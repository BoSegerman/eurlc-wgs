        "db92b1954028601dcbbc63122340bfed" => "Kraken2, PlusPF-8, Release: 10/15/25",
        "01f7d25424cb55f0a39d707a665d7a64" => "Kraken2, PlusPF-16, Release: 10/15/25",
        "3a64075e761e6681537314dec8beb801" => "Kraken2, PlusPFP, Release: 10/15/25",
