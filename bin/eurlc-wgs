#    interop_index1                => "CGTACTAG",
#    interop_index2                => "ACTGCATA",
#    interop_project               => "NA",
#};


sub map_interop_index_summary_to_samples {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my $R_index_summary = $R_interop->{index_summary};
    return 0 if !defined $R_index_summary || ref($R_index_summary) ne 'HASH';

    my $matched   = 0;
    my $unmatched = 0;

    my @lanes = sort { $a <=> $b } grep { /^\d+$/ } keys %{ $R_index_summary->{lanes} || {} };
    return 0 if !@lanes;

    # For now, search all lanes
    my %by_sample_id;
    foreach my $lane (@lanes) {
        my $R_lane = $R_index_summary->{lanes}{$lane};
        next if !defined $R_lane || ref($R_lane) ne 'HASH';
        next if !defined $R_lane->{by_sample_id} || ref($R_lane->{by_sample_id}) ne 'HASH';

        foreach my $sample_id (keys %{ $R_lane->{by_sample_id} }) {
            $by_sample_id{$sample_id} ||= $R_lane->{by_sample_id}{$sample_id};
            $by_sample_id{$sample_id}{lane} ||= $lane;
        }
    }

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        my $sample_name = $R_samples->[$samplenr]{name} // '';
        next if $sample_name eq '';

        my $R_match = $by_sample_id{$sample_name};

        if (!defined $R_match || ref($R_match) ne 'HASH') {
            $unmatched++;
            next;
        }

        $R_samples->[$samplenr]{main_results}{run_data} ||= {};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_lane}
            = $R_match->{lane}
            if defined $R_match->{lane};

        $R_samples->[$samplenr]{main_results}{run_data}{pct_read_identified_pf_sample}
            = $R_match->{pct_read_identified_pf}
            if defined $R_match->{pct_read_identified_pf};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index1}
            = $R_match->{index1}
            if defined $R_match->{index1};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index2}
            = $R_match->{index2}
            if defined $R_match->{index2};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_project}
            = $R_match->{project}
            if defined $R_match->{project};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index_number}
            = $R_match->{index_number}
            if defined $R_match->{index_number};

        $matched++;
    }

    log_message("NOTICE: InterOp index-summary mapping complete: matched [$matched], unmatched [$unmatched]", "green");

    return 1;
}


sub map_interop_run_summary_to_matched_samples {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my %run_data = ();

    my $R_summary = $R_interop->{summary};
    return 0 if !defined $R_summary || ref($R_summary) ne 'HASH';

    $run_data{pf_pct}              = 100 * $R_interop->{index_summary}{lanes}{1}{totals}{pf_reads} / $R_interop->{index_summary}{lanes}{1}{totals}{total_reads}
        if defined $R_interop->{index_summary}{lanes}{1}{totals}{pf_reads}
        && defined $R_interop->{index_summary}{lanes}{1}{totals}{total_reads}
        && $R_interop->{index_summary}{lanes}{1}{totals}{total_reads} > 0;

    $run_data{cluster_density}     = $R_summary->{derived}{cluster_density_mean}
        if defined $R_summary->{derived}{cluster_density_mean};

    $run_data{cluster_pf}          = $R_summary->{derived}{cluster_pf_mean}
        if defined $R_summary->{derived}{cluster_pf_mean};

    $run_data{total_yield_gb}      = $R_summary->{derived}{total_yield_gb}
        if defined $R_summary->{derived}{total_yield_gb};

    $run_data{nonindexed_yield_gb} = $R_summary->{derived}{nonindexed_yield_gb}
        if defined $R_summary->{derived}{nonindexed_yield_gb};

    $run_data{total_pct_q30}       = $R_summary->{derived}{total_pct_q30}
        if defined $R_summary->{derived}{total_pct_q30};

    $run_data{read1_pct_q30}       = $R_summary->{totals}{"Read 1"}{pct_q30}
        if defined $R_summary->{totals}{"Read 1"}{pct_q30};

    $run_data{read2_pct_q30}       = $R_summary->{totals}{"Read 4"}{pct_q30}
        if defined $R_summary->{totals}{"Read 4"}{pct_q30};

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        next if !defined $R_samples->[$samplenr]{main_results}{run_data}{pct_read_identified_pf_sample};

        $R_samples->[$samplenr]{main_results}{run_data} ||= {};

        foreach my $key (keys %run_data) {
            $R_samples->[$samplenr]{main_results}{run_data}{$key} = $run_data{$key};
        }
    }

    return 1;
}


##################################33

sub prompt_yes_no {
    my ($question, $default_yes) = @_;

    my $default = $default_yes ? "Y/n" : "y/N";
    print "$question [$default]: ";

    my $answer = <STDIN>;
    return $default_yes unless defined $answer;   # stdin closed (EOF): take the default
    chomp $answer;
    $answer =~ s/\s+//g;

    return $default_yes if $answer eq '';
    return 1 if $answer =~ /^y(es)?$/i;
    return 0 if $answer =~ /^n(o)?$/i;

    print "Please answer y or n.\n";
    return prompt_yes_no($question, $default_yes);
}

# One-letter choice: prompt_choice("Question?", [ "o" => "overwrite", "r" => "resume" ], "r")
# Returns the chosen word. Empty answer = the default key.
sub prompt_choice {
    my ($question, $opts, $default) = @_;
    my @pairs = @$opts;
    my (%word, @shown);
    while ( my ($k, $w) = splice(@pairs, 0, 2) ) {
        $word{$k} = $w;
        push @shown, ( $k eq $default ? uc($k) : $k ) . "=$w";
    }
    while (1) {
        print "$question [" . join(", ", @shown) . "]: ";
        my $answer = <STDIN>;
        $answer = "" unless defined $answer;
        chomp $answer;
        $answer =~ s/\s+//g;
        $answer = lc $answer;
        return $word{$default} if $answer eq "";
        return $word{$answer} if exists $word{$answer};
        my ($by_word) = grep { $word{$_} eq $answer } keys %word;
        return $word{$by_word} if defined $by_word;
        print "Please answer " . join(", ", map { "$_" } sort keys %word) . ".\n";
    }
}

sub prompt_yes_no_yesstoall {
    my ($question, $default_yes) = @_;

    my $default = $default_yes ? "Y/n/a" : "y/N/a";
    print "$question [$default (a=assume yes for following questions)]: ";

    my $answer = <STDIN>;
    return $default_yes unless defined $answer;   # stdin closed (EOF): take the default
    chomp $answer;
    $answer =~ s/\s+//g;

    return $default_yes if $answer eq '';
    return 1 if $answer =~ /^y(es)?$/i;
    return 0 if $answer =~ /^n(o)?$/i;

   if($answer =~ /^a?$/i){
     $ASSUME_YES = 1;
     return 1;
   }

    print "Please answer y or n.\n";
    return prompt_yes_no_yesstoall($question, $default_yes);
}

# Conda-mode only: if the database directory doesn't exist, prompts to
# create it and does so (mkdir -p, so any missing parent directories are
# created too). Returns 1 if the directory exists or was successfully
# created, 0 if the user declined or creation failed. Used by both the
# configfile=write premount handler and the mount-check section -- both
# need this same "prompt + create" sequence, previously duplicated
# independently in each. Docker mode is NOT handled here, since the two
# callers need genuinely different docker behavior (configfile=write must
# abort -- there's nowhere persistent to write a config file -- while the
# general mount-check instead falls back to an internal default path).
sub prompt_and_create_dir {
    my ($dir) = @_;

    return 1 if -d $dir;

    unless ($ASSUME_YES) {
        my $answer = prompt_yes_no("The directory [$dir] does not exist. Do you want to create it?", 0);
        return 0 unless $answer;
    }

    execute_and_log( "mkdir -p '$dir'" );

    return -d $dir ? 1 : 0;
}

sub premount_list_versions {
    log_message("NOTICE: Versions listing requested - no samples will be processed.");
    log_message("NOTICE: Extracting versioning info.");
    my $softwareversions = log_tool_versions("all","");

    print "\n\nPipeline name: $rundata{pipeline_info}{name}\n",
          "Pipeline version: $rundata{pipeline_info}{version}\n",
          "Pipeline version date: $rundata{pipeline_info}{versiondate}\n",
          "Software versions:\n\n$softwareversions\n";
    close_logfile();
    exit 0;
}

# `conda env list` is read once per process and remembered (B20); the
# cache is dropped after anything that creates or removes an environment
# (conda_env_list_changed). A negative answer is checked again, in case the
# environment was made outside this process meanwhile.
our $S_CONDA_ENVS;
sub conda_env_list_changed { undef $S_CONDA_ENVS }
sub conda_env_exists {
    my ($env_name) = @_;

    for my $try ( 1, 2 ) {
        if ( !$S_CONDA_ENVS ) {
            my $cmd = "conda env list | awk '{print \$1}'";
            my @envs = `$cmd 2>/dev/null`;
            chomp @envs;
            $S_CONDA_ENVS = { map { $_ => 1 } grep { $_ ne "" && !/^#/ } @envs };
        }
        return 1 if $S_CONDA_ENVS->{$env_name};
        last if $try == 2;
        undef $S_CONDA_ENVS;
    }
    return 0;
}

# Expands a tool's config into a list of { exe, test_command } checks to
# perform: one entry per package if "packages => [...]" is defined (new-style
# multi-package tools like bowtie2), otherwise a single entry for the tool's
# program_name/key (old-style single-program tools). Shared by
# validate_tool_installation() and check_conda_env_and_programs() so there is
# one place that defines "what counts as installed" for a tool.
sub expand_tool_checks {
    my ($prog) = @_;

    my $cfg = $R_cfg->{$prog} // {};
    my @checks;

    if (ref($cfg->{packages}) eq 'ARRAY' && @{$cfg->{packages}}) {
        for my $p (@{$cfg->{packages}}) {
            my $exe =
                   $p->{program_name}
                // $p->{exe}
                // $p->{bin}
                // $p->{name}
                // $p->{package_name};

            if (!defined $exe || $exe eq "") {
                # Config problem, not an install failure -- but this function is
                # shared by required AND optional tool code paths, so it must never
                # die here. Log it and report "nothing to check" -- the caller
                # already treats an empty/failed check list as validation failure.
                log_message("ERROR: expand_tool_checks: packages entry missing executable/name under '$prog'", "red");
                return ();
            }

            push @checks, { exe => $exe, test_command => ($p->{test_command} // undef) };
        }
    }
    else {
        my $program_name = $prog;
        if (defined $cfg->{program_name} && $cfg->{program_name} ne "") {
            $program_name = $cfg->{program_name};
        }
        push @checks, { exe => $program_name, test_command => ($cfg->{test_command} // undef) };
    }

    # De-duplicate (by exe+test_command, in case name==program_name etc.)
    my %seen;
    @checks = grep {
        my $k = ($_->{exe} // "") . "\t" . ($_->{test_command} // "");
        !$seen{$k}++
    } @checks;

    return @checks;
}

# Runs a single { exe, test_command } check against a conda env. Prefers the
# configured test_command (e.g. "kraken2 --version") when available, since
# that confirms the program actually runs, not just that a same-named file
# exists in PATH; falls back to a plain "which" check otherwise.
sub run_tool_check {
    my ($env, $check) = @_;

    my $cmd = $check->{test_command}
        ? "conda run -n $env --no-capture-output $check->{test_command} >/dev/null 2>&1"
        : "conda run -n $env --no-capture-output which $check->{exe} >/dev/null 2>&1";

    return system($cmd) == 0;
}

sub validate_tool_installation {
    my ($env, $prog) = @_;

    if (!defined $env || $env eq "") {
        log_message("ERROR: validate_tool_installation: missing env", "red");
        return 0;
    }
    if (!defined $prog || $prog eq "") {
        log_message("ERROR: validate_tool_installation: missing prog", "red");
        return 0;
    }

    my @checks = expand_tool_checks($prog);
    return 0 unless @checks;  # empty = config problem already logged by expand_tool_checks; treat as failure

    for my $check (@checks) {
        return 0 unless run_tool_check($env, $check);  # at least one required program not found/working
    }

    return 1;
}



sub ensure_conda_tool {
    my ($toolname, $auto) = @_;
    $auto //= 0;

    my $cfg = $R_cfg->{$toolname};
    if (!$cfg) {
        log_message("ERROR: No config found for tool '$toolname'", "red");
        return 0;
    }

    my $env = $cfg->{env};
    if (!$env) {
        log_message("ERROR: No env specified for tool '$toolname'", "red");
        return 0;
    }

    log_message("INFO: Checking conda environment for $toolname [$env]");

    my $yml_file = find_env_yml($cfg);

    if (defined $yml_file && $yml_file ne "") {
        log_message("INFO: Found conda YAML for $toolname: [$yml_file]");
    }
    elsif ( ( $cfg->{yml} // "" ) ne "" ) {
        # The YML file is the only source of the versions (B17): installing
        # from the package name instead would miss its extra pins (python,
        # setuptools, ...) and give a different environment.
        log_message("ERROR: Conda YAML [$cfg->{yml}] for $toolname not found. Looked in:", "red");
        log_message("ERROR:   $_", "red") for @{ $cfg->{_yml_tried} // [] };
        log_message("ERROR: Reinstall the pipeline (install.sh or conda), or put the file in <db>/yml/.", "red");
        return 0;
    }
    else {
        # A tool added in the configuration without a YML file.
        log_message("WARNING: $toolname has no conda YAML -- installing from package_name"
                  . ( ( $cfg->{install_version} // "" ) ne "" ? "=$cfg->{install_version}" : "" )
                  . "; the environment is not pinned and may differ between installations", "yellow");
    }

    # ------------------------------------------------------------------
    # Build fallback package spec list
    # ------------------------------------------------------------------

    my @pkg_specs;

    if (!$yml_file) {

        if (ref($cfg->{packages}) eq 'ARRAY' && @{$cfg->{packages}}) {
            for my $p (@{$cfg->{packages}}) {
                my $name = $p->{name} // $p->{package_name};

                if (!defined $name || $name eq "") {
                    log_message("ERROR: packages entry missing name for tool '$toolname'", "red");
                    return 0;
                }

                my $ver = $p->{version} // $p->{install_version};

                push @pkg_specs,
                    (defined($ver) && length($ver))
                    ? "$name=$ver"
                    : $name;
            }
        }
        else {
            my $pkg = $cfg->{package_name};
            if (!$pkg) {
                log_message("ERROR: No package_name for tool '$toolname' and no YAML found", "red");
                return 0;
            }

            my $version = $cfg->{install_version};

            push @pkg_specs,
                (defined($version) && length($version))
                ? "$pkg=$version"
                : $pkg;
        }

        my %seen;
        @pkg_specs = grep { !$seen{$_}++ } @pkg_specs;
    }

    # ------------------------------------------------------------------
    # Existing environment
    # ------------------------------------------------------------------

    if (conda_env_exists($env)) {
        log_message("INFO: Conda env '$env' exists");

        my $ok_update = 1;

        if ($yml_file) {
            my @cmd = (
                "conda", "env", "update",
                "-n", $env,
                "-f", $yml_file,
                "--prune"
            );

            log_message("NOTICE: Updating env '$env' from YAML [$yml_file]");
            log_message("DEBUG: " . join(" ", @cmd));

            system(@cmd);
            if ($? != 0) {
                log_message("ERROR: Conda env update failed for env '$env' using YAML [$yml_file]", "red");
                $ok_update = 0;
            }
        }
        else {
            my @cmd = (
                "conda", "install", "-y",
                "-n", $env,
                "-c", "conda-forge", "-c", "bioconda",
                @pkg_specs
            );

            log_message("NOTICE: Ensuring packages in env '$env': " . join(", ", @pkg_specs));
            log_message("DEBUG: " . join(" ", @cmd));

            system(@cmd);
            if ($? != 0) {
                log_message("ERROR: Conda install/update failed for env '$env'", "red");
                $ok_update = 0;
            }
        }

        return 0 if !$ok_update;

        if (validate_tool_installation($env, $toolname)) {
            log_message("INFO: $toolname validated in $env");
            return 1;
        }
        else {
            log_message("WARNING: Env exists but $toolname validation failed", "red");
            return 0;
        }
    }

    # ------------------------------------------------------------------
    # Missing environment: ask/create
    # ------------------------------------------------------------------

    if ($ASSUME_YES) {
        $auto = 1;
    }

    my $install = $auto
        ? 1
        : prompt_yes_no_yesstoall(
              "Conda env '$env' for $toolname is missing or broken. Create it?",
              0
          );

    unless ($install) {
        log_message("ERROR: Required tool $toolname not installed", "red");
        return 0;
    }

    if ($yml_file) {
        my @cmd = (
            "conda", "env", "create",
            "-f", $yml_file
        );

        log_message("NOTICE: Creating conda env '$env' from YAML [$yml_file]");
        log_message("DEBUG: " . join(" ", @cmd));

        system(@cmd);
        if ($? != 0) {
            log_message("ERROR: Conda environment creation failed for $toolname using YAML [$yml_file]", "red");
            return 0;
        }
    }
    else {
        my @cmd = (
            "conda", "create", "-y",
            "-n", $env,
            "-c", "conda-forge", "-c", "bioconda",
            @pkg_specs
        );

        log_message("NOTICE: Creating conda env '$env' with: " . join(", ", @pkg_specs));
        log_message("DEBUG: " . join(" ", @cmd));

        system(@cmd);
        if ($? != 0) {
            log_message("ERROR: Conda installation failed for $toolname", "red");
            return 0;
        }
    }

    if (validate_tool_installation($env, $toolname)) {
        log_message("NOTICE: $toolname successfully installed in $env", "green");
        return 1;
    }
    else {
        log_message("ERROR: $toolname installed but validation failed", "red");
        return 0;
    }
}


sub writedefaultconfigfile {
   

 if(-f $rundata{config}{path}) {

           if ($ASSUME_YES) {
               graceful_die("Configfile [$rundata{config}{path}] already exists -- overwriting it is a destructive decision and is never auto-approved under assume-yes.");
           }

           my $answer = prompt_yes_no("WARNING: The configfile [$rundata{config}{path}] already exists. Do you want to overwrite it?", 0);

           log_message("INFO: Prompted. Do you want to overwrite config file. answer =[" . ($answer ? "y" : "n") . "]"); 

           unless ($answer) {
               graceful_die("User declined to overwrite existing configfile [$rundata{config}{path}]");
           }
    
            
}            

    #################################################################
    #################################################################
    # Optionally write a default INI file
    
    if (-d getdir("db")) {
       log_message("INFO: Attempting to write a default config file to: [$rundata{config}{path}]");

       if (open my $fh, '>', $rundata{config}{path}) {
          print $fh "; Auto-generated default config file\n";
          print $fh "; Written: " . scalar(localtime) . "\n\n";

          # --- Write tool/general settings ---
          foreach my $section (sort keys %{$rundata{config}{effective}}) {
            next if ($section eq "chewbbaca_schemas" || $section eq "species"); # handled separately
            next unless ref($R_cfg->{$section}) eq 'HASH';

            # The [cleanup] section gets a descriptive header and per-key
            # comments so the generated config file is self-documenting.
            if ($section eq "cleanup") {
                print $fh "[cleanup]\n";
                print $fh "; Controls which large intermediate files are removed when the pipeline finishes.\n";
                print $fh "; 1 = remove  |  0 = keep  (assembly_graphs: gzip | keep | remove)\n";
                my %cleanup_comments = (
                    trimmed_fastq     => "fastp/trimmomatic output -- not needed after assembly",
                    downsampled_fastq => "coverage-capped reads (seqtk/bbmap/rasusa) -- not needed after assembly",
                    jellyfish_db      => "binary .jf k-mer database -- histogram is always kept regardless",
                    bam               => "remapping BAM + BAI -- useful for IGV; can reconstruct FASTQ via samtools fastq",
                    assembler_workfiles => "assembler working files, removed right after each assembly (logs, final graph and differing SPAdes scaffolds are kept)",
                    assembly_graphs   => "final assembly graph (.gfa): gzip | keep | remove",
                    spades_scaffolds  => "SPAdes scaffolds.fasta when it differs from contigs.fasta: remove | gzip | keep",
                    blast_tmp         => "BLAST XML in <tool>_blast/tmp/ of ResFinder, VirulenceFinder, PlasmidFinder",
                );
                for my $param (sort keys %{ $R_cfg->{cleanup} }) {
                    my $val = $R_cfg->{cleanup}{$param} // 0;
                    my $cmt = $cleanup_comments{$param} // "";
                    print $fh "; $cmt\n" if $cmt;
                    print $fh "$param=$val\n";
                }
                print $fh "\n";
                next;
            }

            print $fh "[$section]\n";
            foreach my $param (sort keys %{$R_cfg->{$section}}) {
                my $value = $R_cfg->{$section}{$param};
                # Annotate db_path so users understand it is overridden when frozen
                if ($param eq "db_path") {
                    print $fh "; Live database path -- used unless a frozen version is defined in db_freeze.config\n";
                }
                # A list of plain values is written as comma-separated text
                # (read back into a list, see the config reader). Structures
                # (e.g. [bowtie2] packages, a list of hashes) cannot be
                # written to an INI file and keep their built-in value (A12).
                if ( ref $value eq 'ARRAY' && !grep { ref } @$value ) { $value = join(", ", @$value); }
                elsif ( ref $value )                                 { next; }
                print $fh "$param=$value\n";
            }
            print $fh "\n";
          }

          # --- chewBBACA schemas ---
          # Schemas are NOT written here. They are discovered at runtime from
          # schema.ini files in db/chewbbaca/schemas/<name>/schema.ini.
          # To override individual schema settings (e.g. enabled or filter),
          # add a [chewbbaca_schema_<name>] section manually to this config file.
          print $fh "; chewBBACA schemas are discovered from db/chewbbaca/schemas/<name>/schema.ini\n";
          print $fh "; To override a schema setting, add: [chewbbaca_schema_<name>] enabled=0\n\n";

          # --- Write species ---
          if (exists $rundata{config}{effective}{species} &&
            ref($rundata{config}{effective}{species}) eq 'HASH') {

            foreach my $species_name (sort keys %{$rundata{config}{effective}{species}}) {
                my $species = $rundata{config}{effective}{species}{$species_name};
                print $fh "[species__$species_name]\n";
                # Iterate all keys actually present rather than a hardcoded
                # list -- any new species-level key added to the defaults
                # (fatal_*, warning_*, critical_*, genomesize, gc, etc.)
                # is automatically included without needing to update this
                # function.
                foreach my $k (sort keys %$species) {
                    my $v = $species->{$k} // "";
                    print $fh "$k=$v\n";
                }
                print $fh "\n";
            }
          }

          close $fh;
          log_message("NOTICE: A default config file was written to [$rundata{config}{path}] - modify this if needed");
       }
       else {
          log_message("INFO: Could not create default config file [$rundata{config}{path}]. Msg: [$!]");
          return 0; #failed
       }

       # Also write a default db_freeze.config next to the main config,
       # unless one already exists there.
       # Determine where to write db_freeze.config.
       # IMPORTANT: this runs before the companion-path expansion block (~line 2122),
       # so $R_cfg->{general}{db_freeze_config} may still be the raw relative default
       # ("db_freeze.config") rather than an expanded absolute path.
       # Always resolve relative paths against the db root here.
       my $db_cfg_path = $R_cfg->{general}{db_freeze_config} // "";
       my $db_root     = getdir("db");
       if ($db_cfg_path eq "" || !File::Spec->file_name_is_absolute($db_cfg_path)) {
           $db_cfg_path = File::Spec->catfile($db_root, "db_freeze.config");
       }
       if (-f $db_cfg_path) {
           log_message("NOTICE: db_freeze.config already exists at [$db_cfg_path] -- not overwriting");
       } else {
           write_default_databases_config($db_cfg_path);
       }
    }
    else {
       log_message("INFO: Database path " . getdir("db") . " does not exist  — skipping writing default config");
       return 0; #failed
    }

    return 1; #success
}

# write_default_databases_config($path)
# --------------------------------------
# Generates a default db_freeze.config at $path based on the programs in
# %PROGRAMS that have a db_path defined.  The file is created with commented-
# out marker_md5 lines (empty) so the user knows where to fill them in once
# the databases are installed and frozen.
#
# Returns 1 on success, 0 on failure.
#
# Databases known to db_freeze, one entry per tool:
#   [ section_name, rel_path_under_db, marker_file, config_key, note ]
# These mirror the db_path / db_test entries in the program definitions.
# Only databases that live in a separate directory (not conda-internal) are
# listed. Used both to write a new db_freeze.config and to append entries
# that an older db_freeze.config is missing (--freeze-databases).
sub default_db_freeze_entries {
    return (
        # Kraken2: the index itself (hash.k2d), not only its taxonomy -- the
        # -8/-16 GB variants of one release can share taxo.k2d -- plus the
        # Bracken files in the same folder (B12).
        [ "kraken2",    "kraken2",          "hash.k2d, taxo.k2d, opts.k2d, database*mers.kmer_distrib", "kraken2.db_path", "Kraken2 + Bracken database" ],
        [ "mashscreen", "mash",             "refseq.genomes.k21s1000.msh",   "mashscreen.db_path", "Mash RefSeq sketch"                ],
        [ "checkm",     "checkm",           "hmms/checkm.hmm",               "checkm.db_path",     "CheckM database (optional)"        ],
        [ "bakta",      "bakta/db-light",   "bakta.db",                      "bakta.db_path",      "Bakta light database (optional)"   ],
        [ "resfinder",  "resfinder",        "resfinder_db/all.fsa",          "resfinder.db_path",  "ResFinder database (optional)"     ],
        [ "virulencefinder", "virulencefinder", "virulencefinder_db/*.fsa", "virulencefinder.db_path", "VirulenceFinder database (optional)" ],
        [ "plasmidfinder",   "plasmidfinder",   "plasmidfinder_db/*.fsa",   "plasmidfinder.db_path",   "PlasmidFinder database (optional)"   ],
    );
}

sub write_default_databases_config {
    my ($path) = @_;

    # Resolve the actual db directory (replaces __DB__ in path templates)
    my $db_dir = getdir("db");

    my @db_entries = default_db_freeze_entries();

    open my $fh, '>', $path
        or do { log_message("WARNING: Cannot write default db_freeze.config to [$path]: $!"); return 0; };

    print $fh "; Auto-generated db_freeze.config\n";
    print $fh "; Written: " . scalar(localtime) . "\n";
    print $fh ";\n";
    print $fh "; This file defines FROZEN (versioned) database snapshots for reproducibility.\n";
    print $fh "; Database PATHS are NOT stored here -- they live in eurlc-wgs.config under\n";
    print $fh "; each program's db_path key (using __DB__ placeholders for portability).\n";
    print $fh ";\n";
    print $fh "; Fields:\n";
    print $fh ";   marker_file  = a file inside the database whose MD5 identifies the version\n";
    print $fh ";   marker_md5   = expected MD5 of marker_file after --freeze-databases\n";
    print $fh ";                  leave empty to use the live database without version locking\n";
    print $fh ";   config_key   = eurlc-wgs.config key that holds the live database path\n";
    print $fh ";                  (read-only reference -- do not edit)\n";
    print $fh ";   note         = free-text label shown in run logs\n\n";

    for my $entry (@db_entries) {
        my ($section, $rel_path, $marker, $config_key, $note) = @$entry;

        # Skip databases belonging to disabled programs
        my $prog_enabled = $R_cfg->{$section}{enabled} // 1;
        if (!$prog_enabled || $prog_enabled eq "0") {
            log_message("NOTICE: Skipping [$section] in db_freeze.config -- program is disabled");
            next;
        }

        print $fh "[$section]\n";
        print $fh "marker_file  = $marker\n";
        print $fh "marker_md5   =\n";
        print $fh "config_key   = $config_key\n";
        print $fh "note         = $note\n";
        print $fh "\n";
    }

    # Append one entry per configured chewbbaca schema.
    # The marker file (schema_version.md5) is auto-generated by --freeze-databases
    # if not already present; it contains a fingerprint of all loci file names and
    # sizes so the schema version can be identified without hashing all alleles.
    my $chewbbaca_enabled = $R_cfg->{chewbbaca}{enabled} // 1;
    if ($chewbbaca_enabled && $chewbbaca_enabled ne "0") {
        my $schemas = $R_cfg->{chewbbaca_schemas} // {};
        for my $schema_name (sort keys %$schemas) {
            my $schema = $schemas->{$schema_name};
            next unless ($schema->{enabled} // 1) && ($schema->{enabled} // 1) ne "0";
            my $species_note = $schema->{species} // $schema_name;
            $species_note =~ s/,/, /g;
            print $fh "[chewbbaca_$schema_name]\n";
            print $fh "marker_file  = schema_version.md5\n";
            print $fh "marker_md5   =\n";
            print $fh "config_key   = chewbbaca_schemas.$schema_name.path\n";
            print $fh "note         = chewBBACA schema ($species_note)\n";
            print $fh "\n";
        }
    }

    close $fh;
    log_message("NOTICE: Default db_freeze.config written to [$path]");
    log_message("NOTICE: Run --freeze-databases to lock database versions (fills in marker_md5).");
    return 1;
}

# build_crc32_result_ref
#
# Replaces the raw allele arrays in a $result_ref (as returned by
# parse_chewbbaca) with CRC32-hashed values from the companion
# results_alleles_crc32.tsv file.
#
# Why: chewBBACA uses several ID notations for the same allele sequence
# (classic INF-488, chewie-NS INF-*488, bare *488 ...).  The only
# notation-agnostic comparison is sequence-based, which is exactly what
# the CRC32 table provides.  Using it here makes the distance matrix
# immune to future chewBBACA format changes.
#
# Returns the patched $result_ref on success, undef on failure (so the
# caller can fall back to raw alleles rather than crashing).
sub build_crc32_result_ref {
    my ($result_ref, $crc32_file) = @_;

    unless (defined $crc32_file && -f $crc32_file) {
        log_message("WARNING: CRC32 allele table not found [$crc32_file]; falling back to raw allele IDs for distance matrix");
        return undef;
    }

    # Read the CRC32 TSV -- first column is FILE/sample name.
    my ($crc32_header, $crc32_rows) = read_tsv_rows_by_first_column($crc32_file);
    unless ($crc32_header && $crc32_rows) {
        log_message("WARNING: Could not parse CRC32 allele table [$crc32_file]; falling back to raw allele IDs for distance matrix");
        return undef;
    }

    # read_tsv_rows_by_first_column stores each row as a raw tab-separated
    # string (including the key in column 0).  Split into an arrayref of
    # values, dropping the first column (sample name), to match the
    # {alleles} format that compute_chewbbaca_distance_matrix expects.
    my %crc32_alleles;
    for my $sample (keys %$crc32_rows) {
        my @fields = split /\t/, $crc32_rows->{$sample};
        shift @fields;   # remove sample-name column
        $crc32_alleles{$sample} = \@fields;
    }

    # Parse the header the same way: strip the FILE column.
    my @hdr_fields = split /\t/, $crc32_header;
    shift @hdr_fields;   # remove FILE

    # Build a shallow copy of $result_ref with the allele arrays swapped
    # out for CRC32 values.  Everything else (stats, call rates, etc.) is
    # kept from the original so callers that use those fields are unaffected.
    my %patched = %$result_ref;
    $patched{allele_header} = \@hdr_fields;

    my @patched_data;
    for my $rec (@{ $result_ref->{data} // [] }) {
        my %prec = %$rec;
        my $sample = $rec->{file} // "";
        if (exists $crc32_alleles{$sample}) {
            $prec{alleles} = $crc32_alleles{$sample};
        } else {
            log_message("WARNING: Sample [$sample] missing from CRC32 table; raw allele IDs used for this sample in distance matrix");
        }
        push @patched_data, \%prec;
    }
    $patched{data} = \@patched_data;

    return \%patched;
}

# compute_chewbbaca_distance_matrix
# ---------------------------------
#  Args:
#    $chew_ref: parsed chewBBACA structure
#    %opts:
#       report_distance      => INT (default 5)
#       report_pct_success   => FLOAT (default 0.9)
#       treat_missing_patterns => ARRAYREF of regexes
#       out_prefix           => base path for TSV exports (optional)
#
#  Returns hashref with:
#       sample_names, order, distance_matrix, percent_success,
#       diff_alleles, diff_allele_values, n_positions
#
sub compute_chewbbaca_distance_matrix {
    my ($chew_ref, %opts) = @_;

    $opts{report_distance}      //= 5;
    $opts{report_pct_success}   //= 0.90;
    $opts{treat_missing_patterns} //= [];
    my $out_prefix = $opts{out_prefix};

    die "Invalid chewbbaca structure"
        unless ref($chew_ref) eq 'HASH' && ref($chew_ref->{data}) eq 'ARRAY';

    my @allele_header = @{ $chew_ref->{allele_header} // [] };
    my @rows          = @{ $chew_ref->{data} };

    my @sample_names;
    my %alleles_by_sample;

    for my $r (@rows) {
        next unless ref $r eq 'HASH' && $r->{file};
        push @sample_names, $r->{file};
        my @a = exists $r->{alleles} ? @{ $r->{alleles} } : ();
        push @a, (undef) x (scalar(@allele_header) - scalar(@a)) if @a < @allele_header;
        $alleles_by_sample{$r->{file}} = \@a;
    }

    # Cannot compute a distance matrix with zero samples.
    # This happens when chewBBACA failed or produced no output.
    # Return a minimal but valid structure so callers don't crash.
    # A single sample is fine -- the matrix is trivial (1x1 self-distance = 0).
    if (@sample_names < 1) {
        return {
            sample_names    => \@sample_names,
            order           => \@sample_names,
            distance_matrix => {},
            percent_success => {},
            diff_alleles    => {},
            diff_allele_values => {},
            n_positions     => 0,
        };
    }

    my $is_missing = sub {
        my ($v) = @_;
        return 1 unless defined $v;
        $v =~ s/^\s+|\s+$//g;
        return 1 if $v eq '' || $v eq '-' || $v =~ /^INF-?$/i;
        return 1 if $v =~ /^(PLOT3|PLOT5|LOTSC|NIPH|NIPHEM|ALM|ASM|PAMA|LNF)$/i;
        for my $pat (@{ $opts{treat_missing_patterns} }) {
            return 1 if $v =~ /$pat/;
        }
        return 0;
    };

    my $normalize = sub {
        my ($v) = @_;
        return undef if $is_missing->($v);
        $v =~ s/^\s+|\s+$//g;
        # Strip INF- prefix (chewBBACA novel-allele notation).
        # Handles both classic local IDs (INF-488) and chewie-NS
        # online IDs (INF-*488) where the asterisk indicates an
        # allele retrieved from the Nomenclature Server.
        $v =~ s/^INF[-_](\*?\d+)$/$1/i;
        # Normalise bare NS-style IDs (*488 -> 488) so they compare
        # equal to the stripped form produced by the rule above.
        $v =~ s/^\*(\d+)$/$1/;
        return $v;
    };

    my (%distance, %compared, %percent_success);
    my (%diff_alleles, %diff_allele_values);

    my $n_samples   = scalar @sample_names;
    my $n_positions = scalar @allele_header;

    for my $i (0 .. $n_samples - 1) {
        my $si = $sample_names[$i];
        for my $j ($i + 1 .. $n_samples - 1) {
            my $sj = $sample_names[$j];
            my ($diff_count, $compares) = (0, 0);
            my (@diff_names, @diff_vals);

            my $ai = $alleles_by_sample{$si};
            my $aj = $alleles_by_sample{$sj};

            for my $p (0 .. $n_positions - 1) {
                my $vi = $normalize->($ai->[$p]);
                my $vj = $normalize->($aj->[$p]);
                next unless defined $vi && defined $vj;
                $compares++;
                if ($vi ne $vj) {
                    $diff_count++;
                    my $gene = $allele_header[$p] // "pos$p";
                    push @diff_names, $gene;
                    push @diff_vals, { gene => $gene, $si => $vi, $sj => $vj };
                }
            }

            my $pct_success = $n_positions ? ($compares / $n_positions) : 0;

            $distance{$si}{$sj} = $distance{$sj}{$si} = $diff_count;
            $compared{$si}{$sj} = $compared{$sj}{$si} = $compares;
            $percent_success{$si}{$sj} = $percent_success{$sj}{$si} = $pct_success;

            my $pairkey = "$si-$sj";
            if (($diff_count <= $opts{report_distance}) ||
                ($pct_success >= $opts{report_pct_success})) {
                $diff_alleles{$pairkey}       = \@diff_names;
                $diff_allele_values{$pairkey} = \@diff_vals;
            }
        }
        $distance{$sample_names[$i]}{$sample_names[$i]}       = 0;
        $percent_success{$sample_names[$i]}{$sample_names[$i]} = 1;
    }

    # ---- simple greedy ordering ----
    my %mean_dist = map {
        my $s = $_;
        my @vals = map { $distance{$s}{$_} } grep { $_ ne $s } @sample_names;
        $s => (@vals ? (sum(@vals) / @vals) : 0);
    } @sample_names;

    my ($start) = sort { $mean_dist{$a} <=> $mean_dist{$b} } keys %mean_dist;
    my @order = ($start);
    my %visited = ($start => 1);
    while (keys %visited < $n_samples) {
        my $last = $order[-1];
        my ($next) = sort {
            ($distance{$last}{$a} // 1e9) <=> ($distance{$last}{$b} // 1e9)
        } grep { !$visited{$_} } @sample_names;
        last unless defined $next;
        push @order, $next;
        $visited{$next} = 1;
    }
    push @order, grep { !$visited{$_} } @sample_names;

    # ---- write TSV outputs ----
    if ($out_prefix) {
        my $dist_file = "$out_prefix.dist.tsv";
        my $succ_file = "$out_prefix.success.tsv";

        open my $DF, '>', $dist_file or warn "Cannot write $dist_file: $!";
        open my $SF, '>', $succ_file or warn "Cannot write $succ_file: $!";

        print $DF join("\t", "Sample", @order), "\n";
        print $SF join("\t", "Sample", @order), "\n";

        for my $s1 (@order) {
            print $DF $s1;
            print $SF $s1;
            for my $s2 (@order) {
                my $d = defined $distance{$s1}{$s2} ? $distance{$s1}{$s2} : "";
                my $p = defined $percent_success{$s1}{$s2}
                    ? sprintf("%.3f", $percent_success{$s1}{$s2})
                    : "";
                print $DF "\t$d";
                print $SF "\t$p";
            }
            print $DF "\n";
            print $SF "\n";
        }

        close $DF;
        close $SF;

      #  print STDERR "Distance matrix written to $dist_file\n";
      #  print STDERR "Percent-success matrix written to $succ_file\n";
    }

    return {
        sample_names       => \@sample_names,
        order              => \@order,
        distance_matrix    => \%distance,
        percent_success    => \%percent_success,
        diff_alleles       => \%diff_alleles,
        diff_allele_values => \%diff_allele_values,
        n_positions        => $n_positions,
        allele_header      => \@allele_header,
    };
}
