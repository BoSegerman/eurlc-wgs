sub preprocess_fastp_rawdata {

    my ($samplenr) = @_;

    my $runstep_name = "fastp_rawdata";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     

    if ($sample_type eq "FASTA") {
        return "";
    }
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);
    

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__R1__", "__R2__");
    }

    elsif ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__SE__");
    }
          
    if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastp_rawdata($samplenr);
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

 
    if($sample_type eq "SE" &&  (fill_placeholders("__SE__",$samplenr) eq (fill_placeholders("__SET__",$samplenr)))  )  {
       log_message("ERROR: Fatal error! Fastp inputfile equals oututfile, skipping fastp!!!");
        return "";
    } 
    if($sample_type eq "PE" && ( (fill_placeholders("__R1__",$samplenr) eq (fill_placeholders("__R1T__",$samplenr))) || (fill_placeholders("__R2__",$samplenr) eq (fill_placeholders("__R2T__",$samplenr))) )  )  {
       log_message("ERROR: Fatal error! Fastp inputfile equals oututfile, skipping fastp!!!");
        return "";
    }    
    # runstep specific replacements
    

   ## remove output if fastp is not chosen trimming software

      
#   if( ! $R_cfg->{general}{trimming} eq "fastp" ){
#    $command =~ s/-o '__R1T__'//g;
#    $command =~ s/-O '__R2T__'//g;
#    $command =~ s/-o '__SET__'//g;
#    $R_samples->[$samplenr]{trimmed} = 0;
#   }    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastp_rawdata;

sub postprocess_fastp_rawdata {
    my ($samplenr) = @_;

    my $runstep_name = "fastp_rawdata";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

   # Verify output files
    if ($sample_type eq "PE") {
        if( require_input_files($samplenr, $runstep_name,  "fatal", "__R1T__", "__R2T__")){
           $R_samples->[$samplenr]{trimmed} = 1;
        }
    }

    elsif ($sample_type eq "SE") {
        if(require_input_files($samplenr, $runstep_name,  "fatal", "__SET__")){
           $R_samples->[$samplenr]{trimmed} = 1;        
        }
    }
      

    my $data = read_json($resultfile);
    my $parsed = parse_fastp_results($data);

    return 0 unless defined $parsed;

    # Links used by the HTML reports.
    $parsed->{html_report} =   path_relative_to_outdir(fill_placeholders("__OUTDIR__/__BASE__.raw.html",$samplenr, $runstep_name)); 
    $parsed->{json_report} =   path_relative_to_outdir(fill_placeholders("__OUTDIR__/__BASE__.raw.json",$samplenr, $runstep_name)); 
       
               
   $R_samples->[$samplenr]{results}{$runstep_name} = $parsed;
 
   my $genomesize = $R_samples->[$samplenr]{estimated_genomesize} // 0;
   my $maxdepth =  $R_samples->[$samplenr]{maxdepth};
   my $mindepth =  $R_samples->[$samplenr]{fatal_mindepth};
   my $gc =  $R_samples->[$samplenr]{gc} ;
   
  my $target = $R_samples->[$samplenr]{results}{$runstep_name};

  my $total_bases_before = $target->{summary}{before_filtering}{total_bases};
  my $total_Q30bases_before = $target->{summary}{before_filtering}{q30_bases};

  my $coverageQ30_before = safe_quota($total_Q30bases_before, $genomesize, "n/a");
  my $coverage_before = safe_quota($total_bases_before, $genomesize, "n/a");

  my $total_bases_after = $target->{summary}{after_filtering}{total_bases};
  my $total_Q30bases_after = $target->{summary}{after_filtering}{q30_bases};

  my $coverageQ30_after = safe_quota($total_Q30bases_after, $genomesize, "n/a");
  my $coverage_after = safe_quota($total_bases_after, $genomesize, "n/a");

    my $is_number = sub {
        my ($x) = @_;
        return 0 unless defined $x;
        return 0 if $x eq "";
        return $x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
    };
    
  my $rate_to_pct = sub {
      my ($x) = @_;
      return "n/a" unless $is_number->($x);
      return $x * 100;
  };
      
   ## MAIN RESULTS
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{q30_rate} = $target->{summary}{after_filtering}{q30_rate};
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{q30_rate} = $target->{summary}{before_filtering}{q30_rate};
       
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{R2_R1_read_len_balance} = safe_rel($target->{summary}{after_filtering}{read2_mean_length},$target->{summary}{after_filtering}{read1_mean_length}, "n/a");
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{R2_R1_read_len_balance} = safe_rel($target->{summary}{before_filtering}{read2_mean_length},$target->{summary}{before_filtering}{read1_mean_length}, "n/a");
       
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{av_read_len} = ($target->{summary}{after_filtering}{read1_mean_length}+$target->{summary}{after_filtering}{read2_mean_length})/2;
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len} = ($target->{summary}{before_filtering}{read1_mean_length}+$target->{summary}{before_filtering}{read2_mean_length})/2;
       
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{gc} =  $rate_to_pct->($target->{summary}{after_filtering}{gc_content});

   $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc} =   $rate_to_pct->($target->{summary}{before_filtering}{gc_content});

   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{gc_dev} =  $R_samples->[$samplenr]{gc} - $target->{summary}{after_filtering}{gc_content};
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc_dev} = $R_samples->[$samplenr]{gc} - $target->{summary}{before_filtering}{gc_content};

   $R_samples->[$samplenr]{main_results}{coverage}{raw}{q30_coverage} = $coverageQ30_before // 0;


   $R_samples->[$samplenr]{main_results}{coverage}{raw}{coverage} = $coverage_before // 0;



                               
  log_message("NOTICE: ======= Before filtering ==========", "green");
  if($sample_type eq "PE"){  print_tabular_results("Total reads", "$target->{read1_before_filtering}{total_reads} + $target->{read2_before_filtering}{total_reads} = $target->{summary}{before_filtering}{total_reads}");   }
  if($sample_type eq "SE"){  print_tabular_results("Total reads", "$target->{summary}{before_filtering}{total_reads}");   }
  print_tabular_results("Total bases", $target->{summary}{before_filtering}{total_bases});
  print_tabular_results("Q30 rate", $target->{summary}{before_filtering}{q30_rate});
   if($sample_type eq "PE"){
     print_tabular_results("R1 mean length", $target->{summary}{before_filtering}{read1_mean_length});
     print_tabular_results("R2 mean length", $target->{summary}{before_filtering}{read2_mean_length});
  } 
  if($sample_type eq "SE"){
     print_tabular_results("Read mean length", $target->{summary}{before_filtering}{read1_mean_length});
  } 
  print_tabular_results("GC content", $target->{summary}{before_filtering}{gc_content});
  if($genomesize>0){
    print_tabular_results("Coverage depth", $coverage_before);
    print_tabular_results("Q30 Coverage depth", $coverageQ30_before);
  }
  
  log_message("NOTICE: ======= After filtering ==========", "green");
  if($sample_type eq "PE"){  print_tabular_results("Total reads", "$target->{read1_after_filtering}{total_reads} + $target->{read2_after_filtering}{total_reads} = $target->{summary}{after_filtering}{total_reads}"); }
  if($sample_type eq "SE"){  print_tabular_results("Total reads", "$target->{summary}{after_filtering}{total_reads}"); }
 print_tabular_results("Total bases", $target->{summary}{after_filtering}{total_bases});
 print_tabular_results("Q30 rate", $target->{summary}{after_filtering}{q30_rate});
   if($sample_type eq "PE"){
     print_tabular_results("R1 mean length", $target->{summary}{after_filtering}{read1_mean_length});
     print_tabular_results("R2 mean length", $target->{summary}{after_filtering}{read2_mean_length});
  } 
  if($sample_type eq "SE"){
     print_tabular_results("Read mean length", $target->{summary}{after_filtering}{read1_mean_length});
  } 
  print_tabular_results("GC content", $target->{summary}{after_filtering}{gc_content});
  if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0) {
    print_tabular_results("Coverage depth", $coverage_after);
    print_tabular_results("Q30 Coverage depth", $coverageQ30_after);
  }

  
     
    return 1; # success
}






 
