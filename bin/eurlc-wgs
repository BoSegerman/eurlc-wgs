sub path_relative_to_report_root {
    my ($abs) = @_;

    my $report_dir = get_report_dir();
    $report_dir =~ s{/$}{};

    $abs =~ s{^\Q$report_dir\E/}{};

    return $abs;
}


sub outpath_from_relative {
    my ($rel) = @_;

    my $outdir = getdir("out");
    $outdir =~ s{/$}{};

    return "$outdir/$rel";
}

sub clustering_html_relpath {
    my ($entry) = @_;

    my $species_dirname = $entry->{species_dirname} // "unknown_species";
    my $schema          = $entry->{schema} // "unknown_schema";

    return "report/clustering/${species_dirname}_${schema}.interactive.html";
}

sub get_sample_status_for_js {

    my %status_by_sample;

    foreach my $sample (@$R_samples) {
        my $name = $sample->{name} // next;

        my $status = $sample->{report_issues}{summary}{status}
                  // $sample->{qc}{status}
                  // "UNKNOWN";

        $status_by_sample{$name} = $status;
    }

    return \%status_by_sample;
}

sub get_clustering_default_threshold {
    my ($entry) = @_;

    my $schema  = $entry->{schema} // "";
    my $default = 10;

    if (
        $schema ne ""
        && defined $R_cfg_schemas
        && ref($R_cfg_schemas) eq "HASH"
        && defined $R_cfg_schemas->{$schema}
        && ref($R_cfg_schemas->{$schema}) eq "HASH"
        && defined $R_cfg_schemas->{$schema}{threshold}
        && $R_cfg_schemas->{$schema}{threshold} =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/
    ) {
        return $R_cfg_schemas->{$schema}{threshold} + 0;
    }

    return $default;
}

sub read_square_matrix_tsv {
    my ($file) = @_;

    return undef if !defined $file || !-e $file;

    open my $fh, '<', $file or do {
        log_message("WARNING: Could not open matrix TSV [$file]: $!");
        return undef;
    };

    my $header = <$fh>;
    return undef if !defined $header;

    chomp $header;
    my @cols = split /\t/, $header, -1;
    shift @cols; # remove Sample column

    my %matrix;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my @f = split /\t/, $line, -1;
        my $row_sample = shift @f;

        for my $i (0 .. $#cols) {
            my $col_sample = $cols[$i];
            $matrix{$row_sample}{$col_sample} = $f[$i];
        }
    }

    close $fh;

    return {
        samples => \@cols,
        matrix  => \%matrix,
    };
}

sub perl_to_json {
    my ($x) = @_;
    return encode_json($x);
}

sub get_sample_status_hash {
    my %status;

    foreach my $sample (@$R_samples) {
        my $name = $sample->{name} // next;

        $status{$name} =
            $sample->{report_issues}{summary}{status}
            // $sample->{qc}{status}
            // "UNKNOWN";
    }

    return \%status;
}

sub write_interactive_clustering_html {
    my (%args) = @_;

    my $distance_tsv = $args{distance_tsv};
    my $success_tsv  = $args{success_tsv};
    my $html_file    = $args{html_file};
    my $title        = $args{title} // "Clustering matrix";
    my $species = $args{species} // "n/a";
    my $schema  = $args{schema}  // "n/a";


    my $default_threshold = $args{default_distance_threshold} // 10;

    my $R_distance = read_square_matrix_tsv($distance_tsv);
    my $R_success  = read_square_matrix_tsv($success_tsv);

    if (!$R_distance || ref($R_distance) ne "HASH") {
        log_message("WARNING: Could not build clustering HTML, distance matrix missing or invalid [$distance_tsv]");
        return 0;
    }

    if (!$R_success || ref($R_success) ne "HASH") {
        log_message("WARNING: Could not build clustering HTML, success matrix missing or invalid [$success_tsv]");
        return 0;
    }

    my $R_status = get_sample_status_hash();

    my $json_samples  = encode_json($R_distance->{samples});
    my $json_distance = encode_json($R_distance->{matrix});
    my $json_success  = encode_json($R_success->{matrix});
    my $json_status   = encode_json($R_status);

    my $html_dir = $html_file;
    $html_dir =~ s{/[^/]+$}{};
    ensure_dir($html_dir);

    open my $out, '>', $html_file or do {
        log_message("WARNING: Could not write clustering HTML [$html_file]: $!");
        return 0;
    };

    print $out <<"HTML";
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>@{[ encode_entities($title) ]}</title>
<link rel="stylesheet" href="../assets/style.css">
<link rel="stylesheet" href="../assets/mainreport.css">
<link rel="icon" type="image/png" href="../assets/favicon.png">

<style>
.matrix-controls {
    margin: 1em 0;
    padding: 1em;
    background: #f5f7fb;
    border-radius: 8px;
}
.matrix-wrap {
    overflow: auto;
    max-width: 100%;
    max-height: 80vh;
}
.matrix-table {
    border-collapse: collapse;
    font-size: 11px;
}
.matrix-table th,
.matrix-table td {
    border: 1px solid #ddd;
    padding: 4px 6px;
    text-align: right;
    white-space: nowrap;
}
.matrix-table th {
    position: sticky;
    top: 0;
    background: #eef3fb;
    z-index: 2;
}
.matrix-table th:first-child,
.matrix-table td:first-child {
    position: sticky;
    left: 0;
    background: #eef3fb;
    text-align: left;
    z-index: 1;
}
.sample-status-PASS {
    background: #eef8ee !important;
}
.sample-status-WARNING {
    background: #fff7cc !important;
}
.sample-status-CRITICAL {
    background: #ffe4bf !important;
}
.sample-status-FAIL {
    background: #ffd6d6 !important;
}
.sample-status-UNKNOWN {
    background: #eeeeee !important;
}
.success-low {
    color: #b00020;
    font-weight: bold;
}

.cell-close {
    background: #c8f2d0;
    font-weight: bold;
}
.cell-self {
    background: #eee;
}
.cell-hidden {
    display: none;
}
.cluster-summary {
    margin: 1em 0;
    font-size: 0.95em;
}
</style>
</head>

<body class="main-report">

<div class="report-header brand-header">

    <div class="brand-logo">
        <img src="../assets/eurlc-wgs-logo.png" alt="EURLC-WGS logo"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

        <div class="logo-fallback">EURLC-WGS</div>
    </div>

    <div class="brand-text">
        <div class="pipeline-badge">EURLC-WGS Pipeline</div>
        <div class="pipeline-subtitle">Interactive cg/wgMLST clustering report</div>

        <h1>Clustering report: @{[ encode_entities($species) ]}</h1>
        <div class="pipeline-subtitle">Schema: @{[ encode_entities($schema) ]}</div>
    </div>

</div>

<div class="matrix-controls">

    <label>
        Matrix:
        <select id="matrixType" onchange="renderMatrix()">
            <option value="distance">Distance</option>
            <option value="success">Comparison success</option>
        </select>
    </label>

    &nbsp;&nbsp;

    <label>
        Distance threshold:
        <input type="range" id="thresholdSlider" min="0" max="100" value="$default_threshold" oninput="updateThresholdLabel(); renderMatrix();">
        <span id="thresholdLabel">$default_threshold</span>
    </label>

   <br><br>

   <div id="successThresholdControls">

   <label>
      Comparison success warning threshold:
      <input type="range" id="successThresholdSlider"
             min="0.90" max="0.95" step="0.001" value="0.95"
             oninput="updateSuccessThresholdLabel(); renderMatrix();">
      <span id="successThresholdLabel">0.95</span>
   </label>

   </div>

    <br><br>

    Include samples:
    <label><input type="checkbox" class="statusFilter" value="PASS" checked onchange="renderMatrix()"> PASS</label>
    <label><input type="checkbox" class="statusFilter" value="WARNING" checked  onchange="renderMatrix()"> WARNING</label>
    <label><input type="checkbox" class="statusFilter" value="CRITICAL" onchange="renderMatrix()"> CRITICAL</label>
    <label><input type="checkbox" class="statusFilter" value="FAIL" onchange="renderMatrix()"> FAIL</label>
    <label><input type="checkbox" class="statusFilter" value="UNKNOWN" onchange="renderMatrix()"> UNKNOWN</label>

</div>

<div id="clusterSummary" class="cluster-summary"></div>
<div id="matrixContainer" class="matrix-wrap"></div>

<script>
const samples = $json_samples;
const distanceMatrix = $json_distance;
const successMatrix = $json_success;
const sampleStatus = $json_status;

function getIncludedStatuses() {
    const boxes = document.querySelectorAll(".statusFilter");
    const included = {};
    boxes.forEach(box => {
        if (box.checked) included[box.value] = true;
    });
    return included;
}

function getVisibleSamples() {
    const included = getIncludedStatuses();

    return samples.filter(s => {
        const st = sampleStatus[s] || "UNKNOWN";
        return included[st] === true;
    });
}

function updateThresholdLabel() {
    document.getElementById("thresholdLabel").innerText =
        document.getElementById("thresholdSlider").value;
}

function updateSuccessThresholdLabel() {
    document.getElementById("successThresholdLabel").innerText =
        parseFloat(document.getElementById("successThresholdSlider").value).toFixed(3);
}

function matrixValue(matrix, r, c) {
    if (matrix[r] && matrix[r][c] !== undefined) {
        return matrix[r][c];
    }
    return "";
}

function findClusters(visibleSamples, threshold) {
    let parent = {};
    visibleSamples.forEach(s => parent[s] = s);

    function find(x) {
        while (parent[x] !== x) {
            parent[x] = parent[parent[x]];
            x = parent[x];
        }
        return x;
    }

    function union(a, b) {
        const ra = find(a);
        const rb = find(b);
        if (ra !== rb) parent[rb] = ra;
    }

    for (let i = 0; i < visibleSamples.length; i++) {
        for (let j = i + 1; j < visibleSamples.length; j++) {
            const a = visibleSamples[i];
            const b = visibleSamples[j];
            const d = parseFloat(matrixValue(distanceMatrix, a, b));

            if (!isNaN(d) && d <= threshold) {
                union(a, b);
            }
        }
    }

    let clusters = {};
    visibleSamples.forEach(s => {
        const r = find(s);
        if (!clusters[r]) clusters[r] = [];
        clusters[r].push(s);
    });

    return Object.values(clusters).filter(c => c.length > 1);
}

function updateControlVisibility() {

    const matrixType =
        document.getElementById("matrixType").value;

    const successControls =
        document.getElementById("successThresholdControls");

    if (matrixType === "success") {
        successControls.style.display = "block";
    }
    else {
        successControls.style.display = "none";
    }
}

function renderClusterSummary(visibleSamples, threshold) {
    const clusters = findClusters(visibleSamples, threshold);
    const el = document.getElementById("clusterSummary");

    if (clusters.length === 0) {
        el.innerHTML = "<b>Clusters:</b> none at threshold ≤ " + threshold;
        return;
    }

    let html = "<b>Clusters at threshold ≤ " + threshold + ":</b><br>";
    clusters.forEach((c, idx) => {
        html += "Cluster " + (idx + 1) + " (" + c.length + " samples): " +
                c.join(", ") + "<br>";
    });

    el.innerHTML = html;
}

function renderMatrix() {

    updateControlVisibility();
    
    const matrixType = document.getElementById("matrixType").value;
    const threshold = parseFloat(document.getElementById("thresholdSlider").value);
    const visibleSamples = getVisibleSamples();

    const matrix = matrixType === "success" ? successMatrix : distanceMatrix;

    renderClusterSummary(visibleSamples, threshold);

    let html = "<table class=\\"matrix-table\\">";

    html += "<tr><th>Sample</th>";
    visibleSamples.forEach(s => {
        const st = sampleStatus[s] || "UNKNOWN";
        html += "<th class=\\"sample-status-" + st + "\\" title=\\"" + st + "\\">" + s + "</th>";
    });
    html += "</tr>";

    visibleSamples.forEach(r => {
        const st = sampleStatus[r] || "UNKNOWN";

        html += "<tr>";
        html += "<td class=\\"sample-status-" + st + "\\" title=\\"" + st + "\\">" + r + "</td>";

        visibleSamples.forEach(c => {
            const v = matrixValue(matrix, r, c);
            let cls = "";

            if (r === c) {
                cls = "cell-self";
            }
            else if (matrixType === "distance") {
                const d = parseFloat(v);
                if (!isNaN(d) && d <= threshold) {
                    cls = "cell-close";
                }
            }
            else if (matrixType === "success") {
                const successThreshold = parseFloat(document.getElementById("successThresholdSlider").value);
                const s = parseFloat(v);

                if (!isNaN(s) && s < successThreshold) {
                    cls = "success-low";
                }
            }

            html += "<td class=\\"" + cls + "\\">" + v + "</td>";
        });

        html += "</tr>";
    });

    html += "</table>";



    document.getElementById("matrixContainer").innerHTML = html;
}
updateThresholdLabel();
updateSuccessThresholdLabel();
renderMatrix();
</script>

</body>
</html>
HTML

    close $out;

    log_message("INFO: Wrote interactive clustering HTML [$html_file]", "green");

    return 1;
}



sub install_report_assets {

    my ($target_dir) = @_;

    my $share =
        peekdir("conda") . "/share/eurlc-wgs/assets";

    my @files = (
        "style.css",
        "mainreport.css",
        "favicon.png",
        "eurlc-wgs-logo.png",
    );

    foreach my $file (@files) {

        my $src = "$share/$file";
        my $dst = "$target_dir/$file";

        if (!-e $src) {
            log_message("WARNING: Report asset missing [$src]");
            next;
        }

        if (copy($src, $dst)) {
            log_message("INFO: Installed report asset [$file]");
        }
        else {
            log_message("WARNING: Failed to copy asset [$src] -> [$dst]: $!");
        }
    }
}
#####################################################################################################

sub generate_filtered_clustering_allele_tables {

    my $R_results = $rundata{clustering}{results};
    return 1 if !defined $R_results || ref($R_results) ne "ARRAY";

    my $outdir = getdir("out");
    $outdir =~ s{/$}{};

    my $allele_table_dir = "$outdir/results/clustering/allele_tables";
    ensure_dir($allele_table_dir);

    my $R_status = get_sample_status_hash();

    foreach my $entry (@$R_results) {

        my $species_dirname = $entry->{species_dirname} // "unknown_species";
        my $scheme          = $entry->{schema} // $entry->{scheme} // "unknown_scheme";

        my $source_rel = $entry->{hashed_alleles_all}
                      // $entry->{alleles_crc32}
                      // "";

        if ($source_rel eq "") {
            log_message("WARNING: No CRC32 allele table registered for [$species_dirname] [$scheme]");
            next;
        }

        my $source_abs = outpath_from_relative($source_rel);

        if (!-e $source_abs) {
            log_message("WARNING: CRC32 allele table not found [$source_abs]");
            next;
        }

        my $safe_species = safe_filename_part($species_dirname);
        my $safe_scheme  = safe_filename_part($scheme);

        my @filters = (
            {
                key      => "pass",
                label    => "PASS",
                statuses => { PASS => 1 },
            },
            {
                key      => "pass_warn",
                label    => "PASS+WARNING",
                statuses => { PASS => 1, WARNING => 1 },
            },
            {
                key      => "pass_warn_critical",
                label    => "PASS+WARNING+CRITICAL",
                statuses => { PASS => 1, WARNING => 1, CRITICAL => 1 },
            },
            {
                key      => "all",
                label    => "all samples",
                statuses => undef,
            },
        );

        foreach my $filter (@filters) {

            my $outfile_abs =
                "$allele_table_dir/${safe_species}_${safe_scheme}_$filter->{key}.tsv";

            my $ok = write_filtered_allele_table(
                infile        => $source_abs,
                outfile       => $outfile_abs,
                sample_status => $R_status,
                allowed       => $filter->{statuses},
            );

            if ($ok) {
                my $rel = path_relative_to_outdir($outfile_abs);

                $entry->{"hashed_alleles_$filter->{key}"} = $rel;

                log_message(
                    "INFO: Wrote filtered allele table [$filter->{label}] [$outfile_abs]",
                    "green"
                );
            }
        }
    }

    return 1;
}

sub write_filtered_allele_table {
    my (%args) = @_;

    my $infile        = $args{infile};
    my $outfile       = $args{outfile};
    my $R_status      = $args{sample_status};
    my $R_allowed     = $args{allowed};

    return 0 if !defined $infile  || !-e $infile;
    return 0 if !defined $outfile || $outfile eq "";

    open my $in, '<', $infile or do {
        log_message("WARNING: Could not open allele table [$infile]: $!");
        return 0;
    };

    open my $out, '>', $outfile or do {
        log_message("WARNING: Could not write filtered allele table [$outfile]: $!");
        close $in;
        return 0;
    };

    my $header = <$in>;

    if (!defined $header) {
        log_message("WARNING: Empty allele table [$infile]");
        close $in;
        close $out;
        return 0;
    }

    print $out $header;

    my $kept = 0;
    my $skipped = 0;

    while (my $line = <$in>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my @cols = split /\t/, $line, -1;
        my $sample = $cols[0];

        my $status = $R_status->{$sample} // "UNKNOWN";

        my $keep = 0;

        if (!defined $R_allowed) {
            $keep = 1;  # all samples
        }
        elsif ($R_allowed->{$status}) {
            $keep = 1;
        }

        if ($keep) {
            print $out $line . "\n";
            $kept++;
        }
        else {
            $skipped++;
        }
    }

    close $in;
    close $out;

    log_message("INFO: Filtered allele table [$outfile]: kept=$kept skipped=$skipped");

    return 1;
}


sub safe_filename_part {
    my ($x) = @_;

    $x //= "unknown";
    $x =~ s/^\s+|\s+$//g;
    $x =~ s/\s+/_/g;
    $x =~ s/[^A-Za-z0-9_.-]+/_/g;
    $x =~ s/_+/_/g;

    return $x || "unknown";
}


####################################################################################################

sub generate_filtered_clustering_matrices {

    my $R_results = $rundata{clustering}{results};
    return 1 if !defined $R_results || ref($R_results) ne "ARRAY";

    my $outdir = getdir("out");
    $outdir =~ s{/$}{};

    my $matrix_dir = "$outdir/results/clustering/distance_matrices";
    ensure_dir($matrix_dir);

    my $R_status = get_sample_status_hash();

    foreach my $entry (@$R_results) {

        my $species_dirname = $entry->{species_dirname} // "unknown_species";
        my $scheme          = $entry->{schema} // $entry->{scheme} // "unknown_scheme";

        my $distance_abs = outpath_from_relative($entry->{distance_tsv_all} // "");
        my $success_abs  = outpath_from_relative($entry->{success_tsv_all}  // "");

        if (!-e $distance_abs) {
            log_message("WARNING: Distance matrix not found [$distance_abs]");
            next;
        }

        if (!-e $success_abs) {
            log_message("WARNING: Success matrix not found [$success_abs]");
            next;
        }

        my $safe_species = safe_filename_part($species_dirname);
        my $safe_scheme  = safe_filename_part($scheme);

        my @filters = (
            {
                key      => "pass",
                statuses => { PASS => 1 },
            },
            {
                key      => "pass_warn",
                statuses => { PASS => 1, WARNING => 1 },
            },
            {
                key      => "pass_warn_critical",
                statuses => { PASS => 1, WARNING => 1, CRITICAL => 1 },
            },
            {
                key      => "all",
                statuses => undef,
            },
        );

        foreach my $filter (@filters) {

            my $dist_out_abs =
                "$matrix_dir/${safe_species}_${safe_scheme}_distance_$filter->{key}.tsv";

            my $succ_out_abs =
                "$matrix_dir/${safe_species}_${safe_scheme}_success_$filter->{key}.tsv";

            my $ok_dist = write_filtered_square_matrix(
                infile        => $distance_abs,
                outfile       => $dist_out_abs,
                sample_status => $R_status,
                allowed       => $filter->{statuses},
            );

            my $ok_succ = write_filtered_square_matrix(
                infile        => $success_abs,
                outfile       => $succ_out_abs,
                sample_status => $R_status,
                allowed       => $filter->{statuses},
            );

            if ($ok_dist) {
                $entry->{"distance_tsv_$filter->{key}"} =
                    path_relative_to_outdir($dist_out_abs);
            }

            if ($ok_succ) {
                $entry->{"success_tsv_$filter->{key}"} =
                    path_relative_to_outdir($succ_out_abs);
            }
        }
    }

    return 1;
}

sub write_filtered_square_matrix {
    my (%args) = @_;

    my $infile    = $args{infile};
    my $outfile   = $args{outfile};
    my $R_status  = $args{sample_status};
    my $R_allowed = $args{allowed};

    return 0 if !defined $infile  || !-e $infile;
    return 0 if !defined $outfile || $outfile eq "";

    open my $in, '<', $infile or do {
        log_message("WARNING: Could not open matrix [$infile]: $!");
        return 0;
    };

    my $header = <$in>;
    if (!defined $header) {
        log_message("WARNING: Empty matrix [$infile]");
        close $in;
        return 0;
    }

    chomp $header;

    my @header_cols = split /\t/, $header, -1;
    my $first_col = shift @header_cols;   # usually Sample

    my @keep_samples = grep {
        my $status = $R_status->{$_} // "UNKNOWN";
        !defined $R_allowed || $R_allowed->{$status}
    } @header_cols;

    my %keep = map { $_ => 1 } @keep_samples;

    open my $out, '>', $outfile or do {
        log_message("WARNING: Could not write filtered matrix [$outfile]: $!");
        close $in;
        return 0;
    };

    print $out join("\t", $first_col, @keep_samples) . "\n";

    while (my $line = <$in>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my @cols = split /\t/, $line, -1;
        my $row_sample = shift @cols;

        next if !$keep{$row_sample};

        my @new_row = ($row_sample);

        for my $i (0 .. $#header_cols) {
            my $col_sample = $header_cols[$i];
            next if !$keep{$col_sample};
            push @new_row, $cols[$i];
        }

        print $out join("\t", @new_row) . "\n";
    }

    close $in;
    close $out;

    return 1;
}

###################################################################################################

sub generate_amr_profile_viewer {

    ensure_dir(get_report_amr_dir());

    my $html_file = outpath_from_relative(amr_profile_viewer_relpath());

    my $R_hits = build_amr_profile_hits();

    write_amr_profile_viewer_html(
        html_file => $html_file,
        hits      => $R_hits,
        title     => "AMR profile viewer",
    );

    $rundata{amr}{profile_viewer_html} = amr_profile_viewer_relpath();

    return 1;
}

sub build_amr_profile_hits {

    my @hits;

    foreach my $sample (@$R_samples) {

        my $sample_name = $sample->{name} // next;

 #       log_message("WARNING: AMR viewer: checking sample [$sample_name]");

        my $amr_ref = ref($sample->{results}{amrfinderplus}) || "undef";
        my $res_ref = ref($sample->{results}{resfinder_contigs}) || "undef";

 #       log_message("WARNING: AMR viewer: amrfinderplus ref=[$amr_ref], resfinder_contigs ref=[$res_ref]");

        my $qc_status =
              $sample->{report_issues}{summary}{status}
           // $sample->{qc}{status}
           // "UNKNOWN";

        my $species =
              $sample->{main_results}{taxonomy}{species}
           // "n/a";

        my $A = normalize_amrfinderplus_hits($sample, $sample_name, $qc_status, $species);
        my $R = normalize_resfinder_hits($sample, $sample_name, $qc_status, $species);

#        log_message("WARNING: AMR viewer: sample [$sample_name] AMRFinderPlus hits=" . scalar(@$A) . ", ResFinder hits=" . scalar(@$R));

        push @hits, @$A;
        push @hits, @$R;
    }

#    log_message("WARNING: AMR viewer: total normalized hits=" . scalar(@hits));

    return \@hits;
}



sub normalize_amrfinderplus_hits {
    my ($sample, $sample_name, $qc_status, $species) = @_;

    my @hits;

    my $R = $sample->{results}{amrfinderplus};
    return \@hits if !defined $R || ref($R) ne "HASH";

    my $R_rows = $R->{amr_hits} || $R->{hits} || $R->{data} || [];
    return \@hits if ref($R_rows) ne "ARRAY";



    foreach my $row (@$R_rows) {
        next if ref($row) ne "HASH";

        push @hits, {
            sample     => $sample_name,
            sample_qc  => $qc_status,
            species    => $species,

            tool       => "AMRFinderPlus",

            gene       => $row->{"Element symbol"} // $row->{element_symbol} // $row->{gene_symbol} // $row->{gene} // "n/a",
            allele     => $row->{"Element name"}   // $row->{element_name}   // $row->{allele}      // $row->{gene_symbol} // "n/a",

            drug_class => $row->{"Class"}    // $row->{class}    // $row->{drug_class} // "n/a",
            phenotype  => $row->{"Subclass"} // $row->{subclass} // $row->{phenotype}  // "n/a",

            identity   => $row->{"% Identity to reference"} // $row->{pct_identity} // $row->{identity} // "n/a",
            coverage   => $row->{"% Coverage of reference"} // $row->{pct_coverage} // $row->{coverage} // "n/a",

            contig     => $row->{"Contig id"} // $row->{contig_id} // $row->{contig} // $row->{sequence_name} // "n/a",
            start      => $row->{"Start"}     // $row->{start}     // "n/a",
            end        => $row->{"Stop"}      // $row->{stop}      // $row->{end} // "n/a",
            strand     => $row->{"Strand"}    // $row->{strand}    // "n/a",

            method     => $row->{"Method"} // $row->{method} // "n/a",
            accession  => $row->{"Closest reference accession"} // $row->{closest_reference_accession} // $row->{accession} // "n/a",
            database   => "AMRFinderPlus",

            raw_summary => "",
        };
    }

    return \@hits;
}



sub normalize_resfinder_hits {
    my ($sample, $sample_name, $qc_status, $species) = @_;

    my @hits;

    my $R = $sample->{results}{resfinder_fasta};
    return \@hits if !defined $R || ref($R) ne "HASH";

    my $R_rows = $R->{resfinder_hits} || [];
    return \@hits if ref($R_rows) ne "ARRAY";

    foreach my $row (@$R_rows) {
        next if ref($row) ne "HASH";

        my ($start, $end) = ("n/a", "n/a");

        if (defined $row->{position_in_contig} && $row->{position_in_contig} =~ /^(\d+)\.\.(\d+)$/) {
            ($start, $end) = ($1, $2);
        }
        elsif (defined $row->{position_contig} && $row->{position_contig} =~ /^(\d+)\.\.(\d+)$/) {
            ($start, $end) = ($1, $2);
        }

        push @hits, {
            sample     => $sample_name,
            sample_qc  => $qc_status,
            species    => $species,

            tool       => "ResFinder",

            gene       => $row->{resistance_gene} // $row->{gene} // "n/a",
            allele     => $row->{resistance_gene} // $row->{allele} // "n/a",

            drug_class => "n/a",
            phenotype  => $row->{phenotype} // "n/a",

            identity   => $row->{identity} // "n/a",
            coverage   => $row->{coverage} // "n/a",

            contig     => $row->{contig} // "n/a",
            start      => $start,
            end        => $end,
            strand     => "n/a",

            method     => "nucleotide",
            accession  => $row->{accession} // $row->{accession_no} // "n/a",
            database   => "ResFinder",

            raw_summary => "",
        };
    }

    return \@hits;
}
sub write_amr_profile_viewer_html {
    my (%args) = @_;

    my $html_file = $args{html_file};
    my $R_hits    = $args{hits} || [];
    my $title     = $args{title} // "AMR profile viewer";

    my $json_hits = encode_json($R_hits);

    my $html_dir = $html_file;
    $html_dir =~ s{/[^/]+$}{};
    ensure_dir($html_dir);

    open my $out, '>', $html_file or do {
        log_message("WARNING: Could not write AMR profile viewer [$html_file]: $!");
        return 0;
    };

    print $out <<"HTML";
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>@{[ encode_entities($title) ]}</title>

<link rel="icon" type="image/png" href="../assets/favicon.png">
<link rel="stylesheet" href="../assets/style.css">
<link rel="stylesheet" href="../assets/mainreport.css">

<style>
.amr-controls {
    margin: 1em 0;
    padding: 1em;
    background: #f5f7fb;
    border-radius: 8px;
}
.amr-table-wrap {
    overflow: auto;
    max-width: 100%;
    max-height: 80vh;
}
.amr-table {
    border-collapse: collapse;
    font-size: 12px;
    width: 100%;
}
.amr-table th,
.amr-table td {
    border: 1px solid #ddd;
    padding: 4px 6px;
    white-space: nowrap;
}
.amr-table th {
    position: sticky;
    top: 0;
    background: #eef3fb;
    z-index: 2;
}
.sample-status-PASS { background: #eef8ee; }
.sample-status-WARNING { background: #fff7cc; }
.sample-status-CRITICAL { background: #ffe4bf; }
.sample-status-FAIL { background: #ffd6d6; }
.sample-status-UNKNOWN { background: #eeeeee; }
.amr-low-quality {
    color: #b00020;
    font-weight: bold;
}
.amr-summary {
    margin: 1em 0;
}
</style>
</head>

<body class="main-report">

<div class="report-header brand-header">

    <div class="brand-logo">
        <img src="../assets/eurlc-wgs-logo.png" alt="EURLC-WGS logo"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        <div class="logo-fallback">EURLC-WGS</div>
    </div>

    <div class="brand-text">
        <div class="pipeline-badge">EURLC-WGS Pipeline</div>
        <div class="pipeline-subtitle">AMR profile viewer</div>
        <h1>AMR profile viewer</h1>
        <div class="pipeline-subtitle">AMRFinderPlus and ResFinder results</div>
    </div>

</div>

<div class="amr-controls">

    <label>
        Search:
        <input type="text" id="searchBox" oninput="renderAMRTable()" placeholder="sample, gene, class, phenotype...">
    </label>

    &nbsp;&nbsp;

    <label>
        Tool:
        <select id="toolFilter" onchange="renderAMRTable()">
            <option value="">All</option>
            <option value="AMRFinderPlus">AMRFinderPlus</option>
            <option value="ResFinder">ResFinder</option>
        </select>
    </label>

    &nbsp;&nbsp;

    <label>
        Minimum identity:
        <input type="number" id="minIdentity" value="0" min="0" max="100" step="0.1" onchange="renderAMRTable()">
    </label>

    &nbsp;&nbsp;

    <label>
        Minimum coverage:
        <input type="number" id="minCoverage" value="0" min="0" max="100" step="0.1" onchange="renderAMRTable()">
    </label>

    <br><br>

    Include samples:
    <label><input type="checkbox" class="statusFilter" value="PASS" checked onchange="renderAMRTable()"> PASS</label>
    <label><input type="checkbox" class="statusFilter" value="WARNING" checked onchange="renderAMRTable()"> WARNING</label>
    <label><input type="checkbox" class="statusFilter" value="CRITICAL" onchange="renderAMRTable()"> CRITICAL</label>
    <label><input type="checkbox" class="statusFilter" value="FAIL" onchange="renderAMRTable()"> FAIL</label>
    <label><input type="checkbox" class="statusFilter" value="UNKNOWN" onchange="renderAMRTable()"> UNKNOWN</label>

</div>

<div id="amrSummary" class="amr-summary"></div>
<div id="amrTableContainer" class="amr-table-wrap"></div>

<script>
const amrHits = $json_hits;

function esc(x) {
    if (x === null || x === undefined) return "";
    return String(x)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
}

function getIncludedStatuses() {
    const included = {};
    document.querySelectorAll(".statusFilter").forEach(box => {
        if (box.checked) included[box.value] = true;
    });
    return included;
}

function numOrNull(x) {
    const n = parseFloat(x);
    return isNaN(n) ? null : n;
}

function passesFilters(hit) {
    const included = getIncludedStatuses();
    const st = hit.sample_qc || "UNKNOWN";

    if (!included[st]) return false;

    const tool = document.getElementById("toolFilter").value;
    if (tool && hit.tool !== tool) return false;

    const q = document.getElementById("searchBox").value.toLowerCase();
    if (q) {
        const blob = [
            hit.sample, hit.species, hit.tool, hit.gene, hit.allele,
            hit.drug_class, hit.phenotype, hit.contig, hit.accession
        ].join(" ").toLowerCase();

        if (!blob.includes(q)) return false;
    }

    const minId = parseFloat(document.getElementById("minIdentity").value || "0");
    const minCov = parseFloat(document.getElementById("minCoverage").value || "0");

    const id = numOrNull(hit.identity);
    const cov = numOrNull(hit.coverage);

    if (id !== null && id < minId) return false;
    if (cov !== null && cov < minCov) return false;

    return true;
}

function renderSummary(rows) {
    const samples = new Set();
    const genes = new Set();
    const tools = {};

    rows.forEach(h => {
        samples.add(h.sample);
        genes.add(h.gene);
        tools[h.tool] = (tools[h.tool] || 0) + 1;
    });

    let toolText = Object.keys(tools).map(t => t + ": " + tools[t]).join(", ");
    if (!toolText) toolText = "n/a";

    document.getElementById("amrSummary").innerHTML =
        "<b>Visible hits:</b> " + rows.length +
        " | <b>Samples:</b> " + samples.size +
        " | <b>Genes:</b> " + genes.size +
        " | <b>Tools:</b> " + esc(toolText);
}

function renderAMRTable() {
    const rows = amrHits.filter(passesFilters);

    renderSummary(rows);

    let html = "<table class=\\"amr-table\\">";

    html += "<tr>";
    html += "<th>Sample</th>";
    html += "<th>QC</th>";
    html += "<th>Species</th>";
    html += "<th>Tool</th>";
    html += "<th>Gene</th>";
    html += "<th>Allele</th>";
    html += "<th>Class</th>";
    html += "<th>Phenotype</th>";
    html += "<th>Identity</th>";
    html += "<th>Coverage</th>";
    html += "<th>Contig</th>";
    html += "<th>Start</th>";
    html += "<th>End</th>";
    html += "<th>Strand</th>";
    html += "<th>Method</th>";
    html += "<th>Accession</th>";
    html += "</tr>";

    rows.forEach(h => {
        const st = h.sample_qc || "UNKNOWN";

        html += "<tr>";
        html += "<td class=\\"sample-status-" + esc(st) + "\\">" + esc(h.sample) + "</td>";
        html += "<td class=\\"sample-status-" + esc(st) + "\\">" + esc(st) + "</td>";
        html += "<td>" + esc(h.species) + "</td>";
        html += "<td>" + esc(h.tool) + "</td>";
        html += "<td><b>" + esc(h.gene) + "</b></td>";
        html += "<td>" + esc(h.allele) + "</td>";
        html += "<td>" + esc(h.drug_class) + "</td>";
        html += "<td>" + esc(h.phenotype) + "</td>";
        html += "<td>" + esc(h.identity) + "</td>";
        html += "<td>" + esc(h.coverage) + "</td>";
        html += "<td>" + esc(h.contig) + "</td>";
        html += "<td>" + esc(h.start) + "</td>";
        html += "<td>" + esc(h.end) + "</td>";
        html += "<td>" + esc(h.strand) + "</td>";
        html += "<td>" + esc(h.method) + "</td>";
        html += "<td>" + esc(h.accession) + "</td>";
        html += "</tr>";
    });

    html += "</table>";

    document.getElementById("amrTableContainer").innerHTML = html;
}

renderAMRTable();
</script>

</body>
</html>
HTML

    close $out;

    log_message("INFO: Wrote AMR profile viewer [$html_file]", "green");

    return 1;
}


sub main_report_section_amr {

    my $viewer = $rundata{amr}{profile_viewer_html} // "";

    return "<p>No AMR viewer available.</p>\n" if $viewer eq "";

    $viewer =~ s{^report/}{};

    return qq{
<table class="summary-table">
<tr>
<td class="rowheading">AMR profile viewer</td>
<td><a href="$viewer">🌐 Open AMR profile viewer</a></td>
</tr>
</table>
};
}




####################################################################################################

sub get_report_tsv_dir {
    return get_report_dir() . "/tsv";
}

sub print_detailed_report_tsv_table {

    my $tsv_dir = get_report_tsv_dir();
    ensure_dir($tsv_dir);

    my $outfile = "$tsv_dir/detailed_report_values_by_sample.tsv";

    my $R_def = get_detailed_report_def();

    my @sample_names = map {
        $_->{name} // "unknown_sample"
    } @$R_samples;

    my @rows;

    foreach my $runstep_name (@{ get_detailed_report_runstep_order() }) {

        my $def = $R_def->{$runstep_name};
        next if !defined $def || ref($def) ne "HASH";

        my $section  = $def->{title}    // $runstep_name;
        my $category = $def->{category} // "";

        foreach my $field (@{ $def->{fields} || [] }) {

            next if !defined $field || ref($field) ne "HASH";

            my $label = $field->{label};
            next if !defined $label;

            my %values_by_sample;

            foreach my $sample (@$R_samples) {

                my $sample_name = $sample->{name} // "unknown_sample";
                my $R_result    = $sample->{results}{$runstep_name};

                my $value;

                if (defined $R_result && ref($R_result) eq "HASH") {
                    $value = get_nested_value($R_result, $field->{path});
                }

                if ($field->{hide_if_missing} && !defined $value) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                if ($field->{hide_if_zero} && defined $value && $value =~ /^0(?:\.0+)?$/) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                $values_by_sample{$sample_name} =
                    defined $value
                    ? detailed_report_format_value($value, $field)
                    : "n/a";
            }

            push @rows, {
                runstep  => $runstep_name,
                section  => $section,
                category => $category,
                item     => $label,
                type     => "field",
                values   => \%values_by_sample,
            };
        }

        foreach my $link (@{ $def->{links} || [] }) {

            next if !defined $link || ref($link) ne "HASH";

            my $label = $link->{label} // "Report";

            my %values_by_sample;

            foreach my $sample (@$R_samples) {

                my $sample_name = $sample->{name} // "unknown_sample";
                my $R_result    = $sample->{results}{$runstep_name};

                my $href;

                if (defined $R_result && ref($R_result) eq "HASH") {
                    $href = get_nested_value($R_result, $link->{path});
                }

                if ($link->{hide_if_missing} && (!defined $href || $href eq "" || $href eq "n/a")) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                $values_by_sample{$sample_name} =
                    defined $href && $href ne ""
                    ? $href
                    : "n/a";
            }

            push @rows, {
                runstep  => $runstep_name,
                section  => $section,
                category => $category,
                item     => $label,
                type     => "link",
                values   => \%values_by_sample,
            };
        }
    }

    open my $out, '>', $outfile or do {
        log_message("ERROR: Could not write detailed report TSV [$outfile]: $!", "red");
        return 0;
    };

    print $out join("\t",
        map { tsv_escape($_) }
        (
            "Runstep",
            "Section",
            "Category",
            "Item",
            "Type",
            @sample_names,
        )
    ) . "\n";

    foreach my $row (@rows) {

        my @sample_values = map {
            $row->{values}{$_} // "n/a"
        } @sample_names;

        print $out join("\t",
            map { tsv_escape($_) }
            (
                $row->{runstep},
                $row->{section},
                $row->{category},
                $row->{item},
                $row->{type},
                @sample_values,
            )
        ) . "\n";
    }

    close $out;

    log_message("INFO: Detailed report TSV written to [$outfile]", "green");

    return 1;
}

sub tsv_escape {
    my ($x) = @_;

    return "" if !defined $x;

    $x = "$x";
    $x =~ s/\r?\n/ /g;
    $x =~ s/\t/ /g;

    return $x;
}


