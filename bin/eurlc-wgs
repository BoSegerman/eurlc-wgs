my @measures = sort keys %QC_MEASURE_DEF;

    
# Tiebreak order for the 'assembler' group (equal score -> earlier wins).
# Group members not listed here sort after these, alphabetically.
my @ASSEMBLER_TIEBREAK = qw(spades skesa shovill_spades shovill_skesa);
   
## default config name
$rundata{config}{source} = "built-in defaults"; 
$rundata{config}{overrides} = ""; 
$rundata{config}{default_filename} = $rundata{pipeline_info}{name}  . ".config"; 
$rundata{config}{filename} = $rundata{config}{default_filename}; 
$rundata{config}{path} = peekdir("db") . "/" . $rundata{config}{filename}; 

###################################################################################################
## Structure of $rundata{config}{defaults}
##
## Top-level sections:
##   general              - global pipeline settings (threads, verbosity, etc.)
##   <tool_name>           - one section per external tool (fastp, kraken2, spades, ...).
##                           Common fields: enabled, env, yml, package_name (or packages),
##                           program_name, arguments, db_path, db_test,
##                           install_db. Not every tool uses every field.
##                           Optional: version_check => "strict" requires that every
##                           package=version pin in the resolved YAML (find_env_yml) is
##                           actually installed, not just that the program runs -- auto-
##                           reinstalls (remove + recreate from YAML) on a mismatch. Default
##                           (unset) only checks that the program/test_command runs, any
##                           installed version is accepted. See ensure_tool_version().
##   chewbbaca_schemas     - named cgMLST/wgMLST schema definitions (path, species coverage,
##                           filter), referenced by name from species{}{schema} below.
##   species               - per-species settings, see below. A "default" entry provides
##                           fallback values for any species without its own section.
##
## Species-level keys (under species => { "Genus species" => { ... } }):
## Looked up via get_config_value_for_species($species, $key), which cascades:
## species-specific section -> species "default" section -> general section -> hardcoded
## fallback. Several different *kinds* of keys live side by side here, distinguished only
## by naming convention (not by structure), so it's worth knowing which is which:
##
##   - warning_<measure> / critical_<measure> / fail_<measure>
##       QC classification thresholds, evaluated AFTER a sample has finished processing
##       (see load_expectations()/evaluate_qc_measure()). Used for reporting/status only --
##       never abort processing. <measure> must be a key from %QC_MEASURE_DEF (see the
##       "how to add a measure" guide above that hash for the full list and how to add one).
##       Example: warning_assembly_size, fail_typing_cgmlst_call_rate.
##
##   - fatal_<name>
##       Runtime abort gates, checked DURING processing (not via the QC_MEASURE_DEF/
##       evaluate_qc_measure machinery above -- these are checked directly by name in a
##       handful of specific places in the code). If not met, the sample's processing is
##       stopped early to avoid wasting time on data that's already unusable. Intentionally
##       a short, separate list -- only add one of these if it should genuinely stop a run,
##       not just be flagged in the report. Example: fatal_mindepth, fatal_q30_mindepth.
##
##   - everything else (genomesize, gc, maxdepth, schema, filter, crossreactive_species, ...)
##       Plain operational/reference values consumed directly by specific code, not
##       evaluated as thresholds at all. E.g. genomesize is the expected genome size used to
##       compute the downsampling target; gc is the species' expected GC% (compared against
##       the observed value to compute qscore.*.gc_dev, currently informational only); schema
##       is the name of a chewbbaca_schemas{} entry to use for this species; filter selects
##       which allele filter to apply. These are NOT prefixed like the threshold keys above
##       -- deliberately kept as plain, short field names so they're quick to add/edit in a
##       species config block, at the cost of the category not being visible from the name
##       alone (so when in doubt, check this comment or grep the code for the key name).
##
$rundata{config}{defaults} = {
    general => {
        threads    => 4,

        # validate: compare the results with a validation dataset
        # (EURL-Campylobacter D1/D2/D3, or any dataset with an
        # <ID>_validation_profile.yml and expected-results table).
        #   auto = when the data folder, or the folder above it, holds such a
        #          profile (default); off = never; <folder> = that dataset.
        # Writes report/validation/; see docs/eurlc-validate.md.
        validate   => "auto",

        # verify_reference: compare the results with an earlier run of the
        # same data (after an update of the pipeline, tools or databases).
        #   auto = the newest reference/*.json.gz in the data folder or the
        #          folder above it (default); off = never; <file or folder>.
        # A reference is an earlier run's report/tables/eurlc_results_fingerprint.json.gz.
        # verify_expect: areas or measures where differences are expected
        # (comma-separated, e.g. "amr,qc.coverage"); they are listed but do
        # not count. Writes report/verification/.
        verify_reference => "auto",
        verify_expect    => "",

        # export_efsa: files for programmatic submission to the EFSA WGS
        # System (scripts/eurlc-efsa-export; docs/eurlc-efsa-export.md):
        # results/export/efsa/. Experimental, not yet agreed with EFSA, so off
        # by default (18 Nov 2026). auto = when the run has reportable samples
        # of Salmonella, E. coli, Listeria or Campylobacter; off = never.
        # Nothing is sent. efsa_metadata: TSV with instrument codes and
        # sampling data (default: efsa_metadata.tsv in the data folder, when
        # there). efsa_dir: EFSA's locus lists and locus-name maps (default
        # <database>/efsa_export). efsa_locus_suffix: added to the locus names
        # in allelicProfile.tsv (open question: ".fasta" or nothing).
        # efsa_pipeline_tag: AnalyticalPipelineInfoTag (default EURLC-WGS <version>).
        export_efsa       => "off",
        efsa_metadata     => "",
        efsa_dir          => "",
        efsa_locus_suffix => "",
        efsa_pipeline_tag => "",

        # Companion config files. Relative paths are resolved against the
        # DATABASE directory (falling back to the config file's directory
        # only when no database directory is set); absolute paths are used
        # as-is. An empty value disables that companion file.
        #
        # Example: with the database directory /db, the pipeline looks for
        # /db/db_freeze.config, /db/conda_manifest.ini etc. unless
        # overridden here.
        db_freeze_config => "db_freeze.config",
        conda_manifest   => "conda_manifest.ini",
        seal             => "config_seal.ini",

        # Where --freeze-databases stores frozen copies and where a run
        # looks for them (frozen_dbs/<name>/<md5>/). Empty = <db dir>/frozen_dbs.
        # A relative path is resolved against the database directory.
        frozen_dbs_root  => "",

        # Parallel execution mode (§ parallel scheduler).
        # "off" = strictly sequential, identical behaviour to before this
        # feature existed. "on" = sample-level parallelism: multiple
        # samples' runsteps may be dispatched simultaneously, subject to
        # the resource budget below.
        parallel_mode => "off",

        # Hard resource ceiling for the parallel scheduler. If left at 0
        # (the default) each is auto-detected at startup from the machine
        # (/proc/meminfo, nproc) -- the detected value is then used as the
        # ceiling. Set explicitly to reserve the machine for other work
        # (e.g. max_threads=8 on a 16-core machine leaves half for the OS).
        max_threads => 0,   # 0 = auto-detect
        max_ram_gb  => 0,   # 0 = auto-detect

        # Fraction of the ceiling that can actually be committed at any
        # one time before the scheduler stops dispatching new work.
        # 0.85 = leave 15% headroom against estimation errors and OS
        # overhead. Setting to 1.0 allows full commitment.
        parallel_headroom => 0.85,

        # Default resource claim for any runstep that does not declare its
        # own resources => { threads, ram_gb } field. Set deliberately
        # high so that undeclared runsteps are never co-scheduled -- they
        # effectively occupy the whole budget alone, same as sequential
        # mode. Lower these once resource declarations have been added to
        # the runsteps you care about.
        parallel_default_threads => 99,
        parallel_default_ram_gb  => 999,
        # What to do when the output directory already exists:
        #   prompt -- ask (default); yes -- remove it and start over;
        #   no -- stop; resume -- keep it and only run what is missing
        #   ("extend" is accepted as an older name for resume).
        overwrite  => "prompt",
        # Comma-separated runsteps to run again in an existing output
        # directory, together with every step that depends on them.
        # Implies overwrite=resume. Example: rerun=lissero  or  rerun=spades
        rerun      => "",
        recursive  => 0,
        verbose    => 0,
        fastq      => 1,   # analyze FASTQ input -- see --fastq/--fasta in the manual
        fasta      => 1,   # analyze FASTA input -- both default on; giving exactly
                            # one of --fastq/--fasta on the command line restricts
                            # to just that type
        archive_results => 0,  # archiving is not implemented yet (planned
                                # §4); 1 only asks for/creates the archive
                                # folder (B3)
        trimming => "fastp",
        main_assembly => "fewest_contigs500",
        species_determination => "kraken2",
        mlst_determination => "fastmlst",
        checkm_mode => "per_species_batch",  # or "per_sample" -- see checkm/checkm_per_sample

        # CheckM's lineage_wf places each genome on a reference tree using
        # pplacer. pplacer's RAM usage is driven by the SIZE OF THE
        # REFERENCE TREE, not by genome size or sample count -- the full
        # tree needs ~35-40GB regardless of --pplacer_threads (confirmed:
        # RAM usage tops out around the same ~40GB whether pplacer_threads
        # is 1 or higher -- more threads just means MORE simultaneous
        # ~40GB processes, not a way to reduce the per-thread cost).
        # CheckM's own --reduced_tree flag uses a smaller reference tree,
        # cutting the requirement to ~14-16GB, at the cost of a somewhat
        # less precise lineage placement. Default ON here because most
        # users of this pipeline are not expected to have ~40GB+ free RAM
        # available (confirmed firsthand: even with pplacer_threads=1, a
        # development machine still hit an OOM kill on the full tree).
        # Turn this OFF only if the machine running the pipeline reliably
        # has well over 40GB of free RAM, and the slightly more precise
        # full-tree placement is wanted.
        checkm_reduced_tree => 1,
        # Species this installation works with. Species-specific tools with
        # enabled = auto (SISTR, SeqSero2, ECTyper, LisSero, VirulenceFinder)
        # are switched on for these, and --setup installs them. A genus covers
        # all its species. Add one later with: --resume enable=<species>
        species_scope => "Campylobacter, Salmonella, Escherichia coli, Listeria",
        chewbbaca_mode => "per_sample",  # or "per_species_batch" -- see chewbbaca_per_sample / chewbbaca
        chewbbaca_write_md5 => 0,  # CRC32+SHA256 is the standard pair; MD5 is extra, off by default
        assume_yes => 0, 
        test_software => 1,  
        # Wall-time limit per runstep (safety net against hung tools).
        # Assemblers declare a longer limit of their own (see runstep
        # 'timeout'); any tool can be overridden with [<tool>] timeout.
        timeout => "30m",
        machine_aliases      => "",   # ID=name,ID=name; prefer <db>/known_instruments.tsv
        # Max age (days) of a cached strict-version-check result before it's
        # re-verified against the live conda env, even if the YAML hasn't
        # changed. 0 disables the cache (always re-check). See
        # ensure_tool_version()/validation_cache_is_fresh().
        cache_max_age_days => 7,
    },
    cleanup => {
        # Per-file-type cleanup after the pipeline completes.
        # 1 = remove the files when the pipeline is done (saves disk).
        # 0 = keep them.
        #
        # trimmed_fastq: fastp/trimmomatic output -- roughly the same size as
        #   raw input. Not needed after assembly is done. Default: remove.
        trimmed_fastq      => 1,
        #
        # downsampled_fastq: seqtk/bbmap/rasusa output (coverage-capped reads).
        #   Not needed after assembly is done. Default: remove.
        downsampled_fastq  => 1,
        #
        # merged_fastq: one sample on several lanes, merged into one file per
        #   read direction before the analysis (large_files/fastq/merged/).
        #   Intermediate, about the size of the raw input. Default: remove.
        merged_fastq       => 1,
        #
        # jellyfish_db: the binary .jf k-mer database files produced by
        #   jellyfish count. Only the histogram (.hist) is used by the pipeline
        #   and is always kept. Default: remove (the histogram is kept regardless).
        jellyfish_db       => 1,
        #
        # bam: remapping BAM and BAI files in results/qc/stage3_assemblies/remapping/.
        #   These are useful for visual inspection in IGV and to verify coverage,
        #   but are large (comparable to raw input). They can also be used to
        #   reconstruct FASTQ reads via `samtools fastq`. Since the streaming
        #   remap step (planned §36) the step removes them itself, right after
        #   use; this setting is also read there. Default: remove. Keep with
        #   cleanup.bam=0; make them again with rerun=remap cleanup.bam=0.
        bam                => 1,
        #
        # assembler_workfiles: an assembler's working files (SPAdes k-mer
        #   folders, intermediate graphs, copies of the contigs, ...), removed
        #   as soon as the assembly has been copied to alternative_assemblies/
        #   -- not at the end of the run. Kept: the logs, the final graph (see
        #   assembly_graphs) and, with spades_scaffolds, SPAdes scaffolds.fasta.
        #   A failed assembly is left as it is. Default: remove.
        assembler_workfiles => 1,
        #
        # assembly_graphs: the assembler's final graph (.gfa, for Bandage).
        #   gzip = keep it compressed, keep = keep it as it is, remove = do
        #   not keep it (SKESA then skips gfa_connector). Default: gzip.
        assembly_graphs    => "gzip",
        #
        # spades_scaffolds: SPAdes scaffolds.fasta (contigs joined across
        #   gaps with N; the pipeline uses contigs.fasta). Only kept when it
        #   differs from contigs.fasta: remove (default), gzip or keep.
        spades_scaffolds   => "remove",
        #
        # blast_tmp: the BLAST XML that ResFinder, VirulenceFinder and
        #   PlasmidFinder leave in <tool>_blast/tmp/ (up to ~15 MB per sample
        #   for E. coli); their results are in the tools' own json/txt.
        #   Default: remove.
        blast_tmp          => 1,
    },
    md5 => {
            # Implemented via Digest::MD5 (core Perl) -- no external tool,
            # no conda env, no version check needed. Only enabled matters.
            enabled => 1,
    },
    sample_prescan => {
            # Number of reads to scan per file. More reads = better statistics
            # and more reliable adapter detection, but slower startup.
            # 5000 is sufficient for instrument detection and adapter screening
            # on a typical Illumina run; increase if you see unstable results.
            max_scan_reads => 5000,
    },
    fastp => {
            version_check => "loose",
            required => 1,
            enabled   => 1,
            arguments => "--detect_adapter_for_pe --cut_right --trim_poly_g --length_required 36",
