   return check_conda_tool("mlst");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_mlst;

sub preprocess_mlst {

    my ($samplenr) = @_;

    my $runstep_name = "mlst";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command       = $runstep{$runstep_name}{cmd_template}{main};   
    my $command_alt   = $runstep{$runstep_name}{cmd_template}{alternative};  
      
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};
   

    my $all_resultfiles_present = 1;
    if( ! -f $resultfile ){
      $all_resultfiles_present = 0;
    }
    foreach my $ambl (@assemblers){
       my $alt_resultfile = $alt_resultfile_template;
       $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
       $alt_resultfile = fill_placeholders($alt_resultfile,$samplenr);
       my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta",$samplenr);
       if( -f $test_path){
         if( ! -f $alt_resultfile ){
            $all_resultfiles_present = 0;
         }
       }
    }
    if($all_resultfiles_present){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_mlst($samplenr);
        return "";
    }
         
         
    return "" unless require_input_files($samplenr, $runstep_name, "Optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

     
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
          
    # runstep specific replacements
    
    foreach my $ambl (@assemblers){
       my $add_command = $command_alt;
       my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta",$samplenr);
       if( -f $test_path){
          $add_command =~ s/__ASSEMBLER__/$ambl/g;
          $command = $command . " ; " . $add_command;
       }
    }
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_mlst;

sub postprocess_mlst {
    my ($samplenr) = @_;

    my $runstep_name = "mlst";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    # Parse main assembly MLST result
    my $main_result_ref = parse_mlst($resultfile, $samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name}{main} = $main_result_ref;

    # Parse alternative assembly MLST results
    foreach my $ambl (@assemblers) {
        my $alt_resultfile = $alt_resultfile_template;
        $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
        $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr);

        if (-f $alt_resultfile) {
            my $alt_result_ref = parse_mlst($alt_resultfile, $samplenr);
            $R_samples->[$samplenr]{results}{$runstep_name}{$ambl} = $alt_result_ref;
        }
    }

    # Select best MLST result
    my $selected_from = "main";
    my $selected_ref  = $main_result_ref;

    my $st = $selected_ref->{st} // "n/a";
    my $schema = $selected_ref->{schema} // "n/a";

    if (!defined $st || $st eq "" || $st eq "n/a" || $st eq "-" ) {
        foreach my $ambl (@assemblers) {
            next unless exists $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};

            my $alt_ref = $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};
            my $alt_st  = $alt_ref->{st} // "n/a";

            next if !defined $alt_st || $alt_st eq "" || $alt_st eq "n/a" || $alt_st eq "-";

            $selected_from = $ambl;
            $selected_ref  = $alt_ref;
            $st            = $alt_ref->{st} // "n/a";
            $schema        = $alt_ref->{schema} // "n/a";
            last;
        }
    }

    $R_samples->[$samplenr]{results}{$runstep_name}{st}            = $st;
    $R_samples->[$samplenr]{results}{$runstep_name}{schema}        = $schema;
    $R_samples->[$samplenr]{results}{$runstep_name}{selected_from} = $selected_from;


    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-TYPING__/mlst/__BASE__/__BASE__.mlst.results",$samplenr, $runstep_name)); 

    my $spadespath = fill_placeholders("__DIR-TYPING__/mlst/__BASE__/__BASE__.spades.mlst.results",$samplenr, $runstep_name);
    if(-f $spadespath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{spades_txt_report}   =   path_relative_to_outdir($spadespath); 
    }

    my $shovillspath = fill_placeholders("__DIR-TYPING__/mlst/__BASE__/__BASE__.shovill.mlst.results",$samplenr, $runstep_name);
    if(-f $shovillspath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{shovill_txt_report}   =   path_relative_to_outdir($shovillspath); 
    }

    my $skesaspath = fill_placeholders("__DIR-TYPING__/mlst/__BASE__/__BASE__.skesa.mlst.results",$samplenr, $runstep_name);
    if(-f $skesaspath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{skesa_txt_report}   =   path_relative_to_outdir($skesaspath); 
    }
    
    # Update main_results only if empty or matching; otherwise warn
    my $old_st     = $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST};
    my $old_scheme = $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme};

    my $has_old_st     = defined $old_st     && $old_st ne "" && $old_st ne "-" && $old_st ne "n/a";


    if (!$has_old_st ) {
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST}     = $st;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme} = $schema;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{mlst_method} = "mlst (tseemann)";
    }
    else {
        my $conflict = 0;
        $conflict = 1 if $has_old_st     && $old_st ne $st;


        if ($conflict) {
            push @{ $R_samples->[$samplenr]{warnings} },
                "MLST result [$schema / $st] from $selected_from conflicts with existing main result [$old_scheme / $old_st]";
        }
        else {
            # existing result matches; keep as is
        }
    }

    my $color = "green";
    $color = "yellow" if !defined $st || $st eq "" || $st eq "n/a" || $st eq "-";

    if($selected_from ne "main") { log_message("NOTICE: Sample $sample_name: MLST source assembly: $selected_from", $color); }
    log_message("NOTICE: Sample $sample_name: Schema: $schema", $color);
    log_message("NOTICE: Sample $sample_name: ST Type: $st", $color);

    return 1;
}


# PARSER---------------------------------

sub parse_mlst {
    my ($resultfile, $samplenr) = @_;

    my %mlst_data;   # local hash structure to store parsed results
    my $sample_name = $R_samples->[$samplenr]{name};

    # Try to open the file
    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open MLST result file for sample $sample_name [$resultfile]");
        return {};
    }

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;  # skip blank lines

        # Example line:
        # /path/to/file.fasta  campylobacter  257  aspA(9)  glnA(2)  gltA(4)  glyA(62)  pgm(4)  tkt(5)  uncA(6)
        my @cols = split /\t/, $line;

        # Safety check
        next unless @cols >= 3;   # 1 (path) + 1 (schema) + 1 (st) + >=1 alleles

        my $schema  = $cols[1];
        my $st_type = $cols[2];

        # Store schema and sequence type
        $mlst_data{schema} = $schema;
        $mlst_data{st}     = $st_type;

        # Extract alleles aspA(9) →  aspA => 9
        for my $i (3 .. $#cols) {
            my $allele = $cols[$i];
            if ($allele =~ /^([A-Za-z0-9_]+)\((\d+)\)$/) {
                my ($gene, $id) = ($1, $2);
                $mlst_data{"allele_$gene"} = $id;
            }
        }
    }

    close $fh;
    return \%mlst_data;
}
 
#### example output 
#   schema => "campylobacter",
#  st => 257,
#  allele_aspA => 9,
#  allele_glnA => 2,
#  allele_gltA => 4,
#  allele_glyA => 62,
#  allele_pgm  => 4,
#  allele_tkt  => 5,
#  allele_uncA => 6

