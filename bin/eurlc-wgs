    my $viewer = $rundata{amr}{profile_viewer_html} // "";

    return "<p>No AMR viewer available.</p>\n" if $viewer eq "";

    $viewer =~ s{^report/}{};

    return qq{
<table class="summary-table">
<tr>
<td class="rowheading">AMR profile viewer</td>
<td><a href="$viewer">🌐 Open AMR profile viewer</a></td>
</tr>
</table>
};
}




####################################################################################################

sub get_report_tsv_dir {
    return get_report_dir() . "/tsv";
}

sub print_detailed_report_tsv_table {

    my $tsv_dir = get_report_tsv_dir();
    ensure_dir($tsv_dir);

    my $outfile = "$tsv_dir/detailed_report_values_by_sample.tsv";

    my $R_def = get_detailed_report_def();

    my @sample_names = map {
        $_->{name} // "unknown_sample"
    } @$R_samples;

    my @rows;

    foreach my $runstep_name (@{ get_detailed_report_runstep_order() }) {

        my $def = $R_def->{$runstep_name};
        next if !defined $def || ref($def) ne "HASH";

        my $section  = $def->{title}    // $runstep_name;
        my $category = $def->{category} // "";

        foreach my $field (@{ $def->{fields} || [] }) {

            next if !defined $field || ref($field) ne "HASH";

            my $label = $field->{label};
            next if !defined $label;

            my %values_by_sample;

            foreach my $sample (@$R_samples) {

                my $sample_name = $sample->{name} // "unknown_sample";
                my $R_result    = $sample->{results}{$runstep_name};

                my $value;

                if (defined $R_result && ref($R_result) eq "HASH") {
                    $value = get_nested_value($R_result, $field->{path});
                }

                if ($field->{hide_if_missing} && !defined $value) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                if ($field->{hide_if_zero} && defined $value && $value =~ /^0(?:\.0+)?$/) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                # list fields (columns => ...): one compact text cell in the TSV
                if ( $field->{columns} && ref $value eq 'ARRAY' ) {
                    $values_by_sample{$sample_name} = join("; ", map {
                        my $r = $_;
                        join(" ", grep { $_ ne "" } map { $r->{ $_->[1] } // "" } @{ $field->{columns} })
                    } @$value) || "n/a";
                    next;
                }

                $values_by_sample{$sample_name} =
                    defined $value
                    ? detailed_report_format_value($value, $field)
                    : "n/a";
            }

            push @rows, {
                runstep  => $runstep_name,
                section  => $section,
                category => $category,
                item     => $label,
                type     => "field",
                values   => \%values_by_sample,
            };
        }

        foreach my $link (@{ $def->{links} || [] }) {

            next if !defined $link || ref($link) ne "HASH";

            my $label = $link->{label} // "Report";

            my %values_by_sample;

            foreach my $sample (@$R_samples) {

                my $sample_name = $sample->{name} // "unknown_sample";
                my $R_result    = $sample->{results}{$runstep_name};

                my $href;

                if (defined $R_result && ref($R_result) eq "HASH") {
                    $href = get_nested_value($R_result, $link->{path});
                }

                if ($link->{hide_if_missing} && (!defined $href || $href eq "" || $href eq "n/a")) {
                    $values_by_sample{$sample_name} = "n/a";
                    next;
                }

                $values_by_sample{$sample_name} =
                    defined $href && $href ne ""
                    ? $href
                    : "n/a";
            }

            push @rows, {
                runstep  => $runstep_name,
                section  => $section,
                category => $category,
                item     => $label,
                type     => "link",
                values   => \%values_by_sample,
            };
        }

        # Raw outputs registered via register_raw_output() in result_parsing.
        # These are stored as an ordered array, so they appear in registration
        # order without needing any configuration here in the report section.
        {
            # Collect all raw_output entries seen across any sample for this runstep,
            # keyed by title so each unique file type gets one row in the report.
            my %titles_seen;
            my @ordered_titles;
            foreach my $sample (@$R_samples) {
                my $R_result = $sample->{results}{$runstep_name};
                next unless defined $R_result && ref($R_result) eq "HASH";
                for my $entry (@{ $R_result->{raw_outputs} // [] }) {
                    my $title = $entry->{title} // "Output file";
                    unless ($titles_seen{$title}++) {
                        push @ordered_titles, $title;
                    }
                }
            }

            for my $title (@ordered_titles) {
                my %values_by_sample;
                foreach my $sample (@$R_samples) {
                    my $sample_name = $sample->{name} // "unknown_sample";
                    my $R_result    = $sample->{results}{$runstep_name};
                    my $href        = "n/a";
                    if (defined $R_result && ref($R_result) eq "HASH") {
                        for my $entry (@{ $R_result->{raw_outputs} // [] }) {
                            if (($entry->{title} // "") eq $title) {
                                my $path = $entry->{path} // "";
                                if ($path ne "") {
                                    $href = $path;
                                }
                                last;
                            }
                        }
                    }
                    $values_by_sample{$sample_name} = $href;
                }
                push @rows, {
                    runstep  => $runstep_name,
                    section  => $section,
                    category => $category,
                    item     => $title,
                    type     => "link",
                    values   => \%values_by_sample,
                };
            }
        }
    }

    open my $out, '>', $outfile or do {
        log_message("ERROR: Could not write detailed report TSV [$outfile]: $!", "red");
        return 0;
    };

    print $out join("\t",
        map { tsv_escape($_) }
        (
            "Runstep",
            "Section",
            "Category",
            "Item",
            "Type",
            @sample_names,
        )
    ) . "\n";

    foreach my $row (@rows) {

        my @sample_values = map {
            $row->{values}{$_} // "n/a"
        } @sample_names;

        print $out join("\t",
            map { tsv_escape($_) }
            (
                $row->{runstep},
                $row->{section},
                $row->{category},
                $row->{item},
                $row->{type},
                @sample_values,
            )
        ) . "\n";
    }

    close $out;

    log_message("INFO: Detailed report TSV written to [$outfile]", "green");

    return 1;
}

sub tsv_escape {
    my ($x) = @_;

    return "" if !defined $x;

    $x = "$x";
    $x =~ s/\r?\n/ /g;
    $x =~ s/\t/ /g;

    return $x;
}


####################################################################################################
sub print_result_table {
    my $number_samples = scalar @$R_samples;


    my $outdir    = getdir("out");
    my $outfile   = "$outdir/resulttable.txt";

    open my $fh, '>', $outfile or do {
        log_message("ERROR: Could not write resulttable", "red");
