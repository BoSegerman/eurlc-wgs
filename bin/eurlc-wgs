####################################################################################################

sub print_main_html_report {

    my $number_samples = scalar @$R_samples;

    my $env_path = $ENV{CONDA_PREFIX} // "";
    my $env_path_base = $env_path;
    $env_path_base =~ s{/[^/]*$}{};
    $env_path_base =~ s{/[^/]*$}{};

    log_message("INFO: Printing main html report");

    my $template_file = "$env_path_base/share/eurlc-wgs/templates/main_report.html.tt";

    my $report_dir = get_report_dir();
    my $pdf_dir    = get_report_pdf_dir();

    ensure_dir($report_dir);
    ensure_dir($pdf_dir);

    # Assets should already be installed, but this is harmless if you want one central call elsewhere.
    # install_report_assets(get_report_assets_dir());

    open my $tfh, '<', $template_file
        or graceful_die("Could not open template $template_file: $!");
    my $template_content = do { local $/; <$tfh> };
    close $tfh;

    my $report_html = $template_content;

    my $generated_date    = get_datetime_for_report();
    my $run_name          = get_main_report_name();
    my $pipeline_version  = get_pipeline_version_for_report();

    my $input_path        = get_input_path_for_report();
    my $analysis_host     = get_hostname_for_report();
    my $analysis_user     = get_user_for_report();

    my $run_summary_table     = main_report_section_summary();
    my $sample_overview_table = main_report_section_sample_overview();
    my $versions_table        = short_report_section_versions();
    my $clustering_table      = main_report_section_clustering();

    my $amr_table = main_report_section_amr();
    
    
    # Paths are relative from report/main_report.html
    $report_html =~ s/\Q{{base_css_file}}\E/assets\/style.css/g;
    $report_html =~ s/\Q{{css_file}}\E/assets\/style.css/g;
    $report_html =~ s/\Q{{main_css_file}}\E/assets\/mainreport.css/g;
    $report_html =~ s/\Q{{pipeline_logo_file}}\E/assets\/eurlc-wgs-logo.png/g;
    $report_html =~ s/\Q{{favicon_file}}\E/assets\/favicon.png/g;

    $report_html =~ s/\Q{{run_name}}\E/$run_name/g;
    $report_html =~ s/\Q{{generated_date}}\E/$generated_date/g;
    $report_html =~ s/\Q{{sample_count}}\E/$number_samples/g;
    $report_html =~ s/\Q{{pipeline_version}}\E/$pipeline_version/g;
    $report_html =~ s/\Q{{run_summary_table}}\E/$run_summary_table/g;
    $report_html =~ s/\Q{{sample_overview_table}}\E/$sample_overview_table/g;
    $report_html =~ s/\Q{{versions_table}}\E/$versions_table/g;
    $report_html =~ s/\Q{{input_path}}\E/$input_path/g;
    $report_html =~ s/\Q{{analysis_host}}\E/$analysis_host/g;
    $report_html =~ s/\Q{{analysis_user}}\E/$analysis_user/g;
    $report_html =~ s/\Q{{clustering_table}}\E/$clustering_table/g;

    $report_html =~ s/\Q{{amr_table}}\E/$amr_table/g;

    my $outfile = "$report_dir/main_report.html";

    open my $fh, '>', $outfile or do {
        log_message("ERROR: Could not write report $outfile", "red");
        return 0;
    };

    print $fh $report_html;
    close $fh;

    log_message("INFO: HTML main report written to $outfile", "green");

    my $pdffile   = "$pdf_dir/main_report.pdf";
    my $weasy_env = "eurlc-wgs-weasyprint";

    my $cmd = "conda run -n $weasy_env weasyprint \"$outfile\" \"$pdffile\" __HIDE-STDERR__";
    $cmd = fill_placeholders($cmd);

    my $res = system($cmd);

    if ($res == 0) {
        log_message("INFO: PDF main report written to $pdffile", "green");
    }
    else {
        log_message("WARNING: Could not produce PDF for main report", "yellow");
    }

    return 1;
}

sub write_report_entrypoints {

    my $outdir = getdir("out");
    $outdir =~ s{/$}{};

    my @entry_files = (
        "$outdir/index.html",
        "$outdir/EURLC-WGS-report.html",
    );

    foreach my $file (@entry_files) {

        open my $fh, '>', $file or do {
            log_message("WARNING: Could not write report entry point [$file]: $!");
            next;
        };

        print $fh qq{<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="refresh" content="0; url=report/main_report.html">
<title>EURLC-WGS report</title>
</head>
<body>
<p>Opening <a href="report/main_report.html">EURLC-WGS report</a>.</p>
</body>
</html>
};

        close $fh;

        log_message("INFO: Wrote report entry point [$file]", "green");
    }

    return 1;
}


# Raw system-info detection, used once at startup (see rundata population
# block) to fill %rundata. Intentionally separate from the *_for_report
# functions below: these just detect a value, with no HTML-escaping or
# report-specific defaulting.
sub detect_hostname {
    my $hostname = $ENV{HOSTNAME} // "";
    if ($hostname eq "") {
        chomp($hostname = `hostname 2>/dev/null`);
    }
    return $hostname;
}

sub detect_username {
    my $user = $ENV{USER} // $ENV{LOGNAME} // "";
    if ($user eq "") {
        chomp($user = `whoami 2>/dev/null`);
    }
    return $user;
}

sub derive_run_name_from_indir {
    my ($indir) = @_;
    $indir //= "";
    $indir =~ s{/$}{};
    $indir =~ s{.*/}{};
    return $indir;
}

# Single shared helper for report display: HTML-escape a value, falling back
# to a default (e.g. "unknown") if it's missing/empty. Replaces what used to
# be near-identical escape+default logic repeated in every *_for_report
# function below.
sub report_value {
    my ($value, $default) = @_;
    $default = "unknown" unless defined $default;
    return encode_entities(defined($value) && $value ne "" ? $value : $default);
}

###################################################################################################
## Boolean config field normalization
##
## Historically, genuinely binary on/off settings have been written both as
## numeric 0/1 (e.g. every "enabled" field) and as the strings "yes"/"no"
## (e.g. general.recursive, resfinder.fasta/fastq) -- inconsistently, even
## within the same tool's config block. Numeric 0/1 is the canonical internal
## form: in Perl the string "no" is *true* in boolean context (it's a
## non-empty, non-"0" string), so any future code that does a plain
## "if ($value)" instead of an explicit eq/ne comparison would silently get
## "no" wrong. Numeric 0/1 has no such trap.
##
## This does NOT apply to every setting that happens to include "yes"/"no"
## as one of its possible values -- general.overwrite ("prompt"/"yes"/"no"/
## "extend"), version_check ("strict"/"loose"), and fastmlst.run_update_db
## ("always"/"yes"/"no"/"weekly"/.../a number of days) are genuine multi-value
## settings, not booleans, and must never be normalized here.

# Any parameter with this exact name is treated as boolean regardless of
# which section it's in (every "enabled" field already follows this).
my %KNOWN_BOOLEAN_PARAM = (
    enabled => 1,
);

# A handful of specific section.param fields that are also genuinely binary,
# but don't follow the "enabled" naming convention.
my %KNOWN_BOOLEAN_FIELD = (
    "general.recursive"  => 1,
    "general.verbose"    => 1,
    "general.fastq"       => 1,
    "general.fasta"       => 1,
    "general.archive_results" => 1,
    "resfinder.fasta"     => 1,
    "resfinder.fastq"     => 1,
);

sub is_known_boolean_field {
    my ($section, $param) = @_;
    return 1 if $KNOWN_BOOLEAN_PARAM{$param};
    return 1 if $KNOWN_BOOLEAN_FIELD{"$section.$param"};
    return 0;
}

# Normalizes a human-friendly boolean-ish value (yes/no/true/false/on/off/1/0,
# case-insensitive, surrounding whitespace ignored) to canonical 0/1. Returns
# undef if the value doesn't match any recognized form -- the caller should
# warn and leave the setting unchanged rather than silently storing something
# unrecognized.
sub normalize_boolean_value {
    my ($value) = @_;
    return undef unless defined $value;
    my $v = lc($value);
    $v =~ s/^\s+|\s+$//g;
    return 1 if $v eq "yes" || $v eq "true"  || $v eq "on"  || $v eq "1";
    return 0 if $v eq "no"  || $v eq "false" || $v eq "off" || $v eq "0";
    return undef;
}

sub get_main_report_name {
    return report_value($rundata{pipeline_info}{run_name}, "WGS Run Report");
}

sub get_datetime_for_report {
    my @t = localtime();
    return sprintf(
        "%04d-%02d-%02d %02d:%02d:%02d",
        $t[5] + 1900, $t[4] + 1, $t[3],
        $t[2], $t[1], $t[0]
    );
}

sub get_input_path_for_report {
    return report_value($rundata{pipeline_info}{input_path});
}

sub get_pipeline_version_for_report {
    return report_value($rundata{pipeline_info}{version});
}

sub get_hostname_for_report {
    return report_value($rundata{pipeline_info}{analysis_host});
}

sub get_user_for_report {
    return report_value($rundata{pipeline_info}{analysis_user});
}


###########################################################################

sub main_report_section_summary {

    my %stats = (
        n_samples         => 0,
        n_pass            => 0,
        n_warning         => 0,
        n_critical        => 0,
        n_fail            => 0,

        n_pe              => 0,
        n_se              => 0,
        n_fasta           => 0,

        total_bases       => 0,
        total_pairs       => 0,
        total_se_reads    => 0,

        total_q30_bases   => 0,
        total_q_bases     => 0,
        total_bases_for_qscore => 0,

        min_max_read_len  => undef,
        max_max_read_len  => undef,

        species_count     => {},
        instruments       => {},
        run_ids           => {},
        dates             => {},
        cluster_density   => {},
    );

    foreach my $sample (@$R_samples) {
        $stats{n_samples}++;

        my $qc = $sample->{report_issues}{summary}{status}
              // $sample->{qc}{status}
              // "UNKNOWN";

        $stats{n_pass}++     if $qc eq "PASS";
        $stats{n_warning}++  if $qc eq "WARNING";
        $stats{n_critical}++ if $qc eq "CRITICAL";
        $stats{n_fail}++     if $qc eq "FAIL";

        my $type = uc($sample->{type} // "UNKNOWN");
        $stats{n_pe}++    if $type eq "PE";
        $stats{n_se}++    if $type eq "SE";
        $stats{n_fasta}++ if $type eq "FASTA";

        my $species = $sample->{main_results}{taxonomy}{species} // "unknown";
        $stats{species_count}{$species}++;

        my $instrument = $sample->{results}{fastq_prescan}{total}{instrument}    // "";
        my $alias      = $sample->{results}{fastq_prescan}{total}{machine_alias} // "";
        my $run_nr     = $sample->{results}{fastq_prescan}{total}{run_number}    // "";
        my $date_raw   = $sample->{rawdata_stats}{R1}{created}
                      // $sample->{rawdata_stats}{SE}{created}
                      // $sample->{rawdata_stats}{FASTA}{created};

        my $cluster_density = $sample->{main_results}{run_data}{cluster_density};

        if ($instrument ne "") {
            my $inst_label = $instrument;
            $inst_label .= " ($alias)" if $alias ne "" && $alias ne "n/a" && $alias ne $instrument;
            $stats{instruments}{$inst_label}++;
        }

        if ($instrument ne "" || $run_nr ne "") {
            my $run_id = $instrument;
            $run_id .= ":" if $instrument ne "" || $run_nr ne "";
            $run_id .= $run_nr;
            $run_id =~ s/^:+//;
            $run_id =~ s/:+$//;
            $stats{run_ids}{$run_id}++ if $run_id ne "";
        }

        if (defined $cluster_density && $cluster_density ne "" && $cluster_density ne "n/a") {
            $stats{cluster_density}{$cluster_density}++;
        }

        my $date_ymd = normalize_date_to_ymd($date_raw);
        $stats{dates}{$date_ymd}++ if defined $date_ymd && $date_ymd ne "";

        my ($sample_bases, $sample_pairs, $sample_se_reads) = get_sample_read_totals($sample);

        $stats{total_bases}    += $sample_bases    if defined $sample_bases;
        $stats{total_pairs}    += $sample_pairs    if defined $sample_pairs;
        $stats{total_se_reads} += $sample_se_reads if defined $sample_se_reads;

        my ($bases_for_q, $q30_bases, $q_bases_sum) = get_sample_q_aggregates($sample);

        $stats{total_bases_for_qscore} += $bases_for_q if defined $bases_for_q;
        $stats{total_q30_bases}        += $q30_bases   if defined $q30_bases;
        $stats{total_q_bases}          += $q_bases_sum if defined $q_bases_sum;

        my $sample_max_len = get_sample_max_read_length($sample);

        if (defined $sample_max_len) {
            if (!defined $stats{min_max_read_len} || $sample_max_len < $stats{min_max_read_len}) {
                $stats{min_max_read_len} = $sample_max_len;
            }
            if (!defined $stats{max_max_read_len} || $sample_max_len > $stats{max_max_read_len}) {
                $stats{max_max_read_len} = $sample_max_len;
            }
        }
    }

    my $n_samples_text = $stats{n_samples} . " (" .
        join(", ",
            grep { $_ ne "" } (
                $stats{n_pe}    ? "$stats{n_pe} PE"       : "",
                $stats{n_se}    ? "$stats{n_se} SE"       : "",
                $stats{n_fasta} ? "$stats{n_fasta} FASTA" : "",
            )
        ) . ")";

    my $species_summary    = summarise_count_hash($stats{species_count}, 3);
    my $instrument_summary = summarise_count_hash($stats{instruments}, 3, 0);
    my $runid_summary      = summarise_count_hash($stats{run_ids}, 3, 0);
    my $date_summary       = summarise_dates($stats{dates});

    my $total_bases_text = format_bp_human($stats{total_bases});
    my $total_reads_text = format_total_reads_text($stats{total_pairs}, $stats{total_se_reads});

    my $total_q30_rate_text = "n/a";
    if ($stats{total_bases_for_qscore} > 0) {
        $total_q30_rate_text = sprintf("%.1f%%", 100 * $stats{total_q30_bases} / $stats{total_bases_for_qscore});
    }

    my $total_average_q_text = "n/a";
    if ($stats{total_bases_for_qscore} > 0) {
        $total_average_q_text = sprintf("%.1f", $stats{total_q_bases} / $stats{total_bases_for_qscore});
    }

    my $max_read_length_span = "n/a";
    if (defined $stats{min_max_read_len} && defined $stats{max_max_read_len}) {
        if ($stats{min_max_read_len} == $stats{max_max_read_len}) {
            $max_read_length_span = $stats{min_max_read_len};
        }
        else {
            $max_read_length_span = $stats{min_max_read_len} . "-" . $stats{max_max_read_len};
        }
    }

    my $warning_class  = $stats{n_warning}  > 0 ? 'summary-warning'  : '';
    my $critical_class = $stats{n_critical} > 0 ? 'summary-critical' : '';
    my $fail_class     = $stats{n_fail}     > 0 ? 'summary-fail'     : '';

    my $html = "";

    ############################
    # Status table
    $html .= "<table class=\"summary-status-table\">\n";
    $html .= "  <tr>\n";
    $html .= "    <th>Total</th>\n";
    $html .= "    <th>PASS</th>\n";
    $html .= "    <th>WARNING</th>\n";
    $html .= "    <th>CRITICAL</th>\n";
    $html .= "    <th>FAIL</th>\n";
    $html .= "  </tr>\n";
    $html .= "  <tr>\n";
    $html .= "    <td>" . encode_entities($n_samples_text) . "</td>\n";
    $html .= "    <td>$stats{n_pass}</td>\n";
    $html .= "    <td class=\"$warning_class\">$stats{n_warning}</td>\n";
    $html .= "    <td class=\"$critical_class\">$stats{n_critical}</td>\n";
    $html .= "    <td class=\"$fail_class\">$stats{n_fail}</td>\n";
    $html .= "  </tr>\n";
    $html .= "</table>\n";

    ############################
    # Derived from data
    $html .= "<h3>Derived from data</h3>\n";
    $html .= "<table class=\"summary-table\">\n";
    $html .= "<tr><td class=\"rowheading\">Species represented</td><td>" . encode_entities($species_summary) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Total bases</td><td>" . encode_entities($total_bases_text) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Total reads</td><td>" . encode_entities($total_reads_text) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Instrument(s)</td><td>" . encode_entities($instrument_summary) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Run IDs</td><td>" . encode_entities($runid_summary) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Date(s)</td><td>" . encode_entities($date_summary) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Total Q30 rate</td><td>" . encode_entities($total_q30_rate_text) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Total average Q</td><td>" . encode_entities($total_average_q_text) . "</td></tr>\n";
    $html .= "<tr><td class=\"rowheading\">Max read length span</td><td>" . encode_entities($max_read_length_span) . "</td></tr>\n";
    $html .= "</table>\n";

    ############################
    # Derived from Illumina logfiles
    my $illumina_html = main_report_section_summary_illumina_logfiles();
    if ($illumina_html ne "") {
        $html .= "<h3>Derived from Illumina logfiles</h3>\n";
        $html .= $illumina_html;
    }

    return $html;
}


sub main_report_section_summary_illumina_logfiles {

    my $R_rp  = $rundata{illuminafiles}{runparameters} || {};
    my $R_ss  = $rundata{illuminafiles}{samplesheet}   || {};
    my $R_int = $rundata{illuminafiles}{interop}       || {};

    my @rows;

    ############################
    # RunParameters / SampleSheet
    my $machine         = $R_rp->{scanner_id}         // "n/a";
    my $run_id          = $R_rp->{run_id}             // "n/a";
    my $experiment_name = $R_rp->{experiment_name}    // "n/a";
    my $user_name       = $R_rp->{username}           // "n/a";
    my $run_date        = $R_rp->{run_start_date_iso} // "n/a";
    my $samplesheet_date = $R_ss->{header}{Date}      // "n/a";
    my $library_kit     = $R_rp->{library_prep_kit}   // "n/a";
    my $index_kit       = $R_rp->{index_kit}          // "n/a";
    my $chemistry       = $R_rp->{chemistry}          // "n/a";

    push @rows, [ "Machine",          $machine ]          if $machine ne "n/a";
    push @rows, [ "Run ID",           $run_id ]           if $run_id ne "n/a";
    push @rows, [ "Experiment name",  $experiment_name ]  if $experiment_name ne "n/a";
    push @rows, [ "User name",        $user_name ]        if $user_name ne "n/a";
    push @rows, [ "Run date",         $run_date ]         if $run_date ne "n/a";
    push @rows, [ "SampleSheet date", $samplesheet_date ] if $samplesheet_date ne "n/a";
    push @rows, [ "Library kit",      $library_kit ]      if $library_kit ne "n/a";
    push @rows, [ "Index kit",        $index_kit ]        if $index_kit ne "n/a";
    push @rows, [ "Chemistry",        $chemistry ]        if $chemistry ne "n/a";

    ############################
    # InterOp
    my $R_summary = $R_int->{summary}       || {};
    my $R_index   = $R_int->{index_summary} || {};

    my ($total_reads, $pf_reads, $pf_pct, $cv, $min, $max);

    my @lanes = sort { $a <=> $b } grep { /^\d+$/ } keys %{ $R_index->{lanes} || {} };
    if (@lanes) {
        my $lane = $lanes[0];
        my $R_lane = $R_index->{lanes}{$lane}{totals} || {};

        $total_reads = $R_lane->{total_reads};
        $pf_reads    = $R_lane->{pf_reads};
        $cv          = $R_lane->{cv};
        $min         = $R_lane->{min};
        $max         = $R_lane->{max};

        if (defined $pf_reads && defined $total_reads && $total_reads > 0) {
            $pf_pct = sprintf("%.1f%%", 100 * $pf_reads / $total_reads);
        }
    }

    my $R_totals = $R_summary->{totals} || {};

    my $total_yield  = defined $R_totals->{Total}{yield_gb}         ? $R_totals->{Total}{yield_gb} . " Gb" : "n/a";
    my $nonidx_yield = defined $R_totals->{"Non-indexed"}{yield_gb} ? $R_totals->{"Non-indexed"}{yield_gb} . " Gb" : "n/a";

    my $q30_total = defined $R_totals->{Total}{pct_q30}    ? $R_totals->{Total}{pct_q30} . "%"    : "n/a";
    my $q30_r1    = defined $R_totals->{"Read 1"}{pct_q30} ? $R_totals->{"Read 1"}{pct_q30} . "%" : "n/a";
    my $q30_r2    = defined $R_totals->{"Read 4"}{pct_q30} ? $R_totals->{"Read 4"}{pct_q30} . "%" : "n/a";

    my $q30_i1 = $R_totals->{"Read 2 (I)"}{pct_q30};
    my $q30_i2 = $R_totals->{"Read 3 (I)"}{pct_q30};
    my $q30_index = (defined $q30_i1 || defined $q30_i2)
        ? (($q30_i1 // "n/a") . "% / " . ($q30_i2 // "n/a") . "%")
        : "n/a";

    my $R_read1 = $R_summary->{read_sections}{"Read 1"}{by_surface}{"-"} || {};
    my $density   = $R_read1->{Density};
    my $clusterpf = $R_read1->{"Cluster PF"};

    my $density_text   = defined $density   ? "$density k/mm2" : "n/a";
    my $clusterpf_text = defined $clusterpf ? "$clusterpf%"    : "n/a";

    push @rows, [ "Total reads (InterOp)", $total_reads ] if defined $total_reads;
    push @rows, [ "PF reads",              $pf_reads ]    if defined $pf_reads;
    push @rows, [ "PF (%)",                $pf_pct ]      if defined $pf_pct;
    push @rows, [ "Total yield",           $total_yield ] if $total_yield ne "n/a";
    push @rows, [ "Total yield (excluding index reads)",     $nonidx_yield ] if $nonidx_yield ne "n/a";
    push @rows, [ "Q30 total",             $q30_total ]   if $q30_total ne "n/a";
    push @rows, [ "Q30 R1",                $q30_r1 ]      if $q30_r1 ne "n/a";
    push @rows, [ "Q30 R2",                $q30_r2 ]      if $q30_r2 ne "n/a";
    push @rows, [ "Q30 index I1 / I2",     $q30_index ]   if $q30_index ne "n/a";
    push @rows, [ "Cluster density",       $density_text ] if $density_text ne "n/a";
    push @rows, [ "Cluster PF",            $clusterpf_text ] if $clusterpf_text ne "n/a";

    if (defined $cv || defined $min || defined $max) {
        push @rows, [ "Sample balance CV", defined $cv ? $cv : "n/a" ];
        push @rows, [ "Sample balance min / max",
            (defined $min || defined $max)
                ? (($min // "n/a") . "% / " . ($max // "n/a") . "%")
                : "n/a"
        ];
    }

    my $R_footer = $R_summary->{footer} || {};

    my $extracted = $R_footer->{Extracted};
    my $called    = $R_footer->{Called};
    my $scored    = $R_footer->{Scored};

    if (defined $extracted || defined $called || defined $scored) {

        my $text = join(" / ",
            defined $extracted ? $extracted : "n/a",
            defined $called    ? $called    : "n/a",
            defined $scored    ? $scored    : "n/a",
        );

        push @rows, [ "Tiles processed (Extracted/Called/Scored)", $text ];
    }

    return "" if !@rows;

    my $html = "";
    $html .= "<table class=\"summary-table\">\n";
    foreach my $row (@rows) {
        my ($label, $value) = @$row;
        $html .= "<tr><td class=\"rowheading\">" . encode_entities($label) . "</td><td>" . encode_entities($value) . "</td></tr>\n";
    }
    $html .= "</table>\n";

    return $html;
}

sub normalize_date_to_ymd {
    my ($text) = @_;
    return undef if !defined $text || $text eq "" || $text eq "n/a";

    # already yyyy-mm-dd or yyyy/mm/dd
    if ($text =~ /(\d{4})[-\/](\d{2})[-\/](\d{2})/) {
        return "$1-$2-$3";
    }

    # compact yyyymmdd
    if ($text =~ /(\d{4})(\d{2})(\d{2})/) {
        return "$1-$2-$3";
    }

    return undef;
}

sub summarise_dates {
    my ($R_dates) = @_;
    return "n/a" if !defined $R_dates || ref($R_dates) ne 'HASH' || !%$R_dates;

    my @dates = sort keys %$R_dates;
    return $dates[0] if @dates == 1;
    return join(", ", @dates) if @dates <= 3;
    return $dates[0] . " – " . $dates[-1];
}

sub summarise_count_hash {
    my ($R_hash, $max_items, $show_counts) = @_;
    $max_items   //= 3;
    $show_counts = 1 if !defined $show_counts;

    return "n/a" if !defined $R_hash || ref($R_hash) ne 'HASH' || !%$R_hash;

    my @items = sort keys %$R_hash;
    my $n_total = scalar @items;

    my @shown = @items[0 .. ($n_total < $max_items ? $n_total - 1 : $max_items - 1)];

    my @parts = map {
        $show_counts ? "$_ ($R_hash->{$_})" : $_
    } @shown;

    my $text = join(", ", @parts);

    if ($n_total > $max_items) {
        my $more = $n_total - $max_items;
        $text .= " ... (+$more more)";
    }

    return $text;
}

sub summarise_plain_values {
    my ($R_hash, $max_items) = @_;
    return summarise_count_hash($R_hash, $max_items, 0);
}

sub format_bp_human {
    my ($bases) = @_;
    return "n/a" if !defined $bases || $bases !~ /^\d+(?:\.\d+)?$/;

    if ($bases >= 1_000_000_000) {
        return sprintf("%.2f Gb (%s bp)", $bases / 1_000_000_000, format_int_with_spaces($bases));
    }
    elsif ($bases >= 1_000_000) {
        return sprintf("%.2f Mb (%s bp)", $bases / 1_000_000, format_int_with_spaces($bases));
    }
    elsif ($bases >= 1_000) {
        return sprintf("%.2f kb (%s bp)", $bases / 1_000, format_int_with_spaces($bases));
    }
    else {
        return format_int_with_spaces($bases) . " bp";
    }
}

sub format_int_with_spaces {
    my ($n) = @_;
    return "n/a" if !defined $n || $n !~ /^\d+(?:\.\d+)?$/;

    $n = int($n);
    $n =~ s/\B(?=(\d{3})+(?!\d))/ /g;
    return $n;
}

sub format_total_reads_text {
    my ($pairs, $se_reads) = @_;

    my @parts;
    push @parts, format_int_with_spaces($pairs) . " read pairs" if defined $pairs && $pairs > 0;
    push @parts, format_int_with_spaces($se_reads) . " SE reads" if defined $se_reads && $se_reads > 0;

    return @parts ? join(", ", @parts) : "n/a";
}

sub get_sample_read_totals {
    my ($sample) = @_;

    my $type = uc($sample->{type} // "");
    my $bases = 0;
    my $pairs = 0;
    my $se_reads = 0;

  
    if ($type eq "PE") {
        my $r1_reads = first_defined_numeric(
            $sample->{results}{fastp_rawdata}{read1_before_filtering}{total_reads},
        );

        $bases = first_defined_numeric(
            $sample->{results}{fastp_rawdata}{summary}{before_filtering}{total_bases},
        );



        $pairs = $r1_reads if defined $r1_reads;

    }
    elsif ($type eq "SE") {
        my $reads = first_defined_numeric(
            $sample->{results}{fastp_rawdata}{summary}{before_filtering}{total_reads},
        );

        $bases = first_defined_numeric(
            $sample->{results}{fastp_rawdata}{summary}{before_filtering}{total_bases},
        );

        $se_reads = $reads if defined $reads;

    }
    elsif ($type eq "FASTA") {
       # ignore
    }

    return ($bases, $pairs, $se_reads);
}

sub get_sample_q_aggregates {
    my ($sample) = @_;

    my $type = uc($sample->{type} // "");

    if ($type eq "FASTA") {
        return (0, 0, 0);
    }

    my $q30_rate = first_defined_numeric(
        $sample->{main_results}{qscore}{raw}{q30_rate},
    );

    my $avg_q = first_defined_numeric(
        $sample->{main_results}{qscore}{raw}{av_q_score},
    );

    my ($bases, undef, undef) = get_sample_read_totals($sample);

    return (0, 0, 0) if !defined $bases || $bases <= 0;

    my $q30_bases = 0;
    $q30_bases = $bases * $q30_rate if defined $q30_rate;

    my $q_bases_sum = 0;
    $q_bases_sum = $bases * $avg_q if defined $avg_q;

    return ($bases, $q30_bases, $q_bases_sum);
}

sub get_sample_max_read_length {
    my ($sample) = @_;

    my @candidates = (
        first_defined_numeric($sample->{main_results}{qscore}{raw}{longest_read_len}),
        first_defined_numeric($sample->{results}{fastq_prescan}{R1}{max_length}),
        first_defined_numeric($sample->{results}{fastq_prescan}{R2}{max_length}),
        first_defined_numeric($sample->{results}{fastq_prescan}{SE}{max_length}),
    );

    @candidates = grep { defined $_ } @candidates;
    return undef if !@candidates;

    my $max = $candidates[0];
    foreach my $v (@candidates) {
        $max = $v if $v > $max;
    }

    return $max;
}

sub first_defined_numeric {
    foreach my $v (@_) {
        next if !defined $v;
        next if ref($v);
        next if $v eq '' || $v eq 'n/a';
        return $v + 0 if $v =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
    }
    return undef;
}
###########################################################################

sub short_report_section_versions {
    my ($samplenr) = @_;

    my $sample_name = "";
    if (defined $samplenr && defined $R_samples->[$samplenr]) {
        $sample_name = $R_samples->[$samplenr]{name} // "";
    }

    my $R_run_prov    = $rundata{provenance}{run} || {};
    my $R_sample_prov = $sample_name ne ""
        ? ($rundata{provenance}{samples}{$sample_name} || {})
        : {};

    my $R_tools = merge_provenance_section(
        $R_run_prov->{tools} || {},
        $R_sample_prov->{tools} || {}
    );

    my $R_databases = merge_provenance_section(
        $R_run_prov->{databases} || {},
        $R_sample_prov->{databases} || {}
    );

    my @tool_list = get_sorted_provenance_keys(
        $R_run_prov->{tool_list},
        $R_tools
    );

    my @database_list = get_sorted_provenance_keys(
        $R_run_prov->{database_list},
        $R_databases
    );

    my $html = "";

    ########################################
    # Software table
    $html .= "<table class=\"qc-table\">\n";
    $html .= "<tbody>\n";
    $html .= "<tr><td colspan=\"4\" class=\"rowheading\"><b>Software versions</b></td></tr>\n";
    $html .= "<tr>";
    $html .= "<th>Software</th>";
    $html .= "<th>Conda package</th>";
    $html .= "<th>Version</th>";
    $html .= "<th>Environment</th>";
    $html .= "</tr>\n";

    if (@tool_list) {
        foreach my $tool (@tool_list) {
            my $R_info = $R_tools->{$tool};
            next if !defined $R_info || ref($R_info) ne 'HASH';

            my $package_name = $R_info->{package_name} // "n/a";
            my $version      = $R_info->{version}      // "n/a";
            my $env          = $R_info->{env}          // "n/a";

            $html .= "<tr>";
            $html .= "<td>" . encode_entities($tool) . "</td>";
            $html .= "<td>" . encode_entities($package_name) . "</td>";
            $html .= "<td>" . encode_entities($version) . "</td>";
            $html .= "<td>" . encode_entities($env) . "</td>";
            $html .= "</tr>\n";
        }
    }
    else {
        $html .= "<tr>";
        $html .= "<td colspan=\"4\">n/a</td>";
        $html .= "</tr>\n";
    }

    $html .= "</tbody>\n";
    $html .= "</table>\n";

    ########################################
    # Database table
    $html .= "<table class=\"qc-table\">\n";
    $html .= "<tbody>\n";
    $html .= "<tr><td colspan=\"4\" class=\"rowheading\"><b>Database versions</b></td></tr>\n";
    $html .= "<tr>";
    $html .= "<th>Database</th>";
    $html .= "<th>Version / label</th>";
    $html .= "<th>MD5</th>";
    $html .= "<th>Info</th>";
    $html .= "</tr>\n";

    if (@database_list) {
        foreach my $db (@database_list) {
            my $R_info = $R_databases->{$db};
            next if !defined $R_info || ref($R_info) ne 'HASH';

            my $label = $R_info->{version_label}
                     // $R_info->{description}
                     // "n/a";

            my $md5   = $R_info->{md5} // "n/a";

            my @info_parts;
            push @info_parts, "date: "   . $R_info->{file_date}     if defined $R_info->{file_date}     && $R_info->{file_date} ne "";
            push @info_parts, "size: "   . $R_info->{file_size}     if defined $R_info->{file_size}     && $R_info->{file_size} ne "";
            push @info_parts, "status: " . $R_info->{lookup_status} if defined $R_info->{lookup_status} && $R_info->{lookup_status} ne "";

            my $info = @info_parts ? join(" | ", @info_parts) : "n/a";

            $html .= "<tr>";
            $html .= "<td>" . encode_entities($db) . "</td>";
            $html .= "<td>" . encode_entities($label) . "</td>";
            $html .= "<td>" . encode_entities($md5) . "</td>";
            $html .= "<td>" . encode_entities($info) . "</td>";
            $html .= "</tr>\n";
        }
    }
    else {
        $html .= "<tr>";
        $html .= "<td colspan=\"4\">n/a</td>";
        $html .= "</tr>\n";
    }

    $html .= "</tbody>\n";
    $html .= "</table>\n";

    return $html;
}

sub merge_provenance_section {
    my ($R_run, $R_sample) = @_;

    my %merged;

    if (defined $R_run && ref($R_run) eq 'HASH') {
        foreach my $key (keys %$R_run) {
            if (ref($R_run->{$key}) eq 'HASH') {
                $merged{$key} = { %{ $R_run->{$key} } };
            }
            else {
                $merged{$key} = $R_run->{$key};
            }
        }
    }

    if (defined $R_sample && ref($R_sample) eq 'HASH') {
        foreach my $key (keys %$R_sample) {
            if (ref($R_sample->{$key}) eq 'HASH') {
                $merged{$key} ||= {};
                $merged{$key} = {
                    %{ $merged{$key} || {} },
                    %{ $R_sample->{$key} },
                };
            }
            else {
                $merged{$key} = $R_sample->{$key};
            }
        }
    }

    return \%merged;
}



sub get_sorted_provenance_keys {
    my ($R_preferred_order, $R_hash) = @_;

    my @keys_seen;
    my %seen;

    if (defined $R_preferred_order && ref($R_preferred_order) eq 'ARRAY') {
        foreach my $k (@$R_preferred_order) {
            next if !defined $k || $k eq "";
            push @keys_seen, $k;
            $seen{$k} = 1;
        }
    }

    if (defined $R_hash && ref($R_hash) eq 'HASH') {
        foreach my $k (sort keys %$R_hash) {
            next if $seen{$k};
            push @keys_seen, $k;
            $seen{$k} = 1;
        }
    }

    return @keys_seen;
}





sub main_report_section_sample_overview {
    my $html = "";

    $html .= "<table class=\"overview-table\">\n";
    $html .= "  <thead>\n";
    $html .= "    <tr>\n";
    $html .= "      <th>Sample</th>\n";
    $html .= "      <th>Species</th>\n";
    $html .= "      <th>Typing</th>\n";
    $html .= "      <th>Contamination</th>\n";
    $html .= "      <th>Assembly</th>\n";
    $html .= "      <th>Raw Q30 rate</th>\n";
    $html .= "      <th>Q30+ Coverage</th>\n";
    $html .= "      <th>QC</th>\n";
    $html .= "      <th>Reports</th>\n";
    $html .= "    </tr>\n";
    $html .= "  </thead>\n";
    $html .= "  <tbody>\n";

    my $H = overview_helpers();

    for (my $i = 0; $i < scalar(@$R_samples); $i++) {
        my $sample = $R_samples->[$i];

        $html .= build_sample_overview_row($sample, $H);
    }

    $html .= "  </tbody>\n";
    $html .= "</table>\n";

    return $html;
}

sub build_sample_overview_row {
    my ($sample, $H) = @_;

    my $sample_cell        = build_overview_sample_cell($sample, $H);
    my $species_cell       = build_overview_species_cell($sample, $H);
    my $typing_cell        = build_overview_typing_cell($sample, $H);
    my $contam_cell        = build_overview_contamination_cell($sample, $H);
    my $assembly_cell      = build_overview_assembly_cell($sample, $H);
    my $q30_cell           = build_overview_q30_cell($sample, $H);
    my $coverage_cell      = build_overview_coverage_cell($sample, $H);
    my $qc_cell            = build_overview_qc_cell($sample, $H);
    my $reports_cell       = build_overview_reports_cell($sample, $H);

    my $html = "";
    $html .= "    <tr>\n";
    $html .= $sample_cell;
    $html .= $species_cell;
    $html .= $typing_cell;
    $html .= $contam_cell;
    $html .= $assembly_cell;
    $html .= $q30_cell;
    $html .= $coverage_cell;
    $html .= $qc_cell;
    $html .= $reports_cell;
    $html .= "    </tr>\n";

    return $html;
}

sub build_overview_sample_cell {
    my ($sample, $H) = @_;

    my $esc = $H->{esc};

    my $sample_type_raw = $sample->{type} // "";
    my $sample_name_raw = $sample->{name} // "";

    my %sample_type_label = (
        PE    => "Paired End",
        SE    => "Single End",
        FASTA => "Pre-assembled FASTA file",
    );

    my $sample_type = $sample_type_label{$sample_type_raw} // "unknown";

    my @file_slots;
    if ($sample_type_raw eq "PE") {
        @file_slots = (
            [ "R1", "R1" ],
            [ "R2", "R2" ],
        );
    }
    elsif ($sample_type_raw eq "SE") {
        @file_slots = ([ "SE", "SE" ]);
    }
    elsif ($sample_type_raw eq "FASTA") {
        @file_slots = ([ "FASTA", "Fasta" ]);
    }

    my @tooltip_lines = (
        "Name: " . $esc->($sample_name_raw),
        "Sample type: " . $esc->($sample_type),
    );

    foreach my $slot (@file_slots) {
        my ($key, $label) = @$slot;

        my $path    = $sample->{paths}{raw}{$key}              // "";
        my $created = $sample->{rawdata_stats}{$key}{created}  // "";
        my $size    = $sample->{rawdata_stats}{$key}{filesize} // "";

        push @tooltip_lines, "------------------------";
        push @tooltip_lines, "Rawdata file for $label";
        push @tooltip_lines, "path: " . $esc->($path);
        push @tooltip_lines, "date: " . $esc->($created);
        push @tooltip_lines, "size: " . $esc->(bytes_to_human_readable_filesize($size) . " ($size bytes)");
    }

    my $platform            = $sample->{results}{fastq_prescan}{total}{platform_guess} // "n/a";
    my $instrument_name     = $sample->{results}{fastq_prescan}{total}{instrument} // "n/a";
    my $instrument_nickname = $sample->{results}{fastq_prescan}{total}{machine_alias} // "n/a";
    my $instrument_type     = $sample->{results}{fastq_prescan}{total}{instrument_type_guess} // "n/a";
    my $flowcell            = $sample->{results}{fastq_prescan}{total}{flowcell} // "n/a";
    my $runnr               = $sample->{results}{fastq_prescan}{total}{run_number} // "n/a";
    my $lane                = $sample->{results}{fastq_prescan}{total}{lane} // "n/a";

    my $I7_indexID   = $sample->{samplesheet}{I7_Index_ID} // 'n/a';
    my $I5_indexID   = $sample->{samplesheet}{I5_Index_ID} // 'n/a';

    push @tooltip_lines, "------------------------";
    push @tooltip_lines, "Platform: " . $esc->($platform);
    push @tooltip_lines, "Instrument: " . $esc->($instrument_name);
    push @tooltip_lines, "Instrument nickname: " . $esc->($instrument_nickname);
    push @tooltip_lines, "Instrument type: " . $esc->($instrument_type);
    push @tooltip_lines, "Flowcell: " . $esc->($flowcell);
    push @tooltip_lines, "Run Nr: " . $esc->($runnr);
    push @tooltip_lines, "Lane: " . $esc->($lane);

    if($I7_indexID ne "n/a" && $I5_indexID ne "n/a"){
      push @tooltip_lines, "Illumina indexes: " . $esc->("$I7_indexID, $I5_indexID" );
    }

    my $sample_tooltip = join("&#10;", @tooltip_lines);
    my $sample_celldata = $esc->($sample_name_raw);

    return qq{      <td class="sample-id" title="$sample_tooltip">$sample_celldata</td>\n};
}

sub build_overview_species_cell {
    my ($sample, $H) = @_;

    my $esc         = $H->{esc};
    my $fmt_percent = $H->{fmt_percent};

    my $species_raw        = $sample->{main_results}{taxonomy}{species} // "n/a";
    my $species_method_raw = $sample->{main_results}{taxonomy}{species_method} // "n/a";
    my $species_score_raw  = $sample->{main_results}{taxonomy}{species_score} // "n/a";
    my $genus_raw          = $sample->{main_results}{taxonomy}{genus} // "n/a";
    my $genus_score_raw    = $sample->{main_results}{taxonomy}{genus_score} // "n/a";
    my $genus_method_raw   = $sample->{main_results}{taxonomy}{genus_method} // "n/a";

    my @tooltip_lines = (
        "Species: " . $esc->($species_raw),
        "score: " . $esc->($fmt_percent->($species_score_raw, 1)),
        "method: " . $esc->($species_method_raw),
        "------------------------",
        "Genus: " . $esc->($genus_raw),
        "score: " . $esc->($fmt_percent->($genus_score_raw, 1)),
        "method: " . $esc->($genus_method_raw),
    );

    append_report_issues_to_tooltip_lines($sample, 'taxonomy', \@tooltip_lines);

    my $tooltip = join("&#10;", @tooltip_lines);
    my $level   = get_report_category_level($sample, 'taxonomy');
    my $dot     = warning_level_to_dot_html($level);
    my $cell    = $esc->($species_raw);

    return qq{      <td class="species" title="$tooltip">$cell $dot</td>\n};
}

sub build_overview_typing_cell {
    my ($sample, $H) = @_;

    my $esc = $H->{esc};

    my @tooltip_lines;
    my @celldata_values;

    my $st_raw          = $sample->{main_results}{typing}{mlst}{ST} // "n/a";
    my $cc_raw          = $sample->{main_results}{typing}{mlst}{clonal_complex} // "n/a";
    my $mlst_method_raw = $sample->{main_results}{typing}{mlst}{mlst_method} // "n/a";
    my $mlst_scheme_raw = $sample->{main_results}{typing}{mlst}{scheme} // "n/a";

    my $has_st = defined $st_raw && !ref($st_raw) && $st_raw ne "" && $st_raw ne "n/a";
    my $has_cc = defined $cc_raw && !ref($cc_raw) && $cc_raw ne "" && $cc_raw ne "n/a";

    my $st          = $has_st ? $esc->($st_raw) : "n/a";
    my $cc          = $has_cc ? $esc->($cc_raw) : "n/a";
    my $mlst_method = $has_st ? $esc->($mlst_method_raw) : "n/a";
    my $mlst_scheme = $has_st ? $esc->($mlst_scheme_raw) : "n/a";

    push @tooltip_lines, "MLST";
    if ($has_st) { push @tooltip_lines, "ST: $st"; push @celldata_values, "ST: $st"; }
    if ($has_cc) { push @tooltip_lines, "CC: $cc"; }
    if ($has_st) {
        push @tooltip_lines, "MLST method: $mlst_method";
        push @tooltip_lines, "Scheme: $mlst_scheme";
    }

    my $serotype_raw        = $sample->{main_results}{typing}{serotype}{value}  // "n/a";
    my $serotype_method_raw = $sample->{main_results}{typing}{serotype}{method} // "n/a";
    my $has_serotype = defined $serotype_raw && !ref($serotype_raw) && $serotype_raw ne "" && $serotype_raw ne "n/a";

    push @tooltip_lines, "------------------------";
    push @tooltip_lines, "Serotyping";
    if ($has_serotype) {
        push @tooltip_lines, "Serotype: " . $esc->($serotype_raw);
        push @tooltip_lines, "Method: " . $esc->($serotype_method_raw);
        push @celldata_values, "Serotype: " . $esc->($serotype_raw);
    }







for my $cg (@{ $sample->{main_results}{typing}{cgmlst_schemas} || [] }) {
    my $schema    = $cg->{schema};
    my $call_rate = $cg->{call_rate};
    my $called = $cg->{called};
    my $paralogous = $cg->{paralogous};
    my $inferred_pct = $cg->{inferred_pct};
    my $schema_size    = $cg->{schema_size};

    push @tooltip_lines, "------------------------";
    push @tooltip_lines, "cg/wgMLST";    
    
    push @tooltip_lines, "Schema: " .  $esc->($schema) . " (size=$schema_size)";
    push @tooltip_lines, "Called alleles: " . $esc->($called);    
    push @tooltip_lines, "Call rate: " . $esc->(sprintf("%.1f%%", $call_rate));
    push @tooltip_lines, "Paralogous loci: " . $esc->($paralogous);
    push @tooltip_lines, "Infered percent: " . $esc->(sprintf("%.1f%%",$inferred_pct));
}

    append_report_issues_to_tooltip_lines($sample, 'typing', \@tooltip_lines);

    my $tooltip  = join("&#10;", @tooltip_lines);
    my $celldata = @celldata_values ? join(" | ", @celldata_values) : "n/a";
    my $level    = get_report_category_level($sample, 'typing');
    my $dot      = warning_level_to_dot_html($level);

    return qq{      <td class="typing" title="$tooltip">$celldata $dot</td>\n};
}

sub build_overview_contamination_cell {
    my ($sample, $H) = @_;

    my $esc         = $H->{esc};
    my $fmt_percent = $H->{fmt_percent};
    my $is_number   = $H->{is_number};

    my $contam_species_raw       = $sample->{main_results}{contamination}{species} // "none";
    my $contam_level_raw         = $sample->{main_results}{contamination}{species_level};
    my $contam_genus_raw         = $sample->{main_results}{contamination}{genus} // "none";
    my $contam_genus_level_raw   = $sample->{main_results}{contamination}{genus_level};
    my $contam_genus_method      = $sample->{main_results}{contamination}{genus_method} // "none";
    my $contam_species_method    = $sample->{main_results}{contamination}{species_method} // "none";

    my $contam_numeric = 0;
    $contam_numeric = $contam_level_raw + 0 if $is_number->($contam_level_raw);

    my $contam_numeric_genus = 0;
    $contam_numeric_genus = $contam_genus_level_raw + 0 if $is_number->($contam_genus_level_raw);

    my @tooltip_lines = (
        "Species: " . $esc->($contam_species_raw),
        "Species level: " . $esc->($fmt_percent->($contam_numeric, 1)),
        "Species method: " . $esc->($contam_species_method),
        "Genus: " . $esc->($contam_genus_raw),
        "Genus level: " . $esc->($fmt_percent->($contam_numeric_genus, 1)),
        "Genus method: " . $esc->($contam_genus_method),
    );

    append_report_issues_to_tooltip_lines($sample, 'contamination', \@tooltip_lines);

    my $tooltip  = join("&#10;", @tooltip_lines);
    my $celldata = $esc->($fmt_percent->($contam_numeric, 1));
    my $level    = get_report_category_level($sample, 'contamination');
    my $dot      = warning_level_to_dot_html($level);

    return qq{      <td class="contamination" title="$tooltip">$celldata $dot</td>\n};
}


sub build_overview_assembly_cell {
    my ($sample, $H) = @_;

    my $esc         = $H->{esc};
    my $fmt_mb      = $H->{fmt_mb};
    my $fmt_int     = $H->{fmt_int};
    my $fmt_percent = $H->{fmt_percent};

    my $assembly_size_raw       = $sample->{main_results}{assembly}{size};
    my $assembly_contigs_raw    = $sample->{main_results}{assembly}{contigs} // "n/a";
    my $assembly_n50_raw        = $sample->{main_results}{assembly}{N50} // "n/a";
    my $assembly_gc_raw         = $sample->{main_results}{assembly}{gc} // "n/a";
    my $assembly_kmer_cov_raw   = $sample->{main_results}{assembly}{kmer_cov} // "n/a";
    my $assembly_contigs500_raw = $sample->{main_results}{assembly}{contigs_500} // "n/a";
    my $assembly_method_raw     = $sample->{main_results}{assembly}{method} // "n/a";
    my $assembly_reason_raw     = $sample->{main_results}{assembly}{method_reason} // "n/a";

    my $assembly_size    = $esc->($fmt_mb->($assembly_size_raw));
    my $assembly_contigs = $esc->($assembly_contigs500_raw);

    my $celldata = $assembly_size;
    if (defined $assembly_contigs500_raw && $assembly_contigs500_raw ne "" && $assembly_contigs500_raw ne "n/a") {
        $celldata .= " (" . $assembly_contigs . " ctgs)";
    }

    my @tooltip_lines = (
        "Assembly size: " . $esc->($fmt_int->($assembly_size_raw)),
        "Contigs: " . $esc->($assembly_contigs_raw),
        "Contigs (500+): " . $esc->($assembly_contigs500_raw),
        "N50: " . $esc->($fmt_int->($assembly_n50_raw)),
        "GC: " . $esc->($fmt_percent->($assembly_gc_raw, 1)),
        "Assembly method: " . $esc->($assembly_method_raw),
        "Assembly method reason: " . $esc->($assembly_reason_raw),
    );

    if ($assembly_kmer_cov_raw ne "n/a" && $assembly_kmer_cov_raw ne "") {
        push @tooltip_lines, "k-mer coverage: " . $esc->($assembly_kmer_cov_raw) . "x (strand-specific, ≈½×)";
    }

    append_report_issues_to_tooltip_lines($sample, 'assembly', \@tooltip_lines);

    my $tooltip = join("&#10;", @tooltip_lines);
    my $level   = get_report_category_level($sample, 'assembly');
    my $dot     = warning_level_to_dot_html($level);

    return qq{      <td class="assembly-size" title="$tooltip">$celldata $dot</td>\n};
}

sub build_overview_q30_cell {
    my ($sample, $H) = @_;

    my $esc                   = $H->{esc};
    my $fmt_float             = $H->{fmt_float};
    my $fmt_int               = $H->{fmt_int};
    my $fmt_percent           = $H->{fmt_percent};
    my $fmt_percent_from_rate = $H->{fmt_percent_from_rate};
    my $is_number             = $H->{is_number};

    my $sample_type_raw = $sample->{type} // "";

    my $raw_q30_fraction  = $sample->{main_results}{qscore}{raw}{q30_rate};
    my $raw_n_pct         = $sample->{main_results}{qscore}{raw}{n_pct};
    my $raw_av_read_len   = $sample->{main_results}{qscore}{raw}{av_read_len};
    my $raw_av_q_score    = $sample->{main_results}{qscore}{raw}{av_q_score};
    my $raw_longest       = $sample->{main_results}{qscore}{raw}{longest_read_len};
    my $raw_r1_r2_balance = $sample->{main_results}{qscore}{raw}{R2_R1_read_len_balance};
    my $raw_adapters      = $sample->{main_results}{qscore}{raw}{adapter_pct};
    my $raw_gc            = $sample->{main_results}{qscore}{raw}{gc};

    my $trm_q30_fraction  = $sample->{main_results}{qscore}{trimmed}{q30_rate};
    my $trm_n_pct         = $sample->{main_results}{qscore}{trimmed}{n_pct};
    my $trm_av_read_len   = $sample->{main_results}{qscore}{trimmed}{av_read_len};
    my $trm_av_q_score    = $sample->{main_results}{qscore}{trimmed}{av_q_score};
    my $trm_longest       = $sample->{main_results}{qscore}{trimmed}{longest_read_len};
    my $trm_r1_r2_balance = $sample->{main_results}{qscore}{trimmed}{R2_R1_read_len_balance};
    my $trm_adapters      = $sample->{main_results}{qscore}{trimmed}{adapter_pct};
    my $trm_gc            = $sample->{main_results}{qscore}{trimmed}{gc};

    my $celldata = "n/a";
    if (uc($sample_type_raw) eq "FASTA") {
        $celldata = "n/a (fasta)";
    }
    elsif ($is_number->($raw_q30_fraction)) {
        $celldata = $esc->($fmt_percent_from_rate->($raw_q30_fraction, 0)) .
                    " (Q̄ " . $esc->($fmt_float->($raw_av_q_score, 1)) . ")";
    }

    my @tooltip_lines = (
        "Measure: raw → trimmed/downsampled",
        "Average Q score: " . $esc->($fmt_float->($raw_av_q_score,1)) . " → " . $esc->($fmt_float->($trm_av_q_score,1)),
        "Q30 rate: " . $esc->($fmt_percent_from_rate->($raw_q30_fraction,1)) . " → " . $esc->($fmt_percent_from_rate->($trm_q30_fraction,1)),
        "N rate: " . $esc->($fmt_percent->($raw_n_pct,5)) . " → " . $esc->($fmt_percent->($trm_n_pct,5)),
        "Average read length: " . $esc->($fmt_float->($raw_av_read_len,1)) . " → " . $esc->($fmt_float->($trm_av_read_len,1)),
        "Longest read length: " . $esc->($fmt_int->($raw_longest)) . " → " . $esc->($fmt_int->($trm_longest)),
        "R1–R2 length balance: " . $esc->($fmt_float->($raw_r1_r2_balance,1)) . " → " . $esc->($fmt_float->($trm_r1_r2_balance,1)),
        "Adapter content: " . $esc->($fmt_percent->($raw_adapters,2)) . " → " . $esc->($fmt_percent->($trm_adapters,2)),
        "GC: " . $esc->($fmt_percent->($raw_gc,1)) . " → " . $esc->($fmt_percent->($trm_gc,1)),
    );

    append_report_issues_to_tooltip_lines($sample, 'qscore', \@tooltip_lines);

    my $tooltip = join("&#10;", @tooltip_lines);
    my $level   = get_report_category_level($sample, 'qscore');
    my $dot     = warning_level_to_dot_html($level);

    return qq{      <td class="q30rate" title="$tooltip">$celldata $dot</td>\n};
}

sub build_overview_coverage_cell {
    my ($sample, $H) = @_;

    my $esc       = $H->{esc};
    my $fmt_float = $H->{fmt_float};

    my $sample_type_raw = $sample->{type} // "";

    my $raw_q30_cov = $sample->{main_results}{coverage}{raw}{q30_coverage} // "n/a";
    my $raw_cov     = $sample->{main_results}{coverage}{raw}{coverage} // "n/a";
    my $trm_q30_cov = $sample->{main_results}{coverage}{trimmed}{q30_coverage} // "n/a";
    my $trm_cov     = $sample->{main_results}{coverage}{trimmed}{coverage} // "n/a";

    my $mapped_pct       = $sample->{results}{remap}{mapping}{samtools_stats_sn_picked}{reads_mapped_pct} // "n/a";
    my $properly_paired  = $sample->{results}{remap}{mapping}{samtools_stats_sn_picked}{properly_paired_pct} // "n/a";
    my $insert_size      = $sample->{results}{remap}{mapping}{samtools_stats_sn_picked}{insert_size_average} // "n/a";
    my $mean_depth       = $sample->{results}{remap}{coverage}{depth_mean} // "n/a";
    my $sd_depth         = $sample->{results}{remap}{coverage}{depth_sd} // "n/a";
    my $breadth_1x_pct   = $sample->{results}{remap}{coverage}{breadth_1x_pct} // "n/a";
    my $breadth_10x_pct  = $sample->{results}{remap}{coverage}{breadth_10x_pct} // "n/a";
    my $breadth_20x_pct  = $sample->{results}{remap}{coverage}{breadth_20x_pct} // "n/a";
    my $breadth_30x_pct  = $sample->{results}{remap}{coverage}{breadth_30x_pct} // "n/a";

    my $q30_cov = "n/a";
    if (uc($sample_type_raw) eq "FASTA") {
        $q30_cov = "n/a (fasta)";
    }
    elsif (defined $raw_q30_cov && $raw_q30_cov =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        $q30_cov = $fmt_float->($raw_q30_cov, 1);
    }

    my $celldata = $esc->($q30_cov);

    my @tooltip_lines = (
        "Measure: raw → trimmed/downsampled",
        "Coverage: " . $esc->($fmt_float->($raw_cov,1)) . " → " . $esc->($fmt_float->($trm_cov,1)),
        "Q30 coverage: " . $esc->($fmt_float->($raw_q30_cov,1)) . " → " . $esc->($fmt_float->($trm_q30_cov,1)),
        "--------------------------",
        "Re-mapping",
        "Re-mapping rate: " . $esc->($fmt_float->($mapped_pct,1)) . "%",
        "Properly paired: " . $esc->($fmt_float->($properly_paired,1)) . "%",
        "Insert size: " . $esc->($fmt_float->($insert_size,0)),
        "Mean depth: " . $esc->($fmt_float->($mean_depth,1)),
        "Depth SD: " . $esc->($fmt_float->($sd_depth,2)),
        "Breadth at 1X: " . $esc->($fmt_float->($breadth_1x_pct,1)) . "%",
        "Breadth at 10X: " . $esc->($fmt_float->($breadth_10x_pct,1)) . "%",
        "Breadth at 20X: " . $esc->($fmt_float->($breadth_20x_pct,1)) . "%",
        "Breadth at 30X: " . $esc->($fmt_float->($breadth_30x_pct,1)) . "%",
    );

    append_report_issues_to_tooltip_lines($sample, 'coverage', \@tooltip_lines);

    my $tooltip = join("&#10;", @tooltip_lines);
    my $level   = get_report_category_level($sample, 'coverage');
    my $dot     = warning_level_to_dot_html($level);

    return qq{      <td class="coverage" title="$tooltip">$celldata $dot</td>\n};
}



sub build_overview_qc_cell {
    my ($sample, $H) = @_;

    my $esc = $H->{esc};

    my $qc_raw   = $sample->{report_issues}{summary}{status} // $sample->{qc}{status} // "UNKNOWN";
    my $qc       = $esc->($qc_raw);
    my $qc_class = qc_status_to_cell_class($qc_raw);

    my @tooltip_lines;
    append_issue_container_to_tooltip_lines($sample->{report_issues}{summary}, \@tooltip_lines, "QC summary");

    if ($sample->{fatal_error}) {
        push @tooltip_lines, "------------------------";
        push @tooltip_lines, "Runtime issues";
        foreach my $msg (@{ $sample->{fatal_error_message} || [] }) {
            push @tooltip_lines, "FAIL: $msg";
        }
        if (($sample->{fatal_error_runstep} // '') ne '') {
            push @tooltip_lines, "Runstep: " . $esc->($sample->{fatal_error_runstep});
        }
    }

    my $qc_tooltip = join("&#10;", @tooltip_lines);

    return qq{      <td class="$qc_class" title="$qc_tooltip">$qc</td>\n};
}

sub build_overview_reports_cell {
    my ($sample, $H) = @_;

    my $esc = $H->{esc};

    my $sample_name = $sample->{name} // "";

    my $short_report_raw    = "samples/${sample_name}_report.html";
    my $detailed_report_raw = "samples/${sample_name}_detailed_report.html";
    my $pdf_report_raw      = "pdf/${sample_name}_report.pdf";

    my $short_report    = $esc->($short_report_raw);
    my $detailed_report = $esc->($detailed_report_raw);
    my $pdf_report      = $esc->($pdf_report_raw);

    return qq{      <td class="report-links"><a href="$short_report">short</a> | <a href="$detailed_report">detailed</a> | <a href="$pdf_report">pdf</a></td>\n};
}




sub get_report_category_level {
    my ($sample, $category) = @_;

    return "ok" if !defined $sample || ref($sample) ne 'HASH';
    return "ok" if !defined $category || $category eq '';

    my $status = $sample->{report_issues}{by_category}{$category}{status} // "PASS";

    return "fail"     if $status eq "FAIL";
    return "critical" if $status eq "CRITICAL";
    return "warning"  if $status eq "WARNING";

    return "ok";
}

sub append_issue_container_to_tooltip_lines {
    my ($R_container, $R_tooltip_lines, $header) = @_;

    return if !defined $R_container || ref($R_container) ne 'HASH';
    return if !defined $R_tooltip_lines || ref($R_tooltip_lines) ne 'ARRAY';

    my $R_issues = $R_container->{issues};
    return if !defined $R_issues || ref($R_issues) ne 'HASH';

    my @issue_lines;

    foreach my $sev (
        [ fail     => 'FAIL' ],
        [ critical => 'CRITICAL' ],
        [ warning  => 'WARNING' ],
    ) {
        my ($key, $label) = @$sev;
        my $R_list = $R_issues->{$key};

        next if !defined $R_list || ref($R_list) ne 'ARRAY' || !@$R_list;

        foreach my $msg (@$R_list) {
            next if !defined $msg || $msg eq '';
            push @issue_lines, "$label: $msg";
        }
    }

    return if !@issue_lines;

    push @$R_tooltip_lines, "------------------------";
    push @$R_tooltip_lines, $header if defined $header && $header ne '';
    push @$R_tooltip_lines, @issue_lines;
}

sub append_report_issues_to_tooltip_lines {
    my ($sample, $category, $R_tooltip_lines) = @_;

    return if !defined $sample || ref($sample) ne 'HASH';
    return if !defined $category || $category eq '';
    return if !defined $R_tooltip_lines || ref($R_tooltip_lines) ne 'ARRAY';

    my $R_cat = $sample->{report_issues}{by_category}{$category};
    append_issue_container_to_tooltip_lines($R_cat, $R_tooltip_lines, "QC issues");
}

sub warning_level_to_dot_html {
    my ($level) = @_;

    $level //= "ok";

    my %class_for = (
        ok       => "qc-good",
        warning  => "qc-warning",
        critical => "qc-critical",
        fail     => "qc-bad",
    );

    my $css_class = $class_for{$level} // "qc-good";
    return "<span class=\"qc-dot $css_class\"></span>";
}

sub overview_helpers {
    return {
        esc => sub {
            my ($x) = @_;
            return encode_entities(defined $x ? $x : "");
        },

        is_number => sub {
            my ($x) = @_;
            return 0 unless defined $x;
            return 0 if $x eq "";
            return $x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
        },

        fmt_mb => sub {
            my ($bases) = @_;
            return "n/a" unless defined $bases && $bases =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
            return sprintf("%.2f Mb", $bases / 1_000_000);
        },

        fmt_int => sub {
            my ($n) = @_;
            return "n/a" unless defined $n && $n =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
            $n = int($n);
            $n =~ s/\B(?=(\d{3})+(?!\d))/ /g;
            return $n;
        },

        fmt_float => sub {
            my ($n, $decimals) = @_;
            $decimals //= 1;
            return "n/a" unless defined $n && $n =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
            return sprintf("%.*f", $decimals, $n);
        },

        fmt_percent_from_rate => sub {
            my ($x, $decimals) = @_;
            $decimals //= 1;
            return "n/a" unless defined $x && $x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
            return sprintf("%.*f%%", $decimals, $x * 100);
        },

        fmt_percent => sub {
            my ($n, $decimals) = @_;
            $decimals //= 1;
            return "n/a" unless defined $n && $n =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
            return sprintf("%.*f%%", $decimals, $n);
        },
    };
}

sub get_warning_level_from_list {
    my ($warnings_ref) = @_;

    return "ok" unless defined $warnings_ref && ref($warnings_ref) eq "ARRAY" && @$warnings_ref;

    my $level = "ok";

    foreach my $msg (@$warnings_ref) {
        next unless defined $msg;

        if ($msg =~ /^FAIL:/i) {
            return "fail";
        }
        elsif ($msg =~ /^CRITICAL:/i) {
            $level = "critical" unless $level eq "fail";
        }
        elsif ($msg =~ /^WARNING:/i) {
            $level = "warning" unless $level eq "fail" || $level eq "critical";
        }
    }

    return $level;
}

sub warning_level_to_cell_class {
    my ($level) = @_;

    $level //= "ok";

    my %class_for = (
        ok       => "qc-good",
        warning  => "qc-warning",
        critical => "qc-critical",
        fail     => "qc-bad",
    );

    return $class_for{$level} // "qc-good";
}

sub qc_status_to_cell_class {
    my ($status) = @_;

    $status = uc($status // "");

    return "qc-bad"      if $status eq "FAIL";
    return "qc-critical" if $status eq "CRITICAL";
    return "qc-warning"  if $status eq "WARNING";
    return "qc-good"     if $status eq "PASS" || $status eq "OK";
    return "qc-unknown";
}
####################################################################################################

sub refresh_summary_derived_data {

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {

        # Rebuild threshold expectations from current config
        load_expectations($samplenr);

        # Re-evaluate QC/report issues from loaded main_results
        evaluate_sample_qc($samplenr);


    }

    return 1;
}

sub print_sample_shortreports {

    my $number_samples = scalar @$R_samples;

    my $env_path      = $ENV{CONDA_PREFIX} // "";
    my $env_path_base = $env_path;
    $env_path_base =~ s{/[^/]*$}{};
    $env_path_base =~ s{/[^/]*$}{};

    my $template_file = "$env_path_base/share/eurlc-wgs/templates/short_report.html.tt";

    my $report_dir  = get_report_dir();
    my $samples_dir = get_report_samples_dir();
    my $pdf_dir     = get_report_pdf_dir();
    my $assets_dir  = get_report_assets_dir();

    ensure_dir($report_dir);
    ensure_dir($samples_dir);
    ensure_dir($pdf_dir);
    ensure_dir($assets_dir);

    install_report_assets($assets_dir);

    open my $tfh, '<', $template_file
        or graceful_die("Could not open template $template_file: $!");
    my $template_content = do { local $/; <$tfh> };
    close $tfh;

    log_message("NOTICE: Printing short report for $number_samples samples");

    for (my $i = 0; $i < $number_samples; $i++) {

        my $sample = $R_samples->[$i];

        my $sample_name_raw = $sample->{name} // "sample_$i";
        my $sample_name     = encode_entities($sample_name_raw);
        my $sample_type     = $sample->{type} // "unknown";

        log_message("INFO: Printing short report for sample $sample_name [$sample_type]", "magenta");

        my $report_html = $template_content;

        my $sample_status = $sample->{report_issues}{summary}{status}
                         // $sample->{qc}{status}
                         // "UNKNOWN";

        my $content = short_report_build_sample_report($i);

        # Paths are relative from report/samples/*.html
        $report_html =~ s/\Q{{css_file}}\E/..\/assets\/style.css/g;
        $report_html =~ s/\Q{{main_css_file}}\E/..\/assets\/mainreport.css/g;
        $report_html =~ s/\Q{{pipeline_logo_file}}\E/..\/assets\/eurlc-wgs-logo.png/g;
        $report_html =~ s/\Q{{favicon_file}}\E/..\/assets\/favicon.png/g;

        $report_html =~ s/\Q{{sample_info.sample_name}}\E/$sample_name/g;
        $report_html =~ s/\Q{{sample_status}}\E/encode_entities($sample_status)/ge;
        $report_html =~ s/\Q{{sample_report_content}}\E/$content/g;

        # Backward-compatible placeholders
        $report_html =~ s/\Q{{results_table}}\E/$content/g;
        $report_html =~ s/\Q{{quality_table}}\E//g;
        $report_html =~ s/\Q{{versions_table}}\E/short_report_section_versions($i)/ge;

        my $outfile = "$samples_dir/${sample_name_raw}_report.html";

        open my $fh, '>', $outfile or do {
            log_message("ERROR: Could not write report $outfile", "red");
            next;
        };

        print $fh $report_html;
        close $fh;

        log_message("INFO: HTML report written to $outfile", "green");

        my $pdffile   = "$pdf_dir/${sample_name_raw}_report.pdf";
        my $weasy_env = "eurlc-wgs-weasyprint";

        my $cmd = "conda run -n $weasy_env weasyprint \"$outfile\" \"$pdffile\" __HIDE-STDERR__";
        $cmd = fill_placeholders($cmd);

        my $res = system($cmd);

        if ($res == 0) {
            log_message("INFO: PDF report written to $pdffile", "green");
        }
        else {
            log_message("WARNING: Could not produce PDF for $sample_name_raw", "yellow");
        }
    }

    return 1;
}

####################################################################################################

sub short_report_build_sample_report {
    my ($i) = @_;

    my $sample = $R_samples->[$i];
    my $H = overview_helpers();

    my $html = "";

    $html .= short_report_section_sample_summary($sample, $H);
    $html .= short_report_section_sample_files($sample, $H);
    $html .= short_report_section_taxonomy($sample, $H);
    $html .= short_report_section_typing($sample, $H);
    $html .= short_report_section_contamination($sample, $H);
    $html .= short_report_section_assembly($sample, $H);
    $html .= short_report_section_qscore($sample, $H);
    $html .= short_report_section_coverage($sample, $H);
    $html .= short_report_section_qc_issues($sample, $H);
    $html .= short_report_section_versions($i);

    return $html;
}

sub short_report_section_start {
    my ($title, $level) = @_;

    $level //= "ok";
    my $dot = warning_level_to_dot_html($level);

    my $html = "";
    $html .= "<h2>" . encode_entities($title) . " $dot</h2>\n";
    $html .= "<table class=\"summary-table short-report-table\">\n";
    $html .= "<tbody>\n";

    return $html;
}

sub short_report_section_end {
    return "</tbody>\n</table>\n";
}

sub short_report_row {
    my ($label, $value) = @_;

    $label = encode_entities(defined $label ? $label : "");
    $value = encode_entities(defined $value ? $value : "n/a");

    return "<tr><td class=\"rowheading\">$label</td><td>$value</td></tr>\n";
}

sub short_report_raw_row {
    my ($label, $html_value) = @_;

    $label = encode_entities(defined $label ? $label : "");
    $html_value = defined $html_value ? $html_value : "n/a";

    return "<tr><td class=\"rowheading\">$label</td><td>$html_value</td></tr>\n";
}

sub short_report_section_sample_summary {
    my ($sample, $H) = @_;

    my $status = $sample->{report_issues}{summary}{status}
              // $sample->{qc}{status}
              // "UNKNOWN";

    my $level = get_report_category_level_from_status($status);

    my $html = short_report_section_start("Sample summary", $level);

    $html .= short_report_row("Sample name", $sample->{name} // "n/a");
    $html .= short_report_row("Sample type", $sample->{type} // "n/a");
    $html .= short_report_raw_row("Overall QC", encode_entities($status) . " " . warning_level_to_dot_html($level));

    $html .= short_report_row("Pipeline version", get_pipeline_version_for_report());
    $html .= short_report_row("Analysis host", get_hostname_for_report());
    $html .= short_report_row("Analysis user", get_user_for_report());
    $html .= short_report_row("Generated", get_datetime_for_report());

    $html .= short_report_section_end();
    return $html;
}

sub get_report_category_level_from_status {
    my ($status) = @_;

    $status = uc($status // "");

    return "fail"     if $status eq "FAIL";
    return "critical" if $status eq "CRITICAL";
    return "warning"  if $status eq "WARNING";
    return "ok"       if $status eq "PASS" || $status eq "OK";

    return "warning";
}


sub short_report_section_sample_files {
    my ($sample, $H) = @_;

    my $html = short_report_section_start("Sample and sequencing data", "ok");

    my $type = $sample->{type} // "";

    foreach my $slot (
        $type eq "PE"    ? ("R1", "R2") :
        $type eq "SE"    ? ("SE") :
        $type eq "FASTA" ? ("FASTA") :
        ()
    ) {
        $html .= short_report_row("$slot file", $sample->{paths}{raw}{$slot} // "n/a");
        $html .= short_report_row("$slot file date", $sample->{rawdata_stats}{$slot}{created} // "n/a");

        my $size = $sample->{rawdata_stats}{$slot}{filesize};
        if (defined $size && $size ne "") {
            $html .= short_report_row("$slot file size", bytes_to_human_readable_filesize($size) . " ($size bytes)");
        }
    }

    $html .= short_report_row("Platform", $sample->{results}{fastq_prescan}{total}{platform_guess} // "n/a");
    $html .= short_report_row("Instrument", $sample->{results}{fastq_prescan}{total}{instrument} // "n/a");
    $html .= short_report_row("Instrument nickname", $sample->{results}{fastq_prescan}{total}{machine_alias} // "n/a");
    $html .= short_report_row("Instrument type", $sample->{results}{fastq_prescan}{total}{instrument_type_guess} // "n/a");
    $html .= short_report_row("Flowcell", $sample->{results}{fastq_prescan}{total}{flowcell} // "n/a");
    $html .= short_report_row("Run number", $sample->{results}{fastq_prescan}{total}{run_number} // "n/a");
    $html .= short_report_row("Lane", $sample->{results}{fastq_prescan}{total}{lane} // "n/a");

    my $i7 = $sample->{samplesheet}{I7_Index_ID} // "n/a";
    my $i5 = $sample->{samplesheet}{I5_Index_ID} // "n/a";
    $html .= short_report_row("Illumina indexes", "$i7, $i5") if $i7 ne "n/a" || $i5 ne "n/a";

    $html .= short_report_section_end();
    return $html;
}

sub short_report_section_taxonomy {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "taxonomy");
    my $html = short_report_section_start("Taxonomy", $level);

    $html .= short_report_row("Species", $sample->{main_results}{taxonomy}{species} // "n/a");
    $html .= short_report_row("Species score", $H->{fmt_percent}->($sample->{main_results}{taxonomy}{species_score}, 1));
    $html .= short_report_row("Species method", $sample->{main_results}{taxonomy}{species_method} // "n/a");

    $html .= short_report_row("Genus", $sample->{main_results}{taxonomy}{genus} // "n/a");
    $html .= short_report_row("Genus score", $H->{fmt_percent}->($sample->{main_results}{taxonomy}{genus_score}, 1));
    $html .= short_report_row("Genus method", $sample->{main_results}{taxonomy}{genus_method} // "n/a");

    $html .= short_report_issue_rows($sample, "taxonomy");

    $html .= short_report_section_end();
    return $html;
}



sub short_report_section_typing {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "typing");
    my $html = short_report_section_start("Typing", $level);

    $html .= short_report_row("MLST scheme", $sample->{main_results}{typing}{mlst}{scheme} // "n/a");
    $html .= short_report_row("Sequence type ST", $sample->{main_results}{typing}{mlst}{ST} // "n/a");
    $html .= short_report_row("Clonal complex CC", $sample->{main_results}{typing}{mlst}{clonal_complex} // "n/a");
    $html .= short_report_row("MLST method", $sample->{main_results}{typing}{mlst}{mlst_method} // "n/a");

    $html .= short_report_row("Serotype", $sample->{main_results}{typing}{serotype}{value} // "n/a");
    $html .= short_report_row("Serotype method", $sample->{main_results}{typing}{serotype}{method} // "n/a");

    my $R_cg = $sample->{main_results}{typing}{cgmlst_schemas};

    if (defined $R_cg && ref($R_cg) eq "ARRAY" && @$R_cg) {
        my $n = 0;

        foreach my $cg (@$R_cg) {
            $n++;

            my $schema       = $cg->{schema} // "n/a";
            my $schema_size  = $cg->{schema_size} // "n/a";
            my $called       = $cg->{called} // "n/a";
            my $call_rate    = $cg->{call_rate};
            my $paralogous   = $cg->{paralogous} // "n/a";
            my $inferred     = $cg->{inferred} // "n/a";
            my $inferred_pct = $cg->{inferred_pct};
            my $method       = $cg->{method} // "n/a";

            $html .= short_report_raw_row(
                "cg/wgMLST schema $n",
                "<b>" . encode_entities($schema) . "</b>"
            );

            $html .= short_report_row("Schema size", $schema_size);
            $html .= short_report_row("Called alleles", $called);
            $html .= short_report_row("Call rate", $H->{fmt_percent}->($call_rate, 1));
            $html .= short_report_row("Paralogous loci", $paralogous);
            $html .= short_report_row("Inferred alleles", $inferred);
            $html .= short_report_row("Inferred percent", $H->{fmt_percent}->($inferred_pct, 1));
            $html .= short_report_row("cg/wgMLST method", $method);
        }
    }
    else {
        $html .= short_report_row("cg/wgMLST", "n/a");
    }

    $html .= short_report_issue_rows($sample, "typing");

    $html .= short_report_section_end();
    return $html;
}

sub short_report_section_contamination {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "contamination");
    my $html = short_report_section_start("Contamination", $level);

    $html .= short_report_row("Species contaminant", $sample->{main_results}{contamination}{species} // "none");
    $html .= short_report_row("Species contamination level", $H->{fmt_percent}->($sample->{main_results}{contamination}{species_level}, 1));
    $html .= short_report_row("Species contamination method", $sample->{main_results}{contamination}{species_method} // "n/a");

    $html .= short_report_row("Genus contaminant", $sample->{main_results}{contamination}{genus} // "none");
    $html .= short_report_row("Genus contamination level", $H->{fmt_percent}->($sample->{main_results}{contamination}{genus_level}, 1));
    $html .= short_report_row("Genus contamination method", $sample->{main_results}{contamination}{genus_method} // "n/a");

    $html .= short_report_issue_rows($sample, "contamination");

    $html .= short_report_section_end();
    return $html;
}

sub short_report_section_assembly {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "assembly");
    my $html = short_report_section_start("Assembly", $level);

    $html .= short_report_row("Assembly size (Mb)", $H->{fmt_mb}->($sample->{main_results}{assembly}{size}));
    $html .= short_report_row("Assembly size (bases)", $H->{fmt_int}->($sample->{main_results}{assembly}{size}));
    $html .= short_report_row("Contigs (total)", $sample->{main_results}{assembly}{contigs} // "n/a");
    $html .= short_report_row("Contigs 500+", $sample->{main_results}{assembly}{contigs_500} // "n/a");
    $html .= short_report_row("N50", $H->{fmt_int}->($sample->{main_results}{assembly}{N50}));
    $html .= short_report_row("GC", $H->{fmt_percent}->($sample->{main_results}{assembly}{gc}, 1));
    $html .= short_report_row("N rate", $H->{fmt_percent}->($sample->{main_results}{assembly}{n_rate}, 5));
    $html .= short_report_row("k-mer coverage (strand-specific)", ($sample->{main_results}{assembly}{kmer_cov} // "n/a") . "x");
    $html .= short_report_row("Assembly method", $sample->{main_results}{assembly}{method} // "n/a");
    $html .= short_report_row("Assembly method reason", $sample->{main_results}{assembly}{method_reason} // "n/a");

    $html .= short_report_issue_rows($sample, "assembly");

    $html .= short_report_section_end();
    return $html;
}

sub short_report_section_qscore {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "qscore");
    my $html = short_report_section_start("FASTQ quality", $level);

    if (uc($sample->{type} // "") eq "FASTA") {
        $html .= short_report_row("FASTQ quality", "n/a, pre-assembled FASTA input");
        $html .= short_report_section_end();
        return $html;
    }

    foreach my $stage (
        [ raw     => "Raw reads" ],
        [ trimmed => "Trimmed/downsampled reads" ],
    ) {
        my ($key, $label) = @$stage;
        my $R = $sample->{main_results}{qscore}{$key} || {};

        $html .= short_report_raw_row($label, "<b>" . encode_entities($label) . "</b>");
        $html .= short_report_row("Average Q score", $H->{fmt_float}->($R->{av_q_score}, 1));
        $html .= short_report_row("Q30 rate", $H->{fmt_percent_from_rate}->($R->{q30_rate}, 1));
        $html .= short_report_row("N rate", $H->{fmt_percent}->($R->{n_pct}, 5));
        $html .= short_report_row("Average read length", $H->{fmt_float}->($R->{av_read_len}, 1));
        $html .= short_report_row("Longest read length", $H->{fmt_int}->($R->{longest_read_len}));
        $html .= short_report_row("R1/R2 length balance", $H->{fmt_float}->($R->{R2_R1_read_len_balance}, 1));
        $html .= short_report_row("Adapter content", $H->{fmt_percent}->($R->{adapter_pct}, 2));
        $html .= short_report_row("GC", $H->{fmt_percent}->($R->{gc}, 1));
    }

    $html .= short_report_issue_rows($sample, "qscore");

    $html .= short_report_section_end();
    return $html;
}

sub short_report_section_coverage {
    my ($sample, $H) = @_;

    my $level = get_report_category_level($sample, "coverage");
    my $html = short_report_section_start("Coverage and remapping", $level);

    if (uc($sample->{type} // "") eq "FASTA") {
        $html .= short_report_row("Read coverage", "n/a, pre-assembled FASTA input");
    }

    foreach my $stage (
        [ raw     => "Raw reads" ],
        [ trimmed => "Trimmed/downsampled reads" ],
    ) {
        my ($key, $label) = @$stage;
        my $R = $sample->{main_results}{coverage}{$key} || {};

        $html .= short_report_raw_row($label, "<b>" . encode_entities($label) . "</b>");
        $html .= short_report_row("Coverage", $H->{fmt_float}->($R->{coverage}, 1));
        $html .= short_report_row("Q30+ coverage", $H->{fmt_float}->($R->{q30_coverage}, 1));
    }

    my $R_map = $sample->{results}{remap}{mapping}{samtools_stats_sn_picked} || {};
    my $R_cov = $sample->{results}{remap}{coverage} || {};

    $html .= short_report_raw_row("Re-mapping", "<b>Re-mapping</b>");
    $html .= short_report_row("Re-mapping rate", $H->{fmt_percent}->($R_map->{reads_mapped_pct}, 1));
    $html .= short_report_row("Properly paired", $H->{fmt_percent}->($R_map->{properly_paired_pct}, 1));
    $html .= short_report_row("Insert size", $H->{fmt_float}->($R_map->{insert_size_average}, 0));
    $html .= short_report_row("Mean depth", $H->{fmt_float}->($R_cov->{depth_mean}, 1));
    $html .= short_report_row("Depth SD", $H->{fmt_float}->($R_cov->{depth_sd}, 2));
    $html .= short_report_row("Breadth at 1X", $H->{fmt_percent}->($R_cov->{breadth_1x_pct}, 1));
    $html .= short_report_row("Breadth at 10X", $H->{fmt_percent}->($R_cov->{breadth_10x_pct}, 1));
    $html .= short_report_row("Breadth at 20X", $H->{fmt_percent}->($R_cov->{breadth_20x_pct}, 1));
    $html .= short_report_row("Breadth at 30X", $H->{fmt_percent}->($R_cov->{breadth_30x_pct}, 1));

    $html .= short_report_issue_rows($sample, "coverage");

    $html .= short_report_section_end();
    return $html;
}


sub short_report_section_qc_issues {
    my ($sample, $H) = @_;

    my $status = $sample->{report_issues}{summary}{status}
              // $sample->{qc}{status}
              // "UNKNOWN";

    my $level = get_report_category_level_from_status($status);
    my $html = short_report_section_start("QC issues", $level);

    my $R_summary = $sample->{report_issues}{summary};
    my $added = 0;

    if (defined $R_summary && ref($R_summary) eq "HASH") {
        my $R_issues = $R_summary->{issues} || {};

        foreach my $sev (
            [ fail     => "FAIL" ],
            [ critical => "CRITICAL" ],
            [ warning  => "WARNING" ],
        ) {
            my ($key, $label) = @$sev;
            my $R_list = $R_issues->{$key};

            next if !defined $R_list || ref($R_list) ne "ARRAY";

            foreach my $msg (@$R_list) {
                $html .= short_report_raw_row(
                    $label,
                    encode_entities($msg) . " " . warning_level_to_dot_html(lc($key))
                );
                $added++;
            }
        }
    }

    if ($sample->{fatal_error}) {
        foreach my $msg (@{ $sample->{fatal_error_message} || [] }) {
            $html .= short_report_raw_row(
                "Runtime FAIL",
                encode_entities($msg) . " " . warning_level_to_dot_html("fail")
            );
            $added++;
        }
    }

    $html .= short_report_row("QC issues", "none") if !$added;

    $html .= short_report_section_end();
    return $html;
}

sub short_report_issue_rows {
    my ($sample, $category) = @_;

    my $html = "";

    my $R_cat = $sample->{report_issues}{by_category}{$category};
    return "" if !defined $R_cat || ref($R_cat) ne "HASH";

    my $R_issues = $R_cat->{issues};
    return "" if !defined $R_issues || ref($R_issues) ne "HASH";

    foreach my $sev (
        [ fail     => "FAIL",     "fail" ],
        [ critical => "CRITICAL", "critical" ],
        [ warning  => "WARNING",  "warning" ],
    ) {
        my ($key, $label, $level) = @$sev;
        my $R_list = $R_issues->{$key};

        next if !defined $R_list || ref($R_list) ne "ARRAY";

        foreach my $msg (@$R_list) {
            next if !defined $msg || $msg eq "";

            $html .= short_report_raw_row(
                "$label issue",
                encode_entities($msg) . " " . warning_level_to_dot_html($level)
            );
        }
    }

    return $html;
}





sub html_qc_scale_row {
    my ($offset, $label, $value, $pos, $status) = @_;
    my $sp = ' ' x $offset;

    return <<"HTML";
${sp}<tr>
${sp}  <td>$label</td>
${sp}  <td>$value</td>
${sp}  <td><div class="qc-scale"><div class="qc-marker" style="left: ${pos}%;"></div></div></td>
${sp}  <td class="$status">$status</td>
${sp}</tr>
HTML
}
###############
sub scale_to_zone_position {
    my (
        $value,           # measurement_value
        $best,            # best_possible_value
        $worst,           # worst_possible_value
        $green_left,
        $yellow_left,
        $orange_left,
        $red_left,
        $red_right
    ) = @_;

    # -------------------------------------------------------------
    # 1. Normalize the measurement to 0 (best) → 100 (worst)
    # -------------------------------------------------------------

    my $norm;

    if ($best < $worst) {
        # Normal direction: best=0, worst=100
        $norm = 100 * ($value - $best) / ($worst - $best);
        $green_left = 100 * ($green_left - $best) / ($worst - $best);
        $yellow_left = 100 * ($yellow_left - $best) / ($worst - $best);
        $orange_left = 100 * ($orange_left - $best) / ($worst - $best);
        $red_left = 100 * ($red_left - $best) / ($worst - $best);
        $red_right = 100 * ($red_right - $best) / ($worst - $best);
    } else {
        # Reverse direction: flip scale
        $norm = 100 * ($best - $value) / ($best - $worst);
        $green_left = 100 * ($best - $green_left) / ($best - $worst);
        $yellow_left = 100 * ($best - $yellow_left) / ($best - $worst);
        $orange_left = 100 * ($best - $orange_left) / ($best - $worst);
        $red_left = 100 * ($best - $red_left) / ($best - $worst);
        $red_right = 100 * ($best - $red_right) / ($best - $worst);        
    }

    # Clamp to [0,100]
    $norm = 0   if $norm < 0;
    $norm = 100 if $norm > 100;

# print "value=$value, norm=$norm\n";
    # -------------------------------------------------------------
    # 2. Determine zone + boundaries
    # -------------------------------------------------------------

    my ($zone, $category, $left, $right, $zone_base);

    if ($norm <= $green_left) {
        # Full green zone → always 0
        $category = "PASS";
        return (0, $category) ;
    }
    elsif ($norm <= $yellow_left) {
        $zone      = "green";
        $category = "PASS";
        $left      = $green_left;
        $right     = $yellow_left;
        $zone_base = 0;      # green
    }
    elsif ($norm <= $orange_left) {
        $zone      = "yellow";
        $category = "WARNING";
        $left      = $yellow_left;
        $right     = $orange_left;
        $zone_base = 25;     # yellow
    }
    elsif ($norm <= $red_left) {
        $zone      = "orange";
        $category = "CRITICAL";
        $left      = $orange_left;
        $right     = $red_left;
        $zone_base = 50;     # orange
    }
    elsif ($norm <= $red_right) {
        $zone      = "red";
        $category = "FAIL";
        $left      = $red_left;
        $right     = $red_right;
        $zone_base = 75;     # red
    }
    else {
        # Full red zone → always 100
        $category = "FAIL";
        return (100, $category);
    }

    # -------------------------------------------------------------
    # 3. Compute relative position inside the zone (0–25)
    # -------------------------------------------------------------

    my $rel;
    if ($right == $left) {
        # Avoid accidental division by zero
        $rel = 0;
    } else {
        $rel = 25 * ($norm - $left) / ($right - $left);
    }

    # Clamp rel just in case
    $rel = 0  if $rel < 0;
    $rel = 25 if $rel > 25;

    # -------------------------------------------------------------
    # 4. Final output = zone base + relative offset
    # -------------------------------------------------------------
    my $result = $zone_base + $rel;

    # Should always be 0–100
    $result = 0   if $result < 0;
    $result = 100 if $result > 100;
 
    return ($result,$category);
}
####################
sub get_species(){

    my $i = shift(@_);
    my $local_species = "";

  $local_species= get_kraken2_species($i);
  if($local_species ne "") { return $local_species; }
  
  
  $local_species = get_mashscreen_species($i);
  if($local_species ne "") { return $local_species; }
   
  return "";
}



####################################################################################################

sub get_main_result_value {
    my ($samplenr, $R_path) = @_;

    return undef if !defined $samplenr;
    return undef if !defined $R_samples->[$samplenr];
    return undef if !defined $R_path || ref($R_path) ne 'ARRAY';

    my $value = $R_samples->[$samplenr]{main_results};

    foreach my $key (@$R_path) {
        return undef if !defined $value || ref($value) ne 'HASH' || !exists $value->{$key};
        $value = $value->{$key};
    }

    return $value;
}


sub evaluate_qc_measure {
    my ($samplenr, $measure) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: evaluate_qc_measure called with invalid samplenr");
        return 0;
    }

    if (!defined $measure || $measure eq "") {
        log_message("WARNING: evaluate_qc_measure called without measure");
        return 0;
    }

    if (!exists $QC_MEASURE_DEF{$measure}) {
        log_message("WARNING: evaluate_qc_measure unknown measure [$measure] for sample [$samplenr]");
        return 0;
    }

    my $sample    = $R_samples->[$samplenr];
    my $def       = $QC_MEASURE_DEF{$measure};
    my $path      = $def->{path};
    my $category  = $def->{category};
    my $label     = $def->{label} || $measure;

    my $observed = get_main_result_value($samplenr, $path);
    $sample->{qc_checks}{$measure}{observed} = $observed;

    if (!defined $observed || $observed eq "" || lc($observed) eq "n/a") {
        $sample->{qc_checks}{$measure}{status}  = "NOT_EVALUATED";
        $sample->{qc_checks}{$measure}{message} = "$label: no observed value available";
        return 1;
    }

    my $R_expect = $sample->{qc_expectations}{$measure};
    if (!defined $R_expect || ref($R_expect) ne 'HASH') {
        $sample->{qc_checks}{$measure}{status}  = "NOT_EVALUATED";
        $sample->{qc_checks}{$measure}{message} = "$label: no expectations loaded";
        return 1;
    }

    my $unit = $sample->{qc_checks}{$measure}{unit} // '';
    my $observed_text = format_qc_value($observed, $unit);

    my $R_thresholds = $R_expect->{thresholds} || {};

    my $status  = "PASS";
    my $message = "$label: $observed_text";

    if (defined $R_thresholds->{fail} && threshold_matches($observed, $R_thresholds->{fail})) {
        my $thr_text = format_threshold_text($R_thresholds->{fail});
        $status  = "FAIL";
        $message = "$label is $observed_text, outside fail threshold ($thr_text)";
        set_report_issue($samplenr, $category, "fail", $message);
    }
    elsif (defined $R_thresholds->{critical} && threshold_matches($observed, $R_thresholds->{critical})) {
        my $thr_text = format_threshold_text($R_thresholds->{critical});
        $status  = "CRITICAL";
        $message = "$label is $observed_text, outside critical threshold ($thr_text)";
        set_report_issue($samplenr, $category, "critical", $message);
    }
    elsif (defined $R_thresholds->{warning} && threshold_matches($observed, $R_thresholds->{warning})) {
        my $thr_text = format_threshold_text($R_thresholds->{warning});
        $status  = "WARNING";
        $message = "$label is $observed_text, outside warning threshold ($thr_text)";
        set_report_issue($samplenr, $category, "warning", $message);
    }
    else {
        my $expected_text = format_qc_value($R_expect->{expected}{value}, $R_expect->{expected}{unit});
        $status  = "PASS";
        $message = "$label is $observed_text";
        $message .= " (expected around $expected_text)" if defined $R_expect->{expected}{value};
    }

    $sample->{qc_checks}{$measure}{status}  = $status;
    $sample->{qc_checks}{$measure}{message} = $message;

    return 1;
}


sub evaluate_sample_qc {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: evaluate_sample_qc called with invalid samplenr");
        return 0;
    }

    reset_report_issues($samplenr);

    foreach my $measure (@measures) {
        evaluate_qc_measure($samplenr, $measure);
    }

    sync_qc_from_report_issues($samplenr);

    return 1;
}


sub threshold_matches {
    my ($observed, $R_threshold) = @_;

    return 0 if !defined $R_threshold;
    return 0 if !defined $observed;
    return 0 if ref($observed);
    return 0 if $observed eq '';
    return 0 if lc($observed) eq 'n/a';

    my $obs = _normalize_numeric_value($observed);
    return 0 if !defined $obs;

    my $R_conditions;

    if (ref($R_threshold) eq 'HASH' && exists $R_threshold->{conditions}) {
        # Current/canonical form, as produced by parse_threshold_string().
        $R_conditions = $R_threshold->{conditions};
    }
    elsif (ref($R_threshold) eq 'ARRAY') {
        # LEGACY format from an earlier version of this code, where a
        # threshold was just a bare arrayref of {op,value} conditions with
        # no wrapping hash (no "raw" text kept alongside). No current call
        # site produces this shape -- load_expectations()/parse_threshold_string()
        # always produce the hash form above. Kept for backward compatibility
        # only; safe to remove once confirmed nothing external still relies on it.
        $R_conditions = $R_threshold;
    }
    elsif (!ref($R_threshold)) {
        # LEGACY: allows passing a raw, unparsed config string (e.g. "<30 >31.6")
        # directly instead of a pre-parsed structure. No current call site does
        # this either -- thresholds always go through parse_threshold_string()
        # first. Kept for backward compatibility only; safe to remove once
        # confirmed nothing external still relies on it.
        my $parsed = parse_threshold_string($R_threshold);
        return threshold_matches($observed, $parsed);
    }
    else {
        return 0;
    }

    return 0 if ref($R_conditions) ne 'ARRAY';

    foreach my $cond (@$R_conditions) {
        next if !defined $cond || ref($cond) ne 'HASH';

        my $op    = $cond->{op};
        my $value = $cond->{value};

        next if !defined $op;
        next if !defined $value;

        my $thr = _normalize_numeric_value($value);
        next if !defined $thr;

        return 1 if $op eq '<'  && $obs <  $thr;
        return 1 if $op eq '<=' && $obs <= $thr;
        return 1 if $op eq '>'  && $obs >  $thr;
        return 1 if $op eq '>=' && $obs >= $thr;
        return 1 if $op eq '='  && $obs == $thr;
        return 1 if $op eq '==' && $obs == $thr;
        return 1 if $op eq '!=' && $obs != $thr;
    }

    return 0;
}

sub format_qc_value {
    my ($value, $unit) = @_;

    return 'n/a' if !defined $value || $value eq '';

    $unit //= '';
    return $unit ne '' ? "$value $unit" : "$value";
}

sub format_threshold_text {
    my ($R_threshold) = @_;

    return '' if !defined $R_threshold;

    if (ref($R_threshold) eq 'HASH' && exists $R_threshold->{raw}) {
        # Current/canonical form, as produced by parse_threshold_string().
        return $R_threshold->{raw} // '';
    }

    if (!ref($R_threshold)) {
        # LEGACY: bare unparsed string. No current call site passes this --
        # kept for backward compatibility only; safe to remove once confirmed
        # nothing external still relies on it.
        return $R_threshold;
    }

    if (ref($R_threshold) eq 'ARRAY') {
        # LEGACY: bare arrayref of {op,value} conditions, from an earlier
        # version of this code (reconstructs display text from conditions
        # since there's no "raw" original text in this shape). No current
        # call site produces this shape; kept for backward compatibility
        # only; safe to remove once confirmed nothing external still relies on it.
        my @parts;
        foreach my $cond (@$R_threshold) {
            next if !defined $cond || ref($cond) ne 'HASH';
            next if !defined $cond->{op} || !defined $cond->{value};
            push @parts, "$cond->{op}$cond->{value}";
        }
        return join(" ", @parts);
    }

    return '';
}

sub _normalize_numeric_value {
    my ($value) = @_;

    return undef if !defined $value;
    return undef if ref($value);

    $value =~ s/^\s+|\s+$//g;
    return undef if $value eq '';
    return undef if lc($value) eq 'n/a';

    # Convert comma decimals if they appear
    $value =~ s/,/./g;

    # Extract first numeric token, including scientific notation
    if ($value =~ /([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)/) {
        return $1 + 0;
    }

    return undef;
}

####################################################################################################




sub sample_passes_clustering_filter {
    my ($sample, $mode) = @_;

    $mode //= "pass";

    my $status = $sample->{report_issues}{summary}{status}
              // $sample->{qc}{status}
              // "UNKNOWN";

    $status = uc($status);

    return 1 if $mode eq "all";
    return 1 if $mode eq "pass"   && $status eq "PASS";
    return 1 if $mode eq "usable" && ($status eq "PASS" || $status eq "WARNING");

    return 0;
}





sub main_report_section_clustering {

    my $R_results = $rundata{clustering}{results};

    return "<p>No clustering results available.</p>\n"
        if !defined $R_results || ref($R_results) ne "ARRAY" || !@$R_results;

    my $html = "";

    $html .= "<table class=\"overview-table\">\n";
    $html .= "<thead>\n";
    $html .= "<tr>\n";
    $html .= "<th>Species</th>\n";
    $html .= "<th>Scheme</th>\n";
    $html .= "<th>Interactive view</th>\n";
    $html .= "<th>Downloads</th>\n";
    $html .= "</tr>\n";
    $html .= "</thead>\n<tbody>\n";

    foreach my $entry (@$R_results) {

        my $species = encode_entities($entry->{species} // "n/a");
        my $scheme  = encode_entities($entry->{schema}  // "n/a");

        my $interactive = $entry->{distance_html_interactive} // "";
        $interactive =~ s{^report/}{};
        $interactive = encode_entities($interactive);

        my $download_page = $entry->{clustering_download_page} // "";
        $download_page =~ s{^report/}{};
        $download_page = encode_entities($download_page);

        $html .= "<tr>\n";
        $html .= "<td>$species</td>\n";
        $html .= "<td>$scheme</td>\n";

        $html .= "<td>";
        $html .= $interactive ne ""
            ? qq{<a href="$interactive">🌐 Open matrix viewer</a>}
            : "n/a";
        $html .= "</td>\n";

        $html .= "<td>";
        $html .= $download_page ne ""
            ? qq{<a href="$download_page">📦 Select downloads</a>}
            : "n/a";
        $html .= "</td>\n";

        $html .= "</tr>\n";
    }

    $html .= "</tbody>\n</table>\n";

    return $html;
}


sub write_clustering_download_page {
    my (%args) = @_;

    my $entry     = $args{entry};
    my $html_file = $args{html_file};

    return 0 if !defined $entry || ref($entry) ne "HASH";
    return 0 if !defined $html_file || $html_file eq "";

    my $species = $entry->{species} // "n/a";
    my $scheme  = $entry->{schema}  // "n/a";

    my %files = (
        distance => {
            pass               => $entry->{distance_tsv_pass},
            pass_warn          => $entry->{distance_tsv_pass_warn},
            pass_warn_critical => $entry->{distance_tsv_pass_warn_critical},
            all                => $entry->{distance_tsv_all},
        },
        success => {
            pass               => $entry->{success_tsv_pass},
            pass_warn          => $entry->{success_tsv_pass_warn},
            pass_warn_critical => $entry->{success_tsv_pass_warn_critical},
            all                => $entry->{success_tsv_all},
        },
        alleles => {
            pass               => $entry->{hashed_alleles_pass},
            pass_warn          => $entry->{hashed_alleles_pass_warn},
            pass_warn_critical => $entry->{hashed_alleles_pass_warn_critical},
            all                => $entry->{hashed_alleles_all},
        },
    );

    foreach my $type (keys %files) {
        foreach my $filter (keys %{ $files{$type} }) {
            my $p = $files{$type}{$filter} // "";
            $files{$type}{$filter} = $p ne "" ? "../../$p" : "";
        }
    }

    my $json_files = encode_json(\%files);

    my $html_dir = $html_file;
    $html_dir =~ s{/[^/]+$}{};
    ensure_dir($html_dir);

    open my $out, '>', $html_file or do {
        log_message("WARNING: Could not write clustering download page [$html_file]: $!");
        return 0;
    };

    print $out <<"HTML";
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Clustering downloads</title>

<link rel="icon" type="image/png" href="../assets/favicon.png">
<link rel="stylesheet" href="../assets/style.css">
<link rel="stylesheet" href="../assets/mainreport.css">

<style>
.download-panel {
    margin: 1em 0;
    padding: 1em;
    background: #f5f7fb;
    border-radius: 8px;
}
.download-panel label {
    display: block;
    margin-top: 0.8em;
}
.download-button {
    display: inline-block;
    margin-top: 1em;
    padding: 0.6em 1em;
    background: #1f5f99;
    color: white;
    border-radius: 6px;
    text-decoration: none;
}
.download-button,
.download-button:visited,
.download-button:hover,
.download-button:active {
    color: white !important;
}
.download-note {
    margin-top: 1em;
    color: #555;
    font-size: 0.9em;
}
</style>
</head>

<body class="main-report">

<div class="report-header brand-header">

    <div class="brand-logo">
        <img src="../assets/eurlc-wgs-logo.png" alt="EURLC-WGS logo"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

        <div class="logo-fallback">EURLC-WGS</div>
    </div>

    <div class="brand-text">
        <div class="pipeline-badge">EURLC-WGS Pipeline</div>
        <div class="pipeline-subtitle">Clustering download selector</div>

        <h1>@{[ encode_entities($species) ]}</h1>
        <div class="pipeline-subtitle">Scheme: @{[ encode_entities($scheme) ]}</div>
    </div>

</div>

<div class="download-panel">

    <label>
        File type:
        <select id="fileType" onchange="updateDownloadLink()">
            <option value="distance">Distance matrix</option>
            <option value="success">Comparison success matrix</option>
            <option value="alleles">CRC32 allele table / GrapeTree input</option>
        </select>
    </label>

    <label>
        Sample filter:
        <select id="sampleFilter" onchange="updateDownloadLink()">
            <option value="pass">PASS only</option>
            <option value="pass_warn" selected>PASS + WARNING</option>
            <option value="pass_warn_critical">PASS + WARNING + CRITICAL</option>
            <option value="all">All samples</option>
        </select>
    </label>

    <a id="downloadLink" class="download-button" href="#" download>Download selected TSV</a>

    <div id="missingMessage" class="download-note"></div>

</div>

<script>
const files = $json_files;

function basename(path) {
    return path.split("/").pop();
}

function updateDownloadLink() {
    const type = document.getElementById("fileType").value;
    const filter = document.getElementById("sampleFilter").value;
    const href = files[type][filter];

    const link = document.getElementById("downloadLink");
    const msg = document.getElementById("missingMessage");

    if (href && href !== "") {
        link.href = href;
        link.setAttribute("download", basename(href));
        link.style.display = "inline-block";
        msg.innerHTML = "Selected file: " + basename(href);
    }
    else {
        link.href = "#";
        link.style.display = "none";
        msg.innerHTML = "Selected file is not available.";
    }
}

updateDownloadLink();
</script>

</body>
</html>
HTML

    close $out;

    log_message("INFO: Wrote clustering download page [$html_file]", "green");

    return 1;
}



sub report_link_from_stored_path {
    my ($path) = @_;

    return "" if !defined $path || $path eq "";

    # If already relative to report root
    if ($path =~ s{^report/}{}) {
        return encode_entities($path);
    }

    # Main report is in outdir/report/, so paths relative to outdir need ../
    return encode_entities("../$path");
}

#################################################################################################

sub generate_clustering_html_reports {

    my $R_results = $rundata{clustering}{results};
    return 1 if !defined $R_results || ref($R_results) ne "ARRAY";

    ensure_dir(get_report_clustering_dir());

    foreach my $entry (@$R_results) {

        my $distance_tsv = outpath_from_relative($entry->{distance_tsv_all});
        my $success_tsv  = outpath_from_relative($entry->{success_tsv_all});

        my $html_rel = clustering_html_relpath($entry);
        my $html_abs = outpath_from_relative($html_rel);

        my $threshold = get_clustering_default_threshold($entry);

        write_interactive_clustering_html(
            distance_tsv => $distance_tsv,
            success_tsv  => $success_tsv,
            html_file    => $html_abs,
            title        => "Interactive clustering",
            species      => $entry->{species},
            schema       => $entry->{schema},
            default_distance_threshold => $threshold,
        );

        $entry->{distance_html_interactive} = $html_rel;
        
        my $download_rel = clustering_download_relpath($entry);
        my $download_abs = outpath_from_relative($download_rel);

        write_clustering_download_page(
            entry     => $entry,
            html_file => $download_abs,
        );

        $entry->{clustering_download_page} = $download_rel;
        
    }

    return 1;
}

sub clustering_download_relpath {
    my ($entry) = @_;

    my $species_dirname = safe_filename_part($entry->{species_dirname} // "unknown_species");
    my $scheme          = safe_filename_part($entry->{schema} // "unknown_scheme");

    return "report/clustering/${species_dirname}_${scheme}.downloads.html";
}


