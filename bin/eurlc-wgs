sub estimate_genomesize {

   my ($samplenr) = @_;

    my $sample_type = $R_samples->[$samplenr]{type};     
    my $prespeciescheck_result = $R_samples->[$samplenr]{main_results}{taxonomy}{species};

    ###########################
    ### set the maxdepth
    my $maxdepth = get_config_value_for_species($prespeciescheck_result, 'maxdepth', 0);

    $maxdepth =~ s/[xX\s]+//g if defined $maxdepth;

    if (!defined $maxdepth || $maxdepth !~ /^\d+(?:\.\d+)?$/) {
        $maxdepth = 0;
    }

    $maxdepth = 0 if $maxdepth < 0;

    $R_samples->[$samplenr]{maxdepth} = $maxdepth;
 
    ###########################
    ### set the mindepth
    my $mindepth = get_config_value_for_species($prespeciescheck_result, 'fatal_mindepth', 0);

    $mindepth =~ s/[xX\s]+//g if defined $mindepth;

    if (!defined $mindepth || $mindepth !~ /^\d+(?:\.\d+)?$/) {
        $mindepth = 0;
    }

    $mindepth = 0 if $mindepth < 0;

    $R_samples->[$samplenr]{fatal_mindepth} = $mindepth; 
 
     my $q30mindepth = get_config_value_for_species($prespeciescheck_result, 'fatal_q30_mindepth', 0);

    $q30mindepth =~ s/[xX\s]+//g if defined $q30mindepth;

    if (!defined $q30mindepth || $q30mindepth !~ /^\d+(?:\.\d+)?$/) {
        $q30mindepth = 0;
    }

    $q30mindepth = 0 if $q30mindepth < 0;

    $R_samples->[$samplenr]{fatal_q30_mindepth} = $q30mindepth; 
    
    ###########################
    ### set the gc
    my $gc = get_config_value_for_species($prespeciescheck_result, 'gc', 0);

    $gc =~ s/[%\s]+//g if defined $gc;

    if (!defined $gc || $gc !~ /^\d+(?:\.\d+)?$/) {
        $gc = 0;
    }

    $gc = 0 if $gc < 0;

    $R_samples->[$samplenr]{gc} = $gc; 
 
  
    ############################
    ### set the genomesize
    
    my $genomesize = get_config_value_for_species($prespeciescheck_result, 'genomesize', "auto");
    
    $genomesize  = normalize_genomesize($genomesize);

    if (defined $genomesize && $genomesize ne "" && $genomesize !~ /^(0|auto)$/i) {
      $R_samples->[$samplenr]{estimated_genomesize_method} = "provided estimate for $prespeciescheck_result";
    }  
    elsif ($sample_type eq "FASTA"  ) {
            my $fasta_path = fill_placeholders("__FASTA__",$samplenr);
            my $assemblystats = analyze_assembly_stats($fasta_path);
            $genomesize = (defined $assemblystats && ref($assemblystats) eq 'HASH')
                ? ($assemblystats->{total_length} // 0)
                : 0;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "genomesize of fasta file";
    }    
    else{

        my $R1 = "";
        my $R2 = "";
                
        if($sample_type eq "PE"){
           $R1   = fill_placeholders("__R1__",   $samplenr);
           $R2   = fill_placeholders("__R2__",   $samplenr);
        }  
        if($sample_type eq "SE"){
           $R1   = fill_placeholders("__SE__",   $samplenr);
        }    
        my $base = fill_placeholders("__BASE__", $samplenr);

        check_conda_tool("jellyfish");

        $genomesize = determine_genomesize_jellyfish($R1, $R2, $base);

        if (!defined $genomesize) {
            log_message("WARNING: Failed to determine genomesize, falling back to hard coded default value (5 Mb)", "yellow");
            $genomesize = 5000000;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "fallback default after failed k-mer estimate";
        }
        else {
            $R_samples->[$samplenr]{estimated_genomesize_method} = "k-mer based estimate";
        }
    }       

    
    $R_samples->[$samplenr]{estimated_genomesize} = $genomesize;
    
}

##
##
##    $R_samples->[$samplenr]{estimated_genomesize}
##    $R_samples->[$samplenr]{estimated_genomesize_method}   
##
##
##


sub load_expectations {
    my ($samplenr) = @_;

    my $species = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // '';

    $R_samples->[$samplenr]{qc_expectations} = {};
    $R_samples->[$samplenr]{qc_checks}       = {};

    foreach my $measure (@measures) {
        my %raw;

        foreach my $level (qw(expected warning critical fail)) {
            my $key = "${level}_$measure";
            $raw{$level} = get_config_value_for_species($species, $key);
        }

        my $expected = parse_expected_string($raw{expected});
        my $warning  = parse_threshold_string($raw{warning});
        my $critical = parse_threshold_string($raw{critical});
        my $fail     = parse_threshold_string($raw{fail});


        
        $R_samples->[$samplenr]{qc_expectations}{$measure} = {
            expected   => $expected || {},
            thresholds => {
                warning  => $warning,
                critical => $critical,
                fail     => $fail,
            },
        };

        $R_samples->[$samplenr]{qc_checks}{$measure} = {
            observed => undef,
            unit     => $expected->{unit} // '',
            status   => 'NOT_EVALUATED',
            message  => '',
        };
    }

    return 1;
}

##
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{value}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{unit}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{raw}
##
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{warning}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{critical}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{fail}
##     = undef, if that level has no threshold configured, otherwise:
##     = {
##         conditions => [ { op => '<', value => 30 }, { op => '>', value => 31.6 } ],
##         raw        => '<30 >31.6',   # original config text, used for display
##       }
##     (set by parse_threshold_string(); see threshold_matches() for how
##     conditions are evaluated against an observed value)
##
## $R_samples->[$samplenr]{qc_checks}{$measure}{observed}
## $R_samples->[$samplenr]{qc_checks}{$measure}{unit}
## $R_samples->[$samplenr]{qc_checks}{$measure}{status}
## $R_samples->[$samplenr]{qc_checks}{$measure}{message}
##

sub parse_expected_string {
    my ($text) = @_;

    return {
        value => undef,
        unit  => '',
        raw   => '',
    } unless defined $text && $text ne '';

    $text =~ s/^\s+|\s+$//g;

    my ($value, $unit) = $text =~ /^([<>]?\s*-?\d+(?:\.\d+)?)\s*(.*)$/;

    $unit //= '';
    $unit =~ s/^\s+|\s+$//g;

    return {
        value => defined $value ? $value + 0 : undef,
        unit  => $unit,
        raw   => $text,
    };
}

sub parse_threshold_string {
    my ($text) = @_;

    return undef if !defined $text;
    return undef if ref($text);

    $text =~ s/^\s+|\s+$//g;
    return undef if $text eq '';
    return undef if lc($text) eq 'n/a';

    my @conditions;

    while ($text =~ /(<=|>=|<|>|==|!=|=)\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)/g) {
        push @conditions, {
            op    => $1,
            value => $2 + 0,
        };
    }

    return @conditions
        ? {
            conditions => \@conditions,
            raw        => $text,
        }
        : undef;
}


sub compute_targetbases {

    my ($samplenr) = @_;

    my $setting_targetbases = 0;

    my $genomesize = $R_samples->[$samplenr]{estimated_genomesize};
    my $maxdepth   = $R_samples->[$samplenr]{maxdepth};
    my $method     = $R_samples->[$samplenr]{estimated_genomesize_method} // "";

    if (
        defined $maxdepth &&
        $maxdepth ne "" &&
        $maxdepth !~ /^(0|no|none)$/i &&
        defined $genomesize &&
        $genomesize =~ /^\d+(?:\.\d+)?$/
    ) {
        $setting_targetbases = $maxdepth * $genomesize;

        if ($method eq "k-mer based estimate") {
            my $targetbases_floor = $R_cfg->{species}{default}{targetbases_floor} // 200000000;
            $setting_targetbases = max($setting_targetbases, $targetbases_floor);
        }
    }

    $R_samples->[$samplenr]{targetbases} = int($setting_targetbases);

}


##
##
##   $R_samples->[$samplenr]{targetbases} 
##
##

# Determine genome size estimate from jellyfish histogram
sub determine_genomesize_jellyfish {
    my ($R1, $R2, $basename) = @_;

    my $hist_file = run_jellyfish($R1, $R2, $basename);

    unless (defined $hist_file && -s $hist_file) {
        log_message("WARNING: Jellyfish histogram file missing or empty: $hist_file", "yellow");
        return undef;
    }

    open my $fh, "<", $hist_file or do {
        log_message("WARNING: Could not open jellyfish histogram file: $hist_file ($!)", "yellow");
        return undef;
    };

    my @counts;

    while (<$fh>) {
        chomp;
        next unless /\S/;

        my ($freq, $count) = split;

        # basic sanity check
        next unless defined $count && $count =~ /^\d+(?:\.\d+)?$/;

        push @counts, $count + 0;
    }

    close $fh;

    if (@counts < 10) {
        log_message("WARNING: Jellyfish histogram too small to estimate genome size ($hist_file)", "yellow");
        return undef;
    }

    # Very rough genome size estimation
    my $kmer_sizeestimate = 0;
    for (my $i = 5; $i < @counts; $i++) {
        $kmer_sizeestimate += $counts[$i];
    }

    if ($kmer_sizeestimate <= 0) {
        log_message("WARNING: Jellyfish genome size estimate is zero or invalid ($hist_file)", "yellow");
        return undef;
    }

    return $kmer_sizeestimate / 2;
}


#################################################################################
# Run jellyfish for one sample
sub run_jellyfish {

    my $jellyfish_path            = getdir("out,results,qc,stage1_rawdata") .  "/jellyfish_kmercounts";

    my ($R1, $R2, $basename) = @_;
    my $hist_file = "$jellyfish_path/${basename}_jf.hist";
    my $jf_file   = "$jellyfish_path/${basename}.jf";

    # Build the input command
    my $input_cmd;
    if (defined $R2 && -f $R2) {
        $input_cmd = "zcat $R1 $R2";
    } else {
        $input_cmd = "zcat $R1";
    }


   
    ensure_dir($jellyfish_path);
    
    my $count_cmd = "conda run -n $R_cfg->{jellyfish}->{env} --no-capture-output bash -c \"$input_cmd | jellyfish count /dev/fd/0 -t $R_cfg->{general}->{threads} -s 100M -o $jf_file -m 21\"";

    my $histo_cmd = "conda run -n $R_cfg->{jellyfish}->{env} --no-capture-output jellyfish histo -o $hist_file -f $jf_file";

    execute_and_log("$count_cmd ; $histo_cmd", 0, "Estimating genomesize from k-mer profiles (jellyfish)");


    return $hist_file;
}







