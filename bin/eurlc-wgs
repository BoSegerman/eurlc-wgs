sub find_optional_dir {
    my ($dirname) = @_;

    return undef if !defined $dirname || $dirname eq "";

    my $indir = getdir("in");
    return undef if !defined $indir || $indir eq "";

    my $path = "$indir/$dirname";
    return $path if -d $path;

    return undef;
}

sub load_interop_metrics {

    my $indir = getdir("in");
    return {} if !defined $indir || $indir eq "" || !-d $indir;

    my $interop_dir = "$indir/InterOp";
    return {} if !-d $interop_dir;

    if (!check_conda_tool("interop")) {
        return {};
    }

    my $interop_outdir = getdir("out,results,qc") . "/interop";
    ensure_dir($interop_outdir);

    my $summary_csv       = run_interop_summary($indir, $interop_outdir);
    my $index_summary_csv = run_interop_index_summary($indir, $interop_outdir);

    my %interop;

    if (defined $summary_csv && -s $summary_csv) {
        $interop{summary_csv_file} = $summary_csv;
        $interop{summary}          = parse_interop_summary_file($summary_csv);
    }

    if (defined $index_summary_csv && -s $index_summary_csv) {
        $interop{index_summary_csv_file} = $index_summary_csv;
        $interop{index_summary}          = parse_interop_index_summary_file($index_summary_csv);
    }

    return \%interop;
}

