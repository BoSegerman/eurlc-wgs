    my $db_size = human_readable_filesize($filepath);
    my $db_date = file_date($filepath);

    $rundata{provenance}{run}{databases}{$tool}{filepath}      = $filepath;
    $rundata{provenance}{run}{databases}{$tool}{md5}           = $md5;
    $rundata{provenance}{run}{databases}{$tool}{version_label} = $db_info;
    $rundata{provenance}{run}{databases}{$tool}{lookup_status} = $lookup_status;
    $rundata{provenance}{run}{databases}{$tool}{file_size}     = $db_size;
    $rundata{provenance}{run}{databases}{$tool}{file_date}     = $db_date;

    $rundata{provenance}{run}{database_list} ||= [];
    if (!grep { $_ eq $tool } @{ $rundata{provenance}{run}{database_list} }) {
        push @{ $rundata{provenance}{run}{database_list} }, $tool;
    }

    log_message("INFO: $tool database version=$db_info [$md5]");

    return $db_info;
}
########################################################################################

sub resolve_mashdb {
    my ($path) = @_;

    # Case 1: direct file
    if (-f $path) {
        return $path;
    }

    # Case 2: directory → find .msh files
    if (-d $path) {
        opendir my $dh, $path or do {
            log_message("WARNING: Could not open directory [$path]: $!");
            return "NA";
        };

        my @msh_files = map { "$path/$_" }
                        grep { /\.msh$/i && -f "$path/$_" }
                        readdir $dh;
        closedir $dh;

        if (@msh_files) {
            # pick the largest file
            my ($largest) = sort { -s $b <=> -s $a } @msh_files;
            return $largest;
        }
        else {
            log_message("WARNING: No .msh files found in directory [$path]");
            return "NA";
        }
    }

    # Case 3: path does not exist
    log_message("WARNING: Path [$path] is neither file nor directory");
    return "NA";
}

############################################################################3

sub process_mashhits_file {
    my ($resultfile, $sorted_list_file, $sorted_winnerlist_file, $sample_assess_result_file,$common_assess_result_file,$samplename) = @_;

    ##################### 
    open(my $fh_in, "<", $resultfile) or do {
        log_message("WARNING: mash result file could not be opened [$resultfile]");
        return;
    };

    my @hitlist;
    
    while (my $line = <$fh_in>) {
        chomp $line;
        next unless $line =~ /\t/;
        my @columns = split(/\t/, $line);

        my ($identity, $shared_raw, $multiplicity, $pval, $refgenome, $comment) =
            @columns[0..5];

        # --- ignore flag detection ---
        my $ignore     = 0;
        my $ignoretype = "";
        if ($comment =~ /phage/i)   { $ignore = 1; $ignoretype = "Phage";   }
        if ($comment =~ /virus/i)   { $ignore = 1; $ignoretype = "Virus";   }
        if ($comment =~ /plasmid/i) { $ignore = 1; $ignoretype = "Plasmid"; }
        if ($refgenome =~ /viral/i) { $ignore = 1; $ignoretype = "Viral";   }

        # --- extract "shared/outof" ---
        my ($shared, $outof) = split(/\//, $shared_raw, 2);
        $outof ||= 1;  # avoid divide by zero

        # --- clean comment prefix if bracketed ---
        if ($comment =~ /^\[/) {
            $comment = substr($comment, index($comment, "]") + 2);
        }

        # --- extract species name more robustly ---
        my ($species) = $comment =~ /\b([A-Z][a-z]+ [a-z]+)/;
        $species //= "Unknown species";
        if ($ignore) {
            $species = "## $ignoretype ## ($species)";
        }

        # --- compute hitscore ---
        my $hitscore = sprintf("%.3f", $identity * $shared / $outof);

        # --- format for output ---
        my $value = join("\t",
            $hitscore,
            $species,
            $identity,
            $shared,
            $outof,
            $multiplicity,
            $pval,
            $refgenome,
            $comment
        );

        push @hitlist, $value;
    }  
    close $fh_in;

    ##################
    # --- sort numerically DESCENDING by hitscore ---
    my @sorted = sort {
        (split(/\t/, $b, 2))[0] <=> (split(/\t/, $a, 2))[0]
    } @hitlist;

    ##################
    # --- winner-takes-all: best hit per species ---
    my %best_for_species;
    foreach my $line (@sorted) {
        my @cols = split /\t/, $line;
        my $species = $cols[1];
        next if $species =~ /^##/;        # skip ignored types
        next if exists $best_for_species{$species};
        $best_for_species{$species} = $line;
    }

    # collect winners in sorted order (descending)
    my @sorted_winners = sort {
        (split(/\t/, $b, 2))[0] <=> (split(/\t/, $a, 2))[0]
    } values %best_for_species;

    ##################
    # --- write full sorted file ---
    open(my $fh_out, ">", $sorted_list_file) or do {
        log_message("WARNING: Sorted mash result file could not be created [$sorted_list_file]");
        return;
    };
    
    print $fh_out "Hitscore(Ident*Shared)\tSpecies\tIdentity\tShared_hashes\tOutof\tMultiplicity\tp-val\tReference_ID\tHit_Information\n";
    print $fh_out "$_\n" for @sorted;
    close $fh_out;
    
    ##################
    # --- write winner-takes-all file ---
    open(my $fh_out2, ">", $sorted_winnerlist_file) or do {
        log_message("WARNING: Sorted winners mash result file could not be created [$sorted_winnerlist_file]");
        return;
    };
    
    print $fh_out2 "Hitscore(Ident*Shared)\tSpecies\tIdentity\tShared_hashes\tOutof\tMultiplicity\tp-val\tReference_ID\tHit_Information\n";
    print $fh_out2 "$_\n" for @sorted_winners;
    close $fh_out2;


    
    ##################  
    
    my $assess_mash_screen_status = assess_mash_hits($samplename,\@sorted);
 #   append_assess_status($path, $assess_mash_screen_status);
  
    open(my $fh_assess_all, ">>", $common_assess_result_file) or do {
        log_message("WARNING: Cannot open $common_assess_result_file for appending: $!");
        return;
    };
    
    print $fh_assess_all "$assess_mash_screen_status\n";
    
    close($fh_assess_all);

    ##################  
    
    open(my $fh_assess_smpl, ">", $sample_assess_result_file) or do {
        log_message("WARNING: Cannot open $sample_assess_result_file : $!");
        return;
    };
      print $fh_assess_smpl "$assess_mash_screen_status\n";
    close($fh_assess_smpl);

    ################## 
    
    return 1;    
}

###

################################################################################################

sub assess_mash_hits {
    my ($sample_name, $hit_lines_ref, $min_identity, $score_modifier) = @_;
    $min_identity //= 0.85;       # default if not provided
    $score_modifier //= 0.20;     # default if not provided

    my @hits;
    
    # Parse each line into a hash
    foreach my $line (@$hit_lines_ref) {
        chomp $line;
        next if $line =~ /^Hitscore/;  # skip header
        
        my @cols = split /\t/, $line;
        next unless @cols >= 9;       # sanity check

        my ($hitscore, $species, $identity, $shared, $outof, $multiplicity, $pval, $refid, $hit_info) 
            = @cols[0..8];  # ignore any extra columns

        # Skip ignored species
        next if $species =~ /^(Phage|Virus|Plasmid|Viral)/i;

        # Compute classification score: Hitscore column already identity*shared/outof?
        my $classification_score = $hitscore;  
         
        push @hits, {
            species => $species,
            identity => $identity+0,
            classification_score => $classification_score+0,
        };
    }

    # Return NA if no valid hits remain
    my $nrhits = @hits;

    return "$sample_name\tFAIL\tNA" unless @hits;

    # Sort hits descending by classification_score
    my @sorted = sort { $b->{classification_score} <=> $a->{classification_score} } @hits;

    # Determine threshold based on top hit
    my $threshold = $sorted[0]->{classification_score} - $score_modifier;

    # Keep only hits above min_identity and threshold
    my @top_hits = grep { $_->{identity} > $min_identity && $_->{classification_score} >= $threshold } @sorted;
  $nrhits = @top_hits;

    # Return FAIL if no hits pass
    return "$sample_name\tFAIL\tNA" unless @top_hits;

    # Collect distinct species
    my %species_seen = map { $_->{species} => 1 } @top_hits;
    my @species_list = keys %species_seen;

    # PASS if exactly one species, otherwise FAIL
    if (@species_list == 1) {
        return "$sample_name\tPASS\t$species_list[0]";
    } else {
        return "$sample_name\tFAIL\t" . join(", ", @species_list);
    }
}

#########################

sub append_assess_status {
    my ($path, $status_line) = @_;
    my $dir = dirname($path);
    my $result_file = "$dir/assess_status.txt";

    open(my $fh, ">>", $result_file) or do {
        log_message("WARNING: Cannot open $result_file for appending: $!");
        return;
    };
    print $fh "$status_line\n";
    close($fh);
}


###################################








sub db_exists {
    my ($program) = @_;

   my $env = $R_cfg->{$program}->{env} // "";
   
   my $test = $R_cfg->{$program}->{db_test};
   _fill_placeholders__safe_replace(\$test, "__ENV__", $env);
   $test = fill_placeholders($test);
   
   my $type = $R_cfg->{$program}->{db_test_type} // 'file';



    return -f $test if $type eq 'file';
    return -d $test if $type eq 'dir';

    

    if ($type eq 'command') {
        return system($test . " >/dev/null 2>&1") == 0;
    }

    return 0;
}

sub show_db_info {

    my ($program) = @_;

    my $env = $R_cfg->{$program}->{env} // "";

   my $test = $R_cfg->{$program}->{db_test};
   _fill_placeholders__safe_replace(\$test, "__ENV__", $env);
   $test = fill_placeholders($test);
   
    my $type = $R_cfg->{$program}->{db_test_type} // 'file';
        
   if( -f $test) {
      my $db_size = human_readable_filesize($test);
      my $db_date = file_date($test);
      my $db_version = checkversion_db($test,"$program");
      log_message("NOTICE: $program: Database size $db_size, date $db_date, version $db_version", "green");
   
   }

}

###################################################################################################
## Required vs optional, as a data-driven property
##
## Whether a tool's installation/setup failure should abort the whole run
## (required) or just disable that tool and continue (optional) used to be
## determined entirely by which of two near-duplicate functions happened to
## be called at each site in the main pipeline flow -- not by anything
## visible in the tool's own config. That meant there was no way to tell
## "is kraken2 required?" without reading the source code, and "enabled"
## was effectively meaningless for a required tool (kraken2.enabled=0 was
## silently forced back to 1 elsewhere, regardless of what the config said).
##
## required/optional and enabled/disabled are two different questions:
##   - enabled:  should this tool's runstep run at all in THIS configuration?
##               (always genuinely toggleable, for every tool)
##   - required: IF it's enabled and can't be made to work, should that
##               abort the whole run, or just be skipped?
## A tool can be enabled=0, required=1 -- e.g. kraken2 turned off entirely
## for a fast QC-only profile, where its usual "required" status simply
## doesn't apply because it isn't running at all.
sub check_conda_tool {

  if($R_cfg_general->{test_software} == 0) { 
     return -1; 
  }

   my ($program) = @_;

   my $env = $R_cfg->{$program}->{env};

   ####### sanity check   
   if(! exists $R_cfg->{$program}) {
       graceful_die("Unknown program: $program");
   }
   if(! defined $env || $env eq "") {
       graceful_die("Program: $program does not have an environment defined");
   }
 
  ################## do not double test
    if(exists $tests_performed{$program}  ) {
      if($tests_performed{$program} ==1 ) {
         return 2; 
      }
   }
   $tests_performed{$program} = 1;

   # Defaults to required if unset -- the safer assumption for any tool
   # that doesn't explicitly declare itself optional.
   my $required = $R_cfg->{$program}{required} // 1;

   # On failure: required tools abort immediately via graceful_die (never
   # returns). Optional tools offer to disable themselves and continue,
   # respecting --assume-yes; returns 1 if so (the caller should
   # "return 0" right away), or aborts if the user declines.
   my $fail_or_continue = sub {
       my ($reason) = @_;
       if ($required) {
           graceful_die($reason);
       }
       my $answer = $ASSUME_YES ? 1 : prompt_yes_no("$reason. Do you want to continue without $program?", 1);
       unless ($answer) {
           graceful_die("User chose to abort: $reason");
       }
       $R_cfg->{$program}{enabled} = 0;
       return 1;
   };
  
   ################## test program
   my $status = check_conda_env_and_programs( $env, "$program" );
 
   if ($status == 1) {
       log_message( "INFO: $program program is OK");
   }
   elsif ($status == -1) {
       log_message( "WARNING: $program Environment [$env] does not exist","red");
       unless ( ensure_conda_tool("$program") ) {
           return 0 if $fail_or_continue->("Installation failed for $program");
       }
   }
   elsif ($status == -2) {
       log_message( "WARNING: $program program is missing in environment [$env]. Attempting automatic repair...","red");
       if ( ensure_conda_tool("$program") ) {
           log_message("NOTICE: $program environment repaired successfully", "green");
       }
       else {
           log_message("NOTICE: If the broken environment is not used for other purposes, you may remove it manually and retry");
           log_message("NOTICE: conda env remove -n $env");
           return 0 if $fail_or_continue->("Automatic repair failed for environment [$env]");
       }
   }

   ################## strict version check (opt-in via version_check => "strict")
   unless ( ensure_tool_version($program) ) {
       return 0 if $fail_or_continue->("$program does not match the required pinned version, and automatic reinstall failed");
   }

   ################## test database
   
   my $test = $R_cfg->{$program}->{db_test};
   _fill_placeholders__safe_replace(\$test, "__ENV__", $env);
   $test = fill_placeholders($test);
   
   if($test) {
      
     if ( ! db_exists($program) ) {

       # Need installation. Default answer when actually prompted differs:
       # required tools default to "yes, try downloading"; optional ones
       # default to "no" if the user just hits enter.
       my $install = $ASSUME_YES
           ? 1
           : prompt_yes_no_yesstoall(
              "Database for program $program is missing. Try downloading it?",
              $required
           );

       unless ($install) {
         return 0 if $fail_or_continue->("Downloading the database for $program was declined");
       }

       # Build install command

       my $cmd = $R_cfg->{$program}->{install_db};
       _fill_placeholders__safe_replace(\$cmd, "__ENV__", $env);
       $cmd = fill_placeholders($cmd);

       log_message("NOTICE: Downloading database for $program ");
       log_message("DEBUG: $cmd");
       
       if ( exists $R_cfg->{$program}{db_path} && $R_cfg->{$program}{db_path} ne "")  { 
           my $db_p = $R_cfg->{$program}{db_path};
           _fill_placeholders__safe_replace(\$db_p, "__ENV__", $env);
           $db_p = fill_placeholders($db_p);          
           ensure_dir($db_p); 
       }
       
       system($cmd);
       if ($? != 0) {
        log_message("WARNING: Download command exited with error code [$?]", "red");
       }

       # Validate installation
       if( -f $test ){
         log_message("NOTICE: Database for $program was downloaded", "green");
         return 1;
       }
       else {
         return 0 if $fail_or_continue->("Database for $program download failed");
       }
           
           
           
     } # end if dataabasefile do not exist
     else{
        show_db_info($program);
     }
     
      

   }  # end if dataabasefile  defined in config
   

   return 1;
  
}





###################################
sub preprocess_noop {
    my ($sample, $command) = @_;
    # Do something before the command runs
    return $command; # success
}
sub postprocess_noop {
    my ($sample, $command) = @_;
    # Do something before the command runs
    return $command; # success
}

#######################################

#==================================================
# Setters
#==================================================

sub setdir {
    my ($levels_str, $dir) = @_;
    my @levels = _normalize_levels($levels_str);
    $dir = normalize_path($dir);
    _set_path_entry('DIR', $dir, @levels);
}

sub setfile {
    my ($levels_str, $file) = @_;
    my @levels = _normalize_levels($levels_str);
    _set_path_entry('FILE', $file, @levels);
}

sub _set_path_entry {
    my ($type, $path, @levels) = @_;

    my $node = \%paths;
    for my $level (@levels) {
        $node->{$level} ||= {};
        $node = $node->{$level};
    }

    $node->{$type} = $path;
}

#==================================================
# Getters
#==================================================

# Refuses to let any directory under the "out" or "db" registry roots resolve
# to somewhere outside that root (e.g. via a stray "../" in a config value or
# a registration bug). Other roots ("home", "conda", "program", "in") are
# intentionally not confined, since they are not meant to live under out/db.
# A violation is treated as a structural/config error, not a per-sample
# failure, so it halts the pipeline immediately rather than continuing.
sub _check_path_confinement {
    my ($levels_str, $dir) = @_;

    my @levels = _normalize_levels($levels_str);
    my $root_level = $levels[0] // '';
    return unless $root_level eq 'out' || $root_level eq 'db';

    my $root_dir = _get_path_entry('DIR', $root_level);
    return unless $root_dir;   # root not registered yet -- nothing to check against

    my $resolved_dir  = normalize_path($dir);
    my $resolved_root = normalize_path($root_dir);

    return if $resolved_dir eq $resolved_root;
    return if index($resolved_dir, "$resolved_root/") == 0;

    log_message("ERROR: Refusing to create directory outside the '$root_level' root. [$resolved_dir] is not inside [$resolved_root]", "red");
    close_logfile();
    exit 1;
}

sub peekdir {
    my ($levels_str) = @_;
    return getdir($levels_str, 0);
}

sub getdir  { 
   my ($levels_str, $create_if_missing) = @_;
   
   # default: create directory
   $create_if_missing = 1 unless defined $create_if_missing;
    
   my $dir = _get_path_entry('DIR', $levels_str);

   if ($dir && $create_if_missing) {
        _check_path_confinement($levels_str, $dir);
        ensure_dir($dir);
   }
       
   return $dir;
}
sub getfile { 
    my ($levels_str) = @_;
    return _get_path_entry('FILE', $levels_str);
}

sub _get_path_entry {

    
    my ($type, $levels_str) = @_;
    my @levels = _normalize_levels($levels_str);
    my $node = \%paths;

    for my $level (@levels) {
        if (exists $node->{$level}) {
            $node = $node->{$level};
        } else {
            log_message(Carp::shortmess( "WARNING: path level '$level' not found when accessing $levels_str [$type]"));
            return '';
        }
    }

    if (exists $node->{$type}) {
        return $node->{$type};
    } else {
        log_message(Carp::shortmess( "WARNING: entry missing at $levels_str [$type]"));
        return '';
    }
}

#==================================================
# Utility
#==================================================

sub _normalize_levels {
    my ($levels_str) = @_;
    return () unless defined $levels_str && length $levels_str;
    return split(/\s*,\s*/, $levels_str);
}




############################################################################
############################################################################


sub parse_fastqc_results2 {
    my ($path, $sample_ref, $samplenr, $prefix) = @_;

    my %fastqc_data;
    my @adaptercontent = (0, 0, 0, 0, 0, 0);

    unless (-f $path) {
        log_message("WARNING: FastQC result file not found: $path");
        return {};
    }

    open my $fh, "-|", "unzip -p $path */fastqc_data.txt"
        or do {
            log_message("WARNING: Could not open FastQC file: $path ($!)");
            return {};
        };

    my ($captureadaptertype, $total_seq, $total_bases, $seq_len, $gc) = (0, 0, 0, 0, 0);
    my ($current_module, $in_module) = ('', 0);
    my @current_headers;
    my @current_table;
    my @modules;

    while (my $line = <$fh>) {
        chomp $line;

        # ---- Start of module ----
        if ($line =~ /^>>(.+?)\t(\w+)/) {
            $current_module = $1;
            my $status = $2;
            $in_module = 1;
            @current_headers = ();
            @current_table = ();

            $fastqc_data{modules}{$current_module}{status} = $status;
            push @modules, $current_module;

            $captureadaptertype = ($line =~ /^>>Adapter Content/) ? 1 : 0;
            next;
        }

        # ---- End of module ----
        if ($line =~ /^>>END_MODULE/) {
            $in_module = 0;
            if (@current_headers && @current_table) {
                $fastqc_data{modules}{$current_module}{headers} = [@current_headers];
                $fastqc_data{modules}{$current_module}{data}    = [@current_table];
            }
            $captureadaptertype = 0;
            next;
        }

        # ---- Module content ----
        if ($in_module) {
            if ($line =~ /^#/) {
                @current_headers = split /\t/, substr($line, 1);
            }
            elsif ($line ne '') {
                my @cols = split /\t/, $line;
                push @current_table, \@cols;
            }
        }

        # ---- Summary values ----
        if ($line =~ /^Total Sequences/) {
            $fastqc_data{sequences} = (split /\t/, $line)[1];
            $total_seq = $fastqc_data{sequences};
        }
        elsif ($line =~ /^Total Bases/) {
            $fastqc_data{bases} = (split /\t/, $line)[1];
            $total_bases = $fastqc_data{bases};
        }
        elsif ($line =~ /^Sequence length/) {
            $fastqc_data{seqlen} = (split /\t/, $line)[1];
            $seq_len = $fastqc_data{seqlen};
        }
        elsif ($line =~ /^\%GC/) {
            $fastqc_data{gc} = (split /\t/, $line)[1];
            $gc = $fastqc_data{gc};
        }

        # ---- Adapter Content ----
        if ($captureadaptertype && $line !~ /^#/ && $line !~ /^>>/ && $line ne '') {
            my @cols = split /\t/, $line;
            for my $i (1 .. 6) {
                next unless defined $cols[$i];
                next unless looks_like_number($cols[$i]);
                $adaptercontent[$i-1] = $cols[$i] if $cols[$i] > $adaptercontent[$i-1];
            }
        }
    }

    close $fh;

    $fastqc_data{modules}{entries} = \@modules;

    # ---- Store adapter data ----
    my @adapter_names = qw(
        IlluminaUniversalAdapter
        IlluminaSmallRNA3Adapter
        IlluminaSmallRNA5Adapter
        NexteraTransposaseSequence
        PolyA
        PolyG
    );

    for my $i (0 .. $#adapter_names) {
        $fastqc_data{adapters}{$adapter_names[$i]} = $adaptercontent[$i];
    }
    $fastqc_data{adapters}{entries} = \@adapter_names;

# ---- Per base sequence content stability metrics ----
    if (exists $fastqc_data{modules}{'Per base sequence content'}) {

        my $mod = $fastqc_data{modules}{'Per base sequence content'};
        my $headers = $mod->{headers};
        my $data    = $mod->{data};

        # Identify column indices
        my %col_index;
        for my $i (0 .. $#$headers) {
            $col_index{$headers->[$i]} = $i;
        }

        my @bases = qw(A C G T);
        my %values;
        my @selected_rows;

        # ---- Select bins: start >=15 and skip last bin ----
        for my $row (@$data) {
            my $range = $row->[0];   # e.g. "15-19"
            next unless defined $range;

            my ($start) = split /-/, $range;
            next if $start < 15;

            push @selected_rows, $row;
        }

        # Remove last bin
        pop @selected_rows if @selected_rows > 1;

        # ---- Collect values ----
        for my $row (@selected_rows) {
            for my $b (@bases) {
                next unless defined $col_index{$b};
                push @{ $values{$b} }, $row->[ $col_index{$b} ];
            }
        }

        my %mean;
        my %maxdev;
        my $global_maxdev = 0;

        # ---- Calculate mean and max deviation per base ----
        for my $b (@bases) {
            next unless @{ $values{$b} // [] };

            my $sum = 0;
            $sum += $_ for @{ $values{$b} };
            $mean{$b} = $sum / @{ $values{$b} };

            my $maxd = 0;
            for my $v (@{ $values{$b} }) {
                my $d = abs($v - $mean{$b});
                $maxd = $d if $d > $maxd;
            }
            $maxdev{$b} = $maxd;
            $global_maxdev = $maxd if $maxd > $global_maxdev;
        }

        # ---- A/T and G/C balance ----
        my $at_diff = (defined $mean{A} && defined $mean{T})
                    ? abs($mean{A} - $mean{T}) : 0;

        my $gc_diff = (defined $mean{G} && defined $mean{C})
                    ? abs($mean{G} - $mean{C}) : 0;

        # ---- Store results ----
        $fastqc_data{base_content_stability}{mean} = \%mean;
        $fastqc_data{base_content_stability}{max_deviation_per_base} = \%maxdev;
        $fastqc_data{base_content_stability}{max_deviation_any_base} = $global_maxdev;
        $fastqc_data{base_content_stability}{AT_mean_diff} = $at_diff;
        $fastqc_data{base_content_stability}{GC_mean_diff} = $gc_diff;
    }
    
    return \%fastqc_data;
}

sub print_fastqc_results {
    my ($fastqc_data, $stage) = @_;
    $stage //= "";
    
    # Get adapter and module names safely
    my @adapter_names = @{ $fastqc_data->{adapters}{entries} // [] };
    my @module_names  = @{ $fastqc_data->{modules}{entries}  // [] };

    # --- Log module statuses ---
    foreach my $module (@module_names) {
        my $status = $fastqc_data->{modules}{$module}{status} // "NA";
        _log_fastqc_status($module, $status ,"green", $stage);
    }

    # --- Log key summary values ---
    _log_fastqc_status("Sequences",        $fastqc_data->{sequences} );
    _log_fastqc_status("Bases",            $fastqc_data->{bases} );
    _log_fastqc_status("Sequence length",  $fastqc_data->{seqlen} );
    _log_fastqc_status("GC content (%)",   $fastqc_data->{gc} );

    # --- Log adapter contents ---
    foreach my $adapter (@adapter_names) {
        my $value = $fastqc_data->{adapters}{$adapter} // 0;
        my $int_val = int($value);
        if ($int_val >= 1) {
            _log_fastqc_status($adapter, "$int_val%", "yellow");
        }
    }
}

sub _log_fastqc_status{
    my ($name, $value, $def_color, $stage) = @_;
    $value //= "NA";
    $def_color //= "green";
    $stage //= "";

    my $ucval = uc($value);    
    my $color = $def_color;
    
    if    ($ucval eq 'PASS') {  $color = "green";  }
    elsif ($ucval eq 'FAIL') {  $color = "yellow";  }
    elsif ($ucval eq 'WARN') { $color = "yellow"; }

    
    
    if($name eq 'Per base sequence content' && ($ucval eq'FAIL' || $ucval eq'WARN')) {  $value = "$value (OK for nextera based kits)";  }
    if($name eq 'Per tile sequence quality' && ($ucval eq'FAIL' || $ucval eq'WARN') ) {  $value = "$value (Data may be OK anyway)";  }  
    if($name eq 'Sequence Duplication Levels' && ($ucval eq'FAIL' || $ucval eq'WARN') ) {  $value = "$value (May be normal for small genomes at high coverage)";  }     
    if($stage eq 'rawdata' && $name eq 'Adapter Content' && ( $ucval eq'FAIL' || $ucval eq'WARN') ) {  $color = "yellow"; $value = "$value (OK before the trimming-step)";  }  
    
    my $formatted_line = sprintf("%-35s : %-10s", $name, $value);
    log_message("NOTICE: $formatted_line", $color);
}

