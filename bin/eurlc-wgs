$runstep{$runstep_name}{test} = \&test_downsampling;

sub test_downsampling {
   return check_conda_tool("bbmap");
}
  
# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_downsampling;

sub preprocess_downsampling {

    my ($samplenr) = @_;

    my $runstep_name = "downsampling_bbmap";    
    my $sample_name  = $R_samples->[$samplenr]{name};  
    my $sample_type  = $R_samples->[$samplenr]{type};     


    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    
        
    if ($sample_type eq "FASTA") {
        $R_samples->[$samplenr]{downsampled} = 0;
        return "";
    }

    ###################################
    ### check essential requirements
    

 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__R1T__", "__R2T__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__SET__");
    }

    #check for resultfile 

    if ($sample_type eq "PE"
        && -f fill_placeholders("__R1TD__", $samplenr)
        && -f fill_placeholders("__R2TD__", $samplenr)
        && -f $resultfile) {

        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        $R_samples->[$samplenr]{downsampled} = 1;
        postprocess_downsampling($samplenr);
        return "";
    }


     
    if ($sample_type eq "SE"
        && -f fill_placeholders("__SETD__", $samplenr)
        && -f $resultfile) {

        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        $R_samples->[$samplenr]{downsampled} = 1;
        postprocess_downsampling($samplenr);
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    my $tb = $R_samples->[$samplenr]{targetbases};

    if (!defined $tb || $tb eq "" || $tb !~ /^\d+(?:\.\d+)?$/ || $tb <= 0) {
        log_message("NOTICE: Sample $sample_name: targetbases is undefined or 0, skipping downsampling", "yellow");
        $R_samples->[$samplenr]{downsampled} = 0;
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},  $samplenr));
    ensure_dir(dirname($resultfile));
    
    _fill_placeholders__safe_replace(\$command, "__TARGETBASES__", $tb);
    _fill_placeholders__safe_replace(\$command, "__RESULTFILE__", $resultfile);
     
    $command = fill_placeholders($command, $samplenr, $runstep_name); 
    
    
    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_downsampling;

sub postprocess_downsampling {
    my ($samplenr) = @_;

    my $runstep_name = "downsampling_bbmap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type}; 
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    # verify outputfiles
    if ($sample_type eq "PE") {
        if( require_input_files($samplenr, $runstep_name,  "fatal", "__R1TD__", "__R2TD__")){
           $R_samples->[$samplenr]{downsampled} = 1;
        }
    }

    elsif ($sample_type eq "SE") {
        if(require_input_files($samplenr, $runstep_name,  "fatal", "__SETD__")){
           $R_samples->[$samplenr]{downsampled} = 1;        
        }
    }

    my $result_ref = parse_downsampling_results($resultfile);
    return 0 unless defined $result_ref;

    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref;

    # Links used by the HTML reports.
    $result_ref->{txt_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/Downsampling/__BASE__.downsampling.stderr.txt",$samplenr, $runstep_name)); 



    my $target      = $R_samples->[$samplenr]{results}{$runstep_name};
    my $maxdepth    = $R_samples->[$samplenr]{maxdepth};
    my $genomesize  = $R_samples->[$samplenr]{estimated_genomesize};

    my $actual_coverage = undef;
    if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0
        && defined $target->{output_bases} && $target->{output_bases} =~ /^\d+(?:\.\d+)?$/) {
        $actual_coverage = sprintf("%.1f", $target->{output_bases} / $genomesize);
    }

    $R_samples->[$samplenr]{results}{downsampling_bbmap}{actual_coverage} = $actual_coverage;
    
    
    
    
    my $color = "green";
    if (($actual_coverage // 0) < 30) { $color = "yellow"; }


    log_message("NOTICE: Downsampling target ${maxdepth}X", "green");

    if (defined $actual_coverage) {
        log_message("NOTICE: Achieved coverage ${actual_coverage}X", $color);
    }

    if (defined $target->{samplerate}) {
        log_message("NOTICE: Initial samplerate set to $target->{samplerate}","green");
    }
    if (($target->{input_line} // "") ne "") {
        log_message("NOTICE: $target->{input_line}","green");
    }
    if (($target->{output_line} // "") ne "") {
        log_message("NOTICE: $target->{output_line}","green");
    }

    return 1;
}


##
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_bases}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_line}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_reads}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_bases}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_bases_pct}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_line}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_reads}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_reads_pct}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{paired}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{raw}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{samplerate}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{time_seconds}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{actual_coverage}
##
##



# PARSER---------------------------------

sub parse_downsampling_results {
    my ($resultfile) = @_;

    unless (-f $resultfile) {
        log_message("WARNING: Downsampling result file not found: $resultfile");
        return undef;
    }

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: Could not open downsampling result file: $resultfile");
        return undef;
    };

    my $result = {
        samplerate        => undef,
        paired            => undef,
        input_reads       => undef,
        input_bases       => undef,
        output_reads      => undef,
        output_reads_pct  => undef,
        output_bases      => undef,
        output_bases_pct  => undef,
        time_seconds      => undef,
        input_line        => '',
        output_line       => '',
        raw               => [],
    };

    while (my $line = <$fh>) {
        chomp $line;
        push @{ $result->{raw} }, $line;

        if ($line =~ /^Initial samplerate set to\s+([\d.]+)/) {
            $result->{samplerate} = $1 + 0;
            next;
        }

        if ($line =~ /^Input is being processed as paired/i) {
            $result->{paired} = 1;
            next;
        }

        if ($line =~ /^Input is being processed as single/i) {
            $result->{paired} = 0;
            next;
        }

        if ($line =~ /^Input:\s+(\d+)\s+reads\s+(\d+)\s+bases/i) {
            $result->{input_reads} = $1 + 0;
            $result->{input_bases} = $2 + 0;
            $result->{input_line}  = $line;
            next;
        }

        if ($line =~ /^Output:\s+(\d+)\s+reads\s+\(([\d.]+)%\)\s+(\d+)\s+bases\s+\(([\d.]+)%\)/i) {
            $result->{output_reads}     = $1 + 0;
            $result->{output_reads_pct} = $2 + 0;
            $result->{output_bases}     = $3 + 0;
            $result->{output_bases_pct} = $4 + 0;
            $result->{output_line}      = $line;
            next;
        }

        if ($line =~ /^Time:\s+([\d.]+)\s+seconds\./i) {
            $result->{time_seconds} = $1 + 0;
            next;
        }
    }

    close $fh;

    return $result;
}



