## runstep find_species_kraken2


$runstep_name = "find_species_kraken2";

$runstep{$runstep_name} = {
      message    => "Determining species (using kraken2)...",
      long_name  => "species identification (using kraken2)",
      output_dir => "__DIR-QC1__/species_determination_kraken2",
      resultfile => "__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",
      prescan_dir => "__DIR-QC1__/fastq_prescan",
      prescan_resultfile => "__DIR-QC1__/fastq_prescan/__BASE__.prescan.json",
};


# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    zcat __R1__ | head -n 400000 | gzip > __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__
    zcat __R2__ | head -n 400000 | gzip > __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__  
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db $R_cfg->{kraken2}{db_path} 
       --paired __OUTDIR__/tmpR1.fastq.gz __OUTDIR__/tmpR2.fastq.gz 
       > __OUTDIR__/tmp.krakenout.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/kraken2-__BASE__.report  
       -o __OUTDIR__/__BASE__.bracken 
       -r __READLEN__  
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/kraken2-__BASE__.report  
       -o __OUTDIR__/__BASE__.genus.bracken 
       -r __READLEN__  
       -l G
       __HIDE-OUTPUT__       
CMD


$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    zcat __SE__ | head -n 400000 | gzip > __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db $R_cfg->{kraken2}{db_path} 
       __OUTDIR__/tmpSE.fastq.gz  
       > __OUTDIR__/tmp.krakenout.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/kraken2-__BASE__.report 
       -o __OUTDIR__/__BASE__.bracken 
       -r __READLEN__  
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/kraken2-__BASE__.report 
       -o __OUTDIR__/__BASE__.genus.bracken 
       -r __READLEN__  
       -l G
       __HIDE-OUTPUT__       
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env}  --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__  
       --db $R_cfg->{kraken2}{db_path} 
       __FASTA__  
       > __OUTDIR__/tmp.krakenout.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__ 
    rm __OUTDIR__/tmp.krakenout.txt
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_find_species_kraken2;

sub test_find_species_kraken2 {

  check_conda_tool("bracken");
  return check_conda_tool("kraken2");
    
   
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_find_species_kraken2;

sub preprocess_find_species_kraken2 {

    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";

    my $sample_name = $R_samples->[$samplenr]{name};
    my $sample_type = $R_samples->[$samplenr]{type};

    my $command         = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile      = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    my $prescan_json    = fill_placeholders($runstep{$runstep_name}{prescan_resultfile}, $samplenr, $runstep_name);
    my $prescan_dir     = fill_placeholders($runstep{$runstep_name}{prescan_dir}, $samplenr, $runstep_name);

    ###################################
    ### check essential requirements

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__R1__", "__R2__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__SE__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__FASTA__");
    }

    # Skip only if all relevant outputs exist
    if ($sample_type eq "FASTA") {
        if (-f $resultfile) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_find_species_kraken2($samplenr);
            return "";
        }
    }
    else {
        if (-f $resultfile && -f $prescan_json) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_find_species_kraken2($samplenr);
            return "";
        }
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # Ensure output dirs exist
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));
    ensure_dir($prescan_dir) if $sample_type ne "FASTA";

    my $bracken_len = 150;

    ########################################################
    # Run or load prescan for FASTQ samples
    if ($sample_type ne "FASTA") {

        my $prescan_ref;

        if (-f $prescan_json) {
            $prescan_ref = read_json($prescan_json);
        }
        else {
            my $fq1 = $R_samples->[$samplenr]{paths}{raw}{R1} // $R_samples->[$samplenr]{paths}{raw}{SE} // "";
            my $fq2 = $R_samples->[$samplenr]{paths}{raw}{R2} // "";

            # fastq_prescan should write prescan-__BASE__.json under prescan_dir
            $prescan_ref = fastq_prescan($fq1, $fq2, $prescan_dir, $samplenr);
        }

        if ($prescan_ref && ref($prescan_ref) eq 'HASH') {
            $bracken_len = $prescan_ref->{R1}{estimated_bracken_readlength}
                        // $prescan_ref->{SE}{estimated_bracken_readlength}
                        // $prescan_ref->{total}{estimated_bracken_readlength}
                        // 150;
        }

        $R_samples->[$samplenr]{bracken_readlength} = $bracken_len;
    }
    ##############################################################
    
    
    # check for database file
    if (!test_db_kraken2()) {
        log_message("WARNING: Kraken2 database is missing. Kraken2 will be skipped.", "red");
        return "";
    }

    # runstep specific replacements
    _fill_placeholders__safe_replace(\$command, "__READLEN__", $bracken_len);

    # format command
    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}


# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_find_species_kraken2;

sub postprocess_find_species_kraken2 {
    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    my $prescan_json = fill_placeholders($runstep{$runstep_name}{prescan_resultfile}, $samplenr, $runstep_name);

    #################
    # load prescan json and set main_results (FASTQ only)

    if ($sample_type ne "FASTA") {
        if (-f $prescan_json) {
            my $prescan_ref = read_json($prescan_json);
            $R_samples->[$samplenr]{results}{fastq_prescan} = $prescan_ref;

    # Links used by the HTML reports.
    $prescan_ref->{txt_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.txt",$samplenr, $runstep_name)); 
    $prescan_ref->{json_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.json",$samplenr, $runstep_name)); 
    
            if ($prescan_ref && ref($prescan_ref) eq 'HASH') {

                $R_samples->[$samplenr]{main_results}{run_data}{platform_guess}         = $prescan_ref->{total}{platform_guess}         // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{instrument}             = $prescan_ref->{total}{instrument}             // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{instrument_type_guess}  = $prescan_ref->{total}{instrument_type_guess}  // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{machine_alias}          = $prescan_ref->{total}{machine_alias}          // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{flowcell}               = $prescan_ref->{total}{flowcell}               // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{run_number}             = $prescan_ref->{total}{run_number}             // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{lane}                   = $prescan_ref->{total}{lane}                   // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{looks_long_read}        = $prescan_ref->{total}{looks_long_read}        // "n/a";
                $R_samples->[$samplenr]{main_results}{run_data}{long_read_reason}       = $prescan_ref->{total}{long_read_reason}       // "n/a";

                $R_samples->[$samplenr]{main_results}{qscore}{raw}{n_pct}              = $prescan_ref->{total}{n_pct}                  // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_q_score}          = $prescan_ref->{total}{av_q_score}             // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len}         = $prescan_ref->{total}{average}                // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len}        = $prescan_ref->{total}{q3}                     // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len}        = $prescan_ref->{total}{median}                 // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len}        = $prescan_ref->{total}{q1}                     // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len}        = $prescan_ref->{total}{q05}                    // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{adapter_pct}         = $prescan_ref->{total}{adapter_pct}            // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc}                  = $prescan_ref->{total}{gc_pct}                 // "n/a";
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{longest_read_len}    = $prescan_ref->{total}{longest}                // "n/a";

                $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len_rel}     = safe_rel($prescan_ref->{total}{average}, $prescan_ref->{total}{longest}, "n/a");
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len_rel}    = safe_rel($prescan_ref->{total}{q3},      $prescan_ref->{total}{longest}, "n/a");
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len_rel}    = safe_rel($prescan_ref->{total}{median},  $prescan_ref->{total}{longest}, "n/a");
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len_rel}    = safe_rel($prescan_ref->{total}{q1},      $prescan_ref->{total}{longest}, "n/a");
                $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len_rel}    = safe_rel($prescan_ref->{total}{q05},     $prescan_ref->{total}{longest}, "n/a");
            }
            else {
                log_message("WARNING: fastq_prescan JSON could not be parsed for sample $sample_name");
            }
        }
        else {
            log_message("WARNING: fastq_prescan JSON resultfile not found for sample $sample_name");
        }
    }

    #################
    # parse kraken/bracken results
  
    #################
    # parse results

    my $bracken_resultfile = fill_placeholders("__OUTDIR__/__BASE__.bracken",$samplenr,$runstep_name);
    my $bracken_resultfile_genus = fill_placeholders("__OUTDIR__/__BASE__.genus.bracken",$samplenr,$runstep_name);

    if(-f $bracken_resultfile){
      my $bracken_results_ref = parse_bracken_results($bracken_resultfile,'S');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species} = $bracken_results_ref;
      if (!$bracken_results_ref || !%{$bracken_results_ref}) {
        log_message("WARNING: bracken-species (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") { 
         log_message("WARNING: No bracken (pre-check) resultfile (species level) found for sample $sample_name");  
      } 
    }      
    if(-f $bracken_resultfile_genus){
      my $bracken_results_ref_genus = parse_bracken_results($bracken_resultfile_genus,'G');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus} = $bracken_results_ref_genus;
      if (!$bracken_results_ref_genus || !%{$bracken_results_ref_genus}) {
        log_message("WARNING: bracken-genus (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") {     
         log_message("WARNING: No bracken resultfile (genus level) found for sample $sample_name");   
      }
    }  
    if(-f $resultfile){
      my $kraken_results_ref = parse_kraken2_results($resultfile);
      $R_samples->[$samplenr]{results}{$runstep_name}{kraken2} = $kraken_results_ref;
      if (!$kraken_results_ref || !%{$kraken_results_ref}) {
        log_message("WARNING: kraken (pre-check) data could not be parsed for sample $sample_name" );
      }      
    }
    else{
      log_message("WARNING: No kraken2 (pre-check) resultfile found for sample $sample_name");   
      return 0; 
    }  

    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{kraken2_report}         =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{bracken_species_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_species.report",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{bracken_genus_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_genuses.report",$samplenr, $runstep_name)); 
    
    
    #######################################  
    ## assign genus level taxonomy
    my $genus_method = "bracken";
    my $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{name} // "n/a";
    my $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{percent} // 0;    
    my $percent_int = int($genus_result_percent);  
    
    if($genus_result eq "n/a"){   
       $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{name} // "n/a";
       $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{percent} // 0;    
       $percent_int = int($genus_result_percent);
       $genus_method = "kraken2";   
    }
    

    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus} = $genus_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} = $genus_method;  
 

    
    
    #######################################  
    ## assign species level taxonomy  
    my $species_method = "bracken";    
    my $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{name} // "n/a";
    my $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{percent} // 0; 
    $percent_int = int($species_result_percent);   
     
    if($species_result eq "n/a"){
       $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{name} // "n/a";   
       $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{percent}// 0;
       $percent_int = int($species_result_percent); 
       $species_method = "kraken2"; 
    } 
    
       
    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{species} = $species_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = $species_method;  
 

     
    ####################################### 
    # load species dependent info 

    load_expectations($samplenr); 
    estimate_genomesize($samplenr);    
    compute_targetbases($samplenr);

    
    # print/log typical/estimated genomesize 
      my $size = $R_samples->[$samplenr]{estimated_genomesize};
      
      log_message("NOTICE: Sample $sample_name: genus is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{genus} (score $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}%) ","green");  
      log_message("NOTICE: Sample $sample_name: species is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{species} (score $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}%) ","green"); 
      log_message("NOTICE: Sample $sample_name: Size estimate: $size  ($R_samples->[$samplenr]{estimated_genomesize_method}) ","green");   
      log_message("NOTICE: Sample $sample_name: Maximum bases to use: $R_samples->[$samplenr]{targetbases} ","green"); 
      
    return 1; # success
}


sub test_db_kraken2{
  my $testfile_krakendb = fill_placeholders( normalize_path($R_cfg->{kraken2}->{db_path}) . "/hash.k2d" ) ;
  if( !(-f $testfile_krakendb) ){
     return 0;
  }
  return 1;
}

