# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_fastmlst;

sub preprocess_fastmlst {

    my ($samplenr) = @_;

    my $runstep_name = "fastmlst";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $command                 = $runstep{$runstep_name}{cmd_template}{main};
    my $command_alt             = $runstep{$runstep_name}{cmd_template}{alternative};
    my $resultfile              = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    my $all_resultfiles_present = 1;

    if (! -f $resultfile) {
        $all_resultfiles_present = 0;
    }

    foreach my $ambl (@assemblers) {
        my $alt_resultfile = $alt_resultfile_template;
        $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
        $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr);

        my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta", $samplenr);
        if (-f $test_path) {
            if (! -f $alt_resultfile) {
                $all_resultfiles_present = 0;
            }
        }
    }

    if ($all_resultfiles_present) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_fastmlst($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "Optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    foreach my $ambl (@assemblers) {
        my $add_command = $command_alt;
        my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta", $samplenr);

        if (-f $test_path) {
            $add_command =~ s/__ASSEMBLER__/$ambl/g;
            $command = $command . " ; " . $add_command;
        }
    }

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}



# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastmlst;

sub postprocess_fastmlst {
    my ($samplenr) = @_;

    my $runstep_name = "fastmlst";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    # Parse main assembly fastmlst result
    my $main_result_ref = parse_fastmlst($resultfile, $samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name}{main} = $main_result_ref;

    # Parse alternative assembly fastmlst results
    foreach my $ambl (@assemblers) {
        my $alt_resultfile = $alt_resultfile_template;
        $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
        $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr);

        if (-f $alt_resultfile) {
            my $alt_result_ref = parse_fastmlst($alt_resultfile, $samplenr);
            $R_samples->[$samplenr]{results}{$runstep_name}{$ambl} = $alt_result_ref;
        }
    }

    # Select best fastmlst result
    my $selected_from = "main";
    my $selected_ref  = $main_result_ref;

    my $st             = $selected_ref->{st} // "n/a";
    my $schema         = $selected_ref->{schema} // "n/a";
    my $clonal_complex = $selected_ref->{clonal_complex} // "n/a";

    if (!defined $st || $st eq "" || $st eq "n/a" || $st eq "-") {
        foreach my $ambl (@assemblers) {
            next unless exists $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};

            my $alt_ref = $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};
            my $alt_st  = $alt_ref->{st} // "n/a";

            next if !defined $alt_st || $alt_st eq "" || $alt_st eq "n/a" || $alt_st eq "-";

            $selected_from   = $ambl;
            $selected_ref    = $alt_ref;
            $st              = $alt_ref->{st} // "n/a";
            $schema          = $alt_ref->{schema} // "n/a";
            $clonal_complex  = $alt_ref->{clonal_complex} // "n/a";
            last;
        }
    }

    $R_samples->[$samplenr]{results}{$runstep_name}{st}             = $st;
    $R_samples->[$samplenr]{results}{$runstep_name}{schema}         = $schema;
    $R_samples->[$samplenr]{results}{$runstep_name}{clonal_complex} = $clonal_complex;
    $R_samples->[$samplenr]{results}{$runstep_name}{selected_from}  = $selected_from;

    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.results",$samplenr, $runstep_name)); 

    my $spadespath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.spades.results",$samplenr, $runstep_name);
    if(-f $spadespath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{spades_txt_report}   =   path_relative_to_outdir($spadespath); 
    }

    my $shovillspath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.shovill.results",$samplenr, $runstep_name);
    if(-f $shovillspath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{shovill_txt_report}   =   path_relative_to_outdir($shovillspath); 
    }

    my $skesaspath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.skesa.results",$samplenr, $runstep_name);
    if(-f $skesaspath)
    { 
       $R_samples->[$samplenr]{results}{$runstep_name}->{skesa_txt_report}   =   path_relative_to_outdir($skesaspath); 
    }
    
    # Update main_results only if empty; otherwise warn on conflict
    my $old_st     = $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST};
    my $old_scheme = $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme};
    my $old_cc     = $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex};

    my $has_old_st = defined $old_st && $old_st ne "" && $old_st ne "-" && $old_st ne "n/a";
    my $has_old_cc = defined $old_cc && $old_cc ne "" && $old_cc ne "-" && $old_cc ne "n/a";
    
    if ($has_old_st && !$has_old_cc ) {
       $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex} = $clonal_complex;
       $R_samples->[$samplenr]{main_results}{typing}{mlst}{mlst_method} .= "| fastmlst (CC)";
    }
    elsif (!$has_old_st) {
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST}             = $st;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme}         = $schema;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex} = $clonal_complex;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{mlst_method} = "fastmlst";
    }
    else {
        my $conflict = 0;
        $conflict = 1 if $old_st ne $st;

        if ($conflict) {
            push @{ $R_samples->[$samplenr]{warnings} },
                "FastMLST result [$schema / $st / $clonal_complex] from $selected_from conflicts with existing main result [$old_scheme / $old_st / $old_cc]";
        }
    }

    my $color = "green";
    $color = "yellow" if !defined $st || $st eq "" || $st eq "n/a" || $st eq "-";

#    log_message("NOTICE: FastMLST database age: $fastmlst_db_age days", "green");
    if ($selected_from ne "main") {
        log_message("NOTICE: Sample $sample_name: FastMLST source assembly: $selected_from", $color);
    }
    log_message("NOTICE: Sample $sample_name: Schema: $schema", $color);
    log_message("NOTICE: Sample $sample_name: ST Type: $st", $color);
    log_message("NOTICE: Sample $sample_name: Clonal complex: $clonal_complex", $color);

    return 1;
}


# PARSER---------------------------------

sub parse_fastmlst {
    my ($resultfile, $samplenr) = @_;

    my %fastmlst_data;
    my $sample_name = $R_samples->[$samplenr]{name};

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: could not open fastMLST result file for sample $sample_name [$resultfile]");
        return {};
    };

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        # Example:
        # PT38-3.fasta,cjejuni,257,aspA(9),glnA(2),gltA(4),glyA(62),pgm(4),tkt(5),uncA(6),clonal_complex(ST-257 complex)

        my @cols = split /,/, $line;

        # Need at least filename, schema, ST
        next unless @cols >= 3;

        $fastmlst_data{schema} = $cols[1] // "n/a";
        $fastmlst_data{st}     = $cols[2] // "n/a";

        my @allele_names;
        $fastmlst_data{clonal_complex} = "n/a";

        for my $i (3 .. $#cols) {
            my $field = $cols[$i];

            if ($field =~ /^([A-Za-z0-9_]+)\((\d+)\)$/) {
                my ($gene, $id) = ($1, $2);
                $fastmlst_data{"allele_$gene"} = $id;
                push @allele_names, $gene;
            }
            elsif ($field =~ /^clonal_complex\(([^)]+)\)$/) {
                $fastmlst_data{clonal_complex} = $1;
            }
        }

        $fastmlst_data{allele_names} = \@allele_names;

        last;   # one result line per file expected
    }

    close $fh;
    return \%fastmlst_data;
}

