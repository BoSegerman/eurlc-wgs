## runstep check_for_fasta 

$runstep_name = "check_for_fasta";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Adding fasta files to analysis...",
      long_name  => "Adding fasta files to analysis.",
      output_dir => "__DIR-ALTERNATIVE-ASSEMBLIES__/imported",
      resultfile => "__DIR-ALTERNATIVE-ASSEMBLIES__/imported/__BASE__.imported.fasta",
      resultfiles_status => "NA",

      # The fifth real assembler-group member -- the "imported" candidate
      # for FASTA samples (which select_main_assembly's FASTA branch picks
      # unconditionally, since FASTA samples never have a real competing
      # assembler). Mutually exclusive with the other four via applies_if,
      # the same pattern as check_for_no_trimming/check_for_no_downsampling.
      group      => 'assembler',
      requires   => [],
      produces   => [ 'fasta_imported' ],
      applies_if => sub {
          my ($i) = @_;
          return $R_samples->[$i]{type} eq 'FASTA' ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    cp __FASTA__  __DIR-ALTERNATIVE-ASSEMBLIES__/imported/__BASE__.imported.fasta
    __HIDE-OUTPUT__
    __NEWCOMMAND__
    cp __FASTA__  __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.imported.fasta
    __HIDE-OUTPUT__
CMD

