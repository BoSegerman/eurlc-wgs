## runstep check_for_no_trimming

$runstep_name = "check_for_no_trimming";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Preparing rawdata without trimming...",
      long_name  => "Preparing rawdata without trimming",
      output_dir => "__DIR-TRIMMED__",
      resultfile => "",
      resultfiles_status => "NA",

      # Exact complement of fastp_rawdata's applies_if -- exactly one of
      # the two always applies for a given config (for non-FASTA samples).
      requires   => [],
      produces   => [ 'trimmed_fastq' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return ( lc($R_cfg->{general}{trimming} // '') eq 'fastp' && $R_cfg->{fastp}{enabled} ) ? 0 : 1;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    ln -s '__R1__' '__R1T__' 
       $capture_output
    __NEWCOMMAND__   
    ln -s '__R2__' '__R2T__' 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    ln -s '__SE__' '__SET__' 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";
 
# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_notrimming;

sub test_notrimming {

   return 2;  # no testing needed

}
 
# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_notrimming;

sub preprocess_notrimming {

    my ($samplenr) = @_;

    my $runstep_name = "check_for_no_trimming";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};    

    if($R_samples->[$samplenr]{trimmed}){
      return "";
    }
     if($sample_type eq "FASTA"){
      return "";           
    }
        
    if($sample_type eq "PE" && -f fill_placeholders("__R1T__", $samplenr) && -f fill_placeholders("__R2T__", $samplenr)){
      return "";
    }
    if($sample_type eq "SE" && -f fill_placeholders("__SET__", $samplenr)){
      return "";
    }
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
  
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);         

    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_notrimming;

sub postprocess_notrimming {
    my ($samplenr) = @_;

    my $runstep_name = "check_for_no_trimming";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
      
    log_message("NOTICE: No trimming was performed on sample $sample_name","green");
     
    return 1; # success
}



#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep downsampling_bbmap 


$runstep_name = "downsampling_bbmap";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 4 },

      message    => "Downsampling...",
      long_name  => "Downsampling",
      output_dir => "__DIR-TRIMMED-DOWNSAMPLED__",
      resultfile => "__DIR-QC1__/Downsampling/__BASE__.downsampling.stderr.txt",
      resultfiles_status => "NA",

      # requires trimmed_fastq: the command reads __R1T__/__R2T__/__SET__.
      # requires species_determined: downsampling uses species-specific maxdepth
      # from config (e.g. [species__Campylobacter jejuni] maxdepth = 100).
      # Without the species, only the generic maxdepth can be used, which may
      # be wrong. The chain is: prescan + fastp → find_species → downsampling.
      requires   => [ 'trimmed_fastq', 'species_determined' ],
      produces   => [ 'trimmed_downsampled_fastq' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          # Config only. Both schedulers ask applies_if before requires,
          # and in parallel mode a "no" is final -- so it must not depend on
          # data that only exists once the species is known (targetbases).
          # A sample without a usable target (maxdepth 0) is handled in the
          # preprocessing: reads are linked instead of downsampled.
          return $R_cfg->{bbmap}{enabled} ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{bbmap}->{env} --no-capture-output reformat.sh 
       in='__R1T__' 
       in2='__R2T__' 
       out='__R1TD__' 
       out2='__R2TD__' 
       samplebasestarget=__TARGETBASES__ 
       sampleseed=11 
       1>>'__DIR-LOG__/stdout.txt' 
       2>'__RESULTFILE__'
    __NEWCOMMAND__
    cat '__RESULTFILE__' >> '__DIR-LOG__/stderr.txt'
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{bbmap}->{env} --no-capture-output reformat.sh 
       in='__SET__' 
       out='__SETD__' 
       samplebasestarget=__TARGETBASES__ 
       sampleseed=11 
       1>>'__DIR-LOG__/stdout.txt' 
       2>'__RESULTFILE__'
    __NEWCOMMAND__
    cat '__RESULTFILE__' >> '__DIR-LOG__/stderr.txt'
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_downsampling;

sub test_downsampling {
   return check_conda_tool("bbmap");
}
  
# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_downsampling;

sub preprocess_downsampling {

    my ($samplenr) = @_;

    my $runstep_name = "downsampling_bbmap";    
    my $sample_name  = $R_samples->[$samplenr]{name};  
    my $sample_type  = $R_samples->[$samplenr]{type};     


    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    
        
    if ($sample_type eq "FASTA") {
        $R_samples->[$samplenr]{downsampled} = 0;
        return "";
    }

    ###################################
    ### check essential requirements
    

 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__R1T__", "__R2T__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__SET__");
    }

    #check for resultfile 

    if ($sample_type eq "PE"
        && ( reads_removed_by_cleanup($samplenr, 'downsampled_fastq')
             || ( -f fill_placeholders("__R1TD__", $samplenr) && -f fill_placeholders("__R2TD__", $samplenr) ) )
        && -f $resultfile) {

        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        $R_samples->[$samplenr]{downsampled} = 1;
        postprocess_downsampling($samplenr);
        return "";
    }


     
    if ($sample_type eq "SE"
        && ( reads_removed_by_cleanup($samplenr, 'downsampled_fastq') || -f fill_placeholders("__SETD__", $samplenr) )
        && -f $resultfile) {

        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        $R_samples->[$samplenr]{downsampled} = 1;
        postprocess_downsampling($samplenr);
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # Species is known here (requires species_determined), so the
    # species' maxdepth/genomesize apply; jellyfish only runs if the
    # genome size is not configured for it.
    ensure_targetbases_computed($samplenr);
    my $tb = $R_samples->[$samplenr]{targetbases};

    if (!defined $tb || $tb eq "" || $tb !~ /^\d+(?:\.\d+)?$/ || $tb <= 0) {
        # No target depth (maxdepth 0/none): use the trimmed reads as they are.
        log_message("NOTICE: Sample $sample_name: no downsampling target (maxdepth 0) -- using the trimmed reads as they are");
        $R_samples->[$samplenr]{downsampled} = 0;
        $R_samples->[$samplenr]{_downsampling_linked} = 1;
        my $link = $runstep{check_for_no_downsampling}{cmd_template}{$sample_type} // "";
        my $have = $sample_type eq "PE"
            ? ( -e fill_placeholders("__R1TD__", $samplenr) && -e fill_placeholders("__R2TD__", $samplenr) )
            : -e fill_placeholders("__SETD__", $samplenr);
        if ( $have || $link eq "" ) {
            postprocess_nodownsampling($samplenr);
            return "";
        }
        ensure_dir(fill_placeholders($runstep{check_for_no_downsampling}{output_dir}, $samplenr));
        return fill_placeholders($link, $samplenr, "check_for_no_downsampling");
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},  $samplenr));
    ensure_dir(dirname($resultfile));
    
    _fill_placeholders__safe_replace(\$command, "__TARGETBASES__", $tb);
    _fill_placeholders__safe_replace(\$command, "__RESULTFILE__", $resultfile);
     
    $command = fill_placeholders($command, $samplenr, $runstep_name); 
    
    
    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_downsampling;

sub postprocess_downsampling {
    my ($samplenr) = @_;

    my $runstep_name = "downsampling_bbmap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type}; 
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    # Reads were linked, not downsampled (no target depth) -- see preprocessing.
    return postprocess_nodownsampling($samplenr) if delete $R_samples->[$samplenr]{_downsampling_linked};

    # verify outputfiles
    if ($sample_type eq "PE") {
        if( require_input_files($samplenr, $runstep_name,  "fatal", "__R1TD__", "__R2TD__")){
           $R_samples->[$samplenr]{downsampled} = 1;
        }
    }

    elsif ($sample_type eq "SE") {
        if(require_input_files($samplenr, $runstep_name,  "fatal", "__SETD__")){
           $R_samples->[$samplenr]{downsampled} = 1;        
        }
    }

    my $result_ref = parse_downsampling_results($resultfile);
    return 0 unless defined $result_ref;

    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref;

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "Downsampling log",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/Downsampling/__BASE__.downsampling.stderr.txt",$samplenr, $runstep_name)),
    ); 



    my $target      = $R_samples->[$samplenr]{results}{$runstep_name};
    my $maxdepth    = $R_samples->[$samplenr]{maxdepth};
    my $genomesize  = $R_samples->[$samplenr]{estimated_genomesize};

    my $actual_coverage = undef;
    if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0
        && defined $target->{output_bases} && $target->{output_bases} =~ /^\d+(?:\.\d+)?$/) {
        $actual_coverage = sprintf("%.1f", $target->{output_bases} / $genomesize);
    }

    $R_samples->[$samplenr]{results}{downsampling_bbmap}{actual_coverage} = $actual_coverage;
    
    
    
    
    my $color = "green";
    if (($actual_coverage // 0) < 30) { $color = "yellow"; }


    log_message("NOTICE: Downsampling target ${maxdepth}X", "green");

    if (defined $actual_coverage) {
        log_message("NOTICE: Achieved coverage ${actual_coverage}X", $color);
    }

    if (defined $target->{samplerate}) {
        log_message("NOTICE: Initial samplerate set to $target->{samplerate}","green");
    }
    if (($target->{input_line} // "") ne "") {
        log_message("NOTICE: $target->{input_line}","green");
    }
    if (($target->{output_line} // "") ne "") {
        log_message("NOTICE: $target->{output_line}","green");
    }

    return 1;
}


##
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_bases}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_line}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{input_reads}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_bases}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_bases_pct}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_line}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_reads}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{output_reads_pct}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{paired}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{raw}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{samplerate}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{time_seconds}
##  $R_samples->[$samplenr]{results}{downsampling_bbmap}{actual_coverage}
##
##



# PARSER---------------------------------

sub parse_downsampling_results {
    my ($resultfile) = @_;

    unless (-f $resultfile) {
        log_message("WARNING: Downsampling result file not found: $resultfile");
        return undef;
    }

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: Could not open downsampling result file: $resultfile");
        return undef;
    };

    my $result = {
        samplerate        => undef,
        paired            => undef,
        input_reads       => undef,
        input_bases       => undef,
        output_reads      => undef,
        output_reads_pct  => undef,
        output_bases      => undef,
        output_bases_pct  => undef,
        time_seconds      => undef,
        input_line        => '',
        output_line       => '',
        raw               => [],
    };

    while (my $line = <$fh>) {
        chomp $line;
        push @{ $result->{raw} }, $line;

        if ($line =~ /^Initial samplerate set to\s+([\d.]+)/) {
            $result->{samplerate} = $1 + 0;
            next;
        }

        if ($line =~ /^Input is being processed as paired/i) {
            $result->{paired} = 1;
            next;
        }

        if ($line =~ /^Input is being processed as single/i) {
            $result->{paired} = 0;
            next;
        }

        if ($line =~ /^Input:\s+(\d+)\s+reads\s+(\d+)\s+bases/i) {
            $result->{input_reads} = $1 + 0;
            $result->{input_bases} = $2 + 0;
            $result->{input_line}  = $line;
            next;
        }

        if ($line =~ /^Output:\s+(\d+)\s+reads\s+\(([\d.]+)%\)\s+(\d+)\s+bases\s+\(([\d.]+)%\)/i) {
            $result->{output_reads}     = $1 + 0;
            $result->{output_reads_pct} = $2 + 0;
            $result->{output_bases}     = $3 + 0;
            $result->{output_bases_pct} = $4 + 0;
            $result->{output_line}      = $line;
            next;
        }

        if ($line =~ /^Time:\s+([\d.]+)\s+seconds\./i) {
            $result->{time_seconds} = $1 + 0;
            next;
        }
    }

    close $fh;

    return $result;
}



