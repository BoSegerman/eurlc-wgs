###################################################################################################
################################ Command templates  ###############################################
################################ Runstep library  #################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################


my $runstep_name = "";

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep md5_rawdata
#
# Calculates MD5 fingerprints of the raw input files for traceability.
# Implemented as an internal Perl sub (Digest::MD5) -- no shell dependency,
# works identically on Linux and macOS without detecting md5sum vs md5.

$runstep_name = "md5_rawdata";

$runstep{$runstep_name} = {
    resources  => { threads => 1, ram_gb => 0 },

    message    => "Calculating MD5 fingerprints...",
    long_name  => "MD5 fingerprints (rawdata)",
    output_dir => "__DIR-QC1__/md5",
    resultfile => "__DIR-QC1__/md5/md5-__BASE__.txt",

    requires   => [],
    produces   => [ 'md5_done' ],
    applies_if => sub { return $R_cfg->{md5}{enabled} ? 1 : 0; },
};

# TEST---------------------------------
$runstep{$runstep_name}{test} = sub {
    my ($samplenr) = @_;
    return 2 if exists $tests_performed{md5};
    $tests_performed{md5} = 1;
    return 1;  # Digest::MD5 is core Perl, always available
};

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_md5_rawdata;

sub preprocess_md5_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    return "" if is_disabled($R_cfg->{md5}{enabled});

    my @input_phs = $sample_type eq 'PE'    ? ('__R1__', '__R2__')
                  : $sample_type eq 'SE'    ? ('__SE__')
                  : $sample_type eq 'FASTA' ? ('__FASTA__')
                  : ();
    return "" unless require_input_files($samplenr, $runstep_name, "fatal", @input_phs);

    if (-s $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_md5_rawdata($samplenr);
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));
    return "SUB\tmd5_rawdata_internal\t$samplenr";
}

$INTERNAL_SUB{md5_rawdata_internal} = sub {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $outdir       = fill_placeholders($runstep{$runstep_name}{output_dir},  $samplenr);
    my $allfile      = "$outdir/all_md5sums.txt";

    my @files;
    if    ($sample_type eq 'PE')    { @files = map { fill_placeholders($_, $samplenr) } ('__R1__', '__R2__') }
    elsif ($sample_type eq 'SE')    { @files = (fill_placeholders('__SE__',    $samplenr)) }
    elsif ($sample_type eq 'FASTA') { @files = (fill_placeholders('__FASTA__', $samplenr)) }

    open my $out,    '>',  $resultfile or die "Cannot write $resultfile: $!";
    open my $allout, '>>',$allfile    or die "Cannot append $allfile: $!";
    print $allout "$sample_name\n";
    for my $path (@files) {
        my $digest = md5_file($path);
        if ($digest =~ /^ERROR:/) {
            log_message("WARNING: MD5 failed for [$path]: $digest");
        }
        my $line = "$digest  $path\n";
        print $out    $line;
        print $allout $line;
    }
    close $out; close $allout;
    return 0;
};


# POST---------------------------------
$runstep{$runstep_name}{result_parsing} = \&postprocess_md5_rawdata;

sub postprocess_md5_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    my $results_ref = parse_md5_rawdata_results($resultfile, $samplenr);
    if (!$results_ref || ref($results_ref) ne 'HASH' || !%{$results_ref}) {
        log_message("WARNING: No MD5 results parsed for sample [$sample_name] from [$resultfile]", "yellow");
        # Not fatal -- analysis can continue without checksums -- but worth
        # flagging so it's visible in the report.
        set_runtime_issue($samplenr, "warning", "No MD5 checksums produced for rawdata");
    }

    register_raw_output($samplenr, $runstep_name,
        title => "MD5 checksums (raw data files)",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__OUTDIR__/md5-__BASE__.txt", $samplenr, $runstep_name)),
    );
    $R_samples->[$samplenr]{results}{$runstep_name} = $results_ref;
    $R_samples->[$samplenr]{main_results}{md5} //= [];

    if ($sample_type eq 'PE') {
        my ($r1, $r2) = map { $results_ref->{$_} // "n/a" } ('R1', 'R2');
        log_message("NOTICE: $sample_name rawdata R1: $r1");
        log_message("NOTICE: $sample_name rawdata R2: $r2");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata R1: $r1", "Rawdata R2: $r2";
    } elsif ($sample_type eq 'SE') {
        my $se = $results_ref->{SE} // "n/a";
        log_message("NOTICE: $sample_name rawdata SE: $se");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata SE: $se";
    } elsif ($sample_type eq 'FASTA') {
        my $fa = $results_ref->{FASTA} // "n/a";
        log_message("NOTICE: $sample_name rawdata FASTA: $fa");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata FASTA: $fa";
    }
    return 1;
}

# PARSE---------------------------------
# Parses the result file written by md5_rawdata_internal.
# Format (one line per input file):
#   <32-char-hex>  <full-path-to-file>
#
# Identifies each line by matching the path against the sample's known
# raw file paths (stored in $R_samples->[$samplenr]{paths}{raw}).
# Returns a hashref with keys R1/R2/SE/FASTA and MD5 hex values.
sub parse_md5_rawdata_results {
    my ($resultfile, $samplenr) = @_;
    my %md5;

    return {} unless defined $resultfile && -s $resultfile;

    my $paths = $R_samples->[$samplenr]{paths}{raw} // {};
    my %known = (
        R1    => $paths->{R1}   // "",
        R2    => $paths->{R2}   // "",
        SE    => $paths->{SE}   // "",
        FASTA => $paths->{FASTA} // $R_samples->[$samplenr]{paths}{fasta} // "",
    );

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: Cannot open MD5 result file [$resultfile]: $!");
        return {};
    };

    while (my $line = <$fh>) {
        chomp $line;
        next unless $line =~ /^([0-9a-f]{32})\s+(.+)$/i;
        my ($digest, $path) = ($1, $2);
        for my $key (keys %known) {
            if ($known{$key} ne "" && $path eq $known{$key}) {
                $md5{$key} = $digest;
                last;
            }
        }
    }
    close $fh;
    return \%md5;
}

##   $R_samples->[$samplenr]{results}{md5_rawdata}{R1}     -- MD5 of raw R1
##   $R_samples->[$samplenr]{results}{md5_rawdata}{R2}     -- MD5 of raw R2
##   $R_samples->[$samplenr]{results}{md5_rawdata}{SE}     -- MD5 of raw SE
##   $R_samples->[$samplenr]{results}{md5_rawdata}{FASTA}  -- MD5 of input FASTA


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep sample_prescan
##
## Pre-scans raw FASTQ reads (not FASTA -- prescan doesn't apply to
## already-assembled data). Detects sequencing instrument, estimates read
## length distribution, checks for adapter contamination, and computes the
## bracken_readlength value used by find_species_kraken2. Must run before
## find_species_kraken2: bracken's command needs the estimated read length
## this produces -- a real data dependency, not just ordering preference.
##
## No external tool: pure Perl via the %INTERNAL_SUB mechanism, which gives
## it proper event/timing tracking from run_step() despite not being a
## subprocess. The internal sub writes its result to a JSON file;
## postprocess_sample_prescan reads it back in the parent process.

$runstep_name = "sample_prescan";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Pre-scanning raw reads...",
      long_name  => "Raw read pre-scan",
      output_dir => "__DIR-QC1__/fastq_prescan",
      resultfile => "__DIR-QC1__/fastq_prescan/__BASE__.prescan.json",

      requires   => [],
      produces   => [ 'prescan_done' ],
      applies_if => sub {
          my ($i) = @_;
          return $R_samples->[$i]{type} eq 'FASTA' ? 0 : 1;
      },
};

# TEST---------------------------------
# No external tool, nothing to test -- return 2 (skip) immediately.
$runstep{$runstep_name}{test} = sub { return 2; };

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_sample_prescan;

sub preprocess_sample_prescan {
    my ($samplenr) = @_;

    my $runstep_name = "sample_prescan";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $prescan_dir  = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);
    my $prescan_json = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    if (-s $prescan_json) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_sample_prescan($samplenr);
        return "";
    }

    ensure_dir($prescan_dir);

    my $fq1 = $R_samples->[$samplenr]{paths}{raw}{R1} // $R_samples->[$samplenr]{paths}{raw}{SE} // "";
    my $fq2 = $R_samples->[$samplenr]{paths}{raw}{R2} // "";

    return "SUB\tfastq_prescan_internal\t$fq1\t$fq2\t$prescan_dir\t$samplenr";
}

# INTERNAL SUB---------------------------------
# Registered here (not in the central %INTERNAL_SUB) so everything
# belonging to this runstep is co-located. Writes results to JSON and
# TXT files; returns 0 on success. postprocess_sample_prescan reads
# the JSON back in the parent process.
# HELPER SUBS (used only by fastq_prescan_internal, co-located here)
sub nearest_bracken_readlength {
    my ($current_readlength) = @_;

    my @reference_lengths = (50, 75, 100, 150, 200, 250, 300);

    return 150 if !defined $current_readlength || $current_readlength !~ /^\d+(?:\.\d+)?$/;

    my $len = $reference_lengths[0];
    my $min_diff = abs($current_readlength - $len);

    foreach my $ref (@reference_lengths) {
        my $diff = abs($current_readlength - $ref);
        if ($diff < $min_diff) {
            $min_diff = $diff;
            $len = $ref;
        }
    }

    return $len;
}

sub classify_read_header {
    my ($header, $machine_aliases_ref) = @_;

    my %info = (
        header_format          => "unknown",
        platform_guess         => "unknown",
        source_guess           => "unknown",
        instrument             => "",
        instrument_type_guess  => "",
        run_number             => "",
        flowcell               => "",
        lane                   => "",
        machine_alias          => "",
    );

    return \%info if !defined $header || $header eq "";

    $header =~ s/^\@//;

    # Modern Illumina:
    # instrument:run:flowcell:lane:tile:x:y read:is_filtered:control:index
    if ($header =~ /^([A-Za-z0-9_-]+):(\d+):([A-Za-z0-9_-]+):(\d+):\d+:\d+:\d+(?:\s+[12]:[YN]:\d+:[A-Za-z0-9+-]+)?$/) {
        $info{header_format}  = "illumina_modern";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{run_number}     = $2;
        $info{flowcell}       = $3;
        $info{lane}           = $4;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # Older Illumina-ish patterns
    elsif ($header =~ /^([A-Za-z0-9_-]+):(\d+):(\d+):(\d+):(\d+)(?:#\S+)?(?:\/[12])?$/) {
        $info{header_format}  = "illumina_legacy";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{lane}           = $2;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # SRA / ENA / DDBJ accession-like
    elsif ($header =~ /^((?:SRR|ERR|DRR)\d+(?:\.\d+)?)/i) {
        $info{header_format}  = "sra_ena_accession";
        $info{platform_guess} = "unknown";
        $info{source_guess}   = "SRA_ENA_DDBJ";
        $info{instrument}     = "";
    }

    # ONT often UUID-like headers or runid/ch/chunks
    elsif ($header =~ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/i
        || $header =~ /\brunid=/i
        || $header =~ /\bch=\d+/i
        || $header =~ /\bstart_time=/i) {
        $info{header_format}  = "ont_like";
        $info{platform_guess} = "ONT";
        $info{source_guess}   = "local_or_exported";
    }

    # PacBio CCS/subreads often have movie/zmw style
    elsif ($header =~ m{^[^/\s]+/\d+/(?:ccs|\d+_\d+)}i) {
        $info{header_format}  = "pacbio_like";
        $info{platform_guess} = "PacBio";
        $info{source_guess}   = "local_or_exported";
    }

    # Some IonTorrent exports can look like runID:row:col or similar, but weakly standardized
    elsif ($header =~ /^[A-Za-z0-9._-]+:\d+:\d+$/) {
        $info{header_format}  = "iontorrent_like";
        $info{platform_guess} = "IonTorrent";
        $info{source_guess}   = "local_or_exported";
    }

    if ($info{instrument} ne "" && exists $machine_aliases_ref->{ $info{instrument} }) {
        $info{machine_alias} = $machine_aliases_ref->{ $info{instrument} };
    }

    return \%info;
}

sub parse_machine_aliases {
    my ($text) = @_;

    my %aliases;
    return \%aliases if !defined $text || $text eq "";

    foreach my $pair (split /\s*,\s*/, $text) {
        next if $pair eq "";
        my ($key, $value) = split /\s*=\s*/, $pair, 2;
        next if !defined $key || !defined $value || $key eq "" || $value eq "";
        $aliases{$key} = $value;
    }

    return \%aliases;
}

$INTERNAL_SUB{fastq_prescan_internal} = sub {
    my ($fq1, $fq2, $outfolder, $samplenr) = @_;

    my $MAX_SCAN_READS    = $R_cfg->{sample_prescan}{max_scan_reads} // 5000;
    my $MAX_ADAPTER_READS = $MAX_SCAN_READS;   # adapter check runs over the same reads
    my $DEFAULT_READLENGTH = 150;

    my @constants_adapters = (
        "Illumina Tagmentation: CTGTCTCTTATACACATCT",
        "Illumina TruSeq R1: AGATCGGAAGAGCACACGTCTGAAC",
        "Illumina TruSeq R2: AGATCGGAAGAGCGTCGTGTAGGGA",
        "Illumina Tagmentation alt: ATGTGTATAAGAGACA",
    );

    my @adapters = (
        "CTGTCTCTTATACACATCT",
        "AGATCGGAAGAGCACACGTCTGAAC",
        "AGATCGGAAGAGCGTCGTGTAGGGA",
        "ATGTGTATAAGAGACA",
    );

    my $machine_aliases_ref = parse_machine_aliases($R_cfg->{general}{machine_aliases});

    my $hist_quantile = sub {
        my ($hist, $q) = @_;
        my $total = 0;
        $total += $_ for values %$hist;
        return 0 if $total == 0;

        my $target = int($q * ($total - 1));
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %$hist) {
            $cum += $hist->{$k};
            return $k if $cum > $target;
        }

        my @keys = sort { $a <=> $b } keys %$hist;
        return $keys[-1] // 0;
    };

    my $hist_minmax = sub {
        my ($hist) = @_;
        my @keys = sort { $a <=> $b } keys %$hist;
        return (0, 0) if !@keys;
        return ($keys[0], $keys[-1]);
    };

    my $norm_text = sub {
        my ($x, $default) = @_;
        $default //= "unknown";
        return $default if !defined $x || $x eq "";
        return $x;
    };

    my $init_bucket = sub {
        return {
            reads_scanned           => 0,
            zero_length_reads       => 0,
            bases                   => 0,
            gc_bases                => 0,
            n_bases                 => 0,
            qual_sum                => 0,
            read_len_hist           => {},
            adapters_checked        => 0,
            adapters_found          => 0,
            adapter_hits            => {},
            header_examples         => [],
            header_patterns         => {},
            source_patterns         => {},
            instruments             => {},
            instrument_type_guesses => {},
            flowcells               => {},
            run_numbers             => {},
            lanes                   => {},
            platform_guesses        => {},
            warnings                => [],
        };
    };

    my %res = (
        files    => [ grep { defined && $_ ne "" } ($fq1, $fq2) ],
        adapters => \@constants_adapters,
        R1       => $init_bucket->(),
        R2       => $init_bucket->(),
        total    => $init_bucket->(),
    );

    my @file_specs;
    push @file_specs, [ $fq1, "R1" ] if defined($fq1) && $fq1 ne "";
    push @file_specs, [ $fq2, "R2" ] if defined($fq2) && $fq2 ne "";

    for my $spec (@file_specs) {
        my ($file, $bucket_name) = @$spec;
        my $bucket = $res{$bucket_name};

        my $fh;
        if ($file =~ /\.gz$/i) {
            unless (open($fh, "-|", "gzip", "-dc", $file)) {
                warn "fastq_prescan: Cannot open $file: $!\n";
                return 1;
            }
        }
        else {
            unless (open($fh, "<", $file)) {
                warn "fastq_prescan: Cannot open $file: $!\n";
                return 1;
            }
        }

        while (1) {
            my $header = <$fh>; last unless defined $header;
            my $seq    = <$fh>; last unless defined $seq;
            my $plus   = <$fh>; last unless defined $plus;
            my $qual   = <$fh>; last unless defined $qual;

            chomp($header);
            chomp($seq);
            chomp($plus);
            chomp($qual);

            # FASTQ format validation
            unless ($header =~ /^\@/) {
                push @{ $bucket->{warnings} },
                    "Non-FASTQ header (missing \@) at read ${\($bucket->{reads_scanned}+1)}: ".substr($header,0,40);
                # Skip this record -- we may be misaligned; try to recover
                next;
            }
            unless ($plus =~ /^\+/) {
                push @{ $bucket->{warnings} },
                    "Missing + separator at read ${\($bucket->{reads_scanned}+1)}";
                next;
            }
            if (length($seq) != length($qual)) {
                push @{ $bucket->{warnings} },
                    "Sequence/quality length mismatch at read ${\($bucket->{reads_scanned}+1)}: "
                    . "seq=".length($seq)." qual=".length($qual);
                # Count the read but flag it
            }

            $bucket->{reads_scanned}++;
            $res{total}{reads_scanned}++;

            # Zero-length sequence -- count but don't include in length stats.
            # Causes failures in many downstream tools (fastp, bowtie2, spades).
            if (length($seq) == 0) {
                $bucket->{zero_length_reads}++;
                $res{total}{zero_length_reads}++;
                next;
            }

            my $len = length($seq);
            $bucket->{bases} += $len;
            $res{total}{bases} += $len;

            $bucket->{read_len_hist}{$len}++;
            $res{total}{read_len_hist}{$len}++;

            my $gc_count = ($seq =~ tr/GCgc//);
            $bucket->{gc_bases} += $gc_count;
            $res{total}{gc_bases} += $gc_count;

            my $n_count = ($seq =~ tr/Nn//);
            $bucket->{n_bases} += $n_count;
            $res{total}{n_bases} += $n_count;

            for my $c (unpack("C*", $qual)) {
                my $Q = $c - 33;
                $Q = 0 if $Q < 0;
                $bucket->{qual_sum} += $Q;
                $res{total}{qual_sum} += $Q;
            }

            if ($bucket->{reads_scanned} <= $MAX_ADAPTER_READS) {
                $bucket->{adapters_checked}++;
                for (my $i = 0; $i < @adapters; $i++) {
                    if (index($seq, $adapters[$i]) != -1) {
                        $bucket->{adapters_found}++;
                        $bucket->{adapter_hits}{$constants_adapters[$i]}++;
                        last;
                    }
                }
            }

            if (@{ $bucket->{header_examples} } < 5) {
                push @{ $bucket->{header_examples} }, $header;
            }
            if (@{ $res{total}{header_examples} } < 5) {
                push @{ $res{total}{header_examples} }, $header;
            }

            my $header_info = classify_read_header($header, $machine_aliases_ref);

            my $header_format         = $norm_text->($header_info->{header_format});
            my $source_guess          = $norm_text->($header_info->{source_guess});
            my $platform_guess        = $norm_text->($header_info->{platform_guess});
            my $instrument_type_guess = $norm_text->($header_info->{instrument_type_guess});

            $bucket->{header_patterns}{$header_format}++;
            $res{total}{header_patterns}{$header_format}++;

            $bucket->{source_patterns}{$source_guess}++;
            $res{total}{source_patterns}{$source_guess}++;

            $bucket->{platform_guesses}{$platform_guess}++;
            $res{total}{platform_guesses}{$platform_guess}++;

            $bucket->{instrument_type_guesses}{$instrument_type_guess}++;
            $res{total}{instrument_type_guesses}{$instrument_type_guess}++;

            if (defined $header_info->{instrument} && $header_info->{instrument} ne "") {
                $bucket->{instruments}{ $header_info->{instrument} }++;
                $res{total}{instruments}{ $header_info->{instrument} }++;
            }

            if (defined $header_info->{flowcell} && $header_info->{flowcell} ne "") {
                $bucket->{flowcells}{ $header_info->{flowcell} }++;
                $res{total}{flowcells}{ $header_info->{flowcell} }++;
            }

            if (defined $header_info->{run_number} && $header_info->{run_number} ne "") {
                $bucket->{run_numbers}{ $header_info->{run_number} }++;
                $res{total}{run_numbers}{ $header_info->{run_number} }++;
            }

            if (defined $header_info->{lane} && $header_info->{lane} ne "") {
                $bucket->{lanes}{ $header_info->{lane} }++;
                $res{total}{lanes}{ $header_info->{lane} }++;
            }

            last if $bucket->{reads_scanned} >= $MAX_SCAN_READS;
        }

        close $fh;
    }

    # Build total adapter stats from R1 + R2 buckets instead of sampling only the first reads overall
    $res{total}{adapters_checked} = ($res{R1}{adapters_checked} // 0) + ($res{R2}{adapters_checked} // 0);
    $res{total}{adapters_found}   = ($res{R1}{adapters_found}   // 0) + ($res{R2}{adapters_found}   // 0);

    for my $ad (@constants_adapters) {
        $res{total}{adapter_hits}{$ad} =
              ($res{R1}{adapter_hits}{$ad} // 0)
            + ($res{R2}{adapter_hits}{$ad} // 0);
    }

    my $dominant_key = sub {
        my ($href) = @_;
        return "" if !defined $href || ref($href) ne "HASH" || !%$href;

        my ($best) = sort { $href->{$b} <=> $href->{$a} } keys %$href;
        return $best // "";
    };

    my $dominant_value = sub {
        my ($href) = @_;
        my $key = $dominant_key->($href);
        return $key;
    };

    my $finalize_bucket = sub {
        my ($bucket) = @_;

        if ($bucket->{reads_scanned} > 0 && $bucket->{bases} > 0) {
            my ($min_len, $max_len) = $hist_minmax->($bucket->{read_len_hist});
            $bucket->{shortest}   = $min_len;
            $bucket->{longest}    = $max_len;
            $bucket->{average}    = $bucket->{bases} / $bucket->{reads_scanned};
            $bucket->{median}     = $hist_quantile->($bucket->{read_len_hist}, 0.50);
            $bucket->{q1}         = $hist_quantile->($bucket->{read_len_hist}, 0.25);
            $bucket->{q3}         = $hist_quantile->($bucket->{read_len_hist}, 0.75);
            $bucket->{q05}        = $hist_quantile->($bucket->{read_len_hist}, 0.05);
            $bucket->{gc_pct}     = sprintf("%.5f", 100 * $bucket->{gc_bases} / $bucket->{bases});
            $bucket->{n_pct}      = sprintf("%.5f", 100 * $bucket->{n_bases} / $bucket->{bases});
            $bucket->{av_q_score} = sprintf("%.3f", $bucket->{qual_sum} / $bucket->{bases});
        }
        else {
            $bucket->{shortest}   = 0;
            $bucket->{longest}    = 0;
            $bucket->{average}    = 0;
            $bucket->{median}     = 0;
            $bucket->{q1}         = 0;
            $bucket->{q3}         = 0;
            $bucket->{q05}        = 0;
            $bucket->{gc_pct}     = sprintf("%.5f", 0);
            $bucket->{n_pct}      = sprintf("%.5f", 0);
            $bucket->{av_q_score} = sprintf("%.3f", 0);
        }

        $bucket->{estimated_bracken_readlength} =
            $bucket->{median} && $bucket->{median} > 0
            ? nearest_bracken_readlength($bucket->{median})
            : $DEFAULT_READLENGTH;

        $bucket->{adapter_pct} =
            $bucket->{adapters_checked}
            ? sprintf("%.5f", 100 * $bucket->{adapters_found} / $bucket->{adapters_checked})
            : sprintf("%.5f", 0);

        $bucket->{header_format}         = $dominant_value->($bucket->{header_patterns})         || "unknown";
        $bucket->{source_guess}          = $dominant_value->($bucket->{source_patterns})         || "unknown";
        $bucket->{platform_guess}        = $dominant_value->($bucket->{platform_guesses})        || "unknown";
        $bucket->{instrument_type_guess} = $dominant_value->($bucket->{instrument_type_guesses}) || "unknown";

        $bucket->{instrument} = $dominant_value->($bucket->{instruments}) || "";
        $bucket->{flowcell}   = $dominant_value->($bucket->{flowcells})   || "";
        $bucket->{run_number} = $dominant_value->($bucket->{run_numbers}) || "";
        $bucket->{lane}       = $dominant_value->($bucket->{lanes})       || "";

        $bucket->{machine_alias} = "";
        if ($bucket->{instrument} ne "" && exists $machine_aliases_ref->{ $bucket->{instrument} }) {
            $bucket->{machine_alias} = $machine_aliases_ref->{ $bucket->{instrument} };
        }

        $bucket->{looks_long_read}  = 0;
        $bucket->{long_read_reason} = "";

        if ($bucket->{median} > 600) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Median read length > 600 bp";
        }
        elsif ($bucket->{q3} > 1000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Upper quartile read length > 1000 bp";
        }
        elsif ($bucket->{longest} > 5000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Observed reads > 5000 bp";
        }
        elsif ($bucket->{platform_guess} =~ /^(ONT|PacBio)$/i) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Header format suggests long-read platform";
        }

        if ($bucket->{looks_long_read}) {
            push @{ $bucket->{warnings} }, "Reads may represent long-read data: $bucket->{long_read_reason}";
        }

        if ($bucket->{zero_length_reads} > 0) {
            my $pct = $bucket->{reads_scanned} > 0
                ? sprintf("%.1f", 100 * $bucket->{zero_length_reads} / $bucket->{reads_scanned})
                : "?";
            push @{ $bucket->{warnings} },
                "Zero-length reads detected: $bucket->{zero_length_reads} of $bucket->{reads_scanned} scanned ($pct%). "
              . "Some downstream tools (fastp, bowtie2, SPAdes) do not tolerate empty reads.";
        }

        return $bucket;
    };

    $finalize_bucket->($res{R1});
    $finalize_bucket->($res{R2});
    $finalize_bucket->($res{total});

    # Warn if either file produced zero reads (likely empty or unreadable)
    for my $key (qw(R1 R2)) {
        if ($res{$key}{reads_scanned} == 0 && defined $res{files}[0]) {
            push @{ $res{$key}{warnings} },
                "No reads scanned -- file may be empty or unreadable";
        }
    }

    # For PE samples: verify R1 and R2 appear to be from the same run.
    # Instrument + flowcell mismatch is a strong signal of mis-paired files
    # -- flag as a fatal issue so postprocess can stop the sample.
    $res{total}{fatal_issues} //= [];
    if ($fq2 ne "" && $res{R1}{reads_scanned} > 0 && $res{R2}{reads_scanned} > 0) {
        my $r1_inst = (sort { $res{R1}{instruments}{$b} <=> $res{R1}{instruments}{$a} }
                       keys %{ $res{R1}{instruments} })[0] // "";
        my $r2_inst = (sort { $res{R2}{instruments}{$b} <=> $res{R2}{instruments}{$a} }
                       keys %{ $res{R2}{instruments} })[0] // "";
        my $r1_fc   = (sort { $res{R1}{flowcells}{$b} <=> $res{R1}{flowcells}{$a} }
                       keys %{ $res{R1}{flowcells} })[0] // "";
        my $r2_fc   = (sort { $res{R2}{flowcells}{$b} <=> $res{R2}{flowcells}{$a} }
                       keys %{ $res{R2}{flowcells} })[0] // "";

        if ($r1_inst ne "" && $r2_inst ne "" && $r1_inst ne $r2_inst) {
            push @{ $res{total}{fatal_issues} },
                "R1/R2 instrument mismatch -- files may not be paired correctly "
              . "(R1: $r1_inst, R2: $r2_inst)";
        }
        if ($r1_fc ne "" && $r2_fc ne "" && $r1_fc ne $r2_fc) {
            push @{ $res{total}{fatal_issues} },
                "R1/R2 flowcell mismatch -- files may not be paired correctly "
              . "(R1: $r1_fc, R2: $r2_fc)";
        }
    }

    # Outfolder must be defined -- if not, it's a bug in the caller.
    # Don't graceful_die (we're in a fork -- it would kill just the fork
    # process); instead warn to STDERR and return 1 (failure exit code).
    # The parent will see a non-zero exit and log it as a pipeline error.
    unless (defined $outfolder && $outfolder ne "") {
        warn "fastq_prescan_internal: outfolder not defined (caller bug)\n";
        return 1;
    }

    my $folder = fill_placeholders($outfolder, $samplenr);
    ensure_dir($folder);

    my $json_path = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.json"), $samplenr);
    my $txt_path  = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.txt"),  $samplenr);

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);

    open(my $jfh, ">", $json_path) or graceful_die("fastq_prescan: Cannot write [$json_path]: $!");
    print {$jfh} $json->encode(\%res);
    close($jfh) or graceful_die("fastq_prescan: Failed closing [$json_path]: $!");

    open(my $tfh, ">", $txt_path) or graceful_die("fastq_prescan: Cannot write [$txt_path]: $!");

    my $print_bucket = sub {
        my ($label, $bucket) = @_;
        print {$tfh} "=== $label ===\n";
        print {$tfh} "Reads scanned: $bucket->{reads_scanned}\n";
        print {$tfh} "Read length (shortest/q05/q1/median/q3/average/longest): "
                   . "$bucket->{shortest} / $bucket->{q05} / $bucket->{q1} / $bucket->{median} / $bucket->{q3} / "
                   . sprintf("%.2f", $bucket->{average}) . " / $bucket->{longest}\n";
        print {$tfh} "Estimated Bracken read length: $bucket->{estimated_bracken_readlength}\n";
        print {$tfh} "Average Phred score: $bucket->{av_q_score}\n";
        print {$tfh} "GC %: $bucket->{gc_pct}\n";
        print {$tfh} "N %: $bucket->{n_pct}\n";
        print {$tfh} "Adapter % (of checked): $bucket->{adapter_pct}\n";
        print {$tfh} "Header format: $bucket->{header_format}\n";
        print {$tfh} "Platform guess: $bucket->{platform_guess}\n";
        print {$tfh} "Source guess: $bucket->{source_guess}\n";
        print {$tfh} "Instrument: $bucket->{instrument}\n";
        print {$tfh} "Instrument type guess: $bucket->{instrument_type_guess}\n";
        print {$tfh} "Machine alias: $bucket->{machine_alias}\n";
        print {$tfh} "Flowcell: $bucket->{flowcell}\n";
        print {$tfh} "Run number: $bucket->{run_number}\n";
        print {$tfh} "Lane: $bucket->{lane}\n";
        print {$tfh} "Looks like long-read data: " . ($bucket->{looks_long_read} ? "yes" : "no") . "\n";
        print {$tfh} "Long-read reason: $bucket->{long_read_reason}\n" if $bucket->{long_read_reason};

        if (@{ $bucket->{warnings} }) {
            print {$tfh} "Warnings:\n";
            print {$tfh} "  - $_\n" for @{ $bucket->{warnings} };
        }

        print {$tfh} "Example headers:\n";
        print {$tfh} "  - $_\n" for @{ $bucket->{header_examples} };
        print {$tfh} "\n";
    };

    print {$tfh} "FASTQ prescan summary\n";
    print {$tfh} "Files:\n";
    print {$tfh} "  R1: " . (defined($fq1) && $fq1 ne "" ? $fq1 : "(none)") . "\n";
    print {$tfh} "  R2: " . (defined($fq2) && $fq2 ne "" ? $fq2 : "(none)") . "\n\n";

    $print_bucket->("R1",    $res{R1});
    $print_bucket->("R2",    $res{R2});
    $print_bucket->("TOTAL", $res{total});

    print {$tfh} "Adapters searched:\n";
    print {$tfh} "  - $_\n" for @constants_adapters;

    close($tfh) or graceful_die("fastq_prescan: Failed closing [$txt_path]: $!");

    return 0;   # internal sub contract: write to file, return 0=success
};

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_sample_prescan;

sub postprocess_sample_prescan {
    my ($samplenr) = @_;

    my $runstep_name = "sample_prescan";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $prescan_json = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    unless (-s $prescan_json) {
        log_message("WARNING: fastq_prescan JSON resultfile not found for sample $sample_name");
        return 0;
    }

    my $prescan_ref = read_json($prescan_json);

    unless ($prescan_ref && ref($prescan_ref) eq 'HASH') {
        log_message("WARNING: fastq_prescan JSON could not be parsed for sample $sample_name");
        set_runtime_issue($samplenr, "warning", "sample_prescan: JSON result unreadable");
        return 0;
    }

    # Surface fatal issues (e.g. R1/R2 mismatch) -- stop the sample immediately.
    # These were written by the internal sub (which runs in a fork and cannot
    # call set_runtime_issue directly).
    for my $issue (@{ $prescan_ref->{total}{fatal_issues} // [] }) {
        log_message("ERROR: sample_prescan [$sample_name]: $issue", "red");
        set_runtime_issue($samplenr, "fail", "sample_prescan: $issue");
    }
    return 0 if $R_samples->[$samplenr]{fatal_error};   # stop early if fatal

    # Surface non-fatal warnings from any bucket
    for my $bucket_key (qw(R1 R2 total)) {
        for my $w (@{ $prescan_ref->{$bucket_key}{warnings} // [] }) {
            log_message("WARNING: sample_prescan [$sample_name] $bucket_key: $w", "yellow");
            set_runtime_issue($samplenr, "warning", "sample_prescan $bucket_key: $w");
        }
    }

    # Consumed by find_species_kraken2's bracken command.
    my $bracken_len = $prescan_ref->{R1}{estimated_bracken_readlength}
                    // $prescan_ref->{SE}{estimated_bracken_readlength}
                    // $prescan_ref->{total}{estimated_bracken_readlength}
                    // 150;
    $R_samples->[$samplenr]{bracken_readlength} = $bracken_len;

    $R_samples->[$samplenr]{results}{fastq_prescan} = $prescan_ref;

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "FASTQ prescan results (text)",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.txt",  $samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "FASTQ prescan results (JSON)",
        type  => "json",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.json", $samplenr, $runstep_name)),
    );

    $R_samples->[$samplenr]{main_results}{run_data}{platform_guess}         = $prescan_ref->{total}{platform_guess}         // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{instrument}             = $prescan_ref->{total}{instrument}             // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{instrument_type_guess}  = $prescan_ref->{total}{instrument_type_guess}  // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{machine_alias}          = $prescan_ref->{total}{machine_alias}          // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{flowcell}               = $prescan_ref->{total}{flowcell}               // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{run_number}             = $prescan_ref->{total}{run_number}             // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{lane}                   = $prescan_ref->{total}{lane}                   // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{looks_long_read}        = $prescan_ref->{total}{looks_long_read}        // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{long_read_reason}       = $prescan_ref->{total}{long_read_reason}       // "n/a";

    $R_samples->[$samplenr]{main_results}{qscore}{raw}{n_pct}              = $prescan_ref->{total}{n_pct}                  // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_q_score}          = $prescan_ref->{total}{av_q_score}             // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len}         = $prescan_ref->{total}{average}                // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len}        = $prescan_ref->{total}{q3}                     // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len}        = $prescan_ref->{total}{median}                 // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len}        = $prescan_ref->{total}{q1}                     // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len}        = $prescan_ref->{total}{q05}                    // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{adapter_pct}         = $prescan_ref->{total}{adapter_pct}            // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc}                  = $prescan_ref->{total}{gc_pct}                 // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{longest_read_len}    = $prescan_ref->{total}{longest}                // "n/a";

    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len_rel}     = safe_rel($prescan_ref->{total}{average}, $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len_rel}    = safe_rel($prescan_ref->{total}{q3},      $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len_rel}    = safe_rel($prescan_ref->{total}{median},  $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len_rel}    = safe_rel($prescan_ref->{total}{q1},      $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len_rel}    = safe_rel($prescan_ref->{total}{q05},     $prescan_ref->{total}{longest}, "n/a");

    return 1;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep find_species_kraken2


$runstep_name = "find_species_kraken2";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 8 },

      message    => "Determining species (using kraken2)...",
      long_name  => "species identification (using kraken2)",
      output_dir => "__DIR-QC1__/species_determination_kraken2",
      resultfile => "__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",

      # requires prescan_done: bracken's read-length parameter is a real data
      # dependency set by sample_prescan.
      # requires trimmed_fastq: species determination runs on fastp-trimmed reads
      # (not raw) -- adapter-free reads produce cleaner k-mer hits and better
      # classification. This means fastp_rawdata must complete first, but it's
      # fast (~30-60s) and the quality improvement is worth it.
      # downsampling_bbmap in turn requires species_determined -- it uses
      # species-specific maxdepth from config -- forming the chain:
      #   prescan + fastp → find_species → downsampling
      requires   => [ 'prescan_done', 'trimmed_fastq' ],
      produces   => [ 'species_determined' ],
      applies_if => sub {
          my ($i) = @_;
          return $R_cfg->{kraken2}{enabled} ? 1 : 0;
      },
};


# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    zcat __R1T__ | head -n 400000 | gzip > __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__
    zcat __R2T__ | head -n 400000 | gzip > __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__  
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db __KRAKENDB__
       --paired __OUTDIR__/tmpR1.fastq.gz __OUTDIR__/tmpR2.fastq.gz
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
CMD


$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    zcat __SET__ | head -n 400000 | gzip > __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db __KRAKENDB__
       __OUTDIR__/tmpSE.fastq.gz
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env}  --no-capture-output kraken2
       --report __OUTDIR__/kraken2-__BASE__.report
       --threads __THREADS__  
       --db __KRAKENDB__
       __FASTA__
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_find_species_kraken2;

sub test_find_species_kraken2 {
    my $r_kraken2 = check_conda_tool("kraken2");
    my $r_bracken = check_conda_tool("bracken");

    return 2 if $r_kraken2 == 2 || $r_bracken == 2;   # already tested this run
    return ($r_kraken2 && $r_bracken) ? 1 : 0;
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_find_species_kraken2;

sub preprocess_find_species_kraken2 {

    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";

    my $sample_name = $R_samples->[$samplenr]{name};
    my $sample_type = $R_samples->[$samplenr]{type};

    my $command         = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile      = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    ###################################
    ### check essential requirements

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__R1__", "__R2__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__SE__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__FASTA__");
    }

    # Skip only if the result already exists
    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_find_species_kraken2($samplenr);
        return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # Ensure output dir exists
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));

    # Set by sample_prescan's postprocessing, which requires() guarantees
    # has already run for FASTQ samples; defaults to 150 for FASTA (where
    # prescan never applies and this value isn't actually used downstream).
    my $bracken_len = $R_samples->[$samplenr]{bracken_readlength} // 150;

    # check for database file
    if (!test_db_kraken2()) {
        log_message("WARNING: Kraken2 database is missing. Kraken2 will be skipped.", "red");
        return "";
    }

    # runstep specific replacements
    _fill_placeholders__safe_replace(\$command, "__READLEN__", $bracken_len);

    # format command
    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}


# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_find_species_kraken2;

sub postprocess_find_species_kraken2 {
    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    #################
    # parse kraken/bracken results

    my $bracken_resultfile = fill_placeholders("__OUTDIR__/__BASE__.bracken",$samplenr,$runstep_name);
    my $bracken_resultfile_genus = fill_placeholders("__OUTDIR__/__BASE__.genus.bracken",$samplenr,$runstep_name);

    if(-f $bracken_resultfile){
      my $bracken_results_ref = parse_bracken_results($bracken_resultfile,'S');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species} = $bracken_results_ref;
      if (!$bracken_results_ref || !%{$bracken_results_ref}) {
        log_message("WARNING: bracken-species (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") { 
         log_message("WARNING: No bracken (pre-check) resultfile (species level) found for sample $sample_name");  
      } 
    }      
    if(-f $bracken_resultfile_genus){
      my $bracken_results_ref_genus = parse_bracken_results($bracken_resultfile_genus,'G');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus} = $bracken_results_ref_genus;
      if (!$bracken_results_ref_genus || !%{$bracken_results_ref_genus}) {
        log_message("WARNING: bracken-genus (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") {     
         log_message("WARNING: No bracken resultfile (genus level) found for sample $sample_name");   
      }
    }  
    if(-f $resultfile){
      my $kraken_results_ref = parse_kraken2_results($resultfile);
      $R_samples->[$samplenr]{results}{$runstep_name}{kraken2} = $kraken_results_ref;
      if (!$kraken_results_ref || !%{$kraken_results_ref}) {
        log_message("WARNING: kraken (pre-check) data could not be parsed for sample $sample_name" );
      }      
    }
    else{
      log_message("WARNING: No kraken2 (pre-check) resultfile found for sample $sample_name");   
      return 0; 
    }  

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "Kraken2 classification report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Bracken species report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_species.report",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Bracken genus report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_genuses.report",$samplenr, $runstep_name)),
    ); 
    
    
    #######################################  
    ## assign genus level taxonomy
    my $genus_method = "bracken";
    my $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{name} // "n/a";
    my $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{percent} // 0;    
    my $percent_int = int($genus_result_percent);  
    
    if($genus_result eq "n/a"){   
       $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{name} // "n/a";
       $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{percent} // 0;    
       $percent_int = int($genus_result_percent);
       $genus_method = "kraken2";   
    }
    

    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus} = $genus_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} = $genus_method;  
 

    
    
    #######################################  
    ## assign species level taxonomy  
    my $species_method = "bracken";    
    my $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{name} // "n/a";
    my $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{percent} // 0; 
    $percent_int = int($species_result_percent);   
     
    if($species_result eq "n/a"){
       $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{name} // "n/a";   
       $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{percent}// 0;
       $percent_int = int($species_result_percent); 
       $species_method = "kraken2"; 
    } 
    
       
    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{species} = $species_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = $species_method;  

    # load_expectations()/estimate_genomesize()/compute_targetbases() used to
    # run here. Moved out (runstep machinery design doc, §15): genomesize/
    # targetbases now computed in downsampling_bbmap's own preprocessing
    # (where they're actually used), and load_expectations now runs once,
    # late, right before QC evaluation -- by which point species (if
    # determinable at all) is reliably known, giving species-specific
    # thresholds instead of generic ones, with no functional change for any
    # sample where species-ID is disabled (get_config_value_for_species()
    # already falls back to defaults for an unknown/empty species).

    log_message("NOTICE: Sample $sample_name: genus is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{genus} (score $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}%) ","green");  
    log_message("NOTICE: Sample $sample_name: species is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{species} (score $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}%) ","green"); 

    return 1; # success
}


sub test_db_kraken2{
  # Use db_test if set (resolve_and_verify_databases updates it to the frozen path).
  # Fall back to db_path + hash.k2d for backwards compatibility.
  my $testfile_krakendb;
  my $db_test = $R_cfg->{kraken2}{db_test} // "";
  if ($db_test ne "") {
      $testfile_krakendb = fill_placeholders($db_test);
  } else {
      $testfile_krakendb = fill_placeholders( normalize_path($R_cfg->{kraken2}->{db_path}) . "/hash.k2d" );
  }
  return (-f $testfile_krakendb) ? 1 : 0;
}

##
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{unclassified_percent}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{species}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{species}[]{percent}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{genus}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{genus}[]{percent}
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{species}{entries}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{species}{entries}[]{percent}
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{genus}{entries}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{genus}{entries}[]{percent}
##
##
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus}
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}   
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} 
##
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species}
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}   
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} 
##
##
##
