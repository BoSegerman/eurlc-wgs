#      source_strand => ["+", ...],
#    },
#    {
#      file => "20C003",
#      ...
#    }
#  ]
#}

sub register_clustering_result {
    my (%args) = @_;

  

    my $species_dirname = $args{species_dirname};
    my $species         = $args{species} // $species_dirname;
    my $schema          = $args{schema};
    my $allele_table    = $args{hashed_alleles_all};

    if (!$species_dirname || !$schema) {
        log_message("WARNING: clustering result NOT registered: missing species_dirname or schema");
        return 0;
    }

    my %entry = (
        species_dirname => $species_dirname,
        species         => $species,
        schema          => $schema,

        distance_tsv_all  => $args{distance_tsv_all},
        success_tsv_all   => $args{success_tsv_all},
        distance_html_all => $args{distance_html_all},
        success_html_all  => $args{success_html_all},
        hashed_alleles_all => $allele_table ,
    );

    push @{ $rundata{clustering}{results} }, \%entry;

    my $n = scalar @{ $rundata{clustering}{results} || [] };
    

    return 1;
}

