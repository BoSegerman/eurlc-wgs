   log_message("ERROR: Fatal error - Conda is not found, aborting analysis", "red" );
   close_logfile();
   exit 1;
}
#----------------------
# output dir

# Default: <data folder>/eurlc-wgs (eurlc-wgs_qcscreen for --qc-screen).
# Set again after the arguments are read when datadir= or outdir= is given
# (see "Output folder" after the premount handlers).
our $S_OUTDIR_ARG;   # outdir=<folder>, absolute; undef = default location
