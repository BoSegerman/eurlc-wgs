####################################################################################################
####################################################################################################

sub parse_kraken2_results {
    my ($krakenreport_path) = @_;

    unless (-f $krakenreport_path) {
        log_message("WARNING: Kraken2 report file not found: $krakenreport_path");
        return {};
    }

    open my $fh, '<', $krakenreport_path
        or return {};

    my (%genuslevel, %specieslevel);
    my $unclassified_percent = 0;

    while (<$fh>) {
        chomp;
        next unless /\t/;  # skip non-data lines

        my @columns = split /\t/;
        next unless @columns >= 6;  # basic sanity check

        my ($percent, $count_clade, $count_level, $rank_code, $taxid, $taxname) = @columns;
        $taxname =~ s/^\s+|\s+$//g;

        if ($rank_code eq "U") {
            $unclassified_percent = $percent;
        }
        elsif ($rank_code eq "G") {
            $genuslevel{$taxname} = $percent;
        }
        elsif ($rank_code eq "S") {
            $specieslevel{$taxname} = $percent;
        }
    }
    close $fh;

    # Build result hashref
    my $result = {
        unclassified_percent => $unclassified_percent,
        genus   => [],
        species => [],
    };

    # Fill genus results (sorted descending)
    foreach my $taxname (sort { $genuslevel{$b} <=> $genuslevel{$a} } keys %genuslevel) {
        push @{ $result->{genus} }, {
            name    => $taxname,
            percent => $genuslevel{$taxname},
        };
    }

    # Fill species results (sorted descending)
    foreach my $taxname (sort { $specieslevel{$b} <=> $specieslevel{$a} } keys %specieslevel) {
        push @{ $result->{species} }, {
            name    => $taxname,
            percent => $specieslevel{$taxname},
        };
    }

    return $result;
}

sub print_kraken2_speciescheck_results {
    my ($sample_name, $sample_type, $results_ref) = @_;

    my $prespecies_result = $results_ref->{species}[0]{name} // "NA";
     
    log_message("NOTICE: Sample $sample_name: species detected as: $prespecies_result", "green");
}

            

####################################################################################################

sub parse_bracken_results {
    my ($bracken_path, $target_rank) = @_;

    $target_rank //= 'S';  # default to species

    unless (-f $bracken_path) {
        log_message("WARNING: Bracken result file not found: $bracken_path");
        return {};
    }

    open my $fh, '<', $bracken_path
        or do {
            log_message("WARNING: Could not open Bracken file $bracken_path: $!");
            return {};
        };

    my %level;

    my $header = <$fh>;
    unless (defined $header) {
        close $fh;
        return {};
    }

    while (<$fh>) {
        chomp;
        next unless /\t/;

        my @columns = split /\t/;
        next unless @columns >= 7;

        my ($name, $taxid, $rank, $kraken_reads, $added_reads, $new_est_reads, $fraction) = @columns;

        next unless $rank eq $target_rank;

        $name =~ s/^\s+|\s+$//g;
        next unless defined $fraction && $fraction =~ /^[0-9]*\.?[0-9]+$/;

        my $percent = sprintf("%.5f", $fraction * 100);
        $level{$name} = $percent;
    }

    close $fh;

    my $result = {
        entries => [],
    };

    foreach my $taxname (sort { $level{$b} <=> $level{$a} } keys %level) {
        push @{ $result->{entries} }, {
            name    => $taxname,
            percent => $level{$taxname},
        };
    }

    return $result;
}

