## read software versions


log_message("NOTICE: Collecting and documenting version info for the pipeline.");

my $softwareversions = log_tool_versions("enabled",getdir("out,log"));

# Verify database manifest (db_freeze.config). Runs after tool version
# logging so all version info is grouped in the same startup section.
# Logs results to log/versioning_explicit/databases.log every run.
{
    my $db_config_path = $R_cfg->{general}{db_freeze_config} // "";
    if ($db_config_path ne "" && -f $db_config_path) {
        log_message("NOTICE: Resolving database paths from manifest: $db_config_path");
        my $dbs = load_databases_config($db_config_path);
        if (%$dbs) {
            my $errors = resolve_and_verify_databases($dbs, getdir("out,log"));
            if ($errors > 0) {
                log_message("WARNING: $errors database(s) could not be resolved "
                           . "-- check log/versioning_explicit/databases.log", "red");
            } else {
                log_message("NOTICE: All databases resolved OK");
            }
        } else {
            log_message("WARNING: db_freeze.config is empty or could not be parsed: $db_config_path", "yellow");
        }
    }

    my $prog_config_path = $R_cfg->{general}{conda_manifest} // "";
    if ($prog_config_path ne "" && -f $prog_config_path) {
        log_message("NOTICE: Verifying conda environments against manifest: $prog_config_path");
        my $progs = load_conda_manifest($prog_config_path);
        if (%$progs) {
            my $errors = verify_programs($progs, getdir("out,log"));
            if ($errors > 0) {
                log_message("WARNING: $errors conda environment(s) failed verification "
                           . "-- check log/versioning_explicit/programs.log", "red");
            } else {
                log_message("NOTICE: All conda environments verified OK");
            }
        } else {
            log_message("WARNING: conda_manifest.ini is empty or could not be parsed: $prog_config_path", "yellow");
        }
    }

    # Write config.log -- fingerprints of all three config files plus seal status.
    # Uses the resolved seal path from $R_cfg->{general}{seal}.
    _write_config_log(getdir("out,log"));

}

log_message("INFO: Versions:\n$softwareversions");




