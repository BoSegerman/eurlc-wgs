sub test_sort_assemblies {

   return 2; # no test needed

}

$runstep{$runstep_name}{preprocessing} = \&preprocess_sort_assemblies;

sub preprocess_sort_assemblies {

    my $runstep_name = "sort_assemblies";

    log_message("INFO: Preparing to run step $runstep_name on all sample");

    my $command = "";

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {

        my $sample_name    = $R_samples->[$samplenr]{name};
        my $sample_type    = $R_samples->[$samplenr]{type};
        my $sample_species = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "unknown";

        $sample_species =~ s/\s/_/g;

        my $command_part = $runstep{$runstep_name}{cmd_template};
        my $resultfile   = $runstep{$runstep_name}{resultfile};
        my $outputdir    = $runstep{$runstep_name}{output_dir};

        $command_part =~ s/__SPECIES__/$sample_species/g;
        $resultfile   =~ s/__SPECIES__/$sample_species/g;
        $outputdir    =~ s/__SPECIES__/$sample_species/g;

        $command_part = fill_placeholders($command_part, $samplenr, $runstep_name);
        $resultfile   = fill_placeholders($resultfile,   $samplenr, $runstep_name);
        $outputdir    = fill_placeholders($outputdir,    $samplenr, $runstep_name);

        my $sourcefile = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name);

        ensure_dir($outputdir);

        if (! -f $sourcefile) {
            log_message("WARNING: Sample $sample_name: source assembly file missing [$sourcefile], skipping sort step for this sample", "yellow");
            next;
        }

        if (! -f $resultfile) {
            if ($command eq "") {
                $command = $command_part;
            }
            else {
                $command = $command . " ; " . $command_part;
            }
        }
    }

    if ($command eq "") {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name}. Files already sorted or no source assemblies available");
        postprocess_sort_assemblies();
        return "";
    }

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_sort_assemblies;

sub postprocess_sort_assemblies {
    
    my $runstep_name = "sort_assemblies";

    my $outputdir = $runstep{$runstep_name}{output_dir};  

    # runstep specific replacements
    $outputdir =~ s/__SPECIES__//g;
       
    #format command
    $outputdir  = fill_placeholders($outputdir, "", $runstep_name);     
       
    my $result_ref = parse_sort_assemblies($outputdir);
    
   $rundata{batches} = $result_ref; 
   
   my $hitcount = $result_ref->{subdirs_count};

   
   for(my $i=0;$i<$hitcount; $i++){
   my $dirname = $result_ref->{subdirs}[$i];
   my $species = $result_ref->{$dirname}{species};
   my $samples = $result_ref->{$dirname}{count};
   log_message("NOTICE: Species $species: $samples samples", "green");
  }
      
    
    return 1; # success
}

# PARSER ----------------------------------

sub parse_sort_assemblies {
    my ($dir) = @_;
    my %result;

    # Ensure directory exists
    unless (-d $dir) {
        log_message("WARNING: Directory not found: $dir", "red");
        return {};
    }

    opendir(my $dh, $dir) or do {
        log_message("WARNING: Could not open directory: $dir", "red");
        return {};
    };

    my @subdirs;
    while (my $entry = readdir($dh)) {
        next if $entry =~ /^\./;  # skip . and ..
        my $path = File::Spec->catdir($dir, $entry);
        push @subdirs, $entry if -d $path;
    }
    closedir $dh;

    # Store subdir list
    $result{subdirs} = \@subdirs;
    $result{subdirs_count} = @subdirs;
    
    # Process each subdir
    for my $subdir (@subdirs) {
        my $path = File::Spec->catdir($dir, $subdir);
        opendir(my $sdh, $path) or do {
            log_message("WARNING: Could not open subdirectory: $path", "red");
            next;
        };

        my @fasta_files = grep { /\.fasta$/i && -f File::Spec->catfile($path, $_) } readdir($sdh);
        closedir $sdh;

        my $count   = scalar @fasta_files;
        my $species = $subdir;
        $species =~ s/_/ /g;

        $result{$subdir} = {
            count   => $count,
            species => $species,
            fasta   => [ map { File::Spec->catfile($path, $_) } @fasta_files ],
        };
    }

    return \%result;
}

