our $VERSION           = $PIPELINE_VERSION;   # kept for Perl --version-style tooling conventions

# Forward declaration: summarize_results() is called from the postmount
# argument-handling section, well before its own definition is reached --
# without this, Perl can't check its (empty) prototype at those call sites
# and says so. Harmless either way, but this removes the noise.
sub summarize_results ();

 
