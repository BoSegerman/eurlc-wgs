    # getcwd() returns undef when the shell's CWD has been deleted/renamed
    # (e.g. the user ran --install-scheme from inside a schema dir that got
    # moved by PrepExternalSchema).  Fall back to HOME for early-exit commands
    # that don't need an input directory; for normal runs this produces a clear
    # error message a few lines below via the "not a directory" check.
    my $cwd = eval { getcwd() };
    if (!defined $cwd || $cwd eq "") {
        $cwd = $ENV{HOME} // "/tmp";
        warn "WARNING: Current working directory no longer exists on disk.\n"
           . "         Run eurlc-wgs from a valid directory.\n"
             unless $S_SUPPRESS_STARTUP_LOG;
    }
    setdir( "in"     , $cwd);
    setdir( "program", dirname($0));
    setfile("program", $0);
    setdir("home"    , $ENV{HOME});
    setdir("db"      , peekdir("home") . "/$rundata{pipeline_info}{name}_db");
    setdir("archive" , peekdir("home") . "/$rundata{pipeline_info}{name}_archive");
}


