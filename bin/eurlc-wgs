foreach my $arg (@ARGV) {
  if    ( $arg eq "--no-color" || $arg eq "--no-colour") { $USE_COLOR = 0; }
  elsif ( $arg eq "--color"    || $arg eq "--colour")    { $USE_COLOR = 1; }
}

# Skip-all-interactive-prompts mode. Declared this early (like $USE_COLOR
# above) so it's available even to premount handlers, before %args/%R_cfg
# even exist. Merged with any config-file/CLI-override value later (see
# "$ASSUME_YES ||= ..." near initiate_logfile()) without ever resetting an
# early "yes" back to "no". Does NOT apply to general.overwrite -- that
# prompt (whether to delete an existing output directory) stays fully
# interactive regardless of this flag; see its own dedicated handling below.
my $ASSUME_YES = 0;

foreach my $arg (@ARGV) {
  if ( $arg eq "--assume-yes") { $ASSUME_YES = 1; }
}



