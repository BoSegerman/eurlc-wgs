## runstep multiqc

$runstep_name = "multiqc";

$runstep{$runstep_name} = {
      message    => "Running MultiQC...",
      long_name  => "MultiQC",
      output_dir => "",
      resultfile => "",
      resultfiles_status => "NA",

      # Batch-level -- pure aggregation over the QC1/QC2 output folder
      # structure, not tied to any specific per-sample data-key. Was an
      # unconditional "REQUIRED STEP" with no enabled flag.
      requires   => [],
      produces   => [ 'multiqc_done' ],
      applies_if => sub { return 1; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
cd "__DIR-QC1__"
__NEWCOMMAND__
conda run -n $R_cfg->{multiqc}->{env} --no-capture-output multiqc . __HIDE-OUTPUT__

__NEWCOMMAND__
cd "__DIR-QC2__"
__NEWCOMMAND__
conda run -n $R_cfg->{multiqc}->{env} --no-capture-output multiqc . __HIDE-OUTPUT__

__NEWCOMMAND__
cd "__DIR-QC3__"
__NEWCOMMAND__
conda run -n $R_cfg->{multiqc}->{env} --no-capture-output multiqc . __HIDE-OUTPUT__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_multiqc;

sub test_multiqc {
   return check_conda_tool("multiqc");
}

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_multiqc;

sub preprocess_multiqc {

    my $runstep_name = "multiqc";

    log_message("INFO: Preparing to run step $runstep_name on all samples");

    my $command = $runstep{$runstep_name}{cmd_template};
    $command = fill_placeholders($command, "", $runstep_name);

    my $qc1_report = fill_placeholders("__DIR-QC1__/multiqc_report.html", "", $runstep_name);
    my $qc2_report = fill_placeholders("__DIR-QC2__/multiqc_report.html", "", $runstep_name);
    my $qc3_report = fill_placeholders("__DIR-QC3__/multiqc_report.html", "", $runstep_name);

    # Store expected result files for later use / reporting
    $runstep{$runstep_name}{resultfiles} = [
        $qc1_report,
        $qc2_report,
        $qc3_report,
    ];

    # Skip if all expected reports already exist.
    # For FASTA-only runs stage1/stage2 reports are never produced, so only
    # require qc3 in that case.
    my $has_fastq = grep { ($_->{type} // '') ne 'FASTA' } @$R_samples;
    my $already_done = $has_fastq
        ? (-s $qc1_report && -s $qc2_report && -s $qc3_report)
        : (-s $qc3_report);
    if ($already_done) {
        log_message("NOTICE: Skipping $runstep_name, all expected MultiQC reports already exist");
        postprocess_multiqc();
        return "";
    }

    return $command;
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_multiqc;


sub postprocess_multiqc {

    my $runstep_name = "multiqc";

    my $R_resultfiles = $runstep{$runstep_name}{resultfiles} || [];

    # Stage 1 (raw-read QC) and stage 2 (trimmed-read QC) have no input for
    # FASTA-type samples, so MultiQC produces no report for those stages in
    # FASTA-only runs.  Only warn when a report is missing AND at least one
    # sample in the batch actually had FASTQ data to feed into that stage.
    my $has_fastq_samples = grep { ($_->{type} // '') ne 'FASTA' } @$R_samples;

    my $qc1_report = fill_placeholders("__DIR-QC1__/multiqc_report.html", "", $runstep_name);
    my $qc2_report = fill_placeholders("__DIR-QC2__/multiqc_report.html", "", $runstep_name);
    my $qc3_report = fill_placeholders("__DIR-QC3__/multiqc_report.html", "", $runstep_name);

    for my $entry (
        [ $qc1_report, $has_fastq_samples, "stage 1 (raw-read QC)"    ],
        [ $qc2_report, $has_fastq_samples, "stage 2 (trimmed-read QC)"],
        [ $qc3_report, 1,                  "stage 3 (assembly QC)"    ],
    ) {
        my ($file, $expected, $label) = @$entry;
        if (!defined $file || !-s $file) {
            if ($expected) {
                log_message("WARNING: Expected MultiQC result file missing or empty: [$file]");
                return 0;
            } else {
                log_message("INFO: MultiQC $label report not produced (no FASTQ samples in this run) -- skipping [$file]");
            }
        }
    }


for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report1} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC1__/multiqc_report.html", "", $runstep_name)
        );

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report2} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC2__/multiqc_report.html", "", $runstep_name)
        );

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report3} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC3__/multiqc_report.html", "", $runstep_name)
        );
}

    return 1;
}


## runstep cleanup

$runstep_name = "cleanup";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 1 },
      message    => "Cleaning up intermediate files...",
      long_name  => "Cleanup intermediate files",
      output_dir => "",
      resultfile => "",
      resultfiles_status => "NA",

      # Runs once, at the very end (last in @BATCH_RUNSTEPS_POST).
      # Per-filetype removal is controlled by [cleanup] in the config.
      # Records what it removed in log/cleanup.json, so a later --resume
      # knows the reads were removed on purpose and re-creates them only for
      # samples that need them (plan_read_regeneration).
      requires   => [],
      produces   => [ 'cleanup_done' ],
      applies_if => sub { return 1; },
};

$runstep{$runstep_name}{test} = sub { return 2; };   # no tool or database to check
$runstep{$runstep_name}{preprocessing} = \&preprocess_cleanup;

# All work is done here, in the parent: the batch scheduler calls
# result_parsing only after a step that ran a command, and cleanup has none
# (before, postprocess_cleanup was never called and nothing was removed).
sub preprocess_cleanup {
    my $runstep_name = "cleanup";
    log_message("INFO: Starting $runstep_name step");
    postprocess_cleanup();
    return "";
}

sub postprocess_cleanup {
    my $cfg = $R_cfg->{cleanup} // {};

    # ── Jellyfish .jf databases ──────────────────────────────────────────────
    # Removed unconditionally in run_jellyfish() right after the histogram is
    # written, so there is nothing to do here.

    # ── Trimmed FASTQ ────────────────────────────────────────────────────────
    if ($cfg->{trimmed_fastq} // 1) {
        my $trimmed_dir = getdir("out,large_files,fastq,trimmed");
        if (defined $trimmed_dir && -d $trimmed_dir) {
            my $removed = _cleanup_fastq_dir($trimmed_dir, "trimmed FASTQ");
            log_message("INFO: Cleanup: removed $removed trimmed FASTQ file(s) from [$trimmed_dir]");
        }
    } else {
        log_message("INFO: Cleanup: keeping trimmed FASTQ files (cleanup.trimmed_fastq = 0)");
    }

    # ── Downsampled FASTQ ────────────────────────────────────────────────────
    if ($cfg->{downsampled_fastq} // 1) {
        my $td_dir = getdir("out,large_files,fastq,trimmed_downsampled");
        if (defined $td_dir && -d $td_dir) {
            my $removed = _cleanup_fastq_dir($td_dir, "downsampled FASTQ");
            log_message("INFO: Cleanup: removed $removed downsampled FASTQ file(s) from [$td_dir]");
        }
    } else {
        log_message("INFO: Cleanup: keeping downsampled FASTQ files (cleanup.downsampled_fastq = 0)");
    }

    # ── Merged lane FASTQ (B28) ──────────────────────────────────────────────
    if ($cfg->{merged_fastq} // 1) {
        my $m_dir = getdir("out,large_files,fastq,merged", 0);
        if (defined $m_dir && -d $m_dir) {
            my $removed = _cleanup_fastq_dir($m_dir, "merged lane FASTQ");
            log_message("INFO: Cleanup: removed $removed merged lane FASTQ file(s) from [$m_dir]");
        }
    } else {
        log_message("INFO: Cleanup: keeping merged lane FASTQ files (cleanup.merged_fastq = 0)");
    }

    # ── BAM / BAI ────────────────────────────────────────────────────────────
    if ($cfg->{bam} // 1) {
        my $remap_base = fill_placeholders("__DIR-QC3__/remapping", "", $runstep_name);
        if (defined $remap_base && -d $remap_base) {
            my $removed = 0;
            for my $sample (@$R_samples) {
                # the file names use the sample's base name, which is its
                # name (samples have no separate "base" key -- reading one
                # made this loop skip every sample, so no BAM was removed)
                my $base = $sample->{name} // "";
                next unless $base;
                # with the BAM goes the copy of the assembly it was mapped to
                # (the remap step removes both itself since November 2026;
                # this tidies folders made before that)
                for my $ext (qw(.sorted.bam .sorted.bam.bai .fasta .fasta.fai)) {
                    my $f = "$remap_base/$base/$base$ext";
                    next unless -f $f;
                    if (unlink $f) { $removed++ }
                    else { log_message("WARNING: Cleanup: could not remove [$f]: $!") }
                }
            }
            log_message("INFO: Cleanup: removed $removed BAM/BAI file(s) from [$remap_base]");
        }
    } else {
        log_message("INFO: Cleanup: keeping BAM files (cleanup.bam = 0)");
    }

    # ── BLAST tmp of ResFinder / VirulenceFinder / PlasmidFinder ─────────────
    if ($cfg->{blast_tmp} // 1) {
        my ($n, $bytes) = (0, 0);
        my $res = getdir("out") . "/results";
        for my $tmp ( glob("$res/*/*/*/*_blast/tmp $res/*/*/*_blast/tmp") ) {
            next unless -d $tmp && $tmp =~ m{_blast/tmp$};
            for my $f ( glob("$tmp/*") ) { $bytes += ( -s $f ) // 0 if -f $f; }
            remove_tree($tmp, { result => \my $gone });
            $n++;
        }
        log_message(sprintf("INFO: Cleanup: removed %d BLAST tmp folder(s) (%.1f MB)", $n, $bytes / 1e6)) if $n;
    }

    # What is gone now (this run's removals plus any earlier ones that were
    # not re-created), for plan_read_regeneration on a later --resume.
    my %removed = %S_CLEANUP_REMOVED;
    $removed{trimmed_fastq}     = 1 if $cfg->{trimmed_fastq}     // 1;
    $removed{downsampled_fastq} = 1 if $cfg->{downsampled_fastq} // 1;
    $removed{merged_fastq}      = 1 if ( $cfg->{merged_fastq} // 1 ) && grep { $_->{paths}{lane_sources} } @$R_samples;
    $removed{bam}               = 1 if $cfg->{bam}               // 1;
    write_json_file( { removed => [ sort keys %removed ], time => timestamp_UTC() },
                     getdir("out,log") . "/cleanup.json" ) if %removed;

    return 1;
}

# Resume after a cleanup: are this sample's reads of this category gone on
# purpose (and not being re-created in this run)? Then the data key counts
# as satisfied, so steps that already have their results read them in.
sub reads_removed_by_cleanup {
    my ($i, $category) = @_;
    return 0 unless $S_CLEANUP_REMOVED{$category};
    return 0 if $R_samples->[$i]{_regen_reads}{$category};
    return 1;
}

# Resume after a cleanup (log/cleanup.json): find the samples that still
# have a step to run which reads the trimmed or downsampled reads (no
# result file yet -- new tool, rerun=, earlier failure), and re-create the
# reads only for those: their read-producing steps' result files are
# removed, so fastp / downsampling run again (deterministic: fixed seed).
# All other samples keep their results and need no reads.
sub plan_read_regeneration {
    our @PER_SAMPLE_RUNSTEPS;   # declared further down (run-order lists)
    %S_CLEANUP_REMOVED = ();
    return unless is_resume_mode();
    my $marker = getdir("out,log") . "/cleanup.json";
    return unless -f $marker;
    my $m = eval { read_json_file($marker) } // {};
    %S_CLEANUP_REMOVED = map { $_ => 1 } @{ $m->{removed} // [] };
    return unless $S_CLEANUP_REMOVED{trimmed_fastq} || $S_CLEANUP_REMOVED{downsampled_fastq};

    my %cat_of_key = ( trimmed_fastq => 'trimmed_fastq', trimmed_downsampled_fastq => 'downsampled_fastq' );
    my %producer;   # data key -> producing runsteps
    for my $name (@PER_SAMPLE_RUNSTEPS) {
        push @{ $producer{$_} }, $name for grep { $cat_of_key{$_} } @{ $runstep{$name}{produces} // [] };
    }
    my %is_producer = map { $_ => 1 } map { @$_ } values %producer;

    local $S_STATIC_APPLIES = 1;
    my @regen;
    for my $i ( 0 .. $#$R_samples ) {
        next if ( $R_samples->[$i]{type} // '' ) eq 'FASTA';
        my %need;   # data key -> step that needs it
        for my $name (@PER_SAMPLE_RUNSTEPS) {
            next if $is_producer{$name};
            my $def = $runstep{$name};
            my @keys = grep { $cat_of_key{$_} } @{ $def->{requires} // [] };
            next unless @keys;
            next unless eval { $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
            my $rf = $def->{resultfile} // "";
            next if $rf eq "";
            my $f = eval { fill_placeholders($rf, $i, $name) } // "";
            next if $f eq "" || $f =~ /__[A-Z0-9-]+__/ || -e $f;
            # done in an earlier form (e.g. remap before the streaming way,
            # whose result file was the BAM): no reads needed
            next if $def->{done_otherwise} && eval { $def->{done_otherwise}->($i) };
            $need{$_} //= $name for @keys;
        }
        next unless %need;
        if ( my $miss = $S_RAW_MISSING{ $R_samples->[$i]{name} // "" } ) {
            my $why = join(", ", map { "$_ (for $need{$_})" } sort keys %need);
            log_message("WARNING: Sample " . ( $R_samples->[$i]{name} // $i ) . ": its reads are needed again ($why), "
                      . "but the raw data is not found [$miss->[0]] -- those steps will fail. Give datadir= for the folder that holds the data.", "red");
            set_runtime_issue($i, "warning", "Raw data not found on resume: steps that need the reads again cannot run");
        }
        # downsampled reads are made from the trimmed ones
        $need{trimmed_fastq} //= "downsampling" if $need{trimmed_downsampled_fastq};
        my @what;
        for my $key ( sort keys %need ) {
            my $cat = $cat_of_key{$key};
            next unless $S_CLEANUP_REMOVED{$cat};
            $R_samples->[$i]{_regen_reads}{$cat} = 1;
            push @what, "$cat (for $need{$key})";
            for my $p ( @{ $producer{$key} // [] } ) {
                my $prf = $runstep{$p}{resultfile} // "";
                next if $prf eq "";
                my $pf = eval { fill_placeholders($prf, $i, $p) } // "";
                unlink $pf if $pf ne "" && $pf !~ /__[A-Z0-9-]+__/ && -e $pf;
            }
        }
        push @regen, ( $R_samples->[$i]{name} // "sample $i" ) . ": " . join(", ", @what) if @what;
    }
    if (@regen) {
        log_message("NOTICE: Resume: reads were removed by an earlier cleanup -- re-creating them for " . scalar(@regen) . " sample(s) that need them");
        log_message("INFO:   $_") for @regen;
        $rundata{run_history}{reads_recreated} = \@regen;
    } else {
        log_message("NOTICE: Resume: reads were removed by an earlier cleanup -- no remaining step needs them, nothing to re-create");
    }
}

# Helper: removes all .fastq.gz and .fastq files from a directory.
# Returns the count of files removed.
sub _cleanup_fastq_dir {
    my ($dir, $label) = @_;
    my $removed = 0;
    opendir(my $dh, $dir) or do {
        log_message("WARNING: Cleanup: could not open $label directory [$dir]: $!");
        return 0;
    };
    while (my $entry = readdir $dh) {
        next unless $entry =~ /\.fastq(\.gz)?$/i;
        my $path = "$dir/$entry";
        next unless -f $path || -l $path;   # -l: links (no-downsampling) whose target is already gone
        if (unlink $path) { $removed++ }
        else { log_message("WARNING: Cleanup: could not remove $label file [$path]: $!") }
    }
    closedir $dh;
    return $removed;
}

