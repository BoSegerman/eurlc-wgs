# Stop here, before any of the expensive setup work below (conda environment
# checks, database downloads) -- there is nothing to analyze, so there's no
# point doing any of that. This is deliberately not treated as an ERROR (it's
# not a bug, most likely just the wrong directory, or files in a subfolder
# without recursive=yes) and uses its own distinct exit code (2, rather than
# graceful_die's 1) so a caller -- e.g. a GUI launcher -- can distinguish
# "nothing to do" from a genuine failure.
if ($rundata{stats}{total} == 0) {
    log_message("NOTICE: No FASTQ/FASTA files found in [" . getdir("in") . "].");
    log_message("NOTICE: If your files are in a subfolder, try recursive=yes.");
    log_message("NOTICE: If you meant a different folder, use datadir=<path>.");
    log_message("NOTICE: Nothing to analyze -- stopping here.");
    close_logfile();
    exit 2;
}



