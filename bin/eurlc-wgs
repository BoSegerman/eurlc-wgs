## startup 

# Ensures output is flushed immediately rather than buffered, so log output and
# GUI-launcher live display reflect progress in real time. Explicit on both
# handles rather than relying on $| (which only affects the currently selected
# handle, default STDOUT) -- robust even if select() is used elsewhere later.
STDOUT->autoflush(1);
STDERR->autoflush(1);

