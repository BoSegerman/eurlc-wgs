# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_update_fastmlst_db;

my $fastmlst_update_done = 0;
my $fastmlst_db_age = 0;


sub preprocess_update_fastmlst_db {

    my ($samplenr) = @_;

    my $runstep_name = "update_fastmlst_db";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{update_db};     

    my $fastmlst_db_path = find_fastmlst_db_path();
    
    my $resultfile = "$fastmlst_db_path/mlst.fasta";
    $fastmlst_db_age = file_age_days($resultfile);
    
    
  log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
     
     log_message("INFO: fastmlst database path is [$fastmlst_db_path]");
     
   if( is_docker() ) {    
      return "";
   }
   if($fastmlst_update_done){
      return "";
   }
   if( ! exists($R_cfg->{fastmlst}->{run_update_db}) ){
     return "";
   }

   my $missing_files = 0;
    if( !(-f fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.results",$samplenr)) )    { $missing_files = 1;}
    if($R_cfg->{unicycler}->{enabled} && $sample_type ne "FASTA" && ! (-f fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.unicycler.results",$samplenr)) )   { $missing_files = 1;}
    if($R_cfg->{skesa}->{enabled}     && $sample_type ne "FASTA" && ! (-f fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.skesa.results",$samplenr)) )   { $missing_files = 1;}
    if($R_cfg->{shovill}->{enabled}   && $sample_type ne "FASTA" && ! (-f fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.shovill.results",$samplenr)) )   { $missing_files = 1;}
    if($R_cfg->{spades}->{enabled}    && $sample_type ne "FASTA" && ! (-f fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.spades.results",$samplenr)) )   { $missing_files = 1;}

   if( $missing_files==0 ){
     return "";  # all resultfiles already present for this sample
   }
      

   
    if($fastmlst_db_age == -1){
       $fastmlst_update_done = 1;  # mark as done and proceed running the update
    }
    elsif($R_cfg->{fastmlst}->{run_update_db} eq "always" || $R_cfg->{fastmlst}->{run_update_db} eq "yes" )   {
         $fastmlst_update_done = 1;  # mark as done and proceed running the update
    }
    elsif($R_cfg->{fastmlst}->{run_update_db} eq "no" ){
       if( -f $resultfile){
          return "";
       }
       else{
          $fastmlst_update_done = 1;  # mark as done and proceed running the update
       } 
    }
    elsif($R_cfg->{fastmlst}->{run_update_db} eq "weekly" ){
       if( -f $resultfile && $fastmlst_db_age<=7 ){
          return "";
       }
       else{
          $fastmlst_update_done = 1;  # mark as done and proceed running the update
       } 
    }
    elsif($R_cfg->{fastmlst}->{run_update_db} eq "biweekly" ){
       if( -f $resultfile && $fastmlst_db_age<=14 ){
          return "";
       }
       else{
          $fastmlst_update_done = 1;  # mark as done and proceed running the update
       } 
    }
    elsif($R_cfg->{fastmlst}->{run_update_db} eq "monthly" ){
       if( -f $resultfile && $fastmlst_db_age<=30 ){
          return "";
       }
       else{
          $fastmlst_update_done = 1;  # mark as done and proceed running the update
       } 
    }
    elsif(looks_like_number($R_cfg->{fastmlst}->{run_update_db})  ){
       if( -f $resultfile && $fastmlst_db_age<=$R_cfg->{fastmlst}->{run_update_db} ){
          return "";
       }
       else{
          $fastmlst_update_done = 1;  # mark as done
       } 
    }
    else{
       log_message("WARNING: could not determine fastMLST update db intervall [$R_cfg->{fastmlst}->{run_update_db}] - skipping update");
       $fastmlst_update_done = 1;  # failed, but mark as done so we not try again
       return "";
    }
    
  
    
   
        
    my $u_threads = $R_cfg->{fastmlst}->{update_db_threads} // 2;
           
    # runstep specific replacements
    
    _fill_placeholders__safe_replace(\$command, "__UPDATE_THREADS__", $u_threads);
    
   
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);
    
    #create output dir

    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_update_fastmlst_db;

sub postprocess_update_fastmlst_db {
    my ($samplenr) = @_;

    my $runstep_name = "update_fastmlst_db";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $fastmlst_db_path = find_fastmlst_db_path();
    
    my $resultfile = "$fastmlst_db_path/mlst.fasta";
    
    my $new_age = file_age_days($resultfile);


  if($fastmlst_db_age >=0) { log_message("NOTICE: fastmlst database age was $fastmlst_db_age days", "green");}
   if($fastmlst_db_age == -1) { log_message("NOTICE: fastmlst database was not found", "green");}
  if(exists ($R_cfg->{fastmlst}->{run_update_db}) ) { log_message("NOTICE: Database update intervall is: $R_cfg->{fastmlst}->{run_update_db}", "green"); }
   if($new_age == -1) { log_message("WARNING: fastmlst database is still not found", "yellow");}
   if($new_age >= 0) { log_message("NOTICE: fastmlst database is age after update is $new_age days ", "green");}



    return 1; # success
}

