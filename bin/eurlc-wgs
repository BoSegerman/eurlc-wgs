## list input files

log_message("NOTICE: collecting sample information.");

# The sample set of an output directory is fixed by its first run. A
# resumed run (overwrite=resume / rerun=) reuses the saved file lists in
# log/ and never adds samples: results from different runs could otherwise
# come from different program and database versions. Input files that
# have appeared since are reported, not analysed -- analyse them in a new
# run (and combine runs afterwards).
{
    my $recursive_flag = $R_cfg->{"general"}->{"recursive"} ? 1 : 0;
    my $filelist_path_fastq = getdir("out,log") . "/filelist_fastq.txt";
    my $filelist_path_fasta = getdir("out,log") . "/filelist_fasta.txt";

    if ( !is_resume_mode() ) {

        log_message("INFO: Preparing list of input files");

        if ($recursive_flag) {
            log_message("NOTICE: Recursive search enabled -- scanning [" . getdir("in") . "] and all subdirectories for input files. This may take a while for large directory trees.");
        }

        my @list_off_files_fastq = $R_cfg->{"general"}{"fastq"} ? prepare_fastq_files(getdir("in"),$recursive_flag) : ();
        my @list_off_files_fasta = $R_cfg->{"general"}{"fasta"} ? prepare_fasta_files(getdir("in"),$recursive_flag) : ();

        open(my $fh, '>', $filelist_path_fastq) or graceful_die("Could not open '$filelist_path_fastq' for writing: $!");
        print $fh "$_\n" for @list_off_files_fastq;
        close($fh);
        log_message("INFO: Wrote ".scalar(@list_off_files_fastq)." fastq files to '$filelist_path_fastq'");

        open($fh, '>', $filelist_path_fasta) or graceful_die("Could not open '$filelist_path_fasta' for writing: $!");
        print $fh "$_\n" for @list_off_files_fasta;
        close($fh);
        log_message("INFO: Wrote ".scalar(@list_off_files_fasta)." fasta files to '$filelist_path_fasta'");
    }
    else {
        my @missing_lists = grep { !-f $_ } ($filelist_path_fastq, $filelist_path_fasta);
        if (@missing_lists) {
            graceful_die("Cannot resume: the sample list of the earlier run is missing ("
                       . join(", ", map { basename($_) } @missing_lists) . " in " . getdir("out,log") . "). "
                       . "Without it the sample set cannot be guaranteed to be the same -- start a new run instead.");
        }
        log_message("NOTICE: Resuming with the sample list of the earlier run (log/filelist_fastq.txt, log/filelist_fasta.txt)");

        # Report input files that are not part of this output directory.
        # Compared by input file, not by line: the sample names of an
        # earlier run may follow older naming rules (B28).
        my $files_of = sub { my ($l) = @_; my @f = split /\t/, $l, -1; my $nf = @f;
                             return grep { $_ ne "" && m{/} } @f[ $nf > 2 ? ( 0, 1, 4 .. $nf - 1 ) : ( 0 ) ]; };
        # Compared relative to the data folder, so that the files of a moved
        # analysis (the recorded paths are those of the old place) are not
        # taken for new ones.
        my $now_root = eval { abs_path( getdir("in") ) } // getdir("in");
        my @roots = sort { length($b) <=> length($a) } ( @S_DATA_ROOTS_OLD, $now_root );
        my $rel = sub {
            my ($p) = @_;
            for my $r (@roots) { return substr( $p, length($r) + 1 ) if index( $p, "$r/" ) == 0; }
            return $p;
        };
        my %saved;
        for my $f ($filelist_path_fastq, $filelist_path_fasta) {
            open(my $in, '<', $f) or next;
            while (my $l = <$in>) { chomp $l; next if $l eq ""; $saved{ $rel->($_) } = 1 for $files_of->($l); }
            close $in;
        }
        my @now = map { $files_of->($_) } (
            ( $R_cfg->{"general"}{"fastq"} ? do { local $S_QUIET_SAMPLE_LIST = 1; prepare_fastq_files(getdir("in"), $recursive_flag) } : () ),
            ( $R_cfg->{"general"}{"fasta"} ? prepare_fasta_files(getdir("in"), $recursive_flag) : () ),
        );
        my @new = grep { !$saved{ $rel->($_) } } @now;
        if (@new) {
            my $n = scalar @new;
            my @show = @new[0 .. ($n > 10 ? 9 : $n - 1)];
            log_message("WARNING: $n input file(s) in [" . getdir("in") . "] are not part of this output directory and are NOT analysed in a resumed run"
                      . " (analyse them in a new run): " . join(", ", map { basename($_) } @show) . ( $n > 10 ? ", ..." : "" ), "yellow");
        }
    }
}

$rundata{stats}{PE}    //= 0;
$rundata{stats}{SE}    //= 0;
$rundata{stats}{FASTA} //= 0;
$rundata{stats}{total} //= 0;

read_fastq_filelist(\%rundata);
read_fasta_filelist(\%rundata);
check_moved_inputs(\%rundata) if is_resume_mode();

log_message(
    "NOTICE: Found $rundata{stats}{total} samples " .
    "($rundata{stats}{PE} PE, " .
    "$rundata{stats}{SE} SE, " .
    "$rundata{stats}{FASTA} FASTA)"
);

for my $sample ( @$R_samples) {
    log_message("NOTICE: $sample->{name} [$sample->{type}]", "green");
}

write_sample_manifest(\%rundata);

# Stop here, before any of the expensive setup work below (conda environment
# checks, database downloads) -- there is nothing to analyze, so there's no
# point doing any of that. This is deliberately not treated as an ERROR (it's
# not a bug, most likely just the wrong directory, or files in a subfolder
# without recursive=yes) and uses its own distinct exit code (2, rather than
# graceful_die's 1) so a caller -- e.g. a GUI launcher -- can distinguish
# "nothing to do" from a genuine failure.
if ($rundata{stats}{total} == 0) {
    log_message("NOTICE: No FASTQ/FASTA files found in [" . getdir("in") . "].");
    log_message("NOTICE: If your files are in a subfolder, try recursive=yes.");
    log_message("NOTICE: If you meant a different folder, use datadir=<path>.");
    log_message("NOTICE: Nothing to analyze -- stopping here.");
    close_logfile();
    exit 2;
}




###################################################################################################
## read software versions


log_message("NOTICE: Collecting and documenting version info for the pipeline.");

my $softwareversions = log_tool_versions("enabled",getdir("out,log"));

# Verify database manifest (db_freeze.config). Runs after tool version
# logging so all version info is grouped in the same startup section.
# Logs results to log/versioning_explicit/databases.log every run.
{
    my $db_config_path = $R_cfg->{general}{db_freeze_config} // "";
    if ($db_config_path ne "" && -f $db_config_path) {
        log_message("NOTICE: Resolving database paths from manifest: $db_config_path");
        my $dbs = load_databases_config($db_config_path);
        if (%$dbs) {
            my $errors = resolve_and_verify_databases($dbs, getdir("out,log"));
            if ($errors > 0) {
                log_message("WARNING: $errors database(s) could not be resolved "
                           . "-- check log/versioning_explicit/databases.log", "red");
            } elsif ($S_DB_NOT_INSTALLED) {
                log_message("NOTICE: $S_DB_NOT_INSTALLED database(s) not installed yet -- the test phase offers to install them", "yellow");
            } else {
                log_message("NOTICE: All databases resolved OK");
            }
        } else {
            log_message("WARNING: db_freeze.config is empty or could not be parsed: $db_config_path", "yellow");
        }
    }

    my $prog_config_path = $R_cfg->{general}{conda_manifest} // "";
    if ($prog_config_path ne "" && -f $prog_config_path) {
        log_message("NOTICE: Verifying conda environments against manifest: $prog_config_path");
        my $progs = load_conda_manifest($prog_config_path);
        if (%$progs) {
            my $errors = verify_programs($progs, getdir("out,log"));
            if ($errors > 0) {
                log_message("WARNING: $errors conda environment(s) failed verification "
                           . "-- check log/versioning_explicit/programs.log", "red");
            } else {
                log_message("NOTICE: All conda environments verified OK");
            }
        } else {
            log_message("WARNING: conda_manifest.ini is empty or could not be parsed: $prog_config_path", "yellow");
        }
    }

    # Write config.log -- fingerprints of all three config files plus seal status.
    # Uses the resolved seal path from $R_cfg->{general}{seal}.
    _write_config_log(getdir("out,log"));

}

log_message("INFO: Versions:\n$softwareversions");




###################################################################################################
## species identification used to have its own dedicated test+run pass
## here, entirely separate from the main per-sample loop -- this is exactly
## the structure the runstep machinery redesign replaces (see the design
## doc, §1/§5/§6/§15). find_species_kraken2 (and sample_prescan, which it
## depends on) now run through test_data_driven_runsteps()/
## run_data_driven_runsteps() inside the main per-sample loop below, in the
## same way as every other migrated runstep -- no special-casing left here.

log_message("NOTICE: Loading sample data");
load_optional_illumina_files();

# Resolve parallel scheduler resource ceilings (auto-detect or config).
# Must run after config is loaded; $S_max_threads/$S_max_ram_gb are
# read-only after this point.
log_message("NOTICE: Resolving resource limits (threads/RAM)");
resolve_parallel_resource_limits();

###################################################################################################
## Runstep run order -- the SINGLE place where runsteps are listed.
##
## Every scheduler entry point (test phase, sequential loop, parallel
## scheduler, batch phase) and the GRAPH dump read from these three lists.
## Adding a new runstep = define its block in the runstep library + add its
## name here, once. (Previously the same per-sample list was duplicated in
## four places and had to be kept in sync by hand.)
##
## @PER_SAMPLE_RUNSTEPS -- per-sample runsteps. In sequential mode they run
##   in exactly this order; in parallel mode the order only matters as a
##   tiebreak, the real ordering comes from requires/produces. Place a new
##   step AFTER the steps it depends on so both modes agree.
## @BATCH_RUNSTEPS_PRE  -- cross-sample steps run after the per-sample phase.
## @BATCH_RUNSTEPS_POST -- cross-sample steps run last (aggregation/reporting).
our @PER_SAMPLE_RUNSTEPS = qw(
    md5_rawdata sample_prescan fastqc_rawdata
    fastp_rawdata check_for_no_trimming find_species_kraken2 downsampling_bbmap
    check_for_no_downsampling fastq_stats_trimmed fastp_trimmed_data
    fastqc_trimmed_data check_for_fasta mash_screen Kraken2
    spades skesa shovill_spades shovill_skesa select_main_assembly
    quast remap mlst fastmlst select_main_mlst
    amrfinderplus resfinder_fastq resfinder_fasta select_main_amr_results
    sistr seqsero2 ectyper lissero select_main_serotype
    virulencefinder plasmidfinder
    bakta checkm_per_sample chewbbaca_per_sample
);
our @BATCH_RUNSTEPS_PRE  = qw( sort_assemblies checkm chewbbaca chewbbaca_regenerate_per_batch );
our @BATCH_RUNSTEPS_POST = qw( multiqc cleanup );

# QC screen: only the quick raw-read steps; genome size (config, list, or
# jellyfish when needed) and the QC evaluation happen at the end.
our @QCSCREEN_RUNSTEPS = qw( sample_prescan fastp_rawdata check_for_no_trimming find_species_kraken2 );
if ($S_QCSCREEN) {
    my %keep = map { $_ => 1 } @QCSCREEN_RUNSTEPS;
    @PER_SAMPLE_RUNSTEPS = grep { $keep{$_} } @PER_SAMPLE_RUNSTEPS;
    @BATCH_RUNSTEPS_PRE  = ();
    @BATCH_RUNSTEPS_POST = qw( cleanup );   # the trimmed reads are large here too
}

# Sanity check: every listed name must have a runstep definition. A typo
# here would otherwise make a runstep silently never run.
{
    my @unknown = grep { !exists $runstep{$_} }
                  (@PER_SAMPLE_RUNSTEPS, @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST);
    if (@unknown) {
        graceful_die("Run order lists name runstep(s) with no definition in the runstep library: " . join(", ", @unknown));
    }

    # The reverse is informational only: a defined runstep that is in no
    # list never runs (deliberate for deprecated steps, a bug otherwise).
    my %listed = map { $_ => 1 } (@PER_SAMPLE_RUNSTEPS, @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST);
    my @unlisted = sort grep { !$listed{$_} } keys %runstep;
    log_message("INFO: Runsteps defined but not in any run order list (will not run): " . join(", ", @unlisted)) if @unlisted;
}

###################################################################################################
## Startup graph validation (§9.1) -- structural checks over the runstep
## dependency declarations, run once here, after samples are known
## (needed for the per-sample applicable-producer check) but before any
## real testing or processing begins. Aborts the whole run on any problem
## found, rather than letting a misconfigured/newly-added runstep deadlock
## silently partway through a long run.
# Resuming an output directory that was started with the other chewBBACA
# mode: keep that mode, otherwise every sample would be called again
# (per_sample is the default since v1; older runs used per_species_batch).
# An explicit chewbbaca_mode on the command line always wins.
if ( is_resume_mode() && ( $rundata{config}{overrides} // "" ) !~ /chewbbaca_mode=/ ) {
    my $mode  = lc( $R_cfg->{general}{chewbbaca_mode} // "per_sample" );
    my $clus  = eval { fill_placeholders("__DIR-CLUSTERING__/chewbbaca") } // "";
    my @batch = $clus ne "" ? glob("$clus/*/*/per_batch/rawdata/chewbbaca_results") : ();
    my @per   = $clus ne "" ? glob("$clus/*/*/per_sample/rawdata/*") : ();
    if ( $mode eq "per_sample" && @batch && !@per ) {
        $R_cfg->{general}{chewbbaca_mode} = "per_species_batch";
        log_message("NOTICE: Resume: this output directory was analysed with chewbbaca_mode=per_species_batch -- keeping that mode (set chewbbaca_mode=per_sample to change)");
    } elsif ( $mode eq "per_species_batch" && @per && !@batch ) {
        $R_cfg->{general}{chewbbaca_mode} = "per_sample";
        log_message("NOTICE: Resume: this output directory was analysed with chewbbaca_mode=per_sample -- keeping that mode (set chewbbaca_mode=per_species_batch to change)");
    }
}

{
    my $t0 = time();
    log_message("INFO: Validating pipeline configuration");
    normalize_species_runsteps();   # species => [...] adds implicit requires species_determined
    validate_runstep_graph();       # logs the time of each check
    prepare_rerun();   # rerun=<steps>: remove their results + dependents' (resume mode only)
    plan_read_regeneration();   # after a cleanup: re-create reads only where still needed
    log_message(sprintf("NOTICE: Validating pipeline configuration: done (%.1f s)", time() - $t0));
}

# Dump the complete runstep dependency graph to the log immediately after
# validation. This makes it trivial to diagnose requires-configuration bugs
# after the fact: open the log, search for "GRAPH:", and read off what each
# runstep actually had as its contract at runtime. Catches Perl silent-
# overwrite bugs (duplicate keys) even if validate_no_duplicate_hash_keys
# misses a case, and is the ground truth for any parallel scheduling issue.
{
    my @runstep_names_for_dump = (@PER_SAMPLE_RUNSTEPS, @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST);
    log_message("INFO: GRAPH: Runstep dependency graph (requires/produces) at startup:");
    for my $name (@runstep_names_for_dump) {
        my $def = $runstep{$name};
        next unless defined $def;
        my $req  = join(", ", @{ $def->{requires} // [] }) || "(none)";
        my $prod = join(", ", @{ $def->{produces}  // [] }) || "(none)";
        my $grp  = $def->{group} // "";
        my $grp_str = $grp ? " group=$grp" : "";
        my $sp_str  = $def->{species} ? " species=[" . join(", ", @{ $def->{species} }) . "]" : "";
        log_message("INFO: GRAPH:   $name: requires=[$req] produces=[$prod]$grp_str$sp_str");
    }
    log_message("INFO: GRAPH: End of runstep dependency graph");
}


###################################################################################################
###################################################################################################
###################################################################################################
## run commands -runloop-


#######################
## Run order: @PER_SAMPLE_RUNSTEPS (per sample) and @BATCH_RUNSTEPS_PRE /
## @BATCH_RUNSTEPS_POST (once per run), see "Runstep run order". Every step
## follows the requires/produces/applies_if contract and is run by
## run_data_driven_runsteps / run_parallel_runsteps /
## run_data_driven_batch_runsteps below.

### LOOPED COMMANDS
my $command = "";
my $number_samples = @$R_samples;

##----------------------------------------------------------------------------------------------------
##-------------------------- TEST commands ------------------------------------------------------------
##----------------------------------------------------------------------------------------------------

if($R_cfg_general->{test_software} != 0) { 
    log_message("NOTICE: testing requirements");

    for(my $i=0;$i< @$R_samples; $i++ ){

       my $sample_name = $R_samples->[$i]{name};
       my $sample_type = $R_samples->[$i]{type};
       my $counter = $i+1;
       
      test_data_driven_runsteps( \@PER_SAMPLE_RUNSTEPS, $i );

    } ## END SAMPLE LOOP

}

 #########################
 ## non-sample-looped commands

if($R_cfg_general->{test_software} != 0) { 

     test_data_driven_batch_runsteps( \@BATCH_RUNSTEPS_PRE );
     test_data_driven_batch_runsteps( \@BATCH_RUNSTEPS_POST );

}

##----------------------------------------------------------------------------------------------------
##-------------------------- RUN commands ------------------------------------------------------------
##----------------------------------------------------------------------------------------------------

# The runstep list is defined once, in @PER_SAMPLE_RUNSTEPS (see "Runstep run order").
my @_per_sample_runsteps = @PER_SAMPLE_RUNSTEPS;

merge_lane_files();   # same sample on several lanes -> one file per read (B28)

write_run_status("running", undef);   # now with the sample list
emit_event( type => 'run_started', run_number => $S_RUN_NUMBER, mode => ( $S_QCSCREEN ? "qcscreen" : $S_RUN_MODE ),
            parallel => ( lc( $R_cfg->{general}{parallel_mode} // 'off' ) eq 'on' ? 1 : 0 ),
            samples  => [ map { { name => $_->{name}, index => $_->{index} // undef, type => $_->{type} } } @$R_samples ],
            runsteps => [ @_per_sample_runsteps ], batch_runsteps => [ @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST ] );

if ( lc($R_cfg->{general}{parallel_mode} // 'off') eq 'on' ) {

    # ── PARALLEL MODE ──────────────────────────────────────────────────
    # Pre-compute which (sample, runstep) pairs apply so the progress
    # bar has an accurate denominator from the start.
    my $applicability = precompute_runstep_applicability(\@_per_sample_runsteps);
    log_message("NOTICE: Parallel mode: $applicability->{total} applicable (sample, runstep) pairs across " . scalar(@$R_samples) . " samples");

    run_parallel_runsteps(\@_per_sample_runsteps, $applicability);

} else {

    # ── SEQUENTIAL MODE (default) ──────────────────────────────────────
    # Identical to the original per-sample loop. Output, timing, and
    # behaviour are completely unchanged when parallel_mode = "off".
    for(my $i=0;$i< @$R_samples; $i++ ){

   my $sample_name = $R_samples->[$i]{name};
   my $sample_type = $R_samples->[$i]{type};
   my $counter = $i+1;
   
    log_message("NOTICE: ============== Sample $sample_name [$sample_type] ($counter/$number_samples) ============== ", "magenta");
  
    run_data_driven_runsteps( \@PER_SAMPLE_RUNSTEPS, $i );


write_json_file($R_samples->[$i], fill_placeholders("__DIR-LOG__/__BASE__-results.json",$i) );
} ## END SAMPLE LOOP

} ## END PARALLEL/SEQUENTIAL BRANCH


 #########################
 ## non-sample-looped commands
 
run_data_driven_batch_runsteps( \@BATCH_RUNSTEPS_PRE );


run_data_driven_batch_runsteps( \@BATCH_RUNSTEPS_POST );



#######################
# evaluate results towards qc-tresholds
###
for(my $samplenr=0;$samplenr< @$R_samples; $samplenr++ ){

   my $sample_name = $R_samples->[$samplenr]{name};
   my $sample_type = $R_samples->[$samplenr]{type};
   my $counter = $samplenr+1;

   # load_expectations() runs here, once, late -- by now species (if
   # determinable at all) is fully known, giving species-specific
   # thresholds rather than generic ones. Mirrors refresh_summary_derived_data()'s
   # own pattern exactly (used by summarize/summarise). See the runstep
   # machinery design doc, §15 -- this used to run early, inside
   # find_species_kraken2's postprocessing, before species-ID had even
   # finished.
   load_expectations($samplenr);

   refresh_raw_coverage($samplenr);   # now with the species' genome size
   qcscreen_prepare_sample($samplenr) if $S_QCSCREEN;

   evaluate_sample_qc($samplenr);

}
#############

my $rundata_file  = getdir("out,data") . "/rundata.json";

save_hash_as_json($rundata_file, \%rundata);

###################################################################################################
###################################################################################################
###################################################################################################
## call reporting subs and close
  

# QC screen: its own compact report (written after the exit code is known,
# below); the full report needs results the screen does not produce.
unless ($S_QCSCREEN) {
    summarize_results();

    # Detected species whose species-specific tools are disabled in the config.
    report_species_tools_not_run( \@PER_SAMPLE_RUNSTEPS );
}

# Exit code decision -- must run BEFORE close_logfile() so the two
# log_message calls below actually reach the logfile.
# Exit codes (A15) -- describe how the RUN went, not the samples' QC:
#   0 finished OK   1 error (graceful_die)   2 nothing to analyse
#   3 finished, at least one sample abandoned
#   4 interrupted (Ctrl+C / kill)   5 finished, at least one step failed or
#   hit its time limit   6 stopped with the control channel's terminate
# When several apply, the first in this order wins: 4, 6, 1, 3, 5, 0.
my $_exit_code = 0;
if ( grep { @{ $_->{failed_steps} // [] } } @$R_samples ) {
    my $n = grep { @{ $_->{failed_steps} // [] } } @$R_samples;
    log_message("INFO: $n sample(s) had a step that failed or hit its time limit -- exit code 5");
    $_exit_code = 5;
}
{
    my @abandoned = grep { $_->{fatal_error} } @$R_samples;
    if (@abandoned) {
        my $count = scalar @abandoned;
        my @names = map { $_->{name} // "?" } @abandoned;
        log_message("INFO: $count sample(s) were abandoned during analysis: " . join(", ", @names));
        log_message("INFO: Exiting with code 3 (partial success -- see abandoned samples)");
        $_exit_code = 3;
    }
}

write_qcscreen_outputs($_exit_code) if $S_QCSCREEN;

print_run_summary($_exit_code);

close_logfile();

exit $_exit_code;



###################################################################################################
## end of execution
###################################################################################################
##
##
##
##



###################################################################################################
###################################################################################################
## sub library
###################################################################################################

sub load_optional_illumina_files {

    $rundata{illuminafiles} ||= {};

    ######## RunInfo.xml #################
    my $runinfo_file = find_optional_file("RunInfo.xml");

    if (defined $runinfo_file && -f $runinfo_file) {
        my $runinfo_ref = parse_runinfo_xml($runinfo_file);

        if ($runinfo_ref && ref($runinfo_ref) eq 'HASH' && %$runinfo_ref) {
            $rundata{illuminafiles}{runinfo} = $runinfo_ref;
            log_message("NOTICE: Loaded optional Illumina RunInfo.xml from [$runinfo_file]");

            log_message("NOTICE: Instrument: "   . ($rundata{illuminafiles}{runinfo}{run}{instrument} // "n/a"), "green");
            log_message("NOTICE: Date: "         . ($rundata{illuminafiles}{runinfo}{run}{date} // "n/a"), "green");
            log_message("NOTICE: Flowcell: "     . ($rundata{illuminafiles}{runinfo}{run}{flowcell} // "n/a"), "green");
            log_message("NOTICE: Run number: "   . ($rundata{illuminafiles}{runinfo}{run}{number} // "n/a"), "green");
            log_message("NOTICE: Run id: "       . ($rundata{illuminafiles}{runinfo}{run}{id} // "n/a"), "green");
            log_message("NOTICE: Cycles: "       . ($rundata{illuminafiles}{runinfo}{run}{reads}[0]{num_cycles} // "n/a"), "green");
            log_message("NOTICE: Number lanes: " . ($rundata{illuminafiles}{runinfo}{run}{flowcell_layout}{lane_count} // "n/a"), "green");
            log_message("NOTICE: Number tiles: " . ($rundata{illuminafiles}{runinfo}{run}{flowcell_layout}{tile_count} // "n/a"), "green");
 
        }
        else {
            log_message("WARNING: RunInfo.xml found but could not be parsed [$runinfo_file]");
        }
    }
    #####################################


    ######## RunParameters.xml ###########
    my $runparameters_file = find_optional_file("RunParameters.xml");

    if (defined $runparameters_file && -f $runparameters_file) {
        log_message("NOTICE: Loading optional Illumina RunParameters.xml from [$runparameters_file]");
        my $runparameters_ref = parse_runparameters_xml($runparameters_file);

        if ($runparameters_ref && ref($runparameters_ref) eq 'HASH' && %$runparameters_ref) {
            $rundata{illuminafiles}{runparameters} = $runparameters_ref;
            log_message("INFO: Loaded optional Illumina RunParameters.xml from [$runparameters_file]");
            

            log_message("NOTICE: Mashine: "         . ($rundata{illuminafiles}{runparameters}{scanner_id} // "n/a"), "green");
            log_message("NOTICE: Run ID: "         . ($rundata{illuminafiles}{runparameters}{run_id} // "n/a"), "green");
            log_message("NOTICE: Experiment name: "         . ($rundata{illuminafiles}{runparameters}{experiment_name} // "n/a"), "green");
            log_message("NOTICE: User name: "         . ($rundata{illuminafiles}{runparameters}{username} // "n/a"), "green");
            log_message("NOTICE: Run date: "   . ($rundata{illuminafiles}{runparameters}{run_start_date_iso} // "n/a"), "green");            
            log_message("NOTICE: Library kit: "   . ($rundata{illuminafiles}{runparameters}{library_prep_kit} // "n/a"), "green");
            log_message("NOTICE: Index kit: "   . ($rundata{illuminafiles}{runparameters}{index_kit} // "n/a"), "green");     
            log_message("NOTICE: Chemistry: "   . ($rundata{illuminafiles}{runparameters}{chemistry} // "n/a"), "green");                               
            
        }
        else {
            log_message("WARNING: RunParameters.xml found but could not be parsed [$runparameters_file]");
        }
    }

     ######## SampleSheet.csv ##############
     my $samplesheet_file = find_optional_file("SampleSheet.csv");

     if (defined $samplesheet_file && -f $samplesheet_file) {
         log_message("NOTICE: Loading optional Illumina SampleSheet.csv from [$samplesheet_file]");
         my $samplesheet_ref = parse_samplesheet_csv($samplesheet_file);

         if ($samplesheet_ref && ref($samplesheet_ref) eq 'HASH' && %$samplesheet_ref) {
             $rundata{illuminafiles}{samplesheet} = $samplesheet_ref;
             integrate_samplesheet_into_rundata();
             log_message("INFO: Loaded optional Illumina SampleSheet.csv from [$samplesheet_file]");
             

             log_message("NOTICE: SampleSheet Experiment Name: " . ($rundata{illuminafiles}{samplesheet}{header}{"Experiment Name"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Date: " . ($rundata{illuminafiles}{samplesheet}{header}{"Date"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Chemistry: " . ($rundata{illuminafiles}{samplesheet}{header}{"Chemistry"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Reads: " . join(", ", @{ $rundata{illuminafiles}{samplesheet}{reads} || [] }), "green");
             log_message("NOTICE: SampleSheet samples: " . ($rundata{illuminafiles}{samplesheet}{summary}{n_samples} // "n/a"), "green");

             
         }
         else {
             log_message("WARNING: SampleSheet.csv found but could not be parsed [$samplesheet_file]");
         }
     }
     #######################################
     
     ######## InterOp #####################
     my $interop_dir = find_optional_dir("InterOp");

     if (defined $interop_dir && -d $interop_dir) {
         log_message("NOTICE: Loading optional Illumina InterOp metrics from [$interop_dir]");
         my $interop_ref = load_interop_metrics();

        if ($interop_ref && ref($interop_ref) eq 'HASH' && %$interop_ref) {
            $rundata{illuminafiles}{interop} = $interop_ref;
            map_interop_index_summary_to_samples();
            map_interop_run_summary_to_matched_samples();
            
            print_interop_summary_to_log();  

            log_message("INFO: Loaded optional Illumina InterOp metrics from [$interop_dir]");
        }
         else {
             log_message("WARNING: InterOp directory found but could not be parsed [$interop_dir]");
         }
     }
     ######################################


    return 1;
}


sub print_interop_summary_to_log {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my $R_summary = $R_interop->{summary} || {};
    my $R_index   = $R_interop->{index_summary} || {};



    ########################################
    # PF reads and totals (from index summary)

    my ($total_reads, $pf_reads, $pf_pct, $cv, $min, $max);

    my @lanes = sort { $a <=> $b } grep { /^\d+$/ } keys %{ $R_index->{lanes} || {} };
    if (@lanes) {
        my $lane = $lanes[0];
        my $R_lane = $R_index->{lanes}{$lane}{totals} || {};

        $total_reads = $R_lane->{total_reads};
        $pf_reads    = $R_lane->{pf_reads};
        $cv          = $R_lane->{cv};
        $min         = $R_lane->{min};
        $max         = $R_lane->{max};

        if (defined $pf_reads && defined $total_reads && $total_reads > 0) {
            $pf_pct = sprintf("%.1f", 100 * $pf_reads / $total_reads);
        }
    }

    log_message("NOTICE: Total reads: " . ($total_reads // "n/a"), "green");
    log_message("NOTICE: PF reads: " . ($pf_reads // "n/a"), "green");
    log_message("NOTICE: PF (%): " . (defined $pf_pct ? "$pf_pct %" : "n/a"), "green");

    ########################################
    # Yield and Q30 (from summary totals)

    my $R_totals = $R_summary->{totals} || {};

    my $total_yield      = $R_totals->{Total}{yield_gb};
    my $nonidx_yield     = $R_totals->{"Non-indexed"}{yield_gb};

    my $q30_total        = $R_totals->{Total}{pct_q30};
    my $q30_r1           = $R_totals->{"Read 1"}{pct_q30};
    my $q30_i1           = $R_totals->{"Read 2 (I)"}{pct_q30};
    my $q30_i2           = $R_totals->{"Read 3 (I)"}{pct_q30};
    my $q30_r2           = $R_totals->{"Read 4"}{pct_q30};

    log_message("NOTICE: Total yield: " . (defined $total_yield ? "$total_yield Gb" : "n/a"), "green");
    log_message("NOTICE: Non-indexed yield: " . (defined $nonidx_yield ? "$nonidx_yield Gb" : "n/a"), "green");

    log_message("NOTICE: Q30 total: " . (defined $q30_total ? "$q30_total %" : "n/a"), "green");
    log_message("NOTICE: Q30 R1: " . (defined $q30_r1 ? "$q30_r1 %" : "n/a"), "green");
    log_message("NOTICE: Q30 R2: " . (defined $q30_r2 ? "$q30_r2 %" : "n/a"), "green");
    log_message("NOTICE: Q30 index (I1/I2): " .
        (
            defined $q30_i1 || defined $q30_i2
            ? (($q30_i1 // "n/a") . " / " . ($q30_i2 // "n/a") . " %")
            : "n/a"
        ),
        "green"
    );

    ########################################
    # Cluster density + PF (from Read 1 summary)

    my $R_read1 = $R_summary->{read_sections}{"Read 1"}{by_surface}{"-"} || {};

    my $density   = $R_read1->{Density};
    my $clusterpf = $R_read1->{"Cluster PF"};

    log_message("NOTICE: Cluster density: " . ($density // "n/a") . " k/mm²", "green");
    log_message("NOTICE: Cluster PF: " . ($clusterpf // "n/a") . " %", "green");

    ########################################
    # Sample balance (index summary)

    log_message("NOTICE: Sample balance CV: " . (defined $cv ? $cv : "n/a"), "green");
    log_message("NOTICE: Sample balance min/max: " .
        (
            defined $min || defined $max
            ? (($min // "n/a") . " / " . ($max // "n/a") . " %")
            : "n/a"
        ),
        "green"
    );

    ########################################
    # Footer stats

    my $R_footer = $R_summary->{footer} || {};
    
    log_message("NOTICE: Tiles processed (Extracted/Called/Scored): " .
        join(" / ",
            $R_footer->{Extracted} // "n/a",
            $R_footer->{Called}    // "n/a",
            $R_footer->{Scored}    // "n/a"
        ),
        "green"
    );


    return 1;
}
sub integrate_samplesheet_into_rundata {

    my $R_ss = $rundata{illuminafiles}{samplesheet};

    if (!defined $R_ss || ref($R_ss) ne 'HASH') {
        log_message("WARNING: integrate_samplesheet_into_rundata called without parsed SampleSheet data");
        return 0;
    }

    my $R_indexes = build_samplesheet_indexes($R_ss);
    $rundata{illuminafiles}{samplesheet_indexes} = $R_indexes;

    my $matched   = 0;
    my $unmatched = 0;

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        my $sample_name = $R_samples->[$samplenr]{name} // '';

        if ($sample_name eq '') {
            log_message("WARNING: Sample [$samplenr] has no name, cannot match to SampleSheet");
            $unmatched++;
            next;
        }

        my $R_match =
               $R_indexes->{by_sample_id}{$sample_name}
            || $R_indexes->{by_sample_name}{$sample_name};

        if (!defined $R_match || ref($R_match) ne 'HASH') {
            log_message("NOTICE: No SampleSheet match found for sample [$sample_name]","yellow");
            $unmatched++;
            next;
        }

        # Attach full row as a copied hash
        $R_samples->[$samplenr]{samplesheet} = { %$R_match };

        # Store which key matched
        if (exists $R_indexes->{by_sample_id}{$sample_name}) {
            $R_samples->[$samplenr]{samplesheet_match_type} = 'Sample_ID';
        }
        elsif (exists $R_indexes->{by_sample_name}{$sample_name}) {
            $R_samples->[$samplenr]{samplesheet_match_type} = 'Sample_Name';
        }

        $R_samples->[$samplenr]{samplesheet_match_key} = $sample_name;



        $matched++;
        log_message("NOTICE: Matched sample [$sample_name] to SampleSheet ($R_samples->[$samplenr]{samplesheet_match_type})","green");
    }

    log_message("NOTICE: SampleSheet integration complete: matched [$matched], unmatched [$unmatched]","green");

    return 1;
}

sub build_samplesheet_indexes {
    my ($R_ss) = @_;

    my %by_sample_id;
    my %by_sample_name;

    return {
        by_sample_id   => \%by_sample_id,
        by_sample_name => \%by_sample_name,
    } if !defined $R_ss || ref($R_ss) ne 'HASH' || ref($R_ss->{data}) ne 'ARRAY';

    foreach my $R_row (@{ $R_ss->{data} }) {
        next if !defined $R_row || ref($R_row) ne 'HASH';

        my $sample_id   = $R_row->{Sample_ID}   // '';
        my $sample_name = $R_row->{Sample_Name} // '';

        $by_sample_id{$sample_id}     = $R_row if $sample_id ne '';
        $by_sample_name{$sample_name} = $R_row if $sample_name ne '';
    }

    return {
        by_sample_id   => \%by_sample_id,
        by_sample_name => \%by_sample_name,
    };
}

