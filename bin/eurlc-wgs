###################################################################################################
## Structure of $rundata{config}{defaults}
##
## Top-level sections:
##   general              - global pipeline settings (threads, verbosity, etc.)
##   <tool_name>           - one section per external tool (fastp, kraken2, spades, ...).
##                           Common fields: enabled, env, yml, package_name (or packages),
##                           install_version, program_name, arguments, db_path, db_test,
##                           install_db. Not every tool uses every field.
##                           Optional: version_check => "strict" requires that every
##                           package=version pin in the resolved YAML (find_env_yml) is
##                           actually installed, not just that the program runs -- auto-
##                           reinstalls (remove + recreate from YAML) on a mismatch. Default
##                           (unset) only checks that the program/test_command runs, any
##                           installed version is accepted. See ensure_tool_version().
##   chewbbaca_schemas     - named cgMLST/wgMLST schema definitions (path, species coverage,
##                           filter), referenced by name from species{}{schema} below.
##   species               - per-species settings, see below. A "default" entry provides
##                           fallback values for any species without its own section.
##
## Species-level keys (under species => { "Genus species" => { ... } }):
## Looked up via get_config_value_for_species($species, $key), which cascades:
## species-specific section -> species "default" section -> general section -> hardcoded
## fallback. Several different *kinds* of keys live side by side here, distinguished only
## by naming convention (not by structure), so it's worth knowing which is which:
##
##   - warning_<measure> / critical_<measure> / fail_<measure>
##       QC classification thresholds, evaluated AFTER a sample has finished processing
##       (see load_expectations()/evaluate_qc_measure()). Used for reporting/status only --
##       never abort processing. <measure> must be a key from %QC_MEASURE_DEF (see the
##       "how to add a measure" guide above that hash for the full list and how to add one).
##       Example: warning_assembly_size, fail_typing_cgmlst_call_rate.
##
##   - fatal_<name>
##       Runtime abort gates, checked DURING processing (not via the QC_MEASURE_DEF/
##       evaluate_qc_measure machinery above -- these are checked directly by name in a
##       handful of specific places in the code). If not met, the sample's processing is
##       stopped early to avoid wasting time on data that's already unusable. Intentionally
##       a short, separate list -- only add one of these if it should genuinely stop a run,
##       not just be flagged in the report. Example: fatal_mindepth, fatal_q30_mindepth.
##
##   - everything else (genomesize, gc, maxdepth, schema, filter, crossreactive_species, ...)
##       Plain operational/reference values consumed directly by specific code, not
##       evaluated as thresholds at all. E.g. genomesize is the expected genome size used to
##       compute the downsampling target; gc is the species' expected GC% (compared against
##       the observed value to compute qscore.*.gc_dev, currently informational only); schema
##       is the name of a chewbbaca_schemas{} entry to use for this species; filter selects
##       which allele filter to apply. These are NOT prefixed like the threshold keys above
##       -- deliberately kept as plain, short field names so they're quick to add/edit in a
##       species config block, at the cost of the category not being visible from the name
##       alone (so when in doubt, check this comment or grep the code for the key name).
##
$rundata{config}{defaults} = {
    general => {
        threads    => 4,
        overwrite  => "prompt",
        recursive  => 0,
        keeplevel  => 2,   # 1=minimal … 4=keep everything
        verbose    => 0,
        fastq      => 1,   # analyze FASTQ input -- see --fastq/--fasta in the manual
        fasta      => 1,   # analyze FASTA input -- both default on; giving exactly
                            # one of --fastq/--fasta on the command line restricts
                            # to just that type
        archive_results => 1,  # write hashed allele profiles to the local
                                # mirror and attempt a push to the central
                                # archive (archivedir); see the runstep
                                # machinery design doc, §12
        trimming => "fastp",
        main_assembly => "fewest_contigs500",
        species_determination => "kraken2",
        mlst_determination => "fastmlst",
        assume_yes => 0, 
        test_software => 1,  
        timeout => "15m",
        machine_aliases      => "M01137=SVA miSeq",
        # Max age (days) of a cached strict-version-check result before it's
        # re-verified against the live conda env, even if the YAML hasn't
        # changed. 0 disables the cache (always re-check). See
        # ensure_tool_version()/validation_cache_is_fresh().
        cache_max_age_days => 7,
    },
    md5 => {
            version_check => "loose",
            required => 1,
            enabled => 1,
            env       => "base",          
    },
    fastp => {
            version_check => "loose",
            required => 1,
            enabled   => 1,
            arguments => "--detect_adapter_for_pe --cut_right --trim_poly_g --length_required 36",
            env       => "eurlc-wgs-fastp",
            yml       => "core/eurlc-wgs-fastp.yml",
            package_name  => "fastp",
            install_version  => "0.24.0",              
    },
    fastqc => {
            version_check => "loose",
            required => 0,
            enabled => 0,
            run_on_rawdata => 1,
            arguments => "",
            env       => "eurlc-wgs-fastqc",
            yml       => "core/eurlc-wgs-fastqc.yml",
            package_name  => "fastqc",
            install_version  => "0.12.1", 
    },
    jellyfish => {
            version_check => "loose",
            enabled   => 1,
            required => 1,
            arguments => "",
            env       => "eurlc-wgs-jellyfish",
            yml       => "core/eurlc-wgs-jellyfish.yml",
            package_name  => "kmer-jellyfish",
    },
    interop => {
            version_check => "loose",
            enabled   => 1,
            required => 0,
        arguments    => "",
        env          => "eurlc-wgs-illumina-interop",
        yml          => "core/eurlc-wgs-illumina-interop.yml",
        package_name => "illumina-interop",
