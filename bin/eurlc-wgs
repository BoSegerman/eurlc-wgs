#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep select_main_amr_results
##
## Scaffolding for a future aggregating step over the 'amr' group
## (amrfinderplus/resfinder_fasta/resfinder_fastq) -- deliberately NOT
## reconciling results yet. Unlike assembly/MLST, AMR results from
## different tools aren't simply "pick the best one" or "pick by priority"
## -- different tools can report genuinely complementary findings, and
## getting the reconciliation logic right needs AMR domain expertise this
## isn't the place to improvise. For now: each tool's results are shown
## side by side (as today), and this step only confirms the group ran and
## leaves a placeholder trace, so the real aggregation logic has a known
## home to land in later without needing to revisit amrfinderplus/
## resfinder_fasta/resfinder_fastq's own contract fields again.

$runstep_name = "select_main_amr_results";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Checking AMR results (no aggregation yet)...",
      long_name  => "AMR result aggregation (placeholder)",
      output_dir => "__DIR-AMR__",

      # Always applies; relies on list position (runs after all three AMR
      # tools), the same way select_main_assembly/select_main_mlst do.
      requires   => ['any_amr_done', 'all_amr_settled'],
      produces   => [ 'amr_results_checked' ],
      applies_if => sub { return 1; },
};

$runstep{$runstep_name}{test} = sub { return 2; };  # no external tool

$runstep{$runstep_name}{preprocessing} = \&preprocess_select_main_amr_results;

sub preprocess_select_main_amr_results {
    my ($samplenr) = @_;

    my $sample_name = $R_samples->[$samplenr]{name};
    my @ran = grep { $R_samples->[$samplenr]{results}{$_} } group_members('amr');

    log_message("NOTICE: AMR results available for sample $sample_name from: " . (join(", ", @ran) || "none") . " -- no aggregation implemented yet, shown separately", "yellow");

    my $placeholder = fill_placeholders("__DIR-AMR__/__BASE__.amr_aggregation_not_implemented.txt", $samplenr, "select_main_amr_results");
    ensure_dir(getdir("out,results,amr"));

    return "echo 'AMR result aggregation not implemented in this version -- see each tool output separately' > '$placeholder'";
}

$runstep{$runstep_name}{result_parsing} = sub { return 1; };


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## STUB RUNSTEPS (v1 typing/characterisation tools, built out one at a time)
##
## (All v1 tools are built out now; these helpers are kept for the next new
## tool, e.g. STECFinder or ConFindr in v2.) A stub runstep has its full
## scheduling contract -- requires,
## produces, applies_if, species, group, resources -- but no tool behind
## them yet. Their preprocessing returns an internal SUB (write_stub_result)
## that just writes a small JSON marker in the step's output directory;
## result_parsing reads it back. That exercises the whole machinery
## (dispatch, fork, reap, data keys, group gates, select_main_serotype,
## both schedulers) without any external program, so they can be switched
## on in a test run before the tools are installed.
##
## Building one out = replace its cmd_template / test / preprocessing /
## result_parsing with the real thing (see e.g. amrfinderplus), add env/yml/
## version (and db_path) to its config section, and drop the "stub" wording.
## The contract part normally stays as it is.
##
## All are off by default (enabled => 0) until built out.

# Common preprocessing for a stub: reuse an existing marker (rerun), else
# hand an internal SUB to the scheduler.
sub stub_preprocessing {
    my ($samplenr, $runstep_name) = @_;
    my $sample_name = $R_samples->[$samplenr]{name};
    my $resultfile  = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    log_message("INFO: Preparing to run step $runstep_name (stub) on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        $runstep{$runstep_name}{result_parsing}->($samplenr);
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));
    return "SUB\twrite_stub_result\t$samplenr\t$runstep_name";
}

# Internal SUB (runs in the forked child -- writes files only).
sub write_stub_result {
    my ($samplenr, $runstep_name) = @_;
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    write_json_file({
        stub    => 1,
        runstep => $runstep_name,
        sample  => $R_samples->[$samplenr]{name},
        species => $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "n/a",
        note    => "placeholder result -- tool not implemented yet",
    }, $resultfile);
    return 0;
}

# Common result_parsing for a stub: marks the step as having produced a
# (placeholder) result, so data keys and group gates behave as they will
# for the real tool. $extra lets a step add fields the real tool will
# produce (e.g. serotype => "n/a") so select steps can be exercised.
sub stub_result_parsing {
    my ($samplenr, $runstep_name, %extra) = @_;
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    return 0 unless -f $resultfile;
    $R_samples->[$samplenr]{results}{$runstep_name} = { status => "stub", %extra };
    log_message("NOTICE: Sample $R_samples->[$samplenr]{name}: $runstep_name: stub result (tool not implemented yet)", "yellow");
    return 1;
}

sub stub_test {
    my ($runstep_name) = @_;
    log_message("NOTICE: $runstep_name: stub -- no tool to test yet");
    return 2;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## Shared helpers for typing tools (ECTyper, LisSero, VirulenceFinder, PlasmidFinder)

# First data row of a tab-separated file with a header line, as a hashref
# keyed by lower-cased column name. Returns undef if missing or no data row.
sub read_tsv_first_row {
    my ($file) = @_;
    return undef unless -s $file;
    open(my $fh, '<', $file) or return undef;
    my $header = <$fh>;
    my $line;
    while (defined($line = <$fh>)) { last if $line =~ /\S/; }
    close $fh;
    return undef unless defined $header && defined $line;
    s/\r?\n\z// for $header, $line;
    my @h = split /\t/, $header;
    my @v = split /\t/, $line, -1;
    my %row;
    @row{ map { lc } @h } = map { $_ // "" } @v[0 .. $#h];
    return \%row;
}

# Hits from a CGE tool's JSON result (VirulenceFinder, PlasmidFinder).
# Works on both result formats in use:
#   - legacy (<= 2.x, or --legacy): {tool}{results}{<group>}{<db>}{<hit_id>} =
#       { virulence_gene|plasmid, identity, coverage, accession, contig_name,
#         positions_in_contig, protein_function|note }
#   - BeOne (3.x default): {seq_regions}{<id>} = { name, identity, coverage,
#       ref_acc, query_id, query_start_pos, query_end_pos, ref_database[] }
# by walking the structure and collecting every hash that has a gene name
# plus identity and coverage. Returns a list of flat hashrefs, de-duplicated.
sub parse_cge_hits {
    my ($jsonfile) = @_;
    return () unless -s $jsonfile;
    my $data = read_json_file($jsonfile) or return ();

    my (@hits, %seen);
    my $walk;
    $walk = sub {
        my ($node, $path) = @_;   # $path: keys leading to $node
        if (ref $node eq 'HASH') {
            # First plain string among the name fields. (In BeOne results
            # "gene" is a JSON boolean, so it must not win over "name".)
            my ($gene) = grep { defined && !ref && $_ ne "" }
                         @{$node}{qw(virulence_gene plasmid name gene)};
            if ( defined $gene && defined $node->{identity}
                 && ( defined $node->{coverage} || defined $node->{template_coverage} ) ) {
                my $refdb = $node->{ref_database};
                $refdb = $refdb->[0] if ref $refdb eq 'ARRAY';
                $refdb = $1 if defined $refdb && $refdb =~ /:([^:]+)$/;
                my $pos = $node->{positions_in_contig}
                       // ( defined $node->{query_start_pos} ? "$node->{query_start_pos}..$node->{query_end_pos}" : "" );
                my %h = (
                    gene      => $gene,
                    identity  => $node->{identity},
                    coverage  => $node->{coverage} // $node->{template_coverage},
                    accession => $node->{accession} // $node->{ref_acc} // "",
                    contig    => $node->{contig_name} // $node->{query_id} // "",
                    position  => $pos,
                    function  => $node->{protein_function} // $node->{function} // $node->{note} // "",
                    # legacy layout: ...{<db>}{<hit_id>} -> db is 2 levels up
                    database  => $refdb // ( @$path >= 2 ? $path->[-2] : "" ),
                );
                for (qw(identity coverage)) {
                    $h{$_} = sprintf("%.2f", $h{$_}) if $h{$_} =~ /^\d+\.\d{3,}$/;
                }
                my $key = join("|", @h{qw(gene contig position)});
                push @hits, \%h unless $seen{$key}++;
                return;
            }
            $walk->( $node->{$_}, [ @$path, $_ ] ) for sort keys %$node;
        }
        elsif (ref $node eq 'ARRAY') {
            $walk->( $_, $path ) for @$node;
        }
    };
    $walk->($data, []);
    undef $walk;

    # BeOne: gene functions live in the top-level "phenotypes" section.
    if ( ref $data eq 'HASH' && ref $data->{phenotypes} eq 'HASH' ) {
        for my $h (@hits) {
            next if $h->{function} ne "";
            my $ph = $data->{phenotypes}{ $h->{gene} } or next;
            my $f  = ref $ph eq 'HASH' ? ( $ph->{function} // "" ) : "";
            $h->{function} = $f unless $f =~ /^No function found/i;
        }
    }
    return sort { lc($a->{gene}) cmp lc($b->{gene}) } @hits;
}


