sub preprocess_resfinder_fastq {

    my ($samplenr) = @_;

    my $runstep_name = "resfinder_fastq";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};  
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   

    if(! $R_cfg->{resfinder}->{fastq} ) {
       return "";
    } 
    
    ########################################################################################
    log_message("NOTICE: Resfinder run-step on raw data is not implemented yet","green");
    return "";
    ## problems with the database (kma indexing?
    #######################################################################################
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # runstep specific replacements

    my $resfinder_species = match_species_or_genus($R_cfg->{resfinder}{available_species_resfinder}, $R_samples->[$samplenr]{species});
    _fill_placeholders__safe_replace(\$command, "__RESFINDER-SPECIES__", "'$resfinder_species'");
    
    my $pointfinder_species =  match_species_or_genus($R_cfg->{resfinder}{available_species_pointfinder}, $R_samples->[$samplenr]{species});
    
    if($pointfinder_species eq "Others"  ){
       _fill_placeholders__safe_replace(\$command, "__POINTDB__", "");
    }
    elsif($R_cfg->{resfinder}{run_pointfinder}//1){
       _fill_placeholders__safe_replace(\$command, "__POINTDB__", "--db_path_point $R_cfg->{resfinder}->{db_path}/pointfinder_db");
    }
    else{
      _fill_placeholders__safe_replace(\$command, "__POINTDB__", "");
    }

     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);          

    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_resfinder_fastq;

sub postprocess_resfinder_fastq {
    my ($samplenr) = @_;

    my $runstep_name = "resfinder_fastq";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

   my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
        
    my $result_ref = parse_resfinder($resultfile,$samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref; 
   my $hitcount = $result_ref->{hit_count};
   
   for(my $i=0;$i<$hitcount; $i++){
   log_message("NOTICE: Sample $sample_name: AMR-hit: $result_ref->{resfinder_hits}[$i]->{resistance_gene} ($result_ref->{resfinder_hits}[$i]->{phenotype}) [Identity: $result_ref->{resfinder_hits}[$i]->{identity}% Coverage: $result_ref->{resfinder_hits}[$i]->{coverage}%]", "green");
  }
    return 1; # success
    
}


# PARSER ----------------------------------

sub parse_resfinder {
    my ($resultfile, $samplenr) = @_;

    my %resfinder_data;     # final hash structure
    my @resfinder_hits;     # list of resistance hits (each entry = hashref)
    my $sample_name = $R_samples->[$samplenr]{name};

    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open ResFinder result file for sample $sample_name [$resultfile]");
        return {};
    }

    # Read header line
    my $header = <$fh>;
    unless ($header) {
        log_message("WARNING: empty ResFinder result file for sample $sample_name [$resultfile]");
        return {};
    }

    chomp $header;
    my @columns = split /\t/, $header;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;   # skip empty lines

        my @fields = split /\t/, $line;

        # Map columns to fields
        my %entry;
        @entry{@columns} = @fields;

        # Normalize keys (lowercase, underscores)
        for my $key (keys %entry) {
            my $normkey = lc($key);
            $normkey =~ s/[^a-z0-9]+/_/g;
            $entry{$normkey} = delete $entry{$key};
        }

        push @resfinder_hits, \%entry;
    }

    close $fh;

    # Attach summary info
    $resfinder_data{resfinder_hits} = \@resfinder_hits;
    $resfinder_data{hit_count}      = scalar @resfinder_hits;

    return \%resfinder_data;
}


