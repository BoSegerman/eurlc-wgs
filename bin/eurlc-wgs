    conda run -n $R_cfg->{chewbbaca}->{env} --no-capture-output chewBBACA.py AlleleCall 
       -i __INPUTDIR__ 
       -g __SCHEMA__ 
       -o __DIR-CLUSTERING__/chewbbaca/__SUBDIR__ 
       --cpu __THREADS__ 
       __FILTER__ 
       $R_cfg->{chewbbaca}->{"arguments"} 
       __HIDE-OUTPUT__
CMD


       

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_chewbbaca;

sub test_chewbbaca {

      return check_conda_tool("chewbbaca");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_chewbbaca;

sub preprocess_chewbbaca {

    my $runstep_name = "chewbbaca";

    my $command_template       = $runstep{$runstep_name}{cmd_template}{main};
    my $command_template_hash  = $runstep{$runstep_name}{cmd_template}{hash};
    my $resultfile_template    = $runstep{$runstep_name}{resultfile};
    my $outdir_template        = $runstep{$runstep_name}{output_dir};

    my $command = "";

    log_message("INFO: Preparing to run step $runstep_name on all samples");

    my $species_dir_count = $rundata{batches}{subdirs_count};

    # ------------------------------------------------------------
    # LOOP OVER SPECIES DIRECTORIES
    # ------------------------------------------------------------
    for my $j (0 .. $species_dir_count - 1) {

        my $species_dirname  = $rundata{batches}{subdirs}[$j];
        my $species  = $rundata{batches}{$species_dirname}{species};
        my $samples  = $rundata{batches}{$species_dirname}{count};

        log_message("INFO: Checking species directory [$species_dirname] ($species)");

        # Collect list of sample names in this species dir
        my @listof_samples;
        for my $jj (0 .. $samples - 1) {
            my $fasta_path = $rundata{batches}{$species_dirname}{fasta}[$jj];
            my $filename   = basename($fasta_path);
            (my $samplename = $filename) =~ s/\.fasta$//;
            push @listof_samples, $samplename;
        }

        # --------------------------------------------------------
        # LOOP OVER ALL SCHEMAS FROM CONFIG
        # --------------------------------------------------------
        foreach my $schema_name (keys %{ $R_cfg->{"chewbbaca_schemas"} }) {

            my $schema = $R_cfg->{"chewbbaca_schemas"}{$schema_name};
            my $schema_path = $schema->{path} // "";
            my $filter      = $schema->{filter} // "";
            my $species_raw = $schema->{species} // "";

            # Determine which species this schema applies to
            my @species_list = map { s/^\s+|\s+$//gr } split /,/, $species_raw;
            next unless grep { lc($_) eq lc($species) } @species_list;

            my $schema_dirname = basename($schema_path);
            my $filtercommand = ($filter && $filter ne "unfiltered")
                ? "--genes-list $filter"
                : "";
           
            $schema_path = fill_placeholders($schema_path);

            # ----------------------------------------------------
            # PREPARE COMMAND FOR THIS SCHEMA + SPECIES COMBINATION
            # ----------------------------------------------------
            my $command_part = $command_template;
#            $command_part .= "; $command_template_hash";

            $command_part =~ s/__SCHEMA__/$schema_path/g;
            $command_part =~ s/__FILTER__/$filtercommand/g;
            $command_part =~ s/__SUBDIR__/$species_dirname\/$schema_dirname/g;
            $command_part =~ s#__INPUTDIR__#__DIR-ASSEMBLIES__/by_species/$species_dirname#g;

            if(! -d $schema_path ) {
               log_message("WARNING: Chewbbaca schema path is not valid for schema $schema_name [$schema_path], skipping...");
               next;
            }

            $command_part = fill_placeholders($command_part, "", $runstep_name);

            # Determine output and result file paths
            my $outdir = $outdir_template;
            $outdir =~ s/__SUBDIR__/$species_dirname\/$schema_dirname/g;
            $outdir = fill_placeholders($outdir, "", $runstep_name);
            ensure_dir($outdir);

            my $resultfile = $resultfile_template;
            $resultfile =~ s/__SUBDIR__/$species_dirname\/$schema_dirname/g;
            $resultfile = fill_placeholders($resultfile, "", $runstep_name);

            # ----------------------------------------------------
            # CHECK IF RESULTS ALREADY EXIST
            # ----------------------------------------------------
            my $all_exists = 0;

            if (-f $resultfile) {
            
                my $result_ref = parse_chewbbaca(dirname($resultfile));




                if (defined $result_ref->{file_count} && $result_ref->{file_count} > 0) {
                    my %resultexists = map { $_->{file} => 1 } @{ $result_ref->{data} // [] };
                    my $missing = 0;

                    foreach my $sample_base (@listof_samples) {
                        if (!exists $resultexists{$sample_base}) {
                            $missing = 1;
                            last;
                        }
                    }

                    $all_exists = !$missing;
                }
            }

            # ----------------------------------------------------
            # ADD TO COMMAND IF RUN NEEDED
            # ----------------------------------------------------
            if (!$all_exists) {
                if ($command eq "") {
                    $command = $command_part;
                } else {
                    $command .= "; $command_part";
                }
                log_message("INFO: Queued chewbbaca for species [$species], schema [$schema_name]");
            } else {
                log_message("NOTICE: Results already exist for chewbbaca [$species / $schema_name], Skipping");
            }
        } # end schema loop
    } # end species loop

    # Finalize
    $command = fill_placeholders($command, "", $runstep_name);

    if ($command eq "") {
        log_message("NOTICE: All chewbbaca results already complete — skipping run step.");
        postprocess_chewbbaca();
    }

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_chewbbaca;

sub postprocess_chewbbaca {

    my $runstep_name = "chewbbaca";

    my $resultfile_template = $runstep{$runstep_name}{resultfile};
    my $outdir_template     = $runstep{$runstep_name}{output_dir};

    log_message("INFO: Post-processing chewbbaca results...");

    my $species_dir_count = $rundata{batches}{subdirs_count};

    # clear any old results
    $rundata{clustering}{results} = [];
    for my $sample (@$R_samples) {
        delete $sample->{main_results}{typing}{cgmlst_schemas};
        delete $sample->{main_results}{typing}{cgmlst_call_rate};
        delete $sample->{main_results}{typing}{cgmlst_call_rate_schema};
    }    
    # ------------------------------------------------------------
    # LOOP OVER SPECIES DIRECTORIES
    # ------------------------------------------------------------
    for my $j (0 .. $species_dir_count - 1) {

        my $species_dirname = $rundata{batches}{subdirs}[$j];
        my $species         = $rundata{batches}{$species_dirname}{species};

        log_message("INFO: Processing chewbbaca results for species directory [$species_dirname] ($species)");

        # Resolve base output directory for this species
        my $species_outdir = $outdir_template;
        $species_outdir =~ s/__SUBDIR__/$species_dirname/g;
        $species_outdir = fill_placeholders($species_outdir, "", $runstep_name);

        next unless -d $species_outdir;

        # --------------------------------------------------------
        # LOOP OVER SCHEMA DIRECTORIES THAT ACTUALLY EXIST
        # --------------------------------------------------------
        opendir(my $dh, $species_outdir) or do {
            log_message("WARNING: Could not open chewbbaca output directory [$species_outdir]");
            next;
        };
        my @schema_dirs = grep { -d "$species_outdir/$_" && !/^\./ } readdir($dh);
        closedir($dh);

        foreach my $schema_dirname (@schema_dirs) {

            my $schema_path = "$species_outdir/$schema_dirname";
            next unless -d $schema_path;

            log_message("INFO: Checking schema directory [$schema_dirname] under [$species_outdir]");

            # ----------------------------------------------------
            # LOCATE RESULT SUBDIRECTORY
            # ----------------------------------------------------
            my $found_resultpath = find_chewie_resultpath($schema_path);

            unless ($found_resultpath && -d $found_resultpath) {
                log_message("WARNING: No result subdirectory found for [$schema_dirname] ($found_resultpath)");
                next;
            }

            # If the folder is not named "results", rename it
            my $renamed_path = "$schema_path/results";      
            
            if ($found_resultpath ne $renamed_path) {
                if (-d $renamed_path) {
                    log_message("WARNING: 'results' folder already exists in [$schema_path], skipping rename.");
                } else {
                    log_message("INFO: Renaming chewbbaca output folder [$found_resultpath] -> [$renamed_path]");
                    rename($found_resultpath, $renamed_path)
                        or log_message("WARNING: Could not rename [$found_resultpath] to [$renamed_path]: $!");
                }
            }

           # log_message("NOTICE: Hashing alleles [$species_dirname] ");
            run_chewbbaca_hashing(
                result_dir        => $renamed_path,
                assembly_base_dir => fill_placeholders("__DIR-ASSEMBLIES__/by_species/$species_dirname", "", $runstep_name),
                species_dirname   => $species_dirname,
                scheme_dirname    => $schema_dirname,
            );

            my $collision_check = check_crc32_hash_collisions(
                crc32_file  => "$renamed_path/results_alleles_crc32.tsv",
                sha256_file => "$renamed_path/results_alleles_sha256.tsv",
                out_file    => "$renamed_path/results_alleles_crc32_collision_check.txt",
            );
            
            store_crc32_collision_check_in_samples(
                collision_check => $collision_check,
                species_dirname => $species_dirname,
                scheme          => $schema_dirname,
            );


            
            # ----------------------------------------------------
            # PARSE RESULT FILES
            # ----------------------------------------------------
            if (-d $renamed_path) {
                log_message("INFO: Parsing chewbbaca result files in [$renamed_path]");
                my $result_ref = parse_chewbbaca($renamed_path);


                if ($result_ref && ref $result_ref eq 'HASH') {
                    
                    ## results OK
                    
                    $rundata{batches}{$species_dirname}{chewbbaca}{$schema_dirname} = $result_ref;
                    
                    
                    log_message("NOTICE: Species: $species_dirname, Schema: $schema_dirname", "green");
                    log_message("NOTICE: ----------------------------------------------------------------------------------------------------", "green");
                    
                    for my $rec (@{ $result_ref->{data} || [] }) {

                        my $file           = $rec->{file}           // "NA";
                        my $samplename = $file;
                        my $infered          = $rec->{INF}           // "NA";                        
                        my $called_alleles = $rec->{called_alleles} // "NA";
                        my $niph_total     = $rec->{niph_total}     // "NA";
                        my $schema_size    = $rec->{schema_size}    // "NA";
                        my $call_rate      = $rec->{call_rate}      // "NA";
                        my $infered_pct  =  sprintf("%.1f",  safe_rel($infered,$called_alleles,0) );
                        my $fmt_callrate =  sprintf("%.1f", $call_rate );

                        log_message(
                            "NOTICE: $file: Called alleles=$called_alleles ($infered_pct% infered), NIPH* alleles=$niph_total, call rate=$fmt_callrate% [$called_alleles/$schema_size]",
                            "green"
                        );
  
                    
                    my $sample_idx = $rundata{sample_index}{$samplename};

                    if (defined $sample_idx) {


                        my $cgmlst_record = {
                            scheme       => $schema_dirname,
                            species_dir  => $species_dirname,
                            call_rate    => $rec->{call_rate} // "n/a",
                            paralogous   => $rec->{niph_total} // "n/a",
                            inferred     => $rec->{INF} // "n/a",
                            inferred_pct => $infered_pct // "n/a",
                            called       => $rec->{called_alleles} // "n/a",
                            schema_size  => $rec->{schema_size} // "n/a",

                            EXC          => $rec->{EXC} // "n/a",
                            INF          => $rec->{INF} // "n/a",
                            NIPH         => $rec->{NIPH} // "n/a",
                            NIPHEM       => $rec->{NIPHEM} // "n/a",
                            PLOT3        => $rec->{PLOT3} // "n/a",
                            PLOT5        => $rec->{PLOT5} // "n/a",
                            LOTSC        => $rec->{LOTSC} // "n/a",
                            ALM          => $rec->{ALM} // "n/a",
                            ASM          => $rec->{ASM} // "n/a",
                            PAMA         => $rec->{PAMA} // "n/a",
                            LNF          => $rec->{LNF} // "n/a",

                            invalid_CDSs    => $rec->{'Invalid CDSs'} // "n/a",
                            classified_CDSs => $rec->{'Classified_CDSs'} // "n/a",
                            total_CDSs      => $rec->{'Total_CDSs'} // "n/a",

                            method       => "ChewBBACA: $schema_dirname",
                        };

                        push @{ $R_samples->[$sample_idx]{results}{chewbbaca}{schemas} }, $cgmlst_record;

                        push @{ $R_samples->[$sample_idx]{main_results}{typing}{cgmlst_schemas} }, $cgmlst_record;
                 
                    my $new_call_rate = $rec->{call_rate};

                   if (defined $new_call_rate && $new_call_rate ne "NA" && $new_call_rate ne "n/a") {

                       my $R_typing = $R_samples->[$sample_idx]{main_results}{typing};

                       if (
                           !defined $R_typing->{cgmlst_call_rate}
                           || $R_typing->{cgmlst_call_rate} eq "n/a"
                           || $new_call_rate < $R_typing->{cgmlst_call_rate}
                       ) {
                           $R_typing->{cgmlst_call_rate} = $new_call_rate;
                           $R_typing->{cgmlst_call_rate_schema} = $schema_dirname;
                       }
                   }

                    } else {
                        log_message("WARNING: Could not find sample index for chewbbaca sample [$samplename]");
                    }                     
                   }
                    

                   my $outdir = getdir("out");
                   my $schema = $schema_dirname;
                    

                   my $matrix_ref = compute_chewbbaca_distance_matrix(
                       $result_ref,
                       report_distance    => 10,
                       report_pct_success => 0.85,
                       out_prefix         => $schema_path,
                   );



                  my $matrix_basename = $schema_dirname;

                  my $distance_tsv_all =
                      "$species_outdir/$matrix_basename.dist.tsv";

                  my $success_tsv_all =
                      "$species_outdir/$matrix_basename.success.tsv";

                   my $ok = register_clustering_result(
                       species_dirname => $species_dirname,
                       species         => $species,
                       schema          => $schema_dirname,
                       hashed_alleles_all => path_relative_to_outdir("$schema_path/results/results_alleles_crc32.tsv"),
                       distance_tsv_all  => path_relative_to_outdir($distance_tsv_all),
                       success_tsv_all   => path_relative_to_outdir($success_tsv_all),
                       crc32_collision_check => $collision_check,
                   );

            
                   

#                    #inspect closest pairs
#                    for my $pair (sort keys %{ $matrix_ref->{diff_allele_values} }) {
#                           my $diffs = $matrix_ref->{diff_allele_values}{$pair};
#                           next unless @$diffs;
#                          # print "Differences for $pair:\n";
#                           for my $d (@$diffs) {
#                              my ($gene, $v1, $v2) = ($d->{gene}, $d->{(keys %$d)[1]}, $d->{(keys %$d)[2]});
#                           #   printf "  %-20s : %s vs %s\n", $gene, $v1 // "-", $v2 // "-";
#                           }
#                    }
                    
                    
                    
                    
                } else {
                    log_message("WARNING: Failed to parse chewbbaca results for [$schema_dirname]");
                }
            } else {
                log_message("WARNING: Expected result folder [$renamed_path] missing after rename step.");
            }

        } # end schema dir loop
    } # end species dir loop

    log_message("INFO: chewbbaca post-processing completed.");
    return 1;
}

# PARSER---------------------------------

sub store_crc32_collision_check_in_samples {
    my (%args) = @_;

    my $R_check         = $args{collision_check};
    my $species_dirname = $args{species_dirname} // "n/a";
    my $scheme          = $args{scheme} // "n/a";

    return if !defined $R_check || ref($R_check) ne "HASH";

    # Get all samples belonging to this species batch
    my @sample_names;

    my $count = $rundata{batches}{$species_dirname}{count} // 0;

    for my $i (0 .. $count - 1) {
        my $fasta = $rundata{batches}{$species_dirname}{fasta}[$i] // next;
        my $name = basename($fasta);
        $name =~ s/\.(fa|fasta|fna)$//i;
        push @sample_names, $name;
    }

    # 1. Store summary for all samples in this species/scheme
    foreach my $sample_name (@sample_names) {

        my $sample_idx = $rundata{sample_index}{$sample_name};
        next if !defined $sample_idx;

        push @{ $R_samples->[$sample_idx]{results}{chewbbaca}{crc32_collision_checks} }, {
            species_dirname => $species_dirname,
            scheme          => $scheme,
            checked         => $R_check->{checked} // 0,
            ok              => $R_check->{ok} // 0,
            collision_count => $R_check->{collision_count} // 0,
            rows_checked    => $R_check->{rows_checked} // "n/a",
            report_file     => $R_check->{report_file} // "",
            error           => $R_check->{error} // "",
        };
    }

    # 2. Store detailed collision records only for affected samples
    my $R_collisions = $R_check->{collisions};
    return if ref($R_collisions) ne "ARRAY" || !@$R_collisions;

    foreach my $collision (@$R_collisions) {

        my $R_samples_in_collision = $collision->{samples};
        next if ref($R_samples_in_collision) ne "ARRAY";

        foreach my $sample_name (@$R_samples_in_collision) {

            my $sample_idx = $rundata{sample_index}{$sample_name};
            next if !defined $sample_idx;

            push @{ $R_samples->[$sample_idx]{results}{chewbbaca}{crc32_collisions} }, {
                species_dirname => $species_dirname,
                scheme          => $scheme,
                locus           => $collision->{locus} // "n/a",
                crc32           => $collision->{crc32} // "n/a",
                sha256s         => $collision->{sha256s} || [],
                samples         => $collision->{samples} || [],
            };
        }
    }
}

sub run_chewbbaca_hashing {
    my (%args) = @_;

    my $result_dir        = $args{result_dir};
    my $assembly_base_dir = $args{assembly_base_dir};
    my $species_dirname   = $args{species_dirname} // "";
    my $scheme_dirname    = $args{scheme_dirname}  // "";

    return 0 if !defined $result_dir || !-d $result_dir;
    return 0 if !defined $assembly_base_dir || !-d $assembly_base_dir;

    my $crc32_file = "$result_dir/results_alleles_crc32.tsv";

    if (-f $crc32_file) {
        log_message("NOTICE: ChewBBACA hashed allele table already exists [$crc32_file], skipping hash step");
        return 1;
    }

    my $script = fill_placeholders("__DIR-PROGRAM__/hash_results_alleles.py");

    my $cmd = qq{cd "$result_dir" && conda run -n eurlc-wgs "$script" "$assembly_base_dir" __HIDE-OUTPUT__};
    $cmd = fill_placeholders($cmd);

    my $msg = "Hashing ChewBBACA alleles";
    $msg .= " [$species_dirname]" if $species_dirname ne "";
    $msg .= " [$scheme_dirname]"  if $scheme_dirname ne "";

    execute_and_log($cmd, 1, $msg);

    if (-f $crc32_file) {
        log_message("INFO: ChewBBACA CRC32 allele table written [$crc32_file]", "green");
        return 1;
    }

    log_message("WARNING: ChewBBACA hash step did not produce [$crc32_file]");
    return 0;
}

sub parse_chewbbaca {
    my ($result_dir) = @_;

    my %chewbbaca_data;
    my @data;        # will hold one hash per FILE
    my %stats_by_file;
    my %alleles_by_file;
    my %contigs_by_file;
    my @allele_header;

    my $stats_file   = "$result_dir/results_statistics.tsv";
    my $alleles_file = "$result_dir/results_alleles.tsv";
    my $contigs_file = "$result_dir/results_contigsInfo.tsv";

    # --- Parse results_statistics.tsv ---
    if (-e $stats_file) {
        open my $fh, '<', $stats_file or do {
            log_message("WARNING: could not open $stats_file");
            return {};
        };

        my $header = <$fh>;
        chomp $header;
        my @cols = split /\t/, $header;

        while (my $line = <$fh>) {
            chomp $line;
            next if $line =~ /^\s*$/;
            my @f = split /\t/, $line;
            my %entry;
            @entry{@cols} = @f;
            my $file_id = $entry{'FILE'} // next;
            $stats_by_file{$file_id} = \%entry;
        }
        close $fh;

        # store the header for later reference
        $chewbbaca_data{header} = [ @cols ];
    } else {
        log_message("WARNING: Missing ChewBBACA statistics file [$stats_file]");
    }

    # --- Parse results_alleles.tsv ---
    if (-e $alleles_file) {
        open my $fh, '<', $alleles_file or do {
            log_message("WARNING: could not open $alleles_file");
            return {};
        };

        my $header = <$fh>;
        chomp $header;
        my @cols = split /\t/, $header;
        shift @cols; # remove FILE
        @allele_header = @cols;

        while (my $line = <$fh>) {
            chomp $line;
            next if $line =~ /^\s*$/;
            my @f = split /\t/, $line;
            my $file_id = shift @f;
            $alleles_by_file{$file_id} = \@f;
        }
        close $fh;
    } else {
        log_message("WARNING: Missing ChewBBACA alleles file [$alleles_file]");
    }

    # --- Parse results_contigsInfo.tsv ---
    if (-e $contigs_file) {
        open my $fh, '<', $contigs_file or do {
            log_message("WARNING: could not open $contigs_file");
            return {};
        };

        my $header = <$fh>;
        chomp $header;
        my @cols = split /\t/, $header;
        shift @cols; # remove FILE

        while (my $line = <$fh>) {
            chomp $line;
            next if $line =~ /^\s*$/;
            my @f = split /\t/, $line;
            my $file_id = shift @f;

            my (@contig, @from, @to, @strand);

            for my $v (@f) {
                if ($v =~ /^(.+?)&(\d+)-(\d+)&([+-]?\d)$/) {
                    push @contig, $1;
                    push @from, $2;
                    push @to, $3;
                    push @strand, ($4 == -1 ? '-' : '+');
                } else {
                    push @contig, '';
                    push @from, '';
                    push @to, '';
                    push @strand, '';
                }
            }

            $contigs_by_file{$file_id} = {
                source_contig => \@contig,
                source_from   => \@from,
                source_to     => \@to,
                source_strand => \@strand
            };
        }
        close $fh;
    } else {
        log_message("WARNING: Missing ChewBBACA contigsInfo file [$contigs_file]");
    }

    # --- Merge all by FILE ---
    my @all_files = sort keys %stats_by_file;
    $chewbbaca_data{file_count} = scalar @all_files;
    $chewbbaca_data{data} = [];

    for my $file_id (@all_files) {
        my %record = ( file => $file_id );

        # add stats fields directly
        if (my $s = $stats_by_file{$file_id}) {
            for my $k (keys %$s) {
                next if $k eq 'FILE';
                $record{$k} = $s->{$k};
            }
        }

        # add allele array
        $record{alleles} = $alleles_by_file{$file_id} // [];

        # add contig data arrays
        if (exists $contigs_by_file{$file_id}) {
            my $c = $contigs_by_file{$file_id};
            $record{source_contig} = $c->{source_contig};
            $record{source_from}   = $c->{source_from};
            $record{source_to}     = $c->{source_to};
            $record{source_strand} = $c->{source_strand};
        } else {
            $record{source_contig} = [];
            $record{source_from}   = [];
            $record{source_to}     = [];
            $record{source_strand} = [];
        }
        
        # Derived ChewBBACA summary values
        my $exc    = $record{EXC}    // 0;
        my $inf    = $record{INF}    // 0;
        my $niph   = $record{NIPH}   // 0;
        my $niphem = $record{NIPHEM} // 0;

        my $schema_size = scalar @allele_header;

        $record{called_alleles} = $exc + $inf;
        $record{niph_total}     = $niph + $niphem;
        $record{schema_size}    = $schema_size;

        $record{call_rate} = safe_rel( $record{called_alleles},$schema_size,"NA");
        
        my $idx = scalar @{ $chewbbaca_data{data} };
        

        push @{$chewbbaca_data{data}}, \%record;
        $chewbbaca_data{sample_index}{$file_id} = $idx;
    }

    # Add header of alleles as meta
    $chewbbaca_data{allele_header} = \@allele_header;

    return \%chewbbaca_data;
}


## example output
#{
#  file_count => 3,
#  header => [
#    "FILE", "EXC", "INF", "PLOT3", "PLOT5", "LOTSC", "NIPH",
