# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/__BASE__.kraken2.txt 
       --threads __THREADS__ 
       --db $R_cfg->{kraken2}->{db_path} 
       --paired '__R1TD__' '__R2TD__' 
       > __OUTDIR__/__BASE__.krakenout.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py 
       -r __OUTDIR__/__BASE__.kraken2.txt 
       -o __OUTDIR__/__BASE__.krona_input 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText 
       __OUTDIR__/__BASE__.krona_input 
       -o __OUTDIR__/__BASE__.krona_kraken2.html 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/__BASE__.kraken2.txt 
       -o __OUTDIR__/__BASE__.bracken 
       -r __READLEN__  
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken 
       -d $R_cfg->{bracken}->{db_path} 
       -i __OUTDIR__/__BASE__.kraken2.txt 
       -o __OUTDIR__/__BASE__.genus.bracken 
       -r __READLEN__  
       -l G
       __HIDE-OUTPUT__ 
     __NEWCOMMAND__    
     rm __OUTDIR__/__BASE__.krakenout.txt      
     __NEWCOMMAND__   
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py 
       -r __OUTDIR__/__BASE__.kraken2_bracken_species.txt 
       -o __OUTDIR__/__BASE__.bracken_species_krona_input 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText 
       __OUTDIR__/__BASE__.bracken_species_krona_input 
       -o __OUTDIR__/__BASE__.krona_bracken_species.html 
       __HIDE-OUTPUT__
        __NEWCOMMAND__      
CMD

