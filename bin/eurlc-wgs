            arguments => "--qc",
            # Which SISTR field becomes the serotype: "serovar" (SISTR's own
            # overall prediction -- default) or "serovar_cgmlst" (cgMLST-330
            # based; what the SVA Salmonella pipeline reports).
            serovar_field => "serovar",
            # SISTR qc_status values for which its serotype is used; for any
            # other status select_main_serotype falls back to SeqSero2.
            # "PASS" (default, as the validated SVA Salmonella pipeline: a
            # SISTR QC WARNING such as "only matched 76 cgMLST330 loci" for
            # S. Gallinarum gives a wrong serovar, SeqSero2 is right) or
            # "PASS,WARNING".
            use_if_qc => "PASS",
