## runstep spades

$runstep_name = "spades";

$runstep{$runstep_name} = {
      # Assemblies of larger genomes / long reads can take well over the
      # general timeout; this is only a safety net against a hung run.
      timeout    => "120m",
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 8 },  # typical bacterial isolate at ~100X; raise with [<tool>] parallel_ram_gb for large genomes/high depth

      message    => "Running Spades...",
      long_name  => "Spades",
      output_dir => "__DIR-ALTERNATIVE-ASSEMBLIES__/Spades",
      rerun_paths => [ "__DIR-ALTERNATIVE-ASSEMBLIES__/Spades/__BASE__" ],   # rerun=: also remove the work dir
      resultfile => "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.spades.fasta",
      resultfiles_status => "NA",

      # Runstep machinery design doc, §5/§6 -- one of four candidate
      # producers for the assembler group; select_main_assembly picks the
      # winner among whichever of these actually applied and succeeded.
      group      => 'assembler',
      requires   => [ 'trimmed_downsampled_fastq' ],
      produces   => [ 'spades_assembled' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return $R_cfg->{spades}{enabled} ? 1 : 0;
      },
};

# TEMPLATES---------------------------------


$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
   conda run -n $R_cfg->{spades}->{env} --no-capture-output spades.py 
       -1 '__R1TD__' 
       -2 '__R2TD__' 
       -t __THREADS__ 
       $R_cfg->{spades}->{arguments} 
       -o __OUTDIR__/__BASE__ > /dev/null 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/contigs.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.spades.fasta
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
   conda run -n $R_cfg->{spades}->{env} --no-capture-output spades.py 
       -s '__SETD__'  
       -t __THREADS__ 
       $R_cfg->{spades}->{arguments} 
       -o __OUTDIR__/__BASE__ > /dev/null 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/contigs.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.spades.fasta
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_spades;

sub test_spades {

   return check_conda_tool("spades");


}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_spades;

sub preprocess_spades {

    my ($samplenr) = @_;

    my $runstep_name = "spades";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
   
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     

   if($sample_type eq "FASTA"){
      return "";
   }
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");


    if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_spades($samplenr);
        return "";
    }  
    
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_spades;

sub postprocess_spades {
    my ($samplenr) = @_;

    my $runstep_name = "spades";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr,$runstep_name);  



    my $assemblystats = analyze_assembly_stats($resultfile);
    

    $R_samples->[$samplenr]{results}{$runstep_name} = $assemblystats;

    my $len        = $assemblystats->{total_length}               // "n/a";
    my $contigs    = $assemblystats->{nr_contigs}                // "n/a";
    my $contigs500 = $assemblystats->{nr_contigs_largerthan_500} // "n/a";
    my $n50        = $assemblystats->{n50}                       // "n/a";
    my $gc         = $assemblystats->{gc_content}                // "n/a";
    my $cov        = $assemblystats->{total_coverage}            // 0;
        
    log_message("NOTICE: Total length: $len", "green");
    log_message("NOTICE: Contigs: $contigs", "green");
    log_message("NOTICE: Contigs (500+): $contigs500", "green");
    log_message("NOTICE: N50: $n50", "green");    
    log_message("NOTICE: gc_content: $gc", "green");
    if(($assemblystats->{total_coverage} // 0) > 0){  log_message("NOTICE: Total coverage: $cov", "green"); }

    cleanup_assembler_workdir($samplenr, $runstep_name);
   
    return 1; # success
}



 
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runsteps shovill_spades / shovill_skesa
##
## Shovill wraps a "real" assembler (SPAdes, SKESA, ...) and adds its own
## read correction and contig polishing/filtering. Each inner assembler is
## its own runstep -- one runstep, one result -- generated by
## define_shovill_runstep() so the code exists once. Every variant is a
## normal member of the 'assembler' group: its own output file
## (__BASE__.<name>.fasta), its own quast/mlst results, and it competes in
## select_main_assembly like any other assembler.
##
## Config:
##   [shovill]          the tool: env, yml, version. enabled = master switch
##   [shovill_spades]   enabled, arguments (added to the shovill command line)
##   [shovill_skesa]    enabled, arguments
## A variant runs when BOTH shovill.enabled and <variant>.enabled are on.
## shovill.arguments (if any) applies to every variant.
##
## Adding a variant (e.g. megahit): add a [shovill_megahit] defaults
## section and one define_shovill_runstep() call below, then add the name
## to @PER_SAMPLE_RUNSTEPS.
##
## Shovill does not support single-end reads, so the variants simply do not
## apply to SE samples (the other enabled assemblers cover them).

sub define_shovill_runstep {
    my ($name, $inner) = @_;

    my $label = "Shovill ($inner)";

    $data_key{"${name}_assembled"} = {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{$name}{total_length} ? 1 : 0; },
    };

    $runstep{$name} = {
        # Resources for parallel scheduler (§ parallel_mode=on)
        resources  => { threads => $R_cfg->{general}{threads}, ram_gb => ($inner eq 'skesa' ? 4 : 8) },
        config_section => 'shovill',
        timeout    => "120m",

        message    => "Running $label...",
        long_name  => $label,
        output_dir => "__DIR-ALTERNATIVE-ASSEMBLIES__/" . ucfirst($name),
        rerun_paths => [ "__DIR-ALTERNATIVE-ASSEMBLIES__/" . ucfirst($name) . "/__BASE__" ],
        resultfile => "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$name.fasta",
        resultfiles_status => "NA",

        group      => 'assembler',
        requires   => [ 'trimmed_downsampled_fastq' ],
        produces   => [ "${name}_assembled" ],
        applies_if => sub {
            my ($i) = @_;
            return 0 unless $R_samples->[$i]{type} eq 'PE';
            return ( $R_cfg->{shovill}{enabled} && $R_cfg->{$name}{enabled} ) ? 1 : 0;
        },
    };

    my $args = join ' ', grep { defined && $_ ne '' }
                         ( $R_cfg->{shovill}{arguments}, $R_cfg->{$name}{arguments} );

    $runstep{$name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{shovill}->{env} --no-capture-output shovill
       --assembler $inner
       --R1 '__R1TD__'
       --R2 '__R2TD__'
       --cpus __THREADS__
       $args
       --force
       --outdir __OUTDIR__/__BASE__
       >> __DIR-LOG__/${name}_logs.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    cp __OUTDIR__/__BASE__/contigs.fa __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$name.fasta
CMD
    $runstep{$name}{cmd_template}{SE}    = "";   # shovill does not support single-end reads
    $runstep{$name}{cmd_template}{FASTA} = "";

    $runstep{$name}{test} = sub { return check_conda_tool("shovill"); };

    $runstep{$name}{preprocessing} = sub {
        my ($samplenr) = @_;
        my $sample_name = $R_samples->[$samplenr]{name};
        my $sample_type = $R_samples->[$samplenr]{type};
        return "" unless $sample_type eq 'PE';

        my $resultfile = fill_placeholders($runstep{$name}{resultfile}, $samplenr);
        log_message("INFO: Preparing to run step $name on sample $sample_name ");

        if (-f $resultfile) {
            log_message("NOTICE: Runstep: $runstep{$name}{long_name} Sample: $sample_name already exists. Skipping");
            $runstep{$name}{result_parsing}->($samplenr);
            return "";
        }

        my $command = fill_placeholders($runstep{$name}{cmd_template}{PE}, $samplenr, $name);
        ensure_dir(fill_placeholders($runstep{$name}{output_dir}, $samplenr));
        return $command;
    };

    $runstep{$name}{result_parsing} = sub {
        my ($samplenr) = @_;
        my $resultfile = fill_placeholders($runstep{$name}{resultfile}, $samplenr, $name);
        return 0 unless -s $resultfile;   # failed run: leave results empty (not "assembled")

        my $assemblystats = analyze_assembly_stats($resultfile);
        $R_samples->[$samplenr]{results}{$name} = $assemblystats;

        log_message("NOTICE: Total length: "   . ($assemblystats->{total_length}              // "n/a"), "green");
        log_message("NOTICE: Contigs: "        . ($assemblystats->{nr_contigs}                // "n/a"), "green");
        log_message("NOTICE: Contigs (500+): " . ($assemblystats->{nr_contigs_largerthan_500} // "n/a"), "green");
        log_message("NOTICE: N50: "            . ($assemblystats->{n50}                       // "n/a"), "green");
        log_message("NOTICE: gc_content: "     . ($assemblystats->{gc_content}                // "n/a"), "green");
        my $cov = $assemblystats->{total_coverage} // 0;
        log_message("NOTICE: Total coverage: $cov", "green") if $cov > 0;
        cleanup_assembler_workdir($samplenr, $name);
        return 1;
    };
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## cleanup_assembler_workdir($samplenr, $runstep_name)
##
## Removes an assembler's working folder content once the assembly has been
## copied out to its resultfile (alternative_assemblies/<base>.<asm>.fasta),
## which is all the rest of the pipeline reads. Kept:
##   - the assembler's own log files (version, command, warnings)
##   - the final graph (.gfa), gzipped / as is / not at all
##     (cleanup.assembly_graphs = gzip | keep | remove)
##   - SPAdes scaffolds.fasta, only when it differs from contigs.fasta
## Switched off with cleanup.assembler_workfiles=0.
##
## Called from the assemblers' result_parsing, so it also runs on --resume
## (and tidies folders from older runs); it is idempotent. A failed or
## timed-out assembly has no resultfile (moved aside) and is left untouched
## for troubleshooting. Only names inside <output_dir>/<base>/ are touched.
sub cleanup_assembler_workdir {
    my ($samplenr, $runstep_name) = @_;
    my $cfg = $R_cfg->{cleanup} // {};
    return 0 if is_disabled( $cfg->{assembler_workfiles} // 1 );

    my $def = $runstep{$runstep_name} or return 0;
    my $resultfile = fill_placeholders( $def->{resultfile} // "", $samplenr, $runstep_name );
    return 0 unless $resultfile ne "" && -s $resultfile;

    my $base = fill_placeholders( "__BASE__", $samplenr, $runstep_name );
    return 0 if !defined $base || $base eq "" || $base =~ m{/|^\.};
    my $workdir = fill_placeholders( ( $def->{output_dir} // "" ) . "/__BASE__", $samplenr, $runstep_name );
    return 0 unless -d $workdir && $workdir =~ m{/\Q$base\E$};

    # what each assembler leaves behind that is worth keeping
    my %spec = (
        spades         => { keep  => [qw(spades.log params.txt warnings.log)],
                            graph => [ 'assembly_graph_with_scaffolds.gfa' ] },
        skesa          => { keep  => [],
                            graph => [ "$base.gfa", "$base.csv" ] },   # both from gfa_connector
        # Shovill: the graph is named after the inner assembler
        # (spades.gfa; SKESA makes none). shovill.corrections lists the
        # Pilon corrections (often empty). Removed: contigs.fa (copied out)
        # and the unfiltered <inner>.fasta.
        shovill_spades => { keep  => [qw(shovill.log shovill.corrections)],
                            graph => [ 'spades.gfa', 'contigs.gfa' ] },
        shovill_skesa  => { keep  => [qw(shovill.log shovill.corrections)],
                            graph => [ 'skesa.gfa', 'contigs.gfa' ] },
    );
    my $s = $spec{$runstep_name} or return 0;

    my $mode = lc( $cfg->{assembly_graphs} // "gzip" );
    $mode = "keep"   if $mode =~ /^(0|no|off|false)$/;
    $mode = "gzip"   if $mode =~ /^(1|yes|on|true)$/;
    unless ( $mode =~ /^(gzip|keep|remove)$/ ) {
        log_message("WARNING: cleanup.assembly_graphs=[$mode] is not gzip, keep or remove -- using gzip");
        $mode = "gzip";
    }

    my %keep = map { $_ => 1 } @{ $s->{keep} };

    # SPAdes scaffolds.fasta: never when it is the same as contigs.fasta;
    # otherwise as cleanup.spades_scaffolds says (remove / gzip / keep).
    # Folders tidied by an earlier version may hold a plain or gzipped one.
    if ( $runstep_name eq 'spades' ) {
        my $smode = lc( $cfg->{spades_scaffolds} // "remove" );
        $smode = "remove" if $smode =~ /^(1|yes|on|true)$/;   # 1 = remove, as the other cleanup keys
        $smode = "keep"   if $smode =~ /^(0|no|off|false)$/;
        unless ( $smode =~ /^(remove|gzip|keep)$/ ) {
            log_message("WARNING: cleanup.spades_scaffolds=[$smode] is not remove, gzip or keep -- using remove");
            $smode = "remove";
        }
        my $sf = "$workdir/scaffolds.fasta";
        my $same = -f $sf && -f "$workdir/contigs.fasta"
                && File::Compare::compare( $sf, "$workdir/contigs.fasta" ) == 0;
        if ( -f $sf && !$same && $smode eq "keep" ) {
            $keep{'scaffolds.fasta'} = 1;
        }
        elsif ( -f $sf && !$same && $smode eq "gzip" ) {
            require IO::Compress::Gzip;
            if ( IO::Compress::Gzip::gzip( $sf => "$sf.gz.part", Minimal => 1 ) && rename( "$sf.gz.part", "$sf.gz" ) ) {
                unlink $sf;
            } else {
                unlink "$sf.gz.part";
                $keep{'scaffolds.fasta'} = 1;
            }
        }
        $keep{'scaffolds.fasta.gz'} = 1 if $smode ne "remove";
    }

    for my $g ( @{ $s->{graph} } ) {
        my $f = "$workdir/$g";
        if ( $mode eq "keep" ) {
            $keep{$g} = 1;
            $keep{"$g.gz"} = 1;              # gzipped by an earlier run: leave it
        }
        elsif ( $mode eq "gzip" ) {
            if ( -f $f ) {
                require IO::Compress::Gzip;
                if ( IO::Compress::Gzip::gzip( $f => "$f.gz.part", Minimal => 1 ) && rename( "$f.gz.part", "$f.gz" ) ) {
                    unlink $f;
                } else {
                    unlink "$f.gz.part";
                    log_message("WARNING: [$runstep_name] could not gzip [$f] -- kept uncompressed");
                    $keep{$g} = 1;
                }
            }
            $keep{"$g.gz"} = 1;
        }
        # remove: neither kept
    }

    my ( $n, $bytes ) = ( 0, 0 );
    opendir( my $dh, $workdir ) or return 0;
    my @entries = grep { $_ ne '.' && $_ ne '..' } readdir $dh;
    closedir $dh;
    for my $e (@entries) {
        next if $keep{$e};
        my $p = "$workdir/$e";
        if ( -d $p && !-l $p ) {
            remove_tree( $p, { result => \my $gone } );
            $n += scalar @{ $gone // [] };
        } else {
            $bytes += ( -s $p ) // 0;
            $n++ if unlink $p;
        }
    }
    log_message("INFO: [$runstep_name] " . $R_samples->[$samplenr]{name}
              . ": removed $n working file(s)/folder(s) from $workdir (cleanup.assembler_workfiles)") if $n;
    return 1;
}


define_shovill_runstep('shovill_spades', 'spades');
define_shovill_runstep('shovill_skesa',  'skesa');

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep skesa

$runstep_name = "skesa";

$runstep{$runstep_name} = {
      # Assemblies of larger genomes / long reads can take well over the
      # general timeout; this is only a safety net against a hung run.
      timeout    => "120m",
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 4 },  # typical bacterial isolate at ~100X; raise with [<tool>] parallel_ram_gb for large genomes/high depth

      message    => "Running Skesa...",
      long_name  => "Skesa",
      output_dir => "__DIR-ALTERNATIVE-ASSEMBLIES__/Skesa",
      rerun_paths => [ "__DIR-ALTERNATIVE-ASSEMBLIES__/Skesa/__BASE__" ],   # rerun=: also remove the work dir
      resultfile => "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.skesa.fasta",
      resultfiles_status => "NA",

      group      => 'assembler',
      requires   => [ 'trimmed_downsampled_fastq' ],
      produces   => [ 'skesa_assembled' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return $R_cfg->{skesa}{enabled} ? 1 : 0;
      },
};

# TEMPLATES---------------------------------


$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    mkdir -p __OUTDIR__/__BASE__
    __NEWCOMMAND__
    conda run -n $R_cfg->{skesa}->{env} --no-capture-output skesa 
       --reads __R1TD__,__R2TD__ 
       --cores __THREADS__ 
       $R_cfg->{skesa}->{arguments} 
       > __OUTDIR__/__BASE__/__BASE__.fasta 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{skesa}->{env} --no-capture-output gfa_connector 
       --reads __R1TD__,__R2TD__ 
       --contigs __OUTDIR__/__BASE__/__BASE__.fasta 
       --gfa __OUTDIR__/__BASE__/__BASE__.gfa 
       --csv __OUTDIR__/__BASE__/__BASE__.csv 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/__BASE__.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.skesa.fasta
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    mkdir -p __OUTDIR__/__BASE__
    __NEWCOMMAND__
    conda run -n $R_cfg->{skesa}->{env} --no-capture-output skesa 
       --reads __SETD__ 
       --cores __THREADS__ 
       $R_cfg->{skesa}->{arguments} 
       > __OUTDIR__/__BASE__/__BASE__.fasta 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{skesa}->{env} --no-capture-output gfa_connector 
       --reads __SETD__ 
       --contigs __OUTDIR__/__BASE__/__BASE__.fasta 
       --gfa __OUTDIR__/__BASE__/__BASE__.gfa 
       --csv __OUTDIR__/__BASE__/__BASE__.csv 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/__BASE__.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.skesa.fasta
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_skesa;

sub test_skesa {

   return check_conda_tool("skesa");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_skesa;

sub preprocess_skesa {

    my ($samplenr) = @_;

    my $runstep_name = "skesa";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};  
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);    

    # No graph wanted (cleanup.assembly_graphs=remove): skip gfa_connector,
    # which only makes the graph and costs another pass over the reads.
    if ( defined $command && lc( $R_cfg->{cleanup}{assembly_graphs} // "gzip" ) eq "remove"
         && !is_disabled( $R_cfg->{cleanup}{assembler_workfiles} // 1 ) ) {
        $command =~ s/conda run -n \S+ --no-capture-output gfa_connector .*?__HIDE-OUTPUT__\s*;\s*//;
    }

    if($sample_type eq "FASTA"){
      return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

   if($R_cfg->{general}{main_assembly} eq "skesa"){
      if(-f $resultfile &&  -f fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta",$samplenr) ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_skesa($samplenr);
        return "";
      }  
    }else{
      if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_skesa($samplenr);
        return "";
      }  
    }
    
 
    

          
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_skesa;

sub postprocess_skesa {
    my ($samplenr) = @_;

    my $runstep_name = "skesa";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr,$runstep_name);  



    my $assemblystats = analyze_assembly_stats($resultfile);
    


    $R_samples->[$samplenr]{results}{$runstep_name} = $assemblystats;
    
    my $len        = $assemblystats->{total_length}               // "n/a";
    my $contigs    = $assemblystats->{nr_contigs}                // "n/a";
    my $contigs500 = $assemblystats->{nr_contigs_largerthan_500} // "n/a";
    my $n50        = $assemblystats->{n50}                       // "n/a";
    my $gc         = $assemblystats->{gc_content}                // "n/a";
    my $cov        = $assemblystats->{total_coverage}            // 0;
        
    log_message("NOTICE: Total length: $len", "green");
    log_message("NOTICE: Contigs: $contigs", "green");
    log_message("NOTICE: Contigs (500+): $contigs500", "green");
    log_message("NOTICE: N50: $n50", "green");    
    log_message("NOTICE: gc_content: $gc", "green");
    if(($assemblystats->{total_coverage} // 0) > 0){  log_message("NOTICE: Total coverage: $cov", "green"); }
    
    cleanup_assembler_workdir($samplenr, "skesa");
    return 1; # success
}



#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep select_main_assembly

$runstep_name = "select_main_assembly";

$runstep{$runstep_name} = {
      # any_assembler_done: there is something to select from.
      # all_assemblers_settled: every applicable assembler has finished (or
      # failed) -- without it, the parallel scheduler would select as soon
      # as the FIRST assembler finished, before slower ones had a chance.
      # In sequential mode the list ordering already guarantees both.
      requires   => ['any_assembler_done', 'all_assemblers_settled'],
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Selecting main assembly...",
      long_name  => "Selecting main assembly",
      output_dir => "__DIR-ASSEMBLIES__",
      resultfile => "__DIR-ASSEMBLIES__/__BASE__.fasta",
      resultfiles_status => "NA",

      produces   => [ 'main_assembly_present' ],
};


# TEMPLATES---------------------------------


$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    cp '__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta' '__DIR-ASSEMBLIES__/__BASE__.fasta'
CMD



# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_select_main_assembly;

sub test_select_main_assembly {

   return 2;

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_select_main_assembly;

sub preprocess_select_main_assembly {

    my ($samplenr) = @_;

    my $runstep_name = "select_main_assembly";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template};    
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

    my $main_assembler = "";
    my $reason = "";
    



    
    # Per species if configured ([species__X] main_assembly), else general.
    my $species  = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";
    my $criteria = get_config_value_for_species($species, 'main_assembly', $R_cfg->{general}{main_assembly}) // "";
    my $named_without_result = "";
    if ( ( grep { $_ eq $criteria } group_members('assembler') )
         && !( $R_samples->[$samplenr]{results}{$criteria} && defined $R_samples->[$samplenr]{results}{$criteria}{total_length} ) ) {
        $named_without_result = $criteria;
        $criteria = "fewest_contigs500";
    }
    my $selection_note = "";
    
    if($sample_type eq "FASTA"){       $main_assembler = "imported";   $reason = "rawdata was an assembly";   }
    elsif( grep { $_ eq $criteria } group_members('assembler') ){
        $main_assembler = $criteria;
        $reason = "$criteria is selected as main assembler";
    }
    else {
        my ($comparator, $what);
        $criteria = lc $criteria;   # best_N50 / best_n50 (validated in validate_settings)
        if    ($criteria eq "fewest_contigs")    { $comparator = $gatekeeper_strategy{lowest_value_of}->("nr_contigs");                $what = "assembly with fewest contigs"; }
        elsif ($criteria eq "fewest_contigs500") { $comparator = $gatekeeper_strategy{lowest_value_of}->("nr_contigs_largerthan_500"); $what = "assembly with fewest contigs larger than 500"; }
        elsif ($criteria eq "best_n50")          { $comparator = $gatekeeper_strategy{highest_value_of}->("n50");                      $what = "assembly with highest N50 value"; }
        else                                     { $comparator = $gatekeeper_strategy{lowest_value_of}->("nr_contigs");                $what = "Criteria is missing- using assembly with fewest contigs"; }

        my $gate_note;
        ($main_assembler, $gate_note) = select_assembly_winner($samplenr, $comparator);
        $reason = $what . ( $gate_note ne "" ? " ($gate_note)" : "" );
        $reason = "$named_without_result produced no assembly -- $reason" if $named_without_result ne "";
    }

    # All candidates with their key numbers, for the report and rundata.json
    # (what was compared, and why one was chosen).
    if ( $sample_type ne "FASTA" ) {
        my %excluded = %{ $R_samples->[$samplenr]{_assembly_excluded} // {} };
        delete $R_samples->[$samplenr]{_assembly_excluded};
        my @rows;
        for my $name ( group_members('assembler') ) {
            my $c = $R_samples->[$samplenr]{results}{$name};
            next unless $c && ref $c eq 'HASH' && defined $c->{total_length};
            push @rows, {
                assembler   => $name,
                total_length => $c->{total_length},
                contigs     => $c->{nr_contigs},
                contigs_500 => $c->{nr_contigs_largerthan_500},
                n50         => $c->{n50},
                status      => ( defined $main_assembler && $name eq $main_assembler ) ? "selected"
                             : $excluded{$name} ? "set aside: $excluded{$name}" : "",
            };
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{candidates} = \@rows;
        log_message("INFO: $sample_name assembly candidates: " . join("; ", map {
            "$_->{assembler} $_->{total_length} bp, $_->{contigs_500} contigs500, N50 $_->{n50}" . ( $_->{status} ne "" ? " [$_->{status}]" : "" ) } @rows));
    }

    
    if (!defined $main_assembler || $main_assembler eq "") {
      log_message("ERROR: No suitable main assembler could be selected for sample $sample_name","red");
       return "";
    }
    my $sourcefile = "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta";
    $sourcefile =~ s/__ASSEMBLER__/$main_assembler/g;
    $sourcefile = fill_placeholders($sourcefile, $samplenr, $runstep_name);

    if (!-f $sourcefile) {
        log_message("ERROR: Selected main assembly file does not exist for sample $sample_name: $sourcefile","red");
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
          

     # runstep specific replacements
    
    _fill_placeholders__safe_replace(\$command, "__ASSEMBLER__", $main_assembler);
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
 


    $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_assembler} = $main_assembler;
    $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_reason}    = $reason;
 
 
    if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_select_main_assembly($samplenr);
        return "";
    }  
       
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_select_main_assembly;

sub postprocess_select_main_assembly {
    my ($samplenr) = @_;

    my $runstep_name = "select_main_assembly";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

    my $main_assembler =
       $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_assembler}
    // $R_samples->[$samplenr]{main_results}{assembly}{method}
    // "n/a";

    my $reason =
       $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_reason}
    // $R_samples->[$samplenr]{main_results}{assembly}{method_reason}
    // "n/a";
    
    log_message("NOTICE: Main assembly selected: $main_assembler [$reason]","green");

    my $assemblystats = analyze_assembly_stats($resultfile);
    

    $R_samples->[$samplenr]{results}{$runstep_name}{stats} = $assemblystats;

    my $len        = $assemblystats->{total_length}               // "n/a";
    my $contigs    = $assemblystats->{nr_contigs}                // "n/a";
    my $contigs500 = $assemblystats->{nr_contigs_largerthan_500} // "n/a";
    my $n50        = $assemblystats->{n50}                       // "n/a";
    my $gc         = $assemblystats->{gc_content}                // "n/a";
    my $cov        = $assemblystats->{total_coverage}            // 0;
        
    log_message("NOTICE: Total length: $len", "green");
    log_message("NOTICE: Contigs: $contigs", "green");
    log_message("NOTICE: Contigs (500+): $contigs500", "green");
    log_message("NOTICE: N50: $n50", "green");    
    log_message("NOTICE: gc_content: $gc", "green");
    if(($assemblystats->{total_coverage} // 0) > 0){  log_message("NOTICE: Total coverage: $cov", "green"); }
    
    $R_samples->[$samplenr]{main_results}{assembly}{size} = $len;
    $R_samples->[$samplenr]{main_results}{assembly}{contigs} = $contigs;
    $R_samples->[$samplenr]{main_results}{assembly}{contigs_500} = $contigs500;    
    $R_samples->[$samplenr]{main_results}{assembly}{N50} = $n50;
    $R_samples->[$samplenr]{main_results}{assembly}{gc} = $gc;    
    $R_samples->[$samplenr]{main_results}{assembly}{kmer_cov} = $cov;        
    $R_samples->[$samplenr]{main_results}{assembly}{size} = $len;
    $R_samples->[$samplenr]{main_results}{assembly}{method} = $main_assembler;
    $R_samples->[$samplenr]{main_results}{assembly}{method_reason} = $reason;

    # MD5 fingerprint of the selected assembly (non-deterministic step --
    # same rawdata can produce different assemblies across runs, so a
    # fingerprint here is meaningful unlike trimmed/downsampled FASTQ).
    {
        my $asm_path = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr);
        if (-f $asm_path) {
            my $md5 = md5_file($asm_path);
            $R_samples->[$samplenr]{main_results}{assembly}{md5} = $md5;
            push @{$R_samples->[$samplenr]{main_results}{md5}},
                "Assembly ($main_assembler): $md5";
            log_message("NOTICE: $R_samples->[$samplenr]{name} assembly MD5: $md5");
        }
    }

    return 1; # success
}


# Picks the main assembly among the assemblers that produced a result.
# Returns ($winner, $note); $note is "" or a short text for the report's
# selection reason.
#
# QC gate: before ranking, candidates whose total length lies inside the
# species' fail_assembly_size range (e.g. "<1350000 >2600000") are set
# aside -- a broken assembly can otherwise "win" on contig count or N50.
# If that would leave nothing, the gate is not applied (and the note says
# so); the normal QC evaluation will then flag the selected assembly.
sub select_assembly_winner {
    my ($samplenr, $comparator) = @_;

    my %candidates;
    for my $name ( group_members('assembler') ) {
        my $c = $R_samples->[$samplenr]{results}{$name};
        next unless $c && ref($c) eq 'HASH' && defined $c->{total_length};
        $candidates{$name} = $c;
    }

    my $species   = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";

    # Size gates, tried in order; the first that sets aside some (not all)
    # candidates is used:
    #   1. warning_assembly_size  (catches "a bit too large", e.g. SPAdes
    #                              picking up junk while SKESA is fine)
    #   2. fail_assembly_size
    #   3. only if the species has neither: expected genome size (config,
    #      genome size list or k-mer estimate) +- assembly_size_tolerance
    #      (default 0.2 = 20 %)
    my @gates;
    for my $key (qw(warning_assembly_size fail_assembly_size)) {
        my $thr = parse_threshold_string( get_config_value_for_species($species, $key) );
        push @gates, [ $key, $thr ] if $thr && @{ $thr->{conditions} // [] };
    }
    unless (@gates) {
        ensure_genomesize_computed($samplenr);
        my $gs  = $R_samples->[$samplenr]{estimated_genomesize} // 0;
        my $tol = get_config_value_for_species($species, "assembly_size_tolerance", 0.2);
        $tol = 0.2 unless defined $tol && $tol =~ /^\d*\.?\d+$/ && $tol > 0;
        if ( $gs =~ /^\d+(?:\.\d+)?$/ && $gs > 0 ) {
            my ($lo, $hi) = ( int( $gs * ( 1 - $tol ) ), int( $gs * ( 1 + $tol ) ) );
            push @gates, [ "expected genome size " . int($gs) . " bp +-" . ( $tol * 100 ) . "%",
                           { raw => "<$lo >$hi", conditions => [ { op => '<', value => $lo }, { op => '>', value => $hi } ] } ];
        }
    }

    my $note = "";
    my %excluded_why;
    for my $g (@gates) {
        last unless %candidates;
        my ($gname, $threshold) = @$g;
        my @excluded = grep { threshold_matches($candidates{$_}{total_length}, $threshold) } sort keys %candidates;
        next unless @excluded;
        if (@excluded == keys %candidates) {
            $note = "all assemblies outside $gname $threshold->{raw}";
            next;   # try the next, wider gate
        }
        $note = "set aside by size check ($gname $threshold->{raw}): "
              . join(", ", map { "$_ [" . $candidates{$_}{total_length} . " bp]" } @excluded);
        $excluded_why{$_} = "size outside $gname $threshold->{raw}" for @excluded;
        delete @candidates{@excluded};
        last;
    }
    $note .= " -- size check not applied" if $note =~ /^all assemblies/;
    $R_samples->[$samplenr]{_assembly_excluded} = \%excluded_why;
    log_message("NOTICE: Sample $R_samples->[$samplenr]{name}: main assembly selection: $note", "yellow") if $note ne "";

    my $winner = gatekeeper_select_winner( \%candidates, $comparator, \@ASSEMBLER_TIEBREAK ) // "";
    return wantarray ? ( $winner, $note ) : $winner;
}

    
   
