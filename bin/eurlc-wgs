        $R_samples->[$i]{results}{fastqc_rawdata}{R1}{adapters}{PolyA},   # "rawdata_polyA_content_R1",                   
        $R_samples->[$i]{results}{fastqc_rawdata}{R2}{adapters}{NexteraTransposaseSequence},    #"rawdata_nextera adapter_content_R2",          
        $R_samples->[$i]{results}{fastqc_rawdata}{R2}{adapters}{IlluminaUniversalAdapter},  #"rawdata_Illumina_universal adapter_content_R2",   
        $R_samples->[$i]{results}{fastqc_rawdata}{R2}{adapters}{PolyG},   # "rawdata_polyG_content_R2",  
        $R_samples->[$i]{results}{fastqc_rawdata}{R2}{adapters}{PolyA},   # "rawdata_polyA_content_R2",                         
