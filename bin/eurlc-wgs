## runstep md5_rawdata

$runstep_name = "md5_rawdata";

$runstep{$runstep_name} = {
      message    => "Calculating md5 fingerprints...",
      long_name  => "md5 fingerprints",
      output_dir => "__DIR-QC1__/md5",
      resultfile => "__DIR-QC1__/md5/md5-__BASE__.txt",
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD),
        echo '__BASE__' 
           >> '__OUTDIR__/all_md5sums.txt' 
           __HIDE-STDERR__
        __NEWCOMMAND__   
        __MD5CMD__ '__R1__' '__R2__' 
           | tee -a '__OUTDIR__/all_md5sums.txt' 
           > '__OUTDIR__/md5-__BASE__.txt' 
           __HIDE-STDERR__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD),
        echo '__BASE__' 
           >> '__OUTDIR__/all_md5sums.txt' 
           __HIDE-STDERR__
        __NEWCOMMAND__   
        __MD5CMD__ '__SE__'  
           | tee -a '__OUTDIR__/all_md5sums.txt' 
           > '__OUTDIR__/md5-__BASE__.txt' 
           __HIDE-STDERR__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = wrap_cmd(<<CMD),
        echo '__BASE__' 
           >> '__OUTDIR__/all_md5sums.txt' 
           __HIDE-STDERR__
        __NEWCOMMAND__   
        __MD5CMD__ '__FASTA__'  
           | tee -a '__OUTDIR__/all_md5sums.txt' 
           > '__OUTDIR__/md5-__BASE__.txt' 
           __HIDE-STDERR__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_md5_rawdata;

sub test_md5_rawdata {


   if(exists $tests_performed{md5}  ) {
      return 2; 
   }

   $tests_performed{md5} = 1;
   
   my $md5_cmd = detect_md5_command();
    
   if ($md5_cmd eq "NA") {
        log_message("WARNING: No suitable md5 command found for OS [$rundata{system_info}{os}]. MD5 step will be skipped.","red");
        $R_cfg->{md5}->{enabled} = 0;
        return 0;
   }
    
   return 1;

}


# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_md5_rawdata;

 sub  preprocess_md5_rawdata {
    my ($samplenr) = @_;

    my $runstep_name = "md5_rawdata";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};         
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);

    ###################################
    ### check essential requirements
    
    # check enabled 
    if (is_disabled($R_cfg->{md5}{enabled})) {
        return "";
    }
 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__R1__", "__R2__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__SE__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__FASTA__");
    }

    # check inputfiles PE
    if($sample_type eq "PE"){
       my $infile_1 = fill_placeholders("__R1__",$samplenr);
       my $infile_2 = fill_placeholders("__R2__",$samplenr);
       if(! -f $infile_1 || ! -f $infile_2 ){
          log_message("WARNING: md5 input files are missing [$infile_1] [$infile_2]");
          return "";
       }
    }
    # check inputfiles SE
    if($sample_type eq "SE"){
       my $infile_1 = fill_placeholders("__SE__",$samplenr);
       if(! -f $infile_1 ){
          log_message("WARNING: md5 input file is missing [$infile_1] ");
          return "";
       }
    }
    # check inputfiles FASTA
    if($sample_type eq "FASTA"){
       my $infile_1 = fill_placeholders("__FASTA__",$samplenr);
       if(! -f $infile_1 ){
          log_message("WARNING: md5 input file is missing [$infile_1] ");
          return "";
       }
    }    
    

    #check for resultfile 
    if(-f $resultfile ){
      log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
      postprocess_md5_rawdata($samplenr);
      return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
    
    # runstep specific code
    # get correct md5 executable      
    my $md5_cmd = detect_md5_command();
    
    if ($md5_cmd eq "NA") {
        log_message("WARNING: No suitable md5 command found for OS [$rundata{system_info}{os}]. MD5 step will be skipped.","red");
        return "";
    }

    # runstep specific replacements
    _fill_placeholders__safe_replace(\$command, "__MD5CMD__", $md5_cmd);

    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);   
         
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));

    return $command; # success
} 

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_md5_rawdata;

sub postprocess_md5_rawdata {
    my ($samplenr) = @_;

    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    #parse results
    my $results_ref = parse_md5_results($resultfile);

    if (!$results_ref || ref($results_ref) ne 'HASH' || !%{$results_ref}) {
        log_message("WARNING: No MD5 results parsed for sample [$sample_name] from file [$resultfile]", "yellow");
        set_sample_warning($samplenr,"warning","No md5 results for rawdata");
    }

    # Links used by the HTML reports.
    $results_ref->{txt_report} =   path_relative_to_outdir(fill_placeholders("__OUTDIR__/md5-__BASE__.txt",$samplenr, $runstep_name)); 
  
    
    
    $R_samples->[$samplenr]{results}{$runstep_name} = $results_ref;
    
    
    $R_samples->[$samplenr]{main_results}{md5} //= [];


    ################################
    # print/log results


    my $R1_md5 = $R_samples->[$samplenr]{results}{md5_rawdata}{R1} // "n/a";
    my $R2_md5 = $R_samples->[$samplenr]{results}{md5_rawdata}{R2} // "n/a";
    my $SE_md5 = $R_samples->[$samplenr]{results}{md5_rawdata}{SE} // "n/a";
    my $FASTA_md5 = $R_samples->[$samplenr]{results}{md5_rawdata}{FASTA} // "n/a";

    ## MAIN RESULTS
    if ($sample_type eq "PE") {
        log_message("NOTICE: $sample_name R1: $R1_md5", get_result_color($R1_md5) );
        log_message("NOTICE: $sample_name R2: $R2_md5", get_result_color($R2_md5) );
        push    @{$R_samples->[$samplenr]{main_results}{md5}} , "Rawdata R1: $R1_md5";
        push    @{$R_samples->[$samplenr]{main_results}{md5}} , "Rawdata R2: $R2_md5";
    }
    elsif ($sample_type eq "SE") {
        log_message("NOTICE: $sample_name SE: $SE_md5", get_result_color($SE_md5) );
        push    @{$R_samples->[$samplenr]{main_results}{md5}} , "Rawdata SE: $SE_md5";
    }
    elsif ($sample_type eq "FASTA") {
        log_message("NOTICE: $sample_name FASTA: $FASTA_md5", get_result_color($FASTA_md5) );
        push    @{$R_samples->[$samplenr]{main_results}{md5}} , "Rawdata FASTA: $FASTA_md5";
    }

    return 1; # success
}


sub get_result_color {
 my ($text) = @_;

  if($text eq "" || $text eq "n/a" || $text eq "NA" ){
     return "yellow";
  }
  return "green";
}
##
##   $R_samples->[$samplenr]{results}{md5_rawdata}{R1}
##   $R_samples->[$samplenr]{results}{md5_rawdata}{R2}
##   $R_samples->[$samplenr]{results}{md5_rawdata}{SE}
##   $R_samples->[$samplenr]{results}{md5_rawdata}{FASTA}
##


sub parse_md5_results {
    my ($resultfile) = @_;

    my %md5_data;  # local hash to store parsed results

    my $filename = basename($resultfile);
    # Try to open the file
    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open md5 resultfile $filename");
        return {};  # return empty hashref if file not readable
    }

    while (my $line = <$fh>) {
        chomp $line;
        next unless $line =~ /^(\S+)\s+(\S+)/;  # Match MD5 and path
        my ($md5, $filepath) = ($1, $2);

        my $filename = basename($filepath);

        if (hasR1Extension($filepath)) {
            $md5_data{R1} = $md5;
        }
        elsif (hasR2Extension($filepath)) {
            $md5_data{R2} = $md5;
        }
        elsif (hasFASTQExtension($filepath)) {
            $md5_data{SE} = $md5;
        }
        elsif (hasFASTAExtension($filepath)) {
            $md5_data{FASTA} = $md5;
        }
        else {
            log_message("WARNING: Unrecognized file type for MD5 entry: $filepath");
        }
    }

    close $fh;

    return \%md5_data;  # return hash reference
}


sub detect_md5_command {
  
    my $cmd = "";

    if( is_mac() ) {
        $cmd = `command -v md5 2>/dev/null`;
        chomp $cmd;
        return "md5 -r" if $cmd;
    }
    else {
        $cmd = `command -v md5sum 2>/dev/null`;
        chomp $cmd;
        return "md5sum" if $cmd;
    }

    return "NA";
}




