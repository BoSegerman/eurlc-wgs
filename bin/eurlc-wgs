## runstep fastp_trimmed_data

$runstep_name = "fastp_trimmed_data";

$runstep{$runstep_name} = {
      message    => "Running fastp on trimmed and downsampled data...",
      long_name  => "fastp on trimmed data",
      output_dir => "__DIR-QC2__/Fastp_trimmed_data",
      resultfile => "__DIR-QC2__/Fastp_trimmed_data/__BASE__.trimmed.json",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastp}->{env} --no-capture-output fastp 
       -i '__R1TD__' 
       -I '__R2TD__'  
       --thread __THREADS__ 
       --json __OUTDIR__/__BASE__.trimmed.json 
       --html __OUTDIR__/__BASE__.trimmed.html 
       --report_title '__BASE__.post_downsampling' 
       $R_cfg->{fastp}->{arguments} 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastp}->{env} --no-capture-output fastp 
       -i '__SETD__' 
       --thread __THREADS__ 
       --json __OUTDIR__/__BASE__.trimmed.json 
       --html __OUTDIR__/__BASE__.trimmed.html 
       --report_title '__BASE__.post_downsampling' 
       $R_cfg->{fastp}->{arguments} 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_fastp_trimmed_data;

sub test_fastp_trimmed_data {

   return check_conda_tool("fastp");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_fastp_trimmed_data;

sub preprocess_fastp_trimmed_data {

    my ($samplenr) = @_;

    my $runstep_name = "fastp_trimmed_data";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     

    if ($sample_type eq "FASTA") {
        return "";
    }
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__R1TD__", "__R2TD__");
    }

    elsif ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__SETD__");
    }     

    if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastp_trimmed_data($samplenr);
        return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
              
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastp_trimmed_data;

sub postprocess_fastp_trimmed_data {
    my ($samplenr) = @_;

    my $runstep_name = "fastp_trimmed_data";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

 #   log_message("NOTICE: Sample $sample_name: species is detected as: [$prespecies_results]","green");
  
    my $data = read_json($resultfile);
    my $parsed = parse_fastp_results($data);

    return 0 unless defined $parsed;
    
   $R_samples->[$samplenr]{results}{$runstep_name} = $parsed;
   
   my $genomesize = $R_samples->[$samplenr]{estimated_genomesize};
   my $targetbases =  $R_samples->[$samplenr]{targetbases};
   my $maxdepth =  $R_samples->[$samplenr]{maxdepth};
   my $mindepth =  $R_samples->[$samplenr]{fatal_mindepth};
   my $gc =  $R_samples->[$samplenr]{gc} ;
      
      
  my $target = $R_samples->[$samplenr]{results}{$runstep_name};
  
  
  my $total_bases_before = $target->{summary}{before_filtering}{total_bases};
  my $total_Q30bases_before = $target->{summary}{before_filtering}{q30_bases};
  
  my $coverage_before = 0;
  my $coverageQ30_before = 0;
  
  if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0) {
    $coverage_before = int ($total_bases_before/$genomesize) ;
    $coverageQ30_before = int ($total_Q30bases_before/$genomesize) ;
  }


  
  log_message("NOTICE: ======= After downsampling ==========", "green");
   if($sample_type eq "PE") { print_tabular_results("Total reads", "$target->{read1_before_filtering}{total_reads} + $target->{read2_before_filtering}{total_reads} = $target->{summary}{before_filtering}{total_reads}"); }
   if($sample_type eq "SE") { print_tabular_results("Total reads", "$target->{summary}{before_filtering}{total_reads}"); }
 
   print_tabular_results("Total bases", $target->{summary}{before_filtering}{total_bases});
   print_tabular_results("Q30 rate", $target->{summary}{before_filtering}{q30_rate});
   if($sample_type eq "PE"){
     print_tabular_results("R1 mean length", $target->{summary}{before_filtering}{read1_mean_length});
     print_tabular_results("R2 mean length", $target->{summary}{before_filtering}{read2_mean_length});
   }
   if($sample_type eq "SE") { print_tabular_results("Read mean length", $target->{summary}{before_filtering}{read1_mean_length}); }
   
   print_tabular_results("GC content", $target->{summary}{before_filtering}{gc_content});
 
if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0) {
    print_tabular_results("Coverage depth", $coverage_before);
    print_tabular_results("Q30 Coverage depth", $coverageQ30_before);
  }
      
      
    return 1; # success
       

}

 
sub parse_fastp_results {
    my ($data) = @_;

    unless (ref $data eq 'HASH') {
        log_message("ERROR: fastp result data is not a hashref.");
        return undef;
    }

    my $parsed = dclone($data);

    $parsed->{_source} = 'fastp';
    $parsed->{_loaded} = scalar localtime;

    my @R1_ns = @{ $data->{read1_after_filtering}{content_curves}{N} // [] };
    my @R2_ns = @{ $data->{read2_after_filtering}{content_curves}{N} // [] };

    my @all_ns = (@R1_ns, @R2_ns);

    my $sum   = 0;
    my $count = 0;

    foreach my $value (@all_ns) {
        next unless defined $value && $value ne '';
        $sum += $value;
        $count++;
    }

    my $meanN = $count > 0 ? $sum / $count : 0;
    $parsed->{summary}{after_filtering}{N_rate} = $meanN;

    return $parsed;
}

