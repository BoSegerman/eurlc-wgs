#      alignment_length_gene_length => "762/762",
#      coverage                    => "100.0",
#      position_in_reference        => "1..762",
#      contig                      => "NODE_7_length_150424_cov_40.694979",
#      position_in_contig           => "120188..120949",
#      phenotype                   => "Unknown Beta-lactam",
#      accession_no                => "KR061509",
#    }
#  ],
#  hit_count => 1
#}


