sub parse_runparameters_xml {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my %rp;

    eval {
        require XML::LibXML;

        my $parser = XML::LibXML->new();
        my $doc    = $parser->parse_file($file);

        my ($root) = $doc->findnodes('/RunParameters');
        graceful_die("No <RunParameters> node found in [$file]") if !$root;

        $rp{run_parameters_version} = xml_node_text($root, './RunParametersVersion');
        $rp{run_id}                 = xml_node_text($root, './RunID');
        $rp{scanner_id}             = xml_node_text($root, './ScannerID');
        $rp{run_number}             = xml_node_text($root, './RunNumber');
        $rp{experiment_name}        = xml_node_text($root, './ExperimentName');
        $rp{run_description}        = xml_node_text($root, './RunDescription');
        $rp{library_prep_kit}       = xml_node_text($root, './LibraryPrepKit');
        $rp{index_kit}              = xml_node_text($root, './IndexKit');
        $rp{chemistry}              = xml_node_text($root, './Chemistry');
        $rp{username}               = xml_node_text($root, './Username');
        $rp{enable_analysis}        = xml_node_text($root, './EnableAnalysis');
        $rp{application_name}       = xml_node_text($root, './Setup/ApplicationName');
        $rp{application_version}    = xml_node_text($root, './Setup/ApplicationVersion');
        $rp{num_tiles_per_swath}    = xml_node_text($root, './Setup/NumTilesPerSwath');
        $rp{num_swaths}             = xml_node_text($root, './Setup/NumSwaths');
        $rp{num_lanes}              = xml_node_text($root, './Setup/NumLanes');
        $rp{mcs_version}            = xml_node_text($root, './MCSVersion');
        $rp{rta_version}            = xml_node_text($root, './RTAVersion');
        $rp{reagent_kit_version}    = xml_node_text($root, './ReagentKitVersion');
        $rp{module_name}            = xml_node_text($root, './ModuleName');
        $rp{module_version}         = xml_node_text($root, './ModuleVersion');
        $rp{run_start_date}         = xml_node_text($root, './RunStartDate');
        $rp{run_start_date_iso}     = normalize_runinfo_date($rp{run_start_date});
        $rp{surface_to_scan}        = xml_node_text($root, './SurfaceToScan');
        $rp{focus_method}           = xml_node_text($root, './FocusMethod');
        $rp{after_run_wash_method}  = xml_node_text($root, './AfterRunWashMethod');
        $rp{most_recent_wash_type}  = xml_node_text($root, './MostRecentWashType');

        $rp{flowcell_rfid} = parse_runparameters_rfid_block($root, 'FlowcellRFIDTag');
        $rp{pr2_bottle_rfid} = parse_runparameters_rfid_block($root, 'PR2BottleRFIDTag');
        $rp{reagent_kit_rfid} = parse_runparameters_rfid_block($root, 'ReagentKitRFIDTag');

        $rp{reads} = [];
        foreach my $read_node ($root->findnodes('./Reads/RunInfoRead')) {
            push @{ $rp{reads} }, {
                number          => $read_node->getAttribute('Number')        // '',
                num_cycles      => $read_node->getAttribute('NumCycles')     // '',
                is_indexed_read => $read_node->getAttribute('IsIndexedRead') // '',
            };
        }
    };
    if ($@) {
        log_message("WARNING: Could not parse RunParameters.xml file [$file]: $@");
        return {};
    }

    return \%rp;
}

