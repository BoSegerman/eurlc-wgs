}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_lissero;

sub postprocess_lissero {
    my ($samplenr) = @_;

    my $runstep_name = "lissero";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    my $r = parse_lissero($resultfile);
    unless ($r) {
        log_message("WARNING: Sample $sample_name: LisSero produced no usable result [$resultfile]", "red");
        return 0;
    }
    $r->{status} = "done";

    my @not_used;
    push @not_used, "nontypable" if $r->{serogroup} =~ /^non-?typ/i;
    push @not_used, "no serogroup called" if $r->{serogroup} eq "n/a";
    $r->{serotype}        = @not_used ? "n/a" : $r->{serogroup};
    $r->{not_used_reason} = join("; ", @not_used);
    $R_samples->[$samplenr]{results}{$runstep_name} = $r;

    my $color = @not_used ? "yellow" : "green";
    log_message("NOTICE: Sample $sample_name: LisSero serogroup: $r->{serogroup} "
              . "(prs $r->{prs}, lmo0737 $r->{lmo0737}, lmo1118 $r->{lmo1118}, ORF2110 $r->{orf2110}, ORF2819 $r->{orf2819})"
              . ( $r->{comment} ne "" ? " -- $r->{comment}" : "" ), $color);
    if ( $r->{comment} ne "" ) {
        set_sample_warning($samplenr, "warning", "LisSero: $r->{comment}");
    }

    register_raw_output($samplenr, $runstep_name,
        title => "LisSero results",
        type  => "tsv",
        path  => path_relative_to_outdir($resultfile),
    );

    return 1;
}

# PARSER---------------------------------

sub parse_lissero {
    my ($resultfile) = @_;
    my $row = read_tsv_first_row($resultfile) or return undef;
    my $get = sub { my $v = $row->{ lc $_[0] } // ""; $v =~ s/^\s+|\s+$//g; return $v; };
    my $sg = $get->("SEROTYPE");
    return {
        serogroup => ( $sg ne "" ? $sg : "n/a" ),
        prs       => $get->("PRS")     || "n/a",
        lmo0737   => $get->("LMO0737") || "n/a",
        lmo1118   => $get->("LMO1118") || "n/a",
        orf2110   => $get->("ORF2110") || "n/a",
        orf2819   => $get->("ORF2819") || "n/a",
        comment   => $get->("COMMENT"),
    };
}

######
## example LisSero output
# ID                  SEROTYPE    PRS   LMO0737  LMO1118  ORF2110  ORF2819  COMMENT
# /path/to/15L.fasta  4b, 4d, 4e  FULL  NONE     NONE     FULL     FULL


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep select_main_serotype
##
## Selects the official serotype among the 'serotyping' group (sistr,
## seqsero2, ectyper, lissero), same shape as select_main_mlst: first
## member in priority order with a usable value wins, and any other member
## that disagrees is reported (e.g. SISTR vs SeqSero2 for Salmonella).
## Usually only the tools for the sample's own species ran, so for E. coli
## and Listeria there is just one candidate.
##
## Applies when at least one serotyping tool applies to the sample (config
## on AND species matches). Waits for all of them via all_serotyping_settled
## and does not require any to have succeeded -- if none produced a usable
## serotype it records "n/a" with a reason instead of blocking the sample.
##
## Writes main_results.typing.serotype.{value,method} (already shown in the
## short report).

# Fallback priority within the group. Which of SISTR / SeqSero2 should be
# the official Salmonella answer is decided when those are built out; until
# then SISTR first.
my @SEROTYPE_TIEBREAK = qw(sistr seqsero2 ectyper lissero);

$runstep_name = "select_main_serotype";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Selecting main serotype...",
      long_name  => "Selecting main serotype",
      output_dir => "__DIR-TYPING__",
      resultfile => "__DIR-TYPING__/__BASE__.main_serotype_result.json",
      resultfiles_status => "NA",

      requires   => [ 'all_serotyping_settled' ],
      produces   => [ 'main_serotype_present' ],
      applies_if => sub {
          my ($i) = @_;
          for my $m ( group_members('serotyping') ) {
              my $d = $runstep{$m};
              my $on = eval { exists $d->{applies_if} ? $d->{applies_if}->($i) : 1 };
              return 1 if $on && runstep_species_applies($d, $i);
          }
          return 0;
      },
};

$runstep{$runstep_name}{test} = sub { return 2; };  # no external tool

$runstep{$runstep_name}{preprocessing} = \&preprocess_select_main_serotype;

sub preprocess_select_main_serotype {
    my ($samplenr) = @_;

    my $sample_name  = $R_samples->[$samplenr]{name};
    my $runstep_name = "select_main_serotype";

    my %candidates;
    for my $name ( group_members('serotyping') ) {
        my $c = $R_samples->[$samplenr]{results}{$name};
        next unless $c && ref($c) eq 'HASH' && %$c;
        $candidates{$name} = $c;
    }

    my @priority = group_members('serotyping', \@SEROTYPE_TIEBREAK);
    my @reasons;

    my ($method, $serotype) = priority_select_field( \%candidates, \@priority, 'serotype' );
    if ( defined $method ) {
        push @reasons, "Serotype taken from '$method'"
                     . ( keys %candidates > 1 ? " (priority order: " . join(", ", grep { exists $candidates{$_} } @priority) . ")" : "" );
    }
    else {
        my @ran = sort keys %candidates;
        push @reasons, @ran
            ? "No usable serotype from " . join(", ", @ran)
            : "No serotyping tool produced a result";
        log_message("WARNING: No serotype available for sample $sample_name", "red");
    }
    push @reasons, warn_on_field_mismatch( \%candidates, \@priority, 'serotype', $method, $serotype, "Sample $sample_name: serotype" );

    $R_samples->[$samplenr]{main_results}{typing}{serotype}{value}  = $serotype // "n/a";
    $R_samples->[$samplenr]{main_results}{typing}{serotype}{method} = $method   // "n/a";

    # Full decision for write_main_serotype_result (forked child, reads only).
    $R_samples->[$samplenr]{results}{$runstep_name} = {
        status   => "done",
        serotype => $serotype // "n/a",
        method   => $method   // "n/a",
        reasons  => \@reasons,
    };

    ensure_dir(getdir("out,results,typing"));

    return "SUB\twrite_main_serotype_result\t$samplenr";
}

$runstep{$runstep_name}{result_parsing} = sub {
    my ($samplenr) = @_;
    my $json_path = fill_placeholders($runstep{select_main_serotype}{resultfile}, $samplenr, "select_main_serotype");
    unless (-f $json_path) {
        log_message("WARNING: select_main_serotype result file not found for sample $R_samples->[$samplenr]{name}", "red");
        return 0;
    }
    my $d = $R_samples->[$samplenr]{results}{select_main_serotype} // {};
    log_message("NOTICE: Sample $R_samples->[$samplenr]{name}: serotype: " . ($d->{serotype} // "n/a") . " (" . ($d->{method} // "n/a") . ")", "green");
    return 1;
};

# Internal SUB -- runs in the forked child, writes files only.
sub write_main_serotype_result {
    my ($samplenr) = @_;

    my $decision = $R_samples->[$samplenr]{results}{select_main_serotype};
    return 1 unless $decision && ref($decision) eq 'HASH';

    my $sample_name = $R_samples->[$samplenr]{name};
    my $json_path = fill_placeholders("__DIR-TYPING__/__BASE__.main_serotype_result.json", $samplenr, "select_main_serotype");
    my $txt_path  = fill_placeholders("__DIR-TYPING__/__BASE__.main_serotype_result.txt",  $samplenr, "select_main_serotype");

    write_json_file($decision, $json_path);

    open(my $fh, '>', $txt_path) or do {
        log_message("WARNING: Could not write [$txt_path]: $!", "red");
        return 1;
    };
    print $fh "Main serotype -- sample $sample_name\n";
    print $fh "Serotype: $decision->{serotype} (via $decision->{method})\n";
    print $fh "\nReasons:\n";
    print $fh "  - $_\n" for @{ $decision->{reasons} // [] };
    close($fh);

    return 0;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep virulencefinder
##
## VirulenceFinder (CGE) on the main assembly (BLAST mode, -ifa). E. coli /
## Shigella in v1, searching the databases in [virulencefinder] databases
## (default virulence_ecoli + stx). Database: CGE virulencefinder_db, a git
## clone under __DB__/virulencefinder (install_db), covered by db_freeze.
##
## results.virulencefinder: all hits (gene, identity, coverage, contig, ...),
## a de-duplicated gene list, and a STEC summary: stx genes/subtypes and eae.

$runstep_name = "virulencefinder";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Running VirulenceFinder...",
      long_name  => "VirulenceFinder",
      output_dir => "__DIR-TYPING__/virulencefinder/__BASE__",
      resultfile => "__DIR-TYPING__/virulencefinder/__BASE__/__BASE__.virulencefinder.json",
      resultfiles_status => "NA",

      species    => config_species_list('virulencefinder'),   # from [virulencefinder] species
      requires   => [ 'main_assembly_present', 'kraken2_settled' ],
      produces   => [ 'virulencefinder_done' ],
      applies_if => sub { return $R_cfg->{virulencefinder}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    mkdir -p '__OUTDIR__/tmp'
    __NEWCOMMAND__
    conda run -n $R_cfg->{virulencefinder}->{env} --no-capture-output python -m virulencefinder
       -ifa '__DIR-ASSEMBLIES__/__BASE__.fasta'
       -o '__OUTDIR__'
       -tmp '__OUTDIR__/tmp'
       -p '__VIRULENCEFINDERDB__/virulencefinder_db'
       __VIRULENCEFINDER-DATABASES__
       -j '__OUTDIR__/__BASE__.virulencefinder.json'
       -x -q
       $R_cfg->{virulencefinder}->{arguments}
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -rf '__OUTDIR__/tmp'
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_virulencefinder;

sub test_virulencefinder {
    return check_conda_tool("virulencefinder");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_virulencefinder;

sub preprocess_virulencefinder {

    my ($samplenr) = @_;

    my $runstep_name = "virulencefinder";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $command    = $runstep{$runstep_name}{cmd_template};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_virulencefinder($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    my $dbs = $R_cfg->{virulencefinder}{databases} // "";
    $dbs =~ s/\s+//g;
    _fill_placeholders__safe_replace(\$command, "__VIRULENCEFINDER-DATABASES__", $dbs ne "" ? "-d '$dbs'" : "");

    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_virulencefinder;

sub postprocess_virulencefinder {
    my ($samplenr) = @_;

    my $runstep_name = "virulencefinder";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    unless (-s $resultfile) {
        log_message("WARNING: Sample $sample_name: VirulenceFinder produced no result [$resultfile]", "red");
        return 0;
    }
    my @hits = parse_cge_hits($resultfile);

    # Gene names from the database can carry allele/strain suffixes
    # (stx2a-O157-EDL933, eae-b01a-beta_1a); the summary uses the short form.
    my %genes;
    for my $h (@hits) {
        my $g = $h->{gene};
        $g = $1 if $g =~ /^(stx\d[a-z]?|eae)(?:-|$)/;
        $genes{$g} = 1;
    }
    my @gene_list = sort { lc $a cmp lc $b } keys %genes;

    # stx: subtypes (stx2a) if known; a bare "stx2" only when no stx2
    # subtype was found (the 'stx' database reports the type only).
    # Case matters: lower-case letter = subtype (stx2a), upper-case =
    # toxin subunit in older databases (stx2A/stx2B) -> type stx2.
    my %stx;
    for my $h (@hits) {
        $stx{$1} = 1 if $h->{gene} =~ /^(stx\d[a-z]?)(?![a-z])/;
    }
    for my $s (keys %stx) {
        delete $stx{$s} if $s =~ /^stx\d$/ && grep { /^\Q$s\E[a-z]$/ } keys %stx;
    }
    my @stx = sort keys %stx;

    my ($eae_hit) = grep { $_->{gene} =~ /^eae/i } @hits;
    my $eae = "no";
    if ($eae_hit) {
        $eae = "yes";
        $eae .= " ($1)" if $eae_hit->{gene} =~ /^eae-[^-]*-([a-z]+)/i;   # eae-b01a-beta_1a -> beta
    }

    $R_samples->[$samplenr]{results}{$runstep_name} = {
        status    => "done",
        hit_count => scalar(@hits),
        hits      => \@hits,
        genes     => @gene_list ? join(", ", @gene_list) : "none",
        stx       => @stx ? join(", ", @stx) : "none",
        eae       => $eae,
    };

    log_message("NOTICE: Sample $sample_name: VirulenceFinder: " . scalar(@gene_list) . " gene(s)"
              . ( @gene_list ? ": " . join(", ", @gene_list) : "" ), "green");
    log_message("NOTICE: Sample $sample_name: stx: " . ( @stx ? join(", ", @stx) : "none" ) . ", eae: $eae",
                @stx ? "yellow" : "green");

    register_raw_output($samplenr, $runstep_name,
        title => "VirulenceFinder results (JSON)",
        type  => "txt",
        path  => path_relative_to_outdir($resultfile),
    );

    return 1;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep plasmidfinder
##
## PlasmidFinder 2.1.6 (CGE, bioconda) on the main assembly, BLAST mode:
## plasmid replicon types. Not
## species-specific -- runs for every sample when enabled. Database: CGE
## plasmidfinder_db, a git clone under __DB__/plasmidfinder (install_db),
## covered by db_freeze. Most replicons in the database are from
## Enterobacterales and Gram-positives; for other genera (e.g.
## Campylobacter) an empty result is expected and does not mean "no
## plasmids".

$runstep_name = "plasmidfinder";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Running PlasmidFinder...",
      long_name  => "PlasmidFinder",
      output_dir => "__DIR-TYPING__/plasmidfinder/__BASE__",
      resultfile => "__DIR-TYPING__/plasmidfinder/__BASE__/__BASE__.plasmidfinder.json",
      resultfiles_status => "NA",

      requires   => [ 'main_assembly_present' ],
      produces   => [ 'plasmidfinder_done' ],
      applies_if => sub { return $R_cfg->{plasmidfinder}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    mkdir -p '__OUTDIR__/tmp'
    __NEWCOMMAND__
    conda run -n $R_cfg->{plasmidfinder}->{env} --no-capture-output plasmidfinder.py
       -i '__DIR-ASSEMBLIES__/__BASE__.fasta'
       -o '__OUTDIR__'
       -tmp '__OUTDIR__/tmp'
       -mp blastn
       -p '__PLASMIDFINDERDB__/plasmidfinder_db'
       -x -q
       $R_cfg->{plasmidfinder}->{arguments}
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    mv '__OUTDIR__/data.json' '__OUTDIR__/__BASE__.plasmidfinder.json'
    __NEWCOMMAND__
    rm -rf '__OUTDIR__/tmp'
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_plasmidfinder;

sub test_plasmidfinder {
    return check_conda_tool("plasmidfinder");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_plasmidfinder;

sub preprocess_plasmidfinder {

    my ($samplenr) = @_;

    my $runstep_name = "plasmidfinder";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $command    = $runstep{$runstep_name}{cmd_template};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_plasmidfinder($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_plasmidfinder;

sub postprocess_plasmidfinder {
    my ($samplenr) = @_;

    my $runstep_name = "plasmidfinder";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    unless (-s $resultfile) {
        log_message("WARNING: Sample $sample_name: PlasmidFinder produced no result [$resultfile]", "red");
        return 0;
    }
    my @hits = parse_cge_hits($resultfile);
    my %rep = map { $_->{gene} => 1 } @hits;
    my @replicons = sort { lc $a cmp lc $b } keys %rep;

    $R_samples->[$samplenr]{results}{$runstep_name} = {
        status    => "done",
        hit_count => scalar(@hits),
        hits      => \@hits,
        replicons => @replicons ? join(", ", @replicons) : "none",
    };

    log_message("NOTICE: Sample $sample_name: PlasmidFinder replicons: " . ( @replicons ? join(", ", @replicons) : "none" ), "green");

    register_raw_output($samplenr, $runstep_name,
        title => "PlasmidFinder results (JSON)",
        type  => "txt",
        path  => path_relative_to_outdir($resultfile),
    );

    return 1;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep sort_assemblies

$runstep_name = "sort_assemblies";

$runstep{$runstep_name} = {
      message    => "Sorting assemblies by species...",
      long_name  => "Sorting assemblies by species",
      output_dir => "__DIR-ASSEMBLIES__/by_species/__SPECIES__",
      resultfile => "__DIR-ASSEMBLIES__/by_species/__SPECIES__/__BASE__.fasta",
      resultfiles_status => "NA",

      # Batch-level (§ batch scheduler) -- was an unconditional "REQUIRED
      # STEP" with no enabled flag. requires uses any_sample_satisfies
      # (not all), matching this runstep's own tolerant behavior of
      # skipping individual samples that are missing their assembly rather
      # than failing outright.
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'assemblies_sorted' ],
      applies_if => sub { return 1; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
       cp __DIR-ASSEMBLIES__/__BASE__.fasta __DIR-ASSEMBLIES__/by_species/__SPECIES__/__BASE__.fasta
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_sort_assemblies;

sub test_sort_assemblies {

   return 2; # no test needed

}

$runstep{$runstep_name}{preprocessing} = \&preprocess_sort_assemblies;

sub preprocess_sort_assemblies {

    my $runstep_name = "sort_assemblies";

    log_message("INFO: Preparing to run step $runstep_name on all sample");

    my $command = "";

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {

        my $sample_name    = $R_samples->[$samplenr]{name};
        my $sample_type    = $R_samples->[$samplenr]{type};
        my $sample_species = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "unknown";

        $sample_species =~ s/\s/_/g;

        my $command_part = $runstep{$runstep_name}{cmd_template};
        my $resultfile   = $runstep{$runstep_name}{resultfile};
        my $outputdir    = $runstep{$runstep_name}{output_dir};

        $command_part =~ s/__SPECIES__/$sample_species/g;
        $resultfile   =~ s/__SPECIES__/$sample_species/g;
        $outputdir    =~ s/__SPECIES__/$sample_species/g;

        $command_part = fill_placeholders($command_part, $samplenr, $runstep_name);
        $resultfile   = fill_placeholders($resultfile,   $samplenr, $runstep_name);
        $outputdir    = fill_placeholders($outputdir,    $samplenr, $runstep_name);

        my $sourcefile = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name);

        ensure_dir($outputdir);

        if ( $R_samples->[$samplenr]{fatal_error} ) {
            # The single, shared gateway for excluding a fatal-error sample
            # from every batch runstep at once -- see the runstep machinery
            # design doc's discussion of fatal_to_sample. By never copying
            # this sample's assembly into by_species/, parse_sort_assemblies
            # (which builds $rundata{batches} by scanning that directory)
            # never sees it, and neither does anything downstream that reads
            # from $rundata{batches} -- checkm, chewbbaca (batch mode), the
            # distance matrix, register_clustering_result, multiqc, and any
            # future batch runstep -- with no change needed in any of them,
            # present or future. Per-sample mode is unaffected by this gate
            # entirely; it's already covered by the same check inside
            # run_data_driven_runsteps.
            log_message("NOTICE: Sample $sample_name: excluded from batch-level analyses (fatal error earlier in this sample's analysis)", "yellow");
            next;
        }

        if (! -f $sourcefile) {
            log_message("WARNING: Sample $sample_name: source assembly file missing [$sourcefile], skipping sort step for this sample", "yellow");
            next;
        }

        if (! -f $resultfile) {
            if ($command eq "") {
                $command = $command_part;
            }
            else {
                $command = $command . " ; " . $command_part;
            }
        }
    }

    if ($command eq "") {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name}. Files already sorted or no source assemblies available");
        postprocess_sort_assemblies();
        return "";
    }

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_sort_assemblies;

sub postprocess_sort_assemblies {
    
    my $runstep_name = "sort_assemblies";

    my $outputdir = $runstep{$runstep_name}{output_dir};  

    # runstep specific replacements
    $outputdir =~ s/__SPECIES__//g;
       
    #format command
    $outputdir  = fill_placeholders($outputdir, "", $runstep_name);     
       
    my $result_ref = parse_sort_assemblies($outputdir);
    
   $rundata{batches} = $result_ref; 
   
   my $hitcount = $result_ref->{subdirs_count};

   
   for(my $i=0;$i<$hitcount; $i++){
   my $dirname = $result_ref->{subdirs}[$i];
   my $species = $result_ref->{$dirname}{species};
   my $samples = $result_ref->{$dirname}{count};
   log_message("NOTICE: Species $species: $samples samples", "green");
  }
      
    
    return 1; # success
}

# PARSER ----------------------------------

sub parse_sort_assemblies {
    my ($dir) = @_;
    my %result;

    # Ensure directory exists
    unless (-d $dir) {
        log_message("WARNING: Directory not found: $dir", "red");
        return {};
    }

    opendir(my $dh, $dir) or do {
        log_message("WARNING: Could not open directory: $dir", "red");
        return {};
    };

    my @subdirs;
    while (my $entry = readdir($dh)) {
        next if $entry =~ /^\./;  # skip . and ..
        my $path = File::Spec->catdir($dir, $entry);
        push @subdirs, $entry if -d $path;
    }
    closedir $dh;

    # Store subdir list
    $result{subdirs} = \@subdirs;
    $result{subdirs_count} = @subdirs;
    
    # Process each subdir
    for my $subdir (@subdirs) {
        my $path = File::Spec->catdir($dir, $subdir);
        opendir(my $sdh, $path) or do {
            log_message("WARNING: Could not open subdirectory: $path", "red");
            next;
        };

        my @fasta_files = grep { /\.fasta$/i && -f File::Spec->catfile($path, $_) } readdir($sdh);
        closedir $sdh;

        my $count   = scalar @fasta_files;
        my $species = $subdir;
        $species =~ s/_/ /g;

        $result{$subdir} = {
            count   => $count,
            species => $species,
            fasta   => [ map { File::Spec->catfile($path, $_) } @fasta_files ],
        };
    }

    return \%result;
}

