###################################################################################################
## capture output suffixes

# peekdir (not getdir) -- we only need the path for string interpolation
# in the capture suffixes below. The directory itself is created later,
# right before initiate_logfile(), so that out/ sub-directories are never
# created before the overwrite check has run (which would make the check
# always fire on a re-run even with a fresh output directory).
my $S_logdir = peekdir("out,log");

# Control channel spool directory (§11.3) -- a sibling of out/log/, not
# nested inside it, because it is the one thing under out/ that is an
# INPUT to the pipeline (commands from a GUI or operator) rather than
# pipeline-produced output. Created at startup so a GUI can start writing
# commands before the pipeline has even entered its main loop.
my $S_control_dir = peekdir("out,control");
# The actual directories are created right before initiate_logfile(), after
# the overwrite check -- see below. Using peekdir here (not getdir) so we
# get the correct paths for string interpolation without prematurely
# creating out/ subdirectories that would make the overwrite check always
# fire on the next run.

# Runtime state flags set by process_control_commands() and read in
# run_step() before each dispatch. Both start false; either can be set
# any time a command file arrives in $S_control_dir.
my $S_paused    = 0;   # true: block dispatch of new work
my $S_terminate = 0;   # true: gracefully exit once current step finishes

# PID of the currently-running forked child (0 when none is running).
# Set by execute_and_log immediately after fork(), cleared when waitpid()
# returns. Read by the signal handler to forward the signal to the child
# before the parent exits -- without this, the child becomes an orphan
# and continues running even though the parent is gone.
my $S_current_child_pid = 0;

# Parallel scheduler resource ceilings -- resolved once at startup after
# config is loaded (see the resolve_parallel_resource_limits() call below,
# which fills these in). Read-only after that.
my $S_max_threads = 0;
my $S_max_ram_gb  = 0;

# When set (by run_parallel_runsteps during result_parsing reap cycles),
# log_message appends to this arrayref instead of printing to stdout.
# Prevents result_parsing's diagnostic output from corrupting the board.
our $S_par_log_capture   = undef;

# Count of WARNING-level messages suppressed from screen during parallel
# result_parsing cycles. Shown as "⚠ N warnings" in the status board so
# warnings are never silently lost, even though individual messages are
# suppressed to keep the board stable. Reset at the start of each parallel
# phase run.
our $S_par_warning_count = 0;
our @S_par_warnings      = ();   # text of suppressed warnings, for end-of-run summary

# Signal handlers for SIGTERM (kill / systemd stop / timeout from wrapper)
# and SIGINT (Ctrl-C). Both do the same thing: forward the signal to the
# child's own process group (the child called setpgid(0,0) so it is its
# own group leader -- kill(-$pid, ...) reaches everything the child
# spawned as well), log, close the logfile, then exit with code 4.
# Exit code 4 = externally signalled -- distinct from:
#   1 = graceful_die (pipeline-internal fatal error)
#   2 = config-level warning
#   3 = partial success (samples abandoned via fatal_error)
#   control-channel terminate = also exits 1 (planned, not external)
for my $sig (qw(TERM INT)) {
    $SIG{$sig} = sub {
        # Forward to child first so it does not become an orphan.
        if ($S_current_child_pid > 0) {
            # TERM the child's whole process group (it called setpgid(0,0)
            # so the group ID equals the child's own PID -- this reaches
            # every subprocess the child may have spawned, e.g. conda run +
            # the actual tool process underneath it).
            kill 'TERM', -$S_current_child_pid;
            # Give it a moment, then KILL if still alive.
            my $t0 = time();
            while (time() - $t0 < 5) {
                last if waitpid($S_current_child_pid, POSIX::WNOHANG()) > 0;
                select(undef, undef, undef, 0.2);
            }
            kill 'KILL', -$S_current_child_pid
                if waitpid($S_current_child_pid, POSIX::WNOHANG()) <= 0;
        }
        log_message("NOTICE: Pipeline received SIG$sig -- aborting", "red");
        close_logfile();
        exit 4;
    };
}

my $capture_output_hide            = " 1>>\"$S_logdir/stdout.txt\" 2>>\"$S_logdir/stderr.txt\"";
my $capture_stderr_hide            = " 2>>\"$S_logdir/stderr.txt\"";

my $capture_output_verbose    = " > >(tee -a \"$S_logdir/stdout.txt\") 2> >(tee -a \"$S_logdir/stderr.txt\" >&2)";  # both capture and let through to the screen
my $capture_stderr_verbose    = " 2> >(tee -a \"$S_logdir/stderr.txt\" >&2)";   # both capture and let through to the screen

my $capture_output            = $capture_output_hide ;  #default
my $capture_stderr            = $capture_stderr_hide;   #default

