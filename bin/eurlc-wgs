## runstep multiqc

$runstep_name = "multiqc";

$runstep{$runstep_name} = {
      message    => "Running MultiQC...",
      long_name  => "MultiQC",
      output_dir => "",
      resultfile => "",
      resultfiles_status => "NA",

      # Batch-level -- pure aggregation over the QC1/QC2 output folder
      # structure, not tied to any specific per-sample data-key. Was an
      # unconditional "REQUIRED STEP" with no enabled flag.
      requires   => [],
      produces   => [ 'multiqc_done' ],
      applies_if => sub { return 1; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
cd "__DIR-QC1__"
__NEWCOMMAND__
conda run -n $R_cfg->{multiqc}->{env} --no-capture-output multiqc . __HIDE-OUTPUT__

__NEWCOMMAND__
cd "__DIR-QC2__"
__NEWCOMMAND__
