################################################################################
# Initialize a generic issue container
sub init_issue_container {
    return {
        status => "PASS",
        issues => {
            warning  => [],
            critical => [],
            fail     => [],
        },
    };
}

################################################################################
# Internal helper: validate severity
sub _is_valid_issue_severity {
    my ($severity) = @_;
    return defined $severity && $severity =~ /^(warning|critical|fail)$/ ? 1 : 0;
}

################################################################################
# Internal helper: map severity to status
sub _issue_severity_to_status {
    my ($severity) = @_;

    my %map = (
        warning  => "WARNING",
        critical => "CRITICAL",
        fail     => "FAIL",
    );

    return $map{$severity};
}

################################################################################
# Internal helper: compare statuses
sub _issue_status_rank {
    my ($status) = @_;

    my %rank = (
        PASS     => 0,
        WARNING  => 1,
        CRITICAL => 2,
        FAIL     => 3,
    );

    return exists $rank{$status} ? $rank{$status} : -1;
}

################################################################################
# Internal helper: push unique value to arrayref
sub _push_unique {
    my ($R_array, $value) = @_;

    return 0 if !defined $R_array || ref($R_array) ne 'ARRAY';
    return 0 if !defined $value || $value eq "";

    if (!grep { $_ eq $value } @$R_array) {
        push @$R_array, $value;
        return 1;
    }

    return 0;
}

################################################################################
# Internal helper: ensure issue container structure
sub _ensure_issue_container {
    my ($R_container) = @_;

    return 0 if !defined $R_container || ref($R_container) ne 'HASH';

    $R_container->{status} ||= "PASS";
    $R_container->{issues} ||= {};

    for my $sev (qw(warning critical fail)) {
        $R_container->{issues}{$sev} ||= [];
    }

    return 1;
}

################################################################################
# Core helper: add issue to one issue container
sub add_issue_to_container {
    my ($R_container, $severity, $message) = @_;

    if (!defined $R_container || ref($R_container) ne 'HASH') {
        log_message("WARNING: add_issue_to_container called with invalid container");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: add_issue_to_container got invalid severity [$severity]");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: add_issue_to_container called with empty message");
        return 0;
    }

    _ensure_issue_container($R_container);

    _push_unique($R_container->{issues}{$severity}, $message);

    my $new_status = _issue_severity_to_status($severity);

    if (_issue_status_rank($new_status) > _issue_status_rank($R_container->{status})) {
        $R_container->{status} = $new_status;
    }

    return 1;
}

################################################################################
# Reset all report issues for one sample
sub reset_report_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: reset_report_issues called with invalid samplenr");
        return 0;
    }

    $R_samples->[$samplenr]{report_issues} = {
        by_category => {
            taxonomy      => init_issue_container(),
            typing        => init_issue_container(),
            contamination => init_issue_container(),
            assembly      => init_issue_container(),
            qscore        => init_issue_container(),
            coverage      => init_issue_container(),
        },
        summary => init_issue_container(),
    };

    return 1;
}

################################################################################
# Reset runtime issues for one sample
sub reset_runtime_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: reset_runtime_issues called with invalid samplenr");
        return 0;
    }

    $R_samples->[$samplenr]{runtime_issues} = init_issue_container();
    $R_samples->[$samplenr]{fatal_error} = 0;
    $R_samples->[$samplenr]{fatal_error_message} = [];
    $R_samples->[$samplenr]{fatal_error_runstep} = "";

    return 1;
}

################################################################################
# Ensure a report issue category exists
sub ensure_report_issue_category {
    my ($samplenr, $category) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: ensure_report_issue_category called with invalid samplenr");
        return 0;
    }

    if (!defined $category || $category eq "") {
        log_message("WARNING: ensure_report_issue_category called without category (sample $samplenr)");
        return 0;
    }

    $R_samples->[$samplenr]{report_issues} ||= {
        by_category => {},
        summary     => init_issue_container(),
    };

    $R_samples->[$samplenr]{report_issues}{by_category} ||= {};
    $R_samples->[$samplenr]{report_issues}{summary}     ||= init_issue_container();

    $R_samples->[$samplenr]{report_issues}{by_category}{$category} ||= init_issue_container();

    return 1;
}

################################################################################
# Add a runtime issue
# Use this during runsteps / parsing / missing required outputs / tool failures
sub set_runtime_issue {
    my ($samplenr, $severity, $message, $runstep_name) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: set_runtime_issue called with invalid samplenr");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: set_runtime_issue got invalid severity [$severity] (sample $samplenr)");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: set_runtime_issue called with empty message (sample $samplenr)");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];

    $sample->{runtime_issues} ||= init_issue_container();

    my $ok = add_issue_to_container($sample->{runtime_issues}, $severity, $message);
    return 0 if !$ok;

    if ($severity eq "fail") {
        $sample->{fatal_error} = 1;
        $sample->{fatal_error_message} ||= [];
        _push_unique($sample->{fatal_error_message}, $message);

        if (defined $runstep_name && $runstep_name ne "") {
            $sample->{fatal_error_runstep} = $runstep_name;
        }
    }

    return 1;
}

################################################################################
# Add a report issue
# Use this after QC evaluation when main_results have been populated
sub set_report_issue {
    my ($samplenr, $category, $severity, $message) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: set_report_issue called with invalid samplenr");
        return 0;
    }

    if (!defined $category || $category eq "") {
        log_message("WARNING: set_report_issue missing category (sample $samplenr)");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: set_report_issue got invalid severity [$severity] (sample $samplenr)");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: set_report_issue called with empty message (sample $samplenr)");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];

    ensure_report_issue_category($samplenr, $category);

    add_issue_to_container($sample->{report_issues}{by_category}{$category}, $severity, $message);
    add_issue_to_container($sample->{report_issues}{summary},                $severity, $message);

    return 1;
}

################################################################################
# Optional compatibility layer:
# copy report summary into qc so older report code can continue to work
sub sync_qc_from_report_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: sync_qc_from_report_issues called with invalid samplenr");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];
    my $summary = $sample->{report_issues}{summary};

    if (!defined $summary || ref($summary) ne 'HASH') {
        log_message("WARNING: sync_qc_from_report_issues found no report summary for sample $samplenr");
        return 0;
    }

    _ensure_issue_container($summary);

    $sample->{qc} = {
        status => $summary->{status},
        issues => {
            warning  => [ @{ $summary->{issues}{warning}  || [] } ],
            critical => [ @{ $summary->{issues}{critical} || [] } ],
            fail     => [ @{ $summary->{issues}{fail}     || [] } ],
        },
    };

    return 1;
}

################################################################################
# Return overall status for one report category
sub get_report_category_status {
    my ($samplenr, $category) = @_;

    return "PASS" if !defined $samplenr || !defined $R_samples->[$samplenr];
    return "PASS" if !defined $category || $category eq "";

    my $R_cat = $R_samples->[$samplenr]{report_issues}{by_category}{$category};
    return "PASS" if !defined $R_cat || ref($R_cat) ne 'HASH';

    return $R_cat->{status} || "PASS";
}

################################################################################
# Return all issues for one report category
sub get_report_category_issues {
    my ($samplenr, $category) = @_;

    return init_issue_container() if !defined $samplenr || !defined $R_samples->[$samplenr];
    return init_issue_container() if !defined $category || $category eq "";

    my $R_cat = $R_samples->[$samplenr]{report_issues}{by_category}{$category};
    return init_issue_container() if !defined $R_cat || ref($R_cat) ne 'HASH';

    _ensure_issue_container($R_cat);
    return $R_cat;
}

################################################################################
# Return summary issue container for a sample
sub get_report_summary_issues {
    my ($samplenr) = @_;

    return init_issue_container() if !defined $samplenr || !defined $R_samples->[$samplenr];

    my $R_summary = $R_samples->[$samplenr]{report_issues}{summary};
    return init_issue_container() if !defined $R_summary || ref($R_summary) ne 'HASH';

    _ensure_issue_container($R_summary);
    return $R_summary;
}

sub set_sample_warning {
    my ($samplenr, $warningtype, $warningmessage, $category) = @_;

     $category   //= undef;
     
    ############################ 
    # Validate input (non-fatal)
    if (!defined $samplenr) {
        log_message("WARNING: set_sample_warning called without samplenr");
        return 0;
    }

    if (!defined $warningtype || $warningtype eq "") {
        log_message("WARNING: set_sample_warning missing warningtype (sample $samplenr)");
        return 0;
    }

    if (!defined $warningmessage || $warningmessage eq "") {
        log_message("WARNING: set_sample_warning missing warningmessage (sample $samplenr)");
        return 0;
    }

    my %valid_types = map { $_ => 1 } qw(warning critical fail);

    if (!$valid_types{$warningtype}) {
        log_message("WARNING: set_sample_warning unknown type [$warningtype] (sample $samplenr)");
        return 0;
    }

    my %type_to_status = (
        warning  => "WARNING",
        critical => "CRITICAL",
        fail     => "FAIL",
    );

    my %status_rank = (
        PASS     => 0,
        WARNING  => 1,
        CRITICAL => 2,
        FAIL     => 3,
    );

    ###############################
    # Ensure qc structure exists
    my $qc = $R_samples->[$samplenr]{qc};
    if (!defined $qc) {
        log_message("WARNING: QC structure missing for sample $samplenr, initializing");
        $qc = $R_samples->[$samplenr]{qc} = {};
    }

    # Ensure structure
    $qc->{status} //= "PASS";
    $qc->{issues} //= {};

    for my $t (qw(warning critical fail)) {
        $qc->{issues}{$t} //= [];
    }

    # Add message (avoid duplicates)
    my $arr = $qc->{issues}{$warningtype};
    if (!grep { $_ eq $warningmessage } @$arr) {
        push @$arr, $warningmessage;
    }

    # Upgrade overall status if needed
    my $new_status = $type_to_status{$warningtype};

    if (($status_rank{$new_status} // -1) > ($status_rank{$qc->{status}} // -1)) {
        $qc->{status} = $new_status;
    }


    return 1;
}


# write_sample_manifest(\%rundata)
#
# Writes out/log/sample_manifest.tsv after all samples have been loaded and
# their basenames finalised (after sanitization and unique_basename).
# The file is always written, even when no names were changed, so it serves
# as the authoritative basename → raw-file mapping for the entire run.
#
# Columns:
#   sample_name   - the final basename used throughout the pipeline
#   type          - PE / SE / FASTA
#   raw_R1        - absolute path to the R1 (or SE) FASTQ, or the FASTA file
#   raw_R2        - absolute path to the R2 FASTQ (empty for SE/FASTA)
#
# The file is tab-separated with a header line so it can be opened directly
# in Excel / LibreOffice or parsed with awk/cut without extra options.
# Same sample on several lanes (B28): writes one file per read direction,
# large_files/fastq/merged/<name>.merged_<R1|R2|SE>.fastq.gz, by appending
# the lane files (gzip files may simply be concatenated). Called once,
# before the first step. An existing merged file of the right size (the sum
# of the lane files) is reused. The MD5 of each lane file is computed while
# copying and kept next to the merged file (<file>.sources.md5), so the
# report can name the original files and their checksums.
#
# The merged files are intermediate, like the trimmed reads: removed by
# cleanup.merged_fastq (default 1). On --resume after such a cleanup they are
# made again only for a sample that still has a step to run.
sub merge_lane_files {
    my @todo = grep { $R_samples->[$_]{paths}{lane_sources} } 0 .. $#$R_samples;
    return unless @todo;
    our %S_CLEANUP_REMOVED;
    for my $i (@todo) {
        my $sample = $R_samples->[$i];
        my $name   = $sample->{name};
        my $src    = $sample->{paths}{lane_sources};
        my @slots  = sort keys %$src;
        my @missing_out = grep { !-f $sample->{paths}{raw}{$_} } @slots;

        if ( @missing_out && $S_CLEANUP_REMOVED{merged_fastq} && !sample_has_pending_steps($i) ) {
            log_message("INFO: $name: merged lane files were removed by an earlier cleanup and no step needs them");
            $sample->{lane_merge}{removed_by_cleanup} = 1;
            next;
        }
        for my $slot (@slots) {
            my $target = $sample->{paths}{raw}{$slot};
            my @files  = @{ $src->{$slot} };
            my $want   = 0;
            $want += ( -s $_ // 0 ) for @files;
            my $sidecar = "$target.sources.md5";

            if ( -f $target && ( -s $target // -1 ) == $want ) {
                log_message("INFO: $name: reusing merged $slot file [" . basename($target) . "]");
            }
            else {
                log_message("NOTICE: $name: merging " . scalar(@files) . " lane files into " . basename($target)
                          . sprintf( " (%.1f GB)", $want / 1e9 ));
                my $tmp = "$target.tmp$$";
                open( my $out, '>:raw', $tmp ) or graceful_die("Cannot write [$tmp]: $!");
                my @md5;
                for my $f (@files) {
                    open( my $in, '<:raw', $f ) or graceful_die("Cannot read lane file [$f]: $!");
                    my $ctx = Digest::MD5->new;
                    my $buf;
                    while ( my $n = read( $in, $buf, 4 * 1024 * 1024 ) ) {
                        $ctx->add($buf);
                        print {$out} $buf or graceful_die("Writing [$tmp] failed: $!");
                    }
                    close $in;
                    push @md5, $ctx->hexdigest . "  $f";
                }
                close($out) or graceful_die("Writing [$tmp] failed: $!");
                graceful_die("Merged file [$tmp] has the wrong size") unless ( -s $tmp // -1 ) == $want;
                rename( $tmp, $target ) or graceful_die("Cannot rename [$tmp] to [$target]: $!");
                if ( open( my $sf, '>', $sidecar ) ) { print {$sf} "$_\n" for @md5; close $sf; }
            }
            set_raw_file_metadata( $sample, $slot, $target );

            my %md5_of;
            if ( open( my $sf, '<', $sidecar ) ) {
                while ( my $l = <$sf> ) { chomp $l; my ($m, $f) = split /\s+/, $l, 2; $md5_of{$f} = $m if defined $f; }
                close $sf;
            }
            $sample->{lane_merge}{sources}{$slot} =
                [ map { { file => $_, size => ( -s $_ // 0 ), md5 => $md5_of{$_} } } @files ];
        }
        $sample->{lane_merge}{lanes} = $sample->{lanes};
    }
}

# Does sample $i still have a per-sample step to run (applicable, with a
# result file that does not exist yet)? Same test as plan_read_regeneration.
sub sample_has_pending_steps {
    my ($i) = @_;
    our @PER_SAMPLE_RUNSTEPS;
    local $S_STATIC_APPLIES = 1;
    for my $name (@PER_SAMPLE_RUNSTEPS) {
        my $def = $runstep{$name};
        next unless eval { $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
        my $rf = $def->{resultfile} // "";
        next if $rf eq "";
        my $f = eval { fill_placeholders($rf, $i, $name) } // "";
        next if $f eq "" || $f =~ /__[A-Z0-9-]+__/;
        return 1 unless -e $f;
    }
    return 0;
}

sub write_sample_manifest {
    my ($run_data) = @_;

    my $manifest_path = getdir("out,log") . "/sample_manifest.tsv";
    open my $fh, '>', $manifest_path
        or do { log_message("WARNING: could not write sample manifest [$manifest_path]: $!"); return; };

    print $fh join("\t", "sample_name", "type", "raw_R1_or_SE_or_FASTA", "raw_R2") . "\n";

    for my $sample (@{ $run_data->{samples} }) {
        my $name = $sample->{name} // "";
        my $type = $sample->{type} // "";

        my ($col_r1, $col_r2) = ("", "");

        if ($type eq "PE") {
            $col_r1 = $sample->{paths}{raw}{R1} // "";
            $col_r2 = $sample->{paths}{raw}{R2} // "";
        } elsif ($type eq "SE") {
            $col_r1 = $sample->{paths}{raw}{SE} // "";
        } elsif ($type eq "FASTA") {
            $col_r1 = $sample->{paths}{raw}{FASTA} // "";
        }

        # A merged sample (B28): the lane files it was made from.
        if ( my $src = $sample->{paths}{lane_sources} ) {
            $col_r1 = join( " + ", @{ $src->{R1} // $src->{SE} // [] } );
            $col_r2 = join( " + ", @{ $src->{R2} // [] } );
        }
        print $fh join("\t", $name, $type, $col_r1, $col_r2) . "\n";
    }

    close $fh;
    log_message("INFO: Wrote sample manifest (basename -> raw file mapping) to '$manifest_path'");
    return 1;
}


sub read_fastq_filelist {
    my ($run_data) = @_;

    my $file = getdir("out,log") . "/filelist_fastq.txt";
    open my $fh, '<', $file
        or graceful_die("could not open $file: $!");

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my ($R1, $R2, $base, $tag, @more) = split /\t/, $line, -1;
        unless (defined $base) {
            log_message("WARNING: malformed line -> [$line], skipping");
            next;
        }

        for ($R1, $R2, $base) {
            $_ = "" unless defined $_;
            s/^\s+|\s+$//g;
        }
        # A moved analysis: find the raw files at the data folder's new place
        # (the sample name below is made from the recorded paths, as before).
        my ($R1_rec, $R2_rec) = ($R1, $R2);
        $R1 = resolve_moved_input($R1);
        $R2 = resolve_moved_input($R2);
        @more = map { resolve_moved_input($_) } @more;

        $base = unique_basename($run_data, $base, $R1_rec, $R2_rec) // next;

        my $sample = new_sample_struct($base);

        # Same sample on several lanes (B28): the analysis reads one merged
        # file per read direction, made by merge_lane_files() before the
        # first step runs.
        if ( ( $tag // "" ) eq "merge" ) {
            my @src_R1 = ( $R1, map { $more[ 2 * $_ ] }     0 .. int( @more / 2 ) - 1 );
            my @src_R2 = ( $R2, map { $more[ 2 * $_ + 1 ] } 0 .. int( @more / 2 ) - 1 );
            my @missing = grep { $_ ne "" && !-f $_ } @src_R1, @src_R2;
            if (@missing && is_resume_mode()) {
                # Resume: the sample stays as it was; only steps that need the
                # raw reads again are affected (see plan_read_regeneration).
                push @{ $S_RAW_MISSING{$base} }, @missing;
            }
            elsif (@missing) {
                log_message("WARNING: Sample $base: lane file(s) missing [" . join( ", ", @missing ) . "] -- sample skipped", "red");
                next;
            }
            my $mdir  = getdir("out,large_files,fastq,merged");
            my $is_pe = $R2 ne "";
            $sample->{type} = $is_pe ? "PE" : "SE";
            my %src = $is_pe ? ( R1 => \@src_R1, R2 => \@src_R2 ) : ( SE => \@src_R1 );
            for my $slot ( sort keys %src ) {
                $sample->{paths}{raw}{$slot}          = "$mdir/$base.merged_$slot.fastq.gz";
                $sample->{paths}{lane_sources}{$slot} = $src{$slot};
            }
            $sample->{lanes} = [ map { /_L(\d{3})_R[12]_001\./i ? "L$1" : basename($_) } @src_R1 ];
            for my $slot ( $is_pe ? qw(R1 R2) : qw(SE) ) {
                $sample->{paths}{trimmed}{$slot}     = getdir("out,large_files,fastq,trimmed") . "/$base.t_$slot.fastq.gz";
                $sample->{paths}{downsampled}{$slot} = getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_$slot.fastq.gz";
            }
            if ($is_pe) {
                $sample->{paths}{unpaired}{R1} = getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R1.fastq.gz";
                $sample->{paths}{unpaired}{R2} = getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R2.fastq.gz";
            }
            $run_data->{stats}{ $sample->{type} }++;
            my $idx = @{ $run_data->{samples} };
            push @{ $run_data->{samples} }, $sample;
            $run_data->{sample_index}{$base} = $idx;
            $run_data->{stats}{total}++;
            next;
        }

        my $has_R1 = ($R1 ne "" && -f $R1) ? 1 : 0;
        my $has_R2 = ($R2 ne "" && -f $R2) ? 1 : 0;
        my $R2_given = ($R2 ne "") ? 1 : 0;

        # Resume: the sample keeps the type of the earlier run, also when
        # its raw files cannot be found now -- a missing file must not turn
        # a paired sample into a single-read one, or drop it.
        if (is_resume_mode() && $R1 ne "" && (!$has_R1 || ($R2_given && !$has_R2))) {
            push @{ $S_RAW_MISSING{$base} }, grep { $_ ne "" && !-f $_ } ($R1, $R2);
            ($has_R1, $has_R2) = (1, $R2_given);
        }

        if ($has_R1 && $has_R2) {
            $sample->{type} = "PE";

            $sample->{paths}{raw}{R1} = $R1;
            $sample->{paths}{raw}{R2} = $R2;

            set_raw_file_metadata($sample, "R1", $R1);
            set_raw_file_metadata($sample, "R2", $R2);

            $sample->{paths}{trimmed}{R1} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_R1.fastq.gz";
            $sample->{paths}{trimmed}{R2} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_R2.fastq.gz";

            $sample->{paths}{downsampled}{R1} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_R1.fastq.gz";
            $sample->{paths}{downsampled}{R2} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_R2.fastq.gz";

            $sample->{paths}{unpaired}{R1} =
                getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R1.fastq.gz";
            $sample->{paths}{unpaired}{R2} =
                getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R2.fastq.gz";

            $run_data->{stats}{PE}++;
        }
        elsif ($has_R1 && !$R2_given) {
            $sample->{type} = "SE";

            $sample->{paths}{raw}{SE} = $R1;

            set_raw_file_metadata($sample, "SE", $R1);
            
            $sample->{paths}{trimmed}{SE} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_SE.fastq.gz";
            $sample->{paths}{downsampled}{SE} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_SE.fastq.gz";

            $run_data->{stats}{SE}++;
        }
        elsif ($has_R1 && $R2_given && !$has_R2) {
            log_message("WARNING: Sample $base: R1 exists but R2 is missing [$R2], treating sample as SE", "red");
            $sample->{type} = "SE";

            $sample->{paths}{raw}{SE} = $R1;

            set_raw_file_metadata($sample, "SE", $R1);
            
            $sample->{paths}{trimmed}{SE} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_SE.fastq.gz";
            $sample->{paths}{downsampled}{SE} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_SE.fastq.gz";

            $run_data->{stats}{SE}++;
        }
        else {
            log_message("WARNING: Sample $base: no valid FASTQ files", "red");
            next;
        }

        my $idx = @{ $run_data->{samples} };
        push @{ $run_data->{samples} }, $sample;
        $run_data->{sample_index}{$base} = $idx;
        $run_data->{stats}{total}++;
    }

    close $fh;
}
sub read_fasta_filelist {
    my ($run_data) = @_;

    my $file = getdir("out,log") . "/filelist_fasta.txt";
    open my $fh, '<', $file
        or graceful_die("could not open $file: $!");

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my ($fasta, $base) = split /\t/, $line, 2;
        unless (defined $base) {
            log_message("WARNING: malformed line -> [$line], skipping");
            next;
        }

        for ($fasta, $base) {
            $_ = "" unless defined $_;
            s/^\s+|\s+$//g;
        }

        my $fasta_rec = $fasta;
        $fasta = resolve_moved_input($fasta);
        $base = unique_basename($run_data, $base, $fasta_rec, "") // next;

        if ($fasta ne "" && !-f $fasta && is_resume_mode()) {
            push @{ $S_RAW_MISSING{$base} }, $fasta;
        }
        elsif (!($fasta ne "" && -f $fasta)) {
            log_message("WARNING: Sample $base: FASTA missing [$fasta]", "red");
            next;
        }

        my $sample = new_sample_struct($base);
        $sample->{type} = "FASTA";
        $sample->{paths}{raw}{FASTA} = $fasta;

        set_raw_file_metadata($sample, "FASTA", $fasta);
        
        my $idx = @{ $run_data->{samples} };
        push @{ $run_data->{samples} }, $sample;
        $run_data->{sample_index}{$base} = $idx;

        $run_data->{stats}{FASTA}++;
        $run_data->{stats}{total}++;
    }

    close $fh;
}

sub set_raw_file_metadata {
    my ($sample, $slot, $path) = @_;

    my $meta = get_file_metadata($path);

    $sample->{rawdata_stats}{$slot}{created}  = $meta->{created};
    $sample->{rawdata_stats}{$slot}{modified} = $meta->{modified};
    $sample->{rawdata_stats}{$slot}{filesize} = $meta->{filesize};
}
####################################################################################################

use File::stat;   # NOTE: overrides bare stat() to return an object in scalar context for the rest of this file.
                  # Code below intentionally relies on this (e.g. $st->size, $st->mtime).
                  # Existing list-context stat() calls earlier in this file are unaffected.
                  # strftime is already imported globally at top of file; no need to re-import here.

sub get_file_metadata {
    my ($path) = @_;

    my %meta = (
        created  => "n/a",
        modified => "n/a",
        filesize => "n/a",
    );

    return \%meta unless defined $path && $path ne "" && -e $path;

    my $st = stat($path);
    return \%meta unless $st;

    # filesize in bytes
    $meta{filesize} = $st->size;

    # modification time is always available on normal Unix filesystems
    if (defined $st->mtime && $st->mtime > 0) {
        $meta{modified} = strftime("%Y-%m-%d %H:%M:%S", localtime($st->mtime));
    }

    # Try birth/creation time if available on this Perl/platform
    my $birth_time;
    eval {
        $birth_time = $st->can('birthtime') ? $st->birthtime : undef;
    };

    if (defined $birth_time && $birth_time > 0) {
        $meta{created} = strftime("%Y-%m-%d %H:%M:%S", localtime($birth_time));
    }
    elsif (defined $st->mtime && $st->mtime > 0) {
        # fallback if creation time is unavailable
        $meta{created} = $meta{modified};
    }

    return \%meta;
}



sub unique_basename {
    my ($run_data, $base, $R1, $R2) = @_;

    return $base unless exists $run_data->{sample_index}{$base};

    # The collision can arise in two ways:
    #   (a) Two files in different directories genuinely have the same stem
    #       (recursive scan, e.g. dir1/PT43_R1.fastq.gz + dir2/PT43_R1.fastq.gz).
    #   (b) Two files with different original names map to the same sanitized
    #       stem (e.g. "PT43.3" and "PT43_3" both become "PT43_3" after
    #       sanitize_sample_basename -- the NOTICE from sanitization above
    #       will already explain which files triggered this).
    # In both cases the sample is kept and a unique suffix is appended.
    log_message("WARNING: duplicate sample basename [$base] -- two source files produce the same name "
              . "(check preceding NOTICE lines to see if basename sanitization was involved); renaming...");

    my $counter  = 1;
    my $renamed;
    do {
        $renamed = "${base}_$counter";
        $counter++;
    } while (exists $run_data->{sample_index}{$renamed} && $counter < 100);

    if ($counter >= 100 && exists $run_data->{sample_index}{$renamed}) {
        log_message("ERROR: could not create unique name for [$base] after 100 attempts -- skipping this entry");
        return;
    }

    log_message("NOTICE: [$R1,$R2] basename [$base] renamed to [$renamed] to avoid collision");
    return $renamed;
}



####################################################################################################

####################################################################################################

sub log_progress {
    my ($samplenr, $message) = @_;

    return unless $message;   # no message → no log

    my $base = $R_samples->[$samplenr]->{name} // "";
    my $samplecount = @$R_samples;

    my $number   = $samplenr + 1;
    my $formated = ($samplenr == -1)
        ? "PROGRESS: On all samples: $message"
        : "PROGRESS: Sample $base ($number/$samplecount): $message";

    my $utc_timestamp = timestamp_UTC();  # returns "UTC-time: YYYY-MM-DDTHH:MM:SSZ"

    # put lables into sdterr and stdout 
    system "echo \"[$utc_timestamp] $formated\" >>" . getdir("out,log") . "/stderr.txt";
    system "echo \"[$utc_timestamp] $formated\" >>" . getdir("out,log") . "/stdout.txt";

    
    my $screen_msg = log_message($formated);
    
    return $screen_msg;
}


####################################################################################################


# nearest_bracken_readlength, classify_read_header, parse_machine_aliases:
# moved to the sample_prescan runstep block.


# Instrument models and nicknames: assets/known_instruments.tsv shipped with
# the pipeline, then <db>/known_instruments.tsv (wins). Read once per
# process. Returns { prefix => [ [prefix, model], ... longest first ],
# id => { ID => nickname } }.
our $S_KNOWN_INSTRUMENTS;
sub known_instruments {
    return $S_KNOWN_INSTRUMENTS if $S_KNOWN_INSTRUMENTS;
    my (%pfx, %id);
    for my $f ( find_share_file("assets/known_instruments.tsv"), ( peekdir("db") // "" ) . "/known_instruments.tsv" ) {
        next unless $f && -f $f && open( my $fh, '<', $f );
        while ( my $l = <$fh> ) {   # not $_: callers may have it aliased
            chomp $l; $l =~ s/\r$//;
            next if $l =~ /^\s*(#|$)/;
            my ($kind, $match, $name) = split /\t/, $l;
            next unless defined $name && $match ne "" && $name ne "";
            if    ( lc $kind eq 'prefix' ) { $pfx{ uc $match } = $name; }
            elsif ( lc $kind eq 'id' )     { $id{$match} = $name; }
        }
        close $fh;
    }
    $S_KNOWN_INSTRUMENTS = {
        prefix => [ map { [ $_, $pfx{$_} ] } sort { length($b) <=> length($a) || $a cmp $b } keys %pfx ],
        id     => \%id,
    };
    return $S_KNOWN_INSTRUMENTS;
}

sub guess_illumina_instrument_type {
    my ($instrumentname) = @_;

    return "" if !defined $instrumentname || $instrumentname eq "";
    my $id = uc $instrumentname;
    for my $p ( @{ known_instruments()->{prefix} } ) {
        return $p->[1] if index( $id, $p->[0] ) == 0;
    }
    return "unknown";
}





####################################################################################################

####################################################################################################
## Run banners
##
## The main log (and the tool-output logs) are appended to across runs in
## the same output directory -- a resumed run (overwrite=resume / rerun=)
## continues the same files. Every run therefore starts with a banner that
## stands out and can be searched for:
##
##     grep -n "EURLC-WGS RUN" log/log.txt
##
## lists every start and end, so you can jump from one (re)start to the
## next. The banner shows the run number in this output directory, how the
## run relates to it (new / overwritten / resumed / rerun), and the command
## line exactly as typed.

# ($RUN_BANNER_TAG and $S_RUN_NUMBER are declared near the top of the
# script, next to $S_RUN_MODE -- they are used before execution reaches
# this point.)

sub _shell_quote_arg {
    my ($a) = @_;
    return $a if $a =~ m{^[\w\-./:=,@+%]+$};
    (my $q = $a) =~ s/'/'\\''/g;
    return "'$q'";
}

sub write_run_start_banner {
    my ($logfile) = @_;

    # Run number = earlier start banners in this log + 1.
    my $previous = 0;
    if ( open(my $in, '<', $logfile) ) {
        while (my $l = <$in>) { $previous++ if index($l, "$RUN_BANNER_TAG START") >= 0; }
        close $in;
    }
    $S_RUN_NUMBER = $previous + 1;

    my $mode_text =
        $S_RUN_MODE eq "resumed"     ? "RESUMED in existing output directory -- existing results are reused"
      : $S_RUN_MODE eq "overwritten" ? "NEW (existing output directory was removed first)"
      :                                "NEW";
    my $rerun = $R_cfg->{general}{rerun} // "";
    $mode_text .= "; rerun requested for: $rerun" if $rerun =~ /\S/;

    my $cmd = join(" ", basename($0), map { _shell_quote_arg($_) } @ORIGINAL_ARGV);
    my $line = "#" x 100;

    my @banner = (
        "",
        $line,
        "####  $RUN_BANNER_TAG START  #$S_RUN_NUMBER   " . timestamp_local() . "   (" . ( timestamp_UTC() =~ /UTC/ ? timestamp_UTC() : "UTC " . timestamp_UTC() ) . ")",
        "####  Mode:      $mode_text",
        "####  Command:   $cmd",
        "####  Directory: " . getcwd(),
        "####  User/host: " . ( detect_username() || "?" ) . "@" . ( detect_hostname() || "?" )
            . "   pipeline " . ( $rundata{pipeline_info}{name} // "eurlc-wgs" ) . " " . ( $rundata{pipeline_info}{version} // "" ),
        $line,
        "",
    );
    my $text = join("\n", @banner) . "\n";

    print {$log_fh}      $text;
    print {$log_fh_bash} $text if $log_fh_bash;
    $S_RUN_BANNER_DIR = $S_logdir;   # the END banner goes to the same files
    eval { write_run_status("running", undef) };   # A15: status from the start
    for my $f ( "$S_logdir/stdout.txt", "$S_logdir/stderr.txt" ) {
        if ( open(my $fh, '>>', $f) ) { print {$fh} $text; close $fh; }
    }
}

# End marker, written from the END block (normal exit, errors and Ctrl+C).
# Called from END. The log is normally closed by then (close_logfile runs
# before exit), so the banner is appended to the files directly -- the same
# four files as the START banner, and only if this run wrote one.
sub write_run_end_banner {
    my ($exit_code) = @_;
    return unless defined $S_RUN_BANNER_DIR && -d $S_RUN_BANNER_DIR;
    my $elapsed = time() - ( $rundata{timestamps}{pipeline_start}{time_value} // time() );
    my $status  = $exit_code == 0 ? "finished OK"
                : $exit_code == 3 ? "finished, some samples abandoned"
                : $exit_code == 2 ? "nothing to analyze"
                : $exit_code == 4 ? "interrupted"
                :                   "stopped with an error";
    my $text = "\n####  $RUN_BANNER_TAG END    #$S_RUN_NUMBER   " . timestamp_local()
             . "   exit code $exit_code ($status), elapsed " . format_elapsed($elapsed) . "\n"
             . ( "#" x 100 ) . "\n\n";
    for my $fh ( grep { defined } $log_fh, $log_fh_bash ) { eval { $fh->flush } if $logfile_open; }
    for my $f ( map { "$S_RUN_BANNER_DIR/$_" } qw(log.txt bash_commands.log stdout.txt stderr.txt) ) {
        if ( open( my $out, '>>', $f ) ) { print {$out} $text; close $out; }
    }
}

END {
    my $code = $?;
    if ( defined $MAIN_PID && $$ == $MAIN_PID ) {
        eval { write_run_status( run_state_for_exit($code), $code ) };
        eval { emit_event( type => 'run_finished', exit_code => $code, state => run_state_for_exit($code),
                           result => ( run_state_for_exit($code) eq "finished" ? $S_RUN_RESULT : undef ) ) } if $S_RUN_STATUS_STARTED;
    }
    eval { write_run_end_banner($code) } if defined $MAIN_PID && $$ == $MAIN_PID;
    $? = $code;
}

###################################################################################################
## End-of-run summary. Printed to the screen (and the log, and
## log/run_summary.txt) as the last thing a run does, so the important
## facts -- QC outcome, abandoned samples, every error and warning, tools
## that did not run -- are in one place instead of far up the terminal
## history. Searchable in the log as "EURLC-WGS RUN SUMMARY".

# Command the user can run next: the original arguments without any
# overwrite/resume/rerun/enable flag, plus --resume and the given extras.
sub _suggest_command {
    my (@extra) = @_;
    my @keep = grep { !/^-{0,2}(?:overwrite|resume|rerun|enable)(?:=|$)/ } @ORIGINAL_ARGV;
    return join(" ", basename($0), map { _shell_quote_arg($_) } @keep, "--resume", @extra);
}

sub _issue_group_lines {
    my ($level, $max) = @_;
    my (%n, %first, @order);
    for my $is ( grep { $_->{level} eq $level } @S_RUN_ISSUES ) {
        push @order, $is->{text} unless $n{ $is->{text} }++;
        $first{ $is->{text} } //= $is->{at};
    }
    my @lines;
    for my $txt ( @order[ 0 .. ( $#order < $max - 1 ? $#order : $max - 1 ) ] ) {
        my $t = $txt;
        $t =~ s/\s*\n\s*/ | /g;
        $t = substr($t, 0, 220) . " ..." if length $t > 224;
        push @lines, "    [+$first{$txt}] $t" . ( $n{$txt} > 1 ? "   (x$n{$txt})" : "" );
    }
    push @lines, "    ... and " . ( @order - $max ) . " more -- see the log" if @order > $max;
    return ( scalar( grep { $_->{level} eq $level } @S_RUN_ISSUES ), scalar(@order), @lines );
}

# One line on how well parallel mode used its budget (B24), e.g.
# "threads 71 % of 32, RAM 45 % of 64 GB; dispatch blocked 18 % of the time
# (mostly by spades)". $short leaves out the "Parallel use:" lead.
sub parallel_use_text {
    my ($short) = @_;
    my $u = $rundata{parallel_use} or return "";
    my $t = sprintf( "threads %s %% of %s, RAM %s %% of %s GB; dispatch blocked %s %% of the time",
                     $u->{threads_pct} // "?", $u->{thread_budget}, $u->{ram_pct} // "?", $u->{ram_budget_gb}, $u->{blocked_pct} );
    $t .= " (mostly by $u->{mostly_blocked_by})" if $u->{blocked_pct} > 0 && $u->{mostly_blocked_by};
    return $short ? $t : "Parallel use: $t";
}

sub print_run_summary {
    my ($exit_code) = @_;
    my @out;   # [ text, color ]
    my $add = sub { push @out, [ $_[0], $_[1] // "" ] };
    my $wide = "=" x 100;
    my $samples = $R_samples // [];

    $add->("");
    $add->($wide, "bold");
    $add->("====  $RUN_BANNER_TAG SUMMARY  #$S_RUN_NUMBER   " . timestamp_local()
         . "   elapsed " . format_elapsed( time() - ( $rundata{timestamps}{pipeline_start}{time_value} // time() ) ), "bold");
    $add->($wide, "bold");

    # Samples and QC
    my (%type, %qc, @not_pass, %species);
    for my $s (@$samples) {
        $type{ uc( $s->{type} // "?" ) }++;
        my $q = $s->{report_issues}{summary}{status} // $s->{qc}{status} // "UNKNOWN";
        $qc{$q}++;
        push @not_pass, ( $s->{name} // "?" ) . " ($q)" if $q ne "PASS";
        $species{ $s->{main_results}{taxonomy}{species} // "unknown" }++;
    }
    $add->(sprintf "  %-12s %d  (%s)", "Samples:", scalar(@$samples),
           join(", ", map { "$_ $type{$_}" } sort keys %type));
    my @qc_order = grep { $qc{$_} } ( qw(PASS WARNING CRITICAL FAIL), grep { !/^(PASS|WARNING|CRITICAL|FAIL)$/ } sort keys %qc );
    my $qc_color = ( $qc{FAIL} || $qc{CRITICAL} ) ? "red" : $qc{WARNING} ? "yellow" : "green";
    $add->(sprintf( "  %-12s %s", "QC:", join(", ", map { "$qc{$_} $_" } @qc_order) || "-" ), $qc_color);
    if (@not_pass) {
        my @show = @not_pass > 12 ? ( @not_pass[0..11], "... +" . (@not_pass - 12) . " more" ) : @not_pass;
        $add->(sprintf "  %-12s %s", "", "not PASS: " . join(", ", @show));
    }
    $add->(sprintf "  %-12s %s", "Species:",
           join(", ", map { "$_ ($species{$_})" } sort { $species{$b} <=> $species{$a} || $a cmp $b } keys %species) || "-");
    # Species not determined (review 5.8): the species-specific steps were
    # skipped for these samples without a message of their own.
    {
        my @unknown = map { $_->{name} // "?" }
                      grep { !$_->{fatal_error}
                             && ( $_->{main_results}{taxonomy}{species} // "" ) =~ /^(?:|n\/a|unknown|-)$/i } @$samples;
        if (@unknown) {
            $add->(sprintf( "  %-12s %s", "",
                "species unknown: " . join(", ", @unknown[ 0 .. ( $#unknown < 9 ? $#unknown : 9 ) ]) . ( @unknown > 10 ? ", ..." : "" )
                . " -- species-specific tools and thresholds not used" ), "yellow");
        }
    }

    # Abandoned samples
    my @ab = grep { $_->{fatal_error} } @$samples;
    if (@ab) {
        $add->(sprintf( "  %-12s %d sample(s) could not be finished:", "Abandoned:", scalar @ab ), "red");
        for my $s (@ab) {
            my $why = join("; ", @{ $s->{fatal_error_message} // [] }) || "see the log";
            my $step = $s->{fatal_error_runstep} ? " [$s->{fatal_error_runstep}]" : "";
            $why = substr($why, 0, 200) . " ..." if length $why > 204;
            $add->("    " . ( $s->{name} // "?" ) . "$step: $why", "red");
        }
    }

    # Steps skipped because an earlier step of the sample failed
    {
        my @sk = grep { @{ $_->{skipped_upstream} // [] } } @$samples;
        if (@sk) {
            $add->(sprintf( "  %-12s %s", "Skipped:", scalar(@sk) . " sample(s) had steps skipped because an earlier step failed:" ), "yellow");
            for my $s ( @sk[ 0 .. ( $#sk < 9 ? $#sk : 9 ) ] ) {
                my @n = @{ $s->{skipped_upstream} };
                $add->("    " . ( $s->{name} // "?" ) . ": " . join(", ", @n[ 0 .. ( $#n < 7 ? $#n : 7 ) ]) . ( @n > 8 ? ", ..." : "" ), "yellow");
            }
            $add->("    ... and " . ( @sk - 10 ) . " more -- see the log", "yellow") if @sk > 10;
        }
    }

    # Resume information
    if ( $S_RUN_MODE eq "resumed" ) {
        my $reused = 0;
        $reused += scalar @{ $_->{results}{run_history}{reused_steps} // [] } for @$samples;
        my $rr = $R_cfg->{general}{rerun} // "";
        $add->(sprintf "  %-12s %s", "Resumed:", "run #$S_RUN_NUMBER in this directory; $reused result(s) reused from earlier runs"
               . ( $rr =~ /\S/ ? "; rerun: $rr" : "" ));
    }

    # Errors and warnings
    my ($n_err, $d_err, @err_lines) = _issue_group_lines("ERROR", 10);
    my ($n_warn, $d_warn, @warn_lines) = _issue_group_lines("WARNING", 15);
    $add->(sprintf( "  %-12s %s", "Errors:", $n_err ? "$n_err" . ( $d_err < $n_err ? " ($d_err different)" : "" ) : "none" ),
           $n_err ? "red" : "green");
    $add->($_, "red") for @err_lines;
    $add->(sprintf( "  %-12s %s", "Warnings:", $n_warn ? "$n_warn" . ( $d_warn < $n_warn ? " ($d_warn different)" : "" ) : "none" ),
           $n_warn ? "yellow" : "green");
    $add->($_, "yellow") for @warn_lines;

    # Steps that failed or were skipped on samples whose data had already
    # failed: consequences, not errors (sample_known_data_fail).
    {
        my @ef = grep { @{ $_->{expected_failed_steps} // [] } || @{ $_->{expected_skipped} // [] } } @$samples;
        if (@ef) {
            $add->(sprintf( "  %-12s %s", "Notes:", scalar(@ef) . " sample(s) with data that had already failed (QC FAIL); later steps failed or were skipped as a consequence:" ));
            for my $s ( @ef[ 0 .. ( $#ef < 7 ? $#ef : 7 ) ] ) {
                my @st = ( ( map { $_->{runstep} } @{ $s->{expected_failed_steps} // [] } ),
                           ( map { "$_ (skipped)" } @{ $s->{expected_skipped} // [] } ) );
                $add->( "    " . ( $s->{name} // "?" ) . ": " . join( ", ", @st ) );
            }
            $add->( "    ... +" . ( @ef - 8 ) ) if @ef > 8;
        }
    }

    # Species-specific tools that did not run because they are disabled
    if (@S_TOOLS_NOT_RUN) {
        $add->(sprintf( "  %-12s %s", "Not run:", "species-specific tools that are disabled in the configuration:" ), "yellow");
        my %sections;
        for my $t (@S_TOOLS_NOT_RUN) {
            my @s = @{ $t->{samples} };
            my $list = @s > 8 ? join(", ", @s[0..7]) . ", ... +" . (@s - 8) : join(", ", @s);
            $add->("    [$t->{section}] " . scalar(@s) . " " . join("/", @{ $t->{species} }) . " sample(s): $list", "yellow");
            $sections{ $t->{section} } = 1;
        }
        # one species name per tool covers all of that species' tools
        my %sp; $sp{ $_->{species}[0] } = 1 for @S_TOOLS_NOT_RUN;
        $add->("    to run them now, keeping all other results:");
        $add->("      " . _suggest_command( "enable=" . join(",", sort keys %sp) ));
        $add->("    (or add the species to species_scope in the configuration to always include it)");
    }

    # validation against a validation dataset
    if (%S_VALIDATION) {
        $add->(sprintf( "  %-12s %s: %s", "Validation:", $S_VALIDATION{dataset}, $S_VALIDATION{verdict} ),
               $S_VALIDATION{all_agree} ? "green" : "yellow");
    }
    if (%S_VERIFICATION) {
        $add->(sprintf( "  %-12s %s: %s", "Reference:", $S_VERIFICATION{reference}, $S_VERIFICATION{verdict} ),
               $S_VERIFICATION{same} ? "green" : "yellow");
    }
    if (%S_EFSA_EXPORT) {
        $add->(sprintf( "  %-12s %s", "EFSA export:", $S_EFSA_EXPORT{text} ), $S_EFSA_EXPORT{stopped} ? "yellow" : "green");
    }

    # cgMLST not run: no schema installed for a species that has one
    if (%S_CGMLST_NO_SCHEMA) {
        $add->(sprintf( "  %-12s %s", "No cgMLST:", "no schema installed for these species:" ), "yellow");
        for my $sp (sort keys %S_CGMLST_NO_SCHEMA) {
            my @s = @{ $S_CGMLST_NO_SCHEMA{$sp} };
            my $list = @s > 8 ? join(", ", @s[0..7]) . ", ... +" . (@s - 8) : join(", ", @s);
            $add->("    $sp (" . scalar(@s) . "): $list", "yellow");
            $add->("      install: " . cgmlst_install_hint($sp) . "   then: " . _suggest_command());
        }
    }

    # Where to look
    my $out = eval { abs_path( getdir("out") ) } // "";
    if ( $out ne "" ) {
        my $report = $S_QCSCREEN ? "$out/qcscreen_report.html" : "$out/report/main_report.html";
        $add->(sprintf "  %-12s %s", "Report:", $report) if -f $report;
        $add->(sprintf "  %-12s %s", "Log:", "$out/log/log.txt   (search: \"$RUN_BANNER_TAG\")");
        $add->(sprintf "  %-12s %s", "Parallel:", parallel_use_text(1)) if $rundata{parallel_use};   # B24
    }

    # Verdict
    my $problems = $n_err || @ab || $qc{FAIL};
    my ($verdict, $vcol) =
        $exit_code !~ /^[035]$/ ? ( "STOPPED (exit code $exit_code)", "red" )
      : $problems                          ? ( "FINISHED WITH PROBLEMS -- check the errors / abandoned / FAIL samples above", "red" )
      : ( $n_warn || $qc{WARNING} || $qc{CRITICAL} || @S_TOOLS_NOT_RUN || %S_CGMLST_NO_SCHEMA )
                                           ? ( "FINISHED WITH WARNINGS -- see above", "yellow" )
      :                                      ( "FINISHED OK", "green" );
    $S_RUN_RESULT = $vcol eq "green" ? "ok" : $vcol eq "yellow" ? "warnings" : "problems";
    $add->("  " . ( "-" x 98 ));
    $add->("  RESULT:  $verdict", $vcol);
    $add->($wide, "bold");
    $add->("");

    my $plain = join("", map { "$_->[0]\n" } @out);
    for my $l (@out) {
        my ($txt, $col) = @$l;
        if ( $col ne "" ) { print colorize_for_screen($col), $txt, colorize_for_screen('reset'), "\n"; }
        else              { print "$txt\n"; }
    }
    print {$log_fh} $plain if $logfile_open && $log_fh;
    if ( $out ne "" && open( my $fh, '>', "$out/log/run_summary.txt" ) ) { print {$fh} $plain; close $fh; }
}

###################################################################################################
## QC screen (--qc-screen) -- metrics, verdict, report and JSON status.
##
## The screen runs only sample_prescan, fastp_rawdata and find_species_kraken2
## (see @QCSCREEN_RUNSTEPS). At the end of the run, per sample:
##   qcscreen_prepare_sample  -- trimmed Q30 coverage from fastp's
##       after-filtering totals and the genome size (config, genome size
##       list, or jellyfish), and the largest other genus from the species
##       determination; then the normal QC thresholds are evaluated.
##   qcscreen_sample_status   -- traffic light: worst of the QC thresholds
##       and the runtime issues (FAIL/CRITICAL = red, WARNING = yellow).
## write_qcscreen_outputs writes qcscreen_report.html and qcscreen_status.json
## at the top of the output folder.

sub qcscreen_prepare_sample {
    my ($i) = @_;
    my $s = $R_samples->[$i];

    # Coverage after trimming (fastp output, i.e. before any downsampling)
    my $after = $s->{results}{fastp_rawdata}{summary}{after_filtering};
    my $gs    = $s->{estimated_genomesize} // 0;
    if ( $after && $gs =~ /^\d+(?:\.\d+)?$/ && $gs > 0 ) {
        $s->{main_results}{coverage}{trimmed}{coverage}     = safe_quota( $after->{total_bases}, $gs, "n/a" );
        $s->{main_results}{coverage}{trimmed}{q30_coverage} = safe_quota( $after->{q30_bases},   $gs, "n/a" );
    }

    # Largest other genus, from the species determination (100 000 reads)
    my $tax = $s->{main_results}{taxonomy} // {};
    my ($g, $p) = largest_other_genus( $s->{results}{find_species_kraken2} // {}, $tax->{genus}, $tax->{species} );
    $s->{main_results}{contamination}{genus}        = $g;
    $s->{main_results}{contamination}{genus_level}  = $p;
    $s->{main_results}{contamination}{genus_method} = "Kraken2/Bracken (species determination subset)";

    if ( ( $tax->{species} // "n/a" ) =~ /^(n\/a|)$/ ) {
        set_runtime_issue($i, "warning", "Species could not be determined");
    }
}

# BEGIN: this file-scope table sits after the main program, which has
# already run before a plain assignment here would execute.
my %_QCSCREEN_RANK;
BEGIN { %_QCSCREEN_RANK = ( PASS => 0, WARNING => 1, CRITICAL => 2, FAIL => 3 ); }

sub qcscreen_sample_status {
    my ($s) = @_;
    my $status = $s->{report_issues}{summary}{status} // "PASS";
    $status = "PASS" unless exists $_QCSCREEN_RANK{$status};
    my @msgs;
    for my $lvl (qw(fail critical warning)) {
        push @msgs, @{ $s->{report_issues}{summary}{issues}{$lvl} // [] };
        my @rt = @{ $s->{runtime_issues}{issues}{$lvl} // [] };
        push @msgs, @rt;
        my $L = uc $lvl;
        $status = $L if @rt && $_QCSCREEN_RANK{$L} > $_QCSCREEN_RANK{$status};
    }
    if ( $s->{fatal_error} ) {
        $status = "FAIL";
        push @msgs, @{ $s->{fatal_error_message} // [] };
    }
    my %seen;
    @msgs = grep { defined $_ && $_ ne "" && !$seen{$_}++ } @msgs;
    return ( $status, \@msgs );
}

sub _qcs_light { my ($st) = @_; return $st eq "PASS" ? "green" : $st eq "WARNING" ? "yellow" : "red"; }

sub _qcs_num {
    my ($v, $fmt) = @_;
    return "&ndash;" if !defined $v || $v eq "" || $v !~ /^-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?$/;
    return sprintf($fmt // "%.1f", $v);
}

# One table cell, coloured by the QC status of a measure.
sub _qcs_cell {
    my ($s, $measure, $text, $kind) = @_;
    my $st = $measure ? ( $s->{qc_checks}{$measure}{status} // "NOT_EVALUATED" ) : "NOT_EVALUATED";
    my $cls = " class=\"num" . ( $st eq "NOT_EVALUATED" ? "" : " m-" . lc( _qcs_light($st) ) ) . "\"";
    my $tip = $measure ? encode_entities( $s->{qc_checks}{$measure}{message} // "" ) : "";
    $cls =~ s/num ?// if ( $kind // "" ) eq "text";
    return "<td$cls" . ( $tip ne "" ? " title=\"$tip\"" : "" ) . ">$text</td>";
}

# Adapter-content curve per sample: share of scanned reads (R1+R2) whose
# first adapter hit starts at or before each position.
sub _qcs_adapter_curve {
    my ($s) = @_;
    my $ps = $s->{results}{fastq_prescan} or return;
    my (%hist, $checked, $maxlen, $files);
    for my $b (qw(R1 R2)) {
        my $bk = $ps->{$b} or next;
        next unless $bk->{adapters_checked};
        $files++;
        $checked += $bk->{adapters_checked} // 0;
        $hist{$_} += $bk->{adapter_pos_hist}{$_} for keys %{ $bk->{adapter_pos_hist} // {} };
        my $ml = $bk->{max_length} // $bk->{longest} // 0;
        $maxlen = $ml if !$maxlen || $ml > $maxlen;
    }
    return unless $checked && $maxlen;
    my ($cum, @pts) = (0);
    for my $pos ( 1 .. $maxlen ) {
        $cum += $hist{$pos} // 0;
        push @pts, [ $pos, 100 * $cum / $checked ];
    }
    return { points => \@pts, maxlen => $maxlen, checked => $checked, per_file => int( $checked / ( $files || 1 ) ) };
}

sub _qcs_adapter_svg {
    my (@series) = @_;   # [ name, curve ]
    @series = grep { $_->[1] } @series;
    return "<p class=\"muted\">No adapter scan data available.</p>" unless @series;
    my ( $W, $H, $L, $R, $T, $B ) = ( 860, 280, 52, 16, 14, 40 );
    my $xmax = 0; my $ymax = 10;
    for my $se (@series) {
        $xmax = $se->[1]{maxlen} if $se->[1]{maxlen} > $xmax;
        my $last = $se->[1]{points}[-1][1];
        $ymax = $last if $last > $ymax;
    }
    $ymax = $ymax <= 10 ? 10 : $ymax <= 25 ? 25 : $ymax <= 50 ? 50 : 100;
    my $px = sub { $L + ( $_[0] - 1 ) / ( $xmax > 1 ? $xmax - 1 : 1 ) * ( $W - $L - $R ) };
    my $py = sub { $T + ( 1 - $_[0] / $ymax ) * ( $H - $T - $B ) };
    my @pal = map { "#$_" } qw(2a6fdb e8710a 1e9e6a c2185b 7b4fd6 8d6e00 00838f d84315 5d6d7e 9e9d24);
    my $svg = "<svg viewBox=\"0 0 $W $H\" class=\"chart\" role=\"img\" aria-label=\"Adapter content by read position\">";
    for my $k ( 0 .. 4 ) {
        my $yv = $ymax * $k / 4; my $y = sprintf("%.1f", $py->($yv));
        $svg .= "<line x1=\"$L\" x2=\"" . ( $W - $R ) . "\" y1=\"$y\" y2=\"$y\" class=\"grid\"/>"
              . "<text x=\"" . ( $L - 6 ) . "\" y=\"" . ( $y + 4 ) . "\" class=\"ax\" text-anchor=\"end\">" . ( $yv == int $yv ? $yv : sprintf("%.1f", $yv) ) . "%</text>";
    }
    my $step = $xmax > 200 ? 50 : $xmax > 100 ? 25 : 10;
    for ( my $x = $step; $x <= $xmax; $x += $step ) {
        $svg .= "<text x=\"" . sprintf("%.1f", $px->($x)) . "\" y=\"" . ( $H - $B + 16 ) . "\" class=\"ax\" text-anchor=\"middle\">$x</text>";
    }
    $svg .= "<text x=\"" . ( ( $W + $L ) / 2 ) . "\" y=\"" . ( $H - 6 ) . "\" class=\"ax\" text-anchor=\"middle\">Position in read (bp)</text>";
    my $n = 0;
    for my $se (@series) {
        my ($name, $c) = @$se;
        my $col = $pal[ $n++ % @pal ];
        my $d = join(" ", map { sprintf("%s%.1f,%.1f", ( $_ == 0 ? "M" : "L" ), $px->( $c->{points}[$_][0] ), $py->( $c->{points}[$_][1] )) } 0 .. $#{ $c->{points} });
        my $tip = encode_entities($name) . sprintf(": %.1f%% of reads contain adapter (first %d reads per file)", $c->{points}[-1][1], $c->{per_file});
        $svg .= "<path d=\"$d\" fill=\"none\" stroke=\"$col\" stroke-width=\"1.8\"><title>$tip</title></path>";
        $se->[2] = $col;
    }
    $svg .= "</svg><div class=\"legend\">"
          . join("", map { "<span><i style=\"background:$_->[2]\"></i>" . encode_entities($_->[0]) . "</span>" } @series)
          . "</div>";
    return $svg;
}

sub write_qcscreen_outputs {
    my ($exit_code) = @_;
    my $out = getdir("out");
    my @rows; my %count = ( green => 0, yellow => 0, red => 0 );
    my ( %instr, %runs, %flow, $cycles, $tot_reads, $tot_bases, $tot_q30, @dates );
    my @json_samples; my @curves;

    for my $i ( 0 .. $#$R_samples ) {
        my $s   = $R_samples->[$i];
        my $mr  = $s->{main_results} // {};
        my ($st, $msgs) = qcscreen_sample_status($s);
        my $light = _qcs_light($st);
        $count{$light}++;

        my $rd = $mr->{run_data} // {};
        $instr{ $rd->{instrument} . ( ( $rd->{machine_alias} // "n/a" ) ne "n/a" && $rd->{machine_alias} ne $rd->{instrument} ? " ($rd->{machine_alias})" : "" ) }++
            if ( $rd->{instrument} // "n/a" ) ne "n/a" && $rd->{instrument} ne "";
        $runs{ $rd->{run_number} }++ if ( $rd->{run_number} // "" ) =~ /\S/ && $rd->{run_number} ne "n/a";
        $flow{ $rd->{flowcell} }++   if ( $rd->{flowcell}   // "" ) =~ /\S/ && $rd->{flowcell}   ne "n/a";
        my $longest = $mr->{qscore}{raw}{longest_read_len};
        $cycles = $longest if defined $longest && $longest =~ /^\d+$/ && ( !$cycles || $longest > $cycles );
        my $before = $s->{results}{fastp_rawdata}{summary}{before_filtering} // {};
        my $after  = $s->{results}{fastp_rawdata}{summary}{after_filtering}  // {};
        $tot_reads += $before->{total_reads} // 0;
        $tot_bases += $before->{total_bases} // 0;
        $tot_q30   += $before->{q30_bases}   // 0;
        my $d = normalize_date_to_ymd( $s->{rawdata_stats}{R1}{created} // $s->{rawdata_stats}{SE}{created} );
        push @dates, $d if $d;

        my $tax     = $mr->{taxonomy} // {};
        my $species = $tax->{species} // "n/a";
        my $sp_html = $species eq "n/a" || $species eq ""
            ? "<span class=\"muted\">not determined</span>"
            : "<em>" . encode_entities($species) . "</em> <span class=\"muted\">" . _qcs_num( $tax->{species_score}, "%d" ) . "%</span>";
        my $cg = $mr->{contamination}{genus} // "n/a";
        my $other_html = $cg eq "n/a" ? "&ndash;"
            : encode_entities($cg) . " " . _qcs_num( $mr->{contamination}{genus_level}, "%.2f" ) . "%";
        my $gs_method = $s->{estimated_genomesize_method} // "";
        my $gs_src = $gs_method =~ /^provided/ ? "config" : $gs_method =~ /^typical/ ? "list" : $gs_method =~ /k-mer/ ? "k-mer est." : $gs_method =~ /fallback/ ? "default" : "";
        my $gs_html = _qcs_num( ( $s->{estimated_genomesize} // 0 ) / 1e6, "%.2f" ) . ( $gs_src ne "" ? " <span class=\"tag\" title=\"" . encode_entities($gs_method) . "\">$gs_src</span>" : "" );
        my $q30mb = defined $after->{q30_bases} ? _qcs_num( $after->{q30_bases} / 1e6, "%.0f" ) : "&ndash;";

        # Remarks go on their own line under the sample (keeps the table narrow)
        my $remarks = @$msgs
            ? "<tr class=\"remarks row-$light\"><td></td><td colspan=\"9\"><ul>"
              . join("", map { "<li>" . encode_entities($_) . "</li>" } @$msgs[ 0 .. ( $#$msgs < 4 ? $#$msgs : 4 ) ])
              . ( @$msgs > 5 ? "<li class=\"muted\">+" . ( @$msgs - 5 ) . " more (see the log)</li>" : "" )
              . "</ul></td></tr>"
            : "";

        push @rows, "<tr class=\"row-$light\">"
            . "<td><span class=\"light $light\" aria-hidden=\"true\"></span><span class=\"st\">" . ( $st eq "PASS" ? "OK" : $st ) . "</span></td>"
            . "<td class=\"name\">" . encode_entities( $s->{name} // "?" ) . "</td>"
            . "<td>$sp_html</td>"
            . _qcs_cell( $s, "contamination_genus_level", $other_html, "text" )
            . "<td class=\"num\">$q30mb</td>"
            . "<td class=\"num\">$gs_html</td>"
            . _qcs_cell( $s, "coverage_trimmed_q30_coverage", _qcs_num( $mr->{coverage}{trimmed}{q30_coverage}, "%.0f" ) . "&times;" )
            . _qcs_cell( $s, "qscore_trimmed_average_read_length", _qcs_num( $mr->{qscore}{trimmed}{av_read_len}, "%.0f" ) )
            . _qcs_cell( $s, "qscore_trimmed_too_short_pct", _qcs_num( $mr->{qscore}{trimmed}{too_short_pct} ) )
            . _qcs_cell( $s, "qscore_raw_adapter_trimmed_pct", _qcs_num( $mr->{qscore}{raw}{adapter_trimmed_pct} ) )
            . "</tr>" . $remarks;

        push @curves, [ $s->{name} // "?", _qcs_adapter_curve($s) ];
        push @json_samples, {
            name                => $s->{name},
            status              => $st,
            light               => $light,
            species             => $species,
            species_score       => $tax->{species_score},
            other_genus         => $cg,
            other_genus_pct     => $mr->{contamination}{genus_level},
            q30_bases_trimmed   => $after->{q30_bases},
            genome_size         => $s->{estimated_genomesize},
            genome_size_method  => $gs_method,
            q30_coverage        => $mr->{coverage}{trimmed}{q30_coverage},
            mean_read_length    => $mr->{qscore}{trimmed}{av_read_len},
            too_short_pct       => $mr->{qscore}{trimmed}{too_short_pct},
            adapter_pct         => $mr->{qscore}{raw}{adapter_trimmed_pct},
            insert_size_peak    => $mr->{qscore}{raw}{insert_size_peak},
            issues              => $msgs,
        };
    }

    my $overall = $count{red} ? "red" : $count{yellow} ? "yellow" : "green";
    $overall = "red" if $exit_code !~ /^[035]$/;   # 3, 5: finished (A15)
    my $n = scalar @$R_samples;
    my $headline =
        $overall eq "green"  ? "All $n samples passed the QC screen"
      : $overall eq "yellow" ? "$count{yellow} of $n samples have warnings &ndash; ask a bioinformatician to assess them"
      :                        ( $count{red} || "Some" ) . " of $n samples did not pass &ndash; contact a bioinformatician before continuing";

    my $ri    = $rundata{illuminafiles}{runinfo}{run} // {};
    my $date  = $ri->{date} || ( sort @dates )[0] || "&ndash;";
    my $join  = sub { my $h = shift; my @k = sort keys %$h; @k ? encode_entities( join(", ", @k) ) : "&ndash;" };
    my $q30pct = $tot_bases ? sprintf("%.1f %%", 100 * $tot_q30 / $tot_bases) : "&ndash;";
    my $runname = encode_entities( basename( peekdir("in") // "" ) );
    my $generated = get_datetime_for_report();

    my $html = <<"HTML";
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>QC screen &ndash; $runname</title>
<style>
:root{--ink:#1d2430;--muted:#6b7480;--line:#e3e6ea;--bg:#f6f7f9;--card:#fff;--green:#1e9e5a;--yellow:#e0a100;--red:#d23b3b;
--g-bg:#e8f6ee;--y-bg:#fdf5dd;--r-bg:#fbe7e7}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
header{background:#24303f;color:#fff;padding:18px 28px}header h1{margin:0;font-size:20px;font-weight:600}
header .sub{color:#c6ced8;font-size:13px;margin-top:2px}
