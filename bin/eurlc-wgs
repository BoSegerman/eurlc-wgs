    # fastqc binary already tested by fastqc_rawdata (shared tests_performed key)
    return 2 if exists $tests_performed{fastqc};
    $tests_performed{fastqc} = 1;
    return check_conda_tool("fastqc");
};

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_fastqc_trimmed_data;

sub preprocess_fastqc_trimmed_data {
    my ($samplenr) = @_;
    my $runstep_name = "fastqc_trimmed_data";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # applies_if already gates on enabled and FASTA.
    # TD files are guaranteed by requires => trimmed_downsampled_fastq.

    my $outdir = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr);

    # Already-done check (extend mode)
    if ($sample_type eq "PE") {
        my $r1_zip = "$outdir/${sample_name}_R1_fastqc.zip";
        my $r2_zip = "$outdir/${sample_name}_R2_fastqc.zip";
        if (-s $r1_zip && -s $r2_zip) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_fastqc_trimmed_data($samplenr);
            return "";
        }
    } elsif ($sample_type eq "SE") {
        my $se_zip = "$outdir/${sample_name}_SE_fastqc.zip";
        if (-s $se_zip) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_fastqc_trimmed_data($samplenr);
            return "";
        }
    }

    my $command = $runstep{$runstep_name}{cmd_template}{$sample_type};
    _fill_placeholders__safe_replace(\$command, "__FASTQCENV__", $R_cfg->{fastqc}{env});
    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir($outdir);
    return $command;
}

# POST---------------------------------
$runstep{$runstep_name}{result_parsing} = \&postprocess_fastqc_trimmed_data;

sub postprocess_fastqc_trimmed_data {
    my ($samplenr) = @_;
    my $runstep_name = "fastqc_trimmed_data";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $outdir = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);

    if ($sample_type eq "PE") {
        my $r1_base = "$outdir/${sample_name}_R1_fastqc";
        my $r2_base = "$outdir/${sample_name}_R2_fastqc";

        unless (-s "$r1_base.zip" && -s "$r2_base.zip") {
            log_message("WARNING: FastQC trimmed results missing for sample [$sample_name]", "yellow");
            return 0;
        }

        my $result_ref_R1 = parse_fastqc_results2("$r1_base.zip");
        unless (defined $result_ref_R1) {
            log_message("WARNING: FastQC trimmed R1 could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{R1} = $result_ref_R1;

        my $result_ref_R2 = parse_fastqc_results2("$r2_base.zip");
        unless (defined $result_ref_R2) {
            log_message("WARNING: FastQC trimmed R2 could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{R2} = $result_ref_R2;

        register_raw_output($samplenr, $runstep_name,
            title => "FastQC trimmed report R1 (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$r1_base.html"),
        );
        register_raw_output($samplenr, $runstep_name,
            title => "FastQC trimmed report R2 (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$r2_base.html"),
        );

        log_message("NOTICE:=========== FastQC trimmed R1 ===================", "green");
        _log_fastqc_results_trimmed($result_ref_R1);
        log_message("NOTICE:=========== FastQC trimmed R2 ===================", "green");
        _log_fastqc_results_trimmed($result_ref_R2);
    }
    elsif ($sample_type eq "SE") {
        my $se_base = "$outdir/${sample_name}_SE_fastqc";

        unless (-s "$se_base.zip") {
            log_message("WARNING: FastQC trimmed result missing for sample [$sample_name]", "yellow");
            return 0;
        }
        my $result_ref_SE = parse_fastqc_results2("$se_base.zip");
        unless (defined $result_ref_SE) {
            log_message("WARNING: FastQC trimmed could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{SE} = $result_ref_SE;
        register_raw_output($samplenr, $runstep_name,
            title => "FastQC trimmed report (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$se_base.html"),
        );
        log_message("NOTICE:=========== FastQC trimmed ===================", "green");
        _log_fastqc_results_trimmed($result_ref_SE);
    }

    return 1;
}

# Log FastQC results for trimmed+downsampled data.
# Unlike rawdata, certain modules are expected to PASS after trimming --
# a WARN or FAIL here may indicate a real problem worth flagging.
sub _log_fastqc_results_trimmed {
    my ($fastqc_data) = @_;

    my @module_names  = @{ $fastqc_data->{modules}{entries}  // [] };
    my @adapter_names = @{ $fastqc_data->{adapters}{entries} // [] };

    for my $module (@module_names) {
        my $status   = $fastqc_data->{modules}{$module}{status} // "NA";
        my $ucstatus = uc($status);
        my $color    = $ucstatus eq 'PASS' ? 'green' : 'yellow';
        my $note     = "";

        # After trimming these results should be better -- flag if not
        if ($module eq 'Adapter Content' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note  = " (WARNING: adapters still present after fastp trimming)";
            $color = "red";
        } elsif ($module eq 'Per base sequence quality' && $ucstatus eq 'FAIL') {
            $note  = " (low base quality remaining after trimming)";
            $color = "red";
        } elsif ($module eq 'Per sequence quality scores' && $ucstatus eq 'FAIL') {
            $note  = " (low quality reads remaining after trimming)";
            $color = "red";
        }
        # These are still acceptable on trimmed data (not actionable)
        elsif ($module eq 'Per base sequence content' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note  = " (normal -- head-bias from library prep, not adapter)";
        } elsif ($module eq 'Sequence Duplication Levels' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note  = " (expected at high coverage of small bacterial genomes)";
        }

        log_message(sprintf("NOTICE: %-35s : %-10s%s", $module, $status, $note), $color);
    }

    log_message(sprintf("NOTICE: %-35s : %-10s", "Sequences",       $fastqc_data->{sequences} // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "Bases",           $fastqc_data->{bases}     // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "Sequence length", $fastqc_data->{seqlen}    // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "GC content (%)",  $fastqc_data->{gc}        // "NA"));

    for my $adapter (@adapter_names) {
        my $value   = $fastqc_data->{adapters}{$adapter} // 0;
        my $int_val = int($value);
        if ($int_val >= 1) {
            my $color = $int_val >= 5 ? "red" : "yellow";
            log_message(sprintf("NOTICE: %-35s : %-10s", $adapter, "$int_val%"), $color);
        }
    }
}

##   $R_samples->[$samplenr]{results}{fastqc_trimmed_data}{R1}  -- parsed FastQC data R1
##   $R_samples->[$samplenr]{results}{fastqc_trimmed_data}{R2}  -- parsed FastQC data R2
##   $R_samples->[$samplenr]{results}{fastqc_trimmed_data}{SE}  -- parsed FastQC data SE


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep kraken2

$runstep_name = "Kraken2";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 8 },

      message    => "Running Kraken2...",
      long_name  => "Kraken2",
      output_dir => "__DIR-QC2__/Kraken2",
      resultfile => "__DIR-QC2__/Kraken2/__BASE__.kraken2.txt",
      resultfiles_status => "NA",

      # requires prescan_done: reads bracken_readlength (set by sample_prescan),
      # same as find_species_kraken2.
      #
      # requires trimmed_downsampled_fastq: in sequential mode the list ordering
      # guaranteed downsampling ran before Kraken2 contamination. In parallel mode
      # there is no such guarantee -- without this key, the scheduler dispatches
      # Kraken2 as soon as prescan_done is satisfied, while downsampling may still
      # be running for that sample. Samples processed early (PT43-3, PT43-6) happen
      # to have their downsampling complete in time; the last sample (PT43-7) does
      # not, causing Kraken2 to run against missing input files and mark itself done
      # permanently. trimmed_downsampled_fastq is vacuously TRUE for FASTA samples
      # (no TD files exist for already-assembled input; preprocessing handles FASTA
      # via a separate code path).
      #
      # WARNING: this runstep previously had two separate `requires` entries in its
      # hash (the original ['prescan_done'] and a later-inserted
      # ['prescan_done', 'trimmed_downsampled_fastq']). In Perl, duplicate hash keys
      # silently discard all but the last -- so the trimmed_downsampled_fastq
      # requirement was invisible for months. If you add a new requires here, verify
      # there is exactly ONE requires entry in this hash.
      requires   => [ 'prescan_done', 'trimmed_downsampled_fastq' ],
      produces   => [ 'kraken2_contamination_done' ],
      applies_if => sub { return $R_cfg->{kraken2}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/__BASE__.kraken2.txt 
       --threads __THREADS__ 
       --db __KRAKENDB__
       --paired '__R1TD__' '__R2TD__'
       > __OUTDIR__/__BASE__.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py
       -r __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.krona_input
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText
       __OUTDIR__/__BASE__.krona_input
       -o __OUTDIR__/__BASE__.krona_kraken2.html
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
     __NEWCOMMAND__
     rm __OUTDIR__/__BASE__.krakenout.txt
     __NEWCOMMAND__
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py
       -r __OUTDIR__/__BASE__.kraken2_bracken_species.txt
       -o __OUTDIR__/__BASE__.bracken_species_krona_input
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText
       __OUTDIR__/__BASE__.bracken_species_krona_input
       -o __OUTDIR__/__BASE__.krona_bracken_species.html
       __HIDE-OUTPUT__
        __NEWCOMMAND__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2
       --report __OUTDIR__/__BASE__.kraken2.txt
       --threads __THREADS__
       --db __KRAKENDB__
       '__SETD__'
       > __OUTDIR__/__BASE__.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py
       -r __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.krona_input
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText
       __OUTDIR__/__BASE__.krona_input
       -o __OUTDIR__/__BASE__.krona_kraken2.html
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/__BASE__.kraken2.txt
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
    __NEWCOMMAND__
       rm __OUTDIR__/__BASE__.krakenout.txt
        __NEWCOMMAND__
    conda run -n $R_cfg->{krakentools}->{env} --no-capture-output kreport2krona.py
       -r __OUTDIR__/__BASE__.kraken2_bracken_species.txt
       -o __OUTDIR__/__BASE__.bracken_species_krona_input
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{krona}->{env} --no-capture-output ktImportText
       __OUTDIR__/__BASE__.bracken_species_krona_input
       -o __OUTDIR__/__BASE__.krona_bracken_species.html
       __HIDE-OUTPUT__
        __NEWCOMMAND__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2
       --report __OUTDIR__/__BASE__.kraken2.txt
       --threads __THREADS__
       --db __KRAKENDB__
       __FASTA__
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
       __NEWCOMMAND__
       rm __OUTDIR__/tmp.krakenout.txt
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_kraken2;

sub test_kraken2 {

  

   if(exists $tests_performed{kraken2}  ) {
      return 2; 
   }

   $tests_performed{kraken2} = 1;

    my $testresult = "";
    
    $testresult = check_conda_tool("kraken2");
    $testresult = check_conda_tool("bracken");
    $testresult = check_conda_tool("krakentools");
    $testresult = check_conda_tool("krona");
    return 1;
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_kraken2;

sub preprocess_kraken2 {

    my ($samplenr) = @_;

    my $runstep_name = "Kraken2";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};  
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   

    ###################################
    ### check essential requirements
    

 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__R1TD__", "__R2TD__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__SETD__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__FASTA__");
    }
    


     if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_kraken2($samplenr);
        return "";
    }  

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
                  
    # runstep specific replacements
    
    my $readlen = $R_samples->[$samplenr]{bracken_readlength} // "150";
    _fill_placeholders__safe_replace(\$command, "__READLEN__", $readlen);
    
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_kraken2;

sub postprocess_kraken2 {
    my ($samplenr) = @_;

    my $runstep_name = "Kraken2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);



    #######################################
    # parse results

    my $bracken_resultfile       = fill_placeholders("__OUTDIR__/__BASE__.bracken",       $samplenr, $runstep_name);
    my $bracken_resultfile_genus = fill_placeholders("__OUTDIR__/__BASE__.genus.bracken", $samplenr, $runstep_name);
    
    if (-f $bracken_resultfile) {
        my $bracken_results_ref = parse_bracken_results($bracken_resultfile, 'S');
        $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species} = $bracken_results_ref;
        if (!$bracken_results_ref || !%{$bracken_results_ref}) {
        log_message("WARNING: bracken-species data could not be parsed for sample $sample_name" );
      }
    }
    else {
        if ($sample_type ne "FASTA") {
            log_message("WARNING: No bracken resultfile (species level) found for sample $sample_name");
        }
    }

    if (-f $bracken_resultfile_genus) {
        my $bracken_results_ref_genus = parse_bracken_results($bracken_resultfile_genus, 'G');
        $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus} = $bracken_results_ref_genus;
        if (!$bracken_results_ref_genus || !%{$bracken_results_ref_genus}) {
           log_message("WARNING: bracken-genus data could not be parsed for sample $sample_name" );
        }
    }
    else {
        if ($sample_type ne "FASTA") {
            log_message("WARNING: No bracken resultfile (genus level) found for sample $sample_name");
        }
    }

    if (-f $resultfile) {
        my $kraken_results_ref = parse_kraken2_results($resultfile);
        $R_samples->[$samplenr]{results}{$runstep_name}{kraken2} = $kraken_results_ref;
        if (!$kraken_results_ref || !%{$kraken_results_ref}) {
           log_message("WARNING: kraken data could not be parsed for sample $sample_name" );
        }   
    }
    else {
        log_message("WARNING: No kraken2 resultfile found for sample $sample_name");
        return 0;
    }


    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "Kraken2 contamination report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2.txt",$samplenr, $runstep_name)),
    );

    register_raw_output($samplenr, $runstep_name,
        title => "Kraken2 Bracken species report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2_bracken_species.txt",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Kraken2 Bracken genus report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2_bracken_genuses.txt",$samplenr, $runstep_name)),
    );

    register_raw_output($samplenr, $runstep_name,
        title => "Bracken re-estimated species abundances",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.bracken",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Bracken re-estimated genus abundances",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.genus.bracken",$samplenr, $runstep_name)),
    );

    register_raw_output($samplenr, $runstep_name,
        title => "Krona chart (Kraken2 reads)",
        type  => "html",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.krona_kraken2.html",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Krona chart (Bracken species)",
        type  => "html",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.krona_bracken_species.html",$samplenr, $runstep_name)),
    ); 


    #######################################
    # remember pre-check taxonomy before deciding whether to update it

    my $precheck_species       = $R_samples->[$samplenr]{main_results}{taxonomy}{species}       // "n/a";
    my $precheck_species_score = $R_samples->[$samplenr]{main_results}{taxonomy}{species_score} // 0;
    my $precheck_genus         = $R_samples->[$samplenr]{main_results}{taxonomy}{genus}         // "n/a";
    my $precheck_genus_score   = $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}   // 0;

    #######################################
    # assign final genus call, with bracken -> kraken2 fallback

    my $genus_method         = "bracken";
    my $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{name}    // "n/a";
    my $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{percent} // 0;
    my $percent_int          = int($genus_result_percent);

    if ($genus_result eq "n/a") {
        $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{name}    // "n/a";
        $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{percent} // 0;
        $percent_int          = int($genus_result_percent);
        $genus_method         = "kraken2";
    }

    if ($genus_result eq "n/a") {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{genus_warnings} },
            "Final Kraken2/bracken analysis failed to determine genus";
        set_sample_warning($samplenr,"critical","Failed to determine genus");    
    }

    if ($precheck_genus ne "n/a" && $genus_result ne "n/a" && $genus_result ne $precheck_genus) {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{genus_warnings} },
            "Final Kraken2/bracken genus does not match pre-check genus";
        set_sample_warning($samplenr,"critical","Final Kraken2/bracken genus does not match pre-check genus");
    }

    if ($genus_result ne "n/a" && $percent_int > $precheck_genus_score) {
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus}        = $genus_result;
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}  = $percent_int;
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} = $genus_method;
    }

    #######################################
    # assign final species call, with bracken -> kraken2 fallback

    my $species_method         = "bracken";
    my $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{name}    // "n/a";
    my $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{percent} // 0;
    $percent_int               = int($species_result_percent);

    if ($species_result eq "n/a") {
        $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{name}    // "n/a";
        $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{percent} // 0;
        $percent_int            = int($species_result_percent);
        $species_method         = "kraken2";
    }

    if ($species_result eq "n/a") {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Final Kraken2/bracken analysis failed to determine species";
        set_sample_warning($samplenr,"warning","Failed to determine species");      
    }

    if ($precheck_species ne "n/a" && $species_result ne "n/a" && $species_result ne $precheck_species) {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Final Kraken2/bracken species does not match pre-check species";
        set_sample_warning($samplenr,"warning","Final Kraken2/bracken species does not match pre-check genus");    
    }

    if ($species_result ne "n/a" && $genus_result ne "n/a") {
        my ($species_genus) = split /\s+/, $species_result;
        if (!defined $species_genus || lc($species_genus) ne lc($genus_result)) {
            push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
                "Final Kraken2/bracken genus does not match species";
            log_message("WARNING: Sample $sample_name: Species [$species_result] and Genus [$genus_result] do not match", "red");
            set_sample_warning($samplenr,"critical","Final Kraken2/bracken species [$species_result] and genus [$genus_result] do not match");
        }
    }

    if ($species_result ne "n/a" && $percent_int > $precheck_species_score) {
        $R_samples->[$samplenr]{main_results}{taxonomy}{species}        = $species_result;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}  = $percent_int;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = $species_method;
    }

    #######################################
    # contamination check: genus level
    # use second-ranked entry, with bracken -> kraken2 fallback

    my $genus2_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[1]{name}    // "n/a";
    my $genus2_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[1]{percent} // 0;

    if ($genus2_result eq "n/a") {
        $genus2_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[1]{name}    // "n/a";
        $genus2_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[1]{percent} // 0;
    }

    my $color = "green";
    if ($genus2_result_percent > 5) { $color = "yellow"; }

    log_message(
        "NOTICE: Sample $sample_name: Largest contamination signal (genus level): $genus2_result ($genus2_result_percent%)",
        $color
    );

    $R_samples->[$samplenr]{main_results}{contamination}{genus}       = $genus2_result;
    $R_samples->[$samplenr]{main_results}{contamination}{genus_level} = $genus2_result_percent;
    $R_samples->[$samplenr]{main_results}{contamination}{genus_method} = "Kraken2";

    #######################################
    # contamination check: species level
    # start from second-ranked entry, with bracken -> kraken2 fallback
    # then skip configured cross-reactive species

    my @species_hits;
    my $species_hits_method = "bracken";

    if (exists $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}
        && ref($R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}) eq 'ARRAY'
        && @{ $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries} } > 0) {

        @species_hits = @{ $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries} };
    }
    else {
        $species_hits_method = "kraken2";
        @species_hits = @{ $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species} // [] };
    }

    my %crossreactive_species = ();
    if ($species_result ne "n/a" && exists $R_cfg->{species}{$species_result}{crossreactive_species}) {
        my $cross = $R_cfg->{species}{$species_result}{crossreactive_species} // "";
        foreach my $name (split /\s*,\s*/, $cross) {
            next if !defined $name || $name eq "";
            $crossreactive_species{lc $name} = 1;
        }
    }

    my $species_result2         = "n/a";
    my $species_result2_percent = 0;

    for (my $i = 1; $i < @species_hits; $i++) {
        my $candidate_name    = $species_hits[$i]{name}    // "n/a";
        my $candidate_percent = $species_hits[$i]{percent} // 0;

        next if $candidate_name eq "n/a";

        # skip same as main species
        next if lc($candidate_name) eq lc($species_result);

        # skip configured cross-reactive species
        next if exists $crossreactive_species{lc $candidate_name};

        # skip generic "Genus sp." style candidate for same genus
        if ($genus_result ne "n/a" && $candidate_name =~ /^\Q$genus_result\E\s+sp\./i) {
            next;
        }

        $species_result2         = $candidate_name;
        $species_result2_percent = $candidate_percent;
        last;
    }

    $color = "green";
    if ($species_result2_percent > 2) { $color = "yellow"; }
    if ($species_result2_percent > 5) { $color = "red"; }

    log_message(
        "NOTICE: Sample $sample_name: Largest contamination signal (species level): $species_result2 ($species_result2_percent%) [$species_hits_method]",
        $color
    );

    $R_samples->[$samplenr]{main_results}{contamination}{species}       = $species_result2;
    $R_samples->[$samplenr]{main_results}{contamination}{species_level}        = $species_result2_percent;
    $R_samples->[$samplenr]{main_results}{contamination}{species_method}  = $species_hits_method;

    #######################################
    # summary logging of final top call

    log_message(
        "NOTICE: Sample $sample_name: Final genus call: $genus_result ($genus_result_percent%) [$genus_method]",
        "green"
    );
    log_message(
        "NOTICE: Sample $sample_name: Final species call: $species_result ($species_result_percent%) [$species_method]",
        "green"
    );

    return 1;
}





 
