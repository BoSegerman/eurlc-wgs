#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep sistr
##
## SISTR (sistr_cmd) on the main assembly: serovar from antigen genes,
## cross-checked with a cgMLST-330 prediction. With --qc (default
## arguments) it also reports qc_status PASS/WARNING/FAIL.
##
## results.sistr.serotype is set only when qc_status is not FAIL, so that
## select_main_serotype falls back to SeqSero2 when SISTR fails -- the
## same order as the SVA Salmonella pipeline. The raw serovar is always
## kept in results.sistr.serovar.

$runstep_name = "sistr";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running SISTR...",
      long_name  => "SISTR (Salmonella serotyping)",
      output_dir => "__DIR-TYPING__/sistr",
      resultfile => "__DIR-TYPING__/sistr/__BASE__.sistr.json",
      resultfiles_status => "NA",

      group      => 'serotyping',
      species    => config_species_list('sistr'),   # from [sistr] species
      requires   => [ 'main_assembly_present', 'kraken2_settled' ],
      produces   => [ 'sistr_done' ],
      applies_if => sub { return $R_cfg->{sistr}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{sistr}->{env} --no-capture-output sistr
       -i '__DIR-ASSEMBLIES__/__BASE__.fasta' '__BASE__'
       -f json
       -o '__OUTDIR__/__BASE__.sistr.json'
       -t __THREADS__
       -T '__OUTDIR__/__BASE__.tmp'
       $R_cfg->{sistr}->{arguments}
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -rf '__OUTDIR__/__BASE__.tmp'
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_sistr;

sub test_sistr {
    return check_conda_tool("sistr");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_sistr;

sub preprocess_sistr {

    my ($samplenr) = @_;

    my $runstep_name = "sistr";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $command    = $runstep{$runstep_name}{cmd_template};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_sistr($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_sistr;

sub postprocess_sistr {
    my ($samplenr) = @_;

    my $runstep_name = "sistr";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    my $r = parse_sistr($resultfile, $samplenr);
    unless ($r) {
        log_message("WARNING: Sample $sample_name: SISTR produced no usable result [$resultfile]", "red");
        return 0;   # results.sistr left unset -> sistr_done stays false; select_main_serotype falls back
    }

    my $qc = uc($r->{qc_status} // "n/a");
    $r->{status} = "done";

    # Serotype candidate from the configured field (see [sistr] serovar_field).
    my $field = $R_cfg->{sistr}{serovar_field} // "serovar";
    $field = "serovar" unless exists $r->{$field};
    my $candidate = $r->{$field};

    # Reasons not to use SISTR's answer -> select_main_serotype falls back
    # to SeqSero2. Recorded in results.sistr.not_used_reason.
    my %use_if = map { uc($_) => 1 } grep { /\S/ } split /[,\s]+/, ( $R_cfg->{sistr}{use_if_qc} // "PASS" );
    my @not_used;
    push @not_used, "QC status $qc" unless $use_if{$qc};
    push @not_used, "no serovar called" if $candidate eq "n/a" || $candidate =~ /^[\s\-:]*$/;
    # Monophasic Typhimurium: cgMLST places it in Typhimurium, but without
    # the second-phase flagellin (h2 "-") the serotype is really
    # I 4,[5],12:i:- -- SeqSero2 resolves that better (rule from the SVA
    # Salmonella pipeline).
    if ( ( $r->{serovar_cgmlst} =~ /^Typhimurium$/i || $candidate =~ /^Typhimurium$/i ) && $r->{h2} eq "-" ) {
        push @not_used, "Typhimurium without h2 antigen (possible monophasic variant)";
    }
    $r->{serotype}        = @not_used ? "n/a" : $candidate;
    $r->{serotype_field}  = $field;
    $r->{not_used_reason} = join("; ", @not_used);
    $R_samples->[$samplenr]{results}{$runstep_name} = $r;

    if (@not_used) {
        log_message("NOTICE: Sample $sample_name: SISTR serotype not used (" . $r->{not_used_reason} . ")", "yellow");
    }
    if ( $r->{cgmlst_subspecies} ne "n/a" && lc($r->{cgmlst_subspecies}) ne "enterica" ) {
        my $msg = "SISTR: subspecies is $r->{cgmlst_subspecies}, not enterica";
        log_message("WARNING: Sample $sample_name: $msg", "red");
        set_sample_warning($samplenr, "warning", $msg);
    }

    my $color = $qc eq "PASS" ? "green" : "yellow";
    log_message("NOTICE: Sample $sample_name: SISTR serovar: $r->{serovar} "
              . "(antigen: $r->{serovar_antigen}, cgMLST: $r->{serovar_cgmlst}) "
              . "serogroup $r->{serogroup}, $r->{o_antigen}:$r->{h1}:$r->{h2} [QC $qc]", $color);

    if ($qc eq "FAIL" || $qc eq "WARNING") {
        my $msg = "SISTR QC $qc" . ( $r->{qc_messages} ne "" ? ": $r->{qc_messages}" : "" );
        log_message("WARNING: Sample $sample_name: $msg", "red");
        set_sample_warning($samplenr, "warning", $msg);
    }

    register_raw_output($samplenr, $runstep_name,
        title => "SISTR results (JSON)",
        type  => "txt",
        path  => path_relative_to_outdir($resultfile),
    );

    return 1;
}

# PARSER---------------------------------

# sistr -f json writes a JSON array with one object per genome. Returns a
# flat hashref of the fields we use (missing -> "n/a"), or undef.
sub parse_sistr {
    my ($resultfile, $samplenr) = @_;

    return undef unless -s $resultfile;
    my $data = read_json_file($resultfile);
    my $row  = ( ref $data eq 'ARRAY' ) ? $data->[0]
             : ( ref $data eq 'HASH'  ) ? $data
             : undef;
    return undef unless ref $row eq 'HASH';

    my %r;
    for my $f (qw(serovar serovar_antigen serovar_cgmlst serogroup antigenic_formula
                  o_antigen h1 h2 cgmlst_ST cgmlst_subspecies cgmlst_found_loci
                  cgmlst_matching_alleles cgmlst_distance cgmlst_genome_match qc_status)) {
        my $v = $row->{$f};
        $r{$f} = ( defined $v && $v ne "" ) ? $v : "n/a";
    }
    $r{qc_messages} = $row->{qc_messages} // "";
    $r{qc_messages} =~ s/\s*\|\s*/; /g;
    $r{serovar_antigen} =~ s/\|/, /g;   # e.g. "Typhimurium|Lagos" -> several candidates
    return \%r;
}

######
## example sistr -f json output (one genome)
# [{ "genome": "LT2", "serovar": "Typhimurium", "serovar_antigen": "Typhimurium",
#    "serovar_cgmlst": "Typhimurium", "serogroup": "B", "o_antigen": "1,4,[5],12",
#    "h1": "i", "h2": "1,2", "cgmlst_ST": 660408169, "cgmlst_subspecies": "enterica",
#    "cgmlst_matching_alleles": 327, "cgmlst_distance": 0.009, "cgmlst_genome_match": "LT2",
#    "qc_status": "PASS", "qc_messages": "" }]


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep seqsero2
##
## SeqSero2 on the main assembly (-t 4 = assembly input, -m k = k-mer
## mode), as in the SVA Salmonella pipeline. Its working directory is
## removed afterwards; the result table and log are kept as
## typing/seqsero2/<sample>.seqsero2.{tsv,log}.
##
## results.seqsero2.serotype is the "Predicted serotype" unless SeqSero2
## could not call one (N/A, empty). The antigenic formula is kept
## separately. Monophasic Typhimurium is reported with its standard name
## I 4,[5],12:i:- (searchable and internationally comparable).

$runstep_name = "seqsero2";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running SeqSero2...",
      long_name  => "SeqSero2 (Salmonella serotyping)",
      output_dir => "__DIR-TYPING__/seqsero2",
      resultfile => "__DIR-TYPING__/seqsero2/__BASE__.seqsero2.tsv",
      resultfiles_status => "NA",

      group      => 'serotyping',
      species    => config_species_list('seqsero2'),   # from [seqsero2] species
      requires   => [ 'main_assembly_present', 'kraken2_settled' ],
      produces   => [ 'seqsero2_done' ],
      applies_if => sub { return $R_cfg->{seqsero2}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    rm -rf '__OUTDIR__/__BASE__'
    __NEWCOMMAND__
    conda run -n $R_cfg->{seqsero2}->{env} --no-capture-output SeqSero2_package.py
       -m k -t 4
       -p __THREADS__
       -i '__DIR-ASSEMBLIES__/__BASE__.fasta'
       -n '__BASE__'
       -d '__OUTDIR__/__BASE__'
       $R_cfg->{seqsero2}->{arguments}
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    cp '__OUTDIR__/__BASE__/SeqSero_log.txt' '__OUTDIR__/__BASE__.seqsero2.log' 2>/dev/null
    __NEWCOMMAND__
    cp '__OUTDIR__/__BASE__/SeqSero_result.tsv' '__OUTDIR__/__BASE__.seqsero2.tsv'
    __NEWCOMMAND__
    rm -rf '__OUTDIR__/__BASE__'
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_seqsero2;

sub test_seqsero2 {
    return check_conda_tool("seqsero2");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_seqsero2;

sub preprocess_seqsero2 {

    my ($samplenr) = @_;

    my $runstep_name = "seqsero2";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $command    = $runstep{$runstep_name}{cmd_template};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_seqsero2($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_seqsero2;

sub postprocess_seqsero2 {
    my ($samplenr) = @_;

    my $runstep_name = "seqsero2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    my $r = parse_seqsero2($resultfile);
    unless ($r) {
        log_message("WARNING: Sample $sample_name: SeqSero2 produced no usable result [$resultfile]", "red");
        return 0;   # results.seqsero2 left unset -> seqsero2_done stays false
    }

    $r->{status}   = "done";
    $r->{serotype} = ( $r->{predicted_serotype} =~ /^\s*(n\/a|na|-)?\s*$/i || $r->{predicted_serotype} =~ /^N\/A/i )
                   ? "n/a" : $r->{predicted_serotype};
    $r->{monophasic_typhimurium} = ( $r->{serotype} =~ /^I 4,\[5\],12:i:-$/ ) ? "yes" : "no";

    # Notes: informative ones (config accepted_notes) do not warn.
    my %accepted = map { my $n = lc $_; $n =~ s/^\s+|\s+$//g; $n =~ s/\.$//; ($n => 1) }
                   split /\|/, ( $R_cfg->{seqsero2}{accepted_notes} // "" );
    (my $note_norm = lc $r->{note}) =~ s/^\s+|\s+$//g;
    $note_norm =~ s/\.$//;
    $r->{note_status} = ( $note_norm eq "" || $accepted{$note_norm} ) ? "PASS" : "WARNING";

    $R_samples->[$samplenr]{results}{$runstep_name} = $r;

    my $color = $r->{note_status} eq "PASS" ? "green" : "yellow";
    log_message("NOTICE: Sample $sample_name: SeqSero2 serotype: $r->{serotype} "
              . "(antigenic profile $r->{antigenic_profile})"
              . ( $r->{note} ne "" ? " -- $r->{note}" : "" ), $color);
    if ($r->{note_status} ne "PASS") {
        my $msg = "SeqSero2 note: $r->{note}";
        log_message("WARNING: Sample $sample_name: $msg", "red");
        set_sample_warning($samplenr, "warning", $msg);
    }

    register_raw_output($samplenr, $runstep_name,
        title => "SeqSero2 results",
        type  => "tsv",
        path  => path_relative_to_outdir($resultfile),
    );
    my $logfile = fill_placeholders("__DIR-TYPING__/seqsero2/__BASE__.seqsero2.log", $samplenr);
    if (-f $logfile) {
        register_raw_output($samplenr, $runstep_name, title => "SeqSero2 log", type => "txt",
                            path => path_relative_to_outdir($logfile));
    }

    return 1;
}

# PARSER---------------------------------

# SeqSero_result.tsv: one header line + one result line. Columns are found
# by header name (falls back to the SeqSero2 1.x positions used by the SVA
# pipeline: 7 antigenic profile, 8 serotype, 9 note). Returns undef if the
# file is missing/empty.
sub parse_seqsero2 {
    my ($resultfile) = @_;
    return undef unless -s $resultfile;

    open(my $fh, '<', $resultfile) or return undef;
    my $header = <$fh>;
    my $line   = <$fh>;
    close $fh;
    return undef unless defined $header && defined $line;
    chomp($header, $line);
    $header =~ s/\r//g; $line =~ s/\r//g;

    my @h = split /\t/, $header;
    my @v = split /\t/, $line, -1;
    my %col;
    for my $i (0 .. $#h) { $col{ lc $h[$i] } = $i; }

    my $get = sub {
        my ($name, $fallback) = @_;
        my $i = exists $col{ lc $name } ? $col{ lc $name } : $fallback;
        my $x = ( defined $i && defined $v[$i] ) ? $v[$i] : "";
        $x =~ s/^\s+|\s+$//g;
        return $x;
    };

    my %r = (
        o_antigen          => $get->("O antigen prediction", 3),
        h1_antigen         => $get->("H1 antigen prediction(fliC)", 4),
        h2_antigen         => $get->("H2 antigen prediction(fljB)", 5),
        identification     => $get->("Predicted identification", 6),
        antigenic_profile  => $get->("Predicted antigenic profile", 7),
        predicted_serotype => $get->("Predicted serotype", 8),
        note               => $get->("Note", 9),
    );
    $r{$_} = "n/a" for grep { $r{$_} eq "" && $_ ne "note" } keys %r;
    return \%r;
}

######
## example SeqSero_result.tsv (columns, tab separated)
# Sample name  Output directory  Input files  O antigen prediction  H1 antigen prediction(fliC)
# H2 antigen prediction(fljB)  Predicted identification  Predicted antigenic profile
# Predicted serotype  Note
# 15A  ...  15A.fasta  4  i  1,2  Salmonella enterica subspecies enterica (subspecies I)
# 4:i:1,2  Typhimurium  ...


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep ectyper
##
## ECTyper (phac-nml) on the main assembly: E. coli O:H serotype, and with
## --pathotype (default arguments) also pathotype (STEC, EPEC, ...) and Shiga
## toxin subtypes. Output table: typing/ectyper/<sample>.ectyper.tsv.
##
## Shigella: Kraken2 often cannot separate Shigella from E. coli, so the step
## also runs for Shigella samples. ECTyper's O/H antigens are defined for
## E. coli; when the sample's taxonomy says Shigella the serotype is kept in
## results.ectyper but not used as the main serotype (not_used_reason).
## With --verify (optional, see [ectyper]) ECTyper does its own species check
## and reports non-E. coli genomes as "WARNING (WRONG SPECIES)".

$runstep_name = "ectyper";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running ECTyper...",
      long_name  => "ECTyper (E. coli serotyping)",
      output_dir => "__DIR-TYPING__/ectyper",
      resultfile => "__DIR-TYPING__/ectyper/__BASE__.ectyper.tsv",
      resultfiles_status => "NA",

      group      => 'serotyping',
      species    => config_species_list('ectyper'),   # from [ectyper] species
      requires   => [ 'main_assembly_present', 'kraken2_settled' ],
      produces   => [ 'ectyper_done' ],
      applies_if => sub { return $R_cfg->{ectyper}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    rm -rf '__OUTDIR__/__BASE__'
    __NEWCOMMAND__
    conda run -n $R_cfg->{ectyper}->{env} --no-capture-output ectyper
       -i '__DIR-ASSEMBLIES__/__BASE__.fasta'
       -o '__OUTDIR__/__BASE__'
       -c __THREADS__
       $R_cfg->{ectyper}->{arguments}
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    cp '__OUTDIR__/__BASE__/ectyper.log' '__OUTDIR__/__BASE__.ectyper.log' 2>/dev/null
    __NEWCOMMAND__
    cp '__OUTDIR__/__BASE__/output.tsv' '__OUTDIR__/__BASE__.ectyper.tsv'
    __NEWCOMMAND__
    rm -rf '__OUTDIR__/__BASE__'
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_ectyper;

sub test_ectyper {
    return check_conda_tool("ectyper");
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_ectyper;

sub preprocess_ectyper {

    my ($samplenr) = @_;

    my $runstep_name = "ectyper";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $command    = $runstep{$runstep_name}{cmd_template};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_ectyper($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_ectyper;

sub postprocess_ectyper {
    my ($samplenr) = @_;

    my $runstep_name = "ectyper";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    my $r = parse_ectyper($resultfile);
    unless ($r) {
        log_message("WARNING: Sample $sample_name: ECTyper produced no usable result [$resultfile]", "red");
        return 0;
    }
    $r->{status} = "done";

    # Is the serotype usable as the main serotype?
    my @not_used;
    my $qc = $r->{qc};
    push @not_used, "QC $qc" if $qc =~ /FAIL|WRONG SPECIES/i;
    push @not_used, "no O or H antigen typed" if $r->{serotype_raw} =~ /^[\s\-:]*$/ || $r->{serotype_raw} eq "n/a";
    my $genus = lc( $R_samples->[$samplenr]{main_results}{taxonomy}{genus} // "" );
    my $tax_species = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";
    if ( $genus eq "shigella" || $tax_species =~ /^Shigella\b/i ) {
        push @not_used, "sample identified as Shigella -- ECTyper O:H types are defined for E. coli";
    }
    $r->{serotype}        = @not_used ? "n/a" : $r->{serotype_raw};
    $r->{not_used_reason} = join("; ", @not_used);
    $R_samples->[$samplenr]{results}{$runstep_name} = $r;

    my $color = $qc =~ /^PASS/i ? "green" : "yellow";
    log_message("NOTICE: Sample $sample_name: ECTyper serotype: $r->{serotype_raw} [QC $qc]"
              . ( $r->{pathotype} ne "n/a" ? ", pathotype: $r->{pathotype}" : "" )
              . ( $r->{stx_subtypes} ne "n/a" && $r->{stx_subtypes} ne "-" ? ", stx: $r->{stx_subtypes}" : "" ), $color);
    log_message("NOTICE: Sample $sample_name: ECTyper serotype not used (" . $r->{not_used_reason} . ")", "yellow") if @not_used;

    if ( $qc !~ /^PASS/i && $qc ne "n/a" && $qc ne "-" ) {
        my $msg = "ECTyper QC: $qc" . ( $r->{warnings} ne "" && $r->{warnings} ne "-" ? " ($r->{warnings})" : "" );
        log_message("WARNING: Sample $sample_name: $msg", "red");
        set_sample_warning($samplenr, "warning", $msg);
    }

    register_raw_output($samplenr, $runstep_name,
        title => "ECTyper results",
        type  => "tsv",
        path  => path_relative_to_outdir($resultfile),
    );

    return 1;
}

# PARSER---------------------------------

# output.tsv: header + one row per genome. Columns found by name, so extra
# columns (--pathotype, --verify) are optional. Returns undef if no row.
sub parse_ectyper {
    my ($resultfile) = @_;
    my $row = read_tsv_first_row($resultfile) or return undef;

    my $get = sub {
        for my $name (@_) {
            my $v = $row->{ lc $name };
            if (defined $v) { $v =~ s/^\s+|\s+$//g; return $v eq "" ? "n/a" : $v; }
        }
        return "n/a";
    };

    return {
        species        => $get->("Species"),
        o_type         => $get->("O-type"),
        h_type         => $get->("H-type"),
        serotype_raw   => $get->("Serotype"),
        qc             => $get->("QC"),
        evidence       => $get->("Evidence"),
        database       => $get->("DatabaseVer", "Database"),
        warnings       => $get->("Warnings"),
        pathotype      => $get->("Pathotype"),
        pathotype_genes => $get->("PathotypeGenes", "PathotypeGeneNames"),
        stx_subtypes   => $get->("StxSubtypes"),
        species_mash_top => $get->("SpeciesMashTopID"),
    };
}

######
## example output.tsv (selected columns)
# Name    Species           O-type  H-type  Serotype  QC                 Evidence               Pathotype  StxSubtypes
# 15-520  Escherichia coli  O157    H7      O157:H7   PASS (REPORTABLE)  Based on 3 allele(s)   EHEC-STEC  stx1a;stx2c


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep lissero
##
## LisSero (MDU-PHL) on the main assembly: molecular serogroup of Listeria
## monocytogenes from the presence of prs, lmo0737, lmo1118, ORF2110 and
## ORF2819 (the PCR serogrouping scheme, done in silico). LisSero writes its
## table to stdout; it is saved as typing/lissero/<sample>.lissero.tsv.
## "Nontypable" (only prs found, often 4a/4c) is kept as the reported value
## but is not used as the main serotype.

$runstep_name = "lissero";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Running LisSero...",
      long_name  => "LisSero (Listeria serogrouping)",
      output_dir => "__DIR-TYPING__/lissero",
      resultfile => "__DIR-TYPING__/lissero/__BASE__.lissero.tsv",
      resultfiles_status => "NA",

      group      => 'serotyping',
      species    => config_species_list('lissero'),   # from [lissero] species
      requires   => [ 'main_assembly_present', 'kraken2_settled' ],
      produces   => [ 'lissero_done' ],
      applies_if => sub { return $R_cfg->{lissero}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

# Written to a temporary name and renamed only on success, so a failed run
# does not leave a result file behind that would be "already done" next time.
$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{lissero}->{env} --no-capture-output lissero
       $R_cfg->{lissero}->{arguments}
       '__DIR-ASSEMBLIES__/__BASE__.fasta'
       > '__OUTDIR__/__BASE__.lissero.tsv.part'
       __HIDE-STDERR__
    && mv '__OUTDIR__/__BASE__.lissero.tsv.part' '__OUTDIR__/__BASE__.lissero.tsv'
CMD

