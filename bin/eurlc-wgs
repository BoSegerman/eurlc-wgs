## runstep fastmlst

## DEPRECATED -- update_fastmlst_db and its three subs below (test/pre/post)
## are kept but never wired into the run order. PubMLST closed unauthenticated
## schema updates, so this no longer achieves a real update in practice --
## it currently runs harmlessly but pointlessly. Not removed: the
## conda-env/db-age-checking logic here is likely reusable the day this is
## reworked to authenticate with user-supplied PubMLST login credentials
## (a real feature, just not prioritized for this version). Do not wire
## this back into any runstep list as-is.

$runstep_name = "update_fastmlst_db";

$runstep{$runstep_name} = {
      requires   => ['main_assembly_present'],
      message    => "Updating fastmlst db...",
      long_name  => "Updating fastmlst db",
      output_dir => "",
      resultfile => "",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------



