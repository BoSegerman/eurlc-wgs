    sistr => {
            # SISTR (sistr_cmd): Salmonella serovar prediction from the
            # assembly (antigen genes + cgMLST-330). Runs only for Salmonella
            # samples.
            # NOTE: on first use sistr_cmd downloads its own database (from
            # Zenodo) -- needs network once, not yet covered by db_freeze.
