#  ],
#  data => [
#    {
#      file => "20C002",
#      EXC  => 738,
#      INF  => 184,
#      PLOT3 => 0,
#      ...
#      Total_CDSs => 1813,
#      alleles => ["78", "15", "195", "140", ...],
#      source_contig => ["NODE_19_length_25634_cov_18.932132", ...],
#      source_from   => [13133, ...],
