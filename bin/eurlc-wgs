        $R_samples->[$i]{main_results}{contamination}{mixed_windows},        #"mixed_windows",
        $R_samples->[$i]{main_results}{contamination}{mixed_windows_pct},    #"mixed_windows_pct",
        $R_samples->[$i]{main_results}{contamination}{mixed_minoraf_median}, #"mixed_minoraf_median",
        $R_samples->[$i]{results}{bakta}{annotation}{cdss}, #"CDSs",                        
        $R_samples->[$i]{main_results}{mlst}{st}, #"ST",           
        $R_samples->[$i]{main_results}{mlst}{cc}, #"CC",  
