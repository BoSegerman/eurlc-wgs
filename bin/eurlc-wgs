####################################################################################################

sub parse_fastqc_results(){

  my $fastqc_path = shift(@_);
  my $fastqcfile1_basename = shift(@_);
  my $fastqcfile2_basename = shift(@_);  
  my $prefix = shift(@_);
    
    my $fastqcfile1 = get_fastqc_filename($fastqcfile1_basename ); 
    my $fastqcfile2 = get_fastqc_filename($fastqcfile2_basename );
            
    parse_fastqc_results_readfile("$fastqc_path/$fastqcfile1.zip", $fastqcfile1, $prefix . ".R1");
    parse_fastqc_results_readfile("$fastqc_path/$fastqcfile2.zip", $fastqcfile2, $prefix . ".R2");
  
}


####################################################################################################

sub get_fastqc_filename {
    my ($fastqfile) = @_;

    # Replace common fastq suffixes with "_fastqc"
    $fastqfile =~ s/\.(fastq|fq)(\.gz)?$/_fastqc/;

    return $fastqfile;
}

####################################################################################################
sub parse_fastqc_results_readfile(){

  my $path = shift(@_);
  my $basename = shift(@_);
  my $prefix = shift(@_);

  my @adaptercontent = (0,0,0,0,0,0);


   if( -f $path ){
      my $fh;
      open( $fh, "-|", "unzip -p $path $basename/fastqc_data.txt") or graceful_die("Cannot open zipped file: $path $basename/fastqc_data.txt");
      
      my $captureadaptertype=0;
      
      while (my $line = <$fh>) {
         chomp($line);
         if($line =~ /^>>Basic Statistics/ ){ push @{ $result_summary{$prefix . ".status.BasicStatistics"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Per base sequence quality/ ){ push @{ $result_summary{$prefix . ".status.PerBaseSequenceQuality"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Per tile sequence quality/ ){ push @{ $result_summary{$prefix . ".status.PerTileSequenceQuality"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Per sequence quality scores/ ){ push @{ $result_summary{$prefix . ".status.PerSequenceQuality"} }, (split /\t/,$line)[1]  }         
         if($line =~ /^>>Per sequence GC content/ ){ push @{ $result_summary{$prefix . ".status.GCcontent"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Per base N content/ ){ push @{ $result_summary{$prefix . ".status.Ncontent"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Sequence Length Distribution/ ){ push @{ $result_summary{$prefix . ".status.LengthDistribution"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Overrepresented sequences/ ){ push @{ $result_summary{$prefix . ".status.OverrepresentedSequences"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Per base sequence content/ ){ push @{ $result_summary{$prefix . ".status.PerBaseSequenceContent"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Sequence Duplication Levels/ ){ push @{ $result_summary{$prefix . ".status.SequenceDuplicationLevel"} }, (split /\t/,$line)[1]  }
         if($line =~ /^>>Adapter Content/ ){ push @{ $result_summary{$prefix . ".status.AdapterContent"} }, (split /\t/,$line)[1]  ; $captureadaptertype=1;}

         if($line =~ /^>>END_MODULE/ ){  $captureadaptertype=0;}
         
         if ($captureadaptertype == 1) {
           next if( $line =~ /^#/);
           next if( $line =~ /^>>/);
           my @columns = split(/\t/, $line);

           for my $i (1..6) {
             next unless defined $columns[$i];  # skip if column missing
             if ($columns[$i] > $adaptercontent[$i-1]) {
              $adaptercontent[$i-1] = $columns[$i];
             }
           }
          }
      }
      close($fh);
      
      push @{ $result_summary{$prefix . ".IlluminaUniversalAdapter"} } , $adaptercontent[0] ;
      push @{ $result_summary{$prefix . ".IlluminaSmallRNA3Adapter"} } , $adaptercontent[1] ;
      push @{ $result_summary{$prefix . ".IlluminaSmallRNA5Adapter"} } , $adaptercontent[2] ;
      push @{ $result_summary{$prefix . ".NexteraTransposaseSequence"} } , $adaptercontent[3] ;
      push @{ $result_summary{$prefix . ".PolyA"} } , $adaptercontent[4] ;
      push @{ $result_summary{$prefix . ".PolyG"} } , $adaptercontent[5] ;

    } # end if file
    else{
    push @{ $result_summary{$prefix . ".status.BasicStatistics"} }, "NA";
push @{ $result_summary{$prefix . ".status.PerBaseSequenceQuality"} }, "NA";
push @{ $result_summary{$prefix . ".status.PerTileSequenceQuality"} }, "NA";
push @{ $result_summary{$prefix . ".status.PerSequenceQuality"} }, "NA";         
push @{ $result_summary{$prefix . ".status.GCcontent"} }, "NA";
push @{ $result_summary{$prefix . ".status.Ncontent"} }, "NA";
push @{ $result_summary{$prefix . ".status.LengthDistribution"} }, "NA";
push @{ $result_summary{$prefix . ".status.OverrepresentedSequences"} }, "NA";
push @{ $result_summary{$prefix . ".status.PerBaseSequenceContent"} }, "NA";
push @{ $result_summary{$prefix . ".status.SequenceDuplicationLevel"} }, "NA";
push @{ $result_summary{$prefix . ".status.AdapterContent"} }, "NA";     
push @{ $result_summary{$prefix . ".IlluminaUniversalAdapter"} } , "NA";
push @{ $result_summary{$prefix . ".IlluminaSmallRNA3Adapter"} } , "NA";
push @{ $result_summary{$prefix . ".IlluminaSmallRNA5Adapter"} } , "NA";
push @{ $result_summary{$prefix . ".NexteraTransposaseSequence"} } , "NA";
push @{ $result_summary{$prefix . ".PolyA"} } , "NA";
push @{ $result_summary{$prefix . ".PolyG"} } , "NA";
    }
}

####################################################################################################

sub read_json(){

  my $path = shift(@_);

  # Read the file contents
  open my $fh, '<', $path or return ();
    my $json_text = do { local $/; <$fh> };
  close $fh;

  # Decode JSON string to Perl data structure
  my $data = decode_json($json_text);

  return $data; 

}
####################################################################################################

sub print_to_summary(){

open(HANDLE_QCSUMMARY,">" . getdir("out,results,qc") . "/qc_summary.tab") || graceful_die("could not create file " . getdir("out,results,qc") . "/qc_summary.tab");
 
  my $counter = 0;


  
  foreach my $line (sort( keys %result_summary) )   {  

  $counter++;
  
  if($counter == 1){
  
    print HANDLE_QCSUMMARY "QC-meassure\t";
  
    for(my $i=0;$i< @$R_samples; $i++ ){
     
       print HANDLE_QCSUMMARY $R_samples->[$i]{name};
       if($i<@$R_samples-1){
         print HANDLE_QCSUMMARY "\t";
       }
       else{
          print HANDLE_QCSUMMARY "\n";
       }
    }
  
  }


   my @data = @{ $result_summary{$line} };
  
   print HANDLE_QCSUMMARY "$line\t";
  
   for(my $i=0;$i< @data; $i++ ){
     print HANDLE_QCSUMMARY $data[$i];
       if($i<@data-1){
         print HANDLE_QCSUMMARY "\t";
       }
       else{
          print HANDLE_QCSUMMARY "\n";
       }
   }
   


  } # end foreach line
  close(HANDLE_QCSUMMARY);

}

