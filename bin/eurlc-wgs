## runstep shovill

$runstep_name = "shovill";

$runstep{$runstep_name} = {
      message    => "Running Shovill...",
      long_name  => "Shovill",
      output_dir => "__DIR-ALTERNATIVE-ASSEMBLIES__/Shovill",
      resultfile => "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.shovill.fasta",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------




$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{shovill}->{env} --no-capture-output shovill 
       --R1 '__R1TD__' 
       --R2 '__R2TD__' 
       --cpus __THREADS__ 
       $R_cfg->{shovill}->{arguments} 
       --outdir __OUTDIR__/__BASE__ 
       >> __DIR-LOG__/shovill_logs.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/contigs.fa __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.shovill.fasta
CMD


$runstep{$runstep_name}{cmd_template}{SE} = "";  #shovill do not support single end reads

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_shovill;

sub test_shovill {

   return check_conda_tool("shovill");
 

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_shovill;

sub preprocess_shovill {

    my ($samplenr) = @_;

    my $runstep_name = "shovill";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    if ($sample_type eq "FASTA") {
        return "";
    }

    if ($sample_type eq "SE") {
        log_message("WARNING: Shovill does not support single-end read samples for sample $sample_name","yellow");

        if ($R_cfg->{spades}{enabled}) {
            log_message("NOTICE: Falling back to Spades for single-end sample $sample_name","yellow");
            $R_samples->[$samplenr]{results}{$runstep_name}{delegated_to} = "spades";
            return $runstep{"spades"}{preprocessing}->($samplenr);
        }
        else {
            log_message("WARNING: No suitable fallback assembler enabled for single-end sample $sample_name","yellow");
            return "";
        }
    }

    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_shovill($samplenr);
        return "";
    }

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_shovill;

sub postprocess_shovill {
    my ($samplenr) = @_;

    my $runstep_name = "shovill";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    if (
        $sample_type eq "SE" &&
        exists $R_samples->[$samplenr]{results}{$runstep_name}{delegated_to} &&
        $R_samples->[$samplenr]{results}{$runstep_name}{delegated_to} eq "spades"
    ) {
        return $runstep{"spades"}{result_parsing}->($samplenr);
    }

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    my $assemblystats = analyze_assembly_stats($resultfile);
    $R_samples->[$samplenr]{results}{$runstep_name} = $assemblystats;

    my $len        = $assemblystats->{total_length}               // "n/a";
    my $contigs    = $assemblystats->{nr_contigs}                // "n/a";
    my $contigs500 = $assemblystats->{nr_contigs_largerthan_500} // "n/a";
    my $n50        = $assemblystats->{n50}                       // "n/a";
    my $gc         = $assemblystats->{gc_content}                // "n/a";
    my $cov        = $assemblystats->{total_coverage}            // 0;

    log_message("NOTICE: Total length: $len", "green");
    log_message("NOTICE: Contigs: $contigs", "green");
    log_message("NOTICE: Contigs (500+): $contigs500", "green");
    log_message("NOTICE: N50: $n50", "green");
    log_message("NOTICE: gc_content: $gc", "green");
    if ($cov > 0) {
        log_message("NOTICE: Total coverage: $cov", "green");
    }

    return 1;
}




