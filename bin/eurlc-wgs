   conda run -n $R_cfg->{spades}->{env} --no-capture-output spades.py 
       -1 '__R1TD__' 
       -2 '__R2TD__' 
       -t __THREADS__ 
       $R_cfg->{spades}->{arguments} 
       -o __OUTDIR__/__BASE__ >> __DIR-LOG__/spades_logs.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/contigs.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.spades.fasta
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
   conda run -n $R_cfg->{spades}->{env} --no-capture-output spades.py 
       -s '__SETD__'  
       -t __THREADS__ 
       $R_cfg->{spades}->{arguments} 
       -o __OUTDIR__/__BASE__ >> __DIR-LOG__/spades_logs.txt 
       __HIDE-STDERR__
    __NEWCOMMAND__   
    cp __OUTDIR__/__BASE__/contigs.fasta __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.spades.fasta
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

