$runstep_name = "amrfinderplus";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running Amrfinderplus...",
      long_name  => "Amrfinderplus",
      output_dir => "__DIR-AMR__/amrfinderplus",
      resultfile => "__DIR-AMR__/amrfinderplus/__BASE__.txt",
      resultfiles_status => "NA",

      # Tagged 'amr' alongside resfinder_fasta/resfinder_fastq -- no
      # aggregating select_main_amr_results exists yet (each AMR tool's
      # results are shown side by side, deliberately, until there's
      # confidence -- ideally with AMR domain expertise -- in how to
      # reconcile them into one official answer). The group tag is laid
      # now so that step can slot in later without revisiting these three.
      group      => 'amr',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'amrfinderplus_done' ],
      applies_if => sub { return $R_cfg->{amrfinderplus}{enabled} ? 1 : 0; },
};

