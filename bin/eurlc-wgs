## runstep fastqc_rawdata

$runstep_name = "fastqc_rawdata";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Running FastQC on rawdata...",
      long_name  => "FastQC on raw data",
      output_dir => "__DIR-QC1__/FastQC_rawdata",
      # Output names are guaranteed by the symlink approach in cmd_template:
      # PE: <outdir>/<sample>_R1_fastqc.zip + <sample>_R2_fastqc.zip
      # SE: <outdir>/<sample>_SE_fastqc.zip
      resultfile => "__DIR-QC1__/FastQC_rawdata/__BASE___R1_fastqc.zip",
      resultfiles_status => "NA",

      requires   => [],
      produces   => [ 'fastqc_rawdata_done' ],
      # Disabled by default -- FastQC is slow and can hang on large inputs.
      # Enable via: fastqc_rawdata.enabled = 1
      # The parent fastqc.enabled=0 also acts as a global off-switch.
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return ($R_cfg->{fastqc_rawdata}{enabled} || $R_cfg->{fastqc}{enabled}) ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<'CMD');
    ln -sf '__R1__' '__OUTDIR__/__BASE___R1.fastq.gz'
    __NEWCOMMAND__
    ln -sf '__R2__' '__OUTDIR__/__BASE___R2.fastq.gz'
    __NEWCOMMAND__
    conda run -n __FASTQCENV__ --no-capture-output fastqc
       -t __THREADS__
       -o __OUTDIR__
       '__OUTDIR__/__BASE___R1.fastq.gz'
       '__OUTDIR__/__BASE___R2.fastq.gz'
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -f '__OUTDIR__/__BASE___R1.fastq.gz' '__OUTDIR__/__BASE___R2.fastq.gz'
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<'CMD');
    ln -sf '__SE__' '__OUTDIR__/__BASE___SE.fastq.gz'
    __NEWCOMMAND__
    conda run -n __FASTQCENV__ --no-capture-output fastqc
       -t __THREADS__
       -o __OUTDIR__
       '__OUTDIR__/__BASE___SE.fastq.gz'
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -f '__OUTDIR__/__BASE___SE.fastq.gz'
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = sub {
    my ($samplenr) = @_;
    return 2 if exists $tests_performed{fastqc};
    $tests_performed{fastqc} = 1;
    return check_conda_tool("fastqc");
};

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_fastqc_rawdata;

sub preprocess_fastqc_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "fastqc_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # applies_if already gates on enabled and FASTA; these checks are not needed here.

    # Raw input files (__R1__, __R2__, __SE__) are guaranteed to exist at
    # this point -- their existence is what makes the sample visible to the
    # pipeline in the first place. No need to re-check here.

    # Already-done check (extend mode).
    # With the symlink approach, FastQC output names are guaranteed:
    # PE:  <sample>_R1_fastqc.zip / <sample>_R2_fastqc.zip
    # SE:  <sample>_SE_fastqc.zip
    my $outdir = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr);
    if ($sample_type eq "PE") {
        my $r1_zip = "$outdir/${sample_name}_R1_fastqc.zip";
        my $r2_zip = "$outdir/${sample_name}_R2_fastqc.zip";
        if (-s $r1_zip && -s $r2_zip) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_fastqc_rawdata($samplenr);
            return "";
        }
    } elsif ($sample_type eq "SE") {
        my $se_zip = "$outdir/${sample_name}_SE_fastqc.zip";
        if (-s $se_zip) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_fastqc_rawdata($samplenr);
            return "";
        }
    }

    # Runstep-specific placeholder replacement before fill_placeholders.
    my $command = $runstep{$runstep_name}{cmd_template}{$sample_type};
    _fill_placeholders__safe_replace(\$command, "__FASTQCENV__", $R_cfg->{fastqc}{env});
    $command = fill_placeholders($command, $samplenr, $runstep_name);
    ensure_dir($outdir);
    return $command;
}

# POST---------------------------------
$runstep{$runstep_name}{result_parsing} = \&postprocess_fastqc_rawdata;

sub postprocess_fastqc_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "fastqc_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $outdir = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);

    if ($sample_type eq "PE") {
        my $r1_base = "$outdir/${sample_name}_R1_fastqc";
        my $r2_base = "$outdir/${sample_name}_R2_fastqc";

        unless (-s "$r1_base.zip" && -s "$r2_base.zip") {
            log_message("WARNING: FastQC rawdata results missing for sample [$sample_name]", "yellow");
            return 0;
        }

        my $result_ref_R1 = parse_fastqc_results2("$r1_base.zip");
        unless (defined $result_ref_R1) {
            log_message("WARNING: FastQC rawdata R1 could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{R1} = $result_ref_R1;

        my $result_ref_R2 = parse_fastqc_results2("$r2_base.zip");
        unless (defined $result_ref_R2) {
            log_message("WARNING: FastQC rawdata R2 could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{R2} = $result_ref_R2;

        register_raw_output($samplenr, $runstep_name,
            title => "FastQC report R1 (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$r1_base.html"),
        );
        register_raw_output($samplenr, $runstep_name,
            title => "FastQC report R2 (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$r2_base.html"),
        );

        log_message("NOTICE:=========== FastQC raw R1 ===================", "green");
        _log_fastqc_results_rawdata($result_ref_R1);
        log_message("NOTICE:=========== FastQC raw R2 ===================", "green");
        _log_fastqc_results_rawdata($result_ref_R2);
    }
    elsif ($sample_type eq "SE") {
        my $se_base = "$outdir/${sample_name}_SE_fastqc";

        unless (-s "$se_base.zip") {
            log_message("WARNING: FastQC rawdata result missing for sample [$sample_name]", "yellow");
            return 0;
        }
        my $result_ref_SE = parse_fastqc_results2("$se_base.zip");
        unless (defined $result_ref_SE) {
            log_message("WARNING: FastQC rawdata could not be parsed for sample [$sample_name]", "yellow");
            return 0;
        }
        $R_samples->[$samplenr]{results}{$runstep_name}{SE} = $result_ref_SE;
        register_raw_output($samplenr, $runstep_name,
            title => "FastQC report (HTML)",
            type  => "html",
            path  => path_relative_to_outdir("$se_base.html"),
        );
        log_message("NOTICE:=========== FastQC raw ===================", "green");
        _log_fastqc_results_rawdata($result_ref_SE);
    }

    return 1;
}

# Log FastQC results for rawdata context.
# Inlined here (not shared with fastqc_trimmed_data) because the two
# runsteps differ in which modules are expected to warn/fail and what
# the user should be told about them.
sub _log_fastqc_results_rawdata {
    my ($fastqc_data) = @_;

    my @module_names  = @{ $fastqc_data->{modules}{entries}  // [] };
    my @adapter_names = @{ $fastqc_data->{adapters}{entries} // [] };

    for my $module (@module_names) {
        my $status = $fastqc_data->{modules}{$module}{status} // "NA";
        my $ucstatus = uc($status);
        my $color = $ucstatus eq 'PASS' ? 'green' : 'yellow';
        my $note  = "";

        # Expected WARN/FAIL on rawdata that users sometimes worry about
        if ($module eq 'Per base sequence content' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note = " (normal for Nextera/transposase-based kits)";
        } elsif ($module eq 'Per tile sequence quality' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note = " (data may still be usable)";
        } elsif ($module eq 'Sequence Duplication Levels' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note = " (normal for small genomes at high coverage)";
        } elsif ($module eq 'Adapter Content' && $ucstatus =~ /^(FAIL|WARN)$/) {
            $note = " (expected before trimming -- fastp will remove adapters)";
        }

        log_message(sprintf("NOTICE: %-35s : %-10s%s", $module, $status, $note), $color);
    }

    log_message(sprintf("NOTICE: %-35s : %-10s", "Sequences",       $fastqc_data->{sequences} // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "Bases",           $fastqc_data->{bases}     // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "Sequence length", $fastqc_data->{seqlen}    // "NA"));
    log_message(sprintf("NOTICE: %-35s : %-10s", "GC content (%)",  $fastqc_data->{gc}        // "NA"));

    for my $adapter (@adapter_names) {
        my $value   = $fastqc_data->{adapters}{$adapter} // 0;
        my $int_val = int($value);
        if ($int_val >= 1) {
            log_message(sprintf("NOTICE: %-35s : %-10s", $adapter, "$int_val%"), "yellow");
        }
    }
}

##   $R_samples->[$samplenr]{results}{fastqc_rawdata}{R1}  -- parsed FastQC data R1
##   $R_samples->[$samplenr]{results}{fastqc_rawdata}{R2}  -- parsed FastQC data R2
##   $R_samples->[$samplenr]{results}{fastqc_rawdata}{SE}  -- parsed FastQC data SE


## runstep fastp rawdata 

$runstep_name = "fastp_rawdata";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running Fastp on rawdata...",
      long_name  => "Fastp on raw data",
      output_dir => "__DIR-QC1__/Fastp_rawdata",
      resultfile => "__DIR-QC1__/Fastp_rawdata/__BASE__.raw.json",
      resultfiles_status => "NA",

      # Runstep machinery design doc, §5/§6 -- fastp_rawdata and
      # check_for_no_trimming both produce trimmed_fastq; applies_if makes
      # them mutually exclusive based on which trimming method is actually
      # selected+enabled. Previously this check existed only as commented-
      # out code -- general.trimming/fastp.enabled had no real effect on
      # whether fastp ran.
      requires   => [],
      produces   => [ 'trimmed_fastq' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return ( lc($R_cfg->{general}{trimming} // '') eq 'fastp' && $R_cfg->{fastp}{enabled} ) ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastp}->{env} --no-capture-output fastp 
       -i '__R1__' 
       -I '__R2__' 
       -o '__R1T__' 
       -O '__R2T__'
       --thread __THREADS__ 
       --json '__OUTDIR__/__BASE__.raw.json' 
       --html '__OUTDIR__/__BASE__.raw.html' 
       --report_title '__BASE__.raw' 
       $R_cfg->{fastp}->{arguments} 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastp}->{env} --no-capture-output fastp 
       -i '__SE__' 
       -o __SET__  
       --thread __THREADS__ 
       --json '__OUTDIR__/__BASE__.raw.json' 
       --html '__OUTDIR__/__BASE__.raw.html' 
       --report_title '__BASE__.raw' 
       $R_cfg->{fastp}->{arguments} 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_fastp_rawdata;

sub test_fastp_rawdata {

   return check_conda_tool("fastp");

}
  
# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_fastp_rawdata;

sub preprocess_fastp_rawdata {

    my ($samplenr) = @_;

    my $runstep_name = "fastp_rawdata";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     

    if ($sample_type eq "FASTA") {
        return "";
    }
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);
    

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__R1__", "__R2__");
    }

    elsif ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "fatal", "__SE__");
    }
          
    if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastp_rawdata($samplenr);
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

 
    if($sample_type eq "SE" &&  (fill_placeholders("__SE__",$samplenr) eq (fill_placeholders("__SET__",$samplenr)))  )  {
       log_message("ERROR: Fatal error! Fastp inputfile equals oututfile, skipping fastp!!!");
        return "";
    } 
    if($sample_type eq "PE" && ( (fill_placeholders("__R1__",$samplenr) eq (fill_placeholders("__R1T__",$samplenr))) || (fill_placeholders("__R2__",$samplenr) eq (fill_placeholders("__R2T__",$samplenr))) )  )  {
       log_message("ERROR: Fatal error! Fastp inputfile equals oututfile, skipping fastp!!!");
        return "";
    }    
    # runstep specific replacements
    

   ## remove output if fastp is not chosen trimming software

      
#   if( ! $R_cfg->{general}{trimming} eq "fastp" ){
#    $command =~ s/-o '__R1T__'//g;
#    $command =~ s/-O '__R2T__'//g;
#    $command =~ s/-o '__SET__'//g;
#    $R_samples->[$samplenr]{trimmed} = 0;
#   }    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastp_rawdata;

sub postprocess_fastp_rawdata {
    my ($samplenr) = @_;

    my $runstep_name = "fastp_rawdata";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

   # Verify output files
    if ($sample_type eq "PE") {
        if( require_input_files($samplenr, $runstep_name,  "fatal", "__R1T__", "__R2T__")){
           $R_samples->[$samplenr]{trimmed} = 1;
        }
    }

    elsif ($sample_type eq "SE") {
        if(require_input_files($samplenr, $runstep_name,  "fatal", "__SET__")){
           $R_samples->[$samplenr]{trimmed} = 1;        
        }
    }
      

    my $data = read_json($resultfile);
    my $parsed = parse_fastp_results($data);

    return 0 unless defined $parsed;

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "Fastp HTML report",
        type  => "html",
        path  => path_relative_to_outdir(fill_placeholders("__OUTDIR__/__BASE__.raw.html",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Fastp JSON report",
        type  => "json",
        path  => path_relative_to_outdir(fill_placeholders("__OUTDIR__/__BASE__.raw.json",$samplenr, $runstep_name)),
    ); 
       
               
   $R_samples->[$samplenr]{results}{$runstep_name} = $parsed;

   # Species is not known yet: use a configured genome size if there is
   # one, but do not run jellyfish for it. Raw coverage is (re)computed at
   # the end, once the species is known -- see refresh_raw_coverage().
   { local $S_NO_KMER = 1; ensure_genomesize_computed($samplenr); }

   my $genomesize = $R_samples->[$samplenr]{estimated_genomesize} // 0;
   my $maxdepth =  $R_samples->[$samplenr]{maxdepth};
   my $mindepth =  $R_samples->[$samplenr]{fatal_mindepth};
   my $gc =  $R_samples->[$samplenr]{gc} ;
   
  my $target = $R_samples->[$samplenr]{results}{$runstep_name};

  my $total_bases_before = $target->{summary}{before_filtering}{total_bases};
  my $total_Q30bases_before = $target->{summary}{before_filtering}{q30_bases};

  my $coverageQ30_before = safe_quota($total_Q30bases_before, $genomesize, "n/a");
  my $coverage_before = safe_quota($total_bases_before, $genomesize, "n/a");

  my $total_bases_after = $target->{summary}{after_filtering}{total_bases};
  my $total_Q30bases_after = $target->{summary}{after_filtering}{q30_bases};

  my $coverageQ30_after = safe_quota($total_Q30bases_after, $genomesize, "n/a");
  my $coverage_after = safe_quota($total_bases_after, $genomesize, "n/a");

    my $is_number = sub {
        my ($x) = @_;
        return 0 unless defined $x;
        return 0 if $x eq "";
        return $x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;
    };
    
  my $rate_to_pct = sub {
      my ($x) = @_;
      return "n/a" unless $is_number->($x);
      return $x * 100;
  };
      
   ## MAIN RESULTS
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{q30_rate} = $target->{summary}{after_filtering}{q30_rate};
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{q30_rate} = $target->{summary}{before_filtering}{q30_rate};
   # N share of the whole raw files (the prescan only reads the first reads)
   {
       my $nr = $target->{summary}{before_filtering}{N_rate};
       if ( !defined $nr ) {   # results parsed before 18 Nov 2026: from the curves directly
           my @c = grep { defined $_ && $_ ne '' } @{ $target->{read1_before_filtering}{content_curves}{N} // [] },
                                                   @{ $target->{read2_before_filtering}{content_curves}{N} // [] };
           if (@c) { my $t = 0; $t += $_ for @c; $nr = $t / @c; }
       }
       $R_samples->[$samplenr]{main_results}{qscore}{raw}{n_pct} = sprintf( "%.5f", 100 * $nr ) if defined $nr;
   }
       
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{R2_R1_read_len_balance} = safe_rel($target->{summary}{after_filtering}{read2_mean_length},$target->{summary}{after_filtering}{read1_mean_length}, "n/a");
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{R2_R1_read_len_balance} = safe_rel($target->{summary}{before_filtering}{read2_mean_length},$target->{summary}{before_filtering}{read1_mean_length}, "n/a");
       
   # mean of R1 and R2 -- or just R1 for single-end data (no read2 values)
   my $mean_len = sub { my @v = grep { defined && /^\d+(?:\.\d+)?$/ } @_; @v ? ( List::Util::sum(@v) / @v ) : "n/a" };
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{av_read_len} = $mean_len->( $target->{summary}{after_filtering}{read1_mean_length},  $target->{summary}{after_filtering}{read2_mean_length} );
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len}     = $mean_len->( $target->{summary}{before_filtering}{read1_mean_length}, $target->{summary}{before_filtering}{read2_mean_length} );
       
   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{gc} =  $rate_to_pct->($target->{summary}{after_filtering}{gc_content});

   $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc} =   $rate_to_pct->($target->{summary}{before_filtering}{gc_content});

   $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{gc_dev} =  $R_samples->[$samplenr]{gc} - $target->{summary}{after_filtering}{gc_content};
   $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc_dev} = $R_samples->[$samplenr]{gc} - $target->{summary}{before_filtering}{gc_content};

   $R_samples->[$samplenr]{main_results}{coverage}{raw}{q30_coverage} = $coverageQ30_before // 0;


   $R_samples->[$samplenr]{main_results}{coverage}{raw}{coverage} = $coverage_before // 0;

   # Read loss and adapters (fastp's own counts over all reads). Short
   # reads after trimming are the real problem with adapter-heavy data, so
   # both are QC measures (qscore_trimmed_too_short_pct, ..._adapter_trimmed_pct).
   {
       my $total_reads = $target->{summary}{before_filtering}{total_reads};
       my $fr  = $target->{filtering_result} // {};
       my $ac  = $target->{adapter_cutting}  // {};
       $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{too_short_pct} =
           defined $fr->{too_short_reads} ? sprintf("%.1f", safe_rel($fr->{too_short_reads}, $total_reads, 0)) : "n/a";
       $R_samples->[$samplenr]{main_results}{qscore}{raw}{adapter_trimmed_pct} =
           defined $ac->{adapter_trimmed_reads} ? sprintf("%.1f", safe_rel($ac->{adapter_trimmed_reads}, $total_reads, 0)) : "n/a";
       $R_samples->[$samplenr]{main_results}{qscore}{raw}{insert_size_peak} = $target->{insert_size}{peak} // "n/a";
   }



                               
  log_message("NOTICE: ======= Before filtering ==========", "green");
  if($sample_type eq "PE"){  print_tabular_results("Total reads", "$target->{read1_before_filtering}{total_reads} + $target->{read2_before_filtering}{total_reads} = $target->{summary}{before_filtering}{total_reads}");   }
  if($sample_type eq "SE"){  print_tabular_results("Total reads", "$target->{summary}{before_filtering}{total_reads}");   }
  print_tabular_results("Total bases", $target->{summary}{before_filtering}{total_bases});
  print_tabular_results("Q30 rate", $target->{summary}{before_filtering}{q30_rate});
   if($sample_type eq "PE"){
     print_tabular_results("R1 mean length", $target->{summary}{before_filtering}{read1_mean_length});
     print_tabular_results("R2 mean length", $target->{summary}{before_filtering}{read2_mean_length});
  } 
  if($sample_type eq "SE"){
     print_tabular_results("Read mean length", $target->{summary}{before_filtering}{read1_mean_length});
  } 
  print_tabular_results("GC content", $target->{summary}{before_filtering}{gc_content});
  if($genomesize>0){
    print_tabular_results("Coverage depth", $coverage_before);
    print_tabular_results("Q30 Coverage depth", $coverageQ30_before);
  }
  
  log_message("NOTICE: ======= After filtering ==========", "green");
  if($sample_type eq "PE"){  print_tabular_results("Total reads", "$target->{read1_after_filtering}{total_reads} + $target->{read2_after_filtering}{total_reads} = $target->{summary}{after_filtering}{total_reads}"); }
  if($sample_type eq "SE"){  print_tabular_results("Total reads", "$target->{summary}{after_filtering}{total_reads}"); }
 print_tabular_results("Total bases", $target->{summary}{after_filtering}{total_bases});
 print_tabular_results("Q30 rate", $target->{summary}{after_filtering}{q30_rate});
   if($sample_type eq "PE"){
     print_tabular_results("R1 mean length", $target->{summary}{after_filtering}{read1_mean_length});
     print_tabular_results("R2 mean length", $target->{summary}{after_filtering}{read2_mean_length});
  } 
  if($sample_type eq "SE"){
     print_tabular_results("Read mean length", $target->{summary}{after_filtering}{read1_mean_length});
  } 
  print_tabular_results("GC content", $target->{summary}{after_filtering}{gc_content});
  if (defined $genomesize && $genomesize =~ /^\d+(?:\.\d+)?$/ && $genomesize > 0) {
    print_tabular_results("Coverage depth", $coverage_after);
    print_tabular_results("Q30 Coverage depth", $coverageQ30_after);
  }

  
     
    return 1; # success
}






 
