###################################################################################################
###################################################################################################
## startup 

# Ensures output is flushed immediately rather than buffered, so log output and
# GUI-launcher live display reflect progress in real time. Explicit on both
# handles rather than relying on $| (which only affects the currently selected
# handle, default STDOUT) -- robust even if select() is used elsewhere later.
STDOUT->autoflush(1);
STDERR->autoflush(1);

my %rundata;


# pipeline info
$rundata{pipeline_info} = {
    name        => "eurlc-wgs",
    version     => $PIPELINE_VERSION,
    versiondate => "2026-05-20",
    author      => "Bo Segerman",
    contact     => "bo.segerman\@sva.se",
};



###################################################################################################
## global start time

$rundata{timestamps}{pipeline_start}{time_value}      = time();
$rundata{timestamps}{pipeline_start}{timestamp_UTC}   = timestamp_UTC(); 
$rundata{timestamps}{pipeline_start}{timestamp_local} = timestamp_local(); 


# The command line exactly as the user gave it, before any rewriting --
# shown in the run banner in the log (see write_run_start_banner).
our @ORIGINAL_ARGV = @ARGV;
# --qc-screen: quick QC check of the raw reads only (see "QC screen" below).
# Detected here, directly on @ARGV, because it decides the output folder,
# which is set before the arguments are parsed.
our $S_QCSCREEN = ( grep { /^-{0,2}qc-?screen$/i } @ARGV ) ? 1 : 0;
# Set while the input folder is scanned again on resume, only to report new
# files: the naming and pairing messages were given in the first run.
our $S_QUIET_SAMPLE_LIST = 0;

# --version alone: just the pipeline version, at once -- no conda, no log,
# no database folder (review 5.8). --versions lists every tool's version as
# well (that needs conda and reads all environments).
if ( @ARGV == 1 && $ARGV[0] =~ /^-{0,2}version$/i ) {
    print "eurlc-wgs $PIPELINE_VERSION\n";
    exit 0;
}

# Internal modes of the remap step (planned §36), handled before anything
# else is set up: --remap-summary=depth|pileup reads samtools output from a
# pipe inside the step; --remap-check compares the streaming way with the
# results already in output folders. See remap_internal_main().
if ( @ARGV && $ARGV[0] =~ /^--remap-(?:summary|check)\b/ ) {
    exit remap_internal_main(@ARGV);
}

# How this run relates to the output directory, set by the overwrite check:
#   "new"         -- output directory did not exist
#   "overwritten" -- an existing output directory was removed first
#   "resumed"     -- existing output directory kept (overwrite=resume)
our $S_RUN_MODE = "new";
our $RUN_BANNER_TAG = "EURLC-WGS RUN";   # searchable marker in log/log.txt
our $S_RUN_NUMBER   = 1;                 # set by write_run_start_banner
our $S_RUN_BANNER_DIR;                   # log folder the START banner was written to
our $MAIN_PID       = $$;                # forked children must not write the END banner
our @S_RUN_ISSUES   = ();                # every ERROR/WARNING logged, for the end-of-run summary
our $S_ISSUES_PAUSED = 0;                # 1 while re-printing already collected messages
our @S_TOOLS_NOT_RUN = ();               # filled by report_species_tools_not_run()
our %S_CGMLST_NO_SCHEMA = ();            # species => [sample names] without an installed cgMLST schema
our @S_DATA_ROOTS_OLD = ();              # data folders recorded by earlier runs (log/input_dir.txt), oldest first
our %S_RELOCATED = ();                   # recorded raw file path => where it was found now (moved analysis)
our %S_RAW_MISSING = ();                 # sample base => [recorded raw paths not found now]
our %S_VALIDATION = ();                  # result of the validation against a dataset (run_dataset_validation)
our %S_EFSA_EXPORT = ();                 # result of the EFSA export (run_efsa_export)
our $S_EXPECTED_FAIL_REASON;              # set (local) while a step runs on a sample whose data already failed: a failing command is a NOTICE, not an ERROR
our %S_VERIFICATION = ();                # result of the comparison with a reference run (run_reference_verification)
our $S_FINGERPRINT_FORMAT_VERSION = 1;   # report/tables/eurlc_results_fingerprint.json.gz (write_results_fingerprint)
# Built-in cgMLST QC thresholds per schema (cgmlst_threshold_value). NIPH +
# NIPHEM: clean C. jejuni/C. coli at most 3 (Nov 2026); EURL-Campylobacter
# accepts <= 10 (Inter-EURL Deliverable 10).
our %CGMLST_SCHEMA_QC_DEFAULTS = (
    "CAMPISO-PubMLST-8"       => { warning_typing_cgmlst_paralogous => ">5", critical_typing_cgmlst_paralogous => ">10" },
    "chewie_ns_campylobacter" => { warning_typing_cgmlst_paralogous => ">5", critical_typing_cgmlst_paralogous => ">10" },
    # Salmonella, 18 Nov 2026 (SVA Salmonella validation Dataset_1-4): clean
    # samples down to 94.2-94.9 % (Choleraesuis ST145 94.8, where SVA's
    # INNUENDO schema gives 97.7 -- planned section 44); paralogous clean up to 15
    # (one 64), WARNING >20 as the SVA Salmonella pipeline.
    "chewie_ns_salmonella"    => { warning_typing_cgmlst_call_rate => "<94", critical_typing_cgmlst_call_rate => "<90",
                                   fail_typing_cgmlst_call_rate => "<80", warning_typing_cgmlst_paralogous => ">20" },
);
our %S_CLEANUP_REMOVED = ();
our $S_FULL_DB_VERIFY = 0;   # --verify-databases: hash every marker file again, ignoring <file>.md5 (B12)             # resume: read categories an earlier cleanup removed (log/cleanup.json)
our $S_NO_KMER = 0;                      # 1: genome size from config only, never run jellyfish (pre-species)
our $S_STATIC_APPLIES = 0;               # 1 while applies_if is asked structurally (graph check,
                                         # progress denominator): answer from config only, never
                                         # compute from data (e.g. no jellyfish run)

my $USE_COLOR = (-t STDOUT) ? 1 : 0;

foreach my $arg (@ARGV) {
  if    ( $arg eq "--no-color" || $arg eq "--no-colour") { $USE_COLOR = 0; }
  elsif ( $arg eq "--color"    || $arg eq "--colour")    { $USE_COLOR = 1; }
}

# Skip-all-interactive-prompts mode. Declared this early (like $USE_COLOR
# above) so it's available even to premount handlers, before %args/%R_cfg
# even exist. Merged with any config-file/CLI-override value later (see
# "$ASSUME_YES ||= ..." near initiate_logfile()) without ever resetting an
# early "yes" back to "no". Does NOT apply to general.overwrite -- that
# prompt (whether to delete an existing output directory) stays fully
# interactive regardless of this flag; see its own dedicated handling below.
my $ASSUME_YES = 0;

# Suppress startup log noise when running utility commands (--setup,
# --freeze-databases, --generate-seal). The flag is cleared at the start
# of each _cmd_* function so the utility output itself is never suppressed.
my $S_SUPPRESS_STARTUP_LOG = 0;
my $S_SETUP_OPTIONAL = 0;   # --setup --optional: also install tools that are off (A10)

foreach my $arg (@ARGV) {
    if ($arg =~ /^(?:--?)?assume-yes$/)               { $ASSUME_YES = 1; }
    if ($arg =~ /^(?:--?)?setup$/)                    { $S_SUPPRESS_STARTUP_LOG = 1; }
    if ($arg =~ /^(?:--?)?optional$/)                 { $S_SETUP_OPTIONAL = 1; }   # --setup --optional (install.sh)
    if ($arg =~ /^(?:--?)?freeze-databases(?:=|$)/)   { $S_SUPPRESS_STARTUP_LOG = 1; }
    if ($arg =~ /^(?:--?)?verify-databases$/)         { $S_SUPPRESS_STARTUP_LOG = 1; }
    if ($arg =~ /^(?:--?)?generate-seal(?:=|$)/)        { $S_SUPPRESS_STARTUP_LOG = 1; }
    if ($arg =~ /^(?:--?)?install-scheme(?:=|$)/)       { $S_SUPPRESS_STARTUP_LOG = 1; }
    if ($arg =~ /^(?:--?)?install-efsa-schemas(?:=|$)/){ $S_SUPPRESS_STARTUP_LOG = 1; }
}


###################################################################################################
## welcome message

my $welcome = <<"WELCOME";


@{[ colorize_for_screen('bold blue') ]}====================================================================
                              @{[ colorize_for_screen('bold green') ]}EURLC-WGS@{[ colorize_for_screen('reset') ]}
@{[ colorize_for_screen('bold blue') ]}        Whole-genome sequencing analysis for bacterial isolates
====================================================================@{[ colorize_for_screen('reset') ]}

  @{[ colorize_for_screen('bold') ]}Version:@{[ colorize_for_screen('reset') ]} $rundata{pipeline_info}{version}
  @{[ colorize_for_screen('bold') ]}Started:@{[ colorize_for_screen('reset') ]} $rundata{timestamps}{pipeline_start}{timestamp_local}

  Developed at EURL-Campylobacter (SVA, Sweden)
  Report problems or feedback to: @{[ colorize_for_screen('yellow') ]}$rundata{pipeline_info}{contact}@{[ colorize_for_screen('reset') ]}

@{[ colorize_for_screen('bold blue') ]}====================================================================@{[ colorize_for_screen('reset') ]}


WELCOME

print $welcome;

###################################################################################################
## detect os and runmode

$rundata{system_info}{os} = detect_os();

  
if( is_windows() ) {  
    die("This script requires a Linux based environment.\n" .
        "Please consider installing Windows Subsystem for Linux (WSL)\n"); 
}

$rundata{system_info}{runmode}  = "conda";

# Docker mode is switched off (review B31): there is no Dockerfile, it is not
# documented, and it would exec /db/run.perl -- whatever lies in the database
# folder. The code paths behind is_docker() are left in place but cannot be
# reached; see eurlc-wgs-planned.md, "Docker-läget". To bring it back, restore
# the assignment below and address the points listed there.
foreach my $arg (@ARGV) {
  if( $arg eq "docker") {
    print "ERROR: Docker mode is not available in this version of eurlc-wgs.\n";
    exit 1;
    # $rundata{system_info}{runmode} = "docker";
  }  
}

log_message("NOTICE: Running in $rundata{system_info}{runmode} mode (OS=$rundata{system_info}{os})" ); 

###################################################################################################
## log starttime stamp


if( is_docker() ) {
  log_message("NOTICE: Local Time (may be UTC/GMT in a container) at startup is: $rundata{timestamps}{pipeline_start}{timestamp_local}" ); 
}
else{  
   log_message("NOTICE: Local Time at startup is: $rundata{timestamps}{pipeline_start}{timestamp_local}" ); 
}   

