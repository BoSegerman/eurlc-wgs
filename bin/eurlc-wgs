    if ($recursive_flag) {
        log_message("NOTICE: Recursive search enabled -- scanning [" . getdir("in") . "] and all subdirectories for input files. This may take a while for large directory trees.");
    }

    my @list_off_files_fastq = $R_cfg->{"general"}{"fastq"} ? prepare_fastq_files(getdir("in"),$recursive_flag) : ();
    my @list_off_files_fasta = $R_cfg->{"general"}{"fasta"} ? prepare_fasta_files(getdir("in"),$recursive_flag) : ();
    
    my $filelist_path_fastq = getdir("out,log") . "/filelist_fastq.txt";
    open(my $fh, '>', $filelist_path_fastq) or graceful_die("Could not open '$filelist_path_fastq' for writing: $!");

    foreach my $file (@list_off_files_fastq) {
        print $fh "$file\n";
    }
    close($fh);

    log_message("INFO: Wrote ".scalar(@list_off_files_fastq)." fastq files to '$filelist_path_fastq'");

    ## FASTA
    my $filelist_path_fasta = getdir("out,log") . "/filelist_fasta.txt";
    open( $fh, '>', $filelist_path_fasta) or graceful_die("Could not open '$filelist_path_fasta' for writing: $!");

    foreach my $file (@list_off_files_fasta) {
       print $fh "$file\n";
    }
    close($fh);
    log_message("INFO: Wrote ".scalar(@list_off_files_fasta)." fasta files to '$filelist_path_fasta'");


}



