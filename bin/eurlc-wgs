my %tests_performed;

my @constants_fasta_exts = (
  ".fasta", 
  ".fa",
  ".fna",
  ".fasta.gz", 
  ".fa.gz",
  ".fna.gz"
);

my @constants_R1_extensions = (
    "_1.fastq",     "_1.fastq.gz",
    "_1.fq",        "_1.fq.gz",
    "_r1.fastq",    "_r1.fastq.gz",
    "_r1.fq",       "_r1.fq.gz",
    "_r1_001.fastq","_r1_001.fastq.gz",
    "_r1_001.fq",   "_r1_001.fq.gz",
