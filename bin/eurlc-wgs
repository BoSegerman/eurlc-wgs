sub find_optional_file {
    my ($filename) = @_;

    return undef if !defined $filename || $filename eq "";

    my $indir = getdir("in");   # or whatever your input dir helper is
    return undef if !defined $indir || $indir eq "";

    my $path = "$indir/$filename";
    return $path if -f $path;

    return undef;
}



sub parse_runinfo_xml {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my %runinfo;

    eval {
        require XML::LibXML;

        my $parser = XML::LibXML->new();
        my $doc    = $parser->parse_file($file);

        my ($runinfo_node) = $doc->findnodes('/RunInfo');
        my ($run_node)     = $doc->findnodes('/RunInfo/Run');

        graceful_die("No <Run> node found in RunInfo.xml") if !$run_node;

        $runinfo{version} = $runinfo_node ? ($runinfo_node->getAttribute('Version') // '') : '';

        $runinfo{run} = {
            id     => $run_node->getAttribute('Id')     // '',
            number => $run_node->getAttribute('Number') // '',
        };

        my ($flowcell_node)   = $run_node->findnodes('./Flowcell');
        my ($instrument_node) = $run_node->findnodes('./Instrument');
        my ($date_node)       = $run_node->findnodes('./Date');

        $runinfo{run}{flowcell}   = $flowcell_node   ? $flowcell_node->textContent   : '';
        $runinfo{run}{instrument} = $instrument_node ? $instrument_node->textContent : '';
        $runinfo{run}{date}       = $date_node       ? $date_node->textContent       : '';

        $runinfo{run}{reads} = [];
        foreach my $read_node ($run_node->findnodes('./Reads/Read')) {
            push @{ $runinfo{run}{reads} }, {
                number          => $read_node->getAttribute('Number')        // '',
                num_cycles      => $read_node->getAttribute('NumCycles')     // '',
                is_indexed_read => $read_node->getAttribute('IsIndexedRead') // '',
            };
        }

        my ($layout_node) = $run_node->findnodes('./FlowcellLayout');
        if ($layout_node) {
            $runinfo{run}{flowcell_layout} = {
                lane_count    => $layout_node->getAttribute('LaneCount')    // '',
                surface_count => $layout_node->getAttribute('SurfaceCount') // '',
                swath_count   => $layout_node->getAttribute('SwathCount')   // '',
                tile_count    => $layout_node->getAttribute('TileCount')    // '',
            };
        }
    };
    if ($@) {
        log_message("WARNING: Could not parse RunInfo.xml file [$file]: $@");
        return {};
    }

    return \%runinfo;
}

