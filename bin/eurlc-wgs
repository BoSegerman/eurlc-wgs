sub detailed_report_link_icon {
    my ($type) = @_;

    return "" if !defined $type || $type eq "";

    my %icon_for = (
        html   => "🌐",
        text   => "📄",
        txt    => "📄",
        log    => "📄",
        tsv    => "📊",
        csv    => "📊",
        json   => "📦",
        fasta  => "🧬",
        fa     => "🧬",
        fastq  => "🧬",
        fq     => "🧬",
        pdf    => "📕",
        image  => "🖼️",
        png    => "🖼️",
        jpg    => "🖼️",
        jpeg   => "🖼️",
    );

    return $icon_for{lc($type)} // "📁";
}


sub detailed_report_section_chewbbaca {
    my ($sample) = @_;

    return "" if !defined $sample || ref($sample) ne "HASH";

    my $R_schemas =
        $sample->{results}{chewbbaca}{schemas}
        // $sample->{main_results}{typing}{cgmlst_schemas}
        // [];

    return "" if ref($R_schemas) ne "ARRAY" || !@$R_schemas;

    my $level = get_report_category_level($sample, "typing");
    my $dot   = warning_level_to_dot_html($level);

    my $html = "";

    $html .= "<h2>ChewBBACA cg/wgMLST $dot</h2>\n";

    foreach my $cg (@$R_schemas) {

        my $scheme      = $cg->{scheme} // $cg->{schema} // "n/a";
        my $species_dir = $cg->{species_dir} // "n/a";

        $html .= "<h3>" . encode_entities($scheme) . "</h3>\n";
        $html .= "<table class=\"summary-table detailed-report-table\">\n";
        $html .= "<tbody>\n";

        $html .= detailed_report_row("Species directory", $species_dir);
        $html .= detailed_report_row("Scheme", $scheme);
        $html .= detailed_report_row("Called alleles", $cg->{called} // "n/a");
        $html .= detailed_report_row("Scheme size", $cg->{scheme_size} // $cg->{schema_size} // "n/a");
        $html .= detailed_report_row("Call rate", format_percent_like($cg->{call_rate}));
        $html .= detailed_report_row("Inferred alleles", $cg->{inferred} // "n/a");
        $html .= detailed_report_row("Inferred percent", format_percent_like($cg->{inferred_pct}));
        $html .= detailed_report_row("Paralogous loci (NIPH + NIPHEM)", $cg->{paralogous} // "n/a");

        $html .= detailed_report_row("EXC", $cg->{EXC} // "n/a");
        $html .= detailed_report_row("INF", $cg->{INF} // "n/a");
        $html .= detailed_report_row("NIPH", $cg->{NIPH} // "n/a");
        $html .= detailed_report_row("NIPHEM", $cg->{NIPHEM} // "n/a");
        $html .= detailed_report_row("PLOT3", $cg->{PLOT3} // "n/a");
        $html .= detailed_report_row("PLOT5", $cg->{PLOT5} // "n/a");
        $html .= detailed_report_row("LOTSC", $cg->{LOTSC} // "n/a");
        $html .= detailed_report_row("ALM", $cg->{ALM} // "n/a");
        $html .= detailed_report_row("ASM", $cg->{ASM} // "n/a");
        $html .= detailed_report_row("PAMA", $cg->{PAMA} // "n/a");
        $html .= detailed_report_row("LNF", $cg->{LNF} // "n/a");

        $html .= detailed_report_row("Invalid CDSs", $cg->{invalid_CDSs} // "n/a");
        $html .= detailed_report_row("Classified CDSs", $cg->{classified_CDSs} // "n/a");
        $html .= detailed_report_row("Total CDSs", $cg->{total_CDSs} // "n/a");

        $html .= "</tbody>\n";
        $html .= "</table>\n";
    }

     my $R_checks = $sample->{results}{chewbbaca}{crc32_collision_checks} || [];
     my $R_collisions = $sample->{results}{chewbbaca}{crc32_collisions} || [];

     $html .= "<h3>CRC32 hash collision check</h3>\n";
     $html .= "<table class=\"summary-table detailed-report-table\">\n";
     $html .= "<tbody>\n";

     if (ref($R_checks) eq "ARRAY" && @$R_checks) {

         foreach my $check (@$R_checks) {
             $html .= detailed_report_row("Scheme", $check->{scheme} // "n/a");
             $html .= detailed_report_row("Checked", ($check->{checked} ? "yes" : "no"));
             $html .= detailed_report_row("Collision count", $check->{collision_count} // "n/a");

             if (($check->{report_file} // "") ne "") {
                 my $href = link_from_sample_report_to_outpath($check->{report_file});
                 my $safe_href = encode_entities($href);
                 $html .= detailed_report_raw_row(
                     "Collision report",
                     qq{<a href="$safe_href">📄 CRC32 collision report</a>}
                 );
             }
         }
     }
     else {
         $html .= detailed_report_row("Checked", "n/a");
         $html .= detailed_report_row("Collision count", "n/a");
     }

$html .= "</tbody>\n";
$html .= "</table>\n";

    return $html;
}

sub format_percent_like {
    my ($x) = @_;

    return "n/a" if !defined $x || ref($x) || $x eq "" || lc($x) eq "n/a";

    if ($x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        return sprintf("%.1f%%", $x);
    }

    return $x;
}

sub get_nested_value {
    my ($R_data, $R_path) = @_;

    return undef if !defined $R_data;
    return undef if !defined $R_path || ref($R_path) ne "ARRAY";

    my $value = $R_data;

    foreach my $key (@$R_path) {
        return undef if !defined $value;

        if (ref($value) eq "HASH") {
            return undef if !exists $value->{$key};
            $value = $value->{$key};
        }
        elsif (ref($value) eq "ARRAY") {
            return undef if $key !~ /^\d+$/;
            return undef if $key > $#$value;
            $value = $value->[$key];
        }
        else {
            return undef;
        }
    }

    return $value;
}


sub detailed_report_format_value {
    my ($value, $field) = @_;

    return "n/a" if !defined $value;
    return "n/a" if !ref($value) && ($value eq "" || lc($value) eq "n/a");

    my $format   = $field->{format}   // "text";
    my $unit     = $field->{unit}     // "";
    my $decimals = $field->{decimals} // 1;

    my $text;

    if ($format eq "int" && $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        $text = int($value);
        $text =~ s/\B(?=(\d{3})+(?!\d))/ /g;
    }
    elsif ($format eq "float" && $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        $text = sprintf("%.*f", $decimals, $value);
    }
    elsif ($format eq "percent" && $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        $text = sprintf("%.*f%%", $decimals, $value);
    }
    elsif ($format eq "rate_percent" && $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/) {
        $text = sprintf("%.*f%%", $decimals, $value * 100);
    }
    else {
        $text = "$value";
    }

    $text .= " $unit" if $unit ne "" && $text ne "n/a";

    return $text;
}

sub detailed_report_row {
    my ($label, $value) = @_;

    return "<tr>"
         . "<td class=\"rowheading\">" . encode_entities($label // "") . "</td>"
         . "<td>" . encode_entities($value // "n/a") . "</td>"
         . "</tr>\n";
}

sub detailed_report_raw_row {
    my ($label, $html_value) = @_;

    return "<tr>"
         . "<td class=\"rowheading\">" . encode_entities($label // "") . "</td>"
         . "<td>" . ($html_value // "n/a") . "</td>"
         . "</tr>\n";
}

sub detailed_report_runstep_section {
    my ($sample, $runstep_name, $R_def) = @_;

    return "" if !defined $sample || ref($sample) ne "HASH";
    return "" if !defined $runstep_name || $runstep_name eq "";
    return "" if !defined $R_def || ref($R_def) ne "HASH";

    my $R_result = $sample->{results}{$runstep_name};

    return "" if !defined $R_result || ref($R_result) ne "HASH";

    my $title    = $R_def->{title}    // $runstep_name;
    my $category = $R_def->{category} // "";
    my $level    = $category ne "" ? get_report_category_level($sample, $category) : "ok";
    my $dot      = warning_level_to_dot_html($level);

    my $html = "";

    $html .= "<h2>" . encode_entities($title) . " $dot</h2>\n";
    $html .= "<table class=\"summary-table detailed-report-table\">\n";
    $html .= "<tbody>\n";

    $html .= detailed_report_row("Runstep", $runstep_name);

    foreach my $field (@{ $R_def->{fields} || [] }) {

        next if !defined $field || ref($field) ne "HASH";

        my $label = $field->{label} // next;
        my $value = get_nested_value($R_result, $field->{path});

        next if $field->{hide_if_missing} && !defined $value;
        next if $field->{hide_if_zero} && defined $value && $value =~ /^0(?:\.0+)?$/;

        my $formatted = detailed_report_format_value($value, $field);

        $html .= detailed_report_row($label, $formatted);
    }

    foreach my $link (@{ $R_def->{links} || [] }) {

        next if !defined $link || ref($link) ne "HASH";

        my $label = $link->{label} // "Report";
        my $href  = get_nested_value($R_result, $link->{path});

        next if !defined $href || $href eq "" || $href eq "n/a";

        # Stored href is relative to output root.
        # Detailed sample reports are in outdir/report/samples/.
        $href = link_from_sample_report_to_outpath($href);

        my $safe_href = encode_entities($href);
        my $safe_text = encode_entities($label);

        my $type = $link->{type} // "";
        my $icon = detailed_report_link_icon($type);

        my $link_html = qq{<a href="$safe_href">$icon $safe_text</a>};

        $html .= detailed_report_raw_row(
            $label,
            $link_html
        );
    }

    $html .= "</tbody>\n";
    $html .= "</table>\n";

    return $html;
}


sub detailed_report_build_sample_report {
    my ($samplenr) = @_;

    my $sample = $R_samples->[$samplenr];
    return "" if !defined $sample;

    my $R_report_def = get_detailed_report_def();

   

    my $html = "";

    $html .= short_report_section_sample_summary($sample, overview_helpers());
    $html .= short_report_section_sample_files($sample, overview_helpers());

    foreach my $runstep_name (@{ get_detailed_report_runstep_order() }) {

        # chewbbaca's report section is hand-written (variable-length,
        # per-scheme tables that the flat fields/links format can't express)
        # rather than driven by a fields/links definition -- handled here,
        # at its actual position in the order list, rather than appended
        # unconditionally after this loop regardless of where the order
        # list places it.
        if ($runstep_name eq 'chewbbaca') {
            $html .= detailed_report_section_chewbbaca($sample);
            next;
        }

        if (!exists $R_report_def->{$runstep_name}) {
            #log_message("WARNING: Detailed report: no report definition for [$runstep_name]");
            next;
        }

        if (!exists $sample->{results}{$runstep_name}) {
            #log_message("WARNING: Detailed report: no results stored for [$runstep_name] in sample [" . ($sample->{name} // "n/a") . "]");
            next;
        }

        my $section_html = detailed_report_runstep_section(
            $sample,
            $runstep_name,
            $R_report_def->{$runstep_name}
        );

        $html .= $section_html;
    }

    return $html;
}



sub print_sample_detailedreports {

    my $number_samples = scalar @$R_samples;

    my $env_path      = $ENV{CONDA_PREFIX} // "";
    my $env_path_base = $env_path;
    $env_path_base =~ s{/[^/]*$}{};
    $env_path_base =~ s{/[^/]*$}{};

    my $template_file = "$env_path_base/share/eurlc-wgs/templates/detailed_report.html.tt";

    my $samples_dir = get_report_samples_dir();

    ensure_dir($samples_dir);

    open my $tfh, '<', $template_file
        or graceful_die("Could not open template $template_file: $!");
    my $template_content = do { local $/; <$tfh> };
    close $tfh;

    log_message("NOTICE: Printing detailed HTML reports for $number_samples samples");

    for (my $i = 0; $i < $number_samples; $i++) {

        my $sample = $R_samples->[$i];
        my $sample_name_raw = $sample->{name} // "sample_$i";
        my $sample_name     = encode_entities($sample_name_raw);

        my $content = detailed_report_build_sample_report($i);

        my $report_html = $template_content;

        # Paths are relative from report/samples/*.html
        $report_html =~ s/\Q{{css_file}}\E/..\/assets\/style.css/g;
        $report_html =~ s/\Q{{main_css_file}}\E/..\/assets\/mainreport.css/g;
        $report_html =~ s/\Q{{pipeline_logo_file}}\E/..\/assets\/eurlc-wgs-logo.png/g;
        $report_html =~ s/\Q{{favicon_file}}\E/..\/assets\/favicon.png/g;

        $report_html =~ s/\Q{{sample_info.sample_name}}\E/$sample_name/g;
        $report_html =~ s/\Q{{sample_report_content}}\E/$content/g;

        my $outfile = "$samples_dir/${sample_name_raw}_detailed_report.html";

        open my $fh, '>', $outfile or do {
            log_message("ERROR: Could not write detailed report $outfile", "red");
            next;
        };

        print $fh $report_html;
        close $fh;

        log_message("INFO: Detailed HTML report written to $outfile", "green");
    }

    return 1;
}



######################################################################################################
sub print_to_shortsummary(){


 
 # Define which measures to include
    my @filter_measures = (  'fastmlst.st',
                             'fastmlst.cc',
                             'ST-status',
                             'Species',
                             'fastp_post.summary.after_filtering.q30_rate',
                             'Q30_depth',
                             'fastp_post.summary.after_filtering.meanNrate',  
                             'fastp_pre.summary.sequencing',
                             'mean_readlength',
                             'Contamination_rate',
                             'Largest_Contaminant',
                             'quast_main.contigs_500+',
                             'quast_main.length_500+',
                             'quast_main.N50',
                             'quast_main.GC',
                             'checkm_main.completyeness', 
                             'checkm_main.contamination',
                             'cgmlst',
                             'fastmlst.alleles',
                             'overall_QC_status'); 

    open(HANDLE_QCSUMMARY,">" . getdir("out,results,qc") . "/results_summary.tab") || graceful_die("could not create file " . getdir("out,results,qc") .  "/results_summary.tab");

    # Print header: "Sample\tMeasure1\tMeasure2\t...\n"
    print HANDLE_QCSUMMARY "Sample";
    foreach my $measure (@filter_measures) {
        my $out = $measure;
        if($measure eq 'fastmlst.st') { $out = "ST"; }
        if($measure eq 'fastmlst.cc') { $out = "CC"; }
        if($measure eq 'fastp_post.summary.after_filtering.q30_rate') { $out = "Q30_rate"; }
        if($measure eq 'fastp_post.summary.after_filtering.q30_rate') { $out = "Q30_rate"; }
        if($measure eq 'fastp_post.summary.after_filtering.meanNrate') { $out = "mean_Nrate"; }
        if($measure eq 'quast_main.contigs_500+') { $out = "assembly_contigs"; }
        if($measure eq 'quast_main.length_500+') { $out = "assembly_size"; }
        if($measure eq 'quast_main.N50') { $out = "assembly_N50"; }
        if($measure eq 'quast_main.GC') { $out = "assembly_GC"; }
        if($measure eq 'fastp_pre.summary.sequencing') { $out = "sequencing_cycles"; }
        if($measure eq 'Species') { $out = "Species\tSpecies_status"; }
        if($measure eq 'cgmlst') { $out = "cgMLST_called_alleles\tcgMLST_problematic\tcgMLST_found_percent\tcgMLST_exact_percent\tcgMLST_paralgous"; }
        if($measure eq 'checkm_main.completyeness') { $out = "checkm_complete"; }
        if($measure eq 'checkm_main.contamination') { $out = "checkm_cont"; }
        
        print HANDLE_QCSUMMARY "\t$out";
    }
    print HANDLE_QCSUMMARY "\n";

    # Print one row per sample
    for (my $i = 0; $i < @$R_samples; $i++) {
        my $sample = $R_samples->[$i]{name};
        print HANDLE_QCSUMMARY "$sample";

        foreach my $measure (@filter_measures) {
            # straight forward meassures
            if (exists $result_summary{$measure}) {
                my @values = @{ $result_summary{$measure} };
                print HANDLE_QCSUMMARY "\t$values[$i]";
                #print "[\t$values[$i]]\n";
             }   
            # special cases 
            elsif($measure eq 'overall_QC_status') {
            }
            elsif($measure eq 'Q30_depth') {
            my @values_bases = @{ $result_summary{'fastp_pre.summary.after_filtering.q30_bases'} } ;
            my @values_sizes =  @{ $result_summary{'quast_main.length_500+'} } ;
            my $Q30_depth = int($values_bases[$i]/$values_sizes[$i]);
              print HANDLE_QCSUMMARY "\t$Q30_depth" . "X";
            }
            elsif($measure eq 'mean_readlength') {
            my @values_R1 = @{ $result_summary{'fastp_post.summary.after_filtering.read1_mean_length'} } ;
            my @values_R2 =  @{ $result_summary{'fastp_post.summary.after_filtering.read2_mean_length'} } ;
            my $mean_rlen = int( ($values_R1[$i]+$values_R2[$i])/2 );
              print HANDLE_QCSUMMARY "\t$mean_rlen";
            }
            elsif($measure eq 'Contamination_rate') {
            my @values_kraken = ();
            my $genus="NA"; my $rate="NA";
            if($R_cfg->{"run_kraken2"} eq "yes" ) {   @values_kraken = @{ $result_summary{'kraken2_bracken.kraken2_genus_2'} } ; ($genus,$rate) = split( /=/,$values_kraken[$i] ); }
            
             print HANDLE_QCSUMMARY "\t$rate\t$genus";
             #print "[\t$rate\t$genus]\n";
            }
            elsif($measure eq 'Largest_Contaminant') {
              ; #do nothing (already handled above)            
            }
            elsif($measure eq 'ST-status') {
            my @values_full = @{ $result_summary{'fastmlst.nrFullMatch'} };
            my @values_novel = @{ $result_summary{'fastmlst.nrNovel'} };
            
            my $status = "FAIL";
            if($values_full[$i] == 7) { $status = "OK"; }
            elsif( ($values_full[$i] + $values_novel[$i]) == 7 ) { $status = "NOVEL"; }
            
             print HANDLE_QCSUMMARY "\t$status";
            }
            elsif($measure eq 'cgmlst') {
            my @values_exact = @{ $result_summary{'chewbbaca_pubmlst_campy_cg_v2.exact'} };
            my @values_exact_inf = @{ $result_summary{'chewbbaca_pubmlst_campy_cg_v2.exact_and_inferred'} };
            my @values_problematic = @{ $result_summary{'chewbbaca_pubmlst_campy_cg_v2.problematic_loci'} };
            my @values_NIPH = @{ $result_summary{'chewbbaca_pubmlst_campy_cg_v2.niph'} };
            my @values_NIPHEM = @{ $result_summary{'chewbbaca_pubmlst_campy_cg_v2.niphem'} };
            
            my $called = $values_exact_inf[$i];
            my $problematic = $values_problematic[$i];
            my $exact =  $values_exact[$i];
            my $paralog =  $values_exact[$i];
            my $NIPH = $values_NIPH[$i];
            my $NIPHEM = $values_NIPHEM[$i];
            
            my $found_percent = 0;
            my $exact_percent = 0;
            print "$called, $problematic\n";
            if( ($called+$problematic)>=0 && ($called ne "NA" && $problematic ne "NA") ){
              $found_percent = $called/($called+$problematic)*100;
              $exact_percent =  $exact/($called+$problematic)*100;
            }
            my $parlogs = $NIPH+$NIPHEM;
            
             print HANDLE_QCSUMMARY "\t$called\t$problematic\t$found_percent\t$exact_percent\t$parlogs";
            }
            elsif($measure eq 'Species') {
            my @values_kraken = ();
            my @values_mash = ();
            my $status  = "NA";
            my $status_expl  = "";
            my $sp_kraken = "";  my $sp_mash = "";
            my $score_kraken = "";  my $score_mash = "";
            
            if($R_cfg->{kraken2}->{enabled} ) {   @values_kraken = @{ $result_summary{'kraken2_bracken.kraken2_species_1'} } ; ($sp_kraken,$score_kraken) = split( /=/,$values_kraken[$i] ); }
            if($R_cfg->{mashscreen}->{enabled}  ) {  @values_mash =  @{ $result_summary{'mashscreen.mash_hitscore_1'} } ; ($sp_mash,$score_mash) = split( /=/,$values_mash[$i] ); }
            
            if($sp_kraken eq "") { $sp_kraken = "NA"; }
            if($sp_mash eq "") { $sp_mash = "NA"; }
          
            if( $sp_kraken ne "NA"  && $sp_mash ne "NA" && $sp_kraken ne $sp_mash ) { $status = "WARNING"; $status_expl = "disamb. result" }

       
            
           # if($score_kraken < $R_cfg->{"bracken_species_treshold"} ) { $status = "WARNING"; $status_expl .= " low score" }
   
            my $species = "";
            
            if($sp_kraken ne "") { $species  = $sp_kraken; }
            if($species eq "" && $sp_mash ne "") { $species  = $sp_mash; }

            
            if($species ne "" && $status eq "NA") { $status = "OK"; }
            
            print HANDLE_QCSUMMARY "\t$species\t$status";
            
            if($status_expl ne "") { print HANDLE_QCSUMMARY " ($status_expl)"; }
            
            }
      
            # meassure not found 
             else {
                print HANDLE_QCSUMMARY "\tNA";  # If the measure is missing
                print "MISSING:[$measure]\n";
            }
        }

        print HANDLE_QCSUMMARY "\n";
    }

    close(HANDLE_QCSUMMARY);

}
####################################################################################################

sub check_conda_env_and_programs {
    my ($env, @programs) = @_;

    # 1. Conda must exist (already validated fatally at startup -- see get_conda_base()
    # and the "conda" registry root -- so just confirm the registry has it, no need to
    # re-shell-out to `which conda` here).
    return -3 if peekdir("conda") eq "";

    # 2. Check env exists
    my @envs = `conda env list 2>/dev/null`;
    my $env_exists = 0;
    for my $line (@envs) {
        if ($line =~ /^\s*\Q$env\E(\s|$)/) {
            $env_exists = 1;
            last;
        }
    }
    return -1 unless $env_exists;

    # 3. Check programs (expanded via the shared expand_tool_checks/run_tool_check
    #    helpers -- same logic used by validate_tool_installation(), so there is one
    #    definition of "what counts as installed" for a tool, not two.)
    for my $prog (@programs) {
        my @checks = expand_tool_checks($prog);
        return -2 unless @checks;  # empty = config problem already logged by expand_tool_checks
        for my $check (@checks) {
            return -2 unless run_tool_check($env, $check);
        }
    }

    return 1;
}
#########################################################################################################

###################################################################################################
## Strict version checking, auto-repair, and fingerprint caching for conda environments.
##
## Default behavior (no "version_check" set on a tool) is unchanged: a tool is
## considered fine as long as its program/test_command runs (see
## expand_tool_checks/run_tool_check above). Setting version_check => "strict"
## on a tool additionally requires that every package=version pin in its
## resolved YAML file (see find_env_yml) is actually installed in the env --
## not just "the program runs", but "the program runs at the exact pinned
## version". On a mismatch, the env is removed and recreated from the YAML.
##
## Because comparing against the live conda env is the slow part (conda list/
## conda run all have real startup overhead), a successful strict check is
## cached, keyed by a hash of the YAML file's content. As long as the YAML
## hasn't changed and the cache isn't older than general.cache_max_age_days,
## later runs trust the cache instead of re-querying conda. Set
## cache_max_age_days => 0 to disable caching entirely (always re-check).
##
## Known limitation: only top-level "- package=version" lines under
## "dependencies:" are parsed. A nested "- pip:" sub-list (pip-installed
## packages inside a conda yml) is recognized and skipped, not parsed --
## pip-only pins are not checked.
###################################################################################################

# Parses "- package=version" lines under the top-level "dependencies:" key of
# a conda environment YAML file. Returns a hash of { lowercased_package_name
# => version }. Packages listed without a version (e.g. "- python") are not
# included, since there's nothing pinned to check them against.
sub parse_yml_dependencies {
    my ($yml_file) = @_;
    my %pinned;

    open my $fh, '<', $yml_file or return %pinned;

    my $in_deps = 0;
    while (my $line = <$fh>) {
        chomp $line;

        if ($line =~ /^dependencies:\s*$/) {
            $in_deps = 1;
            next;
        }

        next unless $in_deps;

        # A non-indented line means we've left the dependencies: block
        if ($line =~ /^\S/) {
            $in_deps = 0;
            next;
        }

        # Skip a nested "- pip:" sub-list header (not parsed -- see limitation above)
        next if $line =~ /^\s*-\s*pip:\s*$/;

        if ($line =~ /^\s*-\s*([A-Za-z0-9_.\-]+)\s*=\s*([A-Za-z0-9_.\-]+)/) {
            $pinned{lc($1)} = $2;
        }
    }
    close $fh;

    return %pinned;
}

# Returns { lowercased_package_name => version } for everything currently
# installed in a conda env, via "conda list --json" (structured, easier and
# safer to parse than the human-readable default format).
sub get_installed_packages {
    my ($env) = @_;

    my $json_text = qx(conda list -n $env --json 2>/dev/null);
    return {} unless $json_text;

    my $data = eval { JSON::MaybeXS->new->decode($json_text) };
    return {} unless ref($data) eq 'ARRAY';

    my %installed;
    for my $pkg (@$data) {
        next unless ref($pkg) eq 'HASH' && defined $pkg->{name};
        $installed{lc($pkg->{name})} = $pkg->{version} // '';
    }

    return \%installed;
}

# Compares a conda env's actually-installed package versions against the
# pinned versions in a YAML file. Returns (1, "...") if every pin is matched
# (or there was nothing pinned to check), or (0, "...") describing the first
# problem found, listing every mismatch/missing package.
# Conda's own semantics for "package=X.Y" in a yml: a short version pin
# matches any installed version sharing those leading components (e.g.
# "3.10" matches installed "3.10.4") -- conda treats it as "3.10.*". This is
# deliberately component-wise (split on ".", compare each component as a
# whole string), not a substring match -- "3.3.10" must NOT match an
# installed "3.3.100" just because the text "3.3.10" is a string-prefix of
# "3.3.100"; component-wise correctly tells these apart ("10" ne "100").
sub version_pin_matches {
    my ($want, $have) = @_;
    return 0 unless defined $want && defined $have && $want ne '' && $have ne '';

    my @want_parts = split /\./, $want;
    my @have_parts = split /\./, $have;
    return 0 if @have_parts < @want_parts;

    for my $i (0..$#want_parts) {
        return 0 if $want_parts[$i] ne $have_parts[$i];
    }
    return 1;
}

sub env_matches_yml {
    my ($env, $yml_file) = @_;

    return (0, "YAML file not found: $yml_file") unless -f $yml_file;

    my %pinned = parse_yml_dependencies($yml_file);
    return (1, "no pinned versions in YAML -- nothing to check") unless %pinned;

    my $installed = get_installed_packages($env);
    return (0, "could not query installed packages for env [$env]") unless %$installed;

    my @mismatches;
    for my $pkg (sort keys %pinned) {
        my $want = $pinned{$pkg};
        my $have = $installed->{$pkg};

        if (!defined $have) {
            push @mismatches, "$pkg: required $want, not installed";
        }
        elsif (!version_pin_matches($want, $have)) {
            push @mismatches, "$pkg: required $want, found $have";
        }
    }

    return @mismatches
        ? (0, join("; ", @mismatches))
        : (1, "all pinned versions match");
}

# Removes and recreates a tool's conda env from its YAML, to fix a version
# mismatch. Reuses ensure_conda_tool()'s existing create-from-YAML path;
# auto=1 since reaching this point already means an automatic repair was
# decided on (the tool opted into version_check => "strict"), not something
# to additionally prompt the user about.
sub reinstall_conda_tool {
    my ($toolname) = @_;

    my $cfg = $R_cfg->{$toolname} // {};
    my $env = $cfg->{env};
    return 0 unless $env;

    log_message("NOTICE: Removing conda env '$env' to reinstall with the required pinned versions...", "yellow");
    system("conda", "env", "remove", "-n", $env, "-y");
    if ($? != 0) {
        log_message("ERROR: Failed to remove conda env '$env' for reinstall", "red");
        return 0;
    }

    return ensure_conda_tool($toolname, 1);
}

# ---------------------------------------------------------------------
# Fingerprint cache: avoids re-querying conda for a tool whose YAML hasn't
# changed since it last passed a strict version check.
# ---------------------------------------------------------------------

sub get_validation_cache_path {
    return getdir("db") . "/.env_validation_cache.json";
}

sub hash_file {
    my ($path) = @_;
    open my $fh, '<', $path or return undef;
    local $/;
    my $content = <$fh>;
    close $fh;
    return sha256_hex($content);
}

sub load_validation_cache {
    my $path = get_validation_cache_path();
    return {} unless -f $path;

    my $json_text = eval {
        open my $fh, '<:encoding(UTF-8)', $path or return undef;
        local $/;
        my $txt = <$fh>;
        close $fh;
        $txt;
    };
    return {} unless defined $json_text;

    my $data = eval { JSON::MaybeXS->new->decode($json_text) };
    return (ref($data) eq 'HASH') ? $data : {};
}

sub save_validation_cache {
    my ($cache) = @_;
    my $path = get_validation_cache_path();

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);
    open my $fh, '>:encoding(UTF-8)', $path or do {
        log_message("WARNING: Could not write version validation cache [$path]: $!", "yellow");
        return 0;
    };
    print $fh $json->encode($cache);
    close $fh;
    return 1;
}

# True if a cached "OK" result exists for this tool, the YAML hash matches
# (i.e. the YAML hasn't changed since that check), and the cache entry isn't
# older than $max_age_days. max_age_days <= 0 disables the cache entirely.
sub validation_cache_is_fresh {
    my ($toolname, $yml_hash, $max_age_days) = @_;

    return 0 if !defined $max_age_days || $max_age_days <= 0;

    my $cache = load_validation_cache();
    my $entry = $cache->{$toolname} or return 0;

    return 0 unless ($entry->{yml_hash} // '') eq $yml_hash;

    my $age_seconds     = time() - ($entry->{validated_at_epoch} // 0);
    my $max_age_seconds = $max_age_days * 86400;

    return $age_seconds <= $max_age_seconds;
}

sub update_validation_cache {
    my ($toolname, $yml_hash) = @_;

    my $cache = load_validation_cache();
    $cache->{$toolname} = {
        yml_hash           => $yml_hash,
        validated_at_epoch => time(),
        validated_at_local => timestamp_local(),
    };
    save_validation_cache($cache);
}

# Top-level entry point: call this for any tool, regardless of whether
# version_check => "strict" is set. Returns 1 immediately (no-op) unless it
# is. When it is: checks the fingerprint cache first; on a cache miss,
# compares the env against its YAML, auto-repairs (remove + recreate) on a
# mismatch, and re-checks once. Returns 0 only if the tool still doesn't
# match after a repair attempt.
sub ensure_tool_version {
    my ($toolname) = @_;

    my $cfg = $R_cfg->{$toolname} // {};
    return 1 unless lc($cfg->{version_check} // '') eq 'strict';

    my $env = $cfg->{env};
    if (!$env) {
        log_message("WARNING: version_check=strict set for '$toolname' but no env defined; skipping version check", "yellow");
        return 1;
    }

    my $yml_file = find_env_yml($cfg);
    if (!$yml_file) {
        log_message("WARNING: version_check=strict set for '$toolname' but no YAML found to check against; skipping version check", "yellow");
        return 1;
    }

    my $yml_hash = hash_file($yml_file);
    if (!defined $yml_hash) {
        log_message("WARNING: Could not read YAML [$yml_file] to compute its fingerprint; skipping version check", "yellow");
        return 1;
    }

    my $max_age_days = $R_cfg->{general}{cache_max_age_days} // 7;

    if ( validation_cache_is_fresh($toolname, $yml_hash, $max_age_days) ) {
        log_message("INFO: $toolname version check skipped (cached result still fresh, YAML unchanged)");
        return 1;
    }

    my ($ok, $detail) = env_matches_yml($env, $yml_file);

    if ($ok) {
        log_message("INFO: $toolname version check OK: $detail");
        update_validation_cache($toolname, $yml_hash);
        return 1;
    }

    log_message("WARNING: $toolname version mismatch: $detail", "red");
    log_message("NOTICE: Attempting automatic reinstall to match required pinned versions...");

    return 0 unless reinstall_conda_tool($toolname);

    my ($ok2, $detail2) = env_matches_yml($env, $yml_file);

    if ($ok2) {
        log_message("NOTICE: $toolname version check OK after reinstall: $detail2", "green");
        update_validation_cache($toolname, $yml_hash);
        return 1;
    }

    log_message("ERROR: $toolname still does not match required pinned versions after reinstall: $detail2", "red");
    return 0;
}

sub find_env_yml {
    my ($tool_cfg) = @_;

    my $yml = $tool_cfg->{yml} // "";
    return "" if $yml eq "";

    # Absolute path
    return $yml if $yml =~ m{^/} && -f $yml;

    my @candidates;

    # User/database override
    my $db_dir = get_db_dir();
    push @candidates, "$db_dir/envs/$yml" if $db_dir ne "";

    # Installed defaults
    my $conda_base = get_conda_base();
    push @candidates, "$conda_base/share/eurlc-wgs/envs/$yml" if $conda_base ne "";

    foreach my $path (@candidates) {
        return $path if -f $path;
    }

    return "";
}

sub get_conda_base {

    my $conda_base = $ENV{CONDA_EXE} // "";

    if ($conda_base ne "") {
        $conda_base =~ s{/bin/conda$}{};
        return $conda_base if -d $conda_base;
    }

    my $cmd = "conda info --base";
    my $base = `$cmd 2>/dev/null`;
    chomp $base;

    return $base if defined $base && $base ne "" && -d $base;

    return "";
}

sub get_db_dir {
    return getdir("db");
}

