# ---------- Helper for color-coded logging ----------
sub print_tabular_results {
    my ($name, $value, $def_color) = @_;
    my $ucval = uc($value // '');
    $def_color //= "green";
     
    my $formatted_line = sprintf("%-35s : %-10s", $name, $value);
    
   log_message("NOTICE: $formatted_line", $def_color);
 
}

#==================================================
sub write_json_file {
    my ($data_ref, $json_path) = @_;

    # sanity checks
    unless (ref($data_ref) eq 'HASH') {
        log_message("WARNING: write_json_file expected a hash reference");
        return 0;
    }

    # Create JSON encoder (pretty print + UTF-8)
    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);

    # Try to open the output file
    my $fh;
    unless (open $fh, '>', $json_path) {
        log_message("WARNING: Could not write JSON file '$json_path': $!");
        return 0;
    }

    # Print the JSON data
    print $fh $json->encode($data_ref);
    close $fh;

    log_message("INFO: JSON results written to $json_path");
    return 1;  # success
}

#==================================================

sub read_json_file {
    my ($json_path) = @_;

    # Check if file exists and is readable
    unless (-f $json_path) {
        log_message("WARNING: JSON file not found: $json_path");
        return undef;
    }

    # Try to open and read the file
    open my $fh, '<', $json_path or do {
        log_message("WARNING: Could not open JSON file '$json_path': $!");
        return undef;
    };

    local $/;  # slurp mode
    my $json_text = <$fh>;
    close $fh;

    # Decode JSON into Perl structure
    my $data_ref;
    eval {
        $data_ref = decode_json($json_text);
        1;
    } or do {
        my $err = $@ || "Unknown error";
        log_message("WARNING: Failed to parse JSON from '$json_path': $err");
        return undef;
    };

    return $data_ref;  # return hash reference
}
#==================================================
# Lightweight INI Parser (replacement for Config::IniFiles)
#==================================================

sub read_ini_file {
    my ($path) = @_;
    my %data;
    my $current_section = '';
    my $lineno = 0;

    open my $fh, '<', $path or do {
        log_message("WARNING: Could not open config file [$path]: $!");
        return {};
    };

    while (my $line = <$fh>) {
        $lineno++;
        chomp $line;
        $line =~ s/^\s+|\s+$//g;     # trim
        next if $line =~ /^#/ || $line =~ /^;/ || $line eq '';  # skip comments and empty lines

        # Section header
        if ($line =~ /^\[(.+?)\]$/) {
            $current_section = lc $1;
            $data{$current_section} ||= {};
            next;
        }

        # Key=value line
        if ($line =~ /^([^=]+?)\s*=\s*(.*)$/) {
            my ($key, $value) = (lc $1, $2);
            if ($current_section eq '') {
                log_message("WARNING: Config file [$path] line $lineno: '$key=$value' appears before any [section] header and will be ignored", "red");
            }
            else {
                $data{$current_section}{$key} = $value;
            }
            next;
        }

        # Anything else didn't match a comment, section header, or key=value
        # line -- most likely a typo (missing "=", a malformed [section]
        # line missing its closing bracket, stray text after "]", etc.). The
        # old version of this function silently dropped lines like this with
        # no feedback at all; flag it so a misconfigured file is noticed
        # instead of quietly doing nothing.
        log_message("WARNING: Config file [$path] line $lineno: could not parse, ignoring: [$line]", "red");
    }
    close $fh;
    return \%data;
}

#==================================================
# Replacement for $cfg->val($section, $key)
#==================================================
sub ini_val {
    my ($ini, $section, $key, $default) = @_;
    return $default unless ref($ini) eq 'HASH';
    return exists $ini->{lc $section}{lc $key} ? $ini->{lc $section}{lc $key} : $default;
}



###########################

sub analyze_assembly_stats {
    my ($fasta_path) = @_;
    
    if( ! -f $fasta_path) {
        log_message("WARNING: Fasta file do not exist [$fasta_path]: $!");
        return {};
    }
    my $fh;
    open $fh, '<', $fasta_path or do {
        log_message("WARNING: Could not open fasta file [$fasta_path]: $!");
        return {};
    };
    

    my @contigs;
    my $seq = '';
    my ($header, $gc_count, $n_count) = ('', 0, 0);

    while (<$fh>) {
        chomp;
        if (/^>(.+)/) {
            # store previous contig if exists
            if ($seq ne '') {
                push @contigs, { header => $header, seq => $seq };
                $seq = '';
            }
            $header = $1;
        }
        else {
            $seq .= $_;
        }
    }
    push @contigs, { header => $header, seq => $seq } if $seq ne '';
    close $fh;

    graceful_die("No sequences found in FASTA file: $fasta_path") unless @contigs;
    if( ! @contigs) {
        log_message("WARNING: No sequences found in FASTA file: [$fasta_path]");
        return {};
    }
    
    my @lengths;
    my @lengths_gt500;
    my $total_len = 0;
    my $total_len_gt500 = 0;
    my ($total_gc, $total_n) = (0, 0);
    my ($weighted_cov_sum, $weighted_len_sum) = (0, 0);

    foreach my $contig (@contigs) {
        my $seq = uc($contig->{seq});
        my $len = length($seq);
        next if $len == 0;

        push @lengths, $len;
        $total_len += $len;

        if ($len >= 500) {
            push @lengths_gt500, $len;
            $total_len_gt500 += $len;
        }

        my $gc = ($seq =~ tr/GC//);
        my $n  = ($seq =~ tr/N//);
        $total_gc += $gc;
        $total_n  += $n;

        if ($contig->{header} =~ /_cov_([\d\.]+)/) {
            my $cov = $1;
            if (looks_like_number($cov)) {
                $weighted_cov_sum += $cov * $len;
                $weighted_len_sum += $len;
            }
        }
    }

    my $nr_contigs = scalar @lengths;
    my $nr_contigs_gt500 = scalar @lengths_gt500;
    my $largest_contig = max(@lengths);
    my $gc_content = $total_gc / $total_len * 100;
    my $nr_n_per_100kb = ($total_n / $total_len) * 100_000;

    # Compute coverage (weighted by contig length)
    my $total_coverage = 0;
    $total_coverage = $weighted_cov_sum / $weighted_len_sum if $weighted_len_sum > 0;

    # Compute N50, N90, L50, L90
    my ($n50, $n90, $l50, $l90) = compute_nxx(\@lengths);

    return {
        nr_contigs              => $nr_contigs,
        nr_contigs_largerthan_500 => $nr_contigs_gt500,
        total_length            => $total_len,
        total_length_largerthan_500 => $total_len_gt500,
        largest_contig          => $largest_contig,
        gc_content              => sprintf("%.2f", $gc_content),
        n50                     => $n50,
        n90                     => $n90,
        l50                     => $l50,
        l90                     => $l90,
        nr_n_per_100kb          => sprintf("%.2f", $nr_n_per_100kb),
        total_coverage          => sprintf("%.2f", $total_coverage),
    };
}

###########################

sub compute_nxx {
    my ($lengths_ref) = @_;
    my @sorted = sort { $b <=> $a } @$lengths_ref;
    my $total = sum(@sorted);
    my ($n50, $n90, $l50, $l90) = (0, 0, 0, 0);
    my ($cum, $i) = (0, 0);

    for my $len (@sorted) {
        $cum += $len;
        $i++;
        if (!$n50 && $cum >= 0.5 * $total) { $n50 = $len; $l50 = $i; }
        if (!$n90 && $cum >= 0.9 * $total) { $n90 = $len; $l90 = $i; last; }
    }

    return ($n50, $n90, $l50, $l90);
}


###########################

# ---------------------------------------------------------------------
# Save @{ $rundata{samples} } → JSON file
# ---------------------------------------------------------------------
sub save_samples_results {
    my ($filepath, $samples_ref) = @_;

    my $json = JSON::MaybeXS->new->pretty->canonical->utf8;

    # Ensure directory exists
    my $dir = dirname($filepath);
    unless (-d $dir) {
        graceful_die("Directory $dir does not exist, cannot save samples results");
    }

    # Write atomically
    my $tmp = "$filepath.tmp";

    open my $fh, ">:encoding(UTF-8)", $tmp
        or graceful_die("Cannot write to $tmp: $!");

    print $fh $json->encode($samples_ref);
    close $fh;

    move($tmp, $filepath)
        or graceful_die("Cannot rename $tmp -> $filepath: $!");

    return 1;
}

# ---------------------------------------------------------------------
# Load @{ $rundata{samples} } ← JSON file
# ---------------------------------------------------------------------
sub load_samples_results {
    my ($filepath) = @_;

    my $json = JSON::MaybeXS->new->utf8;

    return [] unless -e $filepath;   # No file, return empty dataset

    open my $fh, "<:encoding(UTF-8)", $filepath
        or graceful_die("Cannot read $filepath: $!");

    local $/;
    my $txt = <$fh>;
    close $fh;

    my $data = $json->decode($txt);

    # Must be an array
    if (ref $data ne 'ARRAY') {
        graceful_die("samples_results.json does not contain an array");
    }

    return $data;
}

# ---------------------------------------------------------------------
# Save %rundata → JSON file
# ---------------------------------------------------------------------
sub save_hash_as_json {
    my ($filepath, $hash_ref) = @_;

    my $json = JSON::MaybeXS->new->pretty->canonical->utf8;
    my $tmp  = "$filepath.tmp";

    my $dir = dirname($filepath);
    graceful_die("Directory $dir does not exist") unless -d $dir;

    open my $fh, ">:encoding(UTF-8)", $tmp
        or graceful_die("Cannot write to $tmp: $!");

    print $fh $json->encode($hash_ref);
    close $fh;

    move($tmp, $filepath)
        or graceful_die("Cannot rename $tmp -> $filepath: $!");

    return 1;
}

# ---------------------------------------------------------------------
# Load dataset-level data from JSON → %rundata
# ---------------------------------------------------------------------
sub load_hash_from_json {
    my ($filepath) = @_;

    my $json = JSON::MaybeXS->new->utf8;

    return {} unless -e $filepath;

    open my $fh, "<:encoding(UTF-8)", $filepath
        or die "Cannot read $filepath: $!";

    local $/;
    my $txt = <$fh>;
    close $fh;

    my $data = $json->decode($txt);

    # Should be a hash
    if (ref $data ne 'HASH') {
        die "$filepath  does not contain a hash\n";
    }

    return $data;
}
###########################


sub generatereport(){

my $tt = Template->new({
    INCLUDE_PATH => 'templates',
    INTERPOLATE  => 1,
    ENCODING     => 'utf8',
    FILTERS      => {
        commify => sub {
            my $n = shift;
            1 while $n =~ s/^(-?\d+)(\d{3})/$1,$2/;
            return $n;
        }
    }
}) or graceful_die("Error creating template");   #die "$Template::ERROR\n";

# Example data (you would have this from your pipeline)
my $test_results = {
    summary => {
        before_filtering => { total_reads => 1_234_567, q30_rate => 92.5, gc_content => 48.3 },
        after_filtering  => { total_reads => 1_180_000, q30_rate => 94.1, gc_content => 48.5 },
    },
    filtering_result => {
        passed_filter_reads => 1180000,
        too_short_reads      => 3000,
        low_quality_reads    => 2000,
    },
};

# Add metadata
my $vars = {
    results => $test_results,
    generated => strftime("%Y-%m-%d %H:%M:%S", localtime),
    title => "EURL-C WGS QC Report",
};

$tt->process('layout.tt', $vars, 'report.html')
    or graceful_die($tt->error());

print "✅ Report generated: report.html\n";

}

sub path_relative_to_outdir {
    my ($path) = @_;

    return "" if !defined $path || $path eq "";

    my $outdir = getdir("out");
    $outdir =~ s{/$}{};

    $path =~ s{^\Q$outdir\E/}{};

    return $path;
}

sub link_from_sample_report_to_outpath {
    my ($out_relative_path) = @_;

    return "" if !defined $out_relative_path || $out_relative_path eq "";

    # sample reports are in outdir/report/samples/
    return "../../$out_relative_path";
}

sub link_from_main_report_to_outpath {
    my ($out_relative_path) = @_;

    return "" if !defined $out_relative_path || $out_relative_path eq "";

    # main report is in outdir/report/
    return "../$out_relative_path";
}


