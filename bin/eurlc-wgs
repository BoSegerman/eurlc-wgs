################################################################################
# Initialize a generic issue container
sub init_issue_container {
    return {
        status => "PASS",
        issues => {
            warning  => [],
            critical => [],
            fail     => [],
        },
    };
}

################################################################################
# Internal helper: validate severity
sub _is_valid_issue_severity {
    my ($severity) = @_;
    return defined $severity && $severity =~ /^(warning|critical|fail)$/ ? 1 : 0;
}

################################################################################
# Internal helper: map severity to status
sub _issue_severity_to_status {
    my ($severity) = @_;

    my %map = (
        warning  => "WARNING",
        critical => "CRITICAL",
        fail     => "FAIL",
    );

    return $map{$severity};
}

################################################################################
# Internal helper: compare statuses
sub _issue_status_rank {
    my ($status) = @_;

    my %rank = (
        PASS     => 0,
        WARNING  => 1,
        CRITICAL => 2,
        FAIL     => 3,
    );

    return exists $rank{$status} ? $rank{$status} : -1;
}

################################################################################
# Internal helper: push unique value to arrayref
sub _push_unique {
    my ($R_array, $value) = @_;

    return 0 if !defined $R_array || ref($R_array) ne 'ARRAY';
    return 0 if !defined $value || $value eq "";

    if (!grep { $_ eq $value } @$R_array) {
        push @$R_array, $value;
        return 1;
    }

    return 0;
}

################################################################################
# Internal helper: ensure issue container structure
sub _ensure_issue_container {
    my ($R_container) = @_;

    return 0 if !defined $R_container || ref($R_container) ne 'HASH';

    $R_container->{status} ||= "PASS";
    $R_container->{issues} ||= {};

    for my $sev (qw(warning critical fail)) {
        $R_container->{issues}{$sev} ||= [];
    }

    return 1;
}

################################################################################
# Core helper: add issue to one issue container
sub add_issue_to_container {
    my ($R_container, $severity, $message) = @_;

    if (!defined $R_container || ref($R_container) ne 'HASH') {
        log_message("WARNING: add_issue_to_container called with invalid container");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: add_issue_to_container got invalid severity [$severity]");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: add_issue_to_container called with empty message");
        return 0;
    }

    _ensure_issue_container($R_container);

    _push_unique($R_container->{issues}{$severity}, $message);

    my $new_status = _issue_severity_to_status($severity);

    if (_issue_status_rank($new_status) > _issue_status_rank($R_container->{status})) {
        $R_container->{status} = $new_status;
    }

    return 1;
}

################################################################################
# Reset all report issues for one sample
sub reset_report_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: reset_report_issues called with invalid samplenr");
        return 0;
    }

    $R_samples->[$samplenr]{report_issues} = {
        by_category => {
            taxonomy      => init_issue_container(),
            typing        => init_issue_container(),
            contamination => init_issue_container(),
            assembly      => init_issue_container(),
            qscore        => init_issue_container(),
            coverage      => init_issue_container(),
        },
        summary => init_issue_container(),
    };

    return 1;
}

################################################################################
# Reset runtime issues for one sample
sub reset_runtime_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: reset_runtime_issues called with invalid samplenr");
        return 0;
    }

    $R_samples->[$samplenr]{runtime_issues} = init_issue_container();
    $R_samples->[$samplenr]{fatal_error} = 0;
    $R_samples->[$samplenr]{fatal_error_message} = [];
    $R_samples->[$samplenr]{fatal_error_runstep} = "";

    return 1;
}

################################################################################
# Ensure a report issue category exists
sub ensure_report_issue_category {
    my ($samplenr, $category) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: ensure_report_issue_category called with invalid samplenr");
        return 0;
    }

    if (!defined $category || $category eq "") {
        log_message("WARNING: ensure_report_issue_category called without category (sample $samplenr)");
        return 0;
    }

    $R_samples->[$samplenr]{report_issues} ||= {
        by_category => {},
        summary     => init_issue_container(),
    };

    $R_samples->[$samplenr]{report_issues}{by_category} ||= {};
    $R_samples->[$samplenr]{report_issues}{summary}     ||= init_issue_container();

    $R_samples->[$samplenr]{report_issues}{by_category}{$category} ||= init_issue_container();

    return 1;
}

################################################################################
# Add a runtime issue
# Use this during runsteps / parsing / missing required outputs / tool failures
sub set_runtime_issue {
    my ($samplenr, $severity, $message, $runstep_name) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: set_runtime_issue called with invalid samplenr");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: set_runtime_issue got invalid severity [$severity] (sample $samplenr)");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: set_runtime_issue called with empty message (sample $samplenr)");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];

    $sample->{runtime_issues} ||= init_issue_container();

    my $ok = add_issue_to_container($sample->{runtime_issues}, $severity, $message);
    return 0 if !$ok;

    if ($severity eq "fail") {
        $sample->{fatal_error} = 1;
        $sample->{fatal_error_message} ||= [];
        _push_unique($sample->{fatal_error_message}, $message);

        if (defined $runstep_name && $runstep_name ne "") {
            $sample->{fatal_error_runstep} = $runstep_name;
        }
    }

    return 1;
}

################################################################################
# Add a report issue
# Use this after QC evaluation when main_results have been populated
sub set_report_issue {
    my ($samplenr, $category, $severity, $message) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: set_report_issue called with invalid samplenr");
        return 0;
    }

    if (!defined $category || $category eq "") {
        log_message("WARNING: set_report_issue missing category (sample $samplenr)");
        return 0;
    }

    if (!_is_valid_issue_severity($severity)) {
        log_message("WARNING: set_report_issue got invalid severity [$severity] (sample $samplenr)");
        return 0;
    }

    if (!defined $message || $message eq "") {
        log_message("WARNING: set_report_issue called with empty message (sample $samplenr)");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];

    ensure_report_issue_category($samplenr, $category);

    add_issue_to_container($sample->{report_issues}{by_category}{$category}, $severity, $message);
    add_issue_to_container($sample->{report_issues}{summary},                $severity, $message);

    return 1;
}

################################################################################
# Optional compatibility layer:
# copy report summary into qc so older report code can continue to work
sub sync_qc_from_report_issues {
    my ($samplenr) = @_;

    if (!defined $samplenr || !defined $R_samples->[$samplenr]) {
        log_message("WARNING: sync_qc_from_report_issues called with invalid samplenr");
        return 0;
    }

    my $sample = $R_samples->[$samplenr];
    my $summary = $sample->{report_issues}{summary};

    if (!defined $summary || ref($summary) ne 'HASH') {
        log_message("WARNING: sync_qc_from_report_issues found no report summary for sample $samplenr");
        return 0;
    }

    _ensure_issue_container($summary);

    $sample->{qc} = {
        status => $summary->{status},
        issues => {
            warning  => [ @{ $summary->{issues}{warning}  || [] } ],
            critical => [ @{ $summary->{issues}{critical} || [] } ],
            fail     => [ @{ $summary->{issues}{fail}     || [] } ],
        },
    };

    return 1;
}

################################################################################
# Return overall status for one report category
sub get_report_category_status {
    my ($samplenr, $category) = @_;

    return "PASS" if !defined $samplenr || !defined $R_samples->[$samplenr];
    return "PASS" if !defined $category || $category eq "";

    my $R_cat = $R_samples->[$samplenr]{report_issues}{by_category}{$category};
    return "PASS" if !defined $R_cat || ref($R_cat) ne 'HASH';

    return $R_cat->{status} || "PASS";
}

################################################################################
# Return all issues for one report category
sub get_report_category_issues {
    my ($samplenr, $category) = @_;

    return init_issue_container() if !defined $samplenr || !defined $R_samples->[$samplenr];
    return init_issue_container() if !defined $category || $category eq "";

    my $R_cat = $R_samples->[$samplenr]{report_issues}{by_category}{$category};
    return init_issue_container() if !defined $R_cat || ref($R_cat) ne 'HASH';

    _ensure_issue_container($R_cat);
    return $R_cat;
}

################################################################################
# Return summary issue container for a sample
sub get_report_summary_issues {
    my ($samplenr) = @_;

    return init_issue_container() if !defined $samplenr || !defined $R_samples->[$samplenr];

    my $R_summary = $R_samples->[$samplenr]{report_issues}{summary};
    return init_issue_container() if !defined $R_summary || ref($R_summary) ne 'HASH';

    _ensure_issue_container($R_summary);
    return $R_summary;
}

sub set_sample_warning {
    my ($samplenr, $warningtype, $warningmessage, $category) = @_;

     $category   //= undef;
     
    ############################ 
    # Validate input (non-fatal)
    if (!defined $samplenr) {
        log_message("WARNING: set_sample_warning called without samplenr");
        return 0;
    }

    if (!defined $warningtype || $warningtype eq "") {
        log_message("WARNING: set_sample_warning missing warningtype (sample $samplenr)");
        return 0;
    }

    if (!defined $warningmessage || $warningmessage eq "") {
        log_message("WARNING: set_sample_warning missing warningmessage (sample $samplenr)");
        return 0;
    }

    my %valid_types = map { $_ => 1 } qw(warning critical fail);

    if (!$valid_types{$warningtype}) {
        log_message("WARNING: set_sample_warning unknown type [$warningtype] (sample $samplenr)");
        return 0;
    }

    my %type_to_status = (
        warning  => "WARNING",
        critical => "CRITICAL",
        fail     => "FAIL",
    );

    my %status_rank = (
        PASS     => 0,
        WARNING  => 1,
        CRITICAL => 2,
        FAIL     => 3,
    );

    ###############################
    # Ensure qc structure exists
    my $qc = $R_samples->[$samplenr]{qc};
    if (!defined $qc) {
        log_message("WARNING: QC structure missing for sample $samplenr, initializing");
        $qc = $R_samples->[$samplenr]{qc} = {};
    }

    # Ensure structure
    $qc->{status} //= "PASS";
    $qc->{issues} //= {};

    for my $t (qw(warning critical fail)) {
        $qc->{issues}{$t} //= [];
    }

    # Add message (avoid duplicates)
    my $arr = $qc->{issues}{$warningtype};
    if (!grep { $_ eq $warningmessage } @$arr) {
        push @$arr, $warningmessage;
    }

    # Upgrade overall status if needed
    my $new_status = $type_to_status{$warningtype};

    if (($status_rank{$new_status} // -1) > ($status_rank{$qc->{status}} // -1)) {
        $qc->{status} = $new_status;
    }


    return 1;
}


sub read_fastq_filelist {
    my ($run_data) = @_;

    my $file = getdir("out,log") . "/filelist_fastq.txt";
    open my $fh, '<', $file
        or graceful_die("could not open $file: $!");

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my ($R1, $R2, $base) = split /\t/, $line, 3;
        unless (defined $base) {
            log_message("WARNING: malformed line -> [$line], skipping");
            next;
        }

        for ($R1, $R2, $base) {
            $_ = "" unless defined $_;
            s/^\s+|\s+$//g;
        }

        $base = unique_basename($run_data, $base, $R1, $R2) // next;

        my $sample = new_sample_struct($base);

        my $has_R1 = ($R1 ne "" && -f $R1) ? 1 : 0;
        my $has_R2 = ($R2 ne "" && -f $R2) ? 1 : 0;
        my $R2_given = ($R2 ne "") ? 1 : 0;

        if ($has_R1 && $has_R2) {
            $sample->{type} = "PE";

            $sample->{paths}{raw}{R1} = $R1;
            $sample->{paths}{raw}{R2} = $R2;

            set_raw_file_metadata($sample, "R1", $R1);
            set_raw_file_metadata($sample, "R2", $R2);

            $sample->{paths}{trimmed}{R1} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_R1.fastq.gz";
            $sample->{paths}{trimmed}{R2} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_R2.fastq.gz";

            $sample->{paths}{downsampled}{R1} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_R1.fastq.gz";
            $sample->{paths}{downsampled}{R2} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_R2.fastq.gz";

            $sample->{paths}{unpaired}{R1} =
                getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R1.fastq.gz";
            $sample->{paths}{unpaired}{R2} =
                getdir("out,large_files,fastq,trimmed") . "/$base.unpaired_R2.fastq.gz";

            $run_data->{stats}{PE}++;
        }
        elsif ($has_R1 && !$R2_given) {
            $sample->{type} = "SE";

            $sample->{paths}{raw}{SE} = $R1;

            set_raw_file_metadata($sample, "SE", $R1);
            
            $sample->{paths}{trimmed}{SE} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_SE.fastq.gz";
            $sample->{paths}{downsampled}{SE} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_SE.fastq.gz";

            $run_data->{stats}{SE}++;
        }
        elsif ($has_R1 && $R2_given && !$has_R2) {
            log_message("WARNING: Sample $base: R1 exists but R2 is missing [$R2], treating sample as SE", "red");
            $sample->{type} = "SE";

            $sample->{paths}{raw}{SE} = $R1;

            set_raw_file_metadata($sample, "SE", $R1);
            
            $sample->{paths}{trimmed}{SE} =
                getdir("out,large_files,fastq,trimmed") . "/$base.t_SE.fastq.gz";
            $sample->{paths}{downsampled}{SE} =
                getdir("out,large_files,fastq,trimmed_downsampled") . "/$base.td_SE.fastq.gz";

            $run_data->{stats}{SE}++;
        }
        else {
            log_message("WARNING: Sample $base: no valid FASTQ files", "red");
            next;
        }

        my $idx = @{ $run_data->{samples} };
        push @{ $run_data->{samples} }, $sample;
        $run_data->{sample_index}{$base} = $idx;
        $run_data->{stats}{total}++;
    }

    close $fh;
}
sub read_fasta_filelist {
    my ($run_data) = @_;

    my $file = getdir("out,log") . "/filelist_fasta.txt";
    open my $fh, '<', $file
        or graceful_die("could not open $file: $!");

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my ($fasta, $base) = split /\t/, $line, 2;
        unless (defined $base) {
            log_message("WARNING: malformed line -> [$line], skipping");
            next;
        }

        for ($fasta, $base) {
            $_ = "" unless defined $_;
            s/^\s+|\s+$//g;
        }

        $base = unique_basename($run_data, $base, $fasta, "") // next;

        unless ($fasta ne "" && -f $fasta) {
            log_message("WARNING: Sample $base: FASTA missing [$fasta]", "red");
            next;
        }

        my $sample = new_sample_struct($base);
        $sample->{type} = "FASTA";
        $sample->{paths}{raw}{FASTA} = $fasta;

        set_raw_file_metadata($sample, "FASTA", $fasta);
        
        my $idx = @{ $run_data->{samples} };
        push @{ $run_data->{samples} }, $sample;
        $run_data->{sample_index}{$base} = $idx;

        $run_data->{stats}{FASTA}++;
        $run_data->{stats}{total}++;
    }

    close $fh;
}

sub set_raw_file_metadata {
    my ($sample, $slot, $path) = @_;

    my $meta = get_file_metadata($path);

    $sample->{rawdata_stats}{$slot}{created}  = $meta->{created};
    $sample->{rawdata_stats}{$slot}{modified} = $meta->{modified};
    $sample->{rawdata_stats}{$slot}{filesize} = $meta->{filesize};
}
####################################################################################################

use File::stat;   # NOTE: overrides bare stat() to return an object in scalar context for the rest of this file.
                  # Code below intentionally relies on this (e.g. $st->size, $st->mtime).
                  # Existing list-context stat() calls earlier in this file are unaffected.
                  # strftime is already imported globally at top of file; no need to re-import here.

sub get_file_metadata {
    my ($path) = @_;

    my %meta = (
        created  => "n/a",
        modified => "n/a",
        filesize => "n/a",
    );

    return \%meta unless defined $path && $path ne "" && -e $path;

    my $st = stat($path);
    return \%meta unless $st;

    # filesize in bytes
    $meta{filesize} = $st->size;

    # modification time is always available on normal Unix filesystems
    if (defined $st->mtime && $st->mtime > 0) {
        $meta{modified} = strftime("%Y-%m-%d %H:%M:%S", localtime($st->mtime));
    }

    # Try birth/creation time if available on this Perl/platform
    my $birth_time;
    eval {
        $birth_time = $st->can('birthtime') ? $st->birthtime : undef;
    };

    if (defined $birth_time && $birth_time > 0) {
        $meta{created} = strftime("%Y-%m-%d %H:%M:%S", localtime($birth_time));
    }
    elsif (defined $st->mtime && $st->mtime > 0) {
        # fallback if creation time is unavailable
        $meta{created} = $meta{modified};
    }

    return \%meta;
}



sub unique_basename {
    my ($run_data, $base, $R1, $R2) = @_;

    return $base unless exists $run_data->{sample_index}{$base};

    log_message("WARNING: duplicate name [$base], renaming...");

    my $counter  = 1;
    my $renamed;
    do {
        $renamed = "${base}_$counter";
        $counter++;
    } while (exists $run_data->{sample_index}{$renamed} && $counter < 100);

    if ($counter >= 100 && exists $run_data->{sample_index}{$renamed}) {
        log_message("ERROR: could not create unique name for [$base], skipping this entry");
        return;
    }

    log_message("NOTICE: [$R1,$R2] $base is renamed to $renamed");
    return $renamed;
}



####################################################################################################

sub get_bracken_readlength(){

  my $samplenr = shift(@_);

  my $sample_name = $R_samples->[$samplenr]{name};  
  my $sample_type = $R_samples->[$samplenr]{type}; 
  
  my $R1 = "";
  
  if($sample_type eq "PE") {
    $R1 = fill_placeholders("__R1__", $samplenr);
  }  
  if($sample_type eq "SE") {
    $R1 = fill_placeholders("__SE__", $samplenr);
  }
  if($sample_type eq "FASTA") {
    return 150;
  }
      
   if($R1 eq "") {  
      log_message("WARNING: no readlength data could be read from [$R1]...setting bracken readlength to 150");
      return 150;
   }
    my $current_readlength = "NA";
    if(lc(substr($R1,-3)) eq ".gz"){
    open(HANDLE_INFILEZ,"zcat $R1 |") || graceful_die("could not open file zcat $R1");
        my $counter = 0;
        my $part = 0;
        my $cumlen = 0;
        my $seqcounter = 0;
	while(<HANDLE_INFILEZ>){
		my $line = $_;
		chomp($line);
		$counter++; $part++;
		if($part>4) { $part=1 }
		if($part==2){ $cumlen = $cumlen + length($line); $seqcounter++; }		
		if ($counter > 1000) {last;}
		
	}
	close(HANDLE_INFILEZ);
	$current_readlength = $cumlen/$seqcounter;
     }
     else{
     open(HANDLE_INFILE,"$R1") || graceful_die("could not open file $R1");
        my $counter = 0;
        my $part = 0;
        my $cumlen = 0;
        my $seqcounter = 0;
	while(<HANDLE_INFILEZ>){
		my $line = $_;
		chomp($line);
		$counter++; $part++;
		if($part>4) { $part=1 }
		if($part==2){ $cumlen = $cumlen + length($line); $seqcounter++; }		
		if ($counter > 1000) {last;}
		
	}
	close(HANDLE_INFILE);
	$current_readlength = $cumlen/$seqcounter;
     }
     my $len = $current_readlength;

    if($len eq "NA"){
      $len = 150;
      log_message("WARNING: no readlength data found...setting bracken readlength to 150");
    }
    else{
      my @reference_lengths = (50, 75, 100, 150, 200, 250, 300);
    

      $len = $reference_lengths[0];
      my $min_diff = abs($current_readlength - $len);

      foreach my $ref (@reference_lengths) {
        my $diff = abs($current_readlength - $ref);
        if ($diff < $min_diff) {
            $min_diff = $diff;
            $len = $ref;
        }
    }
  }

  log_message("INFO: Bracken readlength set to $len");
  
  return $len;
  

}
####################################################################################################

sub log_progress {
    my ($samplenr, $message) = @_;

    return unless $message;   # no message → no log

    my $base = $R_samples->[$samplenr]->{name} // "";
    my $samplecount = @$R_samples;

    my $number   = $samplenr + 1;
    my $formated = ($samplenr == -1)
        ? "PROGRESS: On all samples: $message"
        : "PROGRESS: Sample $base ($number/$samplecount): $message";

    my $utc_timestamp = timestamp_UTC();  # returns "UTC-time: YYYY-MM-DDTHH:MM:SSZ"

    # put lables into sdterr and stdout 
    system "echo \"[$utc_timestamp] $formated\" >>" . getdir("out,log") . "/stderr.txt";
    system "echo \"[$utc_timestamp] $formated\" >>" . getdir("out,log") . "/stdout.txt";

    
    my $screen_msg = log_message($formated);
    
    return $screen_msg;
}


####################################################################################################

sub fastq_prescan {
    my ($fq1, $fq2, $outfolder, $samplenr) = @_;

    my $MAX_SCAN_READS     = 5000;
    my $MAX_ADAPTER_READS  = 5000;
    my $DEFAULT_READLENGTH = 150;

    my @constants_adapters = (
        "Illumina Tagmentation: CTGTCTCTTATACACATCT",
        "Illumina TruSeq R1: AGATCGGAAGAGCACACGTCTGAAC",
        "Illumina TruSeq R2: AGATCGGAAGAGCGTCGTGTAGGGA",
        "Illumina Tagmentation alt: ATGTGTATAAGAGACA",
    );

    my @adapters = (
        "CTGTCTCTTATACACATCT",
        "AGATCGGAAGAGCACACGTCTGAAC",
        "AGATCGGAAGAGCGTCGTGTAGGGA",
        "ATGTGTATAAGAGACA",
    );

    my $machine_aliases_ref = parse_machine_aliases($R_cfg->{general}{machine_aliases});

    my $hist_quantile = sub {
        my ($hist, $q) = @_;
        my $total = 0;
        $total += $_ for values %$hist;
        return 0 if $total == 0;

        my $target = int($q * ($total - 1));
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %$hist) {
            $cum += $hist->{$k};
            return $k if $cum > $target;
        }

        my @keys = sort { $a <=> $b } keys %$hist;
        return $keys[-1] // 0;
    };

    my $hist_minmax = sub {
        my ($hist) = @_;
        my @keys = sort { $a <=> $b } keys %$hist;
        return (0, 0) if !@keys;
        return ($keys[0], $keys[-1]);
    };

    my $norm_text = sub {
        my ($x, $default) = @_;
        $default //= "unknown";
        return $default if !defined $x || $x eq "";
        return $x;
    };

    my $init_bucket = sub {
        return {
            reads_scanned           => 0,
            bases                   => 0,
            gc_bases                => 0,
            n_bases                 => 0,
            qual_sum                => 0,
            read_len_hist           => {},
            adapters_checked        => 0,
            adapters_found          => 0,
            adapter_hits            => {},
            header_examples         => [],
            header_patterns         => {},
            source_patterns         => {},
            instruments             => {},
            instrument_type_guesses => {},
            flowcells               => {},
            run_numbers             => {},
            lanes                   => {},
            platform_guesses        => {},
            warnings                => [],
        };
    };

    my %res = (
        files    => [ grep { defined && $_ ne "" } ($fq1, $fq2) ],
        adapters => \@constants_adapters,
        R1       => $init_bucket->(),
        R2       => $init_bucket->(),
        total    => $init_bucket->(),
    );

    my @file_specs;
    push @file_specs, [ $fq1, "R1" ] if defined($fq1) && $fq1 ne "";
    push @file_specs, [ $fq2, "R2" ] if defined($fq2) && $fq2 ne "";

    for my $spec (@file_specs) {
        my ($file, $bucket_name) = @$spec;
        my $bucket = $res{$bucket_name};

        my $fh;
        if ($file =~ /\.gz$/i) {
            open($fh, "-|", "gzip", "-dc", $file) or graceful_die("fastq_prescan: Cannot open $file: $!");
        }
        else {
            open($fh, "<", $file) or graceful_die("fastq_prescan: Cannot open $file: $!");
        }

        while (1) {
            my $header = <$fh>; last unless defined $header;
            my $seq    = <$fh>; last unless defined $seq;
            my $plus   = <$fh>; last unless defined $plus;
            my $qual   = <$fh>; last unless defined $qual;

            chomp($header);
            chomp($seq);
            chomp($qual);

            $bucket->{reads_scanned}++;
            $res{total}{reads_scanned}++;

            my $len = length($seq);
            $bucket->{bases} += $len;
            $res{total}{bases} += $len;

            $bucket->{read_len_hist}{$len}++;
            $res{total}{read_len_hist}{$len}++;

            my $gc_count = ($seq =~ tr/GCgc//);
            $bucket->{gc_bases} += $gc_count;
            $res{total}{gc_bases} += $gc_count;

            my $n_count = ($seq =~ tr/Nn//);
            $bucket->{n_bases} += $n_count;
            $res{total}{n_bases} += $n_count;

            for my $c (unpack("C*", $qual)) {
                my $Q = $c - 33;
                $Q = 0 if $Q < 0;
                $bucket->{qual_sum} += $Q;
                $res{total}{qual_sum} += $Q;
            }

            if ($bucket->{reads_scanned} <= $MAX_ADAPTER_READS) {
                $bucket->{adapters_checked}++;
                for (my $i = 0; $i < @adapters; $i++) {
                    if (index($seq, $adapters[$i]) != -1) {
                        $bucket->{adapters_found}++;
                        $bucket->{adapter_hits}{$constants_adapters[$i]}++;
                        last;
                    }
                }
            }

            if (@{ $bucket->{header_examples} } < 5) {
                push @{ $bucket->{header_examples} }, $header;
            }
            if (@{ $res{total}{header_examples} } < 5) {
                push @{ $res{total}{header_examples} }, $header;
            }

            my $header_info = classify_read_header($header, $machine_aliases_ref);

            my $header_format         = $norm_text->($header_info->{header_format});
            my $source_guess          = $norm_text->($header_info->{source_guess});
            my $platform_guess        = $norm_text->($header_info->{platform_guess});
            my $instrument_type_guess = $norm_text->($header_info->{instrument_type_guess});

            $bucket->{header_patterns}{$header_format}++;
            $res{total}{header_patterns}{$header_format}++;

            $bucket->{source_patterns}{$source_guess}++;
            $res{total}{source_patterns}{$source_guess}++;

            $bucket->{platform_guesses}{$platform_guess}++;
            $res{total}{platform_guesses}{$platform_guess}++;

            $bucket->{instrument_type_guesses}{$instrument_type_guess}++;
            $res{total}{instrument_type_guesses}{$instrument_type_guess}++;

            if (defined $header_info->{instrument} && $header_info->{instrument} ne "") {
                $bucket->{instruments}{ $header_info->{instrument} }++;
                $res{total}{instruments}{ $header_info->{instrument} }++;
            }

            if (defined $header_info->{flowcell} && $header_info->{flowcell} ne "") {
                $bucket->{flowcells}{ $header_info->{flowcell} }++;
                $res{total}{flowcells}{ $header_info->{flowcell} }++;
            }

            if (defined $header_info->{run_number} && $header_info->{run_number} ne "") {
                $bucket->{run_numbers}{ $header_info->{run_number} }++;
                $res{total}{run_numbers}{ $header_info->{run_number} }++;
            }

            if (defined $header_info->{lane} && $header_info->{lane} ne "") {
                $bucket->{lanes}{ $header_info->{lane} }++;
                $res{total}{lanes}{ $header_info->{lane} }++;
            }

            last if $bucket->{reads_scanned} >= $MAX_SCAN_READS;
        }

        close $fh;
    }

    # Build total adapter stats from R1 + R2 buckets instead of sampling only the first reads overall
    $res{total}{adapters_checked} = ($res{R1}{adapters_checked} // 0) + ($res{R2}{adapters_checked} // 0);
    $res{total}{adapters_found}   = ($res{R1}{adapters_found}   // 0) + ($res{R2}{adapters_found}   // 0);

    for my $ad (@constants_adapters) {
        $res{total}{adapter_hits}{$ad} =
              ($res{R1}{adapter_hits}{$ad} // 0)
            + ($res{R2}{adapter_hits}{$ad} // 0);
    }

    my $dominant_key = sub {
        my ($href) = @_;
        return "" if !defined $href || ref($href) ne "HASH" || !%$href;

        my ($best) = sort { $href->{$b} <=> $href->{$a} } keys %$href;
        return $best // "";
    };

    my $dominant_value = sub {
        my ($href) = @_;
        my $key = $dominant_key->($href);
        return $key;
    };

    my $finalize_bucket = sub {
        my ($bucket) = @_;

        if ($bucket->{reads_scanned} > 0 && $bucket->{bases} > 0) {
            my ($min_len, $max_len) = $hist_minmax->($bucket->{read_len_hist});
            $bucket->{shortest}   = $min_len;
            $bucket->{longest}    = $max_len;
            $bucket->{average}    = $bucket->{bases} / $bucket->{reads_scanned};
            $bucket->{median}     = $hist_quantile->($bucket->{read_len_hist}, 0.50);
            $bucket->{q1}         = $hist_quantile->($bucket->{read_len_hist}, 0.25);
            $bucket->{q3}         = $hist_quantile->($bucket->{read_len_hist}, 0.75);
            $bucket->{q05}        = $hist_quantile->($bucket->{read_len_hist}, 0.05);
            $bucket->{gc_pct}     = sprintf("%.5f", 100 * $bucket->{gc_bases} / $bucket->{bases});
            $bucket->{n_pct}      = sprintf("%.5f", 100 * $bucket->{n_bases} / $bucket->{bases});
            $bucket->{av_q_score} = sprintf("%.3f", $bucket->{qual_sum} / $bucket->{bases});
        }
        else {
            $bucket->{shortest}   = 0;
            $bucket->{longest}    = 0;
            $bucket->{average}    = 0;
            $bucket->{median}     = 0;
            $bucket->{q1}         = 0;
            $bucket->{q3}         = 0;
            $bucket->{q05}        = 0;
            $bucket->{gc_pct}     = sprintf("%.5f", 0);
            $bucket->{n_pct}      = sprintf("%.5f", 0);
            $bucket->{av_q_score} = sprintf("%.3f", 0);
        }

        $bucket->{estimated_bracken_readlength} =
            $bucket->{median} && $bucket->{median} > 0
            ? nearest_bracken_readlength($bucket->{median})
            : $DEFAULT_READLENGTH;

        $bucket->{adapter_pct} =
            $bucket->{adapters_checked}
            ? sprintf("%.5f", 100 * $bucket->{adapters_found} / $bucket->{adapters_checked})
            : sprintf("%.5f", 0);

        $bucket->{header_format}         = $dominant_value->($bucket->{header_patterns})         || "unknown";
        $bucket->{source_guess}          = $dominant_value->($bucket->{source_patterns})         || "unknown";
        $bucket->{platform_guess}        = $dominant_value->($bucket->{platform_guesses})        || "unknown";
        $bucket->{instrument_type_guess} = $dominant_value->($bucket->{instrument_type_guesses}) || "unknown";

        $bucket->{instrument} = $dominant_value->($bucket->{instruments}) || "";
        $bucket->{flowcell}   = $dominant_value->($bucket->{flowcells})   || "";
        $bucket->{run_number} = $dominant_value->($bucket->{run_numbers}) || "";
        $bucket->{lane}       = $dominant_value->($bucket->{lanes})       || "";

        $bucket->{machine_alias} = "";
        if ($bucket->{instrument} ne "" && exists $machine_aliases_ref->{ $bucket->{instrument} }) {
            $bucket->{machine_alias} = $machine_aliases_ref->{ $bucket->{instrument} };
        }

        $bucket->{looks_long_read}  = 0;
        $bucket->{long_read_reason} = "";

        if ($bucket->{median} > 600) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Median read length > 600 bp";
        }
        elsif ($bucket->{q3} > 1000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Upper quartile read length > 1000 bp";
        }
        elsif ($bucket->{longest} > 5000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Observed reads > 5000 bp";
        }
        elsif ($bucket->{platform_guess} =~ /^(ONT|PacBio)$/i) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Header format suggests long-read platform";
        }

        if ($bucket->{looks_long_read}) {
            push @{ $bucket->{warnings} }, "Reads may represent long-read data: $bucket->{long_read_reason}";
        }

        return $bucket;
    };

    $finalize_bucket->($res{R1});
    $finalize_bucket->($res{R2});
    $finalize_bucket->($res{total});

    if (!defined $outfolder || $outfolder eq "") {
        return \%res;
    }

    my $folder = fill_placeholders($outfolder, $samplenr);
    ensure_dir($folder);

    my $json_path = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.json"), $samplenr);
    my $txt_path  = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.txt"),  $samplenr);

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);

    open(my $jfh, ">", $json_path) or graceful_die("fastq_prescan: Cannot write [$json_path]: $!");
    print {$jfh} $json->encode(\%res);
    close($jfh) or graceful_die("fastq_prescan: Failed closing [$json_path]: $!");

    open(my $tfh, ">", $txt_path) or graceful_die("fastq_prescan: Cannot write [$txt_path]: $!");

    my $print_bucket = sub {
        my ($label, $bucket) = @_;
        print {$tfh} "=== $label ===\n";
        print {$tfh} "Reads scanned: $bucket->{reads_scanned}\n";
        print {$tfh} "Read length (shortest/q05/q1/median/q3/average/longest): "
                   . "$bucket->{shortest} / $bucket->{q05} / $bucket->{q1} / $bucket->{median} / $bucket->{q3} / "
                   . sprintf("%.2f", $bucket->{average}) . " / $bucket->{longest}\n";
        print {$tfh} "Estimated Bracken read length: $bucket->{estimated_bracken_readlength}\n";
        print {$tfh} "Average Phred score: $bucket->{av_q_score}\n";
        print {$tfh} "GC %: $bucket->{gc_pct}\n";
        print {$tfh} "N %: $bucket->{n_pct}\n";
        print {$tfh} "Adapter % (of checked): $bucket->{adapter_pct}\n";
        print {$tfh} "Header format: $bucket->{header_format}\n";
        print {$tfh} "Platform guess: $bucket->{platform_guess}\n";
        print {$tfh} "Source guess: $bucket->{source_guess}\n";
        print {$tfh} "Instrument: $bucket->{instrument}\n";
        print {$tfh} "Instrument type guess: $bucket->{instrument_type_guess}\n";
        print {$tfh} "Machine alias: $bucket->{machine_alias}\n";
        print {$tfh} "Flowcell: $bucket->{flowcell}\n";
        print {$tfh} "Run number: $bucket->{run_number}\n";
        print {$tfh} "Lane: $bucket->{lane}\n";
        print {$tfh} "Looks like long-read data: " . ($bucket->{looks_long_read} ? "yes" : "no") . "\n";
        print {$tfh} "Long-read reason: $bucket->{long_read_reason}\n" if $bucket->{long_read_reason};

        if (@{ $bucket->{warnings} }) {
            print {$tfh} "Warnings:\n";
            print {$tfh} "  - $_\n" for @{ $bucket->{warnings} };
        }

        print {$tfh} "Example headers:\n";
        print {$tfh} "  - $_\n" for @{ $bucket->{header_examples} };
        print {$tfh} "\n";
    };

    print {$tfh} "FASTQ prescan summary\n";
    print {$tfh} "Files:\n";
    print {$tfh} "  R1: " . (defined($fq1) && $fq1 ne "" ? $fq1 : "(none)") . "\n";
    print {$tfh} "  R2: " . (defined($fq2) && $fq2 ne "" ? $fq2 : "(none)") . "\n\n";

    $print_bucket->("R1",    $res{R1});
    $print_bucket->("R2",    $res{R2});
    $print_bucket->("TOTAL", $res{total});

    print {$tfh} "Adapters searched:\n";
    print {$tfh} "  - $_\n" for @constants_adapters;

    close($tfh) or graceful_die("fastq_prescan: Failed closing [$txt_path]: $!");

    return \%res;
}

sub nearest_bracken_readlength {
    my ($current_readlength) = @_;

    my @reference_lengths = (50, 75, 100, 150, 200, 250, 300);

    return 150 if !defined $current_readlength || $current_readlength !~ /^\d+(?:\.\d+)?$/;

    my $len = $reference_lengths[0];
    my $min_diff = abs($current_readlength - $len);

    foreach my $ref (@reference_lengths) {
        my $diff = abs($current_readlength - $ref);
        if ($diff < $min_diff) {
            $min_diff = $diff;
            $len = $ref;
        }
    }

    return $len;
}

sub classify_read_header {
    my ($header, $machine_aliases_ref) = @_;

    my %info = (
        header_format          => "unknown",
        platform_guess         => "unknown",
        source_guess           => "unknown",
        instrument             => "",
        instrument_type_guess  => "",
        run_number             => "",
        flowcell               => "",
        lane                   => "",
        machine_alias          => "",
    );

    return \%info if !defined $header || $header eq "";

    $header =~ s/^\@//;

    # Modern Illumina:
    # instrument:run:flowcell:lane:tile:x:y read:is_filtered:control:index
    if ($header =~ /^([A-Za-z0-9_-]+):(\d+):([A-Za-z0-9_-]+):(\d+):\d+:\d+:\d+(?:\s+[12]:[YN]:\d+:[A-Za-z0-9+-]+)?$/) {
        $info{header_format}  = "illumina_modern";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{run_number}     = $2;
        $info{flowcell}       = $3;
        $info{lane}           = $4;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # Older Illumina-ish patterns
    elsif ($header =~ /^([A-Za-z0-9_-]+):(\d+):(\d+):(\d+):(\d+)(?:#\S+)?(?:\/[12])?$/) {
        $info{header_format}  = "illumina_legacy";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{lane}           = $2;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # SRA / ENA / DDBJ accession-like
    elsif ($header =~ /^((?:SRR|ERR|DRR)\d+(?:\.\d+)?)/i) {
        $info{header_format}  = "sra_ena_accession";
        $info{platform_guess} = "unknown";
        $info{source_guess}   = "SRA_ENA_DDBJ";
        $info{instrument}     = "";
    }

    # ONT often UUID-like headers or runid/ch/chunks
    elsif ($header =~ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/i
        || $header =~ /\brunid=/i
        || $header =~ /\bch=\d+/i
        || $header =~ /\bstart_time=/i) {
        $info{header_format}  = "ont_like";
        $info{platform_guess} = "ONT";
        $info{source_guess}   = "local_or_exported";
    }

    # PacBio CCS/subreads often have movie/zmw style
    elsif ($header =~ m{^[^/\s]+/\d+/(?:ccs|\d+_\d+)}i) {
        $info{header_format}  = "pacbio_like";
        $info{platform_guess} = "PacBio";
        $info{source_guess}   = "local_or_exported";
    }

    # Some IonTorrent exports can look like runID:row:col or similar, but weakly standardized
    elsif ($header =~ /^[A-Za-z0-9._-]+:\d+:\d+$/) {
        $info{header_format}  = "iontorrent_like";
        $info{platform_guess} = "IonTorrent";
        $info{source_guess}   = "local_or_exported";
    }

    if ($info{instrument} ne "" && exists $machine_aliases_ref->{ $info{instrument} }) {
        $info{machine_alias} = $machine_aliases_ref->{ $info{instrument} };
    }

    return \%info;
}


sub parse_machine_aliases {
    my ($text) = @_;

    my %aliases;
    return \%aliases if !defined $text || $text eq "";

    foreach my $pair (split /\s*,\s*/, $text) {
        next if $pair eq "";
        my ($key, $value) = split /\s*=\s*/, $pair, 2;
        next if !defined $key || !defined $value || $key eq "" || $value eq "";
        $aliases{$key} = $value;
    }

    return \%aliases;
}


sub guess_illumina_instrument_type {
    my ($instrumentname) = @_;

    return "" if !defined $instrumentname || $instrumentname eq "";

    if    ($instrumentname =~ /^MN/i)     { return "MiniSeq"; }
    elsif ($instrumentname =~ /^M/i)      { return "MiSeq"; }
    elsif ($instrumentname =~ /^HWI-M/i)  { return "MiSeq"; }
    elsif ($instrumentname =~ /^HWUSI/i)  { return "GAII"; }
    elsif ($instrumentname =~ /^HWI-D/i)  { return "HiSeq 2000/2500"; }
    elsif ($instrumentname =~ /^K/i)      { return "HiSeq 3000/4000"; }
    elsif ($instrumentname =~ /^N/i)      { return "NextSeq 500/550"; }
    elsif ($instrumentname =~ /^AA/i)     { return "NextSeq 2000 P1/P2/P3"; }
    elsif ($instrumentname =~ /^A/i)      { return "NovaSeq"; }
    elsif ($instrumentname =~ /^H/i)      { return "NovaSeq S1/S2/S4"; }
    elsif ($instrumentname =~ /^V/i)      { return "NextSeq 2000"; }

    return "unknown";
}





####################################################################################################

sub initiate_logfile {
    my $logfile = getdir("out,log") . "/log.txt";
    my $bash_logfile = getdir("out,log") . "/bash_commands.log";

    open($log_fh, '>>', $logfile)
        or die("FATAL ERROR: could not create file $logfile: $!");
    open($log_fh_bash, '>>', $bash_logfile)
        or die("FATAL ERROR: could not create file $bash_logfile: $!");

    # Enable autoflush on $log_fh so logs are written immediately
    $log_fh->autoflush(1);
    $log_fh_bash->autoflush(1);
        
    $logfile_open = 1;

    print {$log_fh}  "-------------------------------------\n" .
                     "Commands executed before the logfile was opened:\n" . 
                     "$log_buffer\n".
                     "--------------------------------------\n";
    $log_buffer = '';  
        
    my $timestamp = timestamp_UTC();

    print {$log_fh} "========== LOG START ==========\n";
    print {$log_fh} "INFO: Logfile is now opened for writing\n";
    print {$log_fh} "INFO: $timestamp\n";
    print {$log_fh} "INFO: Pipeline name: $rundata{pipeline_info}{name}\n";
    print {$log_fh} "INFO: Pipeline version: $rundata{pipeline_info}{version}\n";
    print {$log_fh} "INFO: Pipeline version date: $rundata{pipeline_info}{versiondate}\n";    
                     

    
               
}


####################################################################################################

sub close_logfile {
    if ($logfile_open) {
        close($log_fh)
            or warn("WARNING: could not close logfile: $!");
        close($log_fh_bash)
            or warn("WARNING: could not close logfile: $!");    
        $logfile_open = 0;
    }
}

# Use this instead of a bare "die" whenever a failure is genuinely fatal for
# the whole pipeline run. Logs the error properly (so it ends up in the log
# file like everything else, not just on STDERR), closes the logfile cleanly,
# then exits -- rather than a raw die, which bypasses log_message() and
# close_logfile() entirely and can leave the logfile in an unflushed state.
#
# IMPORTANT: only call this from a context that is *actually* fatal for the
# whole run (e.g. a required tool that could not be installed after every
# available attempt). Never call it from a shared/low-level function that is
# also used on an optional-tool code path (ensure_conda_tool, expand_tool_checks,
# validate_tool_installation, etc.) -- those should report failure back to
# their caller (return 0 / empty list) and let the caller decide whether that
# failure is fatal (required tool) or recoverable (optional tool, prompt to
# continue without it).
sub graceful_die {
    my ($message) = @_;
    log_message("ERROR: $message", "red");
    log_message("NOTICE: Aborting analysis");
    close_logfile();
    exit 1;
}
####################################################################################################

 

####################################################################################################

sub timestamp_UTC {

    my @t = gmtime();
    my $timestamp = sprintf(
        "%04d-%02d-%02d %02d:%02d:%02d UTC",
        $t[5] + 1900, $t[4] + 1, $t[3],
        $t[2], $t[1], $t[0]
    );

    return "$timestamp";
}

####################################################################################################

sub timestamp_local {

    my @t = localtime();
    my $timestamp = sprintf(
        "%04d-%02d-%02d %02d:%02d:%02d",
        $t[5] + 1900, $t[4] + 1, $t[3],
        $t[2], $t[1], $t[0]
    );

    return "$timestamp";
}

#####################################################################################################

sub format_elapsed {   #for spinner
    my ($seconds) = @_;

    my $hours   = int($seconds / 3600);
    my $minutes = int(($seconds % 3600) / 60);
    my $secs    = $seconds % 60;

    my $str = "";
    $str .= "${hours}h "   if $hours > 0;
    $str .= "${minutes}m " if $minutes > 0;
    $str .= sprintf("%ds", $secs);
    return $str;
}
####################################################################################################
sub _parse_internal_cmd {
    my ($cmd) = @_;
    return unless defined $cmd;

    # Match "SUB\tname" plus optional "\targs..."
    return unless $cmd =~ /^SUB\t([A-Za-z_]\w*)(?:\t(.*))?\z/s;

    my $subname = $1;
    my $argstr  = defined($2) ? $2 : '';

    # Split remaining fields on tabs. Keep empty fields if you need them:
    my @args = length($argstr) ? split(/\t/, $argstr, -1) : ();

    return ($subname, @args);
}

sub _run_internal_sub {
    my ($subname, @args) = @_;

    my $code = $INTERNAL_SUB{$subname};
    if (!$code) {
        log_message("ERROR: Unknown internal sub [$subname]", "red");
        return 2;
    }

    my $exit_code = 0;

    # Capture exceptions so they become a controlled non-zero exit
    my $ok = eval {
        # Convention: internal subs return 0 on success, non-zero on failure.
        # If your subs currently return undef/true/false, normalize here.
        my $rc = $code->(@args);

        # Normalize:
        $exit_code = (!defined $rc) ? 0
                   : ($rc =~ /^\d+\z/) ? $rc
                   : ($rc ? 0 : 1);

        1;
    };

    if (!$ok) {
        my $err = $@ || "Unknown error";
        chomp $err;
        log_message("ERROR: Internal sub [$subname] died: $err", "red");
        return 255;
    }

    return $exit_code;
}

####################################################################################################

sub safe_rel {
    my ($num, $den, $fault_ret) = @_;

    $fault_ret   //= undef;
    
    return $fault_ret  unless is_number($num) && is_number($den);
    return $fault_ret  if $den == 0;

    return ($num / $den) * 100;
}

sub safe_quota {
    my ($num, $den, $fault_ret) = @_;

    $fault_ret   //= undef;
    
    return $fault_ret  unless is_number($num) && is_number($den);
    return $fault_ret  if $den == 0;

    return ($num / $den) ;
}



sub is_number {
    my ($x) = @_;
    return looks_like_number($x);
}

####################################################################################################

sub execute_and_log {
    my ($cmd, $run_fork, $msg, $max_seconds) = @_;
    $run_fork    //= 0;
    $msg         //= '';
    $max_seconds //= parse_duration_to_seconds($R_cfg->{general}{timeout});   # 0/undef => no timeout
    $cmd          = fill_placeholders($cmd);

    my ($subname, @subargs) = _parse_internal_cmd($cmd);
    my $is_internal = defined $subname;

    my $printversionCommand = $cmd;
    $printversionCommand =~ s/;/;\n/g;

    log_message("Executing:\n$printversionCommand");

    if (!$is_internal && $log_fh_bash) {
        my $ts = timestamp_UTC();
        print {$log_fh_bash} "[$ts] $cmd\n";
    }

    my $start_time = time();
    my $status;

    # Disable spinner if not interactive output
    $run_fork = 0 if !$run_fork || !-t STDOUT;

    if ($run_fork) {
        my $pid = fork();
        if (!defined $pid) {
            log_message("ERROR: Fork failed for command: $cmd", "red");
            return;
        }

        if ($pid == 0) {
            # ---- child ----
            # Put child into its own process group so parent can kill everything it spawned.
            setpgid(0, 0);

            if ($is_internal) {
                my $rc = _run_internal_sub($subname, @subargs);
                exit($rc & 255);
            } else {
                exec "bash", "-c", $cmd;
                exit 127;
            }
        }

        # Parent: ensure child has its own PGID (usually same as PID)
        setpgid($pid, $pid);

        my @spinner = ('|','/','-','\\');
        my $i = 0;

        my $get_cols = sub {
            return 80 unless -t STDOUT;
            my ($cols) = (GetTerminalSize())[0];
            return ($cols && $cols > 0) ? $cols : 80;
        };

        my $render_line = sub {
            my ($msg, $spinchar, $elapsed_str) = @_;
            my $cols = $get_cols->();
            my $max  = $cols - 1;
            $max = 10 if $max < 10;

            my $tail = sprintf " [%s] elapsed: %s", $spinchar, $elapsed_str;
            my $raw  = $msg . $tail;
            return $raw if length($raw) <= $max;

            my $head_max = $max - length($tail);
            $head_max = 0 if $head_max < 0;

            my $head = substr($msg, 0, $head_max);
            if ($head_max >= 2 && length($msg) > $head_max) {
                $head = substr($msg, 0, $head_max - 1) . "…";
            }
            return $head . $tail;
        };

        my $timed_out = 0;

        while (1) {
            my $child = waitpid($pid, WNOHANG);
            last if $child > 0;

            my $elapsed = time() - $start_time;

            # ---- timeout check ----
            if ($max_seconds && $elapsed >= $max_seconds) {
                $timed_out = 1;

                my $limit_str = format_elapsed($max_seconds);
                log_message("ERROR: Timeout after $limit_str. Killing the process", "red");
                log_message("INFO: Timeout after $limit_str. Killing: $cmd", "red");
                # TERM whole process group
                kill 'TERM', -$pid;

                # Give it a moment to exit cleanly
                my $grace = 5;  # seconds
                my $t0 = time();
                while (time() - $t0 < $grace) {
                    my $w = waitpid($pid, WNOHANG);
                    last if $w > 0;
                    select(undef, undef, undef, 0.2);
                }

                # Still alive? KILL process group
                my $w = waitpid($pid, WNOHANG);
                if ($w <= 0) {
                    kill 'KILL', -$pid;
                    waitpid($pid, 0);
                }

                last;
            }

            my $elapsed_str = format_elapsed($elapsed);
            my $line = $render_line->($msg, $spinner[$i % 4], $elapsed_str);

            print "\r\e[2K", $line;

            $i = ($i + 1) % @spinner;
            select(undef, undef, undef, 0.2);
        }

        my $elapsed = time() - $start_time;
        my $elapsed_str = format_elapsed($elapsed);

        my $done = $timed_out
            ? sprintf("%s...TIMEOUT (elapsed %s)", $msg, $elapsed_str)
            : sprintf("%s...done (elapsed %s)", $msg, $elapsed_str);

        my $cols = (-t STDOUT) ? ((GetTerminalSize())[0] || 80) : 80;
        my $max  = $cols - 1;
        $done = substr($done, 0, $max) if length($done) > $max;

        print "\r\e[2K", $done, "\n";

        # If timed out, synthesize an exit status that looks like "killed by signal"
        if ($timed_out) {
            $status = 9;          # pretend SIGKILL
            $status = $status & 127;  # fits your later status parsing branch
        } else {
            $status = $?;
        }

    } else {
        # ---- blocking execution ----
        if ($is_internal) {
            my $rc = _run_internal_sub($subname, @subargs);
            $status = ($rc & 255) << 8;
        } else {
            system($cmd);
            $status = $?;
        }
    }

    my $elapsed = time() - $start_time;
    my $hours   = int($elapsed / 3600);
    my $minutes = int(($elapsed % 3600) / 60);
    my $seconds = $elapsed % 60;
    my $runtime = sprintf "%02d:%02d:%02d", $hours, $minutes, $seconds;

    if ($status == -1) {
        log_message("ERROR: Failed to execute command: $cmd");
    } elsif ($status & 127) {
        my $m = sprintf("ERROR: Command died with signal %d: %s", $status & 127);
        log_message($m, "red");
    } else {
        my $exit = $status >> 8;
        if ($exit == 0) {
            log_message("INFO: Done (time used: $runtime)");
        } else {
            my $m = sprintf("ERROR: Command exited with code %d: %s", $exit);
            log_message($m, "red");
        }
    }
}
#####################################################################################################

sub parse_duration_to_seconds {
    my ($s) = @_;
    return 0 if !defined $s;
    $s =~ s/^\s+|\s+$//g;
    return 0 if $s eq "" || lc($s) eq "0" || lc($s) eq "none" || lc($s) eq "off";

    my $orig = $s;

    # If it's just digits, treat as seconds
    if ($s =~ /^\d+$/) {
        return int($s);
    }

    # Normalize: lowercase, remove commas, collapse spaces
    $s = lc $s;
    $s =~ s/,//g;
    $s =~ s/\s+/ /g;

    # Allow formats like: "1h40m", "1h 40m", "2d 3h 10m 5s"
    # Units: d, h, m, s  (days/hours/minutes/seconds)
    my %mult = ( d => 86400, h => 3600, m => 60, s => 1 );

    my $total = 0;
    my $pos = 0;

    while ($s =~ /\G\s*(\d+(?:\.\d+)?)\s*([dhms])\s*/gc) {
        my ($num, $unit) = ($1, $2);
        $total += $num * $mult{$unit};
        $pos = pos($s);
    }

    # If we didn't consume the whole string, it's invalid
    if (!defined($pos) || $pos != length($s)) {
        graceful_die("Invalid duration format [$orig]. Examples: 500s, 40m, 1h40m, 1h 40m, 2d 3h");
    }

    # Return integer seconds (round down)
    return int($total);
}

#####################################################################################################
###################################################################################################
## screen color helper
##
## Single source of truth for ANSI screen coloring, used both by the startup
## banner and by log_message(). Respects $USE_COLOR (auto-disabled when not
## a terminal, see startup section; overridable via --no-color/--color).
## Wrapped in eval so an unrecognized color name degrades to "no color"
## instead of crashing the pipeline (Term::ANSIColor's color() dies on
## unknown attribute names).
sub colorize_for_screen {
    my ($color_name) = @_;

    return "" if !defined $USE_COLOR || !$USE_COLOR;
    return "" unless defined $color_name && $color_name ne "";

    my $code = eval { color($color_name) };
    return $code // "";
}

sub log_message {
    my ($msg, $color) = @_;   # $color is optional

    # Ensure newline unless it already ends with \n or ...
    unless ( $msg =~ /\n$/ || $msg =~ /\.\.\.$/ ) {
        $msg .= "\n";
    }

 #   if($msg =~ "__"){
 #     $msg  = fill_placeholders($msg,"","",0);
 #   }  

    my $elapsed = time() - $rundata{timestamps}{pipeline_start}{time_value};
    my $hours   = int($elapsed / 3600);
    my $minutes = int(($elapsed % 3600) / 60);
    my $seconds = $elapsed % 60;
    my $runtime = sprintf "%02d:%02d:%02d", $hours, $minutes, $seconds;

    my $timestamp = ( is_docker() ) ? timestamp_UTC() : timestamp_local();

    my $output_log = "[$timestamp][+$runtime] $msg";

    my $output_screen = $msg;
    $output_screen =~ s/^(NOTICE:|PROGRESS:)\s*//;  # Strip NOTICE: and PROGRESS: prefixes for screen
    $output_screen = "[+$runtime] $output_screen";

    if ($logfile_open) {
        print {$log_fh} $output_log;
    } else {
        $log_buffer .= $output_log;
    }

    # Default to 0 if not yet set
    my $verbose = $R_cfg->{general}{verbose} // 0;

    # Decide if it should also go to screen
    if ( $verbose || $msg =~ /^(ERROR:|WARNING:|NOTICE:|PROGRESS:)/ ) {
        if ( defined $color && $color ne "" ) {
            print colorize_for_screen($color), $output_screen, colorize_for_screen('reset');
        }
        else {
            print $output_screen;
        }
        return $output_screen;
    }
    return "";
}
#####################################################################################################

####################################################################################################

########################################################################################################

sub ensure_dir {
    my ($path) = @_;


    if (-d $path) {
        return $path;   # success
    }
    
    my $root_dir = _get_path_entry('DIR', "out");
    my $db_root_dir = _get_path_entry('DIR', "db");


    unless (defined $path) {
        log_message("WARNING: Cannot resolve path in ensure_dir","red");
        return "";
    }
    if ( $path eq "") {
       log_message("WARNING: Empty path [$path] in ensure_dir","red");
    }
    
    # Security check — ensure abs_path starts with abs_root
    unless (index($path, $root_dir) == 0 || index($path, $db_root_dir) == 0) {
        log_message("WARNING: Attempt to create directory outside output root or db-root [$path]  — denied","red");
        return "";
    }

    # Create directory if missing
    unless (-d $path) {
        execute_and_log("mkdir -p '$path'");
    }

    if (! (-d $path) ) {
        log_message("WARNING: Could not create directory [$path]","red");
        return "";     
    }
    return $path;   # success
}
##########################################################################################################

sub check_crc32_hash_collisions {
    my (%args) = @_;

    my $crc32_file  = $args{crc32_file};
    my $sha256_file = $args{sha256_file};
    my $out_file    = $args{out_file};   # optional

    my $summary = {
        checked         => 0,
        ok              => 0,
        collision_count => 0,
        collisions      => [],
        rows_checked    => 0,
        report_file     => "",
        error           => "",
    };

    if (!defined $crc32_file || !-e $crc32_file) {
        $summary->{error} = "CRC32 allele table missing: " . ($crc32_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    if (!defined $sha256_file || !-e $sha256_file) {
        $summary->{error} = "SHA256 allele table missing: " . ($sha256_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    open my $crc_fh, '<', $crc32_file or do {
        $summary->{error} = "Could not open CRC32 allele table [$crc32_file]: $!";
        log_message("WARNING: $summary->{error}");
        return $summary;
    };

    open my $sha_fh, '<', $sha256_file or do {
        $summary->{error} = "Could not open SHA256 allele table [$sha256_file]: $!";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        return $summary;
    };

    my $crc_header = <$crc_fh>;
    my $sha_header = <$sha_fh>;

    if (!defined $crc_header || !defined $sha_header) {
        $summary->{error} = "Empty CRC32 or SHA256 allele table";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    chomp $crc_header;
    chomp $sha_header;

    my @crc_cols = split /\t/, $crc_header, -1;
    my @sha_cols = split /\t/, $sha_header, -1;

    if (@crc_cols != @sha_cols) {
        $summary->{error} = "CRC32/SHA256 allele tables have different number of columns";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    for my $i (0 .. $#crc_cols) {
        if ($crc_cols[$i] ne $sha_cols[$i]) {
            $summary->{error} =
                "CRC32/SHA256 headers differ at column $i [$crc_cols[$i]] vs [$sha_cols[$i]]";
            log_message("WARNING: $summary->{error}");
            close $crc_fh;
            close $sha_fh;
            return $summary;
        }
    }

    my %seen;
    my @collisions;
    my $rows = 0;

    while (1) {
        my $crc_line = <$crc_fh>;
        my $sha_line = <$sha_fh>;

        last if !defined $crc_line && !defined $sha_line;

        if (!defined $crc_line || !defined $sha_line) {
            $summary->{error} = "CRC32/SHA256 allele tables have different number of rows";
            log_message("WARNING: $summary->{error}");
            last;
        }

        chomp $crc_line;
        chomp $sha_line;

        next if $crc_line =~ /^\s*$/ && $sha_line =~ /^\s*$/;

        my @crc = split /\t/, $crc_line, -1;
        my @sha = split /\t/, $sha_line, -1;

        my $sample_crc = $crc[0] // "";
        my $sample_sha = $sha[0] // "";

        if ($sample_crc ne $sample_sha) {
            log_message("WARNING: CRC32/SHA256 sample mismatch [$sample_crc] vs [$sample_sha]");
            next;
        }

        $rows++;

        for my $i (1 .. $#crc_cols) {
            my $locus = $crc_cols[$i];

            my $crc_val = $crc[$i] // "";
            my $sha_val = $sha[$i] // "";

            next if $crc_val eq "" || $crc_val eq "-";
            next if $sha_val eq "" || $sha_val eq "-";

            $seen{$locus}{$crc_val}{$sha_val}{$sample_crc} = 1;
        }
    }

    close $crc_fh;
    close $sha_fh;

    foreach my $locus (sort keys %seen) {
        foreach my $crc_val (sort keys %{ $seen{$locus} }) {

            my @sha_values = sort keys %{ $seen{$locus}{$crc_val} };

            next if @sha_values <= 1;

            my @samples;
            foreach my $sha (@sha_values) {
                push @samples, sort keys %{ $seen{$locus}{$crc_val}{$sha} };
            }

            push @collisions, {
                locus   => $locus,
                crc32   => $crc_val,
                sha256s => \@sha_values,
                samples => \@samples,
            };
        }
    }

    $summary->{checked}         = 1;
    $summary->{ok}              = @collisions ? 0 : 1;
    $summary->{collision_count} = scalar(@collisions);
    $summary->{collisions}      = \@collisions;
    $summary->{rows_checked}    = $rows;

    if (defined $out_file && $out_file ne "") {

        open my $out, '>', $out_file or do {
            $summary->{error} = "Could not write CRC32 collision report [$out_file]: $!";
            log_message("WARNING: $summary->{error}");
            return $summary;
        };

        print $out "# CRC32 collision check\n";
        print $out "# CRC32 file: $crc32_file\n";
        print $out "# SHA256 file: $sha256_file\n";
        print $out "# Rows checked: $rows\n";
        print $out "# Collision count: " . scalar(@collisions) . "\n";

        if (@collisions) {
            print $out "# Result: possible CRC32 collisions detected\n";
        }
        else {
            print $out "# Result: no CRC32 collisions detected\n";
        }

        print $out join("\t", qw(locus crc32 sha256_count sha256_values samples)) . "\n";

        foreach my $c (@collisions) {
            print $out join(
                "\t",
                $c->{locus},
                $c->{crc32},
                scalar(@{ $c->{sha256s} || [] }),
                join(",", @{ $c->{sha256s} || [] }),
                join(",", @{ $c->{samples} || [] }),
            ) . "\n";
        }

        close $out;

        $summary->{report_file} = path_relative_to_outdir($out_file);
    }

    if (@collisions) {
        log_message("WARNING: Possible CRC32 hash collisions detected: " . scalar(@collisions));
    }
    else {
        log_message("INFO: No CRC32 hash collisions detected in [$rows] samples", "green");
    }

    return $summary;
}

######################################################################################

sub ensure_dir_not_exists {
    my (%opt) = @_;

    my $dir   = $opt{dir}   or graceful_die("ensure_dir_not_exists: missing dir");
    my $mode  = $opt{mode}  // 'remove';   # remove | rename | fail
    my $quiet = $opt{quiet} // 0;

    return 1 unless -e $dir;   # nothing to do

    graceful_die("ensure_dir_not_exists: [$dir] exists but is not a directory")
        if -e $dir && !-d $dir;

    if ($mode eq 'fail') {
        graceful_die("Output directory [$dir] already exists");
    }

    if ($mode eq 'remove') {
        remove_tree($dir, { error => \my $err });
        if (@$err) {
            graceful_die("Failed removing directory [$dir]: " .
                join(", ", map { %$_ } @$err));
        }
        log_message("INFO: Removed existing directory [$dir]\n") unless $quiet;
        return 1;
    }

    if ($mode eq 'rename') {
      
        my $new = "$dir.old." . time();
        rename($dir, $new)
            or graceful_die("Failed renaming [$dir] -> [$new]: $!");
        log_message("Renamed existing directory [$dir] -> [$new]\n") unless $quiet;
        return 1;
    }

    log_message( "WARNING: ensure_dir_not_exists: unknown mode [$mode]\n");
}

########################################################################################################

sub run_step {
    my (%args) = @_;

    my $name        = $args{name}        // "Unnamed step";
    my $samplenr    = $args{samplenr}    // -1;
    my $message     = $args{message}     // "";
    my $command     = $args{command}     // "";
    my $resultfile  = $args{resultfile}  // "";

    # progress report
    my $formated_msg = log_progress($samplenr, $message);

    
    if (should_run($resultfile)) {
      execute_and_log($command, 1, $formated_msg );
    } else {
      log_message("NOTICE: Skipping step: $name. Already exists (extend mode)");   
    }

}

#########################################################################################################
sub should_run {
    my ($resultfilepath) = @_;

    # if in extend mode and result file already exists → skip
    if (lc($R_cfg->{general}->{overwrite}) eq "extend" && -f $resultfilepath) {
        return 0;  # should not run
    }

    return 1;  # should run
}

##########################################################################################################



##########################################################################################
sub get_species_config {
    my ($species_name) = @_;

    # Normalize species name (case-insensitive key lookup)
    foreach my $key (keys %{ $R_cfg->{species} }) {
        if (lc($key) eq lc($species_name)) {
            return $R_cfg->{species}{$key};
        }
    }

    # Fallback to "default"
    return $R_cfg->{species}{"default"} if exists $R_cfg->{species}{"default"};

    return undef; # nothing found
}


sub get_config_value_for_species {
    my ($species_name, $key, $default_value) = @_;

    $default_value = undef unless defined $default_value;

    # Normalize species name: underscores → spaces, trim
    if (defined $species_name) {
        $species_name =~ s/_/ /g;
        $species_name =~ s/^\s+|\s+$//g;
    }

    # 1. species-specific section (case-insensitive)
    if (defined $species_name && $species_name ne "" && exists $R_cfg->{species}) {

        foreach my $species_key (keys %{ $R_cfg->{species} }) {

            next if lc($species_key) eq 'default';

            my $normalized_key = $species_key;
            $normalized_key =~ s/_/ /g;

            if (lc($normalized_key) eq lc($species_name)) {

                if (exists $R_cfg->{species}{$species_key}{$key}) {
                    return $R_cfg->{species}{$species_key}{$key};
                }

                last;  # species matched, but key missing → fall through
            }
        }
    }

    # 2. species default
    if (exists $R_cfg->{species}{default} &&
        exists $R_cfg->{species}{default}{$key}) {

        return $R_cfg->{species}{default}{$key};
    }

    # 3. general section
    if (exists $R_cfg->{general} &&
        exists $R_cfg->{general}{$key}) {

        return $R_cfg->{general}{$key};
    }

    # 4. fallback value
    return $default_value;
}
##########################################################################################

sub determine_genomesize(){
   my ($R1,$R2) = @_;
    print "calling estimate_genomesize_from_kmers($R1,$R2);\n";
   return estimate_genomesize_from_kmers($R1,$R2);
  
}


sub estimate_genomesize_from_kmers {
    my ($r1,$r2) = @_;

    my $k       =  21;  
    my $threads = $R_cfg->{threads} // 8;
    my $khist   =  "khist.txt";

    # --- run bbduk to build k-mer histogram ---
    my $cmd = "conda run -n $R_cfg->{bbmap}->{env} --no-capture-output ".
              "bbduk.sh in='$r1' in2='$r2' ".
              "k=$k khist='$khist' threads=$threads minkmerhits=1";
    system($cmd) == 0 or graceful_die("bbduk.sh failed ($?)");

    # --- parse histogram ---
    open(my $fh, "<", $khist) or graceful_die("Cannot open $khist: $!");
    my @hist; # [count, freq]
    while (<$fh>) {
        next if (/^#/) || (/^\s*$/);
        my ($count, $freq) = split;
        next unless defined $count && defined $freq;
        push @hist, [$count, $freq];
    }
    close $fh;
    graceful_die("Empty khist") unless @hist;

    # --- find main peak (coverage) ---
    my $min_count_for_peak = 4; # ignore error hump
    my ($peak_count, $peak_freq) = (undef, -1);
    for my $row (@hist) {
        my ($c,$f) = @$row;
        next if $c < $min_count_for_peak;
        if ($f > $peak_freq) {
            $peak_freq  = $f;
            $peak_count = $c;
        }
    }
    graceful_die("No peak found beyond error hump") unless defined $peak_count;

    # --- compute cutoff (5% of peak height) ---
    my $cutoff = 0.05 * $peak_freq;

    # --- sum only k-mers above cutoff ---
    my $sum_kmer_obs = 0;
    for my $row (@hist) {
        my ($c,$f) = @$row;
        next if $f < $cutoff; # filter
        $sum_kmer_obs += $c * $f;
    }

    # --- genome size estimate ---
    my $genomesize_bp = int($sum_kmer_obs / $peak_count + 0.5);
    return $genomesize_bp;
}
##########################################################################################
sub fastq_qc {
    my ($fq1, $fq2, $outfolder, $samplenr) = @_;

    my @constants_adapters = ();
    my @adapters = ();

    push(@constants_adapters,"Illumina Tagmentation: CTGTCTCTTATACACATCT");
    push(@adapters,"CTGTCTCTTATACACATCT");

    push(@constants_adapters,"Illumina TruSeq R1: AGATCGGAAGAGCACACGTCTGAAC");
    push(@adapters,"AGATCGGAAGAGCACACGTCTGAAC");

    push(@constants_adapters,"Illumina TruSeq R2: AGATCGGAAGAGCGTCGTGTAGGGA");
    push(@adapters,"AGATCGGAAGAGCGTCGTGTAGGGA");

    push(@constants_adapters,"Illumina Tagmentation alt: ATGTGTATAAGAGACA");
    push(@adapters,"ATGTGTATAAGAGACA");

    # Quantiles we care about
    my %LEN_Q = (
        q05   => 0.05,
        q1    => 0.25,
        median=> 0.50,
        q3    => 0.75,
    );

    # Hist quantile helper (exact) for small discrete domains
    my $hist_quantile = sub {
        my ($hist, $q) = @_;
        my $total = 0;
        $total += $_ for values %$hist;
        return 0 if $total == 0;

        my $target = int($q * ($total - 1));  # 0-based rank
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %$hist) {
            $cum += $hist->{$k};
            return $k if $cum > $target;
        }
        # fallback
        my @keys = sort { $a <=> $b } keys %$hist;
        return $keys[-1] // 0;
    };

    my $hist_minmax = sub {
        my ($hist) = @_;
        my @keys = sort { $a <=> $b } keys %$hist;
        return (0,0) if !@keys;
        return ($keys[0], $keys[-1]);
    };

    my $init_bucket = sub {
        return {
            reads        => 0,
            bases        => 0,
            q30_bases    => 0,
            n_bases      => 0,
            gc_bases     => 0,
            qual_sum     => 0,

            # Histograms (small, exact, fast)
            read_len_hist => {},   # len -> count
            q30_drop_hist => {},   # pos -> count (pos==len means "never dropped")
            q28_drop_hist => {},

            adapters_found   => 0,
            adapters_checked => 0,
        };
    };

    my %res = (
        R1      => $init_bucket->(),
        R2      => $init_bucket->(),
        total   => $init_bucket->(),
        files   => [ grep { defined && $_ ne "" } ($fq1, $fq2) ],
        adapters=> \@constants_adapters,
    );

    my @file_specs;
    if (defined($fq1) && $fq1 ne "") { push @file_specs, [ $fq1, "R1" ]; }
    if (defined($fq2) && $fq2 ne "") { push @file_specs, [ $fq2, "R2" ]; }

    for my $spec (@file_specs) {
        my ($file, $bucket_name) = @$spec;
        my $b = $res{$bucket_name};

        my $fh;
        if ($file =~ /\.gz$/) {
            open($fh, "-|", "gzip", "-dc", $file) or graceful_die("fastq_qc: Cannot open $file: $!");
        } else {
            open($fh, "<", $file) or graceful_die("fastq_qc: Cannot open $file: $!");
        }

        while (1) {
            my $header = <$fh>; last unless defined $header;
            my $seq    = <$fh>; last unless defined $seq;
            my $plus   = <$fh>; last unless defined $plus;
            my $qual   = <$fh>; last unless defined $qual;

            chomp($seq);
            chomp($qual);

            $b->{reads}++;
            $res{total}{reads}++;

            my $len = length($seq);

            $b->{bases} += $len;
            $res{total}{bases} += $len;

            # hist instead of arrays
            $b->{read_len_hist}{$len}++;
            $res{total}{read_len_hist}{$len}++;

            my $n_count = ($seq =~ tr/Nn//);
            $b->{n_bases} += $n_count;
            $res{total}{n_bases} += $n_count;

            my $gc_count = ($seq =~ tr/GCgc//);
            $b->{gc_bases} += $gc_count;
            $res{total}{gc_bases} += $gc_count;

            # Quality scan: unpack bytes (fast), compute exact mean Q, Q30 bases,
            # and first-drop positions for Q30/Q28.
            my $q30_drop = $len;
            my $q28_drop = $len;

            my $i = 0;
            for my $c (unpack("C*", $qual)) {
                my $Q = $c - 33;
                $Q = 0 if $Q < 0;

                $b->{qual_sum}        += $Q;
                $res{total}{qual_sum} += $Q;

                if ($Q >= 30) {
                    $b->{q30_bases}++;
                    $res{total}{q30_bases}++;
                } else {
                    $q30_drop = $i if $q30_drop == $len;
                    $q28_drop = $i if $q28_drop == $len && $Q < 28;
                }
                $i++;
            }

            # hist instead of arrays
            $b->{q30_drop_hist}{$q30_drop}++;
            $res{total}{q30_drop_hist}{$q30_drop}++;

            $b->{q28_drop_hist}{$q28_drop}++;
            $res{total}{q28_drop_hist}{$q28_drop}++;

            # Adapter sampling (unchanged)
            if ($b->{reads} <= 5000) {
                $b->{adapters_checked}++;
                ADAPT1: for my $ad (@adapters) {
                    if (index($seq, $ad) != -1) { $b->{adapters_found}++; last ADAPT1; }
                }
            }
            if ($res{total}{reads} <= 5000) {
                $res{total}{adapters_checked}++;
                ADAPT2: for my $ad (@adapters) {
                    if (index($seq, $ad) != -1) { $res{total}{adapters_found}++; last ADAPT2; }
                }
            }
        }
        close $fh;
    }

    my $finalize_bucket = sub {
        my ($bucket) = @_;

        if ($bucket->{reads} > 0 && $bucket->{bases} > 0) {
            my ($min_len, $max_len) = $hist_minmax->($bucket->{read_len_hist});
            $bucket->{shortest} = $min_len;
            $bucket->{longest}  = $max_len;

            $bucket->{average}  = $bucket->{bases} / $bucket->{reads};

            $bucket->{median}   = $hist_quantile->($bucket->{read_len_hist}, 0.50);
            $bucket->{q1}       = $hist_quantile->($bucket->{read_len_hist}, 0.25);
            $bucket->{q3}       = $hist_quantile->($bucket->{read_len_hist}, 0.75);
            $bucket->{q05}      = $hist_quantile->($bucket->{read_len_hist}, 0.05);

            $bucket->{n_pct}    = sprintf("%.5f", 100 * $bucket->{n_bases} / $bucket->{bases});
            $bucket->{q30_pct}  = sprintf("%.5f", 100 * $bucket->{q30_bases} / $bucket->{bases});
            $bucket->{gc_pct}   = sprintf("%.5f", 100 * $bucket->{gc_bases} / $bucket->{bases});
            $bucket->{avg_qual} = sprintf("%.3f", $bucket->{qual_sum} / $bucket->{bases});
        } else {
            $bucket->{longest}  = 0;
            $bucket->{shortest} = 0;
            $bucket->{average}  = 0;
            $bucket->{median}   = 0;
            $bucket->{q1}       = 0;
            $bucket->{q3}       = 0;
            $bucket->{q05}      = 0;
            $bucket->{n_pct}    = sprintf("%.5f", 0);
            $bucket->{q30_pct}  = sprintf("%.5f", 0);
            $bucket->{gc_pct}   = sprintf("%.5f", 0);
            $bucket->{avg_qual} = sprintf("%.3f", 0);
        }

        $bucket->{adapter_pct} =
            $bucket->{adapters_checked}
            ? sprintf("%.5f", 100 * $bucket->{adapters_found} / $bucket->{adapters_checked})
            : sprintf("%.5f", 0);

        $bucket->{median_phred_q30_drop} = $hist_quantile->($bucket->{q30_drop_hist}, 0.50);
        $bucket->{median_phred_q28_drop} = $hist_quantile->($bucket->{q28_drop_hist}, 0.50);

        return $bucket;
    };

    $finalize_bucket->($res{R1});
    $finalize_bucket->($res{R2});
    $finalize_bucket->($res{total});

    if (!defined $outfolder || $outfolder eq "") {
        return \%res;
    }

    # No big arrays anymore; histograms are small.
    # If you still don't want them in JSON, you can delete them here.
    # for my $k (qw(R1 R2 total)) {
    #     delete $res{$k}{read_len_hist};
    #     delete $res{$k}{q30_drop_hist};
    #     delete $res{$k}{q28_drop_hist};
    # }

    my $folder = fill_placeholders($outfolder, $samplenr);
    ensure_dir($folder);

    my $json_path = fill_placeholders(File::Spec->catfile($folder, "__BASE__.json"), $samplenr);
    my $txt_path  = fill_placeholders(File::Spec->catfile($folder, "__BASE__.txt"),  $samplenr);

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);

    open(my $jfh, ">", $json_path) or graceful_die("fastq_qc: Cannot write [$json_path]: $!");
    print {$jfh} $json->encode(\%res);
    close($jfh) or graceful_die("fastq_qc: Failed closing [$json_path]: $!");

    open(my $tfh, ">", $txt_path) or graceful_die("fastq_qc: Cannot write [$txt_path]: $!");

    my $print_bucket = sub {
        my ($label, $b) = @_;
        print {$tfh} "=== $label ===\n";
        print {$tfh} "Reads: $b->{reads}\n";
        print {$tfh} "Bases: $b->{bases}\n";
        print {$tfh} "Avg base quality (Phred): $b->{avg_qual}\n";
        print {$tfh} "Q30 bases: $b->{q30_bases}\n";
        print {$tfh} "Q30 %: $b->{q30_pct}\n";
        print {$tfh} "N bases: $b->{n_bases}\n";
        print {$tfh} "N %: $b->{n_pct}\n";
        print {$tfh} "GC %: $b->{gc_pct}\n";
        print {$tfh} "Read length (shortest/q05/q1/median/q3/average/longest): "
                   . "$b->{shortest} / $b->{q05} / $b->{q1} / $b->{median} / $b->{q3} / "
                   . sprintf("%.2f", $b->{average}) . " / $b->{longest}\n";
        print {$tfh} "Median position of first base < Q30: $b->{median_phred_q30_drop}\n";
        print {$tfh} "Median position of first base < Q28: $b->{median_phred_q28_drop}\n";
        print {$tfh} "Adapters checked (reads): $b->{adapters_checked}\n";
        print {$tfh} "Adapters found (reads): $b->{adapters_found}\n";
        print {$tfh} "Adapter % (of checked): $b->{adapter_pct}\n\n";
    };

    print {$tfh} "FASTQ QC summary\n";
    print {$tfh} "Files:\n";
    print {$tfh} "  R1: " . (defined($fq1) && $fq1 ne "" ? $fq1 : "(none)") . "\n";
    print {$tfh} "  R2: " . (defined($fq2) && $fq2 ne "" ? $fq2 : "(none)") . "\n\n";

    $print_bucket->("R1",    $res{R1});
    $print_bucket->("R2",    $res{R2});
    $print_bucket->("TOTAL", $res{total});

    print {$tfh} "Adapters searched:\n";
    print {$tfh} "  - $_\n" for @constants_adapters;

    close($tfh) or graceful_die("fastq_qc: Failed closing [$txt_path]: $!");

    return 0;
}




########################################

##########################################################################################
sub normalize_genomesize {
    my ($val) = @_;
    return "" unless defined $val;
    return "" if $val eq "" || $val =~ /^(0|auto)$/i;

    # Normalize case
    $val =~ s/\s+//g;
    my $multiplier = 1;

    if ($val =~ /^([\d.]+)\s*[kK]$/) {
        return int($1 * 1_000);
    }
    elsif ($val =~ /^([\d.]+)\s*[mM](b|bp)?$/) {
        return int($1 * 1_000_000);
    }
    elsif ($val =~ /^([\d.]+)\s*[gG](b|bp)?$/) {
        return int($1 * 1_000_000_000);
    }
    elsif ($val =~ /^(\d+)$/) {
        return int($1);  # already a plain integer
    }

    # Fallback → could not parse
    log_message( "WARNING: Could not parse genomesize [$val], treating as auto.\n");
    return "";
}


################################################################################################33






sub prepare_fastq_files {
    my ($path, $recursive_flag) = @_;
    $path //= ".";  # default to current dir
    my $recursive = $recursive_flag // 0;

    my $inputmode = 0;  # 1=single file, 2=dir, 3=recursive dir
    if (-f $path) {
        $inputmode = 1;
    } elsif (-d $path) {
        $inputmode = $recursive ? 3 : 2;
    } else {
        graceful_die("input path is not a file or directory [$path]");
    }

    my @listoffiles;

    if ($inputmode == 1) {
        # single file
        if (has_R1_extension($path)) {
            my $R1 = $path;
            my $R2 = toggle_R1R2_extension($R1);
            push @listoffiles, "$R1\t$R2" if -f $R1 && -f $R2;
        }
        if (has_R2_extension($path)) {
            my $R2 = $path;
            my $R1 = toggle_R1R2_extension($R2);
            push @listoffiles, "$R1\t$R2" if -f $R1 && -f $R2;
        } else {
            push @listoffiles, $path;
        }
    }
    elsif ($inputmode == 2 || $inputmode == 3) {
        push_files_in_dir($path, "fastq", \@listoffiles, $recursive ? 1 : 0);
        merge_R1R2(\@listoffiles);
    }

    return () unless @listoffiles;

# normalize paths and add basenames
my @output;
foreach my $analysispath (@listoffiles) {
    my ($R1path, $R2path) = split /\t/, $analysispath;
    my $fastq_stem = get_fastq_stem($R1path);

    # If R2 exists, keep full path, else empty
    $R2path //= "";

    # Build the output line
    my $line = join("\t", $R1path, $R2path, $fastq_stem);

    push @output, $line;
}

    return @output;
}

######################################################################################################


sub prepare_fasta_files {
    my ($path, $recursive_flag) = @_;
    $path //= ".";  # default to current dir
    my $recursive = $recursive_flag // 0;

    my $inputmode = 0;  # 1=single file, 2=dir, 3=recursive dir
    if (-f $path) {
        $inputmode = 1;
    } elsif (-d $path) {
        $inputmode = $recursive ? 3 : 2;
    } else {
        graceful_die("input path is not a file or directory [$path]");
    }

    my @listoffiles;

    if ($inputmode == 1) {
        # single file
        if (hasFASTAExtension($path)) {
            push @listoffiles, "$path" 
        }
       
    }
    elsif ($inputmode == 2 || $inputmode == 3) {
        push_files_in_dir($path, "fasta", \@listoffiles, $recursive ? 1 : 0);
    }

    return () unless @listoffiles;

# normalize paths and add basenames
my @output;
foreach my $analysispath (@listoffiles) {

    my $fasta_stem = get_fasta_stem($analysispath);

    # Build the output line
    my $line = join("\t", $analysispath, $fasta_stem);

    push @output, $line;
}

    return @output;
}


######################################################################################################


sub hasFASTQExtension {
    my ($path) = @_;
    $path = lc $path;

    return $path =~ /\.(fastq|fq)(\.gz)?$/;
}

sub hasFASTAExtension {
    my ($path) = @_;
    $path = lc $path;

    return $path =~ /\.(fasta|fa|fna)(\.gz)?$/;
}


###################################################################################################### 

sub push_files_in_dir {
    my ($dir, $filetype, $files_ref, $recursive) = @_;

    $filetype  = lc($filetype // "");
    $recursive = lc($recursive // "");

    opendir(my $dh, $dir) or graceful_die("Cannot open directory $dir: $!");

    while (my $file = readdir($dh)) {
        next if $file eq "." || $file eq "..";

        my $path = File::Spec->catfile($dir, $file);

        # Match filetype
        if ($filetype eq "fastq" && hasFASTQExtension($file)) {
            push @$files_ref, $path;
        }
        # Match filetype
        if ($filetype eq "fasta" && hasFASTAExtension($file)) {
            push @$files_ref, $path;
        }
        # Recurse into subdirectories
        if ($recursive eq "recursive" && -d $path) {
            push_files_in_dir($path, $filetype, $files_ref, $recursive);
        }
    }

    closedir($dh);
}

###################################################################################################
# Lightweight pre-check: does the input directory contain at least one
# FASTQ/FASTA file? Stops scanning as soon as one is found, anywhere in the
# tree -- it only needs a yes/no answer, not a complete list, so it can be
# much faster than the real file-discovery pass for large/deep directory
# trees, especially in the common case where a match turns up quickly.
# Used only to decide whether there's anything worth analyzing before any
# output-directory handling (which can be destructive) happens; the real,
# full scan later is unaffected by this and still runs as it always has.
sub any_input_files_exist {
    my ($dir, $recursive, $want_fastq, $want_fasta) = @_;
    $want_fastq = 1 unless defined $want_fastq;
    $want_fasta = 1 unless defined $want_fasta;

    opendir(my $dh, $dir) or graceful_die("Cannot open directory $dir: $!");

    my $found = 0;
    while (my $file = readdir($dh)) {
        next if $file eq "." || $file eq "..";

        if ( ($want_fastq && hasFASTQExtension($file)) || ($want_fasta && hasFASTAExtension($file)) ) {
            $found = 1;
            last;
        }

        my $path = File::Spec->catfile($dir, $file);
        if ($recursive && -d $path) {
            if ( any_input_files_exist($path, $recursive, $want_fastq, $want_fasta) ) {
                $found = 1;
                last;
            }
        }
    }

    closedir($dh);
    return $found;
}

###################################################################################################### 

sub merge_R1R2 {
    my ($files_ref) = @_;
    my @files = @$files_ref;

    my (@R1s, @R2s, @singletons);

    # Split into R1, R2, and singletons
    for my $file (@files) {
  
        if    (hasR1Extension($file)) {  push @R1s, $file }
        elsif (hasR2Extension($file)) { push @R2s, $file }
        else                                  { push @singletons, $file }
    }

    # Build a lookup table for R2s
    my %R2_lookup = map { $_ => 1 } @R2s;
    my %merged_R2s;

    # Empty the original array
    @$files_ref = ();

    # Merge R1 with matching R2
    for my $R1 (@R1s) {
        my $expected_R2 = toggleR1R2Extension($R1);

        if ($expected_R2 && $R2_lookup{$expected_R2}) {
            push @$files_ref, "$R1\t$expected_R2";
            $merged_R2s{$expected_R2} = 1;
        }
        else {
            push @$files_ref, $R1;
        }
    }

    # Add unpaired R2s
    for my $R2 (@R2s) {
        push @$files_ref, $R2 unless $merged_R2s{$R2};
    }

    # Add singletons
    push @$files_ref, @singletons;
}
###################################################################################################### 


###################################################################################################### 


sub hasR1Extension {
    my ($path) = @_;
    $path = lc $path;
    $path =~ s{[\\/]+$}{};   # remove trailing / or \

    # Build regex from extensions
    my $ext_regex = join "|", map { quotemeta } @constants_R1_extensions;

    return $path =~ /(?:$ext_regex)$/ ? 1 : 0;
}

sub hasR2Extension {
    my ($path) = @_;
    $path = lc $path;
    $path =~ s{[\\/]+$}{};   # remove trailing / or \

    # Build regex from extensions
    my $ext_regex = join "|", map { quotemeta } @constants_R2_extensions;
    
    return $path =~ /(?:$ext_regex)$/ ? 1 : 0;
}

###################################################################################################### 


sub get_fastq_stem {
    my ($path) = @_;

    # Get the last part of the path
    my $filename = basename($path);

    # Remove trailing slashes or backslashes
    $filename =~ s{[\\/]+$}{};

    # Build regex for all extensions
    my @all_exts = (
        @constants_R1_extensions,
        @constants_R2_extensions,
        @constants_fq_extensions
    );

    # Join extensions into regex, escape dots
    my $ext_pattern = join('|', map { quotemeta($_) } @all_exts);

    # Remove known extension (case-insensitive)
    $filename =~ s/($ext_pattern)$//i;

    return $filename;
}

####################################################################################


sub get_fasta_stem {
    my ($path) = @_;

    # Get the last part of the path
    my $filename = basename($path);

    # Remove trailing slashes or backslashes
    $filename =~ s{[\\/]+$}{};



    # Join extensions into regex, escape dots
    my $ext_pattern = join('|', map { quotemeta($_) } @constants_fasta_exts);

    # Remove known extension (case-insensitive)
    $filename =~ s/($ext_pattern)$//i;

    return $filename;
}

###################################################################################################### 

sub normalize_path {
    my ($path) = @_;
    return $path unless defined $path && $path ne "";

    # Collapse multiple slashes into a single slash
    $path =~ s{//+}{/}g;

    # Remove trailing slash unless it's the root "/"
    $path =~ s{/$}{} unless $path eq "/";

    # Lexically resolve "." and ".." segments. Purely string-based -- does not
    # touch the filesystem, so it works even for paths that don't exist yet
    # (e.g. an out/db root directory being created for the first time).
    my $is_absolute = ($path =~ m{^/});
    my @stack;
    for my $part (split m{/}, $path) {
        next if $part eq "" || $part eq ".";
        if ($part eq "..") {
            pop @stack if @stack && $stack[-1] ne "..";
        }
        else {
            push @stack, $part;
        }
    }
    my $resolved = join("/", @stack);
    $resolved = "/$resolved" if $is_absolute;
    $resolved = "." if $resolved eq "";

    return $resolved;
}

###################################################################################################### 


sub toggleR1R2Extension {
    my ($path_casesens) = @_;
    my $path = lc $path_casesens;

    # Strip trailing / or \
    $path =~ s{[\\/]+$}{};

    for my $i (0 .. $#constants_R1_extensions) {
        my $R1_ext = $constants_R1_extensions[$i];
        my $R2_ext = $constants_R2_extensions[$i];

        # helper closure: transfer case pattern
        my $apply_case = sub {
            my ($from, $to) = @_;
            my $result = '';
            for my $j (0 .. length($from) - 1) {
                my $char = substr($to, $j, 1);
                $result .= (substr($from, $j, 1) =~ /[A-Z]/) ? uc $char : lc $char;
            }
            return $result;
        };

        # Case: R1 → R2
        if ($path =~ /\Q$R1_ext\E$/) {
            my $len = length($R1_ext);
            my $caseSens_R1_ext = substr($path_casesens, -$len);
            my $caseSens_R2_ext = $apply_case->($caseSens_R1_ext, $R2_ext);
            return substr($path_casesens, 0, -$len) . $caseSens_R2_ext;
        }

        # Case: R2 → R1
        if ($path =~ /\Q$R2_ext\E$/) {
            my $len = length($R2_ext);
            my $caseSens_R2_ext = substr($path_casesens, -$len);
            my $caseSens_R1_ext = $apply_case->($caseSens_R2_ext, $R1_ext);
            return substr($path_casesens, 0, -$len) . $caseSens_R1_ext;
        }
    }

    # No match
    return "";
}

######################################################################################################   


###################################################################################################### 

sub log_tool_versions {

    my ($mode, $logdir) = @_;

    # NOTE: deliberately not cached, unlike ensure_tool_version()'s fingerprint
    # cache. This function's job is to record what was ACTUALLY installed at
    # the time of THIS run (see $rundata{provenance}{run}{tools} below, used
    # for audit/accreditation traceability) -- caching it across runs would
    # mean recording a possibly-stale snapshot instead of ground truth, which
    # would defeat that purpose. The conda list --explicit call per tool is
    # genuinely doing real, necessary work, not avoidable overhead.

    my $summary_str = "";
    my $summary_fh;

    if ( $logdir ne "" ) {
        open $summary_fh, ">", "$logdir/versions_summary.txt"
            or die "Cannot write summary: $!";
        ensure_dir( "$logdir/versioning_explicit");    
    }


    my @tool_array;
            
    for my $tool (sort keys %$R_cfg) {
        # Defensive, explicit skip for the non-tool top-level sections (these
        # also get skipped implicitly below since they have no "env" key, but
        # that's incidental, not a documented contract -- skip them by name
        # too so this doesn't silently break if one of them ever gains an
        # "env"-named field for an unrelated reason).
        next if $tool eq 'general' || $tool eq 'chewbbaca_schemas' || $tool eq 'species';

        my $tool_cfg = $R_cfg->{$tool};
        next unless ref($tool_cfg) eq 'HASH';  # skip global scalars

        # Skip unless enabled if $mode eq "enabled". Defaults to enabled if
        # the field is missing entirely, rather than silently excluding the
        # tool from this audit-trail record -- better to slightly
        # over-include here than to have a gap in what's documented as
        # having run. (enabled is guaranteed numeric 0/1 by the time it gets
        # here, normalized at config-load time, so a plain truthy check is
        # enough -- no more need for the old defensive "yes"-string check.)
        if ($mode eq "enabled") {
            next unless ($tool_cfg->{enabled} // 1);
        }

        my $env = $tool_cfg->{env} // next;
        my $pkg_name = $tool_cfg->{package_name} // $tool;

        next if $env eq "base";

        # Capture explicit output in memory
        my $explicit_text = qx(conda list --explicit -n $env 2>/dev/null);
        if ($? != 0) {
            $explicit_text = "";
        }

        # Optionally dump to file
        if ($logdir ne "") {

            my $explicit_file = "$logdir/versioning_explicit/$env.explicit";
            if (!-e $explicit_file) {
                if (open my $fh, ">", $explicit_file) {
                    print $fh $explicit_text;
                    close $fh;
                }
                else {
                    log_message("WARNING: Could not open [$explicit_file] for writing: $!");
                }
            }
        }

        # Parse short version
        my $version = parse_conda_explicit_version($pkg_name, $explicit_text);

        $summary_str .= "$tool\t$version\n";

        if ($logdir ne "") {
            print $summary_fh "$tool\t$version\n";
        }

       print_tabular_results($tool, $version,"green");
       
       $rundata{provenance}{run}{tools}{$tool}{version} = $version;
       $rundata{provenance}{run}{tools}{$tool}{package_name} = $pkg_name;      
       $rundata{provenance}{run}{tools}{$tool}{env} = $env;    
       
       push @tool_array, $tool;
    }

    $rundata{provenance}{run}{tools}{tool_list} = \@tool_array;
    
    close $summary_fh if $logdir ne "";
    return $summary_str;
}

#####################################3

sub parse_conda_explicit_version {
    my ($pkg_name, $explicit_text) = @_;

    for my $line (split /\n/, $explicit_text) {
        next if $line =~ /^#/;

        # Match package entries like:
        # https://.../checkm-genome-1.2.3-pyhdfd78af_1.tar.bz2
        # https://.../ncbi-amrfinderplus-4.0.19-hf69ffd2_0.tar.bz2
        if ($line =~ m{/([^/]+?)-([0-9][A-Za-z0-9\.\-_]*)-(?:[^/]+)\.(?:tar\.bz2|conda)$}) {
            my ($pkg, $ver) = ($1, $2);
            if ($pkg eq $pkg_name) {
                return $ver;
            }
        }
    }

    return "not found";
}


##########################################################################################3

sub detect_os {
    my $os = $^O;

    return 'Linux'   if $os eq 'linux';
    return 'macOS'   if $os eq 'darwin';
    return 'Windows' if $os =~ /MSWin32|cygwin|msys/;
    return 'BSD'     if $os =~ /bsd$/i;
    return 'Solaris' if $os =~ /solaris|sunos/i;

    return "Other ($os)";
}


sub is_docker {
   if ( $rundata{system_info}{runmode} eq "docker" ){ 
     return 1; 
   }
   else{ 
     return 0;  
   }  
}   

sub is_conda {
   if ($rundata{system_info}{runmode} eq "conda"  ){ 
     return 1; 
   }
   else{ 
     return 0;  
   }  
} 

sub is_windows{
   if ($rundata{system_info}{os} eq "Windows"){ 
     return 1; 
   }
   else{ 
     return 0;  
   }  
} 

sub is_linux{
   if ($rundata{system_info}{os} eq "Linux"){ 
     return 1; 
   }
   else{ 
     return 0;  
   }  
} 

sub is_mac{
   if ($rundata{system_info}{os} eq "macOS"){ 
     return 1; 
   }
   else{ 
     return 0;  
   }  
} 
#######################################################################################3

sub bytes_to_human_readable_filesize {
    my ($bytes) = @_;
    return "n/a" unless defined $bytes && $bytes =~ /^\d+$/;

    my @units = ("B", "kB", "MB", "GB", "TB");  # note lowercase k (SI standard)
    my $i = 0;
    my $size = $bytes;

    while ($size >= 1000 && $i < $#units) {
        $size /= 1000;
        $i++;
    }

    return sprintf("%.2f %s", $size, $units[$i]);
}

sub human_readable_filesize {
    my ($filepath) = @_;

    return "n/a" unless -e $filepath;

    my $size = -s $filepath;
    return bytes_to_human_readable_filesize($size);
}
###############################################################################

sub file_date {
    my ($filepath) = @_;

    return "n/a"
        if !defined $filepath || $filepath eq "";

    return "n/a"
        if !-e $filepath;

    my @st = CORE::stat($filepath);
    return "n/a"
        unless @st;

    my $mtime = $st[9];
    return strftime("%Y-%m-%d", localtime($mtime));
}

#############################################################################3

sub checkversion_db {
    my ($filepath, $tool) = @_;

    return "NA" unless defined $filepath && -e $filepath;

    $tool //= "Unknown";

    my $md5file = "$filepath.md5";
    my $md5 = "";

    # --- Case 1: .md5 file already exists ---
    if (-f $md5file) {
        if (open my $fh, "<", $md5file) {
            chomp($md5 = <$fh>);
            close $fh;
        }
        else {
            log_message("INFO: Could not read $md5file: $!");
        }
    }

    # --- Case 2: calculate md5 if needed ---
    if (!$md5) {
        if (is_linux()) {
            log_message("NOTICE: Determining version of $tool database");
            $md5 = `md5sum "$filepath"`;
            $md5 =~ s/\s.*//;
            chomp $md5;
        }
        elsif (is_mac()) {
            log_message("NOTICE: Determining version of $tool database");
            $md5 = `md5 -q "$filepath"`;
            chomp $md5;
        }
        else {
            return "NA";
        }

        # Save hash to .md5 file
        if ($md5) {
            if (open my $out, ">", $md5file) {
                print $out "$md5\n";
                close $out;
            }
            else {
                log_message("WARNING: Could not write $md5file: $!");
            }
        }
    }

    my %reference = (
        "c178de95917bab087fa6494949314ce4" => "Kraken2, Viral, Release: 10/15/25",
        "46a10e0e6935d5c070253e0d89adb927" => "Kraken2, MinusB, Release: 10/15/25",
