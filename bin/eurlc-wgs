        "trim_rate_reads",                 
        "trimmed_bases",   
        "trim_rate_bases",                       
        "trimmed_readlength_R1",
        "trimmed_readlength_R2",                
        "trimmed_Q30rate",        
        "trimmed_GC",
        "trimmed_coverage",        
        "trimmed_Q30coverage", 
        "downsampling",  
        "contamination_species",         
        "contamination_genus",   
        "contamination_species_level",         
        "contamination_genus_level",  
        "mash_status",  
        "spades_contigs",        
        "spades_contigs500p",                
        "spades_N50",
        "spades_size",
        "shovil_contigs",        
        "shovil_contigs500p",                
        "shovil_N50",
        "shovil_size",
        "skesa_contigs",        
        "skesa_contigs500p",                
        "skesa_N50",
        "skesa_size",                
        "variants_5",        
        "variants_10",
        "variants_20",
        "CDSs",                        
        "ST",           
        "CC",                   
    );

    my $header = join("\t", @header_fields) . "\n";

    print $fh $header;
        
    log_message("NOTICE: Printing result table for $number_samples samples");

    for (my $i = 0; $i < $number_samples; $i++) {

       my $genomesize = $R_samples->[$i]{estimated_genomesize};
       my $targetbases =  $R_samples->[$i]{targetbases};
       my $maxdepth =  $R_samples->[$i]{maxdepth};
       my $mindepth =  $R_samples->[$i]{fatal_mindepth};
       my $gc =  $R_samples->[$i]{gc} ;
       
     my $target = $R_samples->[$i]{results}{fastp}{raw};

      my $total_bases_before = $target->{summary}{before_filtering}{total_bases};
      my $total_Q30bases_before = $target->{summary}{before_filtering}{q30_bases};
      
      my $coverage_before = 0;
      my $coverageQ30_before = 0;
      
      if($genomesize >0){
        $coverage_before = int ($total_bases_before/$genomesize) ;
        $coverageQ30_before = int ($total_Q30bases_before/$genomesize) ;
      }
      my $total_bases_after = $target->{summary}{after_filtering}{total_bases};
       my $total_Q30bases_after = $target->{summary}{after_filtering}{q30_bases};
       
       my $coverage_after = 0;
       my $coverageQ30_after = 0;
       
       if($genomesize >0){
         $coverage_after = int ($total_bases_after/$genomesize) ;
         $coverageQ30_after = int ($total_Q30bases_after/$genomesize) ;
       }  
 

     my $trim_rate_reads = safe_rel($R_samples->[$i]{results}{fastp}{raw}{read1_after_filtering}{total_reads}, $R_samples->[$i]{results}{fastp}{raw}{read1_before_filtering}{total_reads},0);
     my $trim_rate_bases = safe_rel($R_samples->[$i]{results}{fastp}{raw}{read1_after_filtering}{total_bases}, $R_samples->[$i]{results}{fastp}{raw}{read1_before_filtering}{total_bases},0);
      
        my $sample_type = $R_samples->[$i]{type};

        my @data_fields = (
        $i, # "Sample_number",
        $R_samples->[$i]{name},    #"Sample_name",
        $R_samples->[$i]{type},    #"Sample_type",
        $R_samples->[$i]{results}{fastqc_rawdata}{R1}{adapters}{NexteraTransposaseSequence},    #"rawdata_nextera adapter_content_R1",          
        $R_samples->[$i]{results}{fastqc_rawdata}{R1}{adapters}{IlluminaUniversalAdapter},  #"rawdata_Illumina_universal adapter_content_R1",   
