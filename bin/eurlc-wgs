        packages => [
            { name => "bowtie2",  },
            { name => "samtools", },
            { name => "bcftools", },
        ],
    }, 
    # Intra-species mixture metric of the remap step (see parse_pileup_minor_af_metrics).
    remap_mixture => {
        min_minor_reads            => 4,
        min_minor_reads_per_strand => 1,
        min_minor_af               => 0.05,
        min_depth_ratio            => 0.5,
        max_depth_ratio            => 1.5,
        min_contig_length          => 2000,
