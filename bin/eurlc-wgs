       __BASE__.sorted.bam
       __HIDE-OUTPUT__               
    __NEWCOMMAND__              
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools stats 
       __BASE__.sorted.bam > __BASE__.stats
       __HIDE-STDERR__    
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools flagstat 
       __BASE__.sorted.bam > __BASE__.flagstats
       __HIDE-STDERR__    
