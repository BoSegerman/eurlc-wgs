#    interop_index1                => "CGTACTAG",
#    interop_index2                => "ACTGCATA",
#    interop_project               => "NA",
#};


sub map_interop_index_summary_to_samples {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my $R_index_summary = $R_interop->{index_summary};
    return 0 if !defined $R_index_summary || ref($R_index_summary) ne 'HASH';

    my $matched   = 0;
    my $unmatched = 0;

    my @lanes = sort { $a <=> $b } grep { /^\d+$/ } keys %{ $R_index_summary->{lanes} || {} };
    return 0 if !@lanes;

    # For now, search all lanes
    my %by_sample_id;
    foreach my $lane (@lanes) {
        my $R_lane = $R_index_summary->{lanes}{$lane};
        next if !defined $R_lane || ref($R_lane) ne 'HASH';
        next if !defined $R_lane->{by_sample_id} || ref($R_lane->{by_sample_id}) ne 'HASH';

        foreach my $sample_id (keys %{ $R_lane->{by_sample_id} }) {
            $by_sample_id{$sample_id} ||= $R_lane->{by_sample_id}{$sample_id};
            $by_sample_id{$sample_id}{lane} ||= $lane;
        }
    }

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        my $sample_name = $R_samples->[$samplenr]{name} // '';
        next if $sample_name eq '';

        my $R_match = $by_sample_id{$sample_name};

        if (!defined $R_match || ref($R_match) ne 'HASH') {
            $unmatched++;
            next;
        }

        $R_samples->[$samplenr]{main_results}{run_data} ||= {};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_lane}
            = $R_match->{lane}
            if defined $R_match->{lane};

        $R_samples->[$samplenr]{main_results}{run_data}{pct_read_identified_pf_sample}
            = $R_match->{pct_read_identified_pf}
            if defined $R_match->{pct_read_identified_pf};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index1}
            = $R_match->{index1}
            if defined $R_match->{index1};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index2}
            = $R_match->{index2}
            if defined $R_match->{index2};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_project}
            = $R_match->{project}
            if defined $R_match->{project};

        $R_samples->[$samplenr]{main_results}{run_data}{interop_index_number}
            = $R_match->{index_number}
            if defined $R_match->{index_number};

        $matched++;
    }

    log_message("NOTICE: InterOp index-summary mapping complete: matched [$matched], unmatched [$unmatched]", "green");

    return 1;
}


sub map_interop_run_summary_to_matched_samples {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my %run_data = ();

    my $R_summary = $R_interop->{summary};
    return 0 if !defined $R_summary || ref($R_summary) ne 'HASH';

    $run_data{pf_pct}              = 100 * $R_interop->{index_summary}{lanes}{1}{totals}{pf_reads} / $R_interop->{index_summary}{lanes}{1}{totals}{total_reads}
        if defined $R_interop->{index_summary}{lanes}{1}{totals}{pf_reads}
        && defined $R_interop->{index_summary}{lanes}{1}{totals}{total_reads}
        && $R_interop->{index_summary}{lanes}{1}{totals}{total_reads} > 0;

    $run_data{cluster_density}     = $R_summary->{derived}{cluster_density_mean}
        if defined $R_summary->{derived}{cluster_density_mean};

    $run_data{cluster_pf}          = $R_summary->{derived}{cluster_pf_mean}
        if defined $R_summary->{derived}{cluster_pf_mean};

    $run_data{total_yield_gb}      = $R_summary->{derived}{total_yield_gb}
        if defined $R_summary->{derived}{total_yield_gb};

    $run_data{nonindexed_yield_gb} = $R_summary->{derived}{nonindexed_yield_gb}
        if defined $R_summary->{derived}{nonindexed_yield_gb};

    $run_data{total_pct_q30}       = $R_summary->{derived}{total_pct_q30}
        if defined $R_summary->{derived}{total_pct_q30};

    $run_data{read1_pct_q30}       = $R_summary->{totals}{"Read 1"}{pct_q30}
        if defined $R_summary->{totals}{"Read 1"}{pct_q30};

    $run_data{read2_pct_q30}       = $R_summary->{totals}{"Read 4"}{pct_q30}
        if defined $R_summary->{totals}{"Read 4"}{pct_q30};

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        next if !defined $R_samples->[$samplenr]{main_results}{run_data}{pct_read_identified_pf_sample};

        $R_samples->[$samplenr]{main_results}{run_data} ||= {};

        foreach my $key (keys %run_data) {
            $R_samples->[$samplenr]{main_results}{run_data}{$key} = $run_data{$key};
        }
    }

    return 1;
}


##################################33

sub prompt_yes_no {
    my ($question, $default_yes) = @_;

    my $default = $default_yes ? "Y/n" : "y/N";
    print "$question [$default]: ";

    my $answer = <STDIN>;
    chomp $answer;
    $answer =~ s/\s+//g;

    return $default_yes if $answer eq '';
    return 1 if $answer =~ /^y(es)?$/i;
    return 0 if $answer =~ /^n(o)?$/i;

    print "Please answer y or n.\n";
    return prompt_yes_no($question, $default_yes);
}

sub prompt_yes_no_yesstoall {
    my ($question, $default_yes) = @_;

    my $default = $default_yes ? "Y/n/a" : "y/N/a";
    print "$question [$default (a=assume yes for following questions)]: ";

    my $answer = <STDIN>;
    chomp $answer;
    $answer =~ s/\s+//g;

    return $default_yes if $answer eq '';
    return 1 if $answer =~ /^y(es)?$/i;
    return 0 if $answer =~ /^n(o)?$/i;

   if($answer =~ /^a?$/i){
     $ASSUME_YES = 1;
     return 1;
   }

    print "Please answer y or n.\n";
    return prompt_yes_no_yesstoall($question, $default_yes);
}

# Conda-mode only: if the database directory doesn't exist, prompts to
# create it and does so (mkdir -p, so any missing parent directories are
# created too). Returns 1 if the directory exists or was successfully
# created, 0 if the user declined or creation failed. Used by both the
# configfile=write premount handler and the mount-check section -- both
# need this same "prompt + create" sequence, previously duplicated
# independently in each. Docker mode is NOT handled here, since the two
# callers need genuinely different docker behavior (configfile=write must
# abort -- there's nowhere persistent to write a config file -- while the
# general mount-check instead falls back to an internal default path).
sub prompt_and_create_dir {
    my ($dir) = @_;

    return 1 if -d $dir;

    unless ($ASSUME_YES) {
        my $answer = prompt_yes_no("The directory [$dir] does not exist. Do you want to create it?", 0);
        return 0 unless $answer;
    }

    execute_and_log( "mkdir -p '$dir'" );

    return -d $dir ? 1 : 0;
}

sub conda_env_exists {
    my ($env_name) = @_;

    my $cmd = "conda env list | awk '{print \$1}'";
    my @envs = `$cmd 2>/dev/null`;
    chomp @envs;

    return scalar grep { $_ eq $env_name } @envs;
}

# Expands a tool's config into a list of { exe, test_command } checks to
# perform: one entry per package if "packages => [...]" is defined (new-style
# multi-package tools like bowtie2), otherwise a single entry for the tool's
# program_name/key (old-style single-program tools). Shared by
# validate_tool_installation() and check_conda_env_and_programs() so there is
# one place that defines "what counts as installed" for a tool.
sub expand_tool_checks {
    my ($prog) = @_;

    my $cfg = $R_cfg->{$prog} // {};
    my @checks;

    if (ref($cfg->{packages}) eq 'ARRAY' && @{$cfg->{packages}}) {
        for my $p (@{$cfg->{packages}}) {
            my $exe =
                   $p->{program_name}
                // $p->{exe}
                // $p->{bin}
                // $p->{name}
                // $p->{package_name};

            if (!defined $exe || $exe eq "") {
                # Config problem, not an install failure -- but this function is
                # shared by required AND optional tool code paths, so it must never
                # die here. Log it and report "nothing to check" -- the caller
                # already treats an empty/failed check list as validation failure.
                log_message("ERROR: expand_tool_checks: packages entry missing executable/name under '$prog'", "red");
                return ();
            }

            push @checks, { exe => $exe, test_command => ($p->{test_command} // undef) };
        }
    }
    else {
        my $program_name = $prog;
        if (defined $cfg->{program_name} && $cfg->{program_name} ne "") {
            $program_name = $cfg->{program_name};
        }
        push @checks, { exe => $program_name, test_command => ($cfg->{test_command} // undef) };
    }

    # De-duplicate (by exe+test_command, in case name==program_name etc.)
    my %seen;
    @checks = grep {
        my $k = ($_->{exe} // "") . "\t" . ($_->{test_command} // "");
        !$seen{$k}++
    } @checks;

    return @checks;
}

# Runs a single { exe, test_command } check against a conda env. Prefers the
# configured test_command (e.g. "kraken2 --version") when available, since
# that confirms the program actually runs, not just that a same-named file
# exists in PATH; falls back to a plain "which" check otherwise.
sub run_tool_check {
    my ($env, $check) = @_;

    my $cmd = $check->{test_command}
        ? "conda run -n $env --no-capture-output $check->{test_command} >/dev/null 2>&1"
        : "conda run -n $env --no-capture-output which $check->{exe} >/dev/null 2>&1";

    return system($cmd) == 0;
}

sub validate_tool_installation {
    my ($env, $prog) = @_;

    if (!defined $env || $env eq "") {
        log_message("ERROR: validate_tool_installation: missing env", "red");
        return 0;
    }
    if (!defined $prog || $prog eq "") {
        log_message("ERROR: validate_tool_installation: missing prog", "red");
        return 0;
    }

    my @checks = expand_tool_checks($prog);
    return 0 unless @checks;  # empty = config problem already logged by expand_tool_checks; treat as failure

    for my $check (@checks) {
        return 0 unless run_tool_check($env, $check);  # at least one required program not found/working
    }

    return 1;
}



sub ensure_conda_tool {
    my ($toolname, $auto) = @_;
    $auto //= 0;

    my $cfg = $R_cfg->{$toolname};
    if (!$cfg) {
        log_message("ERROR: No config found for tool '$toolname'", "red");
        return 0;
    }

    my $env = $cfg->{env};
    if (!$env) {
        log_message("ERROR: No env specified for tool '$toolname'", "red");
        return 0;
    }

    log_message("INFO: Checking conda environment for $toolname [$env]");

    my $yml_file = find_env_yml($cfg);

    if (defined $yml_file && $yml_file ne "") {
        log_message("INFO: Found conda YAML for $toolname: [$yml_file]");
    }
    else {
        log_message("INFO: No conda YAML found for $toolname; falling back to package specifications");
    }

    # ------------------------------------------------------------------
    # Build fallback package spec list
    # ------------------------------------------------------------------

    my @pkg_specs;

    if (!$yml_file) {

        if (ref($cfg->{packages}) eq 'ARRAY' && @{$cfg->{packages}}) {
            for my $p (@{$cfg->{packages}}) {
                my $name = $p->{name} // $p->{package_name};

                if (!defined $name || $name eq "") {
                    log_message("ERROR: packages entry missing name for tool '$toolname'", "red");
                    return 0;
                }

                my $ver = $p->{version} // $p->{install_version};

                push @pkg_specs,
                    (defined($ver) && length($ver))
                    ? "$name=$ver"
                    : $name;
            }
        }
        else {
            my $pkg = $cfg->{package_name};
            if (!$pkg) {
                log_message("ERROR: No package_name for tool '$toolname' and no YAML found", "red");
                return 0;
            }

            my $version = $cfg->{install_version};

            push @pkg_specs,
                (defined($version) && length($version))
                ? "$pkg=$version"
                : $pkg;
        }

        my %seen;
        @pkg_specs = grep { !$seen{$_}++ } @pkg_specs;
    }

    # ------------------------------------------------------------------
    # Existing environment
    # ------------------------------------------------------------------

    if (conda_env_exists($env)) {
        log_message("INFO: Conda env '$env' exists");

        my $ok_update = 1;

        if ($yml_file) {
            my @cmd = (
                "conda", "env", "update",
                "-n", $env,
                "-f", $yml_file,
                "--prune"
            );

            log_message("NOTICE: Updating env '$env' from YAML [$yml_file]");
            log_message("DEBUG: " . join(" ", @cmd));

            system(@cmd);
            if ($? != 0) {
                log_message("ERROR: Conda env update failed for env '$env' using YAML [$yml_file]", "red");
                $ok_update = 0;
            }
        }
        else {
            my @cmd = (
                "conda", "install", "-y",
                "-n", $env,
                "-c", "conda-forge", "-c", "bioconda",
                @pkg_specs
            );

            log_message("NOTICE: Ensuring packages in env '$env': " . join(", ", @pkg_specs));
            log_message("DEBUG: " . join(" ", @cmd));

            system(@cmd);
            if ($? != 0) {
                log_message("ERROR: Conda install/update failed for env '$env'", "red");
                $ok_update = 0;
            }
        }

        return 0 if !$ok_update;

        if (validate_tool_installation($env, $toolname)) {
            log_message("INFO: $toolname validated in $env");
            return 1;
        }
        else {
            log_message("WARNING: Env exists but $toolname validation failed", "red");
            return 0;
        }
    }

    # ------------------------------------------------------------------
    # Missing environment: ask/create
    # ------------------------------------------------------------------

    if ($ASSUME_YES) {
        $auto = 1;
    }

    my $install = $auto
        ? 1
        : prompt_yes_no_yesstoall(
              "Conda env '$env' for $toolname is missing or broken. Create it?",
              0
          );

    unless ($install) {
        log_message("ERROR: Required tool $toolname not installed", "red");
        return 0;
    }

    if ($yml_file) {
        my @cmd = (
            "conda", "env", "create",
            "-f", $yml_file
        );

        log_message("NOTICE: Creating conda env '$env' from YAML [$yml_file]");
        log_message("DEBUG: " . join(" ", @cmd));

        system(@cmd);
        if ($? != 0) {
            log_message("ERROR: Conda environment creation failed for $toolname using YAML [$yml_file]", "red");
            return 0;
        }
    }
    else {
        my @cmd = (
            "conda", "create", "-y",
            "-n", $env,
            "-c", "conda-forge", "-c", "bioconda",
            @pkg_specs
        );

        log_message("NOTICE: Creating conda env '$env' with: " . join(", ", @pkg_specs));
        log_message("DEBUG: " . join(" ", @cmd));

        system(@cmd);
        if ($? != 0) {
            log_message("ERROR: Conda installation failed for $toolname", "red");
            return 0;
        }
    }

    if (validate_tool_installation($env, $toolname)) {
        log_message("NOTICE: $toolname successfully installed in $env", "green");
        return 1;
    }
    else {
        log_message("ERROR: $toolname installed but validation failed", "red");
        return 0;
    }
}


sub writedefaultconfigfile {
   

 if(-f $rundata{config}{path}) {

           if ($ASSUME_YES) {
               graceful_die("Configfile [$rundata{config}{path}] already exists -- overwriting it is a destructive decision and is never auto-approved under assume-yes.");
           }

           my $answer = prompt_yes_no("WARNING: The configfile [$rundata{config}{path}] already exists. Do you want to overwrite it?", 0);

           log_message("INFO: Prompted. Do you want to overwrite config file. answer =[" . ($answer ? "y" : "n") . "]"); 

           unless ($answer) {
               graceful_die("User declined to overwrite existing configfile [$rundata{config}{path}]");
           }
    
            
}            

    #################################################################
    #################################################################
    # Optionally write a default INI file
    
    if (-d getdir("db")) {
       log_message("INFO: Attempting to write a default config file to: [$rundata{config}{path}]");

       if (open my $fh, '>', $rundata{config}{path}) {
          print $fh "; Auto-generated default config file\n";
          print $fh "; Written: " . scalar(localtime) . "\n\n";

          # --- Write tool/general settings ---
          foreach my $section (sort keys %{$rundata{config}{effective}}) {
            next if ($section eq "chewbbaca_schemas" || $section eq "species"); # handled separately
            next unless ref($R_cfg->{$section}) eq 'HASH';

            print $fh "[$section]\n";
            foreach my $param (sort keys %{$R_cfg->{$section}}) {
                my $value = $R_cfg->{$section}{$param};
                print $fh "$param=$value\n";
            }
            print $fh "\n";
          }

          # --- Write schemas ---
          if (exists $rundata{config}{effective}{chewbbaca_schemas} &&
            ref($rundata{config}{effective}{chewbbaca_schemas}) eq 'HASH') {

            foreach my $schema_name (sort keys %{$rundata{config}{effective}{chewbbaca_schemas}}) {
                my $schema = $rundata{config}{effective}{chewbbaca_schemas}{$schema_name};
                print $fh "[chewbbaca_schema_$schema_name]\n";
                foreach my $k (qw(species path filter)) {
                    my $v = $schema->{$k} // "";
                    print $fh "$k=$v\n";
                }
                print $fh "\n";
            }
          }

          # --- Write species ---
          if (exists $rundata{config}{effective}{species} &&
            ref($rundata{config}{effective}{species}) eq 'HASH') {

            foreach my $species_name (sort keys %{$rundata{config}{effective}{species}}) {
                my $species = $rundata{config}{effective}{species}{$species_name};
                print $fh "[species__$species_name]\n";
                foreach my $k (qw(genomesize schema gc maxdepth fatal_mindepth filter)) {
                    my $v = $species->{$k} // "";
                    print $fh "$k=$v\n";
                }
                print $fh "\n";
            }
          }

          close $fh;
          log_message("NOTICE: A default config file was written to [$rundata{config}{path}] - modify this if needed");
       }
       else {
          log_message("INFO: Could not create default config file [$rundata{config}{path}]. Msg: [$!]");
          return 0; #failed
       }
    }
    else {
       log_message("INFO: Database path " . getdir("db") . " does not exist  — skipping writing default config");
       return 0; #failed
    }
    
    return 1; #success
}

# compute_chewbbaca_distance_matrix
# ---------------------------------
#  Args:
#    $chew_ref: parsed chewBBACA structure
#    %opts:
#       report_distance      => INT (default 5)
#       report_pct_success   => FLOAT (default 0.9)
#       treat_missing_patterns => ARRAYREF of regexes
#       out_prefix           => base path for TSV exports (optional)
#
#  Returns hashref with:
#       sample_names, order, distance_matrix, percent_success,
#       diff_alleles, diff_allele_values, n_positions
#
sub compute_chewbbaca_distance_matrix {
    my ($chew_ref, %opts) = @_;

    $opts{report_distance}      //= 5;
    $opts{report_pct_success}   //= 0.90;
    $opts{treat_missing_patterns} //= [];
    my $out_prefix = $opts{out_prefix};

    die "Invalid chewbbaca structure"
        unless ref($chew_ref) eq 'HASH' && ref($chew_ref->{data}) eq 'ARRAY';

    my @allele_header = @{ $chew_ref->{allele_header} // [] };
    my @rows          = @{ $chew_ref->{data} };

    my @sample_names;
    my %alleles_by_sample;

    for my $r (@rows) {
        next unless ref $r eq 'HASH' && $r->{file};
        push @sample_names, $r->{file};
        my @a = exists $r->{alleles} ? @{ $r->{alleles} } : ();
        push @a, (undef) x (scalar(@allele_header) - scalar(@a)) if @a < @allele_header;
        $alleles_by_sample{$r->{file}} = \@a;
    }

    my $is_missing = sub {
        my ($v) = @_;
        return 1 unless defined $v;
        $v =~ s/^\s+|\s+$//g;
        return 1 if $v eq '' || $v eq '-' || $v =~ /^INF-?$/i;
        return 1 if $v =~ /^(PLOT3|PLOT5|LOTSC|NIPH|NIPHEM|ALM|ASM|PAMA|LNF)$/i;
        for my $pat (@{ $opts{treat_missing_patterns} }) {
            return 1 if $v =~ /$pat/;
        }
        return 0;
    };

    my $normalize = sub {
        my ($v) = @_;
        return undef if $is_missing->($v);
        $v =~ s/^\s+|\s+$//g;
        $v =~ s/^INF[-_](\d+)$/$1/i;
        return $v;
    };

    my (%distance, %compared, %percent_success);
    my (%diff_alleles, %diff_allele_values);

    my $n_samples   = scalar @sample_names;
    my $n_positions = scalar @allele_header;

    for my $i (0 .. $n_samples - 1) {
        my $si = $sample_names[$i];
        for my $j ($i + 1 .. $n_samples - 1) {
            my $sj = $sample_names[$j];
            my ($diff_count, $compares) = (0, 0);
            my (@diff_names, @diff_vals);

            my $ai = $alleles_by_sample{$si};
            my $aj = $alleles_by_sample{$sj};

            for my $p (0 .. $n_positions - 1) {
                my $vi = $normalize->($ai->[$p]);
                my $vj = $normalize->($aj->[$p]);
                next unless defined $vi && defined $vj;
                $compares++;
                if ($vi ne $vj) {
                    $diff_count++;
                    my $gene = $allele_header[$p] // "pos$p";
                    push @diff_names, $gene;
                    push @diff_vals, { gene => $gene, $si => $vi, $sj => $vj };
                }
            }

            my $pct_success = $n_positions ? ($compares / $n_positions) : 0;

            $distance{$si}{$sj} = $distance{$sj}{$si} = $diff_count;
            $compared{$si}{$sj} = $compared{$sj}{$si} = $compares;
            $percent_success{$si}{$sj} = $percent_success{$sj}{$si} = $pct_success;

            my $pairkey = "$si-$sj";
            if (($diff_count <= $opts{report_distance}) ||
                ($pct_success >= $opts{report_pct_success})) {
                $diff_alleles{$pairkey}       = \@diff_names;
                $diff_allele_values{$pairkey} = \@diff_vals;
            }
        }
        $distance{$sample_names[$i]}{$sample_names[$i]}       = 0;
        $percent_success{$sample_names[$i]}{$sample_names[$i]} = 1;
    }

    # ---- simple greedy ordering ----
    my %mean_dist = map {
        my $s = $_;
        my @vals = map { $distance{$s}{$_} } grep { $_ ne $s } @sample_names;
        $s => (@vals ? (sum(@vals) / @vals) : 0);
    } @sample_names;

    my ($start) = sort { $mean_dist{$a} <=> $mean_dist{$b} } keys %mean_dist;
    my @order = ($start);
    my %visited = ($start => 1);
    while (keys %visited < $n_samples) {
        my $last = $order[-1];
        my ($next) = sort {
            ($distance{$last}{$a} // 1e9) <=> ($distance{$last}{$b} // 1e9)
        } grep { !$visited{$_} } @sample_names;
        last unless defined $next;
        push @order, $next;
        $visited{$next} = 1;
    }
    push @order, grep { !$visited{$_} } @sample_names;

    # ---- write TSV outputs ----
    if ($out_prefix) {
        my $dist_file = "$out_prefix.dist.tsv";
        my $succ_file = "$out_prefix.success.tsv";

        open my $DF, '>', $dist_file or warn "Cannot write $dist_file: $!";
        open my $SF, '>', $succ_file or warn "Cannot write $succ_file: $!";

        print $DF join("\t", "Sample", @order), "\n";
        print $SF join("\t", "Sample", @order), "\n";

        for my $s1 (@order) {
            print $DF $s1;
            print $SF $s1;
            for my $s2 (@order) {
                my $d = defined $distance{$s1}{$s2} ? $distance{$s1}{$s2} : "";
                my $p = defined $percent_success{$s1}{$s2}
                    ? sprintf("%.3f", $percent_success{$s1}{$s2})
                    : "";
                print $DF "\t$d";
                print $SF "\t$p";
            }
            print $DF "\n";
            print $SF "\n";
        }

        close $DF;
        close $SF;

      #  print STDERR "Distance matrix written to $dist_file\n";
      #  print STDERR "Percent-success matrix written to $succ_file\n";
    }

    return {
        sample_names       => \@sample_names,
        order              => \@order,
        distance_matrix    => \%distance,
        percent_success    => \%percent_success,
        diff_alleles       => \%diff_alleles,
        diff_allele_values => \%diff_allele_values,
        n_positions        => $n_positions,
        allele_header      => \@allele_header,
    };
}
