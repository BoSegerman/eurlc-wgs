   return check_conda_tool("checkm");

}

$runstep{$runstep_name}{preprocessing} = \&preprocess_checkm;

sub preprocess_checkm {

    my $runstep_name = "checkm";       
    
    my $command_template    = $runstep{$runstep_name}{cmd_template};    
    my $resultfile_template = $runstep{$runstep_name}{resultfile}; 
    my $outdir_template = $runstep{$runstep_name}{output_dir};
    my $command = "";
    
    log_message("INFO: Preparing to run step $runstep_name on All samples ");
          
    # runstep specific replacements

 my $species_dir_count = $rundata{batches}{subdirs_count};

    # ------------------------------------------------------------
    # LOOP OVER SPECIES DIRECTORIES
    # ------------------------------------------------------------
    for my $j (0 .. $species_dir_count - 1) {
    

     my $dirname = $rundata{batches}{subdirs}[$j];
     my $species = $rundata{batches}{$dirname}{species};
     my $samples = $rundata{batches}{$dirname}{count};
     
     log_message("INFO: Checking species directory [$dirname] ($species)");
     
     # Collect list of sample names in this species dir
     my @listof_samples = ();
       
     for my $jj (0 .. $samples - 1) {
         my $fasta_path = $rundata{batches}{$dirname}{fasta}[$jj];
         my $filename = basename($fasta_path);
         (my $samplename = $filename) =~ s/\.fasta$//;
         push @listof_samples, $samplename;
     }
 

        
      # info from resultfile, if it exists
     my $resultfile = $resultfile_template;
     $resultfile =~ s/__SUBDIR__/$dirname/g;      
     $resultfile = fill_placeholders($resultfile, "", $runstep_name); 

    my $all_exists = 0;

    if (-f $resultfile) {
        my $result_ref = parse_checkm($resultfile);

        if (defined $result_ref->{bin_count} && $result_ref->{bin_count} > 0) {
            my %resultexists = map { $_->{bin_id} => 1 } @{ $result_ref->{checkm_results} // [] };
            my $missing = 0;

            foreach my $sample_base (@listof_samples) {
                if (!exists $resultexists{$sample_base}) {
                    $missing = 1;
                    last;
                }
            }

            $all_exists = !$missing;
        }
    }
            
  
     if( ! (-f  $resultfile) || !$all_exists){
     
       my $command_part  = $command_template;
       $command_part =~ s/__INPUTDIR__/__DIR-ASSEMBLIES__\/by_species\/$dirname/g;     
       $command_part =~ s/__OUTDIR__/__DIR-QC3__\/CheckM\/$dirname/g;    
       if($command eq ""){
         $command = $command_part;
       }
       else{
         $command = $command . "; " . $command_part;   
       }
       my $outdir = $outdir_template;
       $outdir =~ s/__SUBDIR__/$dirname/g; 
       $outdir = fill_placeholders($outdir, "", $runstep_name);       

       #create output dir
       ensure_dir($outdir);
    }else{
       log_message("NOTICE: Resultfile already exists for CheckM - $species, skipping...");
    }

   
  }  # end for hitcount (count of species after sorting)

     
   #format command
   $command  = fill_placeholders($command, "", $runstep_name);
    
   if($command eq ""){
     postprocess_checkm();
   }
   
   return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_checkm;

sub postprocess_checkm {
  

    my $runstep_name = "checkm";
    
    my $resultfile_template = $runstep{$runstep_name}{resultfile}; 
    
   my $hitcount = $rundata{sort_assemblies}{subdirs_count};

  my @listof_samples = ();
   
   for(my $j=0;$j<$hitcount; $j++){
     my $dirname = $rundata{batches}{subdirs}[$j];
     my $species = $rundata{batches}{$dirname}{species};
     my $samples = $rundata{batches}{$dirname}{count};
     for( my $jj=0;$jj<$samples;$jj++){
         my $fasta_path = $rundata{batches}{$dirname}{fasta}[$jj];
         my $filename = basename($samples);
         my $samplename = $filename;
         $samplename =~ s/.fasta//g; 
         push @listof_samples, $samplename;
     }
 

     my $resultfile = $resultfile_template;
     $resultfile =~ s/__SUBDIR__/$dirname/g;      
     $resultfile = fill_placeholders($resultfile, "", $runstep_name); 

     my $result_ref = parse_checkm($resultfile);
     $rundata{batches}{$dirname}{checkm} = $result_ref; 
     my $hitcount_resultfile = $result_ref->{bin_count};
   
   log_message("NOTICE: CheckM results for species: $species", "green");
   for(my $jj=0;$jj<$hitcount_resultfile; $jj++){
   log_message("NOTICE: Sample: $result_ref->{checkm_results}[$jj]->{bin_id}  (lineage: $result_ref->{checkm_results}[$jj]->{marker_lineage}) [Completeness: $result_ref->{checkm_results}[$jj]->{completeness} Contamination:  $result_ref->{checkm_results}[$jj]->{contamination}]", "green");
  }
   
  }  # end for hitcount (count of species after sorting)

  
    return 1; # success
}

# PARSER---------------------------------

sub parse_checkm {
    my ($resultfile) = @_;

    my %checkm_data;       # final hash structure
    my @checkm_results;    # list of result rows


    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open CheckM result file for resultfile [$resultfile]");
        return {};
    }

    my $header;
    my @columns;
    my $in_table = 0;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;           # skip empty lines
        next if $line =~ /^\[/;             # skip log lines starting with [

        # Detect the start of the CheckM result table
        if (!$in_table && $line =~ /^Bin Id\t/) {
            $in_table = 1;
            $header = $line;
            @columns = split /\t/, $header;
            next;
        }

        # Skip everything before the table
        next unless $in_table;

        # Stop parsing if new INFO lines appear after the table
        last if $line =~ /^\[/;

        my @fields = split /\t/, $line;
        next unless @fields == @columns;    # skip malformed lines

        my %entry;
        @entry{@columns} = @fields;

        # Normalize keys (lowercase, underscores)
        for my $key (keys %entry) {
            my $normkey = lc($key);
            $normkey =~ s/[^a-z0-9]+/_/g;
            $entry{$normkey} = delete $entry{$key};
        }

        push @checkm_results, \%entry;
    }

    close $fh;

    if (!@checkm_results) {
        log_message("WARNING: no CheckM result table found for resultfile [$resultfile]");
    }

    $checkm_data{checkm_results} = \@checkm_results;
    $checkm_data{bin_count}      = scalar @checkm_results;

    return \%checkm_data;
}


