## runstep resfinder_fasta

$runstep_name = "resfinder_fasta";

$runstep{$runstep_name} = {
      message    => "Running Resfinder (on contigs)...",
      long_name  => "Resfinder (on contigs)",
      output_dir => "__DIR-AMR__/resfinder_contigs/__BASE__",
      resultfile => "__DIR-AMR__/resfinder_contigs/__BASE__/ResFinder_results_tab.txt",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------

