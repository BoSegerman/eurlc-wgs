## runstep check_for_no_downsampling 

$runstep_name = "check_for_no_downsampling";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Preparing data (without downsampling)...",
      long_name  => "Preparing data (without downsampling)",
      output_dir => "__DIR-TRIMMED-DOWNSAMPLED__",
      resultfile => "",
      resultfiles_status => "NA",

      # Exact complement of downsampling_bbmap's applies_if.
      requires   => [ 'trimmed_fastq' ],
      produces   => [ 'trimmed_downsampled_fastq' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return 1 unless $R_cfg->{bbmap}{enabled};
          ensure_targetbases_computed($i);
          my $tb = $R_samples->[$i]{targetbases};
          return 1 unless defined $tb && $tb =~ /^\d+(?:\.\d+)?$/ && $tb > 0;
          return 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    ln -s '__R1T__' '__R1TD__' 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    ln -s '__R2T__' '__R2TD__' 
       __HIDE-OUTPUT__
CMD
$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    ln -s '__SET__' '__SETD__' 
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_nodownsampling;

sub test_nodownsampling {

   return 2;  # no testing needed

}
  
# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_nodownsampling;

sub preprocess_nodownsampling {

    my ($samplenr) = @_;

    my $runstep_name = "check_for_no_downsampling";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     

    if($R_samples->[$samplenr]{downsampled}){
      return "";
    }
     if($sample_type eq "FASTA"){
      return "";           
    }


     
    if($sample_type eq "PE" && -f fill_placeholders("__R1TD__", $samplenr) && -f fill_placeholders("__R2TD__", $samplenr)){
      return "";
    }
    if($sample_type eq "SE" && -f fill_placeholders("__SETD__", $samplenr)){
      return "";
    }
  
        
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
 
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);           

    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_nodownsampling;

sub postprocess_nodownsampling {
    my ($samplenr) = @_;

    my $runstep_name = "check_for_no_downsampling";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
      
    log_message("NOTICE: No downsampling was performed on sample $sample_name","green");
    log_message("NOTICE: Trimmed reads were linked into the downsampled paths","green");
    
    # Mark as downsampled=1 so downstream data_key checks that rely on
    # runtime state (rather than file existence) see this step as complete.
    # downsampling_bbmap's postprocess sets this too; both paths need it.
    $R_samples->[$samplenr]{downsampled} = 1;
    
    return 1; # success
}

