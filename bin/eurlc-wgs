$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Determining fastq statistics...",
      long_name  => "Determining fastq statistics",
      output_dir => "__DIR-QC2__/fastq_stats",
      resultfile => "__DIR-QC2__/fastq_stats/__BASE__.json",
      resultfiles_status => "NA",

      # Was an unconditional "REQUIRED STEP" in the old @runorder_loop1 --
      # no enabled flag, always applies. FASTA naturally excluded since
      # trimmed_downsampled_fastq is never satisfied for it.
      # species_determined: coverage uses the species' genome size
