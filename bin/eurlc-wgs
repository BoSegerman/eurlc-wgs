sub get_detailed_report_def {

    my $def = {


    md5_rawdata => {
        title    => "MD5 sums on raw data",
        category => "qscore",

        fields => [
            { label => "R1 file",        path => [ "R1" ], hide_if_missing => 1 },
            { label => "R2 file",        path => [ "R2" ], hide_if_missing => 1 },
            { label => "SE file",        path => [ "SE" ], hide_if_missing => 1 },
            { label => "FASTA file",        path => [ "FASTA" ], hide_if_missing => 1 },
 
        ],
        # links: migrated to register_raw_output() in result_parsing

    },

    fastq_prescan => {
        title    => "FASTQ prescan",
        category => "qscore",

        fields => [
            { label => "Platform guess",        path => [ "total", "platform_guess" ] },
            { label => "Instrument",            path => [ "total", "instrument" ] },
