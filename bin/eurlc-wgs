## runstep fastmlst

$runstep_name = "fastmlst";

$runstep{$runstep_name} = {
      requires   => ['main_assembly_present'],
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => 1, ram_gb => 1 },

      message        => "Running fastmlst...",
      long_name      => "fastmlst",
      output_dir     => "__DIR-TYPING__/fastmlst/__BASE__",
      resultfile     => "__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.results",
      alt_resultfile => "__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.__ASSEMBLER__.results",
      resultfiles_status => "NA",

      group      => 'mlst_determination',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'fastmlst_assembled' ],
      applies_if => sub { return $R_cfg->{fastmlst}{enabled} ? 1 : 0; },
};


# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{main} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastmlst}->{env} --no-capture-output fastmlst
       __DIR-ASSEMBLIES__/__BASE__.fasta
       -t __THREADS__
       -fo __OUTDIR__/mlst_alleles.__BASE__.fasta
       > __OUTDIR__/__BASE__-fastmlst.results
       __HIDE-STDERR__
CMD

$runstep{$runstep_name}{cmd_template}{alternative} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{fastmlst}->{env} --no-capture-output fastmlst
       __DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta
       -t __THREADS__
       -fo __OUTDIR__/mlst_alleles.__BASE__.__ASSEMBLER__.fasta
       > __OUTDIR__/__BASE__-fastmlst.__ASSEMBLER__.results
       __HIDE-STDERR__
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_fastmlst;

sub test_fastmlst {

   return check_conda_tool("fastmlst");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_fastmlst;

sub preprocess_fastmlst {

    my ($samplenr) = @_;

    my $runstep_name = "fastmlst";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $command                 = $runstep{$runstep_name}{cmd_template}{main};
    my $command_alt             = $runstep{$runstep_name}{cmd_template}{alternative};
    my $resultfile              = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    my $all_resultfiles_present = 1;

    if (! -f $resultfile) {
        $all_resultfiles_present = 0;
    }

    foreach my $ambl (group_members('assembler')) {
        my $alt_resultfile = $alt_resultfile_template;
        $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
        $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr);

        my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta", $samplenr);
        if (-f $test_path) {
            if (! -f $alt_resultfile) {
                $all_resultfiles_present = 0;
            }
        }
    }

    if ($all_resultfiles_present) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_fastmlst($samplenr);
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "Optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    foreach my $ambl (group_members('assembler')) {
        my $add_command = $command_alt;
        my $test_path = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta", $samplenr);

        if (-f $test_path) {
            $add_command =~ s/__ASSEMBLER__/$ambl/g;
            $command = $command . " ; " . $add_command;
        }
    }

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));

    return $command;
}



# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastmlst;

sub postprocess_fastmlst {
    my ($samplenr) = @_;

    my $runstep_name = "fastmlst";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    # Parse main assembly fastmlst result
    my $main_result_ref = parse_fastmlst($resultfile, $samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name}{main} = $main_result_ref;

    # Parse alternative assembly fastmlst results
    foreach my $ambl (group_members('assembler')) {
        my $alt_resultfile = $alt_resultfile_template;
        $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
        $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr);

        if (-f $alt_resultfile) {
            my $alt_result_ref = parse_fastmlst($alt_resultfile, $samplenr);
            $R_samples->[$samplenr]{results}{$runstep_name}{$ambl} = $alt_result_ref;
        }
    }

    # Select best fastmlst result
    my $selected_from = "main";
    my $selected_ref  = $main_result_ref;

    my $st             = $selected_ref->{st} // "n/a";
    my $schema         = $selected_ref->{schema} // "n/a";
    my $clonal_complex = $selected_ref->{clonal_complex} // "n/a";

    if (!defined $st || $st eq "" || $st eq "n/a" || $st eq "-") {
        foreach my $ambl (group_members('assembler', \@ASSEMBLER_TIEBREAK)) {
            next unless exists $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};

            my $alt_ref = $R_samples->[$samplenr]{results}{$runstep_name}{$ambl};
            my $alt_st  = $alt_ref->{st} // "n/a";

            next if !defined $alt_st || $alt_st eq "" || $alt_st eq "n/a" || $alt_st eq "-";

            $selected_from   = $ambl;
            $selected_ref    = $alt_ref;
            $st              = $alt_ref->{st} // "n/a";
            $schema          = $alt_ref->{schema} // "n/a";
            $clonal_complex  = $alt_ref->{clonal_complex} // "n/a";
            last;
        }
    }

    $R_samples->[$samplenr]{results}{$runstep_name}{st}             = $st;
    $R_samples->[$samplenr]{results}{$runstep_name}{schema}         = $schema;
    $R_samples->[$samplenr]{results}{$runstep_name}{clonal_complex} = $clonal_complex;
    $R_samples->[$samplenr]{results}{$runstep_name}{selected_from}  = $selected_from;

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "fastmlst results",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.results",$samplenr, $runstep_name)),
    ); 

    my $spadespath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.spades.results",$samplenr, $runstep_name);
    if(-f $spadespath)
    { 
       register_raw_output($samplenr, $runstep_name, title => "MLST results (spades)", type => "txt", path => path_relative_to_outdir($spadespath));
    }

    my $shovillspath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.shovill.results",$samplenr, $runstep_name);
    if(-f $shovillspath)
    { 
       register_raw_output($samplenr, $runstep_name, title => "MLST results (shovill)", type => "txt", path => path_relative_to_outdir($shovillspath));
    }

    my $skesaspath = fill_placeholders("__DIR-TYPING__/fastmlst/__BASE__/__BASE__-fastmlst.skesa.results",$samplenr, $runstep_name);
    if(-f $skesaspath)
    { 
       register_raw_output($samplenr, $runstep_name, title => "MLST results (skesa)", type => "txt", path => path_relative_to_outdir($skesaspath));
    }
    
    # Update main_results only if empty; otherwise warn on conflict
    my $old_st     = $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST};
    my $old_scheme = $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme};
    my $old_cc     = $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex};

    my $has_old_st = defined $old_st && $old_st ne "" && $old_st ne "-" && $old_st ne "n/a";
    my $has_old_cc = defined $old_cc && $old_cc ne "" && $old_cc ne "-" && $old_cc ne "n/a";
    
    if ($has_old_st && !$has_old_cc ) {
       $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex} = $clonal_complex;
       $R_samples->[$samplenr]{main_results}{typing}{mlst}{mlst_method} .= "| fastmlst (CC)";
    }
    elsif (!$has_old_st) {
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{ST}             = $st;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{scheme}         = $schema;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{clonal_complex} = $clonal_complex;
        $R_samples->[$samplenr]{main_results}{typing}{mlst}{mlst_method} = "fastmlst";
    }
    else {
        my $conflict = 0;
        $conflict = 1 if $old_st ne $st;

        if ($conflict) {
            push @{ $R_samples->[$samplenr]{warnings} },
                "FastMLST result [$schema / $st / $clonal_complex] from $selected_from conflicts with existing main result [$old_scheme / $old_st / $old_cc]";
        }
    }

    my $color = "green";
    $color = "yellow" if !defined $st || $st eq "" || $st eq "n/a" || $st eq "-";

#    log_message("NOTICE: FastMLST database age: $fastmlst_db_age days", "green");
    if ($selected_from ne "main") {
        log_message("NOTICE: Sample $sample_name: FastMLST source assembly: $selected_from", $color);
    }
    log_message("NOTICE: Sample $sample_name: Schema: $schema", $color);
    log_message("NOTICE: Sample $sample_name: ST Type: $st", $color);
    log_message("NOTICE: Sample $sample_name: Clonal complex: $clonal_complex", $color);

    return 1;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep select_main_mlst
##
## Selects the official ST (and clonal complex, where available) between
## the mlst_determination group's members. general.mlst_determination
## names the preferred one; if it didn't produce a usable result, falls
## back through the rest in priority order (§6, same shape of problem as
## select_main_assembly, but "pick by priority order" rather than "pick by
## best metric" -- see priority_select_field above). ST and clonal complex
## are selected independently, since not every member produces a clonal
## complex (today only fastmlst does) -- the CC winner can legitimately be
## a different group member than the ST winner. Warns if any non-winning
## member's value disagrees with the winner's.

# Static fallback order for the mlst_determination group (any member not
# explicitly preferred by general.mlst_determination), extensible the same
# way @ASSEMBLER_TIEBREAK is -- add a name here the day a third
# implementation exists.
my @MLST_TIEBREAK = qw(fastmlst mlst);

# general.mlst_determination names the preferred member; whatever it says
# (if it's a real group member) goes first, the rest follow the static
# tiebreak order above.
sub mlst_priority_list {
    my @members = group_members('mlst_determination', \@MLST_TIEBREAK);
    my $preferred = lc($R_cfg->{general}{mlst_determination} // '');
    if ( grep { $_ eq $preferred } @members ) {
        @members = ( $preferred, grep { $_ ne $preferred } @members );
    }
    return @members;
}

$runstep_name = "select_main_mlst";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 0 },

      message    => "Selecting main MLST result...",
      long_name  => "Selecting main MLST result",

      # Always applies -- gracefully warns rather than failing if nothing
      # in the group actually produced a usable result. requires is empty,
      # relying on list position (runs after mlst/fastmlst), the same way
      # select_main_assembly relies on running after all four assemblers.
      requires   => ['any_mlst_done'],,
      produces   => [ 'main_mlst_present' ],
      applies_if => sub { return 1; },
};

$runstep{$runstep_name}{test} = sub { return 2; };  # no external tool

$runstep{$runstep_name}{preprocessing} = \&preprocess_select_main_mlst;

sub preprocess_select_main_mlst {
    my ($samplenr) = @_;

    my $sample_name = $R_samples->[$samplenr]{name};
    my $runstep_name = "select_main_mlst";

    my %candidates;
    for my $name ( group_members('mlst_determination') ) {
        my $c = $R_samples->[$samplenr]{results}{$name};
        next unless $c && ref($c) eq 'HASH';
        $candidates{$name} = $c;
    }

    my @priority = mlst_priority_list();
    my @reasons;

    my ($st_method, $st) = priority_select_field( \%candidates, \@priority, 'st' );
    if ( defined $st_method ) {
        push @reasons, ( $st_method eq $priority[0] )
            ? "ST selected from preferred method '$st_method' (general.mlst_determination)"
            : "Preferred method '$priority[0]' had no usable ST; fell back to '$st_method' (priority order)";
    }
    else {
        push @reasons, "No group member produced a usable ST";
        log_message("WARNING: No MLST result available for sample $sample_name", "red");
    }
    push @reasons, warn_on_field_mismatch( \%candidates, \@priority, 'st', $st_method, $st, "Sample $sample_name: ST" );

    # Clonal complex selected independently -- a different group member can
    # legitimately win this than won ST, since not every member produces it.
    my ($cc_method, $cc) = priority_select_field( \%candidates, \@priority, 'clonal_complex' );
    if ( defined $cc_method ) {
        push @reasons, ( $cc_method eq $st_method )
            ? "Clonal complex selected from the same method as ST ('$cc_method')"
            : "Clonal complex selected from '$cc_method' ('$st_method' does not produce clonal complex data)";
    }
    push @reasons, warn_on_field_mismatch( \%candidates, \@priority, 'clonal_complex', $cc_method, $cc, "Sample $sample_name: Clonal complex" );

    $R_samples->[$samplenr]{main_results}{mlst}{st}        = $st        // "n/a";
    $R_samples->[$samplenr]{main_results}{mlst}{method}    = $st_method // "n/a";
    $R_samples->[$samplenr]{main_results}{mlst}{schema}    = defined $st_method ? ( $candidates{$st_method}{schema} // "n/a" ) : "n/a";
    $R_samples->[$samplenr]{main_results}{mlst}{cc}        = $cc        // "n/a";
    $R_samples->[$samplenr]{main_results}{mlst}{cc_method} = $cc_method // "n/a";

    # Stored here, not just in main_results, so write_main_mlst_result (run
    # in a forked child -- see %INTERNAL_SUB) can read the full decision,
    # including reasons, without needing to write anything back to
    # $R_samples itself. Safe: this is set here, in the parent, before the
    # fork that runs the command this function is about to return happens.
    $R_samples->[$samplenr]{results}{$runstep_name} = {
        st => $st // "n/a", method => $st_method // "n/a", schema => $R_samples->[$samplenr]{main_results}{mlst}{schema},
        cc => $cc // "n/a", cc_method => $cc_method // "n/a",
        reasons => \@reasons,
    };

    ensure_dir(getdir("out,results,typing"));

    return "SUB\twrite_main_mlst_result\t$samplenr";
}

$runstep{$runstep_name}{result_parsing} = sub {
    my ($samplenr) = @_;
    my $sample_name = $R_samples->[$samplenr]{name};
    my $json_path = fill_placeholders("__DIR-TYPING__/__BASE__.main_mlst_result.json", $samplenr, "select_main_mlst");
    unless (-f $json_path) {
        log_message("WARNING: select_main_mlst result file not found for sample $sample_name", "red");
        return 0;
    }
    return 1;
};

# Runs inside run_step()'s forked child (via %INTERNAL_SUB) -- only reads
# $R_samples->[$samplenr]{results}{select_main_mlst} (set by preprocessing,
# in the parent, before the fork) and writes files; never writes back to
# $R_samples itself. See the %INTERNAL_SUB comment for why that split
# matters.
sub write_main_mlst_result {
    my ($samplenr) = @_;

    my $decision = $R_samples->[$samplenr]{results}{select_main_mlst};
    return 1 unless $decision && ref($decision) eq 'HASH';

    my $sample_name = $R_samples->[$samplenr]{name};
    my $json_path = fill_placeholders("__DIR-TYPING__/__BASE__.main_mlst_result.json", $samplenr, "select_main_mlst");
    my $txt_path  = fill_placeholders("__DIR-TYPING__/__BASE__.main_mlst_result.txt",  $samplenr, "select_main_mlst");

    write_json_file($decision, $json_path);

    open(my $fh, '>', $txt_path) or do {
        log_message("WARNING: Could not write [$txt_path]: $!", "red");
        return 1;
    };
    print $fh "Main MLST result -- sample $sample_name\n";
    print $fh "ST:             $decision->{st} (via $decision->{method})\n";
    print $fh "Schema:         $decision->{schema}\n";
    print $fh "Clonal complex: $decision->{cc} (via $decision->{cc_method})\n";
    print $fh "\nReasons:\n";
    for my $reason ( @{ $decision->{reasons} // [] } ) {
        print $fh "  - $reason\n";
    }
    close($fh);

    return 0;
}


# PARSER---------------------------------

sub parse_fastmlst {
    my ($resultfile, $samplenr) = @_;

    my %fastmlst_data;
    my $sample_name = $R_samples->[$samplenr]{name};

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: could not open fastMLST result file for sample $sample_name [$resultfile]");
        return {};
    };

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        # Example:
        # PT38-3.fasta,cjejuni,257,aspA(9),glnA(2),gltA(4),glyA(62),pgm(4),tkt(5),uncA(6),clonal_complex(ST-257 complex)

        my @cols = split /,/, $line;

        # Need at least filename, schema, ST
        next unless @cols >= 3;

        $fastmlst_data{schema} = $cols[1] // "n/a";
        $fastmlst_data{st}     = $cols[2] // "n/a";

        my @allele_names;
        $fastmlst_data{clonal_complex} = "n/a";

        for my $i (3 .. $#cols) {
            my $field = $cols[$i];

            if ($field =~ /^([A-Za-z0-9_]+)\((\d+)\)$/) {
                my ($gene, $id) = ($1, $2);
                $fastmlst_data{"allele_$gene"} = $id;
                push @allele_names, $gene;
            }
            elsif ($field =~ /^clonal_complex\(([^)]+)\)$/) {
                $fastmlst_data{clonal_complex} = $1;
            }
        }

        $fastmlst_data{allele_names} = \@allele_names;

        last;   # one result line per file expected
    }

    close $fh;
    return \%fastmlst_data;
}

######
## example output
# {
#  schema => "cjejuni",
#  st => 257,
#  allele_names => [aspA,glnA,gltA,glyA,pgm,tkt,uncA],
#  aspA => 9,
#  glnA => 2,
#  gltA => 4,
#  glyA => 62,
#  pgm  => 4,
#  tkt  => 5,
#  uncA => 6,
#  clonal_complex => "ST-257 complex"
#}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep amrfinderplus 

$runstep_name = "amrfinderplus";

$runstep{$runstep_name} = {
      requires   => ['main_assembly_present'],
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 2 },

      message    => "Running Amrfinderplus...",
      long_name  => "Amrfinderplus",
      output_dir => "__DIR-AMR__/amrfinderplus",
      resultfile => "__DIR-AMR__/amrfinderplus/__BASE__.txt",
      resultfiles_status => "NA",

      # Tagged 'amr' alongside resfinder_fasta/resfinder_fastq -- no
      # aggregating select_main_amr_results exists yet (each AMR tool's
      # results are shown side by side, deliberately, until there's
      # confidence -- ideally with AMR domain expertise -- in how to
      # reconcile them into one official answer). The group tag is laid
      # now so that step can slot in later without revisiting these three.
      group      => 'amr',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'amrfinderplus_done' ],
      applies_if => sub { return $R_cfg->{amrfinderplus}{enabled} ? 1 : 0; },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{amrfinderplus}->{env} --no-capture-output amrfinder 
       -n __DIR-ASSEMBLIES__/__BASE__.fasta 
       --threads __THREADS__ 
       -o __OUTDIR__/__BASE__.txt 
       $R_cfg->{amrfinderplus}->{arguments} 
       __AMRFINDER_ORGANISM_ARG__
       __HIDE-OUTPUT__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_amrfinderplus;

sub test_amrfinderplus {

    return check_conda_tool("amrfinderplus");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_amrfinderplus;

sub preprocess_amrfinderplus {

    my ($samplenr) = @_;

    my $runstep_name = "amrfinderplus";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template};   
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   



    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
 
    if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_amrfinderplus($samplenr);
        return "";
      }  
 
    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta"); 
               
    # runstep specific replacements
    if( $command =~ /__AMRFINDER_ORGANISM_ARG__/ ) {
        my $species      = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";
        my $organism     = resolve_amrfinderplus_organism($species);
        my $organism_arg = $organism ne "" ? "--organism $organism" : "";
        _fill_placeholders__safe_replace(\$command, "__AMRFINDER_ORGANISM_ARG__", $organism_arg );
    }
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_amrfinderplus;

sub postprocess_amrfinderplus {
    my ($samplenr) = @_;

    my $runstep_name = "amrfinderplus";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
    
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
        
    my $result_ref = parse_amrfinderplus($resultfile,$samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref; 
    my $hitcount = $result_ref->{hit_count} // 0;
   
   for(my $i=0;$i<$hitcount; $i++){
     my $amrhits_symbol = $result_ref->{amr_hits}[$i]->{element_symbol} // "n/a";
     my $amrhits_name = $result_ref->{amr_hits}[$i]->{element_name} // "n/a";
     log_message("NOTICE: Sample $sample_name: AMR-hit:  $amrhits_symbol ($amrhits_name)", "green");
  }
  
      # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "AMRfinderplus results",
        type  => "tsv",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-AMR__/amrfinderplus/__BASE__.txt",$samplenr, $runstep_name)),
    ); 



    return 1; # success
}

# PARSER---------------------------------

sub parse_amrfinderplus {
    my ($resultfile, $samplenr) = @_;

    my %amr_data;          # final hash structure
    my @amr_hits;          # list of AMR hits (each a hashref)
    my $sample_name = $R_samples->[$samplenr]{name};

    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open AMRFinderPlus result file for sample $sample_name [$resultfile]");
        return {};
    }

    # Read header line
    my $header = <$fh>;
    unless ($header) {
        close $fh;
        log_message("WARNING: empty AMRFinderPlus result file for sample $sample_name [$resultfile]");
        return {};
    }

    chomp $header;
    my @columns = split /\t/, $header;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my @fields = split /\t/, $line;

        # Map each column to a hash key
        my %entry;
        @entry{@columns} = @fields;

        # Optionally normalize keys
        for my $key (keys %entry) {
            my $normkey = lc($key);
            $normkey =~ s/[^a-z0-9]+/_/g;
            $entry{$normkey} = delete $entry{$key};
        }

        push @amr_hits, \%entry;
    }

    close $fh;

    # Attach list of hits to top-level hash
    $amr_data{amr_hits} = \@amr_hits;
    $amr_data{hit_count} = scalar @amr_hits;

    return \%amr_data;
}

