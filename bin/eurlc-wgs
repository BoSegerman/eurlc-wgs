# ---------------------------------------------------------------------------
# _efsa_wire_filter_to_schema(filter_path => ..., schema_hints => [...], schemas_root => ...)
#
# Looks for an installed chewieNS schema that matches one of the hint names.
# If found, updates its schema.ini with the given filter value.
# filter_path may be a relative path (e.g. "filters/cgmlst_efsa.txt") — it is
# written as-is so the schema stays relocatable.  discover_installed_schemas()
# resolves relative paths against the schema directory at runtime.
# Returns the schema name if wired, undef otherwise.
# ---------------------------------------------------------------------------
sub _efsa_wire_filter_to_schema {
    my (%args) = @_;
    my $filter_path  = $args{filter_path}  // return undef;
    my $schema_hints = $args{schema_hints} // [];
    my $schemas_root = $args{schemas_root} // return undef;

    return undef unless -d $schemas_root;

    for my $hint (@$schema_hints) {
        my $schema_dir = "$schemas_root/$hint";
        next unless -d $schema_dir;

        my $ini_path = "$schema_dir/schema.ini";
        unless (-f $ini_path) {
            log_message("INFO: Found schema dir [$hint] but no schema.ini — skipping filter wire");
            next;
        }

        # Read existing schema.ini, update filter line
        open(my $fh_in, '<:utf8', $ini_path)
            or do { log_message("WARNING: Cannot read $ini_path: $!"); next; };
        my @lines = <$fh_in>;
        close $fh_in;

        my $found_filter = 0;
        for my $line (@lines) {
            if ($line =~ s{^(\s*filter\s*=\s*).*}{$1$filter_path}) {
                $found_filter = 1;
            }
        }
        unless ($found_filter) {
            # No existing filter line in [schema] section — append after [schema] header
            my @new_lines;
            my $in_schema = 0;
            my $added = 0;
            for my $line (@lines) {
                push @new_lines, $line;
                if (!$added && $line =~ /^\[schema\]/) {
                    $in_schema = 1;
                }
                if ($in_schema && !$added && $line =~ /^(name|label|description|version|species|source)\s*=/) {
                    # keep going, add after last header-like field we see
                }
                if ($in_schema && !$added && ($line =~ /^\[/ && $line !~ /^\[schema\]/ || eof)) {
                    # next section or end of file: inject before this line
                    pop @new_lines;
                    push @new_lines, "filter      = $filter_path\n";
                    push @new_lines, $line;
                    $added = 1;
                }
            }
            push @new_lines, "filter      = $filter_path\n" unless $added;
            @lines = @new_lines;
        }

        open(my $fh_out, '>:utf8', $ini_path)
            or do { log_message("WARNING: Cannot update $ini_path: $!"); next; };
        print $fh_out @lines;
        close $fh_out;

        return $hint;   # success
    }

    return undef;   # no matching schema found
}

sub md5_file {
    my ($path) = @_;
    return "ERROR:not_a_file"  unless defined $path && -f $path;
    return "ERROR:empty_file"  unless -s $path;
    open my $fh, '<:raw', $path or return "ERROR:cannot_open";
    return Digest::MD5->new->addfile($fh)->hexdigest;
}

sub ensure_dir {
    my ($path) = @_;


    if (-d $path) {
        return $path;   # success
    }
    
    my $root_dir = _get_path_entry('DIR', "out");
    my $db_root_dir = _get_path_entry('DIR', "db");


    unless (defined $path) {
        log_message("WARNING: Cannot resolve path in ensure_dir","red");
        return "";
    }
    if ( $path eq "") {
       log_message("WARNING: Empty path [$path] in ensure_dir","red");
    }
    
    # Security check — ensure abs_path starts with abs_root
    unless (index($path, $root_dir) == 0 || index($path, $db_root_dir) == 0) {
        log_message("WARNING: Attempt to create directory outside output root or db-root [$path]  — denied","red");
        return "";
    }

    # Create directory if missing
    unless (-d $path) {
        execute_and_log("mkdir -p '$path'");
    }

    if (! (-d $path) ) {
        log_message("WARNING: Could not create directory [$path]","red");
        return "";     
    }
    return $path;   # success
}
##########################################################################################################

sub check_crc32_hash_collisions {
    my (%args) = @_;

    my $crc32_file  = $args{crc32_file};
    my $sha256_file = $args{sha256_file};
    my $out_file    = $args{out_file};   # optional

    my $summary = {
        checked         => 0,
        ok              => 0,
        collision_count => 0,
        collisions      => [],
        rows_checked    => 0,
        report_file     => "",
        error           => "",
    };

    if (!defined $crc32_file || !-e $crc32_file) {
        $summary->{error} = "CRC32 allele table missing: " . ($crc32_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    if (!defined $sha256_file || !-e $sha256_file) {
        $summary->{error} = "SHA256 allele table missing: " . ($sha256_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    open my $crc_fh, '<', $crc32_file or do {
        $summary->{error} = "Could not open CRC32 allele table [$crc32_file]: $!";
        log_message("WARNING: $summary->{error}");
        return $summary;
    };

    open my $sha_fh, '<', $sha256_file or do {
        $summary->{error} = "Could not open SHA256 allele table [$sha256_file]: $!";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        return $summary;
    };

    my $crc_header = <$crc_fh>;
    my $sha_header = <$sha_fh>;

    if (!defined $crc_header || !defined $sha_header) {
        $summary->{error} = "Empty CRC32 or SHA256 allele table";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    chomp $crc_header;
    chomp $sha_header;

    my @crc_cols = split /\t/, $crc_header, -1;
    my @sha_cols = split /\t/, $sha_header, -1;

    if (@crc_cols != @sha_cols) {
        $summary->{error} = "CRC32/SHA256 allele tables have different number of columns";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    for my $i (0 .. $#crc_cols) {
        if ($crc_cols[$i] ne $sha_cols[$i]) {
            $summary->{error} =
                "CRC32/SHA256 headers differ at column $i [$crc_cols[$i]] vs [$sha_cols[$i]]";
            log_message("WARNING: $summary->{error}");
            close $crc_fh;
            close $sha_fh;
            return $summary;
        }
    }

    my %seen;
    my @collisions;
    my $rows = 0;

    while (1) {
        my $crc_line = <$crc_fh>;
        my $sha_line = <$sha_fh>;

        last if !defined $crc_line && !defined $sha_line;

        if (!defined $crc_line || !defined $sha_line) {
            $summary->{error} = "CRC32/SHA256 allele tables have different number of rows";
            log_message("WARNING: $summary->{error}");
            last;
        }

        chomp $crc_line;
        chomp $sha_line;

        next if $crc_line =~ /^\s*$/ && $sha_line =~ /^\s*$/;

        my @crc = split /\t/, $crc_line, -1;
        my @sha = split /\t/, $sha_line, -1;

        my $sample_crc = $crc[0] // "";
        my $sample_sha = $sha[0] // "";

        if ($sample_crc ne $sample_sha) {
            log_message("WARNING: CRC32/SHA256 sample mismatch [$sample_crc] vs [$sample_sha]");
            next;
        }

        $rows++;

        for my $i (1 .. $#crc_cols) {
            my $locus = $crc_cols[$i];

            my $crc_val = $crc[$i] // "";
            my $sha_val = $sha[$i] // "";

            next if $crc_val eq "" || $crc_val eq "-";
            next if $sha_val eq "" || $sha_val eq "-";

            $seen{$locus}{$crc_val}{$sha_val}{$sample_crc} = 1;
        }
    }

    close $crc_fh;
    close $sha_fh;

    foreach my $locus (sort keys %seen) {
        foreach my $crc_val (sort keys %{ $seen{$locus} }) {

            my @sha_values = sort keys %{ $seen{$locus}{$crc_val} };

            next if @sha_values <= 1;

            my @samples;
            foreach my $sha (@sha_values) {
                push @samples, sort keys %{ $seen{$locus}{$crc_val}{$sha} };
            }

            push @collisions, {
                locus   => $locus,
                crc32   => $crc_val,
                sha256s => \@sha_values,
                samples => \@samples,
            };
        }
    }

    $summary->{checked}         = 1;
    $summary->{ok}              = @collisions ? 0 : 1;
    $summary->{collision_count} = scalar(@collisions);
    $summary->{collisions}      = \@collisions;
    $summary->{rows_checked}    = $rows;

    if (defined $out_file && $out_file ne "") {

        open my $out, '>', $out_file or do {
            $summary->{error} = "Could not write CRC32 collision report [$out_file]: $!";
            log_message("WARNING: $summary->{error}");
            return $summary;
        };

        print $out "# CRC32 collision check\n";
        print $out "# CRC32 file: $crc32_file\n";
        print $out "# SHA256 file: $sha256_file\n";
        print $out "# Rows checked: $rows\n";
        print $out "# Collision count: " . scalar(@collisions) . "\n";

        if (@collisions) {
            print $out "# Result: possible CRC32 collisions detected\n";
        }
        else {
            print $out "# Result: no CRC32 collisions detected\n";
        }

        print $out join("\t", qw(locus crc32 sha256_count sha256_values samples)) . "\n";

        foreach my $c (@collisions) {
            print $out join(
                "\t",
                $c->{locus},
                $c->{crc32},
                scalar(@{ $c->{sha256s} || [] }),
                join(",", @{ $c->{sha256s} || [] }),
                join(",", @{ $c->{samples} || [] }),
            ) . "\n";
        }

        close $out;

        $summary->{report_file} = path_relative_to_outdir($out_file);
    }

    if (@collisions) {
        log_message("WARNING: Possible CRC32 hash collisions detected: " . scalar(@collisions));
    }
    else {
        log_message("INFO: No CRC32 hash collisions detected in [$rows] samples", "green");
    }

    return $summary;
}

######################################################################################

sub ensure_dir_not_exists {
    my (%opt) = @_;

    my $dir   = $opt{dir}   or graceful_die("ensure_dir_not_exists: missing dir");
    my $mode  = $opt{mode}  // 'remove';   # remove | rename | fail
    my $quiet = $opt{quiet} // 0;

    return 1 unless -e $dir;   # nothing to do

    graceful_die("ensure_dir_not_exists: [$dir] exists but is not a directory")
        if -e $dir && !-d $dir;

    if ($mode eq 'fail') {
        graceful_die("Output directory [$dir] already exists");
    }

    if ($mode eq 'remove') {
        remove_tree($dir, { error => \my $err });
        if (@$err) {
            graceful_die("Failed removing directory [$dir]: " .
                join(", ", map { %$_ } @$err));
        }
        log_message("INFO: Removed existing directory [$dir]\n") unless $quiet;
        return 1;
    }

    if ($mode eq 'rename') {
      
        my $new = "$dir.old." . time();
        rename($dir, $new)
            or graceful_die("Failed renaming [$dir] -> [$new]: $!");
        log_message("Renamed existing directory [$dir] -> [$new]\n") unless $quiet;
        return 1;
    }

    log_message( "WARNING: ensure_dir_not_exists: unknown mode [$mode]\n");
}

###################################################################################################
###################################################################################################
##
## SCHEDULER SECTION
##
## The runstep machinery -- data-key registry (%data_key), graph validation,
## the two schedulers (per-sample and batch-level), the control channel
## (pause/resume/terminate via the out/control/ spool directory), signal
## handling, and run_step itself. See the runstep machinery design doc for
## the full design rationale.
##
## Sub-categories:
##   - Startup graph validation
##       validate_runstep_graph, validate_requires_have_data_keys,
##       detect_runstep_dependency_cycles, validate_exactly_one_applicable_producer
##   - Per-sample scheduler
##       test_data_driven_runsteps, run_data_driven_runsteps
##   - Batch scheduler (cross-sample runsteps: sort_assemblies, checkm, chewbbaca, multiqc)
##       test_data_driven_batch_runsteps, run_data_driven_batch_runsteps,
##       any_sample_satisfies, all_samples_satisfy
##   - Control channel
##       process_control_commands, check_control_channel
##   - Dispatch
##       run_step, should_run
##
###################################################################################################
###################################################################################################

###################################################################################################
## Startup graph validation (§9.1) -- structural checks over the runstep
## dependency declarations, run once, after samples are known (needed for
## the per-sample applicable-producer check) but before any real testing
## or processing begins. Aborts the whole run on any problem found, rather
## than letting a misconfigured/newly-added runstep deadlock silently
## partway through a long run. All three checks are based on declared
## requires/produces/applies_if -- none of them call a data_key's actual
## check function, since at this point no sample has produced any real
## data yet (those checks would trivially all be false, telling us nothing
## about whether the GRAPH itself is sound).

# Check A: every key referenced in any runstep's "requires" has a real
# %data_key entry. A missing data_key entry means the runtime
# requires-check can NEVER be satisfied, for any sample, ever --
# a guaranteed-permanent deadlock, not a maybe.
sub validate_requires_have_data_keys {
    my @problems;
    for my $name ( keys %runstep ) {
        my $def = $runstep{$name};
        for my $key ( @{ $def->{requires} // [] } ) {
            next if exists $data_key{$key};
            push @problems, "Runstep [$name] requires data-key [$key], but no such key exists in the data-key registry";
        }
    }
    return @problems;
}

# Check B: no cycles in the dependency graph implied by requires/produces.
# Standard DFS with three-colour marking.
sub detect_runstep_dependency_cycles {
    my %produced_by;
    for my $name ( keys %runstep ) {
        for my $key ( @{ $runstep{$name}{produces} // [] } ) {
            push @{ $produced_by{$key} }, $name;
        }
    }

    my %color;
    my @problems;

    my $visit;
    $visit = sub {
        my ($name, $path) = @_;
        return if ( $color{$name} // 0 ) == 2;

        if ( ( $color{$name} // 0 ) == 1 ) {
            my @cycle = ( @$path, $name );
            push @problems, "Dependency cycle detected: " . join(" -> ", @cycle);
            return;
        }

        $color{$name} = 1;
        for my $key ( @{ $runstep{$name}{requires} // [] } ) {
            for my $producer ( @{ $produced_by{$key} // [] } ) {
                next if $producer eq $name;
                $visit->( $producer, [ @$path, $name ] );
            }
        }
        $color{$name} = 2;
    };

    for my $name ( sort keys %runstep ) { $visit->( $name, [] ); }

    return @problems;
}

# Check C: per sample, for every runstep that itself applies, every key it
# requires must have exactly one declared producer that also applies for
# that same sample.
sub validate_exactly_one_applicable_producer {
    my %produced_by;
    for my $name ( keys %runstep ) {
        next unless defined $name;
        for my $key ( @{ $runstep{$name}{produces} // [] } ) {
            next unless defined $key;
            push @{ $produced_by{$key} }, $name;
        }
    }

    my @problems;

    for my $i ( 0 .. $#$R_samples ) {
        my $sample_name = $R_samples->[$i]{name} // "sample $i";

        for my $name ( keys %runstep ) {
            next unless defined $name;
            my $def = $runstep{$name};
            next unless @{ $def->{requires} // [] };

            my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
            next unless $applies;

            for my $key ( @{ $def->{requires} } ) {
                my @producers = grep { defined $_ } @{ $produced_by{$key} // [] };

                # Skip check for keys where every producer belongs to the
                # same named group -- these are deliberately mutually
                # exclusive pairs (e.g. downsampling_bbmap /
                # check_for_no_downsampling, fastp_rawdata /
                # check_for_no_trimming, checkm / checkm_per_sample).
                # At startup we cannot know which branch applies_if will
                # choose at runtime (it depends on config + data), so
                # false "both applicable" results are common for these.
                # The runtime scheduler already enforces exactly-one via
                # applies_if; this check covers genuine structural errors.
                my @groups = grep { defined $_ }
                             map  { $runstep{$_}{group} }
                             @producers;
                my %unique_groups = map { $_ => 1 } @groups;
                if ( @groups == @producers && keys %unique_groups == 1 ) {
                    next;  # all producers share a group -- legitimate pair
                }

                my @active_producers =
                    grep { defined $_ && eval { exists $runstep{$_}{applies_if} ? $runstep{$_}{applies_if}->($i) : 1 } }
                    @producers;

                if ( @active_producers == 0 ) {
                    # If the key exists in %data_key but has no runstep
                    # producer, it is a synthetic/composite key (like
                    # any_assembler_done) whose check function computes its
                    # value from other keys. No runstep declares produces for
                    # it -- that is by design. Check A already verified it
                    # has a %data_key entry; skip the producer count check.
                    next if exists $data_key{$key};
                    push @problems, "Sample [$sample_name]: runstep [$name] requires [$key], but no declared producer of it applies for this sample";
                }
                elsif ( @active_producers > 1 ) {
                    push @problems, "Sample [$sample_name]: key [$key] has " . scalar(@active_producers) . " simultaneously-applicable declared producers (" . join(", ", grep { defined $_ } @active_producers) . ") -- ambiguous";
                }
            }
        }
    }

    return @problems;
}

# Single entry point -- collects every problem from all three checks before
# stopping, so a developer sees all issues in one pass.
sub validate_runstep_graph {
    my @problems = (
        validate_requires_have_data_keys(),
        detect_runstep_dependency_cycles(),
        validate_exactly_one_applicable_producer(),
        validate_no_duplicate_hash_keys(),    # catches Perl silent-overwrite bugs
    );

    return unless @problems;

    log_message("ERROR: Runstep dependency graph validation failed:", "red");
    log_message("ERROR:   - $_", "red") for @problems;
    graceful_die("Runstep dependency graph validation failed (" . scalar(@problems) . " problem(s)) -- see above");
}

# Check A-extra: detect the Perl silent-overwrite trap where a runstep hash
# contains duplicate keys. Perl silently discards all but the last value for
# a duplicate key in a hash literal, so { requires => [...], requires => [...] }
# leaves only the second requires in effect. This is impossible to catch at
# runtime from the hash alone (the first value is simply gone), so we check
# at the source-code level by re-parsing this script's own text.
sub validate_no_duplicate_hash_keys {
    my @problems;

    # Read our own source to check for duplicate keys within runstep hashes.
    # We look at the block between '$runstep{$runstep_name} = {' and the
    # matching closing '};' for each runstep, and flag any key that appears
    # more than once.
    my $src_path = $0;  # the pipeline script itself
    my $src;
    {
        local $/;
        open my $fh, '<', $src_path or return ();
        $src = <$fh>;
    }

    # Extract per-runstep hash literal blocks
    while ( $src =~ /\$runstep\{\$runstep_name\}\s*=\s*\{([^}]+(?:\{[^}]*\}[^}]*)*)\};/g ) {
        my $block = $1;
        my %seen;
        while ( $block =~ /^\s+(\w+)\s*=>/mg ) {
            my $key = $1;
            # Only care about runstep contract fields -- skip sub-hash keys
            next unless grep { $_ eq $key } qw(
                requires produces applies_if group resources message
                long_name output_dir resultfile resultfiles_status
                result_parsing preprocessing test cmd_template
            );
            $seen{$key}++;
        }
        for my $key (sort keys %seen) {
            next unless $seen{$key} > 1;
            # Identify which runstep this block belongs to
            my $pos = pos($src) - length($&);
            my $before = substr($src, 0, $pos);
            my ($rs_name) = ($before =~ /\$runstep_name\s*=\s*"([^"]+)"\s*;[^;]*$/s);
            $rs_name //= "unknown";
            push @problems,
                "Runstep [$rs_name] has duplicate key [$key] in its hash literal -- "
              . "Perl silently discards all but the last; only the final value is effective. "
              . "This is how the Kraken2 trimmed_downsampled_fastq requires was lost silently.";
        }
    }

    return @problems;
}

###################################################################################################
## Early-test counterpart to run_data_driven_runsteps, for the same reason
## the old @runorder_loop1-driven test loop exists: surface a missing
## requirement before any real processing, not after. Respects applies_if
## the same way -- a disabled runstep is silently skipped here exactly as
## it would have been by never being pushed onto @runorder_loop1 at all.
sub test_data_driven_runsteps {
    my ($runstep_names, $i) = @_;

    my $sample_name = $R_samples->[$i]{name} // "sample $i";
    my $in_parallel = lc($R_cfg->{general}{parallel_mode} // 'off') eq 'on';

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in runstep [$name] for sample [$sample_name] during test phase: $err -- skipping", "red");
                next;
            }
            next unless $applies;
        }

        # In parallel mode, also check requires before calling the test
        # function. Many test functions call preprocessing internally to
        # check readiness; if the step's requires (e.g. main_assembly_present)
        # are not yet satisfied, those preprocessing calls would log spurious
        # warnings ("nothing available", "input file missing") about data that
        # simply hasn't been produced yet in this run. Silently skip instead.
        if ( $in_parallel && @{ $def->{requires} // [] } ) {
            my $ready = 1;
            for my $key ( @{ $def->{requires} } ) {
                unless ( exists $data_key{$key} && eval { $data_key{$key}{check}->($i) } ) {
                    $ready = 0; last;
                }
            }
            next unless $ready;
        }

        my $test_results = eval { $def->{test}->($i) };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] test function crashed in runstep [$name] for sample [$sample_name]: $err -- skipping", "red");
            next;
        }
        next if $test_results == 2;

        if ( $test_results == 1 ) { log_message("NOTICE: $name: OK"); }
        if ( !$test_results ) { log_message("NOTICE: Missing requirements for [$name]", "red"); }
    }
}
sub run_data_driven_runsteps {
    my ($runstep_names, $i) = @_;

    my $sample_name = $R_samples->[$i]{name} // "sample $i";

    for my $name (@$runstep_names) {

        # Fatal-error brake -- checked on every iteration since the flag
        # can become true mid-list (e.g. a coverage-check runstep earlier
        # in the same list call sets it via set_runtime_issue("fail",...)).
        if ( $R_samples->[$i]{fatal_error} ) {
            unless ( $R_samples->[$i]{_fatal_error_logged} ) {
                my $reason = join("; ", @{ $R_samples->[$i]{fatal_error_message} // [] });
                log_message("WARNING: Sample $sample_name: stopping further analysis -- $reason", "red");
                emit_event(type => 'sample_abandoned', sample => $i, reason => $reason);
                $R_samples->[$i]{_fatal_error_logged} = 1;
            }
            last;
        }

        my $def = $runstep{$name};
        next unless defined $def;

        # applies_if -- exception safety (S9.2). A crash here is a
        # PIPELINE CODE BUG, not a data-quality issue. Treat as a soft
        # skip (same as if applies_if returned false) -- never
        # fatal_to_sample. Logged distinctly so the error class is clear.
        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in runstep [$name] for sample [$sample_name]: $err -- skipping (soft skip)", "red");
                next;
            }
            next unless $applies;
        }

        # requires / data_key checks
        my $requires_ok = 1;
        for my $key ( @{ $def->{requires} // [] } ) {
            my $satisfied = eval { exists $data_key{$key} && $data_key{$key}{check}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] data_key check crashed for key [$key] in runstep [$name], sample [$sample_name]: $err -- treating as unsatisfied", "red");
                $satisfied = 0;
            }
            unless ($satisfied) {
                $requires_ok = 0;
                last;
            }
        }
        next unless $requires_ok;

        # preprocessing
        my $command = eval { $def->{preprocessing}->($i) };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] preprocessing crashed in runstep [$name] for sample [$sample_name]: $err -- skipping runstep (soft skip)", "red");
            next;
        }

        if ( defined $command && $command ne "" ) {
            run_step(
                name       => $def->{long_name},
                samplenr   => $i,
                message    => $def->{message},
                command    => $command,
                resultfile => "",
            );

            # result_parsing
            eval { $def->{result_parsing}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] result_parsing crashed in runstep [$name] for sample [$sample_name]: $err -- results for this runstep may be incomplete", "red");
            }
        }
    }
}
###################################################################################################
## Batch-level counterparts to run_data_driven_runsteps/test_data_driven_runsteps,
## for runsteps that are genuinely cross-sample by nature (sort_assemblies,
## multiqc) rather than sample-oriented -- see the design discussion on
## keeping as much as possible sample-oriented so samples from different
## runs can be combined later, with these as the deliberate, named
## exceptions. No sample index: applies_if/test/preprocessing/
## result_parsing are all called with no arguments, exactly mirroring the
## existing @runorder_post1 calling convention (samplenr => -1 in run_step)
## -- this replaces that hardcoded list with the same declarative contract
## the per-sample runsteps already use, not a different mechanism.
##
## "requires" here means something different than for a per-sample
## runstep: there's no single sample to check a data-key against. Two
## helpers below cover the two ways that's actually needed in practice --
## "did at least one sample get far enough" (sort_assemblies tolerates
## individual samples missing their assembly, so it only needs SOME
## sample to have one) versus a stricter "did every sample get there"
## for anything that would need that instead. Meaningful only once the
## full per-sample phase has completed, which is exactly when batch
## runsteps are positioned to run.

sub any_sample_satisfies {
    my ($key) = @_;
    return 0 unless exists $data_key{$key};
    for my $i ( 0 .. $#$R_samples ) {
        return 1 if $data_key{$key}{check}->($i);
    }
    return 0;
}

sub all_samples_satisfy {
    my ($key) = @_;
    return 0 unless exists $data_key{$key};
    for my $i ( 0 .. $#$R_samples ) {
        return 0 unless $data_key{$key}{check}->($i);
    }
    return 1;
}

sub test_data_driven_batch_runsteps {
    my ($runstep_names) = @_;

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in batch runstep [$name] during test phase: $err -- skipping", "red");
                next;
            }
            next unless $applies;
        }

        my $test_results = eval { $def->{test}->() };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] test function crashed in batch runstep [$name]: $err -- skipping", "red");
            next;
        }
        next if $test_results == 2;

        if ( $test_results == 1 ) { log_message("NOTICE: $name: OK"); }
        if ( !$test_results ) { log_message("NOTICE: Missing requirements for [$name]", "red"); }
    }
}
sub run_data_driven_batch_runsteps {
    my ($runstep_names) = @_;

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        # applies_if -- same exception-safety rationale as in
        # run_data_driven_runsteps (S9.2): a crash is a PIPELINE CODE BUG,
        # logged distinctly, treated as a soft skip. Batch runsteps have no
        # single sample to attribute a fatal_to_sample to anyway.
        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in batch runstep [$name]: $err -- skipping (soft skip)", "red");
                next;
            }
            next unless $applies;
        }

        my $requires_ok = 1;
        for my $key ( @{ $def->{requires} // [] } ) {
            my $satisfied = eval { any_sample_satisfies($key) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] requires check crashed for key [$key] in batch runstep [$name]: $err -- treating as unsatisfied", "red");
                $satisfied = 0;
            }
            unless ($satisfied) {
                $requires_ok = 0;
                last;
            }
        }
        next unless $requires_ok;

        my $command = eval { $def->{preprocessing}->() };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] preprocessing crashed in batch runstep [$name]: $err -- skipping runstep (soft skip)", "red");
            next;
        }

        if ( defined $command && $command ne "" ) {
            run_step(
                name       => $def->{long_name},
                samplenr   => -1,
                message    => $def->{message},
                command    => $command,
                resultfile => "",
            );

            eval { $def->{result_parsing}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] result_parsing crashed in batch runstep [$name]: $err -- results for this runstep may be incomplete", "red");
            }
        }
    }
}

###################################################################################################
## Control channel (§11.3) -- spool directory under out/control/, one JSON
## file per command, processed in filename order (timestamps in the name
## ensure chronological order), each file deleted after handling so it is
## never processed twice.
##
## Supported commands:
##   { "command": "pause" }            -- stop dispatching new work
##   { "command": "resume" }           -- resume normal dispatch
##   { "command": "terminate" }        -- graceful terminate: finish the
##                                        current step, then exit 1
##
## Command delivery from the GUI/operator side:
##   Write to a temp name, then rename atomically into the spool dir.
##   Never write the final filename directly (avoids a partially-written
##   file at its final name being read before the write is complete).
##   Example: write_file("$control_dir/.tmp_$name", '{"command":"pause"}');
##            rename("$control_dir/.tmp_$name", "$control_dir/$name");

my %_valid_control_command = map { $_ => 1 } qw(pause resume terminate);

sub process_control_commands {
    return unless -d $S_control_dir;

    opendir(my $dh, $S_control_dir) or return;
    my @files = sort grep { /^[^.]/ && -f "$S_control_dir/$_" } readdir($dh);
    closedir($dh);

    for my $file (@files) {
        my $path = "$S_control_dir/$file";
        my $raw  = do { local $/; open(my $fh,'<',$path) or next; <$fh> };
        my $cmd  = eval { JSON::MaybeXS->new->decode($raw) };
        my $name = ($cmd && ref $cmd eq 'HASH') ? ($cmd->{command} // '') : '';

        unless ($_valid_control_command{$name}) {
            log_message("WARNING: Control channel: ignoring malformed/unknown command file [$file]", "red");
            unlink $path;
            next;
        }

        if ($name eq 'pause') {
            unless ($S_paused) {
                $S_paused = 1;
                log_message("NOTICE: Control channel: PAUSED -- will not dispatch new work until resumed", "yellow");
                emit_event(type => 'paused');
            }
        }
        elsif ($name eq 'resume') {
            if ($S_paused) {
                $S_paused = 0;
                log_message("NOTICE: Control channel: RESUMED -- resuming normal dispatch", "green");
                emit_event(type => 'resumed');
            }
        }
        elsif ($name eq 'terminate') {
            unless ($S_terminate) {
                $S_terminate = 1;
                $S_paused    = 1;   # stop new dispatch too
                log_message("NOTICE: Control channel: TERMINATE received -- will exit after current step finishes", "red");
                emit_event(type => 'terminating');
            }
        }

        unlink $path;
    }
}

# Called at the start of every run_step invocation, before dispatch.
# Processes any pending commands, then blocks (with a short poll sleep)
# if paused, so a pause/resume pair issued between two steps has the
# intended effect. A terminate command while paused is also honoured here.
sub check_control_channel {
    process_control_commands();

    while ($S_paused) {
        # Check for new commands (a resume or terminate) while we wait.
        # 5-second poll -- short enough to feel responsive, long enough
        # not to burn CPU while idle.
        sleep 5;
        process_control_commands();

        if ($S_terminate) {
            log_message("NOTICE: Control channel: terminating after pause -- exiting now", "red");
            close_logfile();
            exit 1;
        }
    }

    if ($S_terminate) {
        log_message("NOTICE: Control channel: terminating after current step -- exiting now", "red");
        close_logfile();
        exit 1;
    }
}

sub run_step {
    my (%args) = @_;

    my $name        = $args{name}        // "Unnamed step";
    my $samplenr    = $args{samplenr}    // -1;
    my $message     = $args{message}     // "";
    my $command     = $args{command}     // "";
    my $resultfile  = $args{resultfile}  // "";

    # progress report
    my $formated_msg = log_progress($samplenr, $message);

    
    if (should_run($resultfile)) {

      # Control channel check (§11.3) -- honour any pending pause/resume/
      # terminate commands before starting a new piece of work. Called here
      # rather than in the schedulers so a single hook covers every
      # runstep, per-sample and batch alike, without scheduler duplication.
      check_control_channel();

      emit_event(type => 'runstep_started', sample => $samplenr, runstep => $name);

      my $result = execute_and_log($command, 1, $formated_msg );

      emit_event(
          type      => 'runstep_finished',
          sample    => $samplenr,
          runstep   => $name,
          status    => ($result && $result->{success}) ? 'success' : 'failed',
          exit_code => $result ? $result->{exit_code} : undef,
          elapsed_s => $result ? $result->{elapsed_s} : undef,
      );

    } else {
      log_message("NOTICE: Skipping step: $name. Already exists (extend mode)");   
    }

}

#########################################################################################################
sub should_run {
    my ($resultfilepath) = @_;

    # if in extend mode and result file already exists → skip
    if (lc($R_cfg->{general}->{overwrite}) eq "extend" && -f $resultfilepath) {
        return 0;  # should not run
    }

    return 1;  # should run
}

###################################################################################################
## Parallel scheduler
##
## Activated when general.parallel_mode = "on". Replaces the per-sample
## loop (which calls run_data_driven_runsteps per sample) with a single
## event loop that dispatches ready (sample, runstep) pairs from multiple
## samples simultaneously, subject to the resource budget.
##
## The batch phase (sort_assemblies, checkm, chewbbaca, multiqc) always
## runs sequentially AFTER all per-sample work is done -- regardless of
## parallel_mode. The existing run_data_driven_batch_runsteps() is called
## unmodified for that.
##
## Key data structures:
##   %S_par_active   -- currently-running jobs, keyed by child PID
##   $S_par_threads  -- threads currently committed
##   $S_par_ram_gb   -- RAM (GB) currently committed
##   %S_par_done     -- "$i,$name" set of completed (sample,runstep) pairs
##   %S_par_next_idx -- per-sample index into $runstep_names (next to try)

# Renders the live status board to stdout using ANSI escape codes.
# Called every poll tick while jobs are active. No-op when stdout is not
# a TTY (CI, background, piped).
sub _par_render_status_board {
    my (%args) = @_;
    return unless -t STDOUT;

    my $active_jobs  = $args{active_jobs}  // {};
    my $done         = $args{done}         // 0;
    my $total        = $args{total}        // 1;
    my $samples_done = $args{samples_done} // 0;
    my $samples_total= $args{samples_total}// scalar(@$R_samples);
    my $start_time   = $args{start_time}   // time();
    my $board_lines  = $args{board_lines}  // 0;
    my $done_lines   = $args{done_lines}   // [];

    # Move cursor up to overwrite the board from the previous tick
    print "\r\e[${board_lines}A\e[J" if $board_lines > 0;

    # Print any completed-step lines ABOVE the new board, in the scrollback
    for my $line (@$done_lines) {
        print "$line\n";
    }

    my $elapsed = format_elapsed(time() - $start_time);
    my $pct     = $total > 0 ? int(100 * $done / $total) : 0;
    my $bar_w   = 30;
    my $filled  = int($bar_w * $pct / 100);
    my $bar     = ('█' x $filled) . ('░' x ($bar_w - $filled));

    my $cols = (-t STDOUT) ? ((GetTerminalSize())[0] || 80) : 80;
    my $sep  = '━' x ($cols > 4 ? $cols - 2 : 78);

    my $headroom = $R_cfg->{general}{parallel_headroom} // 0.85;
    my $max_t    = $S_max_threads ? int($S_max_threads * $headroom) : '?';
    my $max_r    = $S_max_ram_gb  ? int($S_max_ram_gb  * $headroom) : '?';

    print "$sep\n";
    printf " eurlc-wgs  |  parallel  |  elapsed: %-10s\n", $elapsed;
    printf " Progress:  %s %3d%%  (%d/%d steps)\n", $bar, $pct, $done, $total;
    my $warn_str = $S_par_warning_count > 0
        ? "  \x1b[33m\x{26a0} $S_par_warning_count warning(s)\x1b[0m"
        : "";
    printf " Samples:   %d/%d complete  |  Resources: %s/%s threads  %s/%sGB RAM%s\n",
        $samples_done, $samples_total,
        $args{cur_threads} // 0, $max_t,
        $args{cur_ram}     // 0, $max_r,
        $warn_str;
    print "$sep\n";

    my $new_board_lines = 5;

    for my $pid (sort { $a <=> $b } keys %$active_jobs) {
        my $job = $active_jobs->{$pid};
        my $job_elapsed = format_elapsed(time() - ($job->{start_time} // time()));
        printf "  %-10s  %-22s  %s  [%dt %dGB]\n",
            $R_samples->[$job->{sample}]{name} // "?",
            $job->{runstep} // "?",
            $job_elapsed,
            $job->{threads} // 0,
            $job->{ram_gb}  // 0;
        $new_board_lines++;
    }

    print "$sep\n";
    $new_board_lines++;

    # Done-lines were printed inside the board zone (above the live part).
    # Next tick's cursor-up must account for them, otherwise the old board
    # is only partially erased. Add their count to the returned line total.
    return $new_board_lines + scalar(@$done_lines);
}

# The parallel per-sample scheduler. Drives the full per-sample phase;
# the batch phase is not touched.
sub run_parallel_runsteps {
    my ($runstep_names, $applicability) = @_;

    my $headroom      = $R_cfg->{general}{parallel_headroom} // 0.85;
    my $thread_budget = $S_max_threads * $headroom;
    my $ram_budget    = $S_max_ram_gb  * $headroom;
    my $total_work    = $applicability->{total};

    $S_par_warning_count = 0;   # reset for this run
    @S_par_warnings      = ();

    my %S_par_active;      # pid -> { sample, runstep, threads, ram_gb, start_time }
    my $S_par_threads = 0;
    my $S_par_ram_gb  = 0;
    my %S_par_done;           # "$i,$name" = 1
    my %S_samples_completed;  # $i = 1, prevents double-counting samples_done
    my $idle_ticks_without_dispatch = 0;  # deadlock detector
    my $done_count    = 0;
    my $samples_done  = 0;
    my $board_lines   = 0;
    my $start_time    = time();
    my @done_lines    = ();   # buffered done-lines, printed above the board

    # Track which samples still have pending work
    my %samples_pending = map { $_ => 1 } 0 .. $#$R_samples;

    while ( %samples_pending || %S_par_active ) {

        # ── 1. Reap finished children ──────────────────────────────────
        for my $pid (keys %S_par_active) {
            my $w = waitpid($pid, POSIX::WNOHANG());
            next unless $w > 0;

            my $job = delete $S_par_active{$pid};
            $S_par_threads -= $job->{threads};
            $S_par_ram_gb  -= $job->{ram_gb};
            $S_par_threads  = 0 if $S_par_threads < 0;
            $S_par_ram_gb   = 0 if $S_par_ram_gb  < 0;

            my $i    = $job->{sample};
            my $name = $job->{runstep};
            my $def  = $runstep{$name};

            # result_parsing in the parent -- runs synchronously in the
            # reap cycle. Many result_parsing subs call log_message which
            # would print to stdout and corrupt the board rendering. Capture
            # those log lines into @done_lines so the renderer handles them.
            {
                local $S_par_log_capture = \@done_lines;
                eval { $def->{result_parsing}->($i) } if $def;
            }
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                push @done_lines, "ERROR: [PIPELINE BUG] result_parsing crashed in [$name] sample [" . ($R_samples->[$i]{name}//'') . "]: $err";
            }

            $S_par_done{"$i,$name"} = 1;
            $done_count++;

            my $elapsed = format_elapsed(time() - $job->{start_time});
            my $sample_name = $R_samples->[$i]{name} // "sample $i";
            # In parallel mode with a TTY, done-lines are suppressed --
            # they flash past too fast to read and cause the board to jump.
            # The progress bar shows advancement; the log file has the full
            # record. Without a TTY (CI, pipe) we still emit them since
            # there's no board to disrupt.
            log_message("NOTICE: $sample_name: $name done ($elapsed)") unless -t STDOUT;

            emit_event(type => 'runstep_finished', sample => $i, runstep => $name,
                       status => 'success', elapsed_s => time() - $job->{start_time});

            # Re-check sample completion now that this step is done.
            # A sample is complete when every runstep is either already done
            # OR not applicable (applies_if returns false at runtime -- may
            # differ from the startup precompute since some applies_if
            # depend on data produced during the run, e.g. species).
            my $sample_complete = 1;
            for my $n (@$runstep_names) {
                next if $S_par_done{"$i,$n"};
                next if grep { $_->{sample} == $i && $_->{runstep} eq $n } values %S_par_active;
                my $def_n = $runstep{$n};
                next unless defined $def_n;
                my $applies = eval { exists $def_n->{applies_if} ? $def_n->{applies_if}->($i) : 1 };
                if ($applies) {
                    $sample_complete = 0;
                    last;
                }
                # Not applicable at runtime -- mark done so we don't revisit
                $S_par_done{"$i,$n"} = 1;
            }
            if ($sample_complete) {
                delete $samples_pending{$i};
                $samples_done++ unless $S_samples_completed{$i}++;
            }
        }

        # ── 2. Dispatch new work ───────────────────────────────────────
        my $dispatched_this_tick = 0;

        SAMPLE: for my $i ( sort { $a <=> $b } keys %samples_pending ) {

            next if $R_samples->[$i]{fatal_error};

            # Scan the full runstep list every tick -- dispatch as many
            # ready steps as resources allow before moving on to the next
            # sample. This enables mlst+fastmlst+quast+remap to all be
            # dispatched in one tick once the assembly is done.
            # Steps already active for this sample are skipped (the
            # active-jobs grep below handles that).
            RUNSTEP: for my $name (@$runstep_names) {

                next if $S_par_done{"$i,$name"};
                next if grep { $_->{sample} == $i && $_->{runstep} eq $name } values %S_par_active;

                my $def = $runstep{$name};
                next unless defined $def;

                # applies_if
                my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
                if ($@) {
                    (my $err = $@) =~ s/\n/ /g;
                    log_message("ERROR: [PIPELINE BUG] applies_if crashed in [$name] sample [${\($R_samples->[$i]{name}//'')}]: $err -- skipping", "red");
                    next RUNSTEP;
                }
                unless ($applies) {
                    $S_par_done{"$i,$name"} = 1;
                    next RUNSTEP;
                }

                # requires
                my $ready = 1;
                for my $key (@{ $def->{requires} // [] }) {
                    my $key_ok = exists $data_key{$key} && eval { $data_key{$key}{check}->($i) };
                    unless ($key_ok) {
                        $ready = 0; last;
                    }
                }
                next RUNSTEP unless $ready;   # not yet -- try other steps

                # Resource check
                my $res    = get_runstep_resources($name);
                my $need_t = $res->{threads};
                my $need_r = $res->{ram_gb};

                # Allow dispatch if this would be the only running job
                # (prevents deadlock when a single step exceeds the budget).
                my $is_only = !%S_par_active;

                unless ($is_only || ($S_par_threads + $need_t <= $thread_budget
                                  && $S_par_ram_gb  + $need_r <= $ram_budget)) {
                    # Resources exhausted -- stop dispatching for all samples
                    # this tick. (Other samples might fit smaller steps, but
                    # keeping it simple avoids starvation issues.)
                    last SAMPLE;
                }

                # preprocessing
                my $command = eval { $def->{preprocessing}->($i) };
                if ($@) {
                    (my $err = $@) =~ s/\n/ /g;
                    log_message("ERROR: [PIPELINE BUG] preprocessing crashed in [$name]: $err -- skipping", "red");
                    $S_par_done{"$i,$name"} = 1;
                    next RUNSTEP;
                }

                # Empty command: step handled internally by preprocessing
                # (e.g. "already done" path calls result_parsing itself).
                if (!defined $command || $command eq "") {
                    $S_par_done{"$i,$name"} = 1;
                    $done_count++;
                    next RUNSTEP;
                }

                # fork
                emit_event(type => 'runstep_started', sample => $i, runstep => $name);
                log_message("INFO: Dispatching [$name] for sample [${\($R_samples->[$i]{name}//'?')}] (${need_t}t/${need_r}GB)");

                my $pid = fork();
                if (!defined $pid) {
                    log_message("ERROR: Fork failed for [$name]: $!", "red");
                    $S_par_done{"$i,$name"} = 1;
                    next RUNSTEP;
                }

                if ($pid == 0) {
                    POSIX::setpgid(0, 0);
                    # SUB\t... commands are internal Perl subs -- exec bash
                    # can't handle them. Call _run_internal_sub directly,
                    # exactly as execute_and_log does in sequential mode.
                    my ($subname, @subargs) = _parse_internal_cmd($command);
                    if (defined $subname) {
                        my $rc = _run_internal_sub($subname, @subargs);
                        exit($rc & 255);
                    }
                    exec "bash", "-c", $command;
                    exit 127;
                }

                POSIX::setpgid($pid, $pid);

                $S_par_active{$pid} = {
                    sample     => $i,
                    runstep    => $name,
                    threads    => $need_t,
                    ram_gb     => $need_r,
                    start_time => time(),
                };
                $S_par_threads += $need_t;
                $S_par_ram_gb  += $need_r;
                $dispatched_this_tick++;
                $idle_ticks_without_dispatch = 0;
                # No last RUNSTEP -- continue scanning for more ready steps
                # for this sample (e.g. mlst+fastmlst+quast+remap in parallel)
            }
        }

        # ── 3. Control channel ─────────────────────────────────────────
        process_control_commands();
        if ($S_terminate) {
            log_message("NOTICE: Parallel scheduler: terminate command received -- no new work dispatched", "red");
            # Wait for active jobs to finish
            for my $pid (keys %S_par_active) {
                waitpid($pid, 0);
            }
            close_logfile();
            exit 1;
        }

        # ── 4. Status board + sleep ────────────────────────────────────
        $board_lines = _par_render_status_board(
            active_jobs   => \%S_par_active,
            done          => $done_count,
            total         => $total_work,
            samples_done  => $samples_done,
            samples_total => scalar(@$R_samples),
            start_time    => $start_time,
            board_lines   => $board_lines,
            cur_threads   => $S_par_threads,
            cur_ram       => $S_par_ram_gb,
            done_lines    => \@done_lines,
        );
        @done_lines = ();   # consumed by renderer

        if (%S_par_active) {
            select(undef, undef, undef, 0.5);
        }
        elsif (%samples_pending) {
            # No active jobs but still pending samples -- either waiting for
            # a requires to be satisfied (normal, short wait) or genuinely
            # deadlocked (requires will never be satisfied). Either way, sleep
            # briefly to avoid burning CPU.
            $idle_ticks_without_dispatch++;

            if ($idle_ticks_without_dispatch >= 10) {
                # 5s with no progress -- probably deadlocked. Log what's stuck
                # and force-complete the pending samples to unblock the batch phase.
                log_message("WARNING: Parallel scheduler: no progress for ${idle_ticks_without_dispatch} idle ticks -- checking for deadlock", "red");
                for my $i (sort keys %samples_pending) {
                    my $sname = $R_samples->[$i]{name} // "sample $i";
                    my @stuck;
                    for my $name (@$runstep_names) {
                        next if $S_par_done{"$i,$name"};
                        next if grep { $_->{sample} == $i && $_->{runstep} eq $name } values %S_par_active;
                        my $def = $runstep{$name};
                        next unless defined $def;
                        my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
                        next unless $applies;
                        # Check which requires are unsatisfied
                        for my $key (@{ $def->{requires} // [] }) {
                            unless (exists $data_key{$key} && eval { $data_key{$key}{check}->($i) }) {
                                push @stuck, "[$name] waiting for [$key]";
                            }
                        }
                    }
                    if (@stuck) {
                        log_message("WARNING: Sample [$sname] deadlocked on: " . join(", ", @stuck), "red");
                        # Force-complete this sample to unblock the batch phase
                        delete $samples_pending{$i};
                        $samples_done++ unless $S_samples_completed{$i}++;
                    } else {
                        # No stuck steps -- sample is actually done
                        delete $samples_pending{$i};
                        $samples_done++ unless $S_samples_completed{$i}++;
                    }
                }
                $idle_ticks_without_dispatch = 0;
            }

            select(undef, undef, undef, 0.5);
        }
    }

    # Final board clear
    print "\r\e[${board_lines}A\e[J" if -t STDOUT && $board_lines > 0;

    my $total_elapsed = format_elapsed(time() - $start_time);
    log_message("NOTICE: Parallel phase complete: $done_count steps across " . scalar(@$R_samples) . " samples ($total_elapsed)", "green");

    # Surface any warnings that were suppressed during result_parsing cycles.
    # These were counted/stored but not shown on screen to keep the board
    # stable. Print them now so nothing is silently lost before the batch
    # phase begins. Full text is always in the log file regardless.
    if (@S_par_warnings) {
        log_message("NOTICE: " . scalar(@S_par_warnings) . " warning(s) were suppressed during parallel execution:", "yellow");
        log_message("WARNING: $_") for @S_par_warnings;
        log_message("NOTICE: (all warnings above are also in the log file)", "yellow");
    }
}



