## runstep mash screen 

$runstep_name = "mash_screen";

$runstep{$runstep_name} = {
      message    => "Running Mash screen...",
      long_name  => "Mash screen",
      output_dir => "__DIR-QC2__/mash_screen",
      resultfile => "__DIR-QC2__/mash_screen/__BASE__.mash_screen.tsv",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{mashscreen}->{env} --no-capture-output mash screen 
       -w 
       -p __THREADS__ 
       __MASHDBPATH__ 
       '__R1TD__'
       > __OUTDIR__/__BASE__.mash_screen.tsv 
       __HIDE-STDERR__
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{mashscreen}->{env} --no-capture-output mash screen 
       -w 
       -p __THREADS__ 
       __MASHDBPATH__ 
       '__SETD__' 
       > __OUTDIR__/__BASE__.mash_screen.tsv 
       __HIDE-STDERR__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_mash_screen;

sub test_mash_screen {

   if(exists $tests_performed{mashscreen}  ) {
      return 2; 
   }

   $tests_performed{mashscreen} = 1;
 
   if (is_disabled($R_cfg->{mashscreen}{enabled})) {
        return 0;
  }
    
   check_conda_tool("mashscreen");
  #######################
  #test mash db
  my $testfile_mashscreen = fill_placeholders( normalize_path($R_cfg->{mashscreen}->{db_path} ));

  if(-d $testfile_mashscreen) {
    $testfile_mashscreen = resolve_mashdb($testfile_mashscreen);
  }

  if( ! -f $testfile_mashscreen) {
    log_message("WARNING: Mashscreen database not found [$testfile_mashscreen] - Dissabling Mashscreen from analysis!", "red");
    $R_cfg->{mashscreen}->{enabled} = 0;
  }
  else{
     my $db_size = human_readable_filesize($testfile_mashscreen);
     my $db_date = file_date($testfile_mashscreen);
     my $db_version = checkversion_db($testfile_mashscreen,"Mashscreen");
     log_message("NOTICE: Mash screen: Database size $db_size, date $db_date, version $db_version", "green");
     $R_cfg->{mashscreen}->{db_path} = $testfile_mashscreen;
  }


   return 1;

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_mash_screen;

sub preprocess_mash_screen {

    my ($samplenr) = @_;

    my $runstep_name = "mash_screen";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};   
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  


    ###################################
    ### check essential requirements
    
    if ($sample_type eq "FASTA") {
        return "";
    }
 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__R1TD__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__SETD__");
    }



     if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_mash_screen($samplenr);
        return "";
    } 
    
    
    # runstep specific replacements
    
    my $mashscreen_dbfile = fill_placeholders( normalize_path($R_cfg->{mashscreen}->{db_path} ));
   
    if(-d $mashscreen_dbfile) {
      $mashscreen_dbfile = resolve_mashdb($mashscreen_dbfile);
    }

    if( ! -f $mashscreen_dbfile) {
      log_message("WARNING: Mashscreen database not found [$mashscreen_dbfile] - Dissabling Mashscreen from analysis!", "red");
      $R_cfg->{mashscreen}->{enabled} = 0;
      return "";
    }
     
    _fill_placeholders__safe_replace(\$command, "__MASHDBPATH__", $mashscreen_dbfile);
         
         
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
        
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
          

    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_mash_screen;

sub postprocess_mash_screen {
    my ($samplenr) = @_;

    my $runstep_name = "mash_screen";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    # derive processed output paths
    my $tmp = $resultfile;
    $tmp =~ s/\.tsv$//;

    my $sorted_list_file          = "$tmp.sorted.txt";
    my $sorted_winnerlist_file    = "$tmp.sorted.winner_takes_all.txt";
    my $sample_assess_result_file = dirname($resultfile) . "/$sample_name.assess_status.txt";
    my $common_assess_result_file = dirname($resultfile) . "/all.assess_status.txt";

    # create processed files if needed
    if (
        ! -f $sorted_list_file
        || ! -f $sorted_winnerlist_file
        || ! -f $sample_assess_result_file
        || ! -f $common_assess_result_file
    ) {
        process_mashhits_file(
            $resultfile,
            $sorted_list_file,
            $sorted_winnerlist_file,
            $sample_assess_result_file,
            $common_assess_result_file,
            $sample_name
        );
    }

    # parse and mount results
    my $parsed_ref = parse_mashscreen_results(
        $sorted_list_file,
        $sorted_winnerlist_file,
        $sample_assess_result_file
    );

    return 0 unless defined $parsed_ref;

    $R_samples->[$samplenr]{results}{$runstep_name}{main} = $parsed_ref;

    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/mash_screen/__BASE__.mash_screen.tsv",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_sorted}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/mash_screen/__BASE__.mash_screen.sorted.txt",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_winner}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/mash_screen/__BASE__.mash_screen.sorted.winner_takes_all.txt",$samplenr, $runstep_name)); 




    my $status  = $R_samples->[$samplenr]{results}{$runstep_name}{main}{status}  // "n/a";
    my $species = $R_samples->[$samplenr]{results}{$runstep_name}{main}{species} // "n/a";

    my $color = "green";
    if (uc($status) ne "PASS") {
        $color = "yellow";
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Assess mash-screen status do not pass";
        set_sample_warning($samplenr,"warning","Assess mash-screen status do not pass");    
    }
    log_message("NOTICE: Sample $sample_name assess mash screen status: $status", $color);

    $color = "green";
    if ($species ne ($R_samples->[$samplenr]{main_results}{taxonomy}{species} // "n/a")) {
        $color = "yellow";
    }
    my $hitscore = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{1}{hitscore} // 0;
    my $identity    = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{1}{identity} // 0;
    my $shared      = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{1}{shared} // 0;
    my $outof       = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{1}{outof} // 0;   
    log_message("NOTICE: Sample $sample_name mash screen species: $species [Score=$hitscore, identity=$identity shared hashes=$shared/$outof]", $color);

    if ($species ne "n/a" && $species ne ($R_samples->[$samplenr]{main_results}{taxonomy}{species} // "n/a")) {
        log_message(
            "WARNING: Sample $sample_name: species check does not match Kraken2: [$species<>$R_samples->[$samplenr]{main_results}{taxonomy}{species}]",
            "red"
        );
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Mash-screen species does not match Kraken2 species";
        set_sample_warning($samplenr,"warning","Mash-screen species does not match Kraken2 species");      
    }

    if($species ne "n/a" && ($R_samples->[$samplenr]{main_results}{taxonomy}{species} // "n/a") eq "n/a"){
        $R_samples->[$samplenr]{main_results}{taxonomy}{species} = $species;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}  = $hitscore;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = "Mash-screen";
    }
    for (my $i = 1; $i <= 20; $i++) {

        next unless exists $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{species};

        my $hit_species = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{species};
        my $score       = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{hitscore};
        my $identity    = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{identity};
        my $shared      = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{shared};
        my $outof       = $R_samples->[$samplenr]{results}{$runstep_name}{main}{filtered_winner_takes_all}{$i}{outof};

        log_message(
            "NOTICE: Sample $sample_name mash screen result #$i: $hit_species [score=$score, identity=$identity shared hashes=$shared/$outof]",
            "green"
        );
    }

    return 1;
}


sub parse_mashscreen_results {
    my ($sorted_list_file, $sorted_winnerlist_file, $sample_assess_result_file) = @_;

    my $result = {};

    # ------------------------------------------------------------
    # Sorted list
    # ------------------------------------------------------------
    if (! -f $sorted_list_file) {

        log_message("WARNING: Mash-screen sorted results not found: $sorted_list_file");

    } else {

        open my $fh, '<', $sorted_list_file or do {
            log_message("WARNING: Could not open Mash-screen sorted results: $sorted_list_file");
            return undef;
        };

        my $row = 0;

        while (<$fh>) {

            chomp;
            next unless /\t/;

            my @cols = split /\t/, $_, -1;
            next unless @cols >= 9;

            $row++;

            # Skip header
            next if $row == 1 && $cols[0] =~ /Hitscore/i;

            my (
                $hitscore,
                $species,
                $identity,
                $shared,
                $outof,
                $multiplicity,
                $pval,
                $refid,
                $hitinfo
            ) = @cols;

            $result->{sorted}{$row - 1} = {
                hitscore     => $hitscore,
                species      => $species,
                identity     => $identity,
                shared       => $shared,
                outof        => $outof,
                multiplicity => $multiplicity,
                pval         => $pval,
                refid        => $refid,
                hitinfo      => $hitinfo,
            };
        }

        close $fh;
    }

    # ------------------------------------------------------------
    # Winner-takes-all list
    # ------------------------------------------------------------
    if (! -f $sorted_winnerlist_file) {

        log_message("WARNING: Mash-screen winner-takes-all results not found: $sorted_winnerlist_file");

    } else {

        open my $fh, '<', $sorted_winnerlist_file or do {
            log_message("WARNING: Could not open Mash-screen winner-takes-all results: $sorted_winnerlist_file");
            return undef;
        };

        my $row          = 0;
        my $filtered_row = 0;

        while (<$fh>) {

            chomp;
            next unless /\t/;

            my @cols = split /\t/, $_, -1;
            next unless @cols >= 9;

            $row++;

            # Skip header
            next if $row == 1 && $cols[0] =~ /Hitscore/i;

            my (
                $hitscore,
                $species,
                $identity,
                $shared,
                $outof,
                $multiplicity,
                $pval,
                $refid,
                $hitinfo
            ) = @cols;

            $result->{sorted_winner_takes_all}{$row - 1} = {
                hitscore     => $hitscore,
                species      => $species,
                identity     => $identity,
                shared       => $shared,
                outof        => $outof,
                multiplicity => $multiplicity,
                pval         => $pval,
                refid        => $refid,
                hitinfo      => $hitinfo,
            };

            # Filtered high-confidence hits
            if (
                looks_like_number($identity)
                && looks_like_number($shared)
                && $identity >= 0.95
                && $shared >= 100
            ) {

                $filtered_row++;

                $result->{filtered_winner_takes_all}{$filtered_row} = {
                    hitscore     => $hitscore,
                    species      => $species,
                    identity     => $identity,
                    shared       => $shared,
                    outof        => $outof,
                    multiplicity => $multiplicity,
                    pval         => $pval,
                    refid        => $refid,
                    hitinfo      => $hitinfo,
                };
            }
        }

        close $fh;
    }

    # ------------------------------------------------------------
    # Sample assessment
    # ------------------------------------------------------------
    if (! -f $sample_assess_result_file) {

        log_message("WARNING: Mash-screen sample assessment file not found: $sample_assess_result_file");

    } else {

        open my $fh, '<', $sample_assess_result_file or do {
            log_message("WARNING: Could not open Mash-screen sample assessment: $sample_assess_result_file");
            return undef;
        };

        while (<$fh>) {

            chomp;
            next unless /\t/;

            my ($sample, $status, $species) = split /\t/, $_, 3;

            next unless defined $status;
            next unless defined $species;

            # Skip possible header row
            next if $sample =~ /^sample$/i;

            $result->{status}  = $status;
            $result->{species} = $species;

            last;
        }

        close $fh;
    }

    return $result;
}
