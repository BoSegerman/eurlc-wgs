CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_kraken2;

sub test_kraken2 {

  

   if(exists $tests_performed{kraken2}  ) {
      return 2; 
   }

   $tests_performed{kraken2} = 1;

    my $testresult = "";
    
    $testresult = check_conda_tool("kraken2");
    $testresult = check_conda_tool("bracken");
    $testresult = check_conda_tool("krakentools");
    $testresult = check_conda_tool("krona");
    return 1;
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_kraken2;

sub preprocess_kraken2 {

    my ($samplenr) = @_;

    my $runstep_name = "Kraken2";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};  
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   

    ###################################
    ### check essential requirements
    

 
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__R1TD__", "__R2TD__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__SETD__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__FASTA__");
    }
    


     if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_kraken2($samplenr);
        return "";
    }  

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
                  
    # runstep specific replacements
    
    my $readlen = $R_samples->[$samplenr]{bracken_readlength} // "150";
    _fill_placeholders__safe_replace(\$command, "__READLEN__", $readlen);
    
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_kraken2;

sub postprocess_kraken2 {
    my ($samplenr) = @_;

    my $runstep_name = "Kraken2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);



    #######################################
    # parse results

    my $bracken_resultfile       = fill_placeholders("__OUTDIR__/__BASE__.bracken",       $samplenr, $runstep_name);
    my $bracken_resultfile_genus = fill_placeholders("__OUTDIR__/__BASE__.genus.bracken", $samplenr, $runstep_name);
    
    if (-f $bracken_resultfile) {
        my $bracken_results_ref = parse_bracken_results($bracken_resultfile, 'S');
        $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species} = $bracken_results_ref;
        if (!$bracken_results_ref || !%{$bracken_results_ref}) {
        log_message("WARNING: bracken-species data could not be parsed for sample $sample_name" );
      }
    }
    else {
        if ($sample_type ne "FASTA") {
            log_message("WARNING: No bracken resultfile (species level) found for sample $sample_name");
        }
    }

    if (-f $bracken_resultfile_genus) {
        my $bracken_results_ref_genus = parse_bracken_results($bracken_resultfile_genus, 'G');
        $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus} = $bracken_results_ref_genus;
        if (!$bracken_results_ref_genus || !%{$bracken_results_ref_genus}) {
           log_message("WARNING: bracken-genus data could not be parsed for sample $sample_name" );
        }
    }
    else {
        if ($sample_type ne "FASTA") {
            log_message("WARNING: No bracken resultfile (genus level) found for sample $sample_name");
        }
    }

    if (-f $resultfile) {
        my $kraken_results_ref = parse_kraken2_results($resultfile);
        $R_samples->[$samplenr]{results}{$runstep_name}{kraken2} = $kraken_results_ref;
        if (!$kraken_results_ref || !%{$kraken_results_ref}) {
           log_message("WARNING: kraken data could not be parsed for sample $sample_name" );
        }   
    }
    else {
        log_message("WARNING: No kraken2 resultfile found for sample $sample_name");
        return 0;
    }


    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{kraken2_report}         =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2.txt",$samplenr, $runstep_name)); 

    $R_samples->[$samplenr]{results}{$runstep_name}->{kraken2_species_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2_bracken_species.txt",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{kraken2_genus_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2_bracken_genuses.txt",$samplenr, $runstep_name)); 

    $R_samples->[$samplenr]{results}{$runstep_name}->{bracken_species_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.bracken",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{bracken_genus_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.genus.bracken",$samplenr, $runstep_name)); 

    $R_samples->[$samplenr]{results}{$runstep_name}->{kraken2_krona_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.krona_kraken2.html",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{bracken_species_krona_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.krona_bracken_species.html",$samplenr, $runstep_name)); 


    #######################################
    # remember pre-check taxonomy before deciding whether to update it

    my $precheck_species       = $R_samples->[$samplenr]{main_results}{taxonomy}{species}       // "n/a";
    my $precheck_species_score = $R_samples->[$samplenr]{main_results}{taxonomy}{species_score} // 0;
    my $precheck_genus         = $R_samples->[$samplenr]{main_results}{taxonomy}{genus}         // "n/a";
    my $precheck_genus_score   = $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}   // 0;

    #######################################
    # assign final genus call, with bracken -> kraken2 fallback

    my $genus_method         = "bracken";
    my $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{name}    // "n/a";
    my $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{percent} // 0;
    my $percent_int          = int($genus_result_percent);

    if ($genus_result eq "n/a") {
        $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{name}    // "n/a";
        $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{percent} // 0;
        $percent_int          = int($genus_result_percent);
        $genus_method         = "kraken2";
    }

    if ($genus_result eq "n/a") {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{genus_warnings} },
            "Final Kraken2/bracken analysis failed to determine genus";
        set_sample_warning($samplenr,"critical","Failed to determine genus");    
    }

    if ($precheck_genus ne "n/a" && $genus_result ne "n/a" && $genus_result ne $precheck_genus) {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{genus_warnings} },
            "Final Kraken2/bracken genus does not match pre-check genus";
        set_sample_warning($samplenr,"critical","Final Kraken2/bracken genus does not match pre-check genus");
    }

    if ($genus_result ne "n/a" && $percent_int > $precheck_genus_score) {
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus}        = $genus_result;
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}  = $percent_int;
        $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} = $genus_method;
    }

    #######################################
    # assign final species call, with bracken -> kraken2 fallback

    my $species_method         = "bracken";
    my $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{name}    // "n/a";
    my $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{percent} // 0;
    $percent_int               = int($species_result_percent);

    if ($species_result eq "n/a") {
        $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{name}    // "n/a";
        $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{percent} // 0;
        $percent_int            = int($species_result_percent);
        $species_method         = "kraken2";
    }

    if ($species_result eq "n/a") {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Final Kraken2/bracken analysis failed to determine species";
        set_sample_warning($samplenr,"warning","Failed to determine species");      
    }

    if ($precheck_species ne "n/a" && $species_result ne "n/a" && $species_result ne $precheck_species) {
        push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
            "Final Kraken2/bracken species does not match pre-check species";
        set_sample_warning($samplenr,"warning","Final Kraken2/bracken species does not match pre-check genus");    
    }

    if ($species_result ne "n/a" && $genus_result ne "n/a") {
        my ($species_genus) = split /\s+/, $species_result;
        if (!defined $species_genus || lc($species_genus) ne lc($genus_result)) {
            push @{ $R_samples->[$samplenr]{main_results}{taxonomy}{species_warnings} },
                "Final Kraken2/bracken genus does not match species";
            log_message("WARNING: Sample $sample_name: Species [$species_result] and Genus [$genus_result] do not match", "red");
            set_sample_warning($samplenr,"critical","Final Kraken2/bracken species [$species_result] and genus [$genus_result] do not match");
        }
    }

    if ($species_result ne "n/a" && $percent_int > $precheck_species_score) {
        $R_samples->[$samplenr]{main_results}{taxonomy}{species}        = $species_result;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}  = $percent_int;
        $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = $species_method;
    }

    #######################################
    # contamination check: genus level
    # use second-ranked entry, with bracken -> kraken2 fallback

    my $genus2_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[1]{name}    // "n/a";
    my $genus2_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[1]{percent} // 0;

    if ($genus2_result eq "n/a") {
        $genus2_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[1]{name}    // "n/a";
        $genus2_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[1]{percent} // 0;
    }

    my $color = "green";
    if ($genus2_result_percent > 5) { $color = "yellow"; }

    log_message(
        "NOTICE: Sample $sample_name: Largest contamination signal (genus level): $genus2_result ($genus2_result_percent%)",
        $color
    );

    $R_samples->[$samplenr]{main_results}{contamination}{genus}       = $genus2_result;
    $R_samples->[$samplenr]{main_results}{contamination}{genus_level} = $genus2_result_percent;
    $R_samples->[$samplenr]{main_results}{contamination}{genus_method} = "Kraken2";

    #######################################
    # contamination check: species level
    # start from second-ranked entry, with bracken -> kraken2 fallback
    # then skip configured cross-reactive species

    my @species_hits;
    my $species_hits_method = "bracken";

    if (exists $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}
        && ref($R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}) eq 'ARRAY'
        && @{ $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries} } > 0) {

        @species_hits = @{ $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries} };
    }
    else {
        $species_hits_method = "kraken2";
        @species_hits = @{ $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species} // [] };
    }

    my %crossreactive_species = ();
    if ($species_result ne "n/a" && exists $R_cfg->{species}{$species_result}{crossreactive_species}) {
        my $cross = $R_cfg->{species}{$species_result}{crossreactive_species} // "";
        foreach my $name (split /\s*,\s*/, $cross) {
            next if !defined $name || $name eq "";
            $crossreactive_species{lc $name} = 1;
        }
    }

    my $species_result2         = "n/a";
    my $species_result2_percent = 0;

    for (my $i = 1; $i < @species_hits; $i++) {
        my $candidate_name    = $species_hits[$i]{name}    // "n/a";
        my $candidate_percent = $species_hits[$i]{percent} // 0;

        next if $candidate_name eq "n/a";

        # skip same as main species
        next if lc($candidate_name) eq lc($species_result);

        # skip configured cross-reactive species
        next if exists $crossreactive_species{lc $candidate_name};

        # skip generic "Genus sp." style candidate for same genus
        if ($genus_result ne "n/a" && $candidate_name =~ /^\Q$genus_result\E\s+sp\./i) {
            next;
        }

        $species_result2         = $candidate_name;
        $species_result2_percent = $candidate_percent;
        last;
    }

    $color = "green";
    if ($species_result2_percent > 2) { $color = "yellow"; }
    if ($species_result2_percent > 5) { $color = "red"; }

    log_message(
        "NOTICE: Sample $sample_name: Largest contamination signal (species level): $species_result2 ($species_result2_percent%) [$species_hits_method]",
        $color
    );

    $R_samples->[$samplenr]{main_results}{contamination}{species}       = $species_result2;
    $R_samples->[$samplenr]{main_results}{contamination}{species_level}        = $species_result2_percent;
    $R_samples->[$samplenr]{main_results}{contamination}{species_method}  = $species_hits_method;

    #######################################
    # summary logging of final top call

    log_message(
        "NOTICE: Sample $sample_name: Final genus call: $genus_result ($genus_result_percent%) [$genus_method]",
        "green"
    );
    log_message(
        "NOTICE: Sample $sample_name: Final species call: $species_result ($species_result_percent%) [$species_method]",
        "green"
    );

    return 1;
}





 
