###################################################################################################
## default settings




###################################################################################################
## QC measures registry
##
## This is the single place to register a new QC measure. To add one:
##
##   1. Add an entry below with a unique key (the "measure" name used
##      everywhere else, e.g. in config keys and in qc_expectations/qc_checks):
##        my_new_measure => {
##            category => 'qscore',                 # groups related issues in the report
##            path     => [qw(qscore raw my_field)], # where to find the observed value,
##                                                    # i.e. $R_samples->[$i]{main_results}{qscore}{raw}{my_field}
##            label    => 'My new measure',          # human-readable name shown in messages/report
##        },
##
##   2. Nothing else needs to change in code -- @measures (below) is derived
##      automatically from the keys of this hash, and load_expectations()/
##      evaluate_qc_measure() pick it up automatically for every sample.
##
##   3. Add the matching threshold keys to the config file (general section,
##      species default section, and/or a specific species section), named
##      "<level>_<measure>" for level in (expected|warning|critical|fail):
##        general:
##          expected_my_new_measure: "100"
##          warning_my_new_measure:  "<90 >110"
##          critical_my_new_measure: "<80 >120"
##          fail_my_new_measure:     "<70 >130"
##      Any level can be omitted (e.g. no "fail" threshold) -- see
##      get_config_value_for_species() for the species/general fallback order.
##
my %QC_MEASURE_DEF = (
    qscore_raw_gc => {
        category => 'qscore',
        path     => [qw(qscore raw gc)],
        label    => 'Raw read GC content',
    },
    qscore_raw_n_rate => {
        category => 'qscore',
        path     => [qw(qscore raw n_rate)],
        label    => 'Raw read N rate',
    },
    qscore_raw_q30_rate => {
        category => 'qscore',
        path     => [qw(qscore raw q30_rate)],
        label    => 'Raw read Q30 rate',
    },
    qscore_raw_average_read_length => {
        category => 'qscore',
        path     => [qw(qscore raw av_read_len)],
        label    => 'Raw read average read length',
    },
    coverage_raw_q30_coverage => {
        category => 'coverage',
        path     => [qw(coverage raw q30_coverage)],
        label    => 'Raw read Q30+ coverage',
    },
    coverage_raw_coverage => {
        category => 'coverage',
        path     => [qw(coverage raw coverage)],
        label    => 'Raw read coverage',
    },

    qscore_trimmed_gc => {
        category => 'qscore',
        path     => [qw(qscore trimmed gc)],
        label    => 'Trimmed read GC content',
    },
    qscore_trimmed_q30_rate => {
        category => 'qscore',
        path     => [qw(qscore trimmed q30_rate)],
        label    => 'Trimmed read Q30 rate',
    },
    qscore_trimmed_average_q_score => {
        category => 'qscore',
        path     => [qw(qscore trimmed av_q_score)],
        label    => 'Trimmed read average Q score',
    },
    qscore_trimmed_adapters => {
        category => 'qscore',
        path     => [qw(qscore trimmed adapters)],
        label    => 'Trimmed read adapter content',
    },
    qscore_trimmed_average_read_length => {
        category => 'qscore',
        path     => [qw(qscore trimmed av_read_len)],
        label    => 'Trimmed read average length',
    },
    coverage_trimmed_q30_coverage => {
        category => 'coverage',
        path     => [qw(coverage trimmed q30_coverage)],
        label    => 'Trimmed read aQ30+ coverage',
    },
    coverage_trimmed_coverage => {
        category => 'coverage',
        path     => [qw(coverage trimmed coverage)],
        label    => 'Trimmed read coverage',
    },

    taxonomy_species_score => {
        category => 'taxonomy',
        path     => [qw(taxonomy species_score)],
        label    => 'Species determination score',
    },

    contamination_species_level => {
        category => 'contamination',
        path     => [qw(contamination species_level)],
        label    => 'Species contamination level',
    },
    contamination_genus_level => {
        category => 'contamination',
        path     => [qw(contamination genus_level)],
        label    => 'Genus contamination level',
    },

    assembly_size => {
        category => 'assembly',
        path     => [qw(assembly size)],
        label    => 'Assembly size',
    },
    assembly_n50 => {
        category => 'assembly',
        path     => [qw(assembly N50)],
        label    => 'Assembly N50',
    },
    assembly_contigs => {
        category => 'assembly',
        path     => [qw(assembly contigs)],
        label    => 'Assembly number of contigs',
    },
    assembly_gc => {
        category => 'assembly',
        path     => [qw(assembly gc)],
        label    => 'Assembly GC content',
    },

    typing_cgmlst_call_rate => {
        category => 'typing',
        path     => [qw(typing cgmlst_call_rate)],
        label    => 'cgMLST call rate',
    },
    typing_cgmlst_paralogous => {
        category => 'typing',
        path     => [qw(typing cgmlst paralogous)],
        label    => 'cgMLST paralogous loci',
    },
);


my @measures = sort keys %QC_MEASURE_DEF;

    
