       --threads __THREADS__ 
       -o __OUTDIR__/__BASE__.txt 
       $R_cfg->{amrfinderplus}->{arguments} 
       __AMRFINDER_ORGANISM_ARG__
       __HIDE-OUTPUT__
CMD

