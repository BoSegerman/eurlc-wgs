####################################################################################################

####################################################################################################
sub get_kraken2_species(){

  
my $samplenr = shift(@_);
my $krakenreport_path = shift(@_);


  
if( -f $krakenreport_path) { 
open(HANDLE_INFILE,"$krakenreport_path") || return "";

my %specieslevel = ();

while(<HANDLE_INFILE>){
   my $line = $_;
   chomp($line);
   if($line =~ /\t/ ){
      my @columns = split(/\t/,$line);
      my $percent = $columns[0];
      my $domain = $columns[3];
      my $taxname = $columns[5];
      $taxname =~ s/^\s+|\s+$//g;

      if($domain eq "S"){
         $specieslevel{$taxname} = $percent;
      }
     } # if tab


} # end while

    my $count = 0;
  
  foreach my $taxname (sort { $specieslevel{$b} <=> $specieslevel{$a} } keys %specieslevel) {
    $count++;
    if($count==1){   return  $taxname; }
  }
close(HANDLE_INFILE);
} # end if file
else{
  return "";
}
}
