   return check_conda_tool("resfinder");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_resfinder_fasta;

sub preprocess_resfinder_fasta {

    my ($samplenr) = @_;

    my $runstep_name = "resfinder_fasta";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template};   
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   

    if(! $R_cfg->{resfinder}->{fasta} ) {
       return "";
    } 
 
    return "" unless require_input_files($samplenr, $runstep_name, "Optional", "__DIR-ASSEMBLIES__/__BASE__.fasta");
    
     if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_resfinder_fasta($samplenr);
        return "";
      }  
         
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # runstep specific replacements

    my $resfinder_species = match_species_or_genus($R_cfg->{resfinder}{available_species_resfinder}, $R_samples->[$samplenr]{species});
    _fill_placeholders__safe_replace(\$command, "__RESFINDER-SPECIES__", "'$resfinder_species'");
    
    my $pointfinder_species =  match_species_or_genus($R_cfg->{resfinder}{available_species_pointfinder}, $R_samples->[$samplenr]{species});
    
    if($pointfinder_species eq "Others"  ){
       _fill_placeholders__safe_replace(\$command, "__POINTDB__", "");
    }
    elsif($R_cfg->{resfinder}{run_pointfinder}//1){
       _fill_placeholders__safe_replace(\$command, "__POINTDB__", "--db_path_point $R_cfg->{resfinder}->{db_path}/pointfinder_db");
    }
    else{
      _fill_placeholders__safe_replace(\$command, "__POINTDB__", "");
    }

     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);          

    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_resfinder_fasta;

sub postprocess_resfinder_fasta {
    my ($samplenr) = @_;

    my $runstep_name = "resfinder_fasta";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

   my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
        
    my $result_ref = parse_resfinder($resultfile,$samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref; 
   my $hitcount = $result_ref->{hit_count};
   
   for(my $i=0;$i<$hitcount; $i++){
     my $resgene =  $result_ref->{resfinder_hits}[$i]->{resistance_gene} // "n/a";
     my $phenotype = $result_ref->{resfinder_hits}[$i]->{phenotype} // "n/a";
     my $identity = $result_ref->{resfinder_hits}[$i]->{identity} // "n/a";
     my $coverage = $result_ref->{resfinder_hits}[$i]->{coverage} // "n/a";
   log_message("NOTICE: Sample $sample_name: AMR-hit: $resgene ($phenotype) [Identity: $identity % Coverage: $coverage %]", "green");
   }
  
   $R_samples->[$samplenr]{results}{$runstep_name}->{txt_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-AMR__/resfinder_contigs/__BASE__/ResFinder_results_tab.txt",$samplenr, $runstep_name)); 


    return 1; # success
}



