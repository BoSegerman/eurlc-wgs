#    index_summary => {
#        header => [...],
#        rows   => [ {...}, {...} ],
#    },
#
#    derived => {
#        summary_row_count       => 3,
#        index_summary_row_count => 24,
#    },
#};


sub derive_interop_summary {
    my ($R_interop) = @_;

    my %derived;

    return \%derived if !defined $R_interop || ref($R_interop) ne 'HASH';

    # Example: carry row counts for now
    if (defined $R_interop->{summary}{rows} && ref($R_interop->{summary}{rows}) eq 'ARRAY') {
        $derived{summary_row_count} = scalar @{ $R_interop->{summary}{rows} };
    }

    if (defined $R_interop->{index_summary}{rows} && ref($R_interop->{index_summary}{rows}) eq 'ARRAY') {
        $derived{index_summary_row_count} = scalar @{ $R_interop->{index_summary}{rows} };
    }

    return \%derived;
}

sub resolve_interop_executable {
    my (@candidates) = @_;

    my $env = $R_cfg->{interop}{env} // '';
    return undef if $env eq '';

    foreach my $exe (@candidates) {
        my $cmd = "conda run -n $env --no-capture-output $exe >/dev/null 2>&1";
        my $exit = system($cmd);
        return $exe if $exit == 0;
    }

    return undef;
}


sub parse_interop_summary_file {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my %out = (
        version       => '',
        run_name      => '',
        totals        => {},
        read_sections => {},
        footer        => {},
        derived       => {},
    );

    open my $fh, "<", $file or do {
        log_message("WARNING: Could not open InterOp summary file [$file]: $!");
        return {};
    };

    my $mode = '';
    my $current_section = '';
    my @section_columns;

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\r$//g;
        next if $line =~ /^\s*$/;

        if ($line =~ /^\#\s*Version:\s*(.+)$/) {
            $out{version} = $1;
            next;
        }

        if ($out{run_name} eq '' && $line !~ /^Level,/) {
            $out{run_name} = $line;
            next;
        }

        # totals section header
        if ($line =~ /^Level,Yield,Projected Yield,Aligned,Error Rate,Intensity C1,%>=Q30,% Occupied$/) {
            $mode = 'totals_header';
            next;
        }

        # totals rows
        if ($mode eq 'totals_header' && $line =~ /,/) {
            my @f = split /,/, $line, -1;
            if (@f == 8) {
                my $level = $f[0];
                $out{totals}{$level} = {
                    level              => $f[0],
                    yield_gb           => parse_interop_number($f[1]),
                    projected_yield_gb => parse_interop_number($f[2]),
                    aligned_pct        => parse_interop_number($f[3]),
                    error_rate         => parse_interop_number_or_text($f[4]),
                    intensity_c1       => parse_interop_number($f[5]),
                    pct_q30            => parse_interop_number($f[6]),
                    pct_occupied       => parse_interop_number_or_text($f[7]),
                };
                next;
            }
        }

        # read section name
        if ($line =~ /^Read\s+\d+(?:\s+\(I\))?$/) {
            $current_section = $line;
            $out{read_sections}{$current_section} ||= {
                columns    => [],
                rows       => [],
                by_surface => {},
            };
            $mode = 'read_section_wait_header';
            next;
        }

        # read section header
        if ($mode eq 'read_section_wait_header' && $line =~ /^Lane,Surface,Tiles,/) {
            @section_columns = split /,/, $line, -1;
            $out{read_sections}{$current_section}{columns} = [ @section_columns ];
            $mode = 'read_section_rows';
            next;
        }

        # read section rows
        if ($mode eq 'read_section_rows' && $line =~ /,/) {
            my @f = split /,/, $line, -1;
            if (@f == @section_columns) {
                my %row;
                for (my $i = 0; $i < @section_columns; $i++) {
                    $row{$section_columns[$i]} = $f[$i];
                }

                push @{ $out{read_sections}{$current_section}{rows} }, \%row;

                my $surface = $row{Surface} // '';
                $out{read_sections}{$current_section}{by_surface}{$surface} = \%row
                    if $surface ne '';

                next;
            }
        }

        # footer lines like Extracted: 518
        if ($line =~ /^([^:]+):\s*(.+)$/) {
            my ($k, $v) = ($1, $2);
            $out{footer}{$k} = parse_interop_number_or_text($v);
            next;
        }
    }

    close $fh;

    # derived values
    if (exists $out{totals}{Total}) {
        $out{derived}{total_yield_gb} = $out{totals}{Total}{yield_gb};
        $out{derived}{total_pct_q30}  = $out{totals}{Total}{pct_q30};
    }
    if (exists $out{totals}{"Non-indexed"}) {
        $out{derived}{nonindexed_yield_gb} = $out{totals}{"Non-indexed"}{yield_gb};
        $out{derived}{nonindexed_pct_q30}  = $out{totals}{"Non-indexed"}{pct_q30};
    }
    if (exists $out{read_sections}{"Read 1"}{by_surface}{"-"}) {
        $out{derived}{cluster_density_mean} = $out{read_sections}{"Read 1"}{by_surface}{"-"}{Density};
        $out{derived}{cluster_pf_mean}      = $out{read_sections}{"Read 1"}{by_surface}{"-"}{"Cluster PF"};
        $out{derived}{read1_pct_q30}        = parse_interop_number($out{read_sections}{"Read 1"}{by_surface}{"-"}{"%>=Q30"});
    }
    if (exists $out{read_sections}{"Read 4"}{by_surface}{"-"}) {
        $out{derived}{read4_pct_q30}        = parse_interop_number($out{read_sections}{"Read 4"}{by_surface}{"-"}{"%>=Q30"});
    }

    return \%out;
}


sub parse_interop_index_summary_file {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my %out = (
        version => '',
        lanes   => {},
        derived => {},
    );

    open my $fh, "<", $file or do {
        log_message("WARNING: Could not open InterOp index summary file [$file]: $!");
        return {};
    };

    my $current_lane = '';
    my $mode = '';

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\r$//g;
        next if $line =~ /^\s*$/;

        if ($line =~ /^\#\s*Version:\s*(.+)$/) {
            $out{version} = $1;
            next;
        }

        if ($line =~ /^Lane\s+(\d+)$/) {
            $current_lane = $1;
            $out{lanes}{$current_lane} ||= {
                totals       => {},
                samples      => [],
                by_sample_id => {},
            };
            $mode = 'lane_header';
            next;
        }

        if ($mode eq 'lane_header' && $line =~ /^Total Reads,PF Reads,% Read Identified \(PF\),CV,Min,Max$/) {
            my $totals_line = <$fh>;
            last if !defined $totals_line;
            chomp $totals_line;
            $totals_line =~ s/\r$//g;

            my @f = split /,/, $totals_line, -1;
            if (@f == 6) {
                $out{lanes}{$current_lane}{totals} = {
                    total_reads            => parse_interop_number($f[0]),
                    pf_reads               => parse_interop_number($f[1]),
                    pct_read_identified_pf => parse_interop_number($f[2]),
                    cv                     => parse_interop_number($f[3]),
                    min                    => parse_interop_number($f[4]),
                    max                    => parse_interop_number($f[5]),
                };
            }
            $mode = 'samples_header_wait';
            next;
        }

        if ($mode eq 'samples_header_wait' && $line =~ /^Index Number,Sample Id,Project,Index 1 \(I7\),Index 2 \(I5\),% Read Identified \(PF\)$/) {
            $mode = 'sample_rows';
            next;
        }

        if ($mode eq 'sample_rows' && $line =~ /,/) {
            my @f = split /,/, $line, -1;
            next unless @f == 6;

            my %row = (
                index_number           => parse_interop_number($f[0]),
                sample_id              => $f[1],
                project                => $f[2],
                index1                 => $f[3],
                index2                 => $f[4],
                pct_read_identified_pf => parse_interop_number($f[5]),
            );

            push @{ $out{lanes}{$current_lane}{samples} }, \%row;
            $out{lanes}{$current_lane}{by_sample_id}{ $row{sample_id} } = \%row
                if defined $row{sample_id} && $row{sample_id} ne '';

            next;
        }
    }

    close $fh;

    my $lane_count = scalar keys %{ $out{lanes} };
    $out{derived}{lane_count} = $lane_count;

    my $n_indexed = 0;
    foreach my $lane (keys %{ $out{lanes} }) {
        $n_indexed += scalar @{ $out{lanes}{$lane}{samples} || [] };
    }
    $out{derived}{total_indexed_samples} = $n_indexed;

    return \%out;
}

sub parse_interop_number {
    my ($x) = @_;
    return undef if !defined $x;
    return undef if $x eq '';
    return undef if lc($x) eq 'nan';

    return $x + 0 if $x =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;

    return undef;
}

sub parse_interop_number_or_text {
    my ($x) = @_;
    return undef if !defined $x || $x eq '';
    my $n = parse_interop_number($x);
    return $n if defined $n;
    return $x;
}



