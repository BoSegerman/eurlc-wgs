## runstep select_main_assembly

$runstep_name = "select_main_assembly";

$runstep{$runstep_name} = {
      message    => "Selecting main assembly...",
      long_name  => "Selecting main assembly",
      output_dir => "__DIR-ASSEMBLIES__",
      resultfile => "__DIR-ASSEMBLIES__/__BASE__.fasta",
      resultfiles_status => "NA",
};


# TEMPLATES---------------------------------


$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    cp '__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta' '__DIR-ASSEMBLIES__/__BASE__.fasta'
CMD



# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_select_main_assembly;

sub test_select_main_assembly {

   return 2;

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_select_main_assembly;

sub preprocess_select_main_assembly {

    my ($samplenr) = @_;

    my $runstep_name = "select_main_assembly";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template};    
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

    my $main_assembler = "";
    my $reason = "";
    



    
    my $criteria = $R_cfg->{general}{main_assembly} // "";
    
    if($sample_type eq "FASTA"){       $main_assembler = "imported";   $reason = "rawdata was an assembly";   }
    elsif($criteria eq "spades"){  $main_assembler = "spades"; $reason = "spades is selected as main assembler";  }
    elsif($criteria eq "shovill"){ $main_assembler = "shovill";  $reason = "shovill is selected as main assembler";  }
    elsif($criteria eq "skesa"){ $main_assembler = "skesa"; $reason = "skesa is selected as main assembler";   }
    elsif($criteria eq "unicycler"){  $main_assembler = "unicycler"; $reason = "unicycler is selected as main assembler"; }
    elsif($criteria eq "fewest_contigs"){  $main_assembler = get_best_assembler($samplenr,"lowest","nr_contigs"); $reason = "assembly with fewest contigs"; }
    elsif($criteria eq "fewest_contigs500"){  $main_assembler = get_best_assembler($samplenr,"lowest","nr_contigs_largerthan_500"); $reason = "assembly with fewest contigs larger than 500";  }
    elsif($criteria eq "best_N50"){  $main_assembler = get_best_assembler($samplenr,"highest","n50"); $reason = "assembly with highest N50 value"; }
    else{ $main_assembler = get_best_assembler($samplenr,"lowest","nr_contigs"); $reason = "Criteria is missing- using assembly with fewest contigs"; }

    
    if (!defined $main_assembler || $main_assembler eq "") {
      log_message("ERROR: No suitable main assembler could be selected for sample $sample_name","red");
       return "";
    }
    my $sourcefile = "__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta";
    $sourcefile =~ s/__ASSEMBLER__/$main_assembler/g;
    $sourcefile = fill_placeholders($sourcefile, $samplenr, $runstep_name);

    if (!-f $sourcefile) {
        log_message("ERROR: Selected main assembly file does not exist for sample $sample_name: $sourcefile","red");
        return "";
    }
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
          

     # runstep specific replacements
    
    _fill_placeholders__safe_replace(\$command, "__ASSEMBLER__", $main_assembler);
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 
 


    $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_assembler} = $main_assembler;
    $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_reason}    = $reason;
 
 
    if(-f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_select_main_assembly($samplenr);
        return "";
    }  
       
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_select_main_assembly;

sub postprocess_select_main_assembly {
    my ($samplenr) = @_;

    my $runstep_name = "select_main_assembly";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);  

    my $main_assembler =
       $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_assembler}
    // $R_samples->[$samplenr]{main_results}{assembly}{method}
    // "n/a";

    my $reason =
       $R_samples->[$samplenr]{results}{$runstep_name}{main_assembly_reason}
    // $R_samples->[$samplenr]{main_results}{assembly}{method_reason}
    // "n/a";
    
    log_message("NOTICE: Main assembly selected: $main_assembler [$reason]","green");

    my $assemblystats = analyze_assembly_stats($resultfile);
    

    $R_samples->[$samplenr]{results}{$runstep_name}{stats} = $assemblystats;

    my $len        = $assemblystats->{total_length}               // "n/a";
    my $contigs    = $assemblystats->{nr_contigs}                // "n/a";
    my $contigs500 = $assemblystats->{nr_contigs_largerthan_500} // "n/a";
    my $n50        = $assemblystats->{n50}                       // "n/a";
    my $gc         = $assemblystats->{gc_content}                // "n/a";
    my $cov        = $assemblystats->{total_coverage}            // 0;
        
    log_message("NOTICE: Total length: $len", "green");
    log_message("NOTICE: Contigs: $contigs", "green");
    log_message("NOTICE: Contigs (500+): $contigs500", "green");
    log_message("NOTICE: N50: $n50", "green");    
    log_message("NOTICE: gc_content: $gc", "green");
    if($assemblystats->{total_coverage}>0){  log_message("NOTICE: Total coverage: $cov", "green"); }
    
    $R_samples->[$samplenr]{main_results}{assembly}{size} = $len;
    $R_samples->[$samplenr]{main_results}{assembly}{contigs} = $contigs;
    $R_samples->[$samplenr]{main_results}{assembly}{contigs_500} = $contigs500;    
    $R_samples->[$samplenr]{main_results}{assembly}{N50} = $n50;
    $R_samples->[$samplenr]{main_results}{assembly}{gc} = $gc;    
    $R_samples->[$samplenr]{main_results}{assembly}{kmer_cov} = $cov;        
    $R_samples->[$samplenr]{main_results}{assembly}{size} = $len;
    $R_samples->[$samplenr]{main_results}{assembly}{method} = $main_assembler;
    $R_samples->[$samplenr]{main_results}{assembly}{method_reason} = $reason;
    
    return 1; # success
}


 sub get_best_assembler {
    my ($samplenr, $direction, $metric) = @_;

    my @assemblers = qw(spades shovill skesa unicycler imported);

    my $best_assembler = "";
    my $best_value;

    foreach my $assembler (@assemblers) {

        my $value = $R_samples->[$samplenr]{results}{$assembler}{$metric};

        next if !defined $value;
        next if $value eq "";
        next if $value !~ /^-?\d+(?:\.\d+)?$/;

        if ($best_assembler eq "") {
            $best_assembler = $assembler;
            $best_value     = $value;
            next;
        }

        if ($direction eq "lowest"  && $value < $best_value) {
            $best_assembler = $assembler;
            $best_value     = $value;
        }
        elsif ($direction eq "highest" && $value > $best_value) {
            $best_assembler = $assembler;
            $best_value     = $value;
        }
    }

    return $best_assembler;
}

    
   
