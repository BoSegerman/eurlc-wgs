###################################################################################################
## parse arguments

#------------------------------------
# Allow "param value" (space-separated) as an alternative to "param=value"
# for the few arguments that expect a path (datadir, database, configfile).
# "param=value" breaks bash filename tab-completion in many environments
# (nothing to complete after the "="), while "param value" doesn't. This
# rewrites @ARGV into the existing "param=value" form right here, so
# everything below (the %args parser, premount handlers, etc.) only ever
# sees the one form it already understands -- it has no idea this
# alternate syntax exists. Existing "param=value" usage is untouched: the
# regex only matches a bare token with no "=" already attached.
{
    my %path_taking_arg = map { lc($_) => 1 } qw(datadir database configfile);
    my @rewritten;
    my $i = 0;
    while ($i < @ARGV) {
        my $arg = $ARGV[$i];
        if ($arg =~ /^(?:--?)?([^=\s]+)$/ && $path_taking_arg{lc($1)}) {
            my $name = $1;
            my $next = $ARGV[$i+1];

            # Only consume the next token as this argument's value if it
            # exists AND doesn't itself look like a separate argument (a
            # "key=value" pair, another flag starting with "-", or another
            # known path-taking argument name). Without this check, a
            # forgotten value -- e.g. "configfile overwrite=no", meaning
            # configfile's value was left out by mistake -- would silently
            # swallow the next, unrelated argument as if it were configfile's
            # path, both garbling configfile's value AND losing the
            # overwrite=no argument entirely. The same applies to two
            # forgotten path values in a row, e.g. "database datadir" --
            # without excluding known argument names too, this would become
            # "database=datadir", and silently succeed with the wrong
            # database directory if a subfolder named "datadir" happens to
            # exist, rather than failing clearly. A real path practically
            # never contains "=", starts with "-", or is exactly one of
            # these reserved names, so this is a safe heuristic for the
            # common case; a path that genuinely needs one of those forms
            # still works fine with the explicit "param=value" syntax.
            my $next_bare = defined $next ? ($next =~ /^(?:--?)?([^=\s]+)$/ ? lc($1) : undef) : undef;

            if ( defined $next
                 && $next !~ /=/
                 && $next !~ /^-/
                 && !( defined $next_bare && $path_taking_arg{$next_bare} ) ) {
                push @rewritten, "$name=$next";
                $i += 2;
                next;
            }

            print "ERROR: Argument '$name' requires a value, e.g. $name=/some/path or $name /some/path -- none was given.\n";
            if (defined $next) {
                print "(the next word, '$next', looks like its own separate argument, so it was not used as ${name}'s value)\n";
            }
            exit 1;
        }
        else {
            push @rewritten, $arg;
            $i += 1;
        }
    }
    @ARGV = @rewritten;
}

#------------------------------------
# Parse arguments into a hash
my %args;
my %args_handled;

foreach my $arg (@ARGV) {
    if ($arg =~ /^(?:--?)?([^=]+)=(.*)$/) {
        # key=value form
        my ($name, $value) = (lc $1, $2);
        $args{$name} = $value;
        $args_handled{$name} = 0;
    }
    elsif ($arg =~ /^(?:--?)?(.+)$/) {
        # flag form
        my $name = lc $1;
        $args{$name} = "";  # store empty string for flags
        $args_handled{$name} = 0;
    }
}


###################################################################################################
## pre-mount argument handling
##
## "Mount" here is a holdover name from when this pipeline's default deployment
## was a Docker container, where the data directory ("in") and database
## directory ("db") had to be bind-mounted into the container at startup --
## neither was guaranteed to exist (or even be the right path) until the
## container actually started. Running outside Docker (conda mode) relaxes
## that strictly, but the same underlying principle still applies and is worth
## keeping: a handler registered here may run before "in"/"db" are known to
## exist, valid, or even correctly configured.
##
## So: every handler in %premountcheckhandlers below must be safe to call
## without assuming "in"/"db" exist. In practice each one does this by either
## (a) not needing those directories at all (help, version), or (b) being the
## very thing that sets/creates/validates them itself (database, datadir,
## configfile). If you add a new premount handler, ask: "does this need a
## working data or database directory to do its job?" -- if yes, it belongs
## in %postmountcheckhandlers / %postmountcheckhandlerswithArgs below instead,
## not here.
##
## The "## mount-check" section right after the dispatch loop below is what
## actually verifies (or, in conda mode, offers to create) "in"/"db". Anything
## registered in %postmountcheckhandlers/%postmountcheckhandlerswithArgs (further
## down) runs after that check, and can safely assume both directories exist.

#------------------------------------
# Define pre-mount-check handlers
my %premountcheckhandlers = (
help => sub {

    my $help_file = peekdir("conda") . "/share/eurlc-wgs/help.txt";
    my $help_text;

    if (-f $help_file) {
        if (open my $fh, '<', $help_file) {
            local $/;
            $help_text = <$fh>;
            close $fh;

            if (!defined $help_text || $help_text !~ /\S/) {
                log_message(
                    "WARNING: Help file [$help_file] is empty; using built-in help",
                    "yellow"
                );
                $help_text = undef;
            }
        }
        else {
            log_message(
                "WARNING: Could not open help file [$help_file]: $! -- using built-in help",
                "yellow"
            );
        }
    }
    else {
        log_message(
            "WARNING: Help file not found [$help_file] -- using built-in help",
            "yellow"
        );
    }

    # -------------------------------------------------------------------------
    # Fallback built-in help (used if help.txt above is missing, unreadable, or
    # empty). Kept in sync with the actual argument syntax (see %args parsing
    # and the premount/postmount handler hashes above) -- every flag/example
    # below must actually work, not just look plausible.
    # -------------------------------------------------------------------------

    $help_text //= <<'HELP';

EURLC-WGS
Whole genome sequencing analysis pipeline

USAGE:
    navigate to the directory with the input files
    eurlc-wgs [options]

COMMON OPTIONS:
    --help                      Show this help
    --version                   Show pipeline and tool versions, then exit
    configfile=<name|path>      Use a specific config file. Special values:
                                   default  use built-in defaults, ignore any config file
                                   write    write a default config file and exit
    database=<dir>               Use a specific database directory
    datadir=<dir>                Use a specific input data directory
    threads=<n>                  Number of threads
    --overwrite                  Overwrite existing results
    --recursive                  Scan directories recursively for input files
    --verbose                    Verbose output
    --no-color / --color         Force-disable / force-enable colored output
    <section>.<param>=<value>    Override any single config value directly,
                                e.g. fastp.arguments="--length_required 50"

INPUT:
    Input may contain:
      - paired FASTQ files
      - single-end FASTQ files
      - FASTA assemblies

EXAMPLE:
    eurlc-wgs threads=8

OUTPUT:
    Results are written to:
        eurlc-wgs/

For full documentation, ensure that:
    share/eurlc-wgs/help.txt

is installed correctly.

HELP

    print $help_text;
    close_logfile();
    exit 0;
},
    version => sub {
        log_message("NOTICE: Versions listing requested - no samples will be processed.");
        log_message("NOTICE: Extracting versioning info.");
        my $softwareversions = log_tool_versions("all","");
    
        print "\n\nPipeline name: $rundata{pipeline_info}{name}\n",
              "Pipeline version: $rundata{pipeline_info}{version}\n",
              "Pipeline version date: $rundata{pipeline_info}{versiondate}\n",
              "Software versions:\n\n$softwareversions\n";
        close_logfile();
        exit 0;
    },
    configfile => sub {
        my ($configfile_value) = @_;

        my $S_dbdir = peekdir("db");
        
        #------------------------ default ----------------- - stick with default values
        if (lc($configfile_value) eq "default") {
           log_message("NOTICE: Default configuration requested"); 
           $rundata{config}{path}     = "";  #clear configfile path 
           $rundata{config}{filename} = "";
           return;
        }
        #------------------------ write ----------------- - write a configfile with default values and exit
        if (lc($configfile_value) eq "write") {
        
           # db dir must exist - target dir
           unless (-d $S_dbdir) { 
           
              #in docker mode - we cannot create a db dir - if it does not exist we need to exit
              if(is_docker()){  
                  graceful_die("No database directory mounted at [$S_dbdir] -- cannot write a config file without a persistent database directory");
              }
           
              #in conda mode - prompt to create it
              unless ( prompt_and_create_dir($S_dbdir) ) {
                 graceful_die("Database directory [$S_dbdir] does not exist and could not be created -- cannot write config file");
              }
              
           } #end unless db (db dir must exist - target dir)
        
           #now we know that the db directory exists!
           
           my $written = writedefaultconfigfile();
           unless ($written) {
              graceful_die("Failed to create configfile");
           }
           log_message("NOTICE: Configfile written. Done!");
           close_logfile();
           exit 0;
        }  # end configfile=write
        
        #---------------------------
        # assuming format is configfile=path/filename
        
        # -----------------------------
        # Docker mode: strict rules
        # -----------------------------
        if (is_docker()) {

            unless (-d $S_dbdir) {
                graceful_die(
                    "A config file name was provided, but no database directory is mounted. " .
                    "In docker mode, the config file must reside inside the database directory."
                );
            }

            my $candidate = File::Spec->catfile($S_dbdir, $configfile_value);

            if (-f $candidate) {
                $rundata{config}{path}     = abs_path($candidate);
                $rundata{config}{filename} = basename($candidate);
                log_message("NOTICE: Using config file from database directory: [$rundata{config}{filename}]");
                return;
            }

            graceful_die("Config file [$configfile_value] not found in database directory [$S_dbdir]");
        }

        # -----------------------------
        # Conda / native mode
        # -----------------------------
        my $path;

        # Absolute path
        if ($configfile_value =~ m{^/}) {
            $path = $configfile_value;
        }
        # Home-relative path (~)
        elsif ($configfile_value =~ m{^~}) {
            $path = File::Spec->rel2abs( $configfile_value );
        }
        else {
            # Bare filename or relative path: try the database directory
            # first (the conventional shared location), then fall back to
            # resolving relative to the current working directory.
            if (-d $S_dbdir) {
                my $candidate = File::Spec->catfile($S_dbdir, $configfile_value);
                $path = $candidate if -f $candidate;
            }
            if (!$path) {
                my $candidate = File::Spec->rel2abs($configfile_value);
                $path = $candidate if -f $candidate;
            }
        }

        if ($path && -f $path) {
            $rundata{config}{path}     = abs_path($path);
            $rundata{config}{filename} = basename($path);
            log_message("NOTICE: Custom configuration file specified: [$rundata{config}{path}]");
            return;
        }

        # -----------------------------
        # Failure
        # -----------------------------
        graceful_die("Custom configuration file not found or invalid: [$configfile_value]");
    },
    database => sub {
    my $arg_db = shift;

    # Resolve to an absolute path before storing, regardless of whether the
    # user gave a relative or absolute one. Several tools' install_db
    # commands do their own "cd __DB__/...;" *inside* a command string that
    # wrap_cmd() has already prefixed with "cd '$indir';" -- a relative db
    # path would then resolve relative to $indir instead of where the user
    # actually meant, silently pointing at the wrong location.
    my $resolved_db = File::Spec->rel2abs($arg_db);

    if (!-d $resolved_db) {
        graceful_die("Custom database directory [$arg_db] does not exist or is not mounted");
    }

    setdir("db", abs_path($resolved_db));
    log_message("NOTICE: Using custom database directory: [" . peekdir("db") . "]");
    },
    datadir => sub {
    my $arg_datadir = shift;

    # Same reasoning as database= above -- resolve to absolute up front so
    # it can never depend on the current working directory at the point
    # some later command happens to use it.
    my $resolved_datadir = File::Spec->rel2abs($arg_datadir);

    if (!-d $resolved_datadir) {
        graceful_die("Custom in-data directory [$arg_datadir] does not exist or is not mounted");
    }

    setdir("in", abs_path($resolved_datadir));
    log_message("NOTICE: Using custom in-data directory: [" . peekdir("in") . "]");
  },
    archivedir => sub {
    my $arg_archivedir = shift;

    # Same path-resolution reasoning as database=/datadir= above. Unlike
    # those two, this directory is allowed not to exist yet -- it's fine,
    # and expected, to create it on demand (see the mount-check handling
    # below), the same way the database directory itself can be.
    my $resolved_archivedir = File::Spec->rel2abs($arg_archivedir);

    setdir("archive", $resolved_archivedir);
    log_message("NOTICE: Using custom archive directory: [" . peekdir("archive") . "]");
  },


);

#------------------------------------
# Run handlers for matching args. Any key in %args that matches a key here
# is marked handled and dispatched, regardless of whether a value was given
# (unlike the postmount dispatch below, which distinguishes "flag with no
# value" from "flag=value" -- premount handlers always receive whatever
# value was parsed, including "" for a bare flag, and decide for themselves
# what to do with it; see e.g. configfile's "default"/"write"/path handling).
foreach my $key (keys %args) {
    if (exists $premountcheckhandlers{$key}) {
        my $value = $args{$key};
        if (defined $value) {
         $args_handled{$key} = 1;
         $premountcheckhandlers{$key}->($value);
        }
    }

}


###################################################################################################
## mount-check
##
## This is the boundary the comment above %premountcheckhandlers refers to:
## everything above this point must tolerate "in"/"db" not existing yet;
## everything below (postmount handlers, config file loading, and the rest of
## the pipeline) is entitled to assume both are real, valid directories by the
## time this section finishes -- it either verifies them (docker mode: fatal
## if not mounted) or verifies-and-offers-to-create them (conda mode).

#----------- No indir (docker mode) --------------
if( ( is_docker() ) && ! -d peekdir("in")){
   graceful_die("The data directory must be mounted on the container as '/data' when it's started. Run the container with the '--help' argument for more info.");
}

#----------- No indir (conda mode) --------------
if( ( is_conda() ) && ! -d peekdir("in")){
   graceful_die("The data directory is not a directory [datadir='" . peekdir("in") . "']");
}

###################################################################################################
## announce the resolved input directory, prominently and early -- before any
## heavy setup work (conda env checks, database downloads) begins. This is
## the main safety net for someone who ran the pipeline by accident (or in
## the wrong directory): they see immediately where it's about to operate,
## while there's still time to cancel before anything expensive happens.
log_message("NOTICE: Input directory: " . peekdir("in") );
log_message("NOTICE: Press Ctrl+C now to cancel if this is not what you intended." );

#----------- No dbdir (docker mode) --------------
if(  ( is_docker() ) && ! -d peekdir("db")){        
    log_message( "NOTICE: No database directoty is mounted - using internal databases" );  
    setdir("db", "/usr/src/app/db");

    unless ( -d peekdir("db") ) {
        graceful_die("Internal fallback database directory [" . peekdir("db") . "] does not exist either -- the docker image may be built incorrectly");
    }
}

#----------- No dbdir (conda mode) --------------
if(  ( is_conda() ) && ! -d peekdir("db")){        
    log_message( "WARNING: Database directoty is missing or not a directory [databasedir=" . peekdir("db") . "]", "red" );   

    unless ( prompt_and_create_dir(peekdir("db")) ) {
       graceful_die("Database directory [" . peekdir("db") . "] does not exist and could not be created");
    }
}

###################################################################################################
## load config file
## (overrides defaults)



if (-f $rundata{config}{path}) {
    log_message("INFO: Loading settings from config file: [$rundata{config}{path}]");

    my $cfg = read_ini_file($rundata{config}{path});
    $rundata{config}{configfile} = $cfg;
    
    if ($cfg && %$cfg) {
        foreach my $section (keys %$cfg) {
            if ($section =~ /^chewbbaca_schema_(.+)$/i) {
                # The schema's name comes from the SECTION TITLE itself
                # (writedefaultconfigfile() writes "[chewbbaca_schema_<name>]"),
                # not from a "name=" key inside the section -- there isn't one.
                my $name = $1;

                # Merge into an existing (possibly differently-cased) entry if
                # one matches, rather than creating a separate duplicate that
                # other code looking this schema up by name might not find.
                my $target_key = $name;
                for my $existing_key (keys %$R_cfg_schemas) {
                    if (lc($existing_key) eq lc($name)) {
                        $target_key = $existing_key;
                        last;
                    }
                }

                # Read every field present in the section generically (not a
                # fixed list) -- so e.g. "enabled" (previously not read at
                # all) and any future field are picked up automatically.
                foreach my $param (keys %{ $cfg->{$section} }) {
                    my $value = $cfg->{$section}{$param};
                    if (is_known_boolean_field("chewbbaca_schemas", $param)) {
                        my $normalized = normalize_boolean_value($value);
                        if (defined $normalized) {
                            $value = $normalized;
                        }
                        else {
                            log_message("WARNING: [$section:$param] value [$value] is not a recognized yes/no/true/false/1/0", "red");
                        }
                    }
                    $R_cfg_schemas->{$target_key}{$param} = $value;
                }
            }
            elsif ($section =~ /^species__(.+)$/i) {
                # Same reasoning as chewbbaca_schema above: the species name
                # comes from the section title ("[species__<name>]"), and
                # generic field reading picks up filter, crossreactive_species,
                # and every warning_*/critical_*/fail_* QC threshold key --
                # all previously silently dropped by a fixed field list.
                my $name = $1;

                my $target_key = $name;
                for my $existing_key (keys %$R_cfg_species) {
                    # Same normalization as get_config_value_for_species():
                    # underscores <-> spaces, case-insensitive -- so e.g.
                    # "Campylobacter_jejuni" and "campylobacter jejuni" both
                    # correctly match the existing "Campylobacter jejuni" key.
                    (my $norm_existing = $existing_key) =~ s/_/ /g;
                    (my $norm_new      = $name)         =~ s/_/ /g;
                    if (lc($norm_existing) eq lc($norm_new)) {
                        $target_key = $existing_key;
                        last;
                    }
                }

                foreach my $param (keys %{ $cfg->{$section} }) {
                    my $value = $cfg->{$section}{$param};
                    if (is_known_boolean_field("species", $param)) {
                        my $normalized = normalize_boolean_value($value);
                        if (defined $normalized) {
                            $value = $normalized;
                        }
                        else {
                            log_message("WARNING: [$section:$param] value [$value] is not a recognized yes/no/true/false/1/0", "red");
                        }
                    }
                    $R_cfg_species->{$target_key}{$param} = $value;
                }
            }
            elsif ($section =~ /^chewbbaca_schema/i || $section =~ /^species/i) {
                # Looks like it was meant to be one of the two special
                # section types above, but doesn't match the expected
                # "<type>_<name>" / "<type>__<name>" pattern -- most likely a
                # missing name or a typo in the underscore count. Flag it
                # rather than silently treating it as an unrecognized tool
                # section (which it isn't).
                log_message("WARNING: [$section] looks like a chewbbaca_schema/species section but is missing its embedded name (expected [chewbbaca_schema_<name>] or [species__<name>]) -- ignoring", "red");
            }
            else {
                foreach my $param (keys %{ $cfg->{$section} }) {
                    my $value = $cfg->{$section}{$param};

                    if (is_known_boolean_field($section, $param)) {
                        my $normalized = normalize_boolean_value($value);
                        if (defined $normalized) {
                            $value = $normalized;
                        }
                        else {
                            log_message("WARNING: [$section:$param] value [$value] is not a recognized yes/no/true/false/1/0 -- leaving the previous value in place", "red");
                            next;
                        }
                    }

                    if (exists $R_cfg->{$section}{$param} ){
                      if ($R_cfg->{$section}{$param} ne $value) {
                          $R_cfg->{$section}{$param} = $value;
                          log_message("INFO: [$section] overriding default: [$param=$value]");
                      }
                    }else{
                       log_message("WARNING: [$section:$param] Attempt to override a non-existing or deprecated config parameter: [$param=$value] -- check for a typo in the parameter or section name", "red");
                    }  
                }
            }
        }
        
        $rundata{config}{source} = "[$rundata{config}{path}]"; 
    }
    else {
        log_message("WARNING: Could not parse config file [$rundata{config}{path}]. Using built-in defaults.");
    }
}

log_message("NOTICE: Configuration source: $rundata{config}{source}");

###################################################################################################
## load settings from user arguments
## (overrides all other settings)
##
## Past the mount-check above, "in"/"db" are known good, and the config file
## (loaded just above this point) has already been merged into $R_cfg -- so,
## unlike the premount handlers earlier, anything registered below is free to
## assume both directories exist and that $R_cfg reflects defaults+config file.
##
## Split into two hashes by whether the flag takes a value:
##   %postmountcheckhandlers          - bare flags, e.g. --recursive (value eq "")
##   %postmountcheckhandlerswithArgs  - flags requiring a value, e.g. --removetool=kraken2
## A handler can still be a deliberate no-op (e.g. 'no-color' below) purely to
## mark that key as handled -- needed for any flag that's already acted on
## elsewhere (typically earlier, before %args even exists, like the color and
## docker-runmode checks near the top of the script) but would otherwise be
## reported as an unknown argument by the final completeness check.

# Define post-mount-check handlers
my %postmountcheckhandlers = (
    recursive => sub {
        $R_cfg->{general}{"recursive"} = 1;  
        log_message("NOTICE: Overriding from launch-arguments:recursive=1");
        $rundata{config}{overrides} .= "recursive=1\n";
    },
    verbose => sub {
        $R_cfg->{general}{"verbose"} = 1; 
        log_message("NOTICE: Overriding from launch-arguments:verbose=1");
        $rundata{config}{overrides} .= "verbose=1\n";
    },
    overwrite => sub {
        $R_cfg->{general}{"overwrite"} = "yes"; 
        log_message("NOTICE: Overriding from launch-arguments:overwrite=yes");
        $rundata{config}{overrides} .= "overwrite=yes\n";
    },
    # The three below are intentional no-ops: each flag is already acted on
    # elsewhere (see the early color/runmode checks near the top of the
    # script, and the non-interactive/assume-yes GUI-mode plumbing). Registering
    # them here only marks them "handled" so the final completeness check
    # doesn't report them as unknown arguments.
    'non-interactive' => sub {

    },    
    'assume-yes' => sub {

    },      
    'no-color' => sub {

    },          
    # summarize/summarise is intentionally NOT registered here -- it needs to
    # run strictly after every other postmount argument (section.param=value
    # and general key=value overrides included) has already been applied to
    # $R_cfg, since it re-applies current thresholds before rebuilding the
    # report. This loop's "foreach my $key (keys %args)" iterates in Perl's
    # unordered hash order, so registering it here would make e.g.
    # "summarize species.warning_assembly_size=..." behave unpredictably
    # depending on which key happened to be processed first. See the
    # explicit, ordered check right after this loop instead.
#    launchers => sub {
#        system (fill_placeholders("cp __DIR-PROGRAM__/launchers.zip __DIR-IN__"));
#        print "Copied a zip file with launchers into the data directory\n",
#              "check the manual for more info\n";
#        exit 0;
#    },
#    manual => sub {
#        system (fill_placeholders("cp __DIR-PROGRAM__/eurlc_wgs_manual.pdf __DIR-IN__"));
#        print "Copied a manual file (eurlc_wgs_manual.pdf) into the data directory\n";
#        exit 0;
#    },

);

# Shared validation for the manual tool-management commands below
# (removetool/installtool/reinstalltool/infotool): confirms $toolname is a
# real tool section -- not one of the non-tool top-level sections like
# general/species/chewbbaca_schemas -- with a real, named conda environment,
# and refuses to ever resolve to "base". Removing or reinstalling "base"
# would break conda itself system-wide, not just one tool (e.g. md5's env is
# literally "base", since it has no dedicated environment of its own).
# Returns the env name, or calls graceful_die with a clear explanation.
sub resolve_tool_env {
    my ($toolname) = @_;

    if ($toolname eq 'general' || $toolname eq 'species' || $toolname eq 'chewbbaca_schemas') {
        graceful_die("[$toolname] is not a tool, it's a configuration section -- nothing to do");
    }

    unless (exists $R_cfg->{$toolname} && ref($R_cfg->{$toolname}) eq 'HASH') {
        graceful_die("Unknown tool [$toolname]");
    }

    my $env_name = $R_cfg->{$toolname}{env} // "";

    if ($env_name eq "") {
        graceful_die("Tool [$toolname] has no environment configured -- nothing to do");
    }

    if ($env_name eq "base") {
        graceful_die("Tool [$toolname] is configured to run in the 'base' conda environment -- refusing to remove or reinstall 'base', that would break conda itself");
    }

    return $env_name;
}

my %postmountcheckhandlerswithArgs = (
   removetool => sub {
        my ($toolname) = @_;
        my $env_name = resolve_tool_env($toolname);

        log_message("NOTICE: Removing conda environment [$env_name] for tool [$toolname]...");

        my $cmd = "conda remove -n $env_name --all -y";
        system($cmd);
        my $exit_code = $? >> 8;

        if ($exit_code == 0) {
            log_message("NOTICE: Environment [$env_name] was removed successfully.", "green");
            close_logfile();
            exit 0;
        }
        else {
            graceful_die("Failed to remove environment [$env_name] (exit code: $exit_code)");
        }
   },
   installtool => sub {
        my ($toolname) = @_;
        resolve_tool_env($toolname);   # validate only -- ensure_conda_tool resolves the env itself

        log_message("NOTICE: Installing/repairing tool [$toolname] (creates if missing, repairs if broken or mismatched)...");

        if ( ensure_conda_tool($toolname, 1) ) {
            log_message("NOTICE: Tool [$toolname] is installed and healthy.", "green");
            close_logfile();
            exit 0;
        }
        else {
            graceful_die("Failed to install/repair tool [$toolname]");
        }
   },
   reinstalltool => sub {
        my ($toolname) = @_;
        resolve_tool_env($toolname);

        log_message("NOTICE: Reinstalling tool [$toolname] (remove + recreate from scratch)...");

        if ( reinstall_conda_tool($toolname) ) {
            log_message("NOTICE: Tool [$toolname] was reinstalled successfully.", "green");
            close_logfile();
            exit 0;
        }
        else {
            graceful_die("Failed to reinstall tool [$toolname]");
        }
   },
   infotool => sub {
        my ($toolname) = @_;
        my $env_name = resolve_tool_env($toolname);
        my $cfg = $R_cfg->{$toolname};

        my $env_exists = conda_env_exists($env_name) ? "yes" : "no";

        print "\n";
        print "Tool:               $toolname\n";
        print "Environment:        $env_name\n";
        print "Environment exists: $env_exists\n";
        print "Package name:       " . ($cfg->{package_name} // $toolname) . "\n";
        print "Enabled:            " . (defined $cfg->{enabled} ? $cfg->{enabled} : "n/a") . "\n";
        print "Required:           " . (defined $cfg->{required} ? $cfg->{required} : "n/a") . "\n";
        print "Version check:      " . ($cfg->{version_check} // "n/a") . "\n";
        print "YAML file:          " . ($cfg->{yml} // "n/a") . "\n";

        if ($env_exists eq "yes") {
            my $explicit_text = qx(conda list --explicit -n $env_name 2>/dev/null);
            my $version = parse_conda_explicit_version($cfg->{package_name} // $toolname, $explicit_text);
            print "Installed version:  $version\n";
        }
        print "\n";

        close_logfile();
        exit 0;
   },

);


    
#------------------------------------
# Run handlers/set config values for matching args, in priority order:
#   1a. Bare flag matching %postmountcheckhandlers       (e.g. --recursive)
#   1b. Flag=value matching %postmountcheckhandlerswithArgs (e.g. --removetool=kraken2)
#   2.  Dotted key "section.param=value" -> directly overrides $R_cfg->{section}{param},
#       for any existing config section (e.g. --fastp.arguments="...")
#   3.  Bare "key=value" -> falls back to $R_cfg->{general}{key}, if that key
#       already exists in the general section (e.g. --threads=8)
# Anything matching none of these stays at $args_handled{$key}==0 and is
# reported as an unknown argument by the completeness check further below
# (unless explicitly exempted -- see %early_handled_args there).
foreach my $key (keys %args) {

 
    my $value = $args{$key};

    # Case 1a: special handler
    if (exists $postmountcheckhandlers{$key} && $value eq "" ) {
        $args_handled{$key} = 1;
        $postmountcheckhandlers{$key}->($value);
        next;
    }
    # Case 1b: special handler
    if (exists $postmountcheckhandlerswithArgs{$key} && $value ne "" ) {
        $args_handled{$key} = 1;
        $postmountcheckhandlerswithArgs{$key}->($value);
        next;
    }
    # Case 2: dotted key -> section.param
    if ($key =~ /^([^\.]+)\.(.+)$/) {
        my ($section, $param) = ($1, $2);

        if (exists $R_cfg->{$section} && exists $R_cfg->{$section}{$param}) {
            my $apply_value = $value;

            if (is_known_boolean_field($section, $param)) {
                my $normalized = normalize_boolean_value($value);
                if (defined $normalized) {
                    $apply_value = $normalized;
                }
                else {
                    graceful_die("Argument [$key=$value]: not a recognized yes/no/true/false/1/0 value");
                }
            }

            $R_cfg->{$section}{$param} = $apply_value;
            $args_handled{$key} = 1;
            log_message("NOTICE: Overriding from launch-arguments: $section.$param=$apply_value");
            $rundata{config}{overrides} .= "$section.$param=$apply_value\n";
        }
        elsif (exists $R_cfg->{$section}) {
            # Section exists but this exact parameter doesn't -- most likely
            # a typo. This single-level "section.param" syntax also can't
            # reach into per-species/per-schema settings (those need
            # "section.name.param", two levels deep) -- a species/schema
            # override attempted this way will always land here too, since
            # the combined "name.param" string never matches a real key; use
            # a config file for those instead (see the species__/
            # chewbbaca_schema_ section-loading logic above).
            log_message("WARNING: [$section.$param] does not match an existing config parameter -- check for a typo in the parameter name, or use a config file for per-species/per-schema overrides", "red");
        }
        next;
    }

    # Case 3: general section (default)
    if (exists $R_cfg->{general}{$key}) {
        my $apply_value = $value;

        if (is_known_boolean_field("general", $key)) {
            my $normalized = normalize_boolean_value($value);
            if (defined $normalized) {
                $apply_value = $normalized;
            }
            else {
                graceful_die("Argument [$key=$value]: not a recognized yes/no/true/false/1/0 value");
            }
        }

        $R_cfg->{general}{$key} = $apply_value;
        $args_handled{$key} = 1;
        log_message("NOTICE: Overriding from launch-arguments: general.$key=$apply_value");
        $rundata{config}{overrides} .= "general.$key=$apply_value\n";
        next;
    }
}

###################################################################################################
## --fastq / --fasta: restrict which input types get analyzed. Handled here,
## as a combined decision, rather than as two independent bare-flag handlers
## in the dispatch loop above -- two independent handlers couldn't correctly
## express "exactly one given -> restrict to that one, but both given ->
## analyze both", since the loop processes keys in Perl's unordered hash
## order. Only reacts to the bare-flag form (no "="); an explicit
## fastq=no/fasta=yes value-form override is handled separately, normally,
## by the general key=value fallback (Case 3) above, since general.fastq/
## general.fasta are real config fields like any other.
{
    my $fastq_bare_flag = (exists $args{"fastq"} && $args{"fastq"} eq "");
    my $fasta_bare_flag = (exists $args{"fasta"} && $args{"fasta"} eq "");

    if ($fastq_bare_flag || $fasta_bare_flag) {
        $args_handled{"fastq"} = 1 if $fastq_bare_flag;
        $args_handled{"fasta"} = 1 if $fasta_bare_flag;

        if ($fastq_bare_flag && !$fasta_bare_flag) {
            $R_cfg->{general}{fastq} = 1;
            $R_cfg->{general}{fasta} = 0;
            log_message("NOTICE: --fastq given without --fasta: restricting analysis to FASTQ input only");
        }
        elsif ($fasta_bare_flag && !$fastq_bare_flag) {
            $R_cfg->{general}{fasta} = 1;
            $R_cfg->{general}{fastq} = 0;
            log_message("NOTICE: --fasta given without --fastq: restricting analysis to FASTA input only");
        }
        else {
            # both given -- explicit, but same as the default
            $R_cfg->{general}{fastq} = 1;
            $R_cfg->{general}{fasta} = 1;
            log_message("NOTICE: Both --fastq and --fasta given: analyzing both input types");
        }
    }
}

###################################################################################################
## summarize/summarise: deliberately handled here, after the entire dispatch
## loop above, instead of inside it -- see the comment in %postmountcheckhandlers
## where it used to live. This guarantees every other override (including
## section.param=value threshold overrides) has already been applied to
## $R_cfg before thresholds are re-applied and the report is rebuilt. Both
## spellings are accepted and do exactly the same thing.
if ( exists $args{"summarize"} || exists $args{"summarise"} ) {
    $args_handled{"summarize"} = 1 if exists $args{"summarize"};
    $args_handled{"summarise"} = 1 if exists $args{"summarise"};

    my $rundata_file = peekdir("out,data") . "/rundata.json";
    %rundata = %{ load_hash_from_json($rundata_file) };

    $R_samples = $rundata{samples};   # RESET alias

    refresh_summary_derived_data();

    summarize_results();
    close_logfile();
    exit 0;
}


# Arguments handled by dedicated, early checks elsewhere (before %args/%args_handled
# even exists -- see the color and runmode detection blocks near the top of the
# script), rather than through the %postmountcheckhandlers* dispatch below. They
# still end up in %args_handled like any other argument, so they need an explicit
# exemption here, or this check would wrongly report them as unknown.
my %early_handled_args = (
    "docker"     => 1,   # runmode selection, checked directly against @ARGV
    "color"      => 1,   # force-enable colored output, checked directly against @ARGV
    "no-color"   => 1,   # force-disable colored output, checked directly against @ARGV
    "colour"     => 1,   # British spelling alias for "color"
    "no-colour"  => 1,   # British spelling alias for "no-color"
);

my @unknown_args;
foreach my $key (keys %args_handled) {
  my $value = $args_handled{$key};
  push @unknown_args, $key if $value==0 && !$early_handled_args{$key};
}

if (@unknown_args) {
  graceful_die(
      "Unknown argument" . (@unknown_args > 1 ? "s" : "") . " given: " .
      join(", ", sort @unknown_args)
  );
}

###################################################################################################
## extend (not replace) built-in file extension recognition from config, if provided.
## Built-in defaults above always remain available; config can only add extra
## patterns on top, so a misconfigured/missing config entry can never break
## detection of standard file naming conventions.
## NOTE: this must run here, after both the config file and command-line
## argument overrides above have been merged into $R_cfg_general -- running
## it any earlier (e.g. right after the defaults are set up) would only ever
## see the built-in defaults, since user-supplied extra_*_extensions values
## haven't been loaded yet at that point.
for my $pair (
    [ extra_fasta_extensions => \@constants_fasta_exts ],
    [ extra_r1_extensions    => \@constants_R1_extensions ],
    [ extra_r2_extensions    => \@constants_R2_extensions ],
    [ extra_fq_extensions    => \@constants_fq_extensions ],
) {
    my ($cfg_key, $array_ref) = @$pair;
    if ( ref($R_cfg_general->{$cfg_key}) eq 'ARRAY' ) {
        push @$array_ref, map { lc } @{ $R_cfg_general->{$cfg_key} };
        log_message("INFO: Added " . scalar(@{ $R_cfg_general->{$cfg_key} }) . " user-configured extension(s) from '$cfg_key'");
    }
}




###################################################################################################
## adjustments based on settings
##
## Some settings imply that a *different* setting must also have a specific
## value for the pipeline to actually do what was asked -- e.g. choosing a
## tool as the trimming method or as the main-assembly source doesn't by
## itself guarantee that tool's runstep is enabled. Rather than silently
## doing nothing (the tool's runstep gets skipped) or failing deep inside
## some later step with a confusing error, this section catches the
## inconsistency immediately and corrects it -- logging a NOTICE so it's
## visible, not silently overriding something without a trace.
##
## This is not meant to be a general validation pass: it only covers the
## specific known dependencies below. Add to it as new ones are discovered;
## don't assume every possible config inconsistency is caught here.

# --- trimming tool ---
if (lc($R_cfg->{general}->{trimming} // "") eq "fastp" && $R_cfg->{fastp}{enabled} != 1 ) {
    log_message("NOTICE: Adjusting parameter: fastp.enabled=1");
    $R_cfg->{fastp}->{enabled} = 1;
}

# --- assemblers ---
# general.main_assembly selects which already-run assembly is reported as THE
# assembly when more than one assembler is enabled (a specific assembler
# name, or a selection criterion like "fewest_contigs500" -- see
# get_best_assembler()). If it names a specific assembler, that assembler
# must actually be enabled, or there will be nothing for it to select.
if (lc($R_cfg->{general}->{main_assembly} // "") eq "spades" && $R_cfg->{spades}->{enabled} != 1 ) {
    log_message("NOTICE: Adjusting parameter: spades.enabled=1");
    $R_cfg->{spades}->{enabled} = 1;
}
if (lc($R_cfg->{general}->{main_assembly} // "") eq "skesa" && $R_cfg->{skesa}->{enabled} != 1) {
    log_message("NOTICE: Adjusting parameter: skesa.enabled=1");
    $R_cfg->{skesa}->{enabled} = 1;
}
if (lc($R_cfg->{general}->{main_assembly} // "") eq "shovill" && $R_cfg->{shovill}->{enabled} != 1) {
    log_message("NOTICE: Adjusting parameter: shovill.enabled=1");
    $R_cfg->{shovill}->{enabled} = 1;
}
if (lc($R_cfg->{general}->{main_assembly} // "") eq "unicycler" && $R_cfg->{unicycler}->{enabled} != 1 ) {
    log_message("NOTICE: Adjusting parameter: unicycler.enabled=1");
    $R_cfg->{unicycler}->{enabled} = 1;
}


# --- verbosity ---
if ($R_cfg->{"general"}->{"verbose"}) {
    $capture_output = $capture_output_verbose;
    $capture_stderr = $capture_stderr_verbose;
}


# Merge in any config-file/CLI-override value (e.g. assume_yes=1 in a config
# file, or --general.assume_yes=1 on the command line) -- ||= so this can
# only turn it on, never reset the early --assume-yes scan back off.
$ASSUME_YES ||= ($R_cfg->{general}{assume_yes} // 0);

if( is_conda()  && -d peekdir("db") && peekdir("db") eq peekdir("home") . "$rundata{pipeline_info}{name}_db") {
  log_message("NOTICE: Using default location as database path [" . peekdir("db") . "]");
}

#----------- Archive directory: soft, not required for the pipeline to run --------------
# Deliberately checked here, after config-file loading and CLI dispatch
# have both fully completed -- general.archive_results may have been
# turned off by either of those, and this must see that final value, not
# the still-on default. Unlike the database directory, a failure here
# never aborts the run -- archiving is a bonus feature (see the runstep
# machinery design doc, §12), not something the pipeline depends on to
# function. The local mirror inside each run's own output directory is
# unaffected either way.
if ( $R_cfg->{general}{archive_results} ) {

    if ( is_docker() && ! -d peekdir("archive") ) {
        # No sensible internal fallback exists for an archive (unlike the
        # database directory's internal light database) -- writing into
        # the container's own ephemeral filesystem would just be lost the
        # moment the container exits.
        log_message("NOTICE: No archive directory is mounted -- disabling central archiving for this run.");
        $R_cfg->{general}{archive_results} = 0;
    }
    elsif ( is_conda() && ! -d peekdir("archive") ) {
        log_message("NOTICE: Archive directory [" . peekdir("archive") . "] does not exist.");

        unless ( prompt_and_create_dir(peekdir("archive")) ) {
            log_message("WARNING: Could not create archive directory [" . peekdir("archive") . "] -- disabling central archiving for this run.", "red");
            $R_cfg->{general}{archive_results} = 0;
        }
    }
}

###################################################################################################
## fail fast if there is nothing to analyze, before any destructive
## output-directory handling (just below) or expensive environment/database
## setup happens. This is a quick existence check only (stops at the first
## match found anywhere in the tree) -- the real, full file discovery still
## happens later as it always has, this just decides whether it's worth
## getting that far at all.
unless ( any_input_files_exist( getdir("in"), $R_cfg->{"general"}->{"recursive"} ? 1 : 0, $R_cfg->{"general"}{"fastq"}, $R_cfg->{"general"}{"fasta"} ) ) {
    log_message("NOTICE: No FASTQ/FASTA files found in [" . getdir("in") . "].");
    log_message("NOTICE: If your files are in a subfolder, try recursive=yes.");
    log_message("NOTICE: If you meant a different folder, use datadir=<path>.");
    log_message("NOTICE: Nothing to analyze -- stopping here.");
    close_logfile();
    exit 2;
}


###################################################################################################
## make outputdirs

#------------------------
# base path

if( -d peekdir("out") ){

  my $outdirname =  basename(peekdir("out"));

  #--- prompt mode
  if( lc($R_cfg->{"general"}{"overwrite"})  eq  "prompt") {

     if ($ASSUME_YES) {
         graceful_die("Output directory [$outdirname] already exists and overwrite mode is 'prompt' -- this is a destructive decision and is never auto-approved under assume-yes. Set general.overwrite to 'yes' or 'no' to run without interaction.");
     }

     log_message("WARNING: Output directory [$outdirname] already exists. Data will be overwritten.", "red");
     my $answer = prompt_yes_no("Proceed?", 0);

     log_message("INFO: Output directory already exists. Proceed =[" . ($answer ? "y" : "n") . "]"); 

     unless ($answer) {
         graceful_die("User declined to overwrite existing output directory [$outdirname]");
     }
    
     execute_and_log( "rm -r '" . getdir("out") . "'" );
     getdir("out");  #creates the output dir
      
  }  
  #--- overwrite mode
  elsif( lc($R_cfg->{"general"}->{"overwrite"})  eq  "yes") {
     log_message("NOTICE: Output directory already exists.. removing old data");
     execute_and_log( "rm -r '" . getdir("out") . "'" );
     getdir("out");  #creates the output dir
  }    
  #--- no-overwrite mode
  elsif( lc($R_cfg->{"general"}->{"overwrite"})  eq  "no") {
     log_message( "WARNING: Output directory $outdirname already exists. (Overwrite mode is set to 'no')");
     graceful_die("Output directory [$outdirname] already exists and overwrite mode is 'no'");
  } 
  #--- extend mode   - experimental!  
  elsif( lc($R_cfg->{"general"}->{"overwrite"})  eq  "extend") {
     log_message( "NOTICE: Output directory $outdirname already exists.- Extending analysis");
  }      
  #--- unrecognized value -- don't silently do nothing and leave the
  #    existing output directory in an undecided state
  else {
     graceful_die("Output directory [$outdirname] already exists and general.overwrite has an unrecognized value [" . $R_cfg->{"general"}->{"overwrite"} . "] -- expected one of: prompt, yes, no, extend");
  }
}
else{
    getdir("out");  #creates the output dir
}



initiate_logfile();





    
