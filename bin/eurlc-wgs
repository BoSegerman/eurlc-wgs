###################################################################################################
## Canonical per-sample chewBBACA storage -- see the design discussion on
## §12 (historical allele-profile archive) and the runstep machinery design
## doc generally. Regardless of which mode produced the data (chewbbaca,
## the per-species batch runstep, or chewbbaca_per_sample, the per-sample
## runstep), the SAME small set of files gets written here, in the SAME
## shape -- this is what lets everything downstream (reports,
## add_to_archive, manual combining) be completely indifferent to which
## mode actually ran. Mirrors the pattern already used for
## record_checkm_result_for_sample (checkm) -- same idea, third time.
##
## Layout, per (species_dirname, schema_dirname):
##   per_sample/json/<sample>.json         -- the full $cgmlst_record, plus
##                                             the collision-check summary
##                                             for this sample/schema
##   per_sample/tsv/<sample>.profile.tsv   -- exactly one data row (with
##                                             its own header line) cut
##                                             from the hashed (CRC32)
##                                             allele table -- never the
##                                             unhashed results_alleles.tsv,
##                                             precisely to avoid a user
##                                             accidentally picking up
##                                             chewBBACA's own,
##                                             non-comparable-across-runs
##                                             allele IDs for downstream
##                                             work.
##
## $profile_header/$profile_row: one header line and one data line (both
## already tab-separated, both already chomped) lifted directly from
## results_alleles_crc32.tsv -- the caller is responsible for locating the
## right row (by sample name in column 1), this function only writes it
## out faithfully.
## Shared by both chewbbaca modes -- builds the canonical cgmlst_record
## hash from one parsed-results row ($rec, as produced by parse_chewbbaca
## or parse_chewbbaca_from_per_batch_tables). Previously inline only in
## postprocess_chewbbaca; factored out so chewbbaca_per_sample's
## postprocessing can build the identical record shape without duplicating
## ~25 lines of field mapping.
## Sibling to parse_chewbbaca, used only for per-sample-mode regeneration
## (chewbbaca_regenerate_per_batch). parse_chewbbaca itself is hardwired to
## chewBBACA's own unhashed results_alleles.tsv -- which never exists in
## per_batch/ in per-sample mode, by design (only the hashed table is
## copied/regenerated there). This reads the regenerated, HASHED
## results_alleles_crc32.tsv instead, for allele_header/schema_size/the
## per-locus values compute_chewbbaca_distance_matrix needs. This is valid
## because: (1) chewBBACA's special markers (PLOT3/PLOT5/LOTSC/NIPH/etc,
## '-' for not-called) pass through the hashing script unchanged -- the
## same markers, not hash values -- confirmed by check_crc32_hash_collisions
## treating '-' as a literal to skip, not something to hash-compare; and
## (2) hash equality between two samples at a locus exactly mirrors
## original-sequence equality, which is all the distance matrix actually
## needs. Does NOT reconstruct per-sample contig source info (source_contig/
## source_from/source_to/source_strand) -- that's chewBBACA's own
## per-genome detail, not meaningfully combinable across separately-run
## per-sample raw outputs; left empty here, a documented, acceptable gap
## specific to per-sample-mode regeneration.
sub parse_chewbbaca_from_per_batch_tables {
    my ($per_batch_dir) = @_;

    my %chewbbaca_data;
    my $stats_file = "$per_batch_dir/results_statistics.tsv";
    my $crc32_file = "$per_batch_dir/results_alleles_crc32.tsv";

    my ($stats_header, $stats_rows) = read_tsv_rows_by_first_column($stats_file);
    my ($crc32_header, $crc32_rows) = read_tsv_rows_by_first_column($crc32_file);

    my @stats_cols = defined $stats_header ? split(/\t/, $stats_header) : ();
    my @allele_header = defined $crc32_header ? split(/\t/, $crc32_header) : ();
    shift @allele_header;   # remove the FILE column itself

    $chewbbaca_data{header} = \@stats_cols;
    $chewbbaca_data{allele_header} = \@allele_header;
    $chewbbaca_data{data} = [];

    for my $file_id ( sort keys %$stats_rows ) {
        my @f = split /\t/, $stats_rows->{$file_id};
        my %record;
        @record{@stats_cols} = @f;
        $record{file} = $file_id;

        if ( my $crc_line = $crc32_rows->{$file_id} ) {
            my @a = split /\t/, $crc_line;
            shift @a;   # remove the FILE column itself
            $record{alleles} = \@a;
        } else {
            $record{alleles} = [];
        }

        $record{source_contig} = [];
        $record{source_from}   = [];
        $record{source_to}     = [];
        $record{source_strand} = [];

        my $exc    = $record{EXC}    // 0;
        my $inf    = $record{INF}    // 0;
        my $niph   = $record{NIPH}   // 0;
        my $niphem = $record{NIPHEM} // 0;
        my $schema_size = scalar @allele_header;

        $record{called_alleles} = $exc + $inf;
        $record{niph_total}     = $niph + $niphem;
        $record{schema_size}    = $schema_size;
        $record{call_rate}      = safe_rel($record{called_alleles}, $schema_size, "NA");

        my $idx = scalar @{ $chewbbaca_data{data} };
        push @{ $chewbbaca_data{data} }, \%record;
        $chewbbaca_data{sample_index}{$file_id} = $idx;
    }

    $chewbbaca_data{file_count} = scalar @{ $chewbbaca_data{data} };

    return \%chewbbaca_data;
}

sub build_chewbbaca_cgmlst_record {
    my ($rec, $schema_dirname, $species_dirname) = @_;

    my $infered         = $rec->{INF}            // "NA";
    my $called_alleles  = $rec->{called_alleles}  // "NA";
    my $infered_pct     = sprintf("%.1f", safe_rel($infered, $called_alleles, 0));

    return {
        scheme       => $schema_dirname,
        species_dir  => $species_dirname,
        call_rate    => $rec->{call_rate} // "n/a",
        paralogous   => $rec->{niph_total} // "n/a",
        inferred     => $rec->{INF} // "n/a",
        inferred_pct => $infered_pct // "n/a",
        called       => $rec->{called_alleles} // "n/a",
        schema_size  => $rec->{schema_size} // "n/a",

        EXC          => $rec->{EXC} // "n/a",
        INF          => $rec->{INF} // "n/a",
        NIPH         => $rec->{NIPH} // "n/a",
        NIPHEM       => $rec->{NIPHEM} // "n/a",
        PLOT3        => $rec->{PLOT3} // "n/a",
        PLOT5        => $rec->{PLOT5} // "n/a",
        LOTSC        => $rec->{LOTSC} // "n/a",
        ALM          => $rec->{ALM} // "n/a",
        ASM          => $rec->{ASM} // "n/a",
        PAMA         => $rec->{PAMA} // "n/a",
        LNF          => $rec->{LNF} // "n/a",

        invalid_CDSs    => $rec->{'Invalid CDSs'} // "n/a",
        classified_CDSs => $rec->{'Classified_CDSs'} // "n/a",
        total_CDSs      => $rec->{'Total_CDSs'} // "n/a",

        method       => "ChewBBACA: $schema_dirname",
    };
}

sub write_canonical_chewbbaca_sample_files {
    my (%args) = @_;

    my $species_dirname = $args{species_dirname};
    my $schema_dirname   = $args{schema_dirname};
    my $sample_name      = $args{sample_name};
    my $cgmlst_record    = $args{cgmlst_record};
    my $profile_header    = $args{profile_header};
    my $profile_row       = $args{profile_row};

    return 0 unless $species_dirname && $schema_dirname && $sample_name && $cgmlst_record;

    my $base = "__DIR-CLUSTERING__/chewbbaca/$species_dirname/$schema_dirname/per_sample";
    my $json_dir = fill_placeholders("$base/json");
    my $tsv_dir  = fill_placeholders("$base/tsv");

    ensure_dir($json_dir);
    ensure_dir($tsv_dir);

    write_json_file($cgmlst_record, "$json_dir/$sample_name.json");

    if (defined $profile_header && defined $profile_row) {
        my $tsv_path = "$tsv_dir/$sample_name.profile.tsv";
        open(my $fh, '>', $tsv_path) or do {
            log_message("WARNING: Could not write [$tsv_path]: $!", "red");
            return 1;
        };
        print $fh "$profile_header\n$profile_row\n";
        close($fh);
    }

    return 1;
}

# Reads a tab-separated table (results_alleles_crc32.tsv or
# results_statistics.tsv -- both have the sample/file name in column 1)
# into a header line plus a hash of data lines keyed by that first column.
# Used both to look up a single sample's row (canonical per-sample TSV) and
# to drive the per-sample-mode regeneration of the combined per_batch
# tables (concatenating many single-sample tables back into one).
sub read_tsv_rows_by_first_column {
    my ($path) = @_;
    return (undef, {}) unless defined $path && -f $path;

    open(my $fh, '<', $path) or return (undef, {});
    my $header = <$fh>;
    return (undef, {}) unless defined $header;
    chomp $header;

    my %rows;
    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;
        my ($key) = split /\t/, $line, 2;
        next unless defined $key && $key ne '';
        $rows{$key} = $line;
    }
    close($fh);

    return ($header, \%rows);
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep chewbbaca_per_sample
##
## Mutually exclusive with chewbbaca (the per-species-batch mode above) via
## general.chewbbaca_mode -- see the design discussion on per_sample/
## per_batch storage layout. Runs chewBBACA.py AlleleCall on exactly one
## genome at a time (via a single-fasta staging directory, symlinked like
## checkm_per_sample), for each schema configured for this sample's
## species. The per_batch/ central tables (results_alleles_crc32.tsv,
## results_statistics.tsv, the collision check) cannot be produced here --
## meaningful collision checking needs multiple samples to compare against
## -- that happens in a separate step, chewbbaca_regenerate_per_batch,
## once every sample's per-sample work is done.

$runstep_name = "chewbbaca_per_sample";

$runstep{$runstep_name} = {

      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 4 },

      message    => "Running Chewbbaca (per sample)...",
      long_name  => "Chewbbaca (per sample)",
      output_dir => "__DIR-CLUSTERING__/chewbbaca",
      resultfiles_status => "NA",

      group      => 'chewbbaca_mode',
      requires   => [ 'main_assembly_present', 'species_determined' ],
      produces   => [ 'chewbbaca_per_sample_done' ],
      rerun_paths => [
          "__DIR-CLUSTERING__/chewbbaca/*/*/per_sample/rawdata/__BASE__",
          "__DIR-CLUSTERING__/chewbbaca/*/*/per_sample/json/__BASE__.json",
          "__DIR-CLUSTERING__/chewbbaca/*/*/per_sample/tsv/__BASE__.profile.tsv",
      ],
      applies_if => sub {
          return ( $R_cfg->{chewbbaca}{enabled} && lc($R_cfg->{general}{chewbbaca_mode} // 'per_sample') eq 'per_sample' ) ? 1 : 0;
      },
};

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_chewbbaca;   # same conda tool, shared test

# ensure_schema_prepared($schema_path, $schema_name)
# ---------------------------------------------------
# Checks whether a chewBBACA schema directory has been prepared for use
# (i.e. the short/ subdirectory exists and contains FASTA files).
# If not, runs PrepExternalSchema automatically.
#
# chewBBACA requires the schema to be "prepared" (BLAST databases + short
# allele files generated) before AlleleCall can run.  This preparation is
# NOT done automatically by AlleleCall -- without it the run will fail with
# a BLAST database error.
#
# Training file (.trn) resolution order:
#   1. First .trn file found directly in the schema directory
#   2. First .trn file found anywhere under the db chewbbaca/ tree
#   3. Omitted -- Prodigal will run in meta-mode (suboptimal but won't crash)
#
# Returns 1 if the schema is (now) prepared, 0 on failure.
#
sub ensure_schema_prepared {
    my ($schema_path, $schema_name) = @_;
    $schema_name //= basename($schema_path);

    # ── Already prepared? ──────────────────────────────────────────────────────
    my $short_dir = "$schema_path/short";
    my @short_fastas = glob("$short_dir/*.fasta");
    if (-d $short_dir && @short_fastas) {
        return 1;   # nothing to do
    }

    log_message("NOTICE: chewBBACA schema [$schema_name] is not prepared (short/ directory missing or empty).");
    log_message("NOTICE: Running PrepExternalSchema automatically -- this may take a few minutes...");

    # ── Locate training file ───────────────────────────────────────────────────
    my $ptf_arg = "";
    my @trn_in_schema = glob("$schema_path/*.trn");
    if (@trn_in_schema) {
        my $ptf = $trn_in_schema[0];
        $ptf_arg = "--ptf \"$ptf\"";
        log_message("NOTICE: Using training file: $ptf");
    } else {
        # Try the broader chewbbaca db tree
        my $chewbbaca_db = File::Spec->catdir(peekdir("db") // "", "chewbbaca");
        my @trn_global   = glob("$chewbbaca_db/*.trn");
        if (@trn_global) {
            my $ptf = $trn_global[0];
            $ptf_arg = "--ptf \"$ptf\"";
            log_message("NOTICE: Using training file from chewbbaca db root: $ptf");
        } else {
            log_message("WARNING: No .trn training file found for schema [$schema_name].", "yellow");
            log_message("WARNING: Prodigal will run in meta-mode -- results may be less accurate.", "yellow");
            log_message("WARNING: Place a species-specific .trn file in $schema_path to fix this.", "yellow");
        }
    }

    # ── Get thread count ───────────────────────────────────────────────────────
    my $threads = $R_cfg->{general}{threads} // 4;

    # ── Run PrepExternalSchema in-place ───────────────────────────────────────
    # --no-cleanup keeps the original allele files (important for existing schemas).
    # Output goes to a temp dir, then we merge short/ and *.py back into the schema.
    my $chewy_env = $R_cfg->{chewbbaca}{env} // "chewbbaca";
    my $prep_out  = "${schema_path}_prep_tmp_$$";

    my $prep_cmd = "conda run -n $chewy_env --no-capture-output chewBBACA.py PrepExternalSchema"
                 . " -g \"$schema_path\""
                 . " -o \"$prep_out\""
                 . " $ptf_arg"
                 . " --cpu $threads";

    log_message("NOTICE: $prep_cmd");
    my $rc = system($prep_cmd);

    if ($rc != 0) {
        log_message("ERROR: PrepExternalSchema failed (exit code " . ($rc >> 8) . ") for schema [$schema_name].", "red");
        log_message("ERROR: AlleleCall will likely fail. Check the schema directory: $schema_path", "red");
    }

    # chewBBACA 3.x PrepExternalSchema writes short/ directly into the source
    # schema dir (-g), not exclusively into the -o output dir.
    # First check if short/ is now present in the original schema dir.
    # If not, try to merge relevant files from the prep output (older behavior).
    my @post_short = glob("$short_dir/*.fasta");
    if (!@post_short && -d $prep_out) {
        my $prep_inner = "$prep_out/" . basename($schema_path);
        $prep_inner    = -d $prep_inner ? $prep_inner : $prep_out;

        for my $item (glob("$prep_inner/*")) {
            my $bn   = basename($item);
            my $dest = "$schema_path/$bn";
            remove_tree($dest) if -e $dest;
            rename($item, $dest)
                or log_message("WARNING: Could not move $item -> $dest: $!", "yellow");
        }
        @post_short = glob("$short_dir/*.fasta");
    }

    # Clean up prep output directory and chewBBACA's sidecar files
    remove_tree($prep_out)                if -d $prep_out;
    unlink "${prep_out}_invalid_loci.txt"              if -f "${prep_out}_invalid_loci.txt";
    unlink "${prep_out}_invalid_alleles.txt"           if -f "${prep_out}_invalid_alleles.txt";
    unlink "${prep_out}_summary_stats.tsv"             if -f "${prep_out}_summary_stats.tsv";

    return 0 if $rc != 0;

    # Verify
    if (@post_short) {
        log_message("NOTICE: ✓ Schema [$schema_name] prepared successfully.", "green");
        return 1;
    } else {
        log_message("ERROR: PrepExternalSchema ran but short/ still missing in $schema_path", "red");
        return 0;
    }
}

# discover_installed_schemas()
# ----------------------------
# Scans db/chewbbaca/schemas/*/schema.ini and returns a hash of
#   schema_name => { species, path, filter, enabled, source, _schema_dir, ... }
#
# schema.ini format (INI, section [schema]):
#   name         = pubmlst_campy_cg_v2        ; if omitted, dirname is used
#   species      = Campylobacter jejuni, Campylobacter coli
#   source       = pubmlst                     ; pubmlst | chewie-ns | cgmlst.org | custom
#   source_url   = https://...
#   version      = 2
#   description  = cgMLST schema for Campylobacter
#   filter       = filter.txt                  ; relative to schema dir, or "unfiltered"
#   enabled      = 1
#
# filter field resolution:
#   "unfiltered" or ""  → no filter
#   relative path       → resolved against the schema directory
#   absolute path       → used as-is
#
sub discover_installed_schemas {
    my $schemas_root = File::Spec->catdir(peekdir("db") // "", "chewbbaca", "schemas");
    my %found;

    return %found unless defined $schemas_root && -d $schemas_root;

    opendir(my $dh, $schemas_root) or do {
        log_message("WARNING: Could not open schemas directory [$schemas_root]: $!");
        return %found;
    };

    for my $entry (readdir $dh) {
        next if $entry =~ /^\./;
        my $schema_dir = File::Spec->catdir($schemas_root, $entry);
        next unless -d $schema_dir;

        my $ini_file = File::Spec->catfile($schema_dir, "schema.ini");
        unless (-f $ini_file) {
            # Directory exists but has no schema.ini -- not a registered schema
            log_message("INFO: Skipping $entry (no schema.ini found)");
            next;
        }

        my $ini = read_ini_file($ini_file);
        unless ($ini && ref $ini eq 'HASH') {
            log_message("WARNING: Could not parse schema.ini in [$schema_dir]");
            next;
        }

        # Support both [schema] and bare key=value at root level
        my $s = $ini->{schema} // $ini->{''} // {};

        # Derive schema name: from ini "name" field, else from directory name
        my $schema_name = $s->{name} // $entry;
        $schema_name =~ s/\s+/_/g;  # normalise spaces to underscores

        # Derive path: always the directory itself (schema files live directly in it)
        my $path = $schema_dir;

        # Resolve filter path
        my $filter = $s->{filter} // "";
        if ($filter ne "" && $filter ne "unfiltered") {
            unless (File::Spec->file_name_is_absolute($filter)) {
                # Relative path → resolve against schema dir
                $filter = File::Spec->catfile($schema_dir, $filter);
            }
            # Verify the resolved filter file actually exists.
            # If it doesn't, treat the schema as unfiltered and warn — this prevents
            # chewBBACA from crashing with a stale filter name in schema.ini (e.g. "cgmlst"
            # from an old installation before filters were moved inside the schema directory).
            unless (-f $filter) {
                log_message("WARNING: Filter file for schema [$entry] does not exist: $filter", "yellow");
                log_message("WARNING:   Running schema [$entry] without filter. Re-run --install-schema or --install-efsa-schemas to fix.", "yellow");
                $filter = "";
            }
        }

        my $enabled = $s->{enabled} // 1;
        if (defined $enabled && ($enabled eq "0" || lc($enabled) eq "false" || lc($enabled) eq "no")) {
            $enabled = 0;
        } else {
            $enabled = 1;
        }

        $found{$schema_name} = {
            species     => $s->{species}     // "",
            path        => $path,
            filter      => $filter,
            enabled     => $enabled,
            source      => $s->{source}      // "custom",
            source_url  => $s->{source_url}  // "",
            version     => $s->{version}     // "",
            description => $s->{description} // "",
            _schema_dir => $schema_dir,      # internal; not written to config
        };

        log_message("INFO: Discovered chewBBACA schema: [$schema_name] in [$schema_dir]");
    }

    closedir $dh;
    return %found;
}

# Returns the list of (schema_dirname, schema_path, filtercommand) triples
# matching this sample's species -- the per-sample equivalent of
# preprocess_chewbbaca's species/schema matching loop, reused identically
# here and in the regeneration step so both agree on which schemas apply.
sub matching_chewbbaca_schemas_for_species {
    my ($species) = @_;
    my @matches;

    foreach my $schema_name ( keys %{ $R_cfg->{chewbbaca_schemas} } ) {
        my $schema       = $R_cfg->{chewbbaca_schemas}{$schema_name};
        my $schema_path  = $schema->{path} // "";
        my $filter       = $schema->{filter} // "";
        my $species_raw  = $schema->{species} // "";

        my @species_list = map { s/^\s+|\s+$//gr } split /,/, $species_raw;
        next unless grep { lc($_) eq lc($species) } @species_list;

        my $schema_dirname = basename($schema_path);
        my $filtercommand  = ($filter && $filter ne "unfiltered") ? "--genes-list $filter" : "";
        $filtercommand    .= " $schema->{arguments}" if defined $schema->{arguments} && $schema->{arguments} =~ /\S/;

        push @matches, {
            schema_name    => $schema_name,
            schema_dirname => $schema_dirname,
            schema_path    => fill_placeholders($schema_path),
            filtercommand  => $filtercommand,
        };
    }

    return @matches;
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_chewbbaca_per_sample;

sub preprocess_chewbbaca_per_sample {
    my ($samplenr) = @_;

    my $runstep_name = "chewbbaca_per_sample";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $species      = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";

    my @schemas = matching_chewbbaca_schemas_for_species($species);
    my @locked;   # (lockfile, readyfile, command) per schema -- see run_chewbbaca_locked

    if (!@schemas) {
        log_message("NOTICE: Sample $sample_name: no chewBBACA schema configured for species [$species], skipping");
        # For the species EURLC-WGS has schemas for, a missing schema is
        # worth saying out loud: it often means the schema was removed or
        # never installed, and on --resume earlier cgMLST results of the
        # sample are then no longer used.
        if (cgmlst_install_hint($species)) {
            push @{ $S_CGMLST_NO_SCHEMA{$species} }, $sample_name;
            set_runtime_issue($samplenr, "warning", "cgMLST not run: no schema installed for $species");
        }
        return "";
    }

    my $source_fasta = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name);
    unless (-f $source_fasta) {
        log_message("WARNING: Sample $sample_name: source assembly file missing [$source_fasta], skipping chewBBACA (per sample)", "yellow");
        return "";
    }

    my $command = "";

    for my $s (@schemas) {

        if (! -d $s->{schema_path}) {
            log_message("WARNING: Chewbbaca schema path is not valid for schema $s->{schema_name} [$s->{schema_path}], skipping...", "yellow");
            next;
        }

        # Ensure schema is prepared (short/ + BLAST indices exist).
        # PrepExternalSchema is run automatically if needed.
        unless (ensure_schema_prepared($s->{schema_path}, $s->{schema_name})) {
            log_message("WARNING: Skipping schema [$s->{schema_name}] for sample $sample_name -- could not prepare it.", "yellow");
            next;
        }

        my $rawdata_dir = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/$species/$s->{schema_dirname}/per_sample/rawdata/$sample_name", $samplenr, $runstep_name);
        $rawdata_dir =~ s/\s/_/g;   # species name may contain spaces

        my $resultfile = "$rawdata_dir/chewbbaca_results/results_alleles.tsv";

        if (-f $resultfile) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name Schema: $s->{schema_dirname} already exists. Skipping");
            next;
        }

        # Safe here: the check above already confirmed the real result
        # doesn't exist yet, so anything present can only be debris from a
        # previous incomplete attempt (same reasoning as the batch-mode
        # call to this same function).
        cleanup_stale_chewbbaca_rawdata($rawdata_dir);

        my $input_dir = "$rawdata_dir/input";
        ensure_dir($input_dir);
        ensure_dir($rawdata_dir);

        my $symlink_path = "$input_dir/$sample_name.fasta";
        unless (-l $symlink_path || -f $symlink_path) {
            symlink($source_fasta, $symlink_path)
                or graceful_die("Could not symlink [$source_fasta] -> [$symlink_path]: $!");
        }

        my $command_part = "conda run -n $R_cfg->{chewbbaca}->{env} --no-capture-output chewBBACA.py AlleleCall "
                          . "-i '$input_dir' -g '$s->{schema_path}' -o '$rawdata_dir' --cpu __THREADS__ "
                          . "$s->{filtercommand} $R_cfg->{chewbbaca}->{arguments} >/dev/null 2>&1";

        $command_part = fill_placeholders($command_part, $samplenr, $runstep_name);

        my $lockdir = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/.locks", $samplenr, $runstep_name);
        ensure_dir($lockdir);
        push @locked, "$lockdir/$s->{schema_dirname}.lock", "$lockdir/$s->{schema_dirname}.ready", $command_part;
    }

    if (!@locked) {
        postprocess_chewbbaca_per_sample($samplenr);
        return "";
    }

    return join("\t", "SUB", "run_chewbbaca_locked", @locked);
}

# Several samples may run AlleleCall against the same schema at the same
# time in parallel mode. chewBBACA allows that only with --no-inferred
# (schema files are then never written) and only once one allele call has
# created the schema's pre-computed data. So, per schema:
#   - first call in this output directory, or --no-inferred missing from
#     chewbbaca.arguments: exclusive lock (runs alone)
#   - afterwards: shared lock (any number at the same time)
# The lock files live in the output directory, never in the database.
# Runs in the forked child (internal sub): only writes files.
$INTERNAL_SUB{run_chewbbaca_locked} = sub {
    my (@args) = @_;
    my $failed = 0;
    my $no_inferred = ( $R_cfg->{chewbbaca}{arguments} // "" ) =~ /--no-inferred\b/ ? 1 : 0;
    while ( my ($lockfile, $readyfile, $cmd) = splice(@args, 0, 3) ) {
        my $lfh;
        unless ( open( $lfh, '>>', $lockfile ) ) {
            log_message("WARNING: chewBBACA: cannot open lock file [$lockfile]: $! -- running without lock");
            undef $lfh;
        }
        if ($lfh) {
            my $exclusive = ( !$no_inferred || !-e $readyfile ) ? 1 : 0;
            flock( $lfh, $exclusive ? LOCK_EX : LOCK_SH );
            # Another sample may have finished the first call while we waited.
            if ( $exclusive && $no_inferred && -e $readyfile ) {
                flock( $lfh, LOCK_SH );   # downgrade (atomic for flock on Linux)
            }
        }
        log_message("INFO: chewBBACA: $cmd");
        print {$log_fh_bash} "[" . timestamp_UTC() . "] $cmd\n" if $log_fh_bash;
        my $rc = system( "bash", "-c", $cmd );
        if ( $rc == 0 ) {
            if ( !-e $readyfile && open( my $r, '>', $readyfile ) ) { close $r; }
        } else {
            $failed = 1;
        }
        close $lfh if $lfh;   # releases the lock
    }
    return $failed;
};

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_chewbbaca_per_sample;

sub postprocess_chewbbaca_per_sample {
    my ($samplenr) = @_;

    my $runstep_name = "chewbbaca_per_sample";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $species      = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // "";
    # Folder name as sort_assemblies makes it (Campylobacter_jejuni) -- the
    # aggregation step chewbbaca_regenerate_per_batch looks there.
    ( my $species_dirname = $species ) =~ s/\s/_/g;

    my @schemas = matching_chewbbaca_schemas_for_species($species);

    delete $R_samples->[$samplenr]{results}{chewbbaca}{schemas};
    delete $R_samples->[$samplenr]{main_results}{typing}{cgmlst_schemas};

    for my $s (@schemas) {

        my $rawdata_dir = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/$species/$s->{schema_dirname}/per_sample/rawdata/$sample_name", $samplenr, $runstep_name);
        $rawdata_dir =~ s/\s/_/g;

        my $found_resultpath = find_chewie_resultpath($rawdata_dir);
        unless ($found_resultpath && -d $found_resultpath) {
            log_message("WARNING: No chewBBACA result found for sample $sample_name, schema $s->{schema_dirname}", "red");
            set_runtime_issue($samplenr, "warning", "cgMLST (chewBBACA, schema $s->{schema_dirname}) produced no result", $runstep_name);
            next;
        }

        my $chewbbaca_results_path = "$rawdata_dir/chewbbaca_results";
        if ($found_resultpath ne $chewbbaca_results_path) {
            unless (-d $chewbbaca_results_path) {
                rename($found_resultpath, $chewbbaca_results_path)
                    or log_message("WARNING: Could not rename [$found_resultpath] to [$chewbbaca_results_path]: $!", "red");
            }
        }

        my $hashed_results_path = "$rawdata_dir/hashed_results";

        # Hashing only -- NOT collision checking. A single-genome table can
        # never reveal a real collision (needs >=2 samples to compare); see
        # chewbbaca_regenerate_per_batch for where that actually happens.
        run_chewbbaca_hashing(
            result_dir        => $chewbbaca_results_path,
            assembly_base_dir => dirname(fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name)),
            species_dirname   => $species_dirname,
            scheme_dirname    => $s->{schema_dirname},
        );

        my $result_ref = parse_chewbbaca($chewbbaca_results_path);
        unless ($result_ref && ref($result_ref) eq 'HASH' && $result_ref->{file_count}) {
            log_message("WARNING: Could not parse chewBBACA (per sample) result for sample $sample_name, schema $s->{schema_dirname}", "red");
            next;
        }

        my ($rec) = grep { ($_->{file} // '') eq $sample_name } @{ $result_ref->{data} // [] };
        unless ($rec) {
            log_message("WARNING: chewBBACA (per sample) result did not contain sample $sample_name as expected", "red");
            next;
        }

        my $cgmlst_record = build_chewbbaca_cgmlst_record($rec, $s->{schema_dirname}, $species_dirname);

        my ($crc32_header, $crc32_rows) = read_tsv_rows_by_first_column("$hashed_results_path/results_alleles_crc32.tsv");

        write_canonical_chewbbaca_sample_files(
            species_dirname => $species_dirname,
            schema_dirname  => $s->{schema_dirname},
            sample_name     => $sample_name,
            cgmlst_record   => $cgmlst_record,
            profile_header  => $crc32_header,
            profile_row     => $crc32_rows->{$sample_name},
        );

        push @{ $R_samples->[$samplenr]{results}{chewbbaca}{schemas} }, $cgmlst_record;
        push @{ $R_samples->[$samplenr]{main_results}{typing}{cgmlst_schemas} }, $cgmlst_record;

        my $new_call_rate = $rec->{call_rate};
        if (defined $new_call_rate && $new_call_rate ne "NA" && $new_call_rate ne "n/a") {
            my $R_typing = $R_samples->[$samplenr]{main_results}{typing};
            if ( !defined $R_typing->{cgmlst_call_rate}
                 || $R_typing->{cgmlst_call_rate} eq "n/a"
                 || $new_call_rate < $R_typing->{cgmlst_call_rate} ) {
                $R_typing->{cgmlst_call_rate} = $new_call_rate;
                $R_typing->{cgmlst_call_rate_schema} = $s->{schema_dirname};
                $R_typing->{cgmlst_paralogous} = $rec->{paralogous} // $rec->{niph_total} // "n/a";   # same schema as the call rate
            }
        }

        log_message("NOTICE: $sample_name [$s->{schema_dirname}]: Called alleles=$cgmlst_record->{called} ($cgmlst_record->{inferred_pct}% inferred), call rate=$cgmlst_record->{call_rate}%", "green");
    }

    return 1;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep chewbbaca_regenerate_per_batch
##
## Batch-level (no sample index) -- runs once, after every sample's
## chewbbaca_per_sample work is done, only when general.chewbbaca_mode is
## 'per_sample'. Rebuilds the three central per_batch/ files (see the
## design discussion) by concatenating each sample's own per-sample data,
## and runs the REAL collision check here -- the one place in per-sample
## mode where it can be meaningful at all, since it needs multiple samples
## to compare against (a single sample's table can never reveal a
## collision). Also builds a parse_chewbbaca-shaped result_ref from the
## regenerated tables (see parse_chewbbaca_from_per_batch_tables) so
## reporting -- $rundata{batches}{...}{chewbbaca}{...}, the distance
## matrix, register_clustering_result -- works identically regardless of
## which mode actually ran.

$runstep_name = "chewbbaca_regenerate_per_batch";

$runstep{$runstep_name} = {
      message    => "Regenerating chewBBACA per-batch tables...",
      long_name  => "ChewBBACA per-batch table regeneration",
      output_dir => "__DIR-CLUSTERING__/chewbbaca",

      requires   => [ 'chewbbaca_per_sample_done' ],
      produces   => [ 'chewbbaca_regenerated_done' ],
      applies_if => sub {
          return ( $R_cfg->{chewbbaca}{enabled} && lc($R_cfg->{general}{chewbbaca_mode} // 'per_sample') eq 'per_sample' ) ? 1 : 0;
      },
};

$runstep{$runstep_name}{test} = sub { return 2; };  # no external tool of its own

$runstep{$runstep_name}{preprocessing} = \&preprocess_chewbbaca_regenerate_per_batch;

sub preprocess_chewbbaca_regenerate_per_batch {

    my $runstep_name = "chewbbaca_regenerate_per_batch";

    log_message("INFO: Regenerating chewBBACA per-batch tables from per-sample data");

    # clear any old results, same as batch-mode postprocessing does
    $rundata{clustering}{results} = [];
    for my $sample (@$R_samples) {
        delete $sample->{results}{chewbbaca}{schemas};   # rebuilt below (was pushed twice)
        delete $sample->{main_results}{typing}{cgmlst_schemas};
        delete $sample->{main_results}{typing}{cgmlst_call_rate};
        delete $sample->{main_results}{typing}{cgmlst_call_rate_schema};
    }

    my $species_dir_count = $rundata{batches}{subdirs_count} // 0;

    for my $j (0 .. $species_dir_count - 1) {

        my $species_dirname = $rundata{batches}{subdirs}[$j];
        my $species          = $rundata{batches}{$species_dirname}{species};
        my $sample_count     = $rundata{batches}{$species_dirname}{count} // 0;

        my @sample_names;
        for my $jj (0 .. $sample_count - 1) {
            my $fasta = $rundata{batches}{$species_dirname}{fasta}[$jj] // next;
            (my $name = basename($fasta)) =~ s/\.(fa|fasta|fna)$//i;
            push @sample_names, $name;
        }

        for my $s ( matching_chewbbaca_schemas_for_species($species) ) {

            my $schema_dirname = $s->{schema_dirname};
            my $base_dir   = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/$species_dirname/$schema_dirname");
            my $tsv_dir    = "$base_dir/per_sample/tsv";
            my $rawdata_dir = "$base_dir/per_sample/rawdata";
            my $per_batch_dir = "$base_dir/per_batch";

            next unless -d $tsv_dir;

            # ------------------------------------------------------------
            # 1. Concatenate per-sample CRC32 profile rows -> the central,
            #    user-facing per_batch/results_alleles_crc32.tsv
            # ------------------------------------------------------------
            my (@crc32_lines, $crc32_header_line);
            my (@sha256_lines, $sha256_header_line);
            my (@stats_lines, $stats_header_line);
            my $any_sample_found = 0;

            for my $sample_name (@sample_names) {

                my $profile_tsv = "$tsv_dir/$sample_name.profile.tsv";
                next unless -f $profile_tsv;
                $any_sample_found = 1;

                open(my $fh, '<', $profile_tsv) or next;
                my $h = <$fh>;
                my $r = <$fh>;
                close($fh);
                next unless defined $h && defined $r;
                chomp($h, $r);
                $crc32_header_line //= $h;
                push @crc32_lines, $r;

                my $sample_hashed_results    = "$rawdata_dir/$sample_name/hashed_results";
                my $sample_chewbbaca_results = "$rawdata_dir/$sample_name/chewbbaca_results";

                my ($sh, $sr) = read_tsv_rows_by_first_column("$sample_hashed_results/results_alleles_sha256.tsv");
                if (defined $sh && exists $sr->{$sample_name}) {
                    $sha256_header_line //= $sh;
                    push @sha256_lines, $sr->{$sample_name};
                }

                my ($st_h, $st_r) = read_tsv_rows_by_first_column("$sample_chewbbaca_results/results_statistics.tsv");
                if (defined $st_h && exists $st_r->{$sample_name}) {
                    $stats_header_line //= $st_h;
                    push @stats_lines, $st_r->{$sample_name};
                }
            }

            next unless $any_sample_found;

            ensure_dir($per_batch_dir);

            my $crc32_path = "$per_batch_dir/results_alleles_crc32.tsv";
            open(my $cfh, '>', $crc32_path) or graceful_die("Could not write [$crc32_path]: $!");
            print $cfh "$crc32_header_line\n";
            print $cfh "$_\n" for @crc32_lines;
            close($cfh);

            my $stats_path = "$per_batch_dir/results_statistics.tsv";
            if (defined $stats_header_line) {
                open(my $sfh, '>', $stats_path) or graceful_die("Could not write [$stats_path]: $!");
                print $sfh "$stats_header_line\n";
                print $sfh "$_\n" for @stats_lines;
                close($sfh);
            }

            # Temporary, deleted immediately after the collision check --
            # not one of the three documented central per_batch files;
            # only needed as an input to check_crc32_hash_collisions.
            my $sha256_tmp_path = "$per_batch_dir/.tmp_results_alleles_sha256.tsv";
            if (defined $sha256_header_line) {
                open(my $hfh, '>', $sha256_tmp_path) or graceful_die("Could not write [$sha256_tmp_path]: $!");
                print $hfh "$sha256_header_line\n";
                print $hfh "$_\n" for @sha256_lines;
                close($hfh);
            }

            # ------------------------------------------------------------
            # 2. Real collision check -- the one place in per-sample mode
            #    where this is actually meaningful (multiple samples).
            # ------------------------------------------------------------
            my $collision_check = check_crc32_hash_collisions(
                crc32_file  => $crc32_path,
                sha256_file => $sha256_tmp_path,
                out_file    => "$per_batch_dir/results_alleles_crc32_collision_check.txt",
            );

            unlink($sha256_tmp_path) if -f $sha256_tmp_path;

            store_crc32_collision_check_in_samples(
                collision_check => $collision_check,
                species_dirname => $species_dirname,
                scheme          => $schema_dirname,
            );

            # ------------------------------------------------------------
            # 3. Update each sample's already-written canonical json with
            #    the now-known real collision check, and rebuild
            #    main_results.typing.cgmlst_schemas (cleared above) from
            #    the regenerated data -- mirrors exactly what batch-mode
            #    postprocessing does per sample.
            # ------------------------------------------------------------
            my $result_ref = parse_chewbbaca_from_per_batch_tables($per_batch_dir);

            $rundata{batches}{$species_dirname}{chewbbaca}{$schema_dirname} = $result_ref;

            for my $rec ( @{ $result_ref->{data} // [] } ) {
                my $sample_name = $rec->{file} // next;
                my $sample_idx  = $rundata{sample_index}{$sample_name};
                next unless defined $sample_idx;

                my $cgmlst_record = build_chewbbaca_cgmlst_record($rec, $schema_dirname, $species_dirname);

                my ($latest_check) = grep {
                    ($_->{species_dirname} // '') eq $species_dirname
                    && ($_->{scheme} // '') eq $schema_dirname
                } @{ $R_samples->[$sample_idx]{results}{chewbbaca}{crc32_collision_checks} // [] };
                $cgmlst_record->{crc32_collision_check} = $latest_check if $latest_check;

                my ($crc32_header, $crc32_rows) = read_tsv_rows_by_first_column($crc32_path);
                write_canonical_chewbbaca_sample_files(
                    species_dirname => $species_dirname,
                    schema_dirname  => $schema_dirname,
                    sample_name     => $sample_name,
                    cgmlst_record   => $cgmlst_record,
                    profile_header  => $crc32_header,
                    profile_row     => $crc32_rows->{$sample_name},
                );

                push @{ $R_samples->[$sample_idx]{results}{chewbbaca}{schemas} }, $cgmlst_record;
                push @{ $R_samples->[$sample_idx]{main_results}{typing}{cgmlst_schemas} }, $cgmlst_record;

                my $new_call_rate = $rec->{call_rate};
                if (defined $new_call_rate && $new_call_rate ne "NA" && $new_call_rate ne "n/a") {
                    my $R_typing = $R_samples->[$sample_idx]{main_results}{typing};
                    if ( !defined $R_typing->{cgmlst_call_rate}
                         || $R_typing->{cgmlst_call_rate} eq "n/a"
                         || $new_call_rate < $R_typing->{cgmlst_call_rate} ) {
                        $R_typing->{cgmlst_call_rate} = $new_call_rate;
                        $R_typing->{cgmlst_call_rate_schema} = $schema_dirname;
                        $R_typing->{cgmlst_paralogous} = $rec->{paralogous} // $rec->{niph_total} // "n/a";   # same schema as the call rate
                    }
                }
            }

            # ------------------------------------------------------------
            # 4. Distance matrix + clustering registration -- identical to
            #    batch mode, against the regenerated result_ref.
            # ------------------------------------------------------------
            my $species_outdir = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/$species_dirname");

            # out_prefix is a literal FILENAME prefix (writes
            # "$out_prefix.dist.tsv"/".success.tsv"), not a directory --
            # see the matching comment in postprocess_chewbbaca.
            my $matrix_prefix = "$per_batch_dir/$schema_dirname";

            compute_chewbbaca_distance_matrix(
                $result_ref,
                report_distance    => 10,
                report_pct_success => 0.85,
                out_prefix         => $matrix_prefix,
            );

            my $distance_tsv_all = "$matrix_prefix.dist.tsv";
            my $success_tsv_all  = "$matrix_prefix.success.tsv";

            register_clustering_result(
                species_dirname    => $species_dirname,
                species            => $species,
                schema             => $schema_dirname,
                hashed_alleles_all => path_relative_to_outdir($crc32_path),
                distance_tsv_all   => path_relative_to_outdir($distance_tsv_all),
                success_tsv_all    => path_relative_to_outdir($success_tsv_all),
                crc32_collision_check => $collision_check,
            );

            log_message("NOTICE: ChewBBACA per-batch tables regenerated for species [$species_dirname], schema [$schema_dirname] (" . scalar(@crc32_lines) . " samples)", "green");
        }
    }

    my $marker = fill_placeholders("__DIR-CLUSTERING__/chewbbaca/.regeneration_complete");
    return "touch '$marker'";
}

$runstep{$runstep_name}{result_parsing} = sub { return 1; };

sub register_clustering_result {
    my (%args) = @_;

    my $species_dirname = $args{species_dirname};
    my $species         = $args{species} // $species_dirname;
    my $schema          = $args{schema};
    my $allele_table    = $args{hashed_alleles_all};

    if (!$species_dirname || !$schema) {
        log_message("WARNING: clustering result NOT registered: missing species_dirname or schema");
        return 0;
    }

    my %entry = (
        species_dirname => $species_dirname,
        species         => $species,
        schema          => $schema,

        distance_tsv_all  => $args{distance_tsv_all},
        success_tsv_all   => $args{success_tsv_all},
        distance_html_all => $args{distance_html_all},
        success_html_all  => $args{success_html_all},
        hashed_alleles_all => $allele_table ,
    );

    push @{ $rundata{clustering}{results} }, \%entry;

    my $n = scalar @{ $rundata{clustering}{results} || [] };
    

    return 1;
}

