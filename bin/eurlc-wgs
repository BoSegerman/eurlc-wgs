    my $hitcount = $result_ref->{hit_count} // 0;
   
   for(my $i=0;$i<$hitcount; $i++){
     my $amrhits_symbol = $result_ref->{amr_hits}[$i]->{element_symbol} // "n/a";
     my $amrhits_name = $result_ref->{amr_hits}[$i]->{element_name} // "n/a";
     log_message("NOTICE: Sample $sample_name: AMR-hit:  $amrhits_symbol ($amrhits_name)", "green");
  }
  
      # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{txt_report}   =   path_relative_to_outdir(fill_placeholders("__DIR-AMR__/amrfinderplus/__BASE__.txt",$samplenr, $runstep_name)); 



    return 1; # success
}

# PARSER---------------------------------

sub parse_amrfinderplus {
    my ($resultfile, $samplenr) = @_;

    my %amr_data;          # final hash structure
    my @amr_hits;          # list of AMR hits (each a hashref)
    my $sample_name = $R_samples->[$samplenr]{name};

    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open AMRFinderPlus result file for sample $sample_name [$resultfile]");
        return {};
    }

    # Read header line
    my $header = <$fh>;
    unless ($header) {
        close $fh;
        log_message("WARNING: empty AMRFinderPlus result file for sample $sample_name [$resultfile]");
        return {};
    }

    chomp $header;
    my @columns = split /\t/, $header;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;

        my @fields = split /\t/, $line;

        # Map each column to a hash key
        my %entry;
        @entry{@columns} = @fields;

        # Optionally normalize keys
        for my $key (keys %entry) {
            my $normkey = lc($key);
            $normkey =~ s/[^a-z0-9]+/_/g;
            $entry{$normkey} = delete $entry{$key};
        }

        push @amr_hits, \%entry;
    }

    close $fh;

    # Attach list of hits to top-level hash
    $amr_data{amr_hits} = \@amr_hits;
    $amr_data{hit_count} = scalar @amr_hits;

    return \%amr_data;
}

