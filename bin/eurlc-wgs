###############################################################################################

sub match_species_or_genus {
    my ($available_str, $detected_species) = @_;
    return "Other" unless defined $available_str && defined $detected_species;

    # Split the comma-separated list and trim whitespace
    my @available = map {
        s/^\s+|\s+$//g;   # trim
        $_;
    } split /,/, $available_str;

    # Prepare lowercase lookup table for case-insensitive matching
    my %available_lookup = map { lc($_) => $_ } @available;

    # Trim detected species and prepare lowercase
    $detected_species =~ s/^\s+|\s+$//g;
    my $detected_lc = lc($detected_species);

    # 1 Try full species match
    if (exists $available_lookup{$detected_lc}) {
        return $available_lookup{$detected_lc};
    }

    # 2 Try genus-only match
    my ($genus) = split /\s+/, $detected_species;
    if ($genus && exists $available_lookup{lc($genus)}) {
        return $available_lookup{lc($genus)};
    }

    # 3 No match found
    return "Other";
}

# Resolves the correct AMRFinderPlus --organism value for a detected species,
# checking species-level first, then genus-level, against the curated
# amrfinderplus.available_organisms config list. Returns "" (not "Other" --
# AMRFinderPlus has no such catch-all) if neither matches, meaning --organism
# should be omitted entirely for this sample. Kept separate from
# match_species_or_genus() because AMRFinderPlus organism values use
# underscores (e.g. "Klebsiella_pneumoniae"), not spaces like the
# resfinder/pointfinder species lists, so genus extraction has to happen
# before underscore conversion.
sub resolve_amrfinderplus_organism {
    my ($detected_species) = @_;

    return "" unless defined $detected_species && $detected_species ne "" && lc($detected_species) ne "n/a";

    my $available_str = $R_cfg->{amrfinderplus}{available_organisms} // "";
    return "" if $available_str eq "";

    my @available = map { s/^\s+|\s+$//g; $_ } split /,/, $available_str;
    my %available_lookup = map { lc($_) => $_ } @available;

    $detected_species =~ s/^\s+|\s+$//g;

    # 1. Species-level match (e.g. detected "Klebsiella pneumoniae" -> "Klebsiella_pneumoniae")
    (my $species_underscored = $detected_species) =~ s/\s+/_/g;
    if (exists $available_lookup{lc($species_underscored)}) {
        return $available_lookup{lc($species_underscored)};
    }

    # 2. Genus-level match (e.g. "Campylobacter", "Escherichia", "Salmonella")
    my ($genus) = split /\s+/, $detected_species;
    if ($genus && exists $available_lookup{lc($genus)}) {
        return $available_lookup{lc($genus)};
    }

    # 3. No curated organism available for this species/genus -- caller should
    #    omit --organism entirely (e.g. currently the case for Listeria).
    return "";
}
###################################################################################################
## find_fastmlst_db_path

sub find_fastmlst_db_path {

    my $home = $ENV{HOME};
    my $conda_prefix = $ENV{CONDA_PREFIX} // "";
    my @candidate_paths;

    # If conda environment is active — use known structure
    if ($conda_prefix) {
        push @candidate_paths, "$conda_prefix/lib/python3.13/site-packages/fastmlst/pubmlst";
    }

    # Fall back to common locations if CONDA_PREFIX is not set
    push @candidate_paths,
        "$home/miniconda3/envs/$R_cfg->{fastmlst}->{env}/lib/python3.13/site-packages/fastmlst/pubmlst",
        "$home/miniconda3/envs/$R_cfg->{fastmlst}->{env}/lib/python*/site-packages/fastmlst/pubmlst",
        "$home/anaconda3/envs/$R_cfg->{fastmlst}->{env}/lib/python*/site-packages/fastmlst/pubmlst";

    # If nothing yet, try to infer from the path of fastmlst executable
    chomp(my $fastmlst_path = `conda run -n $R_cfg->{fastmlst}->{env} --no-capture-output which fastmlst 2>/dev/null`);
    if ($fastmlst_path && $fastmlst_path =~ m{^(/.+?)/bin/fastmlst$}) {
        my $base = $1;
        push @candidate_paths, "$base/lib/python*/site-packages/fastmlst/pubmlst";
    }

    # Check each possible path
    for my $pattern (@candidate_paths) {
        my @matches = glob($pattern);
        for my $path (@matches) {
            if (-d $path) {
                log_message("INFO: Found FastMLST database at $path");
                return $path;
            }
        }
    }

    # Could not find any match
    log_message("WARNING: Could not locate FastMLST database path", "yellow");
    return "";
}

###################################################################################################
## file_age_days

sub file_age_days {
    my ($filepath) = @_;

    unless (-e $filepath) {
        log_message("INFO: file not found when calculating file-age: $filepath");
        return -1;
    }

    my $mtime = (stat($filepath))[9];   # modification time (epoch seconds)
    my $now   = time();

    my $age_seconds = $now - $mtime;
    my $age_days    = $age_seconds / 86400;   # seconds per day

    # Round to one decimal place (optional)
    $age_days = sprintf("%.1f", $age_days);

    return $age_days;
}

###################################################################################################
## wrap_cmd

sub wrap_cmd {
    my ($cmd) = @_;

    # Replace your __NEWCOMMAND__ markers with semicolons for Bash separation
    $cmd =~ s/__NEWCOMMAND__/;/g;

    # Collapse actual newlines and extra whitespace into spaces
    $cmd =~ s/\s*\n\s*/ /g;

    # Prepend change-directory to data dir
    my $indir = getdir("in");
    return "cd '$indir'; $cmd";
}


###################################################################################################

sub is_disabled {
    my ($value) = @_;
    return 0 unless defined $value;
    return $value =~ /^(0|no|false|off)$/i;
}


sub require_input_files {
    my ($samplenr, $runstep_name, $mode, @placeholders) = @_;

    my $sample_name = $R_samples->[$samplenr]{name} // "unknown"; 
    
    my @missing;

    foreach my $ph (@placeholders) {
        my $file = fill_placeholders($ph, $samplenr, $runstep_name);
        push @missing, $file if !defined $file || $file eq "" || !-s $file;
    }

    if (@missing) {
        my $msg = "$runstep_name (sample $sample_name) input file(s) missing: " . join(" ", @missing);

        if ($mode && $mode eq "fatal") {
            set_runtime_issue($samplenr, "fail", $msg, $runstep_name);
            return 0;
        }
        else {
            set_runtime_issue($samplenr, "warning", $msg, $runstep_name);
            log_message("WARNING: $msg", "yellow");
            return 0;
        }
    }

    return 1;
}
###################################################################################################
## fill_placeholders

sub fill_placeholders {

   my ($cmd, $samplenr, $runstep_name,$warnings) = @_;

    $samplenr //= "";   # default to empty string if undef
    $runstep_name //= "";  #can also be an environment name
    $warnings //= 1;
    if ($warnings && !defined $cmd) {
      log_message("INFO: Warning, an undefined command was passed to fill_placeholders");
      return "";
    }
    $cmd //= "";   # default to empty string if undef

 
 
   if($runstep_name ne "" && exists($runstep{$runstep_name})){
      if( $cmd =~ /__OUTDIR__/ ) { _fill_placeholders__safe_replace(\$cmd, "__OUTDIR__", $runstep{$runstep_name}{output_dir} ); }
   }
    
    if( $cmd =~ /__CONDABASE__/ ) { _fill_placeholders__safe_replace(\$cmd, "__CONDABASE__", getdir("conda") ); }
    if( $cmd =~ /__DIR-LOG__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-LOG__", getdir("out,log") ); }
    if( $cmd =~ /__DIR-PROGRAM__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-PROGRAM__", getdir("program") ); }
    if( $cmd =~ /__DIR-IN__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-IN__", getdir("in") ); }
    if( $cmd =~ /__DIR-HOME__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-HOME__", getdir("home") ); }
    if( $cmd =~ /__DIR-OUT__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-OUT__", getdir("out") ); }
    if( $cmd =~ /__DIR-DB__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-DB__", getdir("db") ); }
    if( $cmd =~ /__DB__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DB__", getdir("db") ); }
    if( $cmd =~ /__DIR-QC__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC__", getdir("out,results,qc" ) ); }
    if( $cmd =~ /__DIR-QC1__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC1__", getdir("out,results,qc,stage1_rawdata" ) ); }    
    if( $cmd =~ /__DIR-QC2__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC2__", getdir("out,results,qc,stage2_trimmeddata" ) ); }    
    if( $cmd =~ /__DIR-QC3__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC3__", getdir("out,results,qc,stage3_assemblies" ) ); }
    if( $cmd =~ /__DIR-QC4__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC4__", getdir("out,results,qc,stage4_analysis" ) ); }            
    if( $cmd =~ /__DIR-ASSEMBLIES__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-ASSEMBLIES__", getdir("out,results,assemblies" ) ); }
    if( $cmd =~ /__DIR-TYPING__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-TYPING__", getdir("out,results,typing" ) ); }
    if( $cmd =~ /__DIR-CLUSTERING__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-CLUSTERING__", getdir("out,results,clustering" ) ); }
    if( $cmd =~ /__DIR-AMR__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-AMR__", getdir("out,results,amr" ) ); }
    if( $cmd =~ /__DIR-FASTQ__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-FASTQ__", getdir("out,large_files,fastq" ) ); }
    if( $cmd =~ /__DIR-TRIMMED__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-TRIMMED__", getdir("out,large_files,fastq,trimmed" ) ); }
    if( $cmd =~ /__DIR-TRIMMED-DOWNSAMPLED__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-TRIMMED-DOWNSAMPLED__", getdir("out,large_files,fastq,trimmed_downsampled" ) ); }
    if( $cmd =~ /__DIR-ANNOTATED__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-ANNOTATED__", getdir("out,results,assemblies,annotated" ) ); }
    if( $cmd =~ /__DIR-ALTERNATIVE-ASSEMBLIES__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-ALTERNATIVE-ASSEMBLIES__", getdir("out,results,assemblies,alternative_assemblies" ) ); }
    if( $cmd =~ /__DIR-QC-RAW__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC-RAW__", getdir("out,results,qc,raw_data_qc" ) ); }
    if( $cmd =~ /__DIR-QC-TRIMMED__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC-TRIMMED__", getdir("out,results,qc,trimmed_data_qc" ) ); }
    if( $cmd =~ /__DIR-QC-ASSEMBLIES__/ ) { _fill_placeholders__safe_replace(\$cmd, "__DIR-QC-ASSEMBLIES__", getdir("out,results,qc,assemblies_qc" ) ); }



    
    if($samplenr ne ""){    
      _fill_placeholders__safe_replace(\$cmd, "__BASE__", $R_samples->[$samplenr]{name} );
      _fill_placeholders__safe_replace(\$cmd, "__R1__", $R_samples->[$samplenr]{paths}{raw}{R1} );
      _fill_placeholders__safe_replace(\$cmd, "__R2__", $R_samples->[$samplenr]{paths}{raw}{R2} );
      _fill_placeholders__safe_replace(\$cmd, "__R1T__", $R_samples->[$samplenr]{paths}{trimmed}{R1} );
      _fill_placeholders__safe_replace(\$cmd, "__R2T__", $R_samples->[$samplenr]{paths}{trimmed}{R2} );
      _fill_placeholders__safe_replace(\$cmd, "__R1TD__", $R_samples->[$samplenr]{paths}{downsampled}{R1} );
      _fill_placeholders__safe_replace(\$cmd, "__R2TD__", $R_samples->[$samplenr]{paths}{downsampled}{R2} );
      _fill_placeholders__safe_replace(\$cmd, "__FASTA__", $R_samples->[$samplenr]{paths}{raw}{FASTA} );        
      _fill_placeholders__safe_replace(\$cmd, "__SE__", $R_samples->[$samplenr]{paths}{raw}{SE} );
      _fill_placeholders__safe_replace(\$cmd, "__SET__", $R_samples->[$samplenr]{paths}{trimmed}{SE} );
      _fill_placeholders__safe_replace(\$cmd, "__SETD__", $R_samples->[$samplenr]{paths}{downsampled}{SE} );
    }
    
    
    _fill_placeholders__safe_replace(\$cmd, "__THREADS__", $R_cfg->{general}{threads} );
    _fill_placeholders__safe_replace(\$cmd, "__HIDE-OUTPUT__", $capture_output );
    _fill_placeholders__safe_replace(\$cmd, "__HIDE-STDERR__", $capture_stderr );

    
 
    
    if($warnings && $cmd =~ /__/) {  log_message("WARNING: Unreplaced placeholder found in command: $cmd"); }
    
return $cmd;

}

##############################

# Use this (not a plain s/PLACEHOLDER/$value/g) for ANY placeholder substitution
# in command strings, including runstep-specific replacements. Two things it
# does that a plain s///g does not:
#
#   1. UNDEF SAFETY: if $value is undef, the placeholder is left UNCHANGED
#      instead of silently vanishing into an empty string. This matters
#      because fill_placeholders() has a final check that warns if any
#      "__..__" placeholder is still present after all substitutions --
#      that check can only catch a missed/undef value if the placeholder
#      survives. A plain s///g would make the placeholder disappear and the
#      command would be silently wrong (e.g. missing an argument) instead of
#      triggering that warning.
#
#   2. \Q...\E on the placeholder: protects against the placeholder name
#      itself being misinterpreted as a regex if it were ever changed to
#      include a regex-special character (not the case for any current
#      "__FOO__"-style name, but cheap insurance).
#
# Tested and confirmed: a $value that itself contains characters like "$1"
# or a literal backslash is NOT a risk with plain s///g either -- Perl
# inserts the variable's content as-is without re-parsing backreference or
# escape syntax inside it. So the real, demonstrated benefit here is #1
# (undef handling), not metacharacter escaping of the value.
sub _fill_placeholders__safe_replace {
    my ($string, $placeholder, $value) = @_;
    return unless defined $$string;
    $$string =~ s/\Q$placeholder\E/defined $value ? $value : $placeholder/ge;
}






####################################################################################################


sub find_chewie_resultpath {
    my ($output_dir) = @_;

    return undef if !defined $output_dir || !-d $output_dir;

    my $standard = File::Spec->catdir($output_dir, "results");

    # Prefer the normalized results folder if it exists
    return $standard if -d $standard;

    opendir(my $dh, $output_dir) or do {
        log_message("WARNING: Cannot open ChewBBACA output directory [$output_dir]: $!");
        return undef;
    };

    my @candidates =
        grep {
            -d File::Spec->catdir($output_dir, $_)
            && /^results_/
        }
        readdir($dh);

    closedir($dh);

    return undef if !@candidates;

    @candidates = sort {
        (stat(File::Spec->catdir($output_dir, $b)))[9]
            <=>
        (stat(File::Spec->catdir($output_dir, $a)))[9]
    } @candidates;

    return File::Spec->catdir($output_dir, $candidates[0]);
}
#################################################################33
sub list_all_chewie_resultpath(){

my $output_dir = shift(@_);

opendir(my $dh, $output_dir) or graceful_die("Cannot open directory $output_dir: $!");
my @subdirs =
    grep { -d File::Spec->catfile($output_dir, $_) && !/^\./ }
    readdir($dh);
closedir($dh);

return map { File::Spec->catfile($output_dir, $_) } @subdirs;

}
