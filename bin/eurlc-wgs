## runstep chewbbaca

$runstep_name = "chewbbaca";

$runstep{$runstep_name} = {
      message    => "Running Chewbbaca...",
      long_name  => "Chewbbaca",
      output_dir => "__DIR-CLUSTERING__/chewbbaca/__SUBDIR__",
