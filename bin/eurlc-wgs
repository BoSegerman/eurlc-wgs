###################################################################################################
## detect replacement script
## (docker development mode)

my $debug_replacement = "/db/run.perl";

# If runmode is docker AND a replacement script exists AND we’re not already running it
if ( is_docker()  && -f $debug_replacement && $0 ne $debug_replacement) {
    exec $debug_replacement, @ARGV
    or do {
            # If exec fails, continue with warning
            my $err = $!;
            log_message("WARNING: Failed to exec [$debug_replacement]. Continuing with container version of run.perl. Msg: [$err]","red");
        };
}

elsif( is_docker()  && $0 eq $debug_replacement ){
  log_message("NOTICE: Overriding container version of run.perl with [$0]" ); 
}


