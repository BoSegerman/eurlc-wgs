    conda run -n $R_cfg->{resfinder}->{env} --no-capture-output run_resfinder.py 
       -o __OUTDIR__
       -s __RESFINDER-SPECIES__
       --db_path_res $R_cfg->{resfinder}->{db_path}/resfinder_db
       __POINTDB__
       $R_cfg->{resfinder}->{arguments} 
       -ifa __DIR-ASSEMBLIES__/__BASE__.fasta 
       __HIDE-OUTPUT__
CMD

