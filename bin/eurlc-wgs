# {
#  sequence => {
#    length => "1729249",
#    count => "41",
#    gc => "30.2"
#  },
#  annotation => {
#    trnas => "43",
#    rrnas => "3"
#  },
#  bakta => {
#    software => "v1.10.4",
#    database => "v5.1, light"
#  }
#}

