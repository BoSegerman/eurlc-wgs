$runstep{$runstep_name}{test} = \&test_remap;

sub test_remap {

  return check_conda_tool("bowtie2");

   


}

# PRE---------------------------------



$runstep{$runstep_name}{preprocessing} = \&preprocess_remap;

sub preprocess_remap {

    my ($samplenr) = @_;

    my $runstep_name = "remap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # remap is currently PE-only
    if ($sample_type ne "PE") {
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta", "__R1TD__", "__R2TD__" );

    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_remap($samplenr);
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_remap;

$runstep{$runstep_name}{result_parsing} = \&postprocess_remap;

sub postprocess_remap {
    my ($samplenr) = @_;

    my $runstep_name = "remap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # remap is currently PE-only
    if ($sample_type ne "PE") {
        return "";
    }

    my $output_dir       = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);
    my $cachefile        = fill_placeholders($runstep{$runstep_name}{cachefile}, $samplenr, $runstep_name);
    my $mixed_sites_tsv  = fill_placeholders($runstep{$runstep_name}{mixed_sites_tsv}, $samplenr, $runstep_name);

    my $result_ref;

    if (-f $cachefile && -f $mixed_sites_tsv) {
        log_message("INFO: Using cached remap QC JSON for sample $sample_name", "green");
        $result_ref = read_json($cachefile);

        if (!$result_ref || ref($result_ref) ne 'HASH') {
            log_message("WARNING: Cached remap QC JSON is invalid for sample $sample_name. Re-parsing source files.", "yellow");
            $result_ref = undef;
        }
    }

    if (!$result_ref) {
        log_message("INFO: Parsing remap QC files for sample $sample_name", "green");
        $result_ref = parse_remap_qc($output_dir, $samplenr);

        if ($result_ref && ref($result_ref) eq 'HASH') {
            write_json_file($result_ref,$cachefile);
        }
        else {
            log_message("WARNING: Remap QC parser did not return a valid hashref for sample $sample_name", "yellow");
            return 0;
        }
    }

    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref;

    my $picked = $result_ref->{mapping}{samtools_stats_sn_picked} // {};
    my $cov    = $result_ref->{coverage} // {};
    my $mix    = $result_ref->{mixture} // {};

    my $fmt = sub {
        my ($value, $suffix) = @_;
        return "n/a" if !defined $value || $value eq "";
        return $value . ($suffix // "");
    };

    my $fmt_percent = sub {
        my ($value) = @_;
        return "n/a" if !defined $value || $value eq "";
        return $value . "%";
    };

    my $fmt_error_rate = sub {
        my ($value) = @_;
        return "n/a" if !defined $value || $value eq "";
        return "n/a" unless $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/;
        return sprintf("%.5f%%", 100 * $value);
    };

    print_tabular_results("reads_mapped",         $fmt_percent->($picked->{reads_mapped_pct}));
    print_tabular_results("properly_paired",      $fmt_percent->($picked->{properly_paired_pct}));
    print_tabular_results("error_rate, base level", $fmt_error_rate->($result_ref->{mapping}{error_rate}));

    print_tabular_results("average read length",  $fmt->($picked->{average_length}));
    print_tabular_results("average Q score value", $fmt->($picked->{average_quality}));
    print_tabular_results("insert_size_average",  $fmt->($picked->{insert_size_average}));

    print_tabular_results("Mean depth",           $fmt->($cov->{depth_mean}, "X"));
    print_tabular_results("Median depth",         $fmt->($cov->{depth_median}, "X"));
    print_tabular_results("Q1 depth",             $fmt->($cov->{depth_q1}, "X"));
    print_tabular_results("Q3 depth",             $fmt->($cov->{depth_q3}, "X"));
    print_tabular_results("Depth IQR",            $fmt->($cov->{depth_iqr}));
    print_tabular_results("Depth IQR over median", $fmt->($cov->{depth_iqr_over_median}));
    print_tabular_results("Depth SD",             $fmt->($cov->{depth_sd}));

    print_tabular_results("Breadth of coverage at 1X",  $fmt_percent->($cov->{breadth_1x_pct}));
    print_tabular_results("Breadth of coverage at 10X", $fmt_percent->($cov->{breadth_10x_pct}));
    print_tabular_results("Breadth of coverage at 20X", $fmt_percent->($cov->{breadth_20x_pct}));
    print_tabular_results("Breadth of coverage at 30X", $fmt_percent->($cov->{breadth_30x_pct}));

    print_tabular_results("SNP callable genome at >=20X (bases)", $fmt->($mix->{"callable_sites_dp_ge_20"}));
    print_tabular_results("SNP callable genome at >=20X (%)",     $fmt_percent->($cov->{breadth_20x_pct}));

    print_tabular_results(
        "positions (>=20X) with minor allele fraction 5-10%",
        $fmt->($mix->{"sites_minoraf_0_05_to_0_10_dp20"})
    );
    print_tabular_results(
        "positions (>=20X) with minor allele fraction 10-20%",
        $fmt->($mix->{"sites_minoraf_0_10_to_0_20_dp20"})
    );
    print_tabular_results(
        "positions (>=20X) with minor allele fraction >=20%",
        $fmt->($mix->{"sites_minoraf_ge_0_20_dp20"})
    );



    
    return 1;
}




###############################################################################
# REMAPPING QC RESULT STRUCTURE OVERVIEW
#
# $res = {
#
#   files => {
#       flagstats        => "<samtools flagstat output>",
#       coverage         => "<samtools coverage output>",
#       idxstats         => "<samtools idxstats output>",
#       stats            => "<samtools stats output>",
#       snps_bcf         => "<optional SNP BCF path, if later added>",
#       depth_tsv        => "<samtools depth -aa output>",
#       pileup           => "<samtools mpileup.gz output>",
#       mixed_sites_tsv  => "<tab-delimited table of mixed positions>",
#   },
#
#   mapping => {
#       # ---- parsed from samtools flagstat ----
#       flagstat => {
#           reads_total           => int,
#           reads_mapped          => int,
#           reads_mapped_pct      => float,
#           properly_paired       => int,
#           properly_paired_pct   => float,
#           paired_in_sequencing  => int,
#           read1                 => int,
#           read2                 => int,
#           singletons            => int,
#           singletons_pct        => float,
#       },
#
#       # ---- parsed from samtools stats (selected SN fields) ----
#       samtools_stats_sn_picked => {
#           raw_total_sequences        => int,
#           sequences                  => int,
#           reads_mapped               => int,
#           reads_unmapped             => int,
#           reads_properly_paired      => int,
#           reads_mapped_and_paired    => int,
#           reads_MQ0                  => int,
#
#           bases_mapped_cigar         => int,
#           mismatches                 => int,
#           error_rate                 => float,
#
#           average_length             => float,
#           average_quality            => float,
#
#           insert_size_average        => float,
#           insert_size_sd             => float,
#
#           inward_oriented_pairs      => int,
#           outward_oriented_pairs     => int,
#           other_orientation_pairs    => int,
#           pairs_diff_chromosomes     => int,
#
#           properly_paired_pct        => float,
#           reads_mapped_pct           => float,   # derived if possible
#       },
#
#       # ---- full SN key-value table from samtools stats ----
#       samtools_stats_sn_all => {
#           "<samtools SN key>" => "<value>",
#           ...
#       },
#
#       # ---- convenience aliases copied from samtools_stats_sn_picked ----
#       raw_total_sequences        => int,
#       sequences                  => int,
#       reads_mapped               => int,
#       reads_unmapped             => int,
#       reads_properly_paired      => int,
#       reads_mapped_and_paired    => int,
#       reads_MQ0                  => int,
#       bases_mapped_cigar         => int,
#       mismatches                 => int,
#       error_rate                 => float,
#       average_length             => float,
#       average_quality            => float,
#       insert_size_average        => float,
#       insert_size_sd             => float,
#       inward_oriented_pairs      => int,
#       outward_oriented_pairs     => int,
#       other_orientation_pairs    => int,
#       pairs_diff_chromosomes     => int,
#       properly_paired_pct        => float,
#       reads_mapped_pct           => float,
#
#       # ---- parsed from idxstats ----
#       idxstats_total_mapped      => int,
#       idxstats_total_unmapped    => int,
#
#       top_contigs_by_mapped_reads => [
#           {
#               contig   => "<contig name>",
#               length   => int,
#               mapped   => int,
#               unmapped => int,
#           },
#           ...
#       ],
#   },
#
#   coverage => {
#       # ---- parsed from idxstats ----
#       idxstats_total_ref_len => int,
#
#       contig_lengths => {
#           "<contig name>" => int,
#           ...
#       },
#
#       # ---- parsed from samtools coverage ----
#       per_contig => [
#           {
#               contig       => "<contig name>",
#               covbases     => int | undef,
#               coverage_pct => float | undef,
#               meandepth    => float | undef,
#           },
#           ...
#       ],
#
#       genome_len_from_coverage => int,
#       covered_bases_1x         => int,
#       breadth_1x_pct           => float,
#       mean_depth_weighted      => float,
#
#       # ---- parsed from samtools depth -aa (whole genome) ----
#       depth_positions_total      => int,
#       depth_mean                 => float,
#       depth_sd                   => float,
#       depth_cv                   => float,
#       depth_q1                   => int,
#       depth_median               => int,
#       depth_q3                   => int,
#       depth_iqr                  => int,
#       depth_iqr_over_median      => float,
#
#       breadth_1x_pct             => float,
#       breadth_10x_pct            => float,
#       breadth_20x_pct            => float,
#       breadth_30x_pct            => float,
#
#       # ---- parsed from samtools depth -aa (per contig medians) ----
#       depth_per_contig => {
#           "<contig name>" => {
#               median_depth => int,
#               positions    => int,
#           },
#           ...
#       },
#   },
#
#   variants => {
#       # currently reserved / not actively populated in this version
#   },
#
#   mixture => {
#       # ---- callable sites in pileup at minimum depth ----
#       callable_sites_dp_ge_20           => int,
#
#       # ---- disjoint minor-allele-fraction bins ----
#       sites_minoraf_0_05_to_0_10_dp20   => int,
#       sites_minoraf_0_10_to_0_20_dp20   => int,
#       sites_minoraf_ge_0_20_dp20        => int,
#
#       rate_minoraf_0_05_to_0_10_dp20    => float,
#       rate_minoraf_0_10_to_0_20_dp20    => float,
#       rate_minoraf_ge_0_20_dp20         => float,
#
#       # ---- overall minor AF distribution among callable sites ----
#       minoraf_median_dp20               => float | undef,
#       minoraf_p95_dp20                  => float | undef,
#   },
#
#   warnings => [
#       "Missing flagstats file",
#       "Missing depth file",
#       "Could not compute genome_len from coverage file (missing start/end cols?)",
#       ...
#   ],
# };
#
#
# MIXED POSITIONS TSV (files->{mixed_sites_tsv})
#
# Header:
# contig    contig_length    position    ref_base    depth    median_depth
# depth_over_median    major_base    major_base_count    disagree_count
# minor_af    filtered
#
# Where:
#   contig             = contig/chromosome name
#   contig_length      = length from idxstats
#   position           = 1-based genomic position
#   ref_base           = reference base from pileup
#   depth              = total pileup depth at the position
#   median_depth       = per-contig median depth from depth file
#   depth_over_median  = depth / per-contig median depth
#   major_base         = most supported base in pileup (A/C/G/T)
#   major_base_count   = count of reads supporting major_base
#   disagree_count     = depth - major_base_count
#   minor_af           = disagree_count / depth
#   filtered           = placeholder flag for future filtering logic
#
###############################################################################



sub parse_remap_qc {
    my ($dir, $samplenr) = @_;

    my $base = fill_placeholders("__BASE__", $samplenr);
    my $min_dp = 20;

    my $mixed_sites_tsv = File::Spec->catfile($dir, "$base.mixed_positions.tsv");

    my %res = (
        files => {
            flagstats       => File::Spec->catfile($dir, "$base.flagstats"),
            coverage        => File::Spec->catfile($dir, "$base.coverage"),
            idxstats        => File::Spec->catfile($dir, "$base.idxstats"),
            stats           => File::Spec->catfile($dir, "$base.stats"),
            snps_bcf        => File::Spec->catfile($dir, "$base.snps.bcf"),
            depth_tsv       => File::Spec->catfile($dir, "$base.depth.tsv"),
            pileup          => File::Spec->catfile($dir, "$base.pileup.gz"),
            mixed_sites_tsv => $mixed_sites_tsv,
        },
        mapping  => {},
        coverage => {},
        variants => {},
        warnings => [],
    );

    # ---------- helpers ----------
    my $read_lines = sub {
        my ($path) = @_;
        return [] unless -e $path;

        open(my $fh, "<", $path) or do {
            log_message("WARNING: Cannot open [$path]: $!", "yellow");
            return [];
        };

        my @l = <$fh>;
        close($fh);
        return \@l;
    };

    my $pct = sub {
        my ($num, $den) = @_;
        return undef if !defined($den) || $den == 0;
        return sprintf("%.4f", 100 * $num / $den);
    };

    # ---------- parse flagstat ----------
    if (-e $res{files}{flagstats}) {
        my $lines = $read_lines->($res{files}{flagstats});
        my %fs;

        for my $ln (@$lines) {
            chomp($ln);

            if ($ln =~ /^(\d+)\s+\+\s+\d+\s+in total/) {
                $fs{reads_total} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+mapped\s+\(([\d.]+)%/) {
                $fs{reads_mapped}     = $1;
                $fs{reads_mapped_pct} = $2;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+properly paired\s+\(([\d.]+)%/) {
                $fs{properly_paired}     = $1;
                $fs{properly_paired_pct} = $2;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+paired in sequencing/) {
                $fs{paired_in_sequencing} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+read1/) {
                $fs{read1} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+read2/) {
                $fs{read2} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+singletons\s+\(([\d.]+)%/) {
                $fs{singletons}     = $1;
                $fs{singletons_pct} = $2;
            }
        }

        if (defined $fs{reads_total} && defined $fs{reads_mapped} && !defined $fs{reads_mapped_pct}) {
            $fs{reads_mapped_pct} = $pct->($fs{reads_mapped}, $fs{reads_total});
        }

        $res{mapping}{flagstat} = \%fs;
    }
    else {
        push @{ $res{warnings} }, "Missing flagstats file";
    }

    # ---------- parse samtools stats (SN lines) ----------
    if (-e $res{files}{stats}) {
        my $lines = $read_lines->($res{files}{stats});
        my %sn;

        for my $ln (@$lines) {
            chomp($ln);
            next unless $ln =~ /^SN\t([^:]+):\t(.+)$/;
            my ($k, $v) = ($1, $2);

            $v =~ s/\t\#.*$//;
            $v =~ s/\s+\#.*$//;
            $k =~ s/^\s+|\s+$//g;
            $v =~ s/^\s+|\s+$//g;

            $sn{$k} = $v;
        }

        my $get = sub {
            my ($key) = @_;
            return undef unless exists $sn{$key};
            my $v = $sn{$key};
            $v =~ s/,/./g if $key =~ /percentage/i;
            $v =~ s/^\s+|\s+$//g;
            return $v;
        };

        my %picked = (
            raw_total_sequences        => $get->('raw total sequences'),
            sequences                  => $get->('sequences'),
            reads_mapped               => $get->('reads mapped'),
            reads_unmapped             => $get->('reads unmapped'),
            reads_properly_paired      => $get->('reads properly paired'),
            reads_mapped_and_paired    => $get->('reads mapped and paired'),
            reads_MQ0                  => $get->('reads MQ0'),

            bases_mapped_cigar         => $get->('bases mapped (cigar)'),
            mismatches                 => $get->('mismatches'),
            error_rate                 => $get->('error rate'),

            average_length             => $get->('average length'),
            average_quality            => $get->('average quality'),

            insert_size_average        => $get->('insert size average'),
            insert_size_sd             => $get->('insert size standard deviation'),

            inward_oriented_pairs      => $get->('inward oriented pairs'),
            outward_oriented_pairs     => $get->('outward oriented pairs'),
            other_orientation_pairs    => $get->('pairs with other orientation'),
            pairs_diff_chromosomes     => $get->('pairs on different chromosomes'),

            properly_paired_pct        => $get->('percentage of properly paired reads (%)'),
        );

        if (defined $picked{raw_total_sequences} && $picked{raw_total_sequences} =~ /^\d+$/ &&
            defined $picked{reads_mapped}        && $picked{reads_mapped}        =~ /^\d+$/) {
            $picked{reads_mapped_pct} = sprintf("%.4f", 100 * $picked{reads_mapped} / $picked{raw_total_sequences});
        }

        if (defined $picked{bases_mapped_cigar} && $picked{bases_mapped_cigar} =~ /^\d+$/ &&
            defined $picked{mismatches}         && $picked{mismatches}         =~ /^\d+$/ &&
            (!defined $picked{error_rate} || $picked{error_rate} !~ /\S/)) {
            $picked{error_rate} = sprintf("%.6e", $picked{mismatches} / $picked{bases_mapped_cigar});
        }

        $res{mapping}{samtools_stats_sn_picked} = \%picked;
        $res{mapping}{samtools_stats_sn_all}    = \%sn;

        # Convenience aliases at mapping top level
        for my $k (keys %picked) {
            $res{mapping}{$k} = $picked{$k};
        }
    }
    else {
        push @{ $res{warnings} }, "Missing stats file";
    }

    # ---------- parse idxstats ----------
    if (-e $res{files}{idxstats}) {
        my $lines = $read_lines->($res{files}{idxstats});

        my $total_ref_len = 0;
        my $total_mapped  = 0;
        my $total_unmapped = 0;
        my @contigs;
        my %contig_lengths;

        for my $ln (@$lines) {
            chomp($ln);
            next if $ln eq "";

            my ($rname, $rlen, $mapped, $unmapped) = split(/\t/, $ln);
            next unless defined $unmapped;

            $total_ref_len += $rlen;
            $total_mapped  += $mapped;
            $total_unmapped += $unmapped;
            $contig_lengths{$rname} = 0 + $rlen;

            push @contigs, {
                contig   => $rname,
                length   => 0 + $rlen,
                mapped   => 0 + $mapped,
                unmapped => 0 + $unmapped,
            };
        }

        $res{coverage}{idxstats_total_ref_len} = $total_ref_len;
        $res{mapping}{idxstats_total_mapped}   = $total_mapped;
        $res{mapping}{idxstats_total_unmapped} = $total_unmapped;
        $res{coverage}{contig_lengths}         = \%contig_lengths;

        @contigs = sort { $b->{mapped} <=> $a->{mapped} } @contigs;
        splice(@contigs, 10) if @contigs > 10;
        $res{mapping}{top_contigs_by_mapped_reads} = \@contigs;
    }
    else {
        push @{ $res{warnings} }, "Missing idxstats file";
    }

    # ---------- parse samtools coverage ----------
    if (-e $res{files}{coverage}) {
        my $lines = $read_lines->($res{files}{coverage});

        my @hdr;
        my %col;
        my $header_seen = 0;

        my $total_len = 0;
        my $total_covbases = 0;
        my $sum_depth_x_len = 0;

        for my $ln (@$lines) {
            chomp($ln);
            next if $ln eq "";

            if ($ln =~ /^#/) {
                $ln =~ s/^\#//;
                @hdr = split(/\t/, $ln);
                %col = map { $hdr[$_] => $_ } 0 .. $#hdr;
                $header_seen = 1;
                next;
            }

            my @f = split(/\t/, $ln);

            my $rname     = $header_seen && exists $col{rname}     ? $f[$col{rname}]     : $f[0];
            my $startpos  = $header_seen && exists $col{startpos}  ? $f[$col{startpos}]  : undef;
            my $endpos    = $header_seen && exists $col{endpos}    ? $f[$col{endpos}]    : undef;
            my $covbases  = $header_seen && exists $col{covbases}  ? $f[$col{covbases}]  : undef;
            my $coverage  = $header_seen && exists $col{coverage}  ? $f[$col{coverage}]  : undef;
            my $meandepth = $header_seen && exists $col{meandepth} ? $f[$col{meandepth}] : undef;

            my $len = undef;
            if (defined $startpos && defined $endpos && $startpos =~ /^\d+$/ && $endpos =~ /^\d+$/) {
                $len = $endpos - $startpos + 1;
            }

            push @{ $res{coverage}{per_contig} }, {
                contig       => $rname,
                covbases     => defined($covbases)  ? 0 + $covbases  : undef,
                coverage_pct => defined($coverage)  ? 0 + $coverage  : undef,
                meandepth    => defined($meandepth) ? 0 + $meandepth : undef,
            };

            if (defined $len && defined $covbases && $len =~ /^\d+$/) {
                $total_len       += $len;
                $total_covbases  += $covbases;
                $sum_depth_x_len += (defined($meandepth) ? $meandepth : 0) * $len;
            }
        }

        if ($total_len > 0) {
            $res{coverage}{genome_len_from_coverage} = $total_len;
            $res{coverage}{covered_bases_1x}         = $total_covbases;
            $res{coverage}{breadth_1x_pct}           = sprintf("%.2f", 100 * $total_covbases / $total_len);
            $res{coverage}{mean_depth_weighted}      = sprintf("%.3f", $sum_depth_x_len / $total_len);
        }
        else {
            push @{ $res{warnings} }, "Could not compute genome_len from coverage file (missing start/end cols?)";
        }
    }
    else {
        push @{ $res{warnings} }, "Missing coverage file";
    }

    # ---------- breadth/depth from depth file ----------
    my $contig_depth_ref;
    if (-e $res{files}{depth_tsv}) {
        my $ds = depth_stats_from_file(path => $res{files}{depth_tsv}, cap => 5000);
        if ($ds) {
            @{ $res{coverage} }{ keys %$ds } = values %$ds;
        }

        $contig_depth_ref = depth_stats_per_contig_from_file(
            path => $res{files}{depth_tsv},
            cap  => 5000,
        );

        $res{coverage}{depth_per_contig} = $contig_depth_ref if defined $contig_depth_ref;
    }
    else {
        $res{coverage}{breadth_10x_pct} = undef;
        $res{coverage}{breadth_20x_pct} = undef;
        $res{coverage}{breadth_30x_pct} = undef;
        push @{ $res{warnings} }, "Missing depth file";
    }

    # ---------- pileup-based mixture metrics ----------
    my $mix = parse_pileup_minor_af_metrics(
        pileup             => $res{files}{pileup},
        min_dp             => $min_dp,
        out_tsv            => $mixed_sites_tsv,
        contig_depth_ref   => $contig_depth_ref,
        contig_lengths_ref => $res{coverage}{contig_lengths},
    );
    $res{mixture} = $mix if defined $mix;

    return \%res;
}

sub depth_stats_from_file {
    my (%opt) = @_;
    my $path = $opt{path};
    if (!defined $path || $path eq "") {
        log_message("WARNING: depth_stats_from_file: missing path", "yellow");
        return undef;
    }    
    
    my $cap  = $opt{cap} // 5000;   # cap huge depths
    my $min_pos = $opt{min_pos} // 1;

    unless (-s $path) {
        log_message("WARNING: Cannot read depth file, file missing or empty: [$path]", "yellow");
        return undef;
    }

    open(my $fh, "<", $path) or do {
        log_message("WARNING: Cannot open depth file [$path]: $!", "yellow");
        return undef;
    };

    my %hist;
    my $n = 0;
    my $sum = 0;

    my ($ge1, $ge10, $ge20, $ge30) = (0,0,0,0);

    while (my $ln = <$fh>) {
        chomp($ln);
        next if $ln eq "";
        my @f = split(/\t/, $ln);
        next unless @f >= 3;
        my $d = $f[2];
        next unless defined $d && $d =~ /^\d+$/;

        $n++;
        $sum += $d;

        $ge1 ++ if $d >= 1;
        $ge10++ if $d >= 10;
        $ge20++ if $d >= 20;
        $ge30++ if $d >= 30;

        $d = $cap if $d > $cap;
        $hist{$d}++;
    }
    close($fh);

    return undef if $n < $min_pos;

    my $q_from_hist = sub {
        my ($q) = @_; # 0..1
        my $target = int($q * ($n - 1));
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %hist) {
            $cum += $hist{$k};
            return $k if $cum > $target;
        }
        return (sort { $a <=> $b } keys %hist)[-1];
    };

    my $mean = $sum / $n;

    # If you also want SD/CV, compute it in a second pass over histogram:
    my $ss = 0;
    for my $k (keys %hist) {
        my $cnt = $hist{$k};
        my $diff = $k - $mean;
        $ss += $cnt * $diff * $diff;
    }
    my $sd = sqrt($ss / $n);
    my $cv = $mean > 0 ? ($sd / $mean) : undef;

    my $q1     = $q_from_hist->(0.25);
    my $median = $q_from_hist->(0.50);
    my $q3     = $q_from_hist->(0.75);
    my $iqr    = $q3 - $q1;

    return {
        depth_positions_total => $n,
        depth_mean            => sprintf("%.3f", $mean),
        depth_sd              => sprintf("%.3f", $sd),
        depth_cv              => defined($cv) ? sprintf("%.6f", $cv) : undef,

        depth_q1              => $q1,
        depth_median          => $median,
        depth_q3              => $q3,
        depth_iqr             => $iqr,
        depth_iqr_over_median => ($median > 0) ? sprintf("%.6f", $iqr / $median) : undef,

        breadth_1x_pct         => sprintf("%.5f", 100 * $ge1  / $n),
        breadth_10x_pct        => sprintf("%.5f", 100 * $ge10 / $n),
        breadth_20x_pct        => sprintf("%.5f", 100 * $ge20 / $n),
        breadth_30x_pct        => sprintf("%.5f", 100 * $ge30 / $n),
    };
}

sub depth_stats_per_contig_from_file {
    my (%opt) = @_;
    my $path = $opt{path};
    my $cap  = $opt{cap} // 5000;

    unless (-s $path) {
        log_message("WARNING: Cannot read depth file, file missing or empty: [$path]", "yellow");
        return undef;
    }

    open(my $fh, "<", $path) or do {
        log_message("WARNING: Cannot open depth file [$path]: $!", "yellow");
        return undef;
    };

    my %hist_by_contig;
    my %n_by_contig;

    while (my $ln = <$fh>) {
        chomp($ln);
        next if $ln eq "";
        my @f = split(/\t/, $ln);
        next unless @f >= 3;

        my ($contig, $pos, $d) = @f[0,1,2];
        next unless defined $d && $d =~ /^\d+$/;

        $n_by_contig{$contig}++;
        $d = $cap if $d > $cap;
        $hist_by_contig{$contig}{$d}++;
    }
    close($fh);

    my %out;

    for my $contig (keys %hist_by_contig) {
        my $n = $n_by_contig{$contig};
        next unless $n > 0;

        my $target = int(0.50 * ($n - 1));
        my $cum = 0;
        my $median = 0;

        for my $k (sort { $a <=> $b } keys %{ $hist_by_contig{$contig} }) {
            $cum += $hist_by_contig{$contig}{$k};
            if ($cum > $target) {
                $median = $k;
                last;
            }
        }

        $out{$contig}{median_depth} = $median;
        $out{$contig}{positions}    = $n;
    }

    return \%out;
}


sub parse_pileup_minor_af_metrics {
    my (%opt) = @_;

    my $pileup = $opt{pileup};
    my $min_dp = $opt{min_dp} // 20;
    my $out_tsv = $opt{out_tsv};
    my $contig_depth_ref = $opt{contig_depth_ref} // {};
    my $contig_lengths_ref = $opt{contig_lengths_ref} // {};

    if (!defined $pileup || $pileup eq "") {
        log_message("WARNING: parse_pileup_minor_af_metrics: missing pileup path", "yellow");
        return undef;
    }

    my $fh;
    if ($pileup =~ /\.gz$/) {
        unless (-s $pileup) {
            log_message("WARNING: Gzipped pileup file missing or empty: [$pileup]", "yellow");
            return undef;
        }
        open($fh, "-|", "gzip", "-dc", $pileup) or do {
            log_message("WARNING: Cannot open gzipped pileup [$pileup]: $!", "yellow");
            return undef;
        };
    }
    else {
        unless (-s $pileup) {
            log_message("WARNING: Pileup file missing or empty: [$pileup]", "yellow");
            return undef;
        }
        open($fh, "<", $pileup) or do {
            log_message("WARNING: Cannot open pileup [$pileup]: $!", "yellow");
            return undef;
        };
    }

    my $tfh;
    if (defined $out_tsv && $out_tsv ne "") {
        open($tfh, ">", $out_tsv) or do {
            log_message("WARNING: Cannot write mixed-position TSV [$out_tsv]: $!", "yellow");
            $tfh = undef;
        };

        if ($tfh) {
            print {$tfh} join("\t",
                qw(contig contig_length position ref_base depth median_depth depth_over_median major_base major_base_count disagree_count minor_af filtered)
            ), "\n";
        }
    }

    my $callable = 0;
    my $bin_5_10  = 0;
    my $bin_10_20 = 0;
    my $bin_ge_20 = 0;
    my @minor_afs;

    while (my $ln = <$fh>) {
        chomp($ln);
        next if $ln eq "";

        my ($chr, $pos, $ref, $dp, $bases, $quals) = split(/\t/, $ln);
        next unless defined $dp && $dp =~ /^\d+$/;
        next unless defined $ref && defined $bases;

        next if $dp < $min_dp;
        $callable++;

        my %cnt = (A => 0, C => 0, G => 0, T => 0);
        my $i    = 0;
        my $len  = length($bases);
        my $refU = uc($ref);

        while ($i < $len) {
            my $c = substr($bases, $i, 1);

            if ($c eq '^') {
                $i += 2;
                next;
            }
            if ($c eq '$') {
                $i++;
                next;
            }
            if ($c eq '+' || $c eq '-') {
                $i++;
                my $num = '';
                while ($i < $len) {
                    my $d = substr($bases, $i, 1);
                    last unless $d =~ /\d/;
                    $num .= $d;
                    $i++;
                }
                my $n = $num ne '' ? int($num) : 0;
                $i += $n;
                next;
            }
            if ($c eq '*') {
                $i++;
                next;
            }
            if ($c eq '.' || $c eq ',') {
                $cnt{$refU}++ if exists $cnt{$refU};
                $i++;
                next;
            }

            my $b = uc($c);
            if (exists $cnt{$b}) {
                $cnt{$b}++;
            }
            $i++;
        }

        my $major_base = "N";
        my $major_count = 0;
        for my $b (qw(A C G T)) {
            if ($cnt{$b} > $major_count) {
                $major_count = $cnt{$b};
                $major_base  = $b;
            }
        }

        my $disagree_count = $dp - $major_count;
        my $minor_af = $dp > 0 ? ($disagree_count / $dp) : 0;

        push @minor_afs, $minor_af;

        my $bin_hit = 0;
        if ($minor_af >= 0.05 && $minor_af < 0.10) {
            $bin_5_10++;
            $bin_hit = 1;
        }
        elsif ($minor_af >= 0.10 && $minor_af < 0.20) {
            $bin_10_20++;
            $bin_hit = 1;
        }
        elsif ($minor_af >= 0.20) {
            $bin_ge_20++;
            $bin_hit = 1;
        }

        if ($bin_hit && $tfh) {
            my $contig_len   = $contig_lengths_ref->{$chr} // "n/a";
            my $median_depth = $contig_depth_ref->{$chr}{median_depth} // "n/a";

            my $depth_over_median = "n/a";
            if (defined $median_depth && $median_depth =~ /^\d+(?:\.\d+)?$/ && $median_depth > 0) {
                $depth_over_median = sprintf("%.6f", $dp / $median_depth);
            }

            my $filtered = 0;   # placeholder for future filtering logic

            print {$tfh} join("\t",
                $chr,
                $contig_len,
                $pos,
                $ref,
                $dp,
                $median_depth,
                $depth_over_median,
                $major_base,
                $major_count,
                $disagree_count,
                sprintf("%.6f", $minor_af),
                $filtered
            ), "\n";
        }
    }

    close($fh);
    close($tfh) if $tfh;

    my %out;
    $out{"callable_sites_dp_ge_$min_dp"} = $callable;

    $out{"sites_minoraf_0_05_to_0_10_dp$min_dp"} = $bin_5_10;
    $out{"sites_minoraf_0_10_to_0_20_dp$min_dp"} = $bin_10_20;
    $out{"sites_minoraf_ge_0_20_dp$min_dp"}      = $bin_ge_20;

    $out{"rate_minoraf_0_05_to_0_10_dp$min_dp"} = $callable ? sprintf("%.6f", $bin_5_10  / $callable) : sprintf("%.6f", 0);
    $out{"rate_minoraf_0_10_to_0_20_dp$min_dp"} = $callable ? sprintf("%.6f", $bin_10_20 / $callable) : sprintf("%.6f", 0);
    $out{"rate_minoraf_ge_0_20_dp$min_dp"}      = $callable ? sprintf("%.6f", $bin_ge_20 / $callable) : sprintf("%.6f", 0);

    if (@minor_afs) {
        @minor_afs = sort { $a <=> $b } @minor_afs;
        my $n = @minor_afs;
        $out{"minoraf_median_dp$min_dp"} = sprintf("%.6f", $minor_afs[int($n / 2)]);
        $out{"minoraf_p95_dp$min_dp"}    = sprintf("%.6f", $minor_afs[int(0.95 * ($n - 1))]);
    }
    else {
        $out{"minoraf_median_dp$min_dp"} = undef;
        $out{"minoraf_p95_dp$min_dp"}    = undef;
    }

    return \%out;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep bakta 

$runstep_name = "bakta";

$runstep{$runstep_name} = {
      message    => "Running Bakta...",
      long_name  => "Bakta",
      output_dir => "__DIR-ANNOTATED__/__BASE__",
      resultfile => "__DIR-ANNOTATED__/__BASE__/__BASE__.txt",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{bakta}->{env} --no-capture-output bakta 
       --threads __THREADS__ 
       --output __OUTDIR__ 
       --db $R_cfg->{bakta}->{db_path} 
       __DIR-ASSEMBLIES__/__BASE__.fasta 
       __HIDE-OUTPUT__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_bakta;

sub test_bakta {

   return check_conda_tool("bakta");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_bakta;

sub preprocess_bakta {

    my ($samplenr) = @_;

    my $runstep_name = "bakta";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $command    = $runstep{$runstep_name}{cmd_template};   
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
    my $output_dir = fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr);   
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");


  if( -f $resultfile ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_bakta($samplenr);
        return "";
   }
   
   ensure_dir_not_exists(  dir  => $output_dir,  mode => 'remove' );  # bakta will not run if the output dir already exists (case dir exists but not resultfile)
             
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);
    
    #create output dir
  #  --bakta creates the output dir itself (cast an error if the dir already exists)
    
    return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_bakta;

sub postprocess_bakta {
    my ($samplenr) = @_;

    my $runstep_name = "bakta";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);   
        
    my $result_ref = parse_bakta($resultfile,$samplenr);
    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref; 


   log_message("NOTICE: Sample $sample_name: Coding density: $result_ref->{sequence}{coding_density}", "green");
   log_message("NOTICE: Sample $sample_name: CDSs: $result_ref->{annotation}{cdss}", "green");
   log_message("NOTICE: Sample $sample_name: tRNAs: $result_ref->{annotation}{trnas}", "green");
   log_message("NOTICE: Sample $sample_name: rRNAs: $result_ref->{annotation}{rrnas}", "green");
   log_message("NOTICE: Sample $sample_name: ncRNAs: $result_ref->{annotation}{ncrnas}", "green");   
   log_message("NOTICE: Sample $sample_name: Pseudogenes: $result_ref->{annotation}{pseudogenes}", "green");
   log_message("NOTICE: Sample $sample_name: Hypotheticals: $result_ref->{annotation}{hypotheticals}", "green");
   log_message("NOTICE: Sample $sample_name: Pseudogenes: $result_ref->{annotation}{pseudogenes}", "green");
   log_message("NOTICE: Sample $sample_name: OriCs: $result_ref->{annotation}{orics}", "green");   
       
    return 1; # success
}

# PARSER---------------------------------

sub parse_bakta {
    my ($resultfile, $samplenr) = @_;

    my %bakta_data;   # local hash structure to store parsed results

    my $sample_name = $R_samples->[$samplenr]{name};

    # Try to open the file
    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open Bakta result file for sample $sample_name [$resultfile]");
        return {};  # return empty hashref on failure
    }

    my $section = "";   # track current section: Sequence, Annotation, or Bakta

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\s+$//;     # trim trailing whitespace
        next if $line =~ /^\s*$/;  # skip empty lines

        # Detect section headers
        if ($line =~ /^Sequence\(s\):/) {
            $section = "sequence";
            next;
        }
        elsif ($line =~ /^Annotation:/) {
            $section = "annotation";
            next;
        }
        elsif ($line =~ /^Bakta:/) {
            $section = "bakta";
            next;
        }

        # Skip lines that don't look like key-value pairs
        next unless $line =~ /^(.+?):\s+(.+)$/;

        my ($key, $value) = ($1, $2);

        # Normalize key
        my $normalized_key = lc($key);
        $normalized_key =~ s/[^a-z0-9]+/_/g;

        # Store in sectioned hash
        $bakta_data{$section}{$normalized_key} = $value;
    }

    close $fh;

    return \%bakta_data;
}
 
# example output 
# {
#  sequence => {
#    length => "1729249",
#    count => "41",
#    gc => "30.2"
#  },
#  annotation => {
#    trnas => "43",
#    rrnas => "3"
#  },
#  bakta => {
#    software => "v1.10.4",
#    database => "v5.1, light"
#  }
#}

