sub xml_node_text {
    my ($context_node, $xpath) = @_;

    return '' if !defined $context_node || !defined $xpath || $xpath eq '';

    my ($node) = $context_node->findnodes($xpath);
    return $node ? $node->textContent : '';
}

sub parse_runparameters_rfid_block {
    my ($root, $block_name) = @_;

    return {} if !defined $root || !defined $block_name || $block_name eq '';

    my ($node) = $root->findnodes("./$block_name");
    return {} if !$node;

    return {
        serial_number   => xml_node_text($node, './SerialNumber'),
        part_number     => xml_node_text($node, './PartNumber'),
        expiration_date => xml_node_text($node, './ExpirationDate'),
        lot_number      => xml_node_text($node, './LotNumber'),
    };
}

sub normalize_runinfo_date {
    my ($d) = @_;
    return '' if !defined $d || $d !~ /^(\d{2})(\d{2})(\d{2})$/;

    my ($yy, $mm, $dd) = ($1, $2, $3);
    my $year = $yy >= 70 ? "19$yy" : "20$yy";

    return "$year-$mm-$dd";
}


sub parse_samplesheet_csv {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my %samplesheet = (
        header       => {},
        reads        => [],
        settings     => {},
        data_columns => [],
        data         => [],
        summary      => {},
    );

    my $csv;
    eval {
        require Text::CSV;
        $csv = Text::CSV->new({
            binary           => 1,
            allow_whitespace => 0,
            auto_diag        => 1,
        });
    };
    if ($@ || !$csv) {
        log_message("WARNING: Text::CSV not available, cannot parse SampleSheet.csv [$file]");
        return {};
    }

    open(my $fh, "<", $file) or do {
        log_message("WARNING: Could not open SampleSheet.csv [$file]: $!");
        return {};
    };

    my $section = '';
    my @data_columns;

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\r$//;

        next if $line =~ /^\s*$/;

        # Section headers like [Header]
        if ($line =~ /^\[(.+)\]\s*$/) {
            $section = lc($1);
            next;
        }

        # Parse line as CSV
        if (!$csv->parse($line)) {
            log_message("WARNING: Failed to parse CSV line in [$file]: [$line]");
            next;
        }

        my @fields = $csv->fields();

        if ($section eq 'header') {
            my $key   = defined $fields[0] ? $fields[0] : '';
            my $value = defined $fields[1] ? $fields[1] : '';
            next if $key eq '';
            $samplesheet{header}{$key} = $value;
        }
        elsif ($section eq 'reads') {
            my $readlen = defined $fields[0] ? $fields[0] : '';
            push @{ $samplesheet{reads} }, $readlen if $readlen ne '';
        }
        elsif ($section eq 'settings') {
            my $key   = defined $fields[0] ? $fields[0] : '';
            my $value = defined $fields[1] ? $fields[1] : '';
            next if $key eq '';
            $samplesheet{settings}{$key} = $value;
        }
        elsif ($section eq 'data') {
            if (!@data_columns) {
                @data_columns = @fields;
                $samplesheet{data_columns} = [ @data_columns ];
                next;
            }

            my %row;
            for (my $i = 0; $i < @data_columns; $i++) {
                my $col = $data_columns[$i];
                my $val = defined $fields[$i] ? $fields[$i] : '';
                $row{$col} = $val;
            }

            push @{ $samplesheet{data} }, \%row;
        }
    }

    close($fh);

    # Optional summary
    $samplesheet{summary}{n_samples} = scalar @{ $samplesheet{data} };
    $samplesheet{summary}{sample_ids} = [
        map { $_->{Sample_ID} // '' } @{ $samplesheet{data} }
    ];

    return \%samplesheet;
}
