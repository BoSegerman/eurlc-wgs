## runstep chewbbaca

$runstep_name = "chewbbaca";

$runstep{$runstep_name} = {
      message    => "Running Chewbbaca...",
      long_name  => "Chewbbaca (per-species batch)",
      output_dir => "__DIR-CLUSTERING__/chewbbaca/__SUBDIR__/per_batch/rawdata",
      resultfile => "__DIR-CLUSTERING__/chewbbaca/__SUBDIR__/per_batch/rawdata/chewbbaca_results/results_alleles.tsv",
      resultfiles_status => "NA",

      # Batch-level (runs once per species+schema directory). Mutually
      # exclusive with chewbbaca_per_sample via general.chewbbaca_mode --
      # see the design discussion on per_sample/per_batch storage layout
      # and the empirical batch-vs-per-sample comparison this enables
      # (same pattern as checkm_mode).
      group      => 'chewbbaca_mode',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'chewbbaca_batch_done' ],
      applies_if => sub {
          return ( $R_cfg->{chewbbaca}{enabled} && lc($R_cfg->{general}{chewbbaca_mode} // 'per_sample') eq 'per_species_batch' ) ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{main} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{chewbbaca}->{env} --no-capture-output chewBBACA.py AlleleCall 
       -i __INPUTDIR__ 
       -g __SCHEMA__ 
       -o __DIR-CLUSTERING__/chewbbaca/__SUBDIR__/per_batch/rawdata 
       --cpu __THREADS__ 
       __FILTER__ 
       $R_cfg->{chewbbaca}->{"arguments"} 
