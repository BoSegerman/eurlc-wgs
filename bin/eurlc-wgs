    my $report = "$out/qcscreen_report.html";
    if ( open( my $fh, '>:encoding(UTF-8)', $report ) ) { print {$fh} $html; close $fh; }
    else { log_message("ERROR: Could not write QC screen report [$report]: $!", "red"); }

    write_json_file( {
        pipeline   => "eurlc-wgs",
        version    => $rundata{pipeline_info}{version},
        mode       => "qcscreen",
        generated  => $generated,
        input      => $rundata{pipeline_info}{input_path},
        exit_code  => $exit_code,
        overall    => $overall,
        counts     => \%count,
        report     => $report,
        samples    => \@json_samples,
    }, "$out/qcscreen_status.json" );

    log_message("NOTICE: QC screen report: $report", $overall eq "green" ? "green" : $overall eq "yellow" ? "yellow" : "red");
    return $overall;
}


sub initiate_logfile {
    my $logfile = getdir("out,log") . "/log.txt";
    my $bash_logfile = getdir("out,log") . "/bash_commands.log";

    open($log_fh, '>>', $logfile)
        or die("FATAL ERROR: could not create file $logfile: $!");
    open($log_fh_bash, '>>', $bash_logfile)
        or die("FATAL ERROR: could not create file $bash_logfile: $!");

    # Enable autoflush on $log_fh so logs are written immediately
    $log_fh->autoflush(1);
    $log_fh_bash->autoflush(1);
        
    $logfile_open = 1;

    # Clear, searchable start marker for this run (the log is appended to
    # across resumed runs). Also written to the tool output logs.
    write_run_start_banner($logfile);

    print {$log_fh}  "-------------------------------------\n" .
                     "Commands executed before the logfile was opened:\n" . 
                     "$log_buffer\n".
                     "--------------------------------------\n";
    $log_buffer = '';  
        
    my $timestamp = timestamp_UTC();

    print {$log_fh} "========== LOG START ==========\n";
    print {$log_fh} "INFO: Logfile is now opened for writing\n";
    print {$log_fh} "INFO: $timestamp\n";
    print {$log_fh} "INFO: Pipeline name: $rundata{pipeline_info}{name}\n";
    print {$log_fh} "INFO: Pipeline version: $rundata{pipeline_info}{version}\n";
    print {$log_fh} "INFO: Pipeline version date: $rundata{pipeline_info}{versiondate}\n";    
                     

    
               
}


####################################################################################################

sub close_logfile {
    if ($logfile_open) {
        close($log_fh)
            or warn("WARNING: could not close logfile: $!");
        close($log_fh_bash)
            or warn("WARNING: could not close logfile: $!");    
        $logfile_open = 0;
    }
}

###################################################################################################
## Event stream (events.jsonl) -- see the runstep machinery design doc, §11.2.
## One JSON object per line, append-only, so a future GUI (or anything else)
## can `tail -f` this file and parse complete events as they land. Lazily
## opened on first use; auto-flushed so each event is visible immediately
## without needing to coordinate an explicit close at every one of this
## script's many exit points (graceful_die, etc.) -- the OS closes the
## handle on process exit regardless.

my $event_fh;

sub _get_event_fh {
    return $event_fh if defined $event_fh;

    my $path = getdir("out,log") . "/events.jsonl";

    open( $event_fh, '>>', $path ) or do {
        log_message("WARNING: Could not open event stream [$path] for writing: $! -- continuing without it", "red");
        return undef;
    };
    $event_fh->autoflush(1);

    return $event_fh;
}

# Event stream log/events.jsonl, one JSON object per line (A16). Every
# event has schema_version, ts (ISO 8601, local time with offset and
# milliseconds) and type. Sample events carry both "sample" (name) and
# "sample_index" (-1 = cross-sample step); runstep events carry "runstep"
# (the key, e.g. spades) and "runstep_label" (e.g. "Spades assembly").
# Types: run_started, runstep_started, runstep_finished (status success |
# failed | timeout | skipped | reused), sample_abandoned, paused, resumed,
# terminating, run_finished. Both schedulers produce the same fields.
# (schema version is a literal below: a file-scope assignment here would sit
# after the main program and never run -- see the BEGIN notes elsewhere.)

sub iso_timestamp {
    my $t   = Time::HiRes::time();
    my $ms  = int( ( $t - int $t ) * 1000 );
    my @lt  = localtime( int $t );
    ( my $tz = POSIX::strftime("%z", @lt) ) =~ s/^([+-]\d\d)(\d\d)$/$1:$2/;
    return POSIX::strftime("%Y-%m-%dT%H:%M:%S", @lt) . sprintf(".%03d", $ms) . $tz;
}

sub emit_runstep_event {
    my ($type, $i, $name, %extra) = @_;
    emit_event( type => $type, sample => $i, runstep => $name,
                runstep_label => ( $runstep{$name}{long_name} // $name ), %extra );
}

sub emit_event {
    my (%event) = @_;

    $event{schema_version} = 1;   # event schema version (A16)
    $event{ts} = iso_timestamp();
    if ( exists $event{sample} && defined $event{sample} && $event{sample} =~ /^-?\d+$/ ) {
        my $idx = $event{sample};
        $event{sample_index} = $idx + 0;
        $event{sample} = $idx >= 0 ? ( $R_samples->[$idx]{name} // undef ) : undef;
    }

    my $fh = _get_event_fh();
    if ($fh) {
        my $line = encode_json(\%event);
        print {$fh} "$line\n";
    }

    update_terminal_status(\%event);
}

# Hook for every event, after it has been written to log/events.jsonl.
# Deliberately empty: the terminal status board is drawn by the parallel
# scheduler itself (_par_render_status_board). Kept as the one place a
# future live view (e.g. a GUI feed, planned §18) can be attached to.
sub update_terminal_status {
    my ($event) = @_;
    return;
}

# Use this instead of a bare "die" whenever a failure is genuinely fatal for
# the whole pipeline run. Logs the error properly (so it ends up in the log
# file like everything else, not just on STDERR), closes the logfile cleanly,
# then exits -- rather than a raw die, which bypasses log_message() and
# close_logfile() entirely and can leave the logfile in an unflushed state.
#
# IMPORTANT: only call this from a context that is *actually* fatal for the
# whole run (e.g. a required tool that could not be installed after every
# available attempt). Never call it from a shared/low-level function that is
# also used on an optional-tool code path (ensure_conda_tool, expand_tool_checks,
# validate_tool_installation, etc.) -- those should report failure back to
# their caller (return 0 / empty list) and let the caller decide whether that
# failure is fatal (required tool) or recoverable (optional tool, prompt to
# continue without it).
sub graceful_die {
    my ($message) = @_;
    log_message("ERROR: $message", "red");
    kill_all_children();   # e.g. an error during the parallel phase (A2)
    log_message("NOTICE: Aborting analysis");
    close_logfile();
    exit 1;
}
####################################################################################################

 

####################################################################################################

sub timestamp_UTC {

    my @t = gmtime();
    my $timestamp = sprintf(
        "%04d-%02d-%02d %02d:%02d:%02d UTC",
        $t[5] + 1900, $t[4] + 1, $t[3],
        $t[2], $t[1], $t[0]
    );

    return "$timestamp";
}

####################################################################################################

sub timestamp_local {

    my @t = localtime();
    my $timestamp = sprintf(
        "%04d-%02d-%02d %02d:%02d:%02d",
        $t[5] + 1900, $t[4] + 1, $t[3],
        $t[2], $t[1], $t[0]
    );

    return "$timestamp";
}

#####################################################################################################

sub format_elapsed {   #for spinner
    my ($seconds) = @_;

    my $hours   = int($seconds / 3600);
    my $minutes = int(($seconds % 3600) / 60);
    my $secs    = $seconds % 60;

    my $str = "";
    $str .= "${hours}h "   if $hours > 0;
    $str .= "${minutes}m " if $minutes > 0;
    $str .= sprintf("%ds", $secs);
    return $str;
}
####################################################################################################
sub _parse_internal_cmd {
    my ($cmd) = @_;
    return unless defined $cmd;

    # Match "SUB\tname" plus optional "\targs..."
    return unless $cmd =~ /^SUB\t([A-Za-z_]\w*)(?:\t(.*))?\z/s;

    my $subname = $1;
    my $argstr  = defined($2) ? $2 : '';

    # Split remaining fields on tabs. Keep empty fields if you need them:
    my @args = length($argstr) ? split(/\t/, $argstr, -1) : ();

    return ($subname, @args);
}

sub _run_internal_sub {
    my ($subname, @args) = @_;

    my $code = $INTERNAL_SUB{$subname};
    if (!$code) {
        log_message("ERROR: Unknown internal sub [$subname]", "red");
        return 2;
    }

    my $exit_code = 0;

    # Capture exceptions so they become a controlled non-zero exit
    my $ok = eval {
        # Convention: internal subs return 0 on success, non-zero on failure.
        # If your subs currently return undef/true/false, normalize here.
        my $rc = $code->(@args);

        # Normalize:
        $exit_code = (!defined $rc) ? 0
                   : ($rc =~ /^\d+\z/) ? $rc
                   : ($rc ? 0 : 1);

        1;
    };

    if (!$ok) {
        my $err = $@ || "Unknown error";
        chomp $err;
        log_message("ERROR: Internal sub [$subname] died: $err", "red");
        return 255;
    }

    return $exit_code;
}

####################################################################################################

sub safe_rel {
    my ($num, $den, $fault_ret) = @_;

    $fault_ret   //= undef;
    
    return $fault_ret  unless is_number($num) && is_number($den);
    return $fault_ret  if $den == 0;

    return ($num / $den) * 100;
}

sub safe_quota {
    my ($num, $den, $fault_ret) = @_;

    $fault_ret   //= undef;
    
    return $fault_ret  unless is_number($num) && is_number($den);
    return $fault_ret  if $den == 0;

    return ($num / $den) ;
}



sub is_number {
    my ($x) = @_;
    return looks_like_number($x);
}

####################################################################################################

sub execute_and_log {
    my ($cmd, $run_fork, $msg, $max_seconds) = @_;
    $run_fork    //= 0;
    $msg         //= '';
    $max_seconds //= parse_duration_to_seconds($R_cfg->{general}{timeout});   # 0/undef => no timeout
    $cmd          = fill_placeholders($cmd);

    my ($subname, @subargs) = _parse_internal_cmd($cmd);
    my $is_internal = defined $subname;

    my $printversionCommand = $cmd;
    $printversionCommand =~ s/;/;\n/g;

    log_message("Executing:\n$printversionCommand");

    if (!$is_internal && $log_fh_bash) {
        my $ts = timestamp_UTC();
        print {$log_fh_bash} "[$ts] $cmd\n";
    }

    my $start_time = time();
    my $status;

    # The spinner needs a terminal. The time limit does not: a caller that
    # asked for the forked mode (runsteps) keeps it without a terminal
    # whenever a limit applies (nohup, GUI, output redirected to a file),
    # otherwise the limit would silently be ignored there.
    my $show_spinner = ( $run_fork && -t STDOUT ) ? 1 : 0;
    $run_fork = ( $run_fork && ( $show_spinner || $max_seconds ) ) ? 1 : 0;
    my $timed_out = 0;

    if ($run_fork) {
        my $pid = fork();
        if (!defined $pid) {
            log_message("ERROR: Fork failed for command: $cmd", "red");
            return;
        }

        if ($pid == 0) {
            # ---- child ----
            # Put child into its own process group so parent can kill everything it spawned.
            setpgid(0, 0);

            if ($is_internal) {
                my $rc = _run_internal_sub($subname, @subargs);
                # _exit: no END blocks or destructors in the child (B23);
                # flush first, _exit does not.
                STDOUT->flush; STDERR->flush; $log_fh->flush if $logfile_open && $log_fh;
                POSIX::_exit($rc & 255);
            } else {
                exec("bash", "-c", $cmd) or POSIX::_exit(127);
            }
        }

        # Parent: ensure child has its own PGID (usually same as PID)
        setpgid($pid, $pid);

        # Expose the child's PID so the SIGTERM/SIGINT handler can forward
        # the signal to its process group before exiting. Cleared below
        # once waitpid() confirms the child is done.
        $S_current_child_pid = $pid;

        my @spinner = ('|','/','-','\\');
        my $i = 0;

        my $get_cols = sub {
            return 80 unless -t STDOUT;
            my ($cols) = (GetTerminalSize())[0];
            return ($cols && $cols > 0) ? $cols : 80;
        };

        my $render_line = sub {
            my ($msg, $spinchar, $elapsed_str) = @_;
            my $cols = $get_cols->();
            my $max  = $cols - 1;
            $max = 10 if $max < 10;

            my $tail = sprintf " [%s] elapsed: %s", $spinchar, $elapsed_str;
            my $raw  = $msg . $tail;
            return $raw if length($raw) <= $max;

            my $head_max = $max - length($tail);
            $head_max = 0 if $head_max < 0;

            my $head = substr($msg, 0, $head_max);
            if ($head_max >= 2 && length($msg) > $head_max) {
                $head = substr($msg, 0, $head_max - 1) . "…";
            }
            return $head . $tail;
        };

        while (1) {
            my $child = waitpid($pid, WNOHANG);
            last if $child > 0;

            my $elapsed = time() - $start_time;

            # ---- timeout check ----
            if ($max_seconds && $elapsed >= $max_seconds) {
                $timed_out = 1;

                my $limit_str = format_elapsed($max_seconds);
                log_message("ERROR: Timeout after $limit_str. Killing the process", "red");
                log_message("INFO: Timeout after $limit_str. Killing: $cmd", "red");
                # TERM whole process group
                kill 'TERM', -$pid;

                # Give it a moment to exit cleanly
                my $grace = 5;  # seconds
                my $t0 = time();
                while (time() - $t0 < $grace) {
                    my $w = waitpid($pid, WNOHANG);
                    last if $w > 0;
                    select(undef, undef, undef, 0.2);
                }

                # Still alive? KILL process group
                my $w = waitpid($pid, WNOHANG);
                if ($w <= 0) {
                    kill 'KILL', -$pid;
                    waitpid($pid, 0);
                }

                last;
            }

            if ($show_spinner) {
                my $elapsed_str = format_elapsed($elapsed);
                my $line = $render_line->($msg, $spinner[$i % 4], $elapsed_str);
                print "\r\e[2K", $line;
            }

            $i = ($i + 1) % @spinner;
            select(undef, undef, undef, 0.2);
        }

        my $elapsed = time() - $start_time;
        my $elapsed_str = format_elapsed($elapsed);

        my $done = $timed_out
            ? sprintf("%s...TIMEOUT (elapsed %s)", $msg, $elapsed_str)
            : sprintf("%s...done (elapsed %s)", $msg, $elapsed_str);

        my $cols = (-t STDOUT) ? ((GetTerminalSize())[0] || 80) : 80;
        my $max  = $cols - 1;
        $done = substr($done, 0, $max) if length($done) > $max;

        print "\r\e[2K", $done, "\n" if $show_spinner;

        # If timed out, synthesize an exit status that looks like "killed by signal"
        if ($timed_out) {
            $status = 9;          # pretend SIGKILL
            $status = $status & 127;  # fits your later status parsing branch
        } else {
            $status = $?;
        }

        # Child is fully done at this point (either exited, timed-out and
        # killed, or collected by waitpid above). Clear so the signal
        # handler does not try to forward to an already-gone PID.
        $S_current_child_pid = 0;

    } else {
        # ---- blocking execution ----
        if ($is_internal) {
            my $rc = _run_internal_sub($subname, @subargs);
            $status = ($rc & 255) << 8;
        } else {
            system("bash", "-c", $cmd);   # bash like the forked path, not /bin/sh (dash) (B21)
            $status = $?;
        }
    }

    my $elapsed = time() - $start_time;
    my $hours   = int($elapsed / 3600);
    my $minutes = int(($elapsed % 3600) / 60);
    my $seconds = $elapsed % 60;
    my $runtime = sprintf "%02d:%02d:%02d", $hours, $minutes, $seconds;

    my $exit_code;

    if ($status == -1) {
        log_message("ERROR: Failed to execute command: $cmd");
        $exit_code = -1;
    } elsif ($status & 127) {
        my $m = sprintf("ERROR: Command died with signal %d: %s", $status & 127, $cmd);
        $m = sprintf( "NOTICE: Command died with signal %d (expected, %s): %s", $status & 127, $S_EXPECTED_FAIL_REASON, $cmd )
            if defined $S_EXPECTED_FAIL_REASON && !$timed_out && ( $status & 127 ) != 2;   # not a time limit or Ctrl+C
        log_message($m, $m =~ /^NOTICE/ ? "yellow" : "red");
        $exit_code = 128 + ($status & 127);   # conventional shell-style signal exit code
    } else {
        $exit_code = $status >> 8;
        if ($exit_code == 0) {
            log_message("INFO: Done (time used: $runtime)");
        } elsif ( defined $S_EXPECTED_FAIL_REASON ) {
            # The sample's data had already failed (sample_known_data_fail).
            log_message( sprintf( "NOTICE: Command exited with code %d (expected, %s): %s", $exit_code, $S_EXPECTED_FAIL_REASON, $cmd ), "yellow" );
        } else {
            my $m = sprintf("ERROR: Command exited with code %d: %s", $exit_code, $cmd);
            log_message($m, "red");
        }
    }

    return {
        success    => ($exit_code == 0) ? 1 : 0,
        exit_code  => $exit_code,
        elapsed_s  => $elapsed,
        timed_out  => $timed_out,
    };
}
#####################################################################################################

# Wall-time limit (seconds) for one runstep. In order:
#   1. config  [<tool>] timeout = 60m   (section from get_runstep_config_section;
#      also tool.timeout=60m on the command line)
#   2. runstep contract  timeout => "60m"   (long-running tools, e.g. assemblers)
#   3. general.timeout (default 30m)
# "0", "none" or "off" means no limit. The limit is a safety net against hung
# tools, not a performance target -- set it well above normal run times.
# Time limit of a step: its own config section, then the sections whose
# names are shorter prefixes of it (fastqc_rawdata -> fastqc: a [fastqc]
# timeout covers both FastQC steps), then the runstep's built-in value, then
# general.timeout.
sub get_runstep_timeout {
    my ($name) = @_;
    my $section = get_runstep_config_section($name // "");
    my @sections;
    if ( defined $section ) {
        my @parts = split /_/, $section;
        while (@parts) {
            my $cand = join '_', @parts;
            push @sections, $cand if ref $R_cfg->{$cand} eq 'HASH' && $cand ne 'general';
            pop @parts;
        }
    }
    for my $v ( ( map { $R_cfg->{$_}{timeout} } @sections ),
                $runstep{$name // ""}{timeout},
                $R_cfg->{general}{timeout} ) {
        return parse_duration_to_seconds($v) if defined $v && $v ne "";
    }
    return 0;
}

sub parse_duration_to_seconds {
    my ($s) = @_;
    return 0 if !defined $s;
    $s =~ s/^\s+|\s+$//g;
    return 0 if $s eq "" || lc($s) eq "0" || lc($s) eq "none" || lc($s) eq "off";

    my $orig = $s;

    # If it's just digits, treat as seconds
    if ($s =~ /^\d+$/) {
        return int($s);
    }

    # Normalize: lowercase, remove commas, collapse spaces
    $s = lc $s;
    $s =~ s/,//g;
    $s =~ s/\s+/ /g;

    # Allow formats like: "1h40m", "1h 40m", "2d 3h 10m 5s"
    # Units: d, h, m, s  (days/hours/minutes/seconds)
    my %mult = ( d => 86400, h => 3600, m => 60, s => 1 );

    my $total = 0;
    my $pos = 0;

    while ($s =~ /\G\s*(\d+(?:\.\d+)?)\s*([dhms])\s*/gc) {
        my ($num, $unit) = ($1, $2);
        $total += $num * $mult{$unit};
        $pos = pos($s);
    }

    # If we didn't consume the whole string, it's invalid
    if (!defined($pos) || $pos != length($s)) {
        graceful_die("Invalid duration format [$orig]. Examples: 500s, 40m, 1h40m, 1h 40m, 2d 3h");
    }

    # Return integer seconds (round down)
    return int($total);
}

#####################################################################################################
###################################################################################################
## screen color helper
##
## Single source of truth for ANSI screen coloring, used both by the startup
## banner and by log_message(). Respects $USE_COLOR (auto-disabled when not
## a terminal, see startup section; overridable via --no-color/--color).
## Wrapped in eval so an unrecognized color name degrades to "no color"
## instead of crashing the pipeline (Term::ANSIColor's color() dies on
## unknown attribute names).
sub colorize_for_screen {
    my ($color_name) = @_;

    return "" if !defined $USE_COLOR || !$USE_COLOR;
    return "" unless defined $color_name && $color_name ne "";

    my $code = eval { color($color_name) };
    return $code // "";
}

sub log_message {
    my ($msg, $color) = @_;   # $color is optional

    # In utility mode (--setup, --freeze-databases, --generate-seal) suppress
    # screen output during the noisy startup phase. The flag is cleared when
    # the utility command itself begins, so its own output is always visible.
    # Always write to the log file regardless.
    my $suppress_screen = $S_SUPPRESS_STARTUP_LOG ? 1 : 0;
    $suppress_screen = 0 if $msg =~ /^ERROR:/;   # an error is always shown (A10)

    # Ensure newline unless it already ends with \n or ...
    unless ( $msg =~ /\n$/ || $msg =~ /\.\.\.$/ ) {
        $msg .= "\n";
    }

 #   if($msg =~ "__"){
 #     $msg  = fill_placeholders($msg,"","",0);
 #   }  

    my $elapsed = time() - $rundata{timestamps}{pipeline_start}{time_value};
    my $hours   = int($elapsed / 3600);
    my $minutes = int(($elapsed % 3600) / 60);
    my $seconds = $elapsed % 60;
    my $runtime = sprintf "%02d:%02d:%02d", $hours, $minutes, $seconds;

    my $timestamp = ( is_docker() ) ? timestamp_UTC() : timestamp_local();

    my $output_log = "[$timestamp][+$runtime] $msg";

    # Remember every error and warning for the end-of-run summary, so they
    # are not lost far up in the terminal history.
    if ( !$S_ISSUES_PAUSED && ( $msg =~ /^(ERROR|WARNING):/ || $msg =~ /\[PIPELINE BUG\]/ ) ) {
        my $level = $msg =~ /^WARNING:/ ? "WARNING" : "ERROR";
        (my $text = $msg) =~ s/\s+\z//;
        push @S_RUN_ISSUES, { level => $level, text => $text, at => $runtime };
    }

    my $output_screen = $msg;
    $output_screen =~ s/^(NOTICE:|PROGRESS:)[ \t]?//;  # Strip NOTICE: and PROGRESS: prefixes for screen
    $output_screen = "[+$runtime] $output_screen";

    if ($logfile_open) {
        print {$log_fh} $output_log;
    } else {
        $log_buffer .= $output_log;
    }

    # Default to 0 if not yet set
    my $verbose = $R_cfg->{general}{verbose} // 0;

    # Decide if it should also go to screen
    if ( !$suppress_screen && ( $verbose || $msg =~ /^(ERROR:|WARNING:|NOTICE:|PROGRESS:)/ ) ) {
        # During parallel scheduler result_parsing reap cycles,
        # $S_par_log_capture is set. Three-way behaviour:
        #
        #   ERROR: / [PIPELINE BUG]  → add to done_lines (shown above board)
        #   WARNING:                  → count in $S_par_warning_count, suppress
        #                               from screen (shown as "⚠ N" in board)
        #   NOTICE: / PROGRESS: / .. → suppress entirely from screen (log only)
        #
        # All messages still go to the log file (written above). Only screen
        # output is affected here.
        if ( defined $S_par_log_capture ) {
            if ( $msg =~ /^ERROR:/ || $msg =~ /\[PIPELINE BUG\]/ ) {
                (my $clean = $output_screen) =~ s/\n$//;
                push @$S_par_log_capture, $clean;
            }
            elsif ( $msg =~ /^WARNING:/ ) {
                $S_par_warning_count++;
                (my $clean = $output_screen) =~ s/\n$//;
                push @S_par_warnings, $clean;
            }
            # NOTICE / INFO / PROGRESS → suppressed from screen, log file only
            return $output_screen;
        }
        if ( defined $color && $color ne "" ) {
            print colorize_for_screen($color), $output_screen, colorize_for_screen('reset');
        }
        else {
            print $output_screen;
        }
        return $output_screen;
    }
    return "";
}
#####################################################################################################

####################################################################################################

########################################################################################################

# Compute the MD5 hex digest of a file.
# Returns the 32-character hex string on success, or one of:
#   "ERROR:not_a_file"   -- path does not exist or is not a regular file
#   "ERROR:empty_file"   -- file exists but has zero bytes
#   "ERROR:cannot_open"  -- permission or OS error opening the file
# Callers should treat any value starting with "ERROR:" as a failure.
# Uses Digest::MD5 (core Perl module, no external tool required).
# Register a raw output file to be exposed as a link in the detailed report.
# Call from result_parsing after the file has been produced.
#
# Arguments (named):
#   title  -- display label in the report (required)
#   type   -- file type for icon selection: txt, json, html, tsv, pdf, csv,
#             krona, fasta (required; unknown types get a generic icon)
#   path   -- path to the file, RELATIVE TO THE OUTPUT ROOT (required).
#             Use path_relative_to_outdir() to produce this value.
#   hide_if_missing -- if true (default), skip the link if the file doesn't
#             exist at report-generation time (optional)
#
# Stores into $R_samples->[$samplenr]{results}{$runstep_name}{raw_outputs}
# as an ordered array, so links appear in registration order.
#
# The detailed report renderer reads this array and renders each entry as a
# link cell; no further configuration in the report section is needed.
sub register_raw_output {
    my ($samplenr, $runstep_name, %args) = @_;

    my $title = $args{title} or do {
        log_message("WARNING: register_raw_output called without title (runstep=$runstep_name)");
        return;
    };
    my $type  = $args{type}  // "unknown";
    my $path  = $args{path};
    if (!defined $path || $path eq "") {
        log_message("WARNING: register_raw_output called without path (runstep=$runstep_name, title=$title)");
        return;
    }
    my $hide_if_missing = $args{hide_if_missing} // 1;

    $R_samples->[$samplenr]{results}{$runstep_name}{raw_outputs} //= [];
    push @{ $R_samples->[$samplenr]{results}{$runstep_name}{raw_outputs} }, {
        title           => $title,
        type            => $type,
        path            => $path,
        hide_if_missing => $hide_if_missing,
    };
}

# Load and verify the database manifest (db_freeze.config).
#
# The manifest is an INI-style file where each section declares one
# database:
#
#   [kraken2_standard]
#   path         = /data/databases/kraken2/standard8
#   marker_file  = taxo.k2d
#   marker_md5   = a3f7c8d2e1b4...
#   note         = Standard-8, downloaded 2025-10-15
#
# At startup the pipeline computes the MD5 of each marker_file and
# compares it against the stored marker_md5. A mismatch means the
# database has been changed or replaced since the manifest was last
# updated -- the pipeline logs a warning and continues (database issues
# are serious but should not silently prevent analysis).
#
# Results are logged to log/versioning_explicit/databases.log so every
# run has a record of which database versions were active.

# ─── Program manifest: conda environment verification ──────────────────────
#
# conda_manifest.ini is an INI file declaring one conda environment per section:
#
#   [eurlc-wgs-fastp]
#   explicit_list_md5 = a3f7c8d2...              <- one accepted fingerprint
#   explicit_list_md5 = a3f7c8d2..., 9b2e1a4f... <- or multiple (any match = OK)
#   note = fastp 0.24.0, validated 2025-08-01
#
# The fingerprint is an MD5 of the sorted package URL lines from
# `conda list --explicit -n <env>`, excluding comment lines. This captures
# exactly which packages (including all dependencies) are installed, and is
# stable across runs on the same platform. Two platforms (linux-64, osx-arm64)
# will produce different fingerprints for the same YML -- list both values
# separated by commas if the pipeline is used on multiple platforms.
#
# To generate a fingerprint for the current installation of an environment:
#   eurlc-wgs --show-env-fingerprint eurlc-wgs-fastp
# or check log/versioning_explicit/programs.log after any run.

sub load_conda_manifest {
    my ($path) = @_;
    return {} unless defined $path && $path ne "" && -f $path;

    my %progs;
    for my $e ( grep { defined } parse_ini_entries( $path, label => "conda_manifest.ini" ) ) {
        my ( $section, $key, $val ) = @$e;
        $progs{$section} //= {};
        next unless defined $key;
        if ($key eq 'explicit_list_md5') {
            # accumulate multiple accepted fingerprints (comma-separated or
            # multiple lines -- both are supported)
            $progs{$section}{accepted_md5} //= [];
            push @{ $progs{$section}{accepted_md5} },
                grep { $_ ne "" } map { s/^\s+|\s+$//gr } split /,/, $val;
        } else {
            $progs{$section}{$key} = $val;
        }
    }
    return \%progs;
}

# Compute the fingerprint for a conda environment.
# Returns a 32-char hex MD5 string, or undef on failure.
# The fingerprint covers only the package URL lines (sorted), not the
# comment header, so it is stable across conda versions and run dates.
sub conda_env_fingerprint {
    my ($env_name) = @_;

    my @raw = qx(conda list --explicit -n "$env_name" 2>/dev/null);
    return undef unless @raw;

    # Keep only @EXPLICIT marker and package URL lines; skip # comments
    my @pkg_lines = sort grep { /^\@EXPLICIT$|^https?:/ } @raw;
    return undef unless @pkg_lines;

    return Digest::MD5::md5_hex(join("", @pkg_lines));
}

# Verify conda environments against the program manifest.
# Logs results to log/versioning_explicit/programs.log.
# Returns number of environments with MISMATCH or ERROR status.
sub verify_programs {
    my ($programs_ref, $logdir) = @_;

    return 0 unless defined $programs_ref && %$programs_ref;

    my (@lines, $errors, $warnings);
    $errors = $warnings = 0;

    push @lines, "Program manifest -- conda environment verification\n";
    push @lines, sprintf("%-32s  %-12s  %-34s  %s\n",
        "Environment", "Status", "Actual fingerprint", "Note");
    push @lines, "-" x 100 . "\n";

    for my $env (sort keys %$programs_ref) {
        my $prog         = $programs_ref->{$env};
        my @accepted     = @{ $prog->{accepted_md5} // [] };
        my $note         = $prog->{note} // "";
        my ($status, $actual, $color) = ("UNKNOWN", "", "yellow");

        $actual = conda_env_fingerprint($env) // "";

        if ($actual eq "") {
            $status = "ENV_NOT_FOUND"; $color = "red";
            $errors++;
            log_message("WARNING: Program manifest: conda environment [$env] not found "
                       . "or conda not accessible.", "red");
        }
        elsif (!@accepted) {
            # No reference fingerprints defined yet -- log actual so user can add it
            $status = "UNVERIFIED"; $color = "yellow";
            $warnings++;
            log_message("NOTICE: Program manifest: [$env] has no reference fingerprint. "
                       . "Add this to conda_manifest.ini to enable verification:\n"
                       . "  explicit_list_md5 = $actual", "yellow");
        }
        elsif (grep { lc($_) eq lc($actual) } @accepted) {
            $status = "OK"; $color = "green";
        }
        else {
            $status = "MISMATCH"; $color = "red";
            $errors++;
            log_message("WARNING: Program manifest: [$env] fingerprint does not match "
                       . "any accepted value.\n"
                       . "  Actual:   $actual\n"
                       . "  Accepted: " . join(", ", @accepted) . "\n"
                       . "  The conda environment may have been updated or differs from "
                       . "the validated installation.", "red");
        }

        log_message(sprintf("NOTICE: env:%-28s  %-10s  %s", $env, $status, $note), $color);
        push @lines, sprintf("%-32s  %-12s  %-34s  %s\n",
            $env, $status, $actual || "-", $note);
    }

    push @lines, "-" x 100 . "\n";
    push @lines, $errors == 0 && $warnings == 0
        ? "All environments verified OK.\n"
        : "Verified with $errors mismatch(es)/error(s), $warnings unverified.\n";
    push @lines, "\nTo generate fingerprints for current environments:\n";
    for my $env (sort keys %$programs_ref) {
        push @lines, "  conda list --explicit -n $env | grep -v '^#' | sort | md5sum\n";
    }

    if (defined $logdir && $logdir ne "") {
        ensure_dir("$logdir/versioning_explicit");
        if (open my $fh, '>', "$logdir/versioning_explicit/programs.log") {
            print $fh @lines;
            close $fh;
        }
    }

    return $errors;
}

# ─── Database manifest: load, resolve, verify ──────────────────────────────
#
# db_freeze.config is an INI file that defines frozen (versioned) database
# snapshots. It does NOT store database paths -- those live in eurlc-wgs.config
# under the program's db_path key. db_freeze.config only records which frozen
# snapshot to use (via marker_md5) and where to look for the marker file.
#
#   [kraken2]
#   marker_file  = taxo.k2d             <- file whose MD5 identifies the version
#   marker_md5   = a3f7c8d2...          <- expected MD5; leave empty = use live db
#   config_key   = kraken2.db_path      <- $R_cfg key whose value is the live path
#   note         = Standard-8 2025-10   <- free-text label shown in run logs
#
# The live database path is ALWAYS read from $R_cfg via config_key (which in
# turn picks it up from eurlc-wgs.config, supporting __DB__ placeholders and
# making the setup fully portable without absolute paths in db_freeze.config).
#
# Database directory layout:
#
#   eurlc-wgs_db/
#     kraken2/              ← live database (db_path in eurlc-wgs.config)
#     mash/
#     chewbbaca/
#     frozen_dbs/           ← frozen snapshots (--freeze-databases)
#       kraken2/
#         a3f9b2c1.../      ← copy named after MD5 of marker_file
#       mash/
#         c8d3f1b2.../
#
#   marker_md5 set  →  frozen_dbs/<name>/<md5>/  exists + MD5 matches  →  use it    [OK]
#                   →  frozen_dbs/<name>/<md5>/  missing or MD5 wrong  →  WARN+live  [DEGRADED]
#   marker_md5 empty →                                                  →  use live  [UNVERSIONED]
#   live path missing in all cases                                      →  ERROR     [NO_DB]
#
#   config_key is updated in $R_cfg so all downstream code sees the
#   resolved path without needing to know about the versioning layer.

sub load_databases_config {
    my ($path) = @_;
    return {} unless defined $path && $path ne "" && -f $path;

    # Any name in brackets: schema sections contain hyphens, e.g.
    # [chewbbaca_CAMPISO-PubMLST-8] (A7); case is kept (schema names).
    my %dbs;
    for my $e ( grep { defined } parse_ini_entries( $path, label => "db_freeze.config" ) ) {
        my ( $section, $key, $val ) = @$e;
        $dbs{$section} //= {};
        $dbs{$section}{$key} = $val if defined $key;
    }
    return \%dbs;
}

# Resolve each database to a concrete directory path and verify its MD5.
# Updates $R_cfg in-place via config_key so runsteps see the resolved path.
# Returns the number of databases with ERROR status.
sub resolve_and_verify_databases {
    my ($databases_ref, $logdir) = @_;

    return 0 unless defined $databases_ref && %$databases_ref;

    my (@lines, $errors, $warnings);
    $errors = $warnings = 0;

    push @lines, "Database manifest -- path resolution and verification\n";
    push @lines, sprintf("%-28s  %-12s  %-44s  %s\n",
        "Database", "Status", "Resolved path", "Note");
    push @lines, "-" x 110 . "\n";

    for my $name (sort keys %$databases_ref) {
        my $db         = $databases_ref->{$name};
        my $marker     = $db->{marker_file} // "";
        my $ref_md5    = lc($db->{marker_md5}  // "");
        my $config_key = $db->{config_key}  // "";
        my $note       = $db->{note}        // "";

        # The live database path is read from $R_cfg via config_key.
        # db_freeze.config intentionally does NOT store paths -- they live in
        # eurlc-wgs.config (with __DB__ placeholders) for portability.
        my $root = get_live_db_root($db);

        # Skip databases whose program is currently disabled in the pipeline config.
        # Derive the program name from config_key (e.g. "bakta.db_path" -> "bakta"),
        # falling back to the section name itself.
        {
            my $prog = get_program_for_db($name, $db);
            my $prog_enabled = $R_cfg->{$prog}{enabled} // 1;
            if (!$prog_enabled || $prog_enabled eq "0") {
                push @lines, sprintf("%-28s  %-12s  %s\n",
                    "db:$name", "DISABLED", "program '$prog' is disabled -- skipped");
                next;
            }
        }

        my ($resolved, $status, $color, $detail) = ("", "UNKNOWN", "yellow", "");

        if ($root eq "") {
            $status = "NO_PATH"; $color = "red"; $detail = "live db path not found via config_key=$config_key (check db_path in eurlc-wgs.config)";
            $errors++;
        }
        elsif ($ref_md5 ne "") {
            # ── Versioned mode: look in frozen_dbs/<name>/<md5>/ ──────────
            # frozen_dbs_root: explicit config > db-dir/frozen_dbs > dirname(root)/frozen_dbs
            my $frozen_root   = get_frozen_dbs_root(File::Basename::dirname($root));
            my $versioned_dir    = "$frozen_root/$name/$ref_md5";
            my $versioned_marker = "$versioned_dir/$marker";

            if (-d $versioned_dir) {
                my $fpr = $marker ne "" ? db_marker_fingerprint( $versioned_dir, $marker, full => $S_FULL_DB_VERIFY ) : { error => "no marker" };
                my $actual_md5 = $fpr->{fingerprint} // "ERROR:$fpr->{error}";
                $db->{_fingerprint_files} = $fpr->{files};
                if ($actual_md5 =~ /^ERROR:/) {
                    $status = "MARKER_MISSING"; $color = "red";
                    $detail = "marker $marker not found in $versioned_dir";
                    $errors++;
                    $resolved = _db_fallback_live($root, $name, \$status, \$color,
                                                  \$warnings, \$detail);
                }
                elsif ($actual_md5 eq $ref_md5) {
                    $resolved = $versioned_dir;
                    $status   = "OK"; $color = "green";
                    # For a chewBBACA schema the marker is a summary, not the
                    # data itself: check that the frozen copy (loci and
                    # filter) still matches it (B16).
                    if ( $marker eq "schema_version.md5" ) {
                        my $fp   = _chewbbaca_schema_fingerprint($versioned_dir);
                        my $body = _chewbbaca_marker_body($versioned_marker);
                        if ( !$fp || !$body || join("\n", @$body) ne join("\n", @{ $fp->{lines} }) ) {
                            $status = "CONTENT_CHANGED"; $color = "red";
                            $detail = "loci or filter in $versioned_dir differ from its schema_version.md5";
                            $errors++;
                            log_message("WARNING: Database [$name]: the frozen schema in $versioned_dir has been "
                                       . "changed after freezing (loci or filter). Falling back to live database at $root", "red");
                            $resolved = _db_fallback_live($root, $name, \$status, \$color,
                                                          \$warnings, \$detail);
                        }
                    }
                }
                else {
                    $status = "MD5_MISMATCH"; $color = "red";
                    $detail = "expected $ref_md5, got $actual_md5";
                    $errors++;
                    log_message("WARNING: Database [$name]: MD5 mismatch in frozen "
                               . "directory $versioned_dir\n"
                               . "  Expected: $ref_md5\n"
                               . "  Actual:   $actual_md5\n"
                               . "  Falling back to live database at $root", "red");
                    $resolved = _db_fallback_live($root, $name, \$status, \$color,
                                                  \$warnings, \$detail);
                }
            }
            else {
                log_message("WARNING: Database [$name]: frozen directory not found: "
                           . "$versioned_dir -- falling back to live database at $root", "yellow");
                $warnings++;
                $resolved = _db_fallback_live($root, $name, \$status, \$color,
                                              \$warnings, \$detail);
            }
        }
        else {
            # ── Unversioned mode: no marker_md5 set, use path directly ───
            $resolved = _db_fallback_live($root, $name, \$status, \$color,
                                          \$warnings, \$detail);
            $status = "UNVERSIONED" if $status eq "LIVE_OK";
        }

        # No database at all (B11). A frozen version was required: an error
        # that counts. Otherwise -- typically a new installation -- it is
        # simply not installed yet, and the test phase offers to install it.
        if ( $status eq "NO_DB" ) {
            if ( $ref_md5 ne "" ) {
                $errors++;
                log_message("ERROR: Database [$name]: no usable database at $root (and no frozen copy). "
                          . "Install it there, or set db_path in eurlc-wgs.config.", "red");
            } else {
                $status = "NOT_INSTALLED"; $color = "yellow";
                $detail = "not installed yet at $root -- the test phase offers to install it";
            }
        }

        # Update $R_cfg so downstream runsteps see the resolved path.
        # Also update db_test to point into the resolved directory so that
        # the legacy db_exists() / test_db_* checks don't look in the
        # original (now possibly renamed/absent) live database directory.
        if ($resolved ne "" && $config_key ne "") {
            my @key_parts = split /\./, $config_key;
            if (@key_parts == 2) {
                my ($section, $field) = @key_parts;
                $R_cfg->{$section}{$field} = $resolved;

                # Rewrite db_test: replace the old db_path prefix with $resolved
                my $old_db_path = $root;   # original path before resolution
                my $old_test    = $R_cfg->{$section}{db_test} // "";
                if ($old_test ne "" && $old_db_path ne "" && $old_db_path ne $resolved) {
                    # db_test may still have __DB__ placeholders at this point
                    # (fill_placeholders hasn't run on it yet); normalise first
                    my $filled_test = fill_placeholder_string($old_test, $R_cfg->{$section});
                    $filled_test = fill_placeholders($filled_test);
                    if (index($filled_test, $old_db_path) == 0) {
                        # Swap the prefix for the resolved path
                        my $suffix = substr($filled_test, length($old_db_path));
                        $R_cfg->{$section}{db_test} = $resolved . $suffix;
                    }
                }

                # Bracken shares kraken2's database directory and is treated as
                # an obligatory part of kraken2 analysis. When kraken2 resolves
                # to a frozen path, propagate the same path to bracken so that
                # bracken runsteps (-d flag) and db_test checks always point to
                # the same directory as kraken2 -- no separate db_freeze.config
                # entry and no duplicate copy of the database.
                if ($section eq "kraken2" && $field eq "db_path") {
                    $R_cfg->{bracken}{db_path} = $resolved;
                    $R_cfg->{bracken}{db_test} = "$resolved/database150mers.kmer_distrib";
                    log_message("NOTICE: db:bracken                  (inherited kraken2 resolved path → $resolved)");
                }
            }
            elsif (@key_parts == 3) {
                # Three-level key: e.g. "chewbbaca_schemas.pubmlst_campy_cg_v2.path"
                my ($section, $subsection, $field) = @key_parts;
                $R_cfg->{$section}{$subsection}{$field} = $resolved;

                # For chewbbaca schema path updates: remap filter file into the
                # frozen schema directory so filter commands point to the frozen copy.
                if ($section eq "chewbbaca_schemas" && $field eq "path") {
                    my $old_filter = $R_cfg->{chewbbaca_schemas}{$subsection}{filter} // "";
                    if ($old_filter && $old_filter ne "unfiltered") {
                        my $expanded = fill_placeholder_string($old_filter, {});
                        $expanded    = fill_placeholders($expanded);
                        if ($expanded ne "" && $expanded ne "unfiltered") {
                            my $filter_bn     = File::Basename::basename($expanded);
                            # Same relative place as in the live schema
                            # (filters/<name>.txt -- what the marker covers),
                            # else the copy at the top of the frozen folder.
                            my $frozen_filter = "$resolved/$filter_bn";
                            if ( index( $expanded, "$root/" ) == 0 ) {
                                my $same = "$resolved/" . substr( $expanded, length("$root/") );
                                $frozen_filter = $same if -f $same;
                            }
                            if (-f $frozen_filter) {
                                $R_cfg->{chewbbaca_schemas}{$subsection}{filter} = $frozen_filter;
                                log_message("NOTICE: db:$name filter → $frozen_filter");
                            } else {
                                log_message("NOTICE: db:$name filter not in frozen dir ($frozen_filter) -- keeping live path");
                            }
                        }
                    }
                }
            }
        }

        my $log_path = $resolved ne "" ? $resolved : "—";
        # Enrich status label with FROZEN/LIVE indicator for terminal output
        my $display_status = $status;
        if ($status eq "OK") {
            my $frozen_root_check = get_frozen_dbs_root(File::Basename::dirname($root));
            if (index($resolved, $frozen_root_check) == 0) {
                $display_status = "OK [FROZEN]";
            } else {
                $display_status = "OK [LIVE]";
            }
        }
        # Which version this is (B12): the fingerprint of the marker files,
        # named from known_databases.tsv or the database's SOURCE.txt.
        my ($fingerprint, $version) = ("", "");
        if ( $resolved ne "" && -d $resolved && $marker ne "" && $marker ne "schema_version.md5" ) {
            my $fr = db_marker_fingerprint( $resolved, $marker, full => $S_FULL_DB_VERIFY );
            if ( $fr->{fingerprint} ) {
                $fingerprint = $fr->{fingerprint};
                $version = known_database_label( $name, $fingerprint, map { $_->[1] } @{ $fr->{files} } )
                        // db_source_label($resolved) // "unknown version";
                $rundata{provenance}{run}{db_versions}{$name} = {
                    fingerprint => $fingerprint, version => $version, path => $resolved, status => $display_status,
                    files => { map { $_->[0] => $_->[1] } @{ $fr->{files} } },
                };
            }
        }
        log_message(sprintf("NOTICE: db:%-24s  %-14s  %s", $name, $display_status,
            ($detail ? "($detail)" : $version ne "" ? $version : $note)), $color);
        push @lines, sprintf("%-28s  %-12s  %-44s  %s\n",
            $name, $status, length($log_path) > 44 ? "...".substr($log_path,-41) : $log_path,
            $detail || $note);
        push @lines, sprintf("%-28s  %-12s  version: %s, fingerprint %s\n", "", "", $version, $fingerprint) if $fingerprint ne "";
    }

    push @lines, "-" x 110 . "\n";
    my $not_installed = grep { /\bNOT_INSTALLED\b/ } @lines;
    push @lines, $errors == 0 && $warnings == 0 && !$not_installed
        ? "All databases resolved OK.\n"
        : "Resolved with $errors error(s), $warnings warning(s)" . ( $not_installed ? ", $not_installed not installed yet" : "" ) . ".\n";
    $S_DB_NOT_INSTALLED = $not_installed;

    if (defined $logdir && $logdir ne "") {
        ensure_dir("$logdir/versioning_explicit");
        if (open my $fh, '>', "$logdir/versioning_explicit/databases.log") {
            print $fh @lines;
            close $fh;
        }
    }

    return $errors;
}

# Internal: fall back to the live (unversioned) database at $root.
# Used when the frozen/versioned directory is missing or fails MD5 verification.
sub _db_fallback_live {
    my ($root, $name, $status_ref, $color_ref, $warn_ref, $detail_ref) = @_;
    if (-d $root) {
        $$status_ref = "LIVE_OK"; $$color_ref = "yellow";
        $$detail_ref = "using live database at $root";
        $$warn_ref++;
        return $root;
    }
    else {
        # Reported (and counted) by the caller, which knows whether a frozen
        # version was required (B11).
        $$status_ref = "NO_DB"; $$color_ref = "red";
        $$detail_ref = "database directory not found: $root";
        return "";
    }
}



# Write a per-run config.log summarising config file fingerprints and seal status.
sub _write_config_log {
    my ($logdir) = @_;
    return unless defined $logdir && $logdir ne "";

    my $db_path   = $R_cfg->{general}{db_freeze_config} // "";
    my $prog_path = $R_cfg->{general}{conda_manifest}  // "";
    my $cfg_path  = $rundata{config}{path}              // "";
    my $seal_path = $R_cfg->{general}{seal}             // "";

    # Only reference the seal file if it actually exists
    $seal_path = "" unless $seal_path ne "" && -f $seal_path;

    my @lines;
    push @lines, "Configuration fingerprint log\n";
    push @lines, "Run date: " . timestamp_UTC() . "\n\n";

    for my $label_path (
        ["eurlc-wgs.config",   $cfg_path  ],
        ["db_freeze.config",   $db_path   ],
        ["conda_manifest.ini",    $prog_path ],
        ["config_seal.ini",    $seal_path ],
    ) {
        my ($label, $path) = @$label_path;
        my $md5 = ($path && -f $path) ? md5_file($path) : "file not found";
        push @lines, sprintf("%-22s  %s\n  path: %s\n\n", $label, $md5, $path || "(not configured)");
    }

    # Seal verification
    if ($seal_path && -f $seal_path) {
        my $result = _verify_config_seal($seal_path, $cfg_path, $db_path, $prog_path);
        push @lines, "Config seal: $result->{status}\n";
        push @lines, "Seal name:   $result->{name}\n"    if $result->{name};
        push @lines, "$result->{detail}\n"               if $result->{detail};
    } else {
        push @lines, "Config seal: UNSEALED -- no config_seal.ini found\n";
        push @lines, "Running without verified configuration seal.\n";
    }

    ensure_dir("$logdir/versioning_explicit");
    if (open my $fh, '>', "$logdir/versioning_explicit/config.log") {
        print $fh @lines;
        close $fh;
    }
}

# Load and verify config_seal.ini against current config files.
sub _load_config_seal {
    my ($seal_path) = @_;
    return {} unless -f $seal_path;

    my %seal;
    for my $e ( grep { defined } parse_ini_entries( $seal_path, label => "config_seal.ini" ) ) {
        my ( $section, $key, $val ) = @$e;
        $seal{$section}{$key} = $val if defined $key;
    }
    return \%seal;
}

# Fingerprints of what the pipeline itself brings, beside the three config
# files (B13): the script (version and MD5) and the genome size lists. A
# missing local list is recorded as "none", so adding one later breaks the
# seal just like changing it.
sub pipeline_seal_fingerprints {
    my %fp;
    my $script = eval { abs_path($0) } // $0;
    $fp{pipeline_version} = $PIPELINE_VERSION;
    $fp{pipeline_md5}     = ( $script && -f $script ) ? md5_file($script) : "";

    my $bundled = find_share_file("assets/genome_sizes.tsv");
    $fp{genome_sizes_bundled} = $bundled ? md5_file($bundled) : "none";
    my $local = ( peekdir("db") // "" ) . "/genome_sizes.tsv";
    $fp{genome_sizes_local}   = -f $local ? md5_file($local) : "none";
    return \%fp;
}

# Command-line overrides that can change results (B13). Settings that only
# steer the run -- resources, time limits, resume/overwrite, input
# selection, cleanup, logging -- are left out: they are in the log, but do
# not mark the seal.
sub seal_relevant_overrides {
    my %run_control = map { $_ => 1 } qw(
        threads max_threads max_ram_gb parallel_mode parallel_headroom
        parallel_default_threads parallel_default_ram_gb
        overwrite rerun recursive verbose fastq fasta assume_yes test_software
        timeout cache_max_age_days cleanup trimmed_fastq downsampled_fastq
        archive_results chewbbaca_write_md5 machine_aliases
        seal db_freeze_config conda_manifest frozen_dbs_root validate
        verify_reference verify_expect export_efsa efsa_metadata efsa_dir efsa_locus_suffix efsa_pipeline_tag
    );
    my @relevant;
    for my $line ( split /\n/, $rundata{config}{overrides} // "" ) {
        $line =~ s/^\s+|\s+$//g;
        next if $line eq "";
        my ($key) = $line =~ /^([^=\s]+)/ or next;
        my ($section, $param) = $key =~ /^([^.]+)\.(.+)$/ ? ( $1, $2 ) : ( "general", $key );
        next if $section eq "general" && $run_control{$param};
        next if $section ne "general" && $param =~ /^(?:timeout|parallel_threads|parallel_ram_gb)$/;
        next if $section eq "cleanup";   # which intermediate files are kept
        push @relevant, $line;
    }
    my %seen;
    return grep { !$seen{$_}++ } @relevant;
}

# Seal status, one of SEAL VERIFIED, SEAL VERIFIED WITH OVERRIDES,
# SEAL BROKEN. The result is cached: the files do not change during a run,
# and the BROKEN warning should be logged once, not once per caller.
our $S_SEAL_RESULT;
sub _verify_config_seal {
    my ($seal_path, $cfg_path, $db_path, $prog_path) = @_;
    return $S_SEAL_RESULT if $S_SEAL_RESULT;

    # Allow caller to omit cfg_path -- use the loaded config file path
    $cfg_path //= $rundata{config}{path} // "";

    my $seal = _load_config_seal($seal_path);
    my $name = $seal->{seal}{name} // "(unnamed)";
    my (@mismatches, @notes);

    my %files = (
        eurlc_wgs_config => $cfg_path,
        db_freeze_config => $db_path,
        conda_manifest  => $prog_path,
    );

    for my $key (sort keys %files) {
        my $ref_md5 = lc($seal->{fingerprints}{$key} // "");
        next unless $ref_md5 ne "";
        my $path = $files{$key} // "";
        my $actual = ($path && -f $path) ? lc(md5_file($path)) : "missing";
        push @mismatches, "  $key: expected $ref_md5, got $actual"
            unless $actual eq $ref_md5;
    }

    # Pipeline script and genome size lists (B13). A seal made before these
    # were recorded has no such keys; it is checked as before, with a note.
    my $now = pipeline_seal_fingerprints();
    if ( defined $seal->{fingerprints}{pipeline_version} ) {
        my $ref_v = $seal->{fingerprints}{pipeline_version};
        if ( $ref_v ne $now->{pipeline_version} ) {
            push @mismatches, "  pipeline version: sealed $ref_v, running $now->{pipeline_version}";
        }
        elsif ( lc( $seal->{fingerprints}{pipeline_md5} // "" ) ne ""
                && lc( $seal->{fingerprints}{pipeline_md5} ) ne lc( $now->{pipeline_md5} ) ) {
            push @mismatches, "  pipeline script: same version ($ref_v) but the file has changed";
        }
        for my $key (qw(genome_sizes_bundled genome_sizes_local)) {
            my $ref = lc( $seal->{fingerprints}{$key} // "" );
            next if $ref eq "";
            my $act = lc $now->{$key};
            next if $act eq $ref;
            my $label = $key eq "genome_sizes_local" ? "local genome size list (<db>/genome_sizes.tsv)"
                                                     : "bundled genome size list";
            push @mismatches, "  $label: "
                . ( $ref eq "none" ? "added since the seal was made"
                  : $act eq "none" ? "removed since the seal was made"
                  :                  "changed since the seal was made" );
        }
    }
    else {
        push @notes, "This seal predates pipeline version checking -- regenerate it with --generate-seal to include the pipeline version.";
    }

    if (@mismatches) {
        my $detail = "MISMATCHES:\n" . join("\n", @mismatches);
        log_message("WARNING: Config seal [$name] is BROKEN -- configuration has changed "
                   . "since the seal was generated:\n$detail", "red");
        return $S_SEAL_RESULT = { status => "SEAL BROKEN", name => $name, detail => $detail,
                                  mismatches => \@mismatches, overrides => [] };
    }

    my @overrides = seal_relevant_overrides();
    if (@overrides) {
        my $detail = "Command-line overrides of the sealed configuration:\n"
                   . join("\n", map { "  $_" } @overrides);
        $detail .= "\n" . join("\n", @notes) if @notes;
        log_message("NOTICE: Config seal [$name] verified, with command-line overrides: "
                   . join(", ", @overrides), "yellow");
        return $S_SEAL_RESULT = { status => "SEAL VERIFIED WITH OVERRIDES", name => $name,
                                  detail => $detail, mismatches => [], overrides => \@overrides };
    }
    return $S_SEAL_RESULT = { status => "SEAL VERIFIED", name => $name, detail => join("\n", @notes),
                              mismatches => [], overrides => [] };
}


# ── YML checksum tracking ─────────────────────────────────────────────────
# Records the MD5 of each YML file used to install a conda environment.
# Stored in db_dir/yml/.checksums (one "env_name = md5" per line).
# --setup compares current YML MD5 against stored value to detect updates.

sub _yml_checksum_path {
    my $db_dir = peekdir("db");
    return "$db_dir/yml/.checksums";
}

sub _read_yml_checksums {
    my $path = _yml_checksum_path();
    my %sums;
    return %sums unless -f $path;
    open my $fh, '<', $path or return %sums;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || !/\S/;
        if (/^(\S+)\s*=\s*(\S+)$/) { $sums{$1} = $2; }
    }
    close $fh;
    return %sums;
}

sub _write_yml_checksums {
    my (%sums) = @_;
    my $path = _yml_checksum_path();
    ensure_dir(File::Basename::dirname($path));
    open my $fh, '>', $path or do {
        log_message("WARNING: Cannot write YML checksums to $path: $!", "yellow");
        return;
    };
    print $fh "# YML installation checksums -- managed by eurlc-wgs --setup\n";
    print $fh "# Do not edit manually. Delete to force reinstall of all environments.\n";
    for my $env (sort keys %sums) {
        print $fh "$env = $sums{$env}\n";
    }
    close $fh;
}

# --setup: guided first-time or repair installation.
# Installs missing conda environments, optionally downloads missing databases,
# and reports on configuration and seal status.
# Adapts to what it finds in the db directory:
#   - If db_dir/yml/*.yml exist, they are used instead of built-in YML files
#   - If db_dir/eurlc-wgs.config exists, that config is used (run with configfile=)
#   - If db_freeze.config exists, database status is shown
# Safe to run multiple times (skips already-installed environments).
sub _cmd_setup {
    $S_SUPPRESS_STARTUP_LOG = 0;   # show all output from here on

    my $db_dir  = peekdir("db");
    my $db_dir_exists = -d $db_dir;

    log_message("NOTICE: ─────────────────────────────────────────────────");
    log_message("NOTICE: eurlc-wgs setup");
    log_message("NOTICE: ─────────────────────────────────────────────────");
    log_message("NOTICE: Database/config directory: $db_dir");

    # ── 1. DB directory ──────────────────────────────────────────────
    unless ($db_dir_exists) {
        log_message("NOTICE: Database directory does not exist: $db_dir");
        my $create = $ASSUME_YES || prompt_yes_no("Create it now?", 1);
        if ($create) {
            ensure_dir($db_dir);
            ensure_dir("$db_dir/yml");
            log_message("NOTICE: Created $db_dir", "green");
        } else {
            log_message("NOTICE: Setup cancelled -- database directory is required.");
            return;
        }
    }

    # ── 2. Detect installation type ──────────────────────────────────
    my $custom_config = "$db_dir/eurlc-wgs.config";
    my $custom_ymls   = glob("$db_dir/yml/*.yml") ? 1 : 0;
    my $db_config     = $R_cfg->{general}{db_freeze_config} // "";

    if ($custom_ymls) {
        log_message("NOTICE: Found YML files in $db_dir/yml/ -- will use these for environment installation.");
    }
    if (-f $custom_config && ($rundata{config}{path} // "") ne $custom_config) {
        log_message("NOTICE: Found config file in db directory.", "yellow");
        log_message("NOTICE: For a fully configured installation, run with:");
        log_message("NOTICE:   eurlc-wgs --setup configfile=$custom_config");
    }

    # ── 2b. Species scope ────────────────────────────────────────────
    # Species-specific tools are installed for general.species_scope
    # (resolved before this point). Given on the command line
    # (--setup species_scope="Campylobacter"), it is also written to the
    # configuration file in use, so later runs use the same scope.
    log_message("NOTICE:");
    log_message("NOTICE: Species scope: " . ( $R_cfg->{general}{species_scope} // "" ));
    if ( ( $rundata{config}{overrides} // "" ) =~ /general\.species_scope=/ ) {
        my $cfg_path = $rundata{config}{path} // "";
        if ( $cfg_path ne "" && -f $cfg_path ) {
            if ( set_config_file_value( $cfg_path, "general", "species_scope", $R_cfg->{general}{species_scope} ) ) {
                log_message("NOTICE: Saved species_scope in $cfg_path", "green");
            }
        } else {
            log_message("NOTICE: No configuration file in use -- species_scope applies to this setup only.", "yellow");
            log_message("NOTICE: To keep it, write a config (configfile=write) and set species_scope in its [general] section.", "yellow");
        }
    }

    # ── 3. Conda environments ─────────────────────────────────────────
    log_message("NOTICE:");
    log_message("NOTICE: ── Conda environments ──────────────────────────");

    # Collect unique envs from enabled tools
    my (%seen_env, @tools_by_env);
    for my $tool (sort keys %$R_cfg) {
        next unless ref($R_cfg->{$tool}) eq 'HASH';
        my $env = $R_cfg->{$tool}{env} // "";
        next if $env eq "" || $env eq "base";
        next unless ($R_cfg->{$tool}{enabled} // 1) || $S_SETUP_OPTIONAL;   # before marking seen: a disabled
        next if $seen_env{$env}++;                     # tool must not hide a shared env
        push @tools_by_env, { tool => $tool, env => $env };
    }

    # Load stored YML checksums to detect updates
    my %yml_checksums = _read_yml_checksums();
    my $checksums_changed = 0;

    my ($n_ok, $n_updated, $n_missing, $n_failed) = (0, 0, 0, 0);

    for my $entry (@tools_by_env) {
        my ($tool, $env) = @{$entry}{qw(tool env)};
        my $exists   = conda_env_exists($env);
        my $yml      = find_env_yml($R_cfg->{$tool});
        my $yml_src  = $yml ? ($yml =~ m{$db_dir} ? "db-dir" : "built-in") : "none";
        my $yml_md5  = ($yml && -f $yml) ? md5_file($yml) : "";

        if ($exists) {
            my $stored_md5 = $yml_checksums{$env} // "";

            if ($yml_md5 ne "" && $stored_md5 ne "" && $yml_md5 ne $stored_md5) {
                # YML has changed since last install -- update available
                log_message(sprintf("NOTICE:   ⚠   %-34s (update available, YML: %s)",
                    $env, $yml_src), "yellow");
                my $update = $ASSUME_YES || prompt_yes_no("  Update $env?", 1);
                if ($update) {
                    log_message("NOTICE:   Updating $env from $yml ...");
                    my @cmd = ("conda", "env", "update", "-n", $env, "-f", $yml, "--prune");
                    my $ok = (system(@cmd) == 0);
                    if ($ok) {
                        $yml_checksums{$env} = $yml_md5;
                        $checksums_changed = 1;
                        log_message("NOTICE:   ✓  $env updated", "green");
                        $n_updated++;
                    } else {
                        log_message("WARNING:  ✗  $env update failed", "red");
                        $n_failed++;
                    }
                } else {
                    log_message("NOTICE:   Skipped. Run --setup again to update later.");
                    $n_ok++;  # counts as ok for now
                }
            } elsif ($yml_md5 ne "" && $stored_md5 eq "") {
                # Env exists but no checksum stored yet -- record it
                $yml_checksums{$env} = $yml_md5;
                $checksums_changed = 1;
                log_message(sprintf("NOTICE:   ✓  %-36s (installed, checksum recorded)",
                    $env), "green");
                $n_ok++;
            } else {
                log_message(sprintf("NOTICE:   ✓  %-36s (installed, up to date)", $env), "green");
                $n_ok++;
            }
        } else {
            # Environment missing -- offer installation
            log_message(sprintf("NOTICE:   ✗  %-36s (not installed, YML: %s)",
                $env, $yml_src), "yellow");
            $n_missing++;

            my $install = $ASSUME_YES || prompt_yes_no("  Install $env?", 1);
            if ($install) {
                my $ok = ensure_conda_tool($tool, 1);
                if ($ok) {
                    if ($yml_md5 ne "") {
                        $yml_checksums{$env} = $yml_md5;
                        $checksums_changed = 1;
                    }
                    log_message("NOTICE:   ✓  $env installed", "green");
                    $n_missing--;
                    $n_ok++;
                } else {
                    log_message("WARNING:  ✗  $env installation failed", "red");
                    $n_failed++;
                    $n_missing--;
                }
            }
        }
    }

    # Persist checksum updates
    _write_yml_checksums(%yml_checksums) if $checksums_changed;

    log_message("NOTICE:");
    if ($n_missing == 0 && $n_failed == 0 && $n_updated == 0) {
        log_message("NOTICE: All conda environments are installed and up to date.", "green");
    } else {
        my @parts;
        push @parts, "$n_ok OK"        if $n_ok;
        push @parts, "$n_updated updated" if $n_updated;
        push @parts, "$n_missing skipped" if $n_missing;
        push @parts, "$n_failed failed"   if $n_failed;
        log_message("NOTICE: " . join(", ", @parts) . ".", $n_failed ? "red" : "yellow");
    }

    # ── 4. Databases ──────────────────────────────────────────────────
    my ($n_db_failed, $n_db_missing) = (0, 0);
    my $db_result = sub { my ($r) = @_; $n_db_failed++ if defined $r && $r == 0; $n_db_missing++ if !defined $r; };
    log_message("NOTICE:");
    log_message("NOTICE: ── Databases ────────────────────────────────────");

    if ($db_config ne "" && -f $db_config) {
        # db_freeze.config present -- show what a run would use. Same rules
        # as resolve_and_verify_databases(): live path from config_key,
        # frozen copy in <frozen_dbs_root>/<name>/<marker_md5>/.
        my $dbs = load_databases_config($db_config);
        for my $name (sort keys %$dbs) {
            my $db      = $dbs->{$name};
            my $ref_md5 = lc($db->{marker_md5} // "");
            my $prog    = get_program_for_db($name, $db);

            my $prog_enabled = $R_cfg->{$prog}{enabled} // 1;
            if ( ( !$prog_enabled || $prog_enabled eq "0" ) && !$S_SETUP_OPTIONAL ) {
                log_message(sprintf("NOTICE:   -  %-28s (program '%s' disabled)", $name, $prog));
                next;
            }

            my $live   = get_live_db_root($db);
            my $frozen = $ref_md5 ne ""
                ? get_frozen_dbs_root(File::Basename::dirname($live || ".")) . "/$name/$ref_md5"
                : "";

            if ($frozen ne "" && -d $frozen) {
                log_message(sprintf("NOTICE:   ✓  %-28s (frozen %s)", $name, substr($ref_md5, 0, 8)), "green");
            } elsif ($live ne "" && -d $live) {
                my $why = $ref_md5 ne "" ? "frozen copy missing -- live database will be used"
                                         : "live, not frozen";
                log_message(sprintf("NOTICE:   ○  %-28s (%s)", $name, $why), "yellow");
            } else {
                log_message(sprintf("NOTICE:   ✗  %-28s (not found: %s)", $name, $live || "no db_path for " . ($db->{config_key} // '?')), "red");
                my $tool = _find_tool_for_db($name, $db);
                $db_result->( defined $tool ? _setup_offer_db_install($tool, $name, $live) : undef );
            }
        }
    } else {
        # No db_freeze.config -- use built-in db_test paths to check
        my @db_tools = grep {
            ref($R_cfg->{$_}) eq 'HASH'
            && (   ($R_cfg->{$_}{db_path} // "") ne ""
                || ($R_cfg->{$_}{db_test} // "") ne "" )
            && ($R_cfg->{$_}{install_db} // "") ne ""
        } sort keys %$R_cfg;

        for my $tool (@db_tools) {
            next unless ( $R_cfg->{$tool}{enabled} // 1 ) || $S_SETUP_OPTIONAL;
            my $db_path  = fill_placeholder_string($R_cfg->{$tool}{db_path} // "", $R_cfg->{$tool});
            my $db_test  = fill_placeholder_string($R_cfg->{$tool}{db_test} // "", $R_cfg->{$tool});
            my $exists   = $db_test ne "" ? -e $db_test : ($db_path ne "" ? -d $db_path : 0);
            my $install_cmd = $R_cfg->{$tool}{install_db} // "";
            my $display_path = $db_test ne "" ? $db_test : $db_path;

            if ($exists) {
                log_message(sprintf("NOTICE:   ✓  %-28s (%s)", $tool, $display_path), "green");
            } else {
                log_message(sprintf("NOTICE:   ✗  %-28s (%s)", $tool, $display_path), "red");
                $db_result->( _setup_offer_db_install($tool, $tool, $db_path) );
            }
        }
    }

    # ── 5. Configuration seal status ──────────────────────────────────
    log_message("NOTICE:");
    log_message("NOTICE: ── Configuration seal ───────────────────────────");

    my $seal_path = $R_cfg->{general}{seal} // "";
    if ($seal_path ne "" && -f $seal_path) {
        my $result = _verify_config_seal($seal_path,
            $rundata{config}{path} // "",
            $R_cfg->{general}{db_freeze_config} // "",
            $R_cfg->{general}{conda_manifest} // "");
        my $color = $result->{status} eq "SEAL VERIFIED" ? "green"
                  : $result->{status} eq "SEAL BROKEN"   ? "red" : "yellow";
        log_message("NOTICE:   $result->{status}: $result->{name}", $color);
    } elsif ($seal_path ne "") {
        log_message("NOTICE:   UNSEALED -- $seal_path not found", "yellow");
        log_message("NOTICE:   Run --freeze-databases then --generate-seal to create a seal.");
    } else {
        log_message("NOTICE:   UNSEALED -- no seal configured", "yellow");
    }

    # ── 6. Summary ────────────────────────────────────────────────────
    log_message("NOTICE:");
    log_message("NOTICE: ─────────────────────────────────────────────────");
    my $n_failures = $n_failed + $n_db_failed;
    if ($n_failures) {
        # Exit code 1 (A14), so install.sh and scripts see it.
        log_message("ERROR: Setup finished with problems: "
            . join(", ", ( $n_failed ? "$n_failed conda environment(s)" : () ), ( $n_db_failed ? "$n_db_failed database(s)" : () ))
            . " could not be installed -- see the lines marked ✗ above", "red");
    }
    log_message("NOTICE: " . ( $n_failures ? "Next steps:" : "Setup complete. Next steps:" ));
    if ($n_failures) {
        log_message("NOTICE:   - Fix the failed installations (log: " . getdir("out,log") . ") and run --setup again.");
    }
    if ($n_missing > 0 || $n_db_missing > 0) {
        log_message("NOTICE:   - Some environments or databases were skipped. Re-run --setup to install them.");
    }
    # cgMLST schemas are installed separately: name the EFSA ones that are
    # missing for the species in scope, as a ready command.
    {
        my %efsa = ( campylobacter => [ "CAMPISO-PubMLST-8",    "Campylobacter" ],
                     ecoli         => [ "chewie_ns_ecoli",      "Escherichia coli" ],
                     salmonella    => [ "chewie_ns_salmonella", "Salmonella" ],
                     listeria      => [ "chewie_ns_listeria",   "Listeria" ] );
        my $schemas = ( peekdir("db") // "" ) . "/chewbbaca/schemas";
        my $scope   = [ grep { $_ ne "" } map { s/^\s+|\s+$//gr } split /,/, ( $R_cfg->{general}{species_scope} // "" ) ];
        my @missing = grep {
            !-d "$schemas/$efsa{$_}[0]"
            && ( !@$scope || grep( { lc $_ eq 'all' } @$scope ) || species_lists_overlap( $scope, [ $efsa{$_}[1] ] ) )
        } sort keys %efsa;
        if (@missing) {
            log_message("NOTICE:   - Install the cgMLST schemas (EFSA):");
            log_message("NOTICE:       eurlc-wgs --install-efsa-schemas"
                      . ( @missing == keys %efsa ? "" : "=" . join( ",", @missing ) ));
            log_message("NOTICE:     (--list-schemas shows all available schemas)");
        }
    }
    if (!-f ($seal_path // "")) {
        log_message("NOTICE:   - Run --freeze-databases to lock database versions.");
        log_message("NOTICE:   - Run --generate-seal=\"<name>\" after validation to create a seal.");
    }
    log_message("NOTICE:   - Run eurlc-wgs --versions to see every tool's version.");
    log_message("NOTICE: ─────────────────────────────────────────────────");
    return $n_failures;
}

# Find which tool config section corresponds to a db_freeze.config entry.
# Matches by db_path overlap or config_key section name.
# Root directory for frozen database copies (frozen_dbs/<name>/<md5>/).
# Single definition used by the startup resolver, --freeze-databases and
# --setup, so the three can never disagree.
#   1. general.frozen_dbs_root in eurlc-wgs.config (relative -> db dir)
#   2. <db dir>/frozen_dbs                          (standard layout)
#   3. <$fallback_parent>/frozen_dbs                (last resort, no db dir)
sub get_frozen_dbs_root {
    my ($fallback_parent) = @_;
    my $db_base = peekdir("db") // "";
    my $cfg     = $R_cfg->{general}{frozen_dbs_root} // "";
    if ($cfg ne "") {
        $cfg = fill_placeholder_string($cfg, {});
        $cfg = "$db_base/$cfg" if $cfg !~ m{^/} && $db_base ne "";
        return $cfg;
    }
    return "$db_base/frozen_dbs" if $db_base ne "";
    return ( $fallback_parent // "." ) . "/frozen_dbs";
}

# Live database path for one db_freeze.config entry, looked up in the
# pipeline config via its config_key (db_freeze.config stores no paths).
# Falls back to a legacy 'path' field if present.
sub get_live_db_root {
    my ($db) = @_;
    my $config_key = $db->{config_key} // "";
    my $root = "";
    if ($config_key ne "") {
        my @kp = split /\./, $config_key;
        if (@kp == 2) {
            $root = fill_placeholders($R_cfg->{$kp[0]}{$kp[1]} // "");
        } elsif (@kp == 3) {
            $root = fill_placeholders($R_cfg->{$kp[0]}{$kp[1]}{$kp[2]} // "");
        }
    }
    if ($root eq "" && defined $db->{path} && $db->{path} ne "") {
        $root = fill_placeholders($db->{path});
    }
    return $root;
}

# Program a db_freeze.config entry belongs to (for the enabled check).
sub get_program_for_db {
    my ($name, $db) = @_;
    my $config_key = $db->{config_key} // "";
    return ($config_key =~ /^chewbbaca_schemas\./) ? "chewbbaca"
         : ($config_key =~ /^(\w+)\./)            ? $1
         : $name;
}

# --setup helper: offer to run a tool's install_db command.
# $target is shown to the user as the expected location.
sub _setup_offer_db_install {
    my ($tool, $label, $target) = @_;
    my $install_cmd = $R_cfg->{$tool}{install_db} // "";
    if ($install_cmd eq "") {
        my $hint = ($target // "") ne "" ? $target : "(see documentation)";
        log_message("NOTICE:   No automated install command -- install manually to $hint");
        return;
    }
    my $go = $ASSUME_YES || prompt_yes_no("  Download/install $label database?", 1);
    return unless $go;   # undef: skipped; 1: installed; 0: failed

    my $db_root = peekdir("db");
    my $db_path = fill_placeholder_string($R_cfg->{$tool}{db_path} // "", $R_cfg->{$tool});
    ensure_dir($db_path) if $db_path ne "";
    my $cmd = $install_cmd;
    $cmd =~ s/__DB__/$db_root/g;
    my $env_name   = $R_cfg->{$tool}{env}  // "";
    my $conda_base = get_conda_base();
    $cmd =~ s/__ENV__/$env_name/g;
    $cmd =~ s/__CONDABASE__/$conda_base/g;
    log_message("NOTICE:   Running: $cmd");
    if ( system($cmd) == 0 ) {
        log_message("NOTICE:   ✓  $label database installed", "green");
        write_db_source_file( $db_path, $cmd );   # B12
        return 1;
    }
    log_message("WARNING:  ✗  $label database installation failed", "red");
    return 0;
}

sub _find_tool_for_db {
    my ($db_name, $db) = @_;
    my $config_key = $db->{config_key} // "";
    if ($config_key =~ /^(\w+)\./) {
        my $section = $1;
        return $section if exists $R_cfg->{$section};
    }
    return undef;
}

# Expand __DB__ placeholder in a string using the current db dir.
sub fill_placeholder_string {
    my ($str, $tool_cfg) = @_;
    return "" unless defined $str;
    my $db          = peekdir("db");
    my $conda_base  = get_conda_base();
    my $env_name    = (defined $tool_cfg && ref $tool_cfg eq 'HASH')
                      ? ($tool_cfg->{env} // "") : "";
    $str =~ s/__DB__/$db/g;
    $str =~ s/__CONDABASE__/$conda_base/g;
    $str =~ s/__ENV__/$env_name/g;
    return $str;
}

# --freeze-databases[=name1,name2,...]: snapshot each live database into frozen_dbs/<name>/<md5>/
#
# Usage:
#   eurlc-wgs --freeze-databases              # freeze all unfrozen databases
#   eurlc-wgs --freeze-databases=kraken2      # freeze only kraken2
#   eurlc-wgs --freeze-databases=kraken2,mash # freeze kraken2 and mash
#
# Directory layout after freezing:
#
#   eurlc-wgs_db/
#     kraken2/              ← live database (unchanged)
#     frozen_dbs/
#       kraken2/
#         a3f9b2c1.../      ← frozen copy, named after MD5 of marker_file
#
# frozen_dbs/ location defaults to <db dir>/frozen_dbs, or can be set
# explicitly with general.frozen_dbs_root in eurlc-wgs.config (see
# get_frozen_dbs_root).
#
# When a database is re-frozen (live version has changed), the old marker_md5
# line in db_freeze.config is commented out with a datestamp, and the new
# value is written below it. This provides an in-file history of which frozen
# versions have been used, and makes it easy to identify dangling frozen dirs
# that are no longer referenced.
# _generate_chewbbaca_schema_marker($schema_dir, $schema_name)
#
# Generates a schema_version.md5 file inside the given chewBBACA schema
# directory.  The file contains a fingerprint built from the sorted list of
# all *.fasta file names and their byte sizes.  Using names+sizes instead of
# full MD5s keeps generation fast even for large schemas (thousands of loci),
# while still reliably detecting additions, deletions or size-changing edits.
#
# The MD5 of this marker file is what gets stored in db_freeze.config and is
# used by resolve_and_verify_databases to confirm the frozen copy matches.
#
# The body (everything after the # header) is also what
# _chewbbaca_schema_fingerprint() returns, so a frozen copy can be checked
# against its own marker at run time. Since B16 it ends with the active
# filter (from schema.ini) and its MD5: the filter decides which loci are
# typed, so a changed filter is a new schema version.
sub _chewbbaca_schema_fingerprint {
    my ($schema_dir) = @_;
    opendir(my $dh, $schema_dir) or return undef;
    my @fasta_files = sort grep { /\.fasta$/i && -f "$schema_dir/$_" } readdir($dh);
    closedir($dh);
    return undef unless @fasta_files;

    # Same "name:size" form as markers made before B16 (-s gives "" for an
    # empty file), so their MD5 stays valid when nothing has changed.
    my @lines = map { "$_:" . ( -s "$schema_dir/$_" // 0 ) } @fasta_files;

    my $ini = "$schema_dir/schema.ini";
    if ( -f $ini && open( my $ifh, '<', $ini ) ) {
        my $filter = "";
        while ( my $l = <$ifh> ) {
            $filter = $1 if $l =~ /^\s*filter\s*=\s*(.*?)\s*$/;
        }
        close $ifh;
        if ( $filter ne "" && $filter ne "unfiltered" ) {
            my $abs = File::Spec->file_name_is_absolute($filter) ? $filter : "$schema_dir/$filter";
            push @lines, "filter:$filter:" . ( -f $abs ? md5_file($abs) : "missing" );
        }
    }
    return { loci => scalar(@fasta_files), lines => \@lines };
}

# Body lines of an existing marker file (the part after the # header).
sub _chewbbaca_marker_body {
    my ($marker_path) = @_;
    open( my $fh, '<', $marker_path ) or return undef;
    my @lines = grep { $_ ne "" && !/^#/ } map { s/\s+$//r } <$fh>;
    close $fh;
    return \@lines;
}

sub _generate_chewbbaca_schema_marker {
    my ($schema_dir, $schema_name) = @_;
    my $marker_path = "$schema_dir/schema_version.md5";

    my $fp = _chewbbaca_schema_fingerprint($schema_dir);
    unless ($fp) {
        log_message("WARNING: [$schema_name] No .fasta files found in (or cannot read) schema directory [$schema_dir] -- cannot generate marker", "yellow");
        return 0;
    }

    my $content = "";
    $content .= "# chewBBACA schema version marker\n";
    $content .= "# Schema:    $schema_name\n";
    $content .= "# Generated: " . strftime("%Y-%m-%d %H:%M:%S", localtime) . "\n";
    $content .= "# Loci:      $fp->{loci}\n";
    $content .= "# Method:    sorted-loci-name-size fingerprint, then the active filter and its MD5\n";
    $content .= "#\n";
    $content .= "$_\n" for @{ $fp->{lines} };

    open my $fh, '>', $marker_path or do {
        log_message("WARNING: [$schema_name] Cannot write schema marker [$marker_path]: $!", "yellow");
        return 0;
    };
    print $fh $content;
    close $fh;

    log_message("NOTICE: [$schema_name] Schema version marker generated: $marker_path ($fp->{loci} loci)");
    return 1;
}

# --verify-databases (B12): every database in db_freeze.config is checked
# with a full MD5 of its marker files (the remembered values in <file>.md5
# are not used, and are renewed), and its version is named. A frozen
# database whose files no longer match is an error. For an unknown version
# the line to add to <db>/known_databases.tsv is printed. Returns the
# number of errors.
sub _cmd_verify_databases {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my $path = $R_cfg->{general}{db_freeze_config} // "";
    unless ( $path ne "" && -f $path ) {
        log_message("ERROR: --verify-databases needs db_freeze.config ($path not found)", "red");
        return 1;
    }
    my $dbs = load_databases_config($path);
    local $S_FULL_DB_VERIFY = 1;
    log_message("NOTICE: Verifying all databases with a full MD5 of their marker files -- this can take several minutes");
    my $errors = resolve_and_verify_databases( $dbs, undef );
    my $v = $rundata{provenance}{run}{db_versions} // {};
    my @unknown;
    log_message("NOTICE:");
    for my $name ( sort keys %$dbs ) {
        my $e = $v->{$name} or next;
        log_message( sprintf( "NOTICE: %-20s %-14s %s", $name, $e->{status}, $e->{version} ) );
        log_message( sprintf( "NOTICE: %-20s fingerprint %s", "", $e->{fingerprint} ) );
        push @unknown, "$name\t$e->{fingerprint}\t*\t<label, e.g. what was downloaded and when>"
            if $e->{version} eq "unknown version" || $e->{version} =~ /\(installed /;
    }
    if (@unknown) {
        log_message("NOTICE:");
        log_message("NOTICE: To name a version, add a line to " . peekdir("db") . "/known_databases.tsv:");
        log_message("NOTICE:   $_") for @unknown;
    }
    return $errors;
}

sub _cmd_freeze_databases {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($filter_arg) = @_;

    # Parse optional filter: comma-separated list of database names to process
    my %filter;
    if (defined $filter_arg && $filter_arg ne "") {
        %filter = map { $_ => 1 } split /\s*,\s*/, $filter_arg;
        log_message("NOTICE: --freeze-databases filter: only processing: " . join(", ", sort keys %filter));
    }

    my $db_path  = $R_cfg->{general}{db_freeze_config} // "";
    my $db_root_ = getdir("db");
    # Resolve relative path against db root (safety net in case expansion block ran early)
    if ($db_path ne "" && !File::Spec->file_name_is_absolute($db_path)) {
        $db_path = File::Spec->catfile($db_root_, $db_path);
    }

    # If db_freeze.config is missing, offer to create a default one.
    unless ($db_path && -f $db_path) {
        # Determine where to place it: db root is always the preferred location
        if ($db_path eq "") {
            $db_path = File::Spec->catfile($db_root_, "db_freeze.config");
            log_message("NOTICE: general.db_freeze_config is not set -- will use [$db_path]", "yellow");
        } else {
            log_message("NOTICE: db_freeze.config not found at [$db_path]", "yellow");
        }

        my $create_it;
        if ($ASSUME_YES) {
            $create_it = 1;
            log_message("NOTICE: --assume-yes: creating default db_freeze.config automatically");
        } else {
            $create_it = prompt_yes_no(
                "db_freeze.config does not exist. Create a default one at [$db_path]?", 1);
        }

        unless ($create_it) {
            log_message("INFO: Aborting --freeze-databases -- db_freeze.config is required.");
            return;
        }

        write_default_databases_config($db_path)
            or do {
                log_message("ERROR: Could not create db_freeze.config at [$db_path].", "red");
                return;
            };

        # Update config so the rest of this function can find it
        $R_cfg->{general}{db_freeze_config} = $db_path;

        log_message("NOTICE: A default db_freeze.config was created at [$db_path].");
        log_message("NOTICE: Review it and adjust paths before rerunning --freeze-databases if needed.");
        log_message("NOTICE: Continuing with freeze using the newly created config...");
    }

    my $dbs = load_databases_config($db_path);
    unless (%$dbs) {
        log_message("ERROR: db_freeze.config is empty or unreadable: $db_path", "red");
        return;
    }

    # Append entries for enabled tools whose database is not yet listed
    # (db_freeze.config written before the tool was added to the pipeline).
    {
        my @missing = grep {
            my ($section) = @$_;
            my $en = $R_cfg->{$section}{enabled} // 1;
            $en && $en ne "0" && !exists $dbs->{$section};
        } default_db_freeze_entries();
        if (@missing) {
            log_message("NOTICE: Appending missing database entries to $db_path: " . join(", ", map { $_->[0] } @missing));
            if (open my $fh_append, '>>', $db_path) {
                for my $e (@missing) {
                    my ($section, $rel, $marker, $config_key, $note) = @$e;
                    print $fh_append "[$section]\n";
                    print $fh_append "marker_file  = $marker\n";
                    print $fh_append "marker_md5   =\n";
                    print $fh_append "config_key   = $config_key\n";
                    print $fh_append "note         = $note\n";
                    print $fh_append "\n";
                }
                close $fh_append;
                $dbs = load_databases_config($db_path);
            } else {
                log_message("WARNING: Cannot update db_freeze.config [$db_path]: $!", "yellow");
            }
        }
    }

    # Check if any enabled chewbbaca schemas are missing from the loaded config.
    # This happens when db_freeze.config was created before chewbbaca support was
    # added -- the file exists so write_default_databases_config was never called,
    # and the chewbbaca entries were never appended.
    {
        my $chewbbaca_enabled = $R_cfg->{chewbbaca}{enabled} // 1;
        if ($chewbbaca_enabled && $chewbbaca_enabled ne "0") {
            my $schemas = $R_cfg->{chewbbaca_schemas} // {};
            my @missing_schemas;
            for my $schema_name (sort keys %$schemas) {
                my $schema = $schemas->{$schema_name};
                next unless ($schema->{enabled} // 1) && ($schema->{enabled} // 1) ne "0";
                my $entry_name = "chewbbaca_$schema_name";
                unless (exists $dbs->{$entry_name}) {
                    push @missing_schemas, $schema_name;
                }
            }
            if (@missing_schemas) {
                log_message("NOTICE: db_freeze.config is missing chewBBACA schema entries: "
                          . join(", ", @missing_schemas));
                log_message("NOTICE: Appending missing chewBBACA schema entries to $db_path ...");
                if (open my $fh_append, '>>', $db_path) {
                    for my $schema_name (@missing_schemas) {
                        my $schema      = $schemas->{$schema_name};
                        my $schema_path = $schema->{path} // "";
                        $schema_path    = fill_placeholders($schema_path);
                        my $species_note = $schema->{species} // $schema_name;
                        $species_note =~ s/,/, /g;
                        print $fh_append "[chewbbaca_$schema_name]\n";
                        print $fh_append "marker_file  = schema_version.md5\n";
                        print $fh_append "marker_md5   =\n";
                        print $fh_append "config_key   = chewbbaca_schemas.$schema_name.path\n";
                        print $fh_append "note         = chewBBACA schema ($species_note)\n";
                        print $fh_append "\n";
                    }
                    close $fh_append;
                    log_message("NOTICE: db_freeze.config updated -- reloading...");
                    $dbs = load_databases_config($db_path);
                    unless (%$dbs) {
                        log_message("ERROR: db_freeze.config is empty or unreadable after update: $db_path", "red");
                        return;
                    }
                } else {
                    log_message("WARNING: Cannot update db_freeze.config [$db_path]: $! -- chewBBACA schemas will be skipped", "yellow");
                }
            }
        }
    }

    # Determine frozen_dbs root.
    # Priority: 1. explicit general.frozen_dbs_root in config
    #           2. <db dir>/frozen_dbs  (the standard layout)
    #           3. dirname of db_freeze.config file / frozen_dbs  (last resort)
    my $frozen_root = get_frozen_dbs_root(File::Basename::dirname($db_path));
    log_message("NOTICE: Frozen databases will be stored under: $frozen_root");

    # Inspect each database:
    #   - truth is whether frozen_dbs/<name>/<md5>/ exists on disk
    #   - db_freeze.config is a pointer that must be consistent with that truth
    #   - three outcomes per database:
    #       SKIP_OK    : frozen dir exists AND config already has correct marker_md5
    #       FIX_CONFIG : frozen dir exists but config marker_md5 is wrong/missing
    #       FREEZE     : frozen dir does not exist yet -- copy needed
    my (@to_freeze, @to_fix_config, @already_ok);
    for my $name (sort keys %$dbs) {

        # Apply name filter if specified
        if (%filter && !$filter{$name}) {
            log_message("NOTICE: [$name] not in filter -- skipping");
            next;
        }

        my $db         = $dbs->{$name};
        my $config_key = $db->{config_key} // "";
        my $prog       = ($config_key =~ /^chewbbaca_schemas\./) ? "chewbbaca"
                       : ($config_key =~ /^(\w+)\./) ? $1
                       : $name;
        my $prog_enabled = $R_cfg->{$prog}{enabled} // 1;
        if (!$prog_enabled || $prog_enabled eq "0") {
            log_message("NOTICE: [$name] -- program '$prog' is disabled -- skipping");
            next;
        }

        # Resolve the live database path via config_key from the main config
        # (db_path in eurlc-wgs.config, supporting __DB__ placeholders).
        # db_freeze.config intentionally does NOT store paths.
        my $root = "";
        if ($config_key ne "") {
            my @kp = split /\./, $config_key;
            if (@kp == 2) {
                $root = fill_placeholders($R_cfg->{$kp[0]}{$kp[1]} // "");
            } elsif (@kp == 3) {
                $root = fill_placeholders($R_cfg->{$kp[0]}{$kp[1]}{$kp[2]} // "");
            }
        }
        # Backward-compat: old db_freeze.config entries may still carry a path field
        if ($root eq "" && defined $db->{path} && $db->{path} ne "") {
            $root = fill_placeholders($db->{path});
        }

        my $marker  = $db->{marker_file} // "";
        my $ref_md5 = $db->{marker_md5}  // "";

        unless ($root ne "" && -d $root) {
            log_message("WARNING: [$name] live database directory not found: "
                      . ($root || "(path not resolved -- check db_path in eurlc-wgs.config)")
                      . " -- skipping", "yellow");
            next;
        }

        # For chewbbaca schemas: auto-generate schema_version.md5 if not yet present.
        # The marker is a fingerprint (sorted loci filenames + sizes) that identifies
        # the schema version without requiring a full MD5 of all allele FASTA files.
        my $marker_path = "$root/$marker";
        # An existing marker is rewritten when the schema or its filter has
        # changed since it was made (B16); otherwise it is left alone, so its
        # MD5 -- the frozen version -- stays the same.
        if ($marker eq "schema_version.md5" && -f $marker_path) {
            my $fp   = _chewbbaca_schema_fingerprint($root);
            my $body = _chewbbaca_marker_body($marker_path);
            if ( $fp && $body && join("\n", @$body) ne join("\n", @{ $fp->{lines} }) ) {
                log_message("NOTICE: [$name] schema or filter changed since the marker was made -- regenerating it (new frozen version)");
                unlink $marker_path;
            }
        }
        if ($marker eq "schema_version.md5" && !-f $marker_path) {
            log_message("NOTICE: [$name] generating schema version marker...");
            _generate_chewbbaca_schema_marker($root, $name)
                or do {
                    log_message("WARNING: [$name] could not generate schema marker -- skipping", "yellow");
                    next;
                };
        }

        # One marker file, or a list of them (B12): db_marker_fingerprint.
        my $fpr = db_marker_fingerprint( $root, $marker );
        if ( $fpr->{error} ) {
            log_message("WARNING: [$name] $fpr->{error} -- skipping", "yellow");
            next;
        }
        my $actual_md5 = $fpr->{fingerprint};

        # Bracken requires its own marker file inside the kraken2 directory.
        # Since bracken is an obligatory part of kraken2 analysis and shares
        # the same database directory, we validate it here rather than as a
        # separate db_freeze.config entry (which would cause a duplicate copy).
        if ($name eq "kraken2") {
            my $bracken_marker = "$root/database150mers.kmer_distrib";
            unless (-f $bracken_marker) {
                log_message("ERROR: Bracken marker file not found in kraken2 database directory:", "red");
                log_message("ERROR:   $bracken_marker", "red");
                log_message("ERROR: The kraken2 database must contain Bracken distribution files "
                          . "(database*mers.kmer_distrib) before it can be frozen.", "red");
                log_message("ERROR: Run 'bracken-build -d $root -t <threads> -k 35 -l 150' "
                          . "to generate them, then retry --freeze-databases.", "red");
                log_message("ERROR: Aborting freeze.", "red");
                return;
            }
            log_message("NOTICE: [kraken2] Bracken marker file found: $bracken_marker -- OK");
        }

        # For chewbbaca schemas: capture any associated filter file path so it
        # can be copied into the frozen schema directory during Phase A.
        my $filter_file = "";
        if ($config_key =~ /^chewbbaca_schemas\.([^.]+)\./) {   # [^.]: schema names contain hyphens (A7)
            my $schema_key = $1;
            my $f = $R_cfg->{chewbbaca_schemas}{$schema_key}{filter} // "";
            if ($f && $f ne "unfiltered") {
                $f = fill_placeholder_string($f, {});
                $f = fill_placeholders($f);
                $filter_file = $f if $f ne "unfiltered" && -f $f;
            }
        }

        my $frozen_dir = "$frozen_root/$name/$actual_md5";
        if (-d $frozen_dir) {
            if ($ref_md5 eq $actual_md5) {
                # Frozen dir exists and config is correct -- nothing to do
                log_message("NOTICE: [$name] already frozen and config up to date (md5=$actual_md5) -- skipping");
                push @already_ok, $name;
            } else {
                # Frozen dir exists but config pointer is wrong/missing -- fix config only
                log_message("NOTICE: [$name] frozen directory exists ($frozen_dir) but db_freeze.config "
                          . "marker_md5 is [" . ($ref_md5 || "not set") . "] -- will update config");
                push @to_fix_config, { name => $name, root => $root, marker => $marker,
                                       md5 => $actual_md5, frozen_dir => $frozen_dir };
            }
        } else {
            # Frozen dir does not exist -- full freeze needed
            push @to_freeze, { name => $name, root => $root, marker => $marker,
                                md5 => $actual_md5, frozen_dir => $frozen_dir,
                                filter_file => $filter_file };
        }
    }

    if (!@to_freeze && !@to_fix_config) {
        log_message("NOTICE: All databases already frozen and config up to date -- nothing to do.", "green");
        return;
    }

    # Show plan and prompt
    if (@to_freeze) {
        log_message("NOTICE: The following databases will be frozen (copy + config update):", "green");
        for my $db (@to_freeze) {
            log_message(sprintf("NOTICE:   %-24s  %s  →  %s", $db->{name}, $db->{root}, $db->{frozen_dir}));
        }
    }
    if (@to_fix_config) {
        log_message("NOTICE: The following databases only need a config update (frozen dir already exists):", "green");
        for my $db (@to_fix_config) {
            log_message(sprintf("NOTICE:   %-24s  marker_md5 → %s", $db->{name}, $db->{md5}));
        }
    }
    log_message("NOTICE: Live database directories will NOT be modified. db_freeze.config will be updated.");

    unless ($ASSUME_YES) {
        my $ok = prompt_yes_no("Proceed with freezing databases?", 0);
        unless ($ok) {
            log_message("NOTICE: Freeze cancelled.");
            return;
        }
    }

    # Backup db_freeze.config first
    my $backup = "$db_path.bak." . strftime("%Y%m%d_%H%M%S", localtime);
    File::Copy::copy($db_path, $backup)
        or log_message("WARNING: Could not back up db_freeze.config to $backup: $!", "yellow");

    # Read raw config text for in-place update
    open my $fh_in, '<', $db_path or do {
        log_message("ERROR: Cannot read db_freeze.config: $!", "red"); return;
    };
    my $config_text = do { local $/; <$fh_in> };
    close $fh_in;

    my (@frozen_ok, $config_changed);

    # Phase A: databases that need copying
    for my $db (@to_freeze) {
        my $target = $db->{frozen_dir};
        log_message("NOTICE: Freezing $db->{name}: $db->{root} → $target ...");

        ensure_dir("$frozen_root/$db->{name}");

        my $ok = system("cp", "-r", $db->{root}, $target) == 0;
        unless ($ok) {
            log_message("ERROR: Copy failed for $db->{name}: $!", "red");
            next;
        }

        # For chewbbaca schemas: also copy any associated filter file into the
        # frozen schema directory. This keeps the frozen snapshot self-contained
        # and allows resolve_and_verify_databases to remap {filter} to the frozen path.
        if ($db->{filter_file} && -f $db->{filter_file}) {
            my $filter_dest = "$target/" . File::Basename::basename($db->{filter_file});
            if (File::Copy::copy($db->{filter_file}, $filter_dest)) {
                log_message("NOTICE:   Filter file frozen: $filter_dest");
            } else {
                log_message("WARNING:  Could not copy filter file to frozen dir [$filter_dest]: $!", "yellow");
            }
        }

        # Verify MD5 in frozen copy
        # Full MD5 of the copy (not the remembered values, which were copied
        # along); this also remembers them for the frozen copy's later runs.
        my $vfr = db_marker_fingerprint( $target, $db->{marker}, full => 1 );
        my $verify_md5 = $vfr->{fingerprint} // "";
        unless ($verify_md5 eq $db->{md5}) {
            log_message("ERROR: MD5 mismatch after copy for $db->{name} -- frozen copy may be corrupt. "
                       . "Not updating db_freeze.config for this entry.", "red");
            next;
        }

        _update_marker_md5_in_config(\$config_text, $db->{name}, $db->{md5});
        $config_changed = 1;
        push @frozen_ok, $db->{name};
        log_message("NOTICE:   ✓ $db->{name} frozen: $db->{md5}", "green");
    }

    # Phase B: databases where frozen dir already existed but config was out of sync
    for my $db (@to_fix_config) {
        _update_marker_md5_in_config(\$config_text, $db->{name}, $db->{md5});
        $config_changed = 1;
        push @frozen_ok, $db->{name};
        log_message("NOTICE:   ✓ $db->{name} config updated: marker_md5 = $db->{md5}", "green");
    }

    if ($config_changed) {
        open my $fh_out, '>', $db_path or do {
            log_message("ERROR: Cannot write db_freeze.config: $! (backup at $backup)", "red");
            return;
        };
        print $fh_out $config_text;
        close $fh_out;
        log_message("NOTICE: db_freeze.config updated. Backup at $backup.", "green");
    }

    my $attempted = scalar(@to_freeze) + scalar(@to_fix_config);
    my $failed    = $attempted - scalar(@frozen_ok);
    if ($failed > 0) {
        log_message("WARNING: $failed database(s) could not be processed -- see errors above.", "yellow");
    } else {
        log_message("NOTICE: All databases frozen successfully. Run --generate-seal when ready.", "green");
    }
}

# _update_marker_md5_in_config(\$config_text, $db_name, $new_md5)
#
# Updates the marker_md5 line for $db_name in the raw config text.
# If marker_md5 is already set to a DIFFERENT value, the old line is
# commented out with a datestamp so the history is preserved in the file:
#
#   # marker_md5 = a3f9b2c1...   [replaced 2026-10-24 by freeze-databases]
#   marker_md5 = 7d4e1f8a...
#
# If marker_md5 is not present at all, a new line is inserted after the
# last key in the section.  If marker_md5 is already set to the same value,
# the text is left unchanged.
sub _update_marker_md5_in_config {
    my ($text_ref, $db_name, $new_md5) = @_;

    my $date  = strftime("%Y-%m-%d", localtime);
    my $stamp = "replaced $date by --freeze-databases";

    # Match the section and capture the marker_md5 line (if any).
    # Handles three cases:
    #   marker_md5 = <value>      -- existing non-empty value (update or skip if same)
    #   marker_md5 =              -- empty value (just write the new md5)
    #   (absent)                  -- insert a new line at end of section
    #
    # We do NOT touch lines that start with ; (comments), so a user who has
    # hand-commented out their marker_md5 line keeps it commented.
    my $replaced = 0;
    $$text_ref =~ s{
        (\[$db_name\]          # section header
        .*?)                   # anything before marker_md5 (non-greedy, dotall)
        (^[ \t]*marker_md5     # the key at start of line (preserve indentation)
         [ \t]*=[ \t]*)        # = sign with optional spaces
        (\S*)                  # current value (may be empty)
        ([ \t]*(?:\#[^\n]*)?)  # optional trailing comment
        (\n)                   # newline
    }{
        $replaced = 1;
        if ($3 eq $new_md5) {
            # Already correct -- leave unchanged
            "$1$2$3$4$5"
        } elsif ($3 eq "") {
            # Was empty -- just fill in the value
            "$1$2$new_md5$4$5"
        } else {
            # Had a different value -- comment out old line, write new below
            "$1# $2$3$4  # [$stamp]$5${2}$new_md5$5"
        }
    }semx;

    # If no marker_md5 line existed in the section (and we didn't replace one), append one
    unless ($replaced) {
        $$text_ref =~ s{(\[$db_name\][^\[]*?)(\n(?=\[|$))}{${1}\nmarker_md5 = $new_md5$2}s;
    }
}

# --generate-seal[=NAME]: auto-generate conda_manifest.ini, then write config_seal.ini.
#
# Flow:
#   1. Verify all databases are frozen (db_freeze.config complete).
#   2. Snapshot all enabled conda environments → conda_manifest.ini (always overwritten).
#   3. Fingerprint eurlc-wgs.config, db_freeze.config, conda_manifest.ini → config_seal.ini.
#
# conda_manifest.ini is always regenerated as part of sealing -- it is not a
# file the user maintains by hand.  The seal is meaningless without it.
sub _cmd_generate_seal {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($seal_name) = @_;

    my $db_path   = $R_cfg->{general}{db_freeze_config} // "";
    my $cfg_path  = $rundata{config}{path}              // "";
    my $seal_path = $R_cfg->{general}{seal}             // "";

    unless ($db_path && -f $db_path) {
        log_message("ERROR: --generate-seal requires db_freeze.config to be found. "
                   . "Set general.db_freeze_config or place db_freeze.config next to "
                   . "eurlc-wgs.config.", "red");
        return;
    }

    # Resolve the directory where seal and manifest will be written.
    my $config_dir = $cfg_path ne ""
        ? File::Basename::dirname($cfg_path)
        : File::Basename::dirname($db_path);

    if ($seal_path eq "") {
        $seal_path = "$config_dir/config_seal.ini";
    }

    # Derive conda_manifest path from seal path (always next to it)
    my $manifest_path = File::Basename::dirname($seal_path) . "/conda_manifest.ini";
    # Store resolved path so startup verification can find it
    $R_cfg->{general}{conda_manifest} = $manifest_path;

    # ── 1. Check all databases are frozen ───────────────────────────────────
    my $dbs = load_databases_config($db_path);
    my @unfrozen;
    for my $name (sort keys %$dbs) {
        my $md5 = $dbs->{$name}{marker_md5} // "";
        push @unfrozen, $name if $md5 eq "";
    }
    if (@unfrozen) {
        log_message("ERROR: Cannot generate seal -- the following databases are not frozen "
                   . "(marker_md5 not set in db_freeze.config):", "red");
        log_message("ERROR:   - $_", "red") for @unfrozen;
        log_message("ERROR: Run --freeze-databases first.", "red");
        return;
    }

    # ── 2. Snapshot conda environments → conda_manifest.ini ─────────────────
    log_message("NOTICE: Snapshotting conda environments → $manifest_path");

    my (%seen_env, @envs_to_snap);
    for my $tool (sort keys %$R_cfg) {
        next unless ref($R_cfg->{$tool}) eq 'HASH';
        my $env = $R_cfg->{$tool}{env} // "";
        next if $env eq "" || $env eq "base";
        next if $seen_env{$env}++;
        next unless ($R_cfg->{$tool}{enabled} // 1);
        push @envs_to_snap, { tool => $tool, env => $env };
    }

    my $created = strftime("%Y-%m-%d %H:%M:%S", localtime);

    open my $mfh, '>', $manifest_path or do {
        log_message("ERROR: Cannot write conda_manifest.ini [$manifest_path]: $!", "red");
        return;
    };
    print $mfh "# conda_manifest.ini -- conda environment fingerprints\n";
    print $mfh "# Auto-generated by --generate-seal on $created\n";
    print $mfh "# Do not edit by hand. Regenerate with: eurlc-wgs --generate-seal\n\n";

    my $snap_errors = 0;
    for my $entry (sort { $a->{env} cmp $b->{env} } @envs_to_snap) {
        my ($tool, $env) = @{$entry}{qw(tool env)};
        my $fp = conda_env_fingerprint($env);
        if (defined $fp) {
            print $mfh "[$env]\n";
            print $mfh "explicit_list_md5 = $fp\n";
            print $mfh "tool              = $tool\n\n";
            log_message("NOTICE:   OK  $env");
        } else {
            log_message("WARNING: Could not fingerprint conda env [$env] (not installed?)", "yellow");
            print $mfh "[$env]\n";
            print $mfh "; WARNING: environment not found at seal time\n";
            print $mfh "explicit_list_md5 =\n";
            print $mfh "tool              = $tool\n\n";
            $snap_errors++;
        }
    }
    close $mfh;

    if ($snap_errors) {
        log_message("WARNING: $snap_errors environment(s) could not be fingerprinted -- "
                   . "install missing tools before sealing.", "yellow");
    }

    # ── 3. Fingerprint all three config files → config_seal.ini ─────────────
    my %fp;
    $fp{eurlc_wgs_config} = ($cfg_path       && -f $cfg_path)       ? md5_file($cfg_path)       : "";
    $fp{db_freeze_config} = ($db_path        && -f $db_path)        ? md5_file($db_path)        : "";
    $fp{conda_manifest}   = ($manifest_path  && -f $manifest_path)  ? md5_file($manifest_path)  : "";
    my $pfp = pipeline_seal_fingerprints();

    open my $sfh, '>', $seal_path or do {
        log_message("ERROR: Cannot write config_seal.ini [$seal_path]: $!", "red");
        return;
    };

    print $sfh <<"SEAL";
# config_seal.ini -- configuration attestation
#
# This file locks the configuration to a named, approved state.
# If present, the pipeline verifies fingerprints at startup and warns
# if any config file has changed since the seal was generated.
#
# To regenerate (also regenerates conda_manifest.ini):
#   eurlc-wgs --generate-seal="$seal_name"
#
# To unseal (run without verification): delete or move this file.

[seal]
name        = $seal_name
created     = $created
created_by  = (fill in your name)
description = (fill in: purpose, validated species, accreditation reference, etc.)

[fingerprints]
eurlc_wgs_config = $fp{eurlc_wgs_config}
db_freeze_config = $fp{db_freeze_config}
conda_manifest   = $fp{conda_manifest}

# The pipeline itself (B13): a new version or a changed script breaks the
# seal. genome_sizes_local = none means there was no <db>/genome_sizes.tsv.
pipeline_version     = $pfp->{pipeline_version}
pipeline_md5         = $pfp->{pipeline_md5}
genome_sizes_bundled = $pfp->{genome_sizes_bundled}
genome_sizes_local   = $pfp->{genome_sizes_local}
SEAL

    close $sfh;

    log_message("NOTICE: Config seal generated: $seal_path", "green");
    log_message("NOTICE: Seal name: $seal_name (pipeline $pfp->{pipeline_version})");
    log_message("NOTICE: Open $seal_path and fill in 'created_by' and 'description'.");
    log_message("NOTICE: Reference this seal name in your method documentation when recording runs.");
}

# ---------------------------------------------------------------------------
# load_schema_catalogs()
#
# Scans db/chewbbaca/catalog/*.json and merges all catalog files into a flat
# hash of available schemas keyed by schema name.  Multiple catalog files are
# merged; if the same schema name appears in more than one catalog, the last
# file wins (alphabetical order).
#
# Returns: %catalog  (schema_name => catalog entry hashref)
# ---------------------------------------------------------------------------
sub load_schema_catalogs {
    my $db = peekdir("db");
    return () if $db eq "";

    # Make sure the builtin catalog exists and is current (B16). Before,
    # only --install-efsa-schemas wrote it.
    # Only where the database folder is writable; a read-only one keeps
    # whatever catalog it has.
    eval { _efsa_ensure_builtin_catalog($db) } if -w $db;

    my $catalog_dir = "$db/chewbbaca/catalog";
    return () unless -d $catalog_dir;

    my %catalog;
    for my $json_file (sort glob("$catalog_dir/*.json")) {
        open(my $fh, "<:utf8", $json_file) or next;
        my $content = do { local $/; <$fh> };
        close $fh;

        # Parse JSON: prefer JSON (XS) if available, fall back to JSON::PP (Perl core).
        my $data;
        eval {
            local $@;
            eval { require JSON; $data = JSON::decode_json($content) };
            if ($@) {
                require JSON::PP;
                $data = JSON::PP::decode_json($content);
            }
        };
        if ($@ || !defined $data) {
            (my $err = $@) =~ s/ at .* line \d+.*//s;
            log_message("WARNING: Could not parse catalog $json_file: $err", "yellow");
            next;
        }

        my $cat_name = $data->{catalog_name} // basename($json_file, ".json");
        my $schemas  = $data->{schemas} // [];
        for my $entry (@$schemas) {
            my $name = $entry->{name} or next;
            $entry->{_catalog_name} = $cat_name;
            $entry->{_catalog_file} = $json_file;
            $catalog{$name} = $entry;
        }
    }
    return %catalog;
}

# ---------------------------------------------------------------------------
# _cmd_list_schemas()
#
# Lists installed schemas (from discover_installed_schemas) and available
# schemas (from catalog JSONs in db/chewbbaca/catalog/).
# ---------------------------------------------------------------------------
sub _cmd_list_schemas {
    $S_SUPPRESS_STARTUP_LOG = 0;

    # ── Color shortcuts ───────────────────────────────────────────────────────
    my $C_RESET  = colorize_for_screen("reset");
    my $C_BOLD   = colorize_for_screen("bold");
    my $C_DIM    = colorize_for_screen("dark");
    my $C_CYAN   = colorize_for_screen("cyan");
    my $C_GREEN  = colorize_for_screen("green");
    my $C_YELLOW = colorize_for_screen("yellow");
    my $C_WHITE  = colorize_for_screen("bold white");

    # ── Helper: print a section header ───────────────────────────────────────
    my $LINE = "─" x 60;
    my $DBL  = "═" x 60;

    my $p = sub { print @_, "\n" };   # plain print + newline

    $p->("");
    $p->( $C_BOLD . $C_CYAN . $DBL . $C_RESET );
    $p->( $C_BOLD . "  chewBBACA schema catalog" . $C_RESET );
    $p->( $C_BOLD . $C_CYAN . $DBL . $C_RESET );

    # ── Installed schemas ─────────────────────────────────────────────────────
    my %installed = discover_installed_schemas();
    my $n_inst = scalar keys %installed;

    $p->("");
    $p->( $C_BOLD . "  Installed schemas  ($n_inst)" . $C_RESET );
    $p->( $C_DIM  . "  $LINE" . $C_RESET );

    if (%installed) {
        for my $name (sort keys %installed) {
            my $s = $installed{$name};
            my $enabled = ($s->{enabled} // 1);
            my $status_c = $enabled ? $C_GREEN : $C_YELLOW;
            my $status   = $enabled ? "enabled" : "disabled";

            my $filter_raw = $s->{filter} // "";
            my $filter_str = ($filter_raw eq "" || $filter_raw eq "unfiltered")
                             ? "(wgMLST / unfiltered)"
                             : "filter: " . basename($filter_raw);

            my $desc    = $s->{description} // $s->{species} // "";
            my $dir     = $s->{_schema_dir} // "";

            $p->("");
            $p->( "  " . $C_WHITE . $name . $C_RESET
                  . "  " . $status_c . "[$status]" . $C_RESET );
            $p->( "    " . $C_DIM . $desc . $C_RESET )         if $desc ne "";
            $p->( "    " . $C_DIM . $filter_str . $C_RESET );
            $p->( "    " . $C_DIM . "dir: $dir" . $C_RESET )   if $dir ne "";
        }
    } else {
        $p->( "  " . $C_DIM . "(none installed)" . $C_RESET );
        $p->( "  " . $C_DIM . "Use --install-schema=<name> to install a schema." . $C_RESET );
    }

    # ── Available schemas from catalog ───────────────────────────────────────
    my %catalog = load_schema_catalogs();
    my $n_cat = scalar keys %catalog;

    $p->("");
    $p->( $C_BOLD . "  Available in catalog  ($n_cat)" . $C_RESET );
    $p->( $C_DIM  . "  $LINE" . $C_RESET );

    if (%catalog) {
        for my $name (sort keys %catalog) {
            my $e       = $catalog{$name};
            my $label   = $e->{label} // $name;
            my $species = ref($e->{species}) eq 'ARRAY'
                          ? join(", ", @{$e->{species}}) : ($e->{species} // "");
            my $cat_n   = $e->{_catalog_name} // "";
            my $is_inst = exists $installed{$name};
            my $inst_tag = $is_inst
                ? "  " . $C_GREEN . "[installed]" . $C_RESET
                : "";

            $p->("");
            $p->( "  " . $C_WHITE . $name . $C_RESET . $inst_tag );
            $p->( "    " . $label );
            $p->( "    " . $C_DIM . $species . $C_RESET )  if $species ne "";
            $p->( "    " . $C_DIM . "catalog: $cat_n" . $C_RESET ) if $cat_n ne "";

            # Filters
            if (ref($e->{filters}) eq 'HASH') {
                my @fkeys = sort { # default filter first, then alphabetical
                    my $ad = ($e->{filters}{$a}{default} // 0);
                    my $bd = ($e->{filters}{$b}{default} // 0);
                    $bd <=> $ad || $a cmp $b
                } keys %{$e->{filters}};

                for my $fn (@fkeys) {
                    my $fi  = $e->{filters}{$fn};
                    my $def = ($fi->{default} // 0);
                    my $lbl = $fi->{label} // $fn;
                    my $def_tag = $def
                        ? "  " . $C_YELLOW . "[default filter]" . $C_RESET
                        : "";
                    $p->( sprintf("    %s  %-10s%s  %s%s",
                          $C_DIM . "filter:" . $C_RESET,
                          $fn, $C_RESET, $lbl, $def_tag) );
                }
            }
        }
    } else {
        my $db = peekdir("db");
        $p->( "  " . $C_DIM . "(no catalog files found in $db/chewbbaca/catalog/)" . $C_RESET );
        $p->( "  " . $C_DIM . "Place JSON catalog files there, or run --update-catalog." . $C_RESET );
    }

    # ── Footer ────────────────────────────────────────────────────────────────
    $p->("");
    $p->( $C_DIM . "  $LINE" . $C_RESET );
    $p->( "  Install a schema:    " . $C_CYAN . "eurlc-wgs --install-schema=<name>" . $C_RESET );
    $p->( "  Install all:         " . $C_CYAN . "eurlc-wgs --install-schema=all" . $C_RESET );
    $p->( "  Import a local dir:  " . $C_CYAN . "eurlc-wgs --import-schema=<dir>" . $C_RESET );
    $p->("");
}

# ---------------------------------------------------------------------------
# _cmd_install_schema($name_arg)
#
# Installs one or all schemas from the catalog.
# --install-schema=<name>   install a named schema
# --install-schema=all      install everything in the catalog
# --install-schema          show help / list catalog
# ---------------------------------------------------------------------------
sub _cmd_install_schema {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($name_arg) = @_;

    my %catalog = load_schema_catalogs();

    # ── No argument: show help ────────────────────────────────────────────────
    unless (defined $name_arg && $name_arg ne "") {
        log_message("NOTICE:");
        log_message("NOTICE: Usage:  eurlc-wgs --install-schema=<name>");
        log_message("NOTICE:         eurlc-wgs --install-schema=all");
        log_message("NOTICE:");
        if (%catalog) {
            log_message("NOTICE: Available schemas in catalog:");
            for my $n (sort keys %catalog) {
                log_message(sprintf("NOTICE:   %-35s %s", $n, $catalog{$n}{label} // ""));
            }
        } else {
            my $db = peekdir("db");
            log_message("NOTICE: No catalog files found in $db/chewbbaca/catalog/");
            log_message("NOTICE: Run --list-schemas for details.");
        }
        log_message("NOTICE:");
        log_message("NOTICE: See all schemas and status:  eurlc-wgs --list-schemas");
        return;
    }

    # ── Install all ───────────────────────────────────────────────────────────
    if (lc($name_arg) eq "all") {
        unless (%catalog) {
            log_message("ERROR: No schemas found in catalog.", "red");
            return;
        }
        my @all = sort keys %catalog;
        log_message("NOTICE:");
        log_message("NOTICE: Installing all " . scalar(@all) . " catalog schemas:");
        log_message("NOTICE:   - $catalog{$_}{label}") for @all;
        log_message("NOTICE:");
        my @failed;
        for my $n (@all) {
            log_message("NOTICE:");
            log_message("NOTICE: ════════════════════════════════════════════════════════");
            log_message("NOTICE: Installing: $catalog{$n}{label} [$n]");
            log_message("NOTICE: ════════════════════════════════════════════════════════");
            my $ok = _install_one_schema($catalog{$n});
            push @failed, $n unless $ok;
        }
        log_message("NOTICE:");
        log_message("NOTICE: ════════════════════════════════════════════════════════");
        if (@failed) {
            log_message("WARNING: Failed to install: " . join(", ", @failed), "yellow");
        } else {
            log_message("NOTICE: ✓  All schemas installed successfully.", "green");
        }
        return;
    }

    # ── Named schema ──────────────────────────────────────────────────────────
    my $entry = $catalog{$name_arg};
    unless ($entry) {
        # Fuzzy match
        my ($match) = grep { index($_, $name_arg) >= 0 || index($name_arg, $_) >= 0 }
                      sort keys %catalog;
        if ($match) {
            log_message("NOTICE: Interpreting '$name_arg' as '$match'.");
            $entry = $catalog{$match};
        } else {
            log_message("ERROR: Schema '$name_arg' not found in catalog.", "red");
            log_message("NOTICE: Run --list-schemas to see available schemas.");
            return;
        }
    }

    _install_one_schema($entry);
}

# ---------------------------------------------------------------------------
# _install_one_schema($catalog_entry_hashref)
#
# Downloads (or otherwise installs) one schema based on its catalog entry,
# then writes a schema.ini into the schema directory.
#
# The schema is placed directly at:
#   db/chewbbaca/schemas/<schema_name>/
#
# chewBBACA DownloadSchema creates a named subdir inside the -o target, so
# we use a temporary download container and then rename the inner subdir to
# the canonical name.
#
# Returns 1 on success, 0 on failure.
# ---------------------------------------------------------------------------
sub _install_one_schema {
    my ($entry) = @_;
    my $db = peekdir("db");
    if ($db eq "") {
        log_message("ERROR: No database directory configured. Set general.db in eurlc-wgs.config.", "red");
        return 0;
    }

    my $schema_name = $entry->{name}
        or do { log_message("ERROR: Catalog entry has no 'name' field.", "red"); return 0; };

    my $label      = $entry->{label}   // $schema_name;
    my $method     = ($entry->{install} // {})->{method} // "chewie-ns-download";
    my $chewy_env  = $R_cfg->{chewbbaca}{env} // "eurlc-wgs-chewbbaca";
    my $cpu        = ($entry->{install} // {})->{cpu} // $R_cfg->{general}{threads} // 4;

    my $schema_dir = "$db/chewbbaca/schemas/$schema_name";

    log_message("NOTICE:");
    log_message("NOTICE: ── Install schema: $label ──");
    log_message("NOTICE:   Schema name  : $schema_name");
    log_message("NOTICE:   Method       : $method");
    log_message("NOTICE:   Target dir   : $schema_dir/");
    log_message("NOTICE:   conda env    : $chewy_env");
    log_message("NOTICE:");

    ensure_dir("$db/chewbbaca/schemas");

    # ── Already installed? ────────────────────────────────────────────────────
    if (-d $schema_dir) {
        my @fastas = glob("$schema_dir/*.fasta");
        if (@fastas) {
            log_message("NOTICE: Schema already installed at $schema_dir");
            my $go = $ASSUME_YES || prompt_yes_no("  Remove and re-install?", 0);
            unless ($go) {
                log_message("NOTICE: Keeping existing installation.");
                # Update schema.ini with catalog metadata (non-destructive merge)
                _write_schema_ini($schema_dir, $entry, undef);
                return 1;
            }
            log_message("NOTICE: Removing existing installation...");
            remove_tree($schema_dir);
        }
    }

    # ── Download: Chewie-NS ───────────────────────────────────────────────────
    if ($method eq "chewie-ns-download") {
        my $meta    = $entry->{source_meta} // {};
        my $sp_id   = $meta->{species_id}
            or do { log_message("ERROR: Catalog entry for $schema_name missing source_meta.species_id", "red"); return 0; };
        my $sc_id   = $meta->{schema_id} // 1;

        # chewBBACA needs an empty container dir; it creates a named subdir inside.
        my $dl_container = "$db/chewbbaca/schemas/.dl_${schema_name}_$$";
        ensure_dir($dl_container);

        log_message("NOTICE: Downloading from Chewie-NS (species=$sp_id schema=$sc_id)...\n");
        my $dl_cmd = "conda run -n $chewy_env --no-capture-output chewBBACA.py DownloadSchema"
                   . " -sp $sp_id -sc $sc_id -o \"$dl_container\" --cpu $cpu";
        log_message("NOTICE: Running: $dl_cmd");
        my $rc = system($dl_cmd);

        if ($rc != 0) {
            log_message("ERROR: DownloadSchema failed (exit $rc).", "red");
            remove_tree($dl_container);
            return 0;
        }

        # Move the inner subdir to $schema_dir
        my @subdirs = grep { -d $_ } glob("$dl_container/*/");
        unless (@subdirs) {
            log_message("ERROR: Download succeeded but no schema subdir found in $dl_container", "red");
            remove_tree($dl_container);
            return 0;
        }
        my $inner = $subdirs[0];
        $inner =~ s{/$}{};

        rename($inner, $schema_dir)
            or do {
                log_message("ERROR: Could not move $inner → $schema_dir: $!", "red");
                remove_tree($dl_container);
                return 0;
            };
        remove_tree($dl_container);
        log_message("NOTICE: ✓  Schema downloaded to $schema_dir", "green");

    } else {
        log_message("ERROR: Unknown install method '$method' for schema $schema_name.", "red");
        log_message("NOTICE: Supported methods: chewie-ns-download");
        return 0;
    }

    # ── PrepExternalSchema ────────────────────────────────────────────────────
    # Uses ensure_schema_prepared() which handles short/ dir detection.
    log_message("NOTICE: Running PrepExternalSchema to prepare the schema...\n");
    unless (ensure_schema_prepared($schema_dir, $schema_name)) {
        log_message("WARNING: PrepExternalSchema failed — schema may not be usable.", "yellow");
        # Don't abort — the schema is on disk; user may fix manually.
    }

    # ── Resolve and install filter files ─────────────────────────────────────
    my $active_filter = _install_schema_filters($schema_dir, $entry, $db);

    # ── Write schema.ini ─────────────────────────────────────────────────────
    _write_schema_ini($schema_dir, $entry, $active_filter);

    log_message("NOTICE:");
    log_message("NOTICE: ✓  Schema '$schema_name' installed and ready.", "green");
    log_message("NOTICE:    Path: $schema_dir");
    log_message("NOTICE:    Run --list-schemas to verify.");
    return 1;
}

# ---------------------------------------------------------------------------
# _install_schema_filters($schema_dir, $entry, $db)
#
# Looks for filter files for each named filter in the catalog entry.
# Priority: file_url download → bundled pipeline resource → already on disk.
# Filter files are placed in $schema_dir/filters/<name>.txt
#
# Returns the name of the default filter (or undef if none).
# ---------------------------------------------------------------------------
sub _install_schema_filters {
    my ($schema_dir, $entry, $db) = @_;
    my $filters = $entry->{filters} // {};
    return undef unless %$filters;

    my $filter_dir = "$schema_dir/filters";
    ensure_dir($filter_dir);

    # Only return a default filter name if the default filter has an actual file.
    # A filter with file=null (e.g. "wgmlst" for Listeria) means "run unfiltered"
    # and must not be written to schema.ini as a filter name, since discover_installed_schemas
    # would try to resolve it as a path and pass it to chewBBACA via --genes-list.
    my $default_filter;

    for my $fname (sort keys %$filters) {
        my $fi = $filters->{$fname};
        $default_filter = $fname if (($fi->{default} // 0) && defined $fi->{file});

        # Target path
        my $target_file = "$filter_dir/$fname.txt";

        # Skip if filter has no file (e.g. wgmlst = run unfiltered)
        unless (defined $fi->{file}) {
            log_message("NOTICE:   Filter '$fname': no file (run unfiltered)");
            next;
        }

        next if -f $target_file;   # already present

        # Try file_url first
        if (($fi->{file_url} // "") ne "") {
            log_message("NOTICE:   Downloading filter '$fname' from $fi->{file_url} ...");
            my $rc = system("curl", "-fsSL", "-o", $target_file, $fi->{file_url});   # list form: no shell quoting (A6)
            if ($rc == 0 && -f $target_file) {
                log_message("NOTICE:   ✓  Filter '$fname' downloaded.", "green");
                next;
            }
            log_message("WARNING:   Filter '$fname' download failed — trying bundled.", "yellow");
        }

        # Try bundled resource (pipeline installation assets)
        if ($fi->{bundled} // 0) {
            my $schema_name = $entry->{name} // "";
            # Canonical location: share/eurlc-wgs/assets/chewbbaca/filters/<schema_name>/<fname>.txt
            # Fallback: alongside the pipeline script (development installs).
            my $assets_root = find_share_file("assets/chewbbaca");   # B30
            my $script_dir  = dirname(abs_path($0));
            my @search_paths = (
                "$assets_root/filters/${schema_name}/${fname}.txt",
                "$assets_root/filters/${fname}.txt",
                "$script_dir/assets/chewbbaca/filters/${schema_name}/${fname}.txt",
                "$script_dir/assets/chewbbaca/filters/${fname}.txt",
            );
            my ($found) = grep { -f $_ } @search_paths;
            if ($found) {
                system("cp", $found, $target_file);
                log_message("NOTICE:   ✓  Filter '$fname' copied from $found", "green");
                next;
            }
            log_message("WARNING:   Filter '$fname' marked bundled but not found in:", "yellow");
            log_message("WARNING:     $_") for @search_paths;
        }

        log_message("NOTICE:   Filter '$fname': place a locus list at $target_file");
    }

    return $default_filter;
}

# ---------------------------------------------------------------------------
# _write_schema_ini($schema_dir, $catalog_entry, $default_filter_name)
#
# Writes (or overwrites) $schema_dir/schema.ini from the catalog entry.
# Existing ini fields not covered by the catalog are preserved if the file
# already exists.
# ---------------------------------------------------------------------------
sub _write_schema_ini {
    my ($schema_dir, $entry, $default_filter) = @_;

    my $ini_path = "$schema_dir/schema.ini";

    my $name        = $entry->{name}        // basename($schema_dir);
    my $label       = $entry->{label}       // $name;
    my $description = $entry->{description} // $label;
    my $version     = $entry->{version}     // "1";
    my $source      = $entry->{source}      // "unknown";
    my $source_url  = ($entry->{source_meta} // {})->{url} // "";
    my $species_ref = $entry->{species}     // [];
    my $species_str = ref($species_ref) eq 'ARRAY' ? join(", ", @$species_ref) : $species_ref;

    # Build filter value: name of default filter, or "unfiltered"
    my $filter_val = $default_filter // "unfiltered";
    # Point to the actual file if it exists
    if ($default_filter) {
        my $fpath = "$schema_dir/filters/${default_filter}.txt";
        $filter_val = "filters/${default_filter}.txt" if -f $fpath;
    }

    open(my $fh, ">:utf8", $ini_path)
        or do { log_message("WARNING: Could not write $ini_path: $!", "yellow"); return; };

    print $fh "; schema.ini — auto-generated by eurlc-wgs --install-schema\n";
    print $fh "; Edit only if you need to override pipeline behaviour.\n";
    print $fh "\n";
    print $fh "[schema]\n";
    print $fh "name        = $name\n";
    print $fh "label       = $label\n";
    print $fh "description = $description\n";
    print $fh "version     = $version\n";
    print $fh "species     = $species_str\n";
    print $fh "source      = $source\n";
    print $fh "source_url  = $source_url\n";
    print $fh "filter      = $filter_val\n";
    print $fh "enabled     = 1\n";

    # Write source_meta fields for provenance
    my $meta = $entry->{source_meta} // {};
    if (%$meta) {
        print $fh "\n[source_meta]\n";
        for my $k (sort keys %$meta) {
            next if $k eq "url";   # already in [schema]
            print $fh "$k = $meta->{$k}\n";
        }
    }

    close $fh;
    log_message("NOTICE: ✓  Wrote schema.ini to $ini_path", "green");
}

# ---------------------------------------------------------------------------
# _cmd_import_schema($dir)
#
# Imports a locally available schema directory into db/chewbbaca/schemas/.
# The directory must contain .fasta files. A schema.ini is created if absent.
# ---------------------------------------------------------------------------
sub _cmd_import_schema {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($dir) = @_;

    unless (defined $dir && $dir ne "" && -d $dir) {
        log_message("NOTICE:");
        log_message("NOTICE: Usage:  eurlc-wgs --import-schema=<path/to/schema/dir>");
        log_message("NOTICE:");
        log_message("NOTICE: The directory must contain .fasta files (one per locus).");
        log_message("NOTICE: A schema.ini will be created from a template that you can edit.");
        log_message("NOTICE:");
        if (defined $dir && $dir ne "" && !-d $dir) {
            log_message("ERROR: Directory not found: $dir", "red");
        }
        return;
    }

    my @fastas = glob("$dir/*.fasta");
    unless (@fastas) {
        log_message("ERROR: No .fasta files found in $dir", "red");
        log_message("NOTICE: The schema directory must contain one .fasta file per locus.");
        return;
    }

    my $db = peekdir("db");
    if ($db eq "") {
        log_message("ERROR: No database directory configured. Set general.db in eurlc-wgs.config.", "red");
        return;
    }

    my $basename    = basename($dir);
    my $schema_name = $basename;
    $schema_name    =~ s/[^A-Za-z0-9_-]/_/g;
    my $schema_dir  = "$db/chewbbaca/schemas/$schema_name";

    log_message("NOTICE:");
    log_message("NOTICE: ── Import schema ──────────────────────────────────────");
    log_message("NOTICE:   Source      : $dir");
    log_message("NOTICE:   Schema name : $schema_name");
    log_message("NOTICE:   Target dir  : $schema_dir");
    log_message("NOTICE:   Loci found  : " . scalar(@fastas));
    log_message("NOTICE:");

    if (-d $schema_dir) {
        my $go = $ASSUME_YES || prompt_yes_no("  Target already exists. Overwrite?", 0);
        unless ($go) {
            log_message("NOTICE: Aborted.");
            return;
        }
        remove_tree($schema_dir);
    }

    system("cp", "-r", $dir, $schema_dir) == 0   # list form (A6)
        or do { log_message("ERROR: Failed to copy $dir → $schema_dir: $!", "red"); return; };

    log_message("NOTICE: ✓  Copied to $schema_dir", "green");

    # Write a template schema.ini if not already present
    unless (-f "$schema_dir/schema.ini") {
        my $fake_entry = {
            name        => $schema_name,
            label       => $schema_name,
            description => "Imported from $dir",
            version     => "1",
            source      => "custom",
            species     => [],
            source_meta => {},
        };
        _write_schema_ini($schema_dir, $fake_entry, undef);
        log_message("NOTICE: Edit $schema_dir/schema.ini to set species, description, etc.");
    }

    # Run PrepExternalSchema
    log_message("NOTICE: Running PrepExternalSchema...");
    ensure_schema_prepared($schema_dir, $schema_name);

    log_message("NOTICE:");
    log_message("NOTICE: ✓  Schema '$schema_name' imported.", "green");
    log_message("NOTICE:    Run --list-schemas to verify.");
}

# ---------------------------------------------------------------------------
# _cmd_update_catalog($url)
#
# Stub for v1: placeholder for downloading updated catalog JSON files.
# ---------------------------------------------------------------------------
sub _cmd_update_catalog {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($url) = @_;
    log_message("NOTICE:");
    log_message("NOTICE: --update-catalog is not yet implemented in this version.");
    log_message("NOTICE: To add schemas to the catalog, place JSON files in:");
    my $db = peekdir("db");
    log_message("NOTICE:   $db/chewbbaca/catalog/");
    log_message("NOTICE: See the builtin.json distributed with the pipeline for the format.");
    log_message("NOTICE:");
}

# ---------------------------------------------------------------------------
# _cmd_install_efsa_schemas()
#
# Downloads cgMLST schemas and allele filters from the EFSA One Health
# Azure DevOps repository:
#   https://dev.azure.com/efsa-devops/EFSA/_git/efsa.wgs.onehealth
#
# What EFSA publishes:
#   data/Campylobacter_schema/CAMPISO-PubMLST-8/   ← already PrepExternalSchema'd
#     *.fasta, short/*.fasta                         ← allele sequences
#     Campylobacter_jejuni_coli.trn                  ← prodigal training file
#     list_loci_cgMLST_CAMPISO.txt                   ← cgMLST loci filter
#   data/chewbbaca_filters/
#     cgMLST_ecoli.txt                               ← E. coli cgMLST loci filter
#     cgMLST_salmonella.txt                          ← Salmonella cgMLST loci filter
#
# After this command:
#   db/chewbbaca/schemas/CAMPISO-PubMLST-8/         ← installed & ready
#   db/chewbbaca/filters/cgMLST_ecoli.txt
#   db/chewbbaca/filters/cgMLST_salmonella.txt
#
# Note: E. coli and Salmonella schemas must be installed separately (PubMLST wgMLST).
# The filters downloaded here will be applied automatically once those schemas are
# installed and have matching filter paths.
# ---------------------------------------------------------------------------
sub _cmd_install_efsa_schemas {
    $S_SUPPRESS_STARTUP_LOG = 0;
    my ($arg) = @_;
    $arg //= "";

    my $EFSA_REPO_URL  = "https://dev.azure.com/efsa-devops/EFSA/_git/efsa.wgs.onehealth";
    my $EFSA_REPO_NAME = "efsa.wgs.onehealth";

    # Bundled chewBBACA assets live under share/eurlc-wgs/assets/chewbbaca/
    # relative to the pipeline's conda/install prefix.
    my $chewbbaca_assets = find_share_file("assets/chewbbaca");   # B30

    # ── Species definitions ───────────────────────────────────────────────────
    # Each entry describes one species:
    #   install_type      : "efsa_campy"  — copy schema from EFSA repo (no chewieNS download)
    #                       "chewie_ns"   — install via chewieNS catalog
    #   schema_name       : canonical name in db/chewbbaca/schemas/ and catalog
    #   filter_efsa       : path under $chewbbaca_assets to the EFSA-compatible filter
    #                       (uses INNUENDO locus names; required for EFSA upload). undef = no filter.
    #   filter_chewiens   : path under $chewbbaca_assets to the chewieNS filter
    #                       (uses wgMLST locus names; for internal analysis). undef = same as EFSA.
    #   mapping_asset     : path under $chewbbaca_assets to the INNUENDO↔wgMLST mapping TSV.
    #                       Used to generate EFSA-compatible output files after chewBBACA runs.
    #   aliases           : additional names accepted on the command line
    my @SPECIES_ORDER = qw(campylobacter ecoli salmonella listeria);
    my %SPECIES_DEF = (
        campylobacter => {
            label           => "Campylobacter jejuni/coli (EFSA CAMPISO-PubMLST-8, cgMLST, no filter)",
            install_type    => "efsa_campy",
            schema_name     => "CAMPISO-PubMLST-8",
            filter_efsa     => undef,
            filter_chewiens => undef,
            mapping_asset   => undef,
            aliases         => [qw(campy campylobacter_jejuni campylobacter_coli)],
        },
        ecoli => {
            label           => "Escherichia coli (chewieNS wgMLST + cgMLST filter)",
            install_type    => "chewie_ns",
            schema_name     => "chewie_ns_ecoli",
            # Asset paths are relative to $chewbbaca_assets and use the schema name
            # as directory, matching what _install_schema_filters expects.
            # EFSA filter: exact INNUENDO-named loci as published by EFSA.
            # Required for uploading results to the EFSA One Health database.
            filter_efsa     => "filters/chewie_ns_ecoli/cgmlst_efsa.txt",
            # chewieNS filter: same loci in the new wgMLST naming used by chewieNS schemas.
            # Use this for internal analysis when EFSA upload compatibility is not required.
            filter_chewiens => "filters/chewie_ns_ecoli/cgmlst_chewiens.txt",
            aliases         => [qw(e.coli e_coli escherichia escherichia_coli)],
        },
        salmonella => {
            label           => "Salmonella enterica (chewieNS wgMLST + cgMLST filter)",
            install_type    => "chewie_ns",
            schema_name     => "chewie_ns_salmonella",
            # EFSA and chewieNS filters are equivalent (100% loci overlap after name mapping).
            # We provide both for clarity; efsa uses INNUENDO names, chewiens uses wgMLST names.
            filter_efsa     => "filters/chewie_ns_salmonella/cgmlst_efsa.txt",
            filter_chewiens => "filters/chewie_ns_salmonella/cgmlst_chewiens.txt",
            aliases         => [qw(salmonella_enterica)],
        },
        listeria => {
            label           => "Listeria monocytogenes (chewieNS wgMLST, no cgMLST filter)",
            install_type    => "chewie_ns",
            schema_name     => "chewie_ns_listeria",
            filter_efsa     => undef,
            filter_chewiens => undef,
            # No filter for Listeria (schema is already cgMLST-sized).
            # The INNUENDO↔wgMLST mapping for EFSA output translation is a bundled
            # pipeline asset (assets/chewbbaca/mappings/chewie_ns_listeria/id_mapping.tsv)
            # read at runtime — it does not need to be copied to the database.
            aliases         => [qw(listeria_monocytogenes)],
        },
    );

    # ── Parse species selection ───────────────────────────────────────────────
    my @selected;
    if ($arg eq "" || $arg eq "1" || lc($arg) eq "all") {
        @selected = @SPECIES_ORDER;
    } else {
        # Build alias map
        my %alias_map;
        for my $key (@SPECIES_ORDER) {
            $alias_map{$key} = $key;
            $alias_map{$_}   = $key for @{ $SPECIES_DEF{$key}{aliases} // [] };
        }
        my %seen;
        for my $tok (split /[,\s]+/, lc($arg)) {
            $tok =~ s/^\s+|\s+$//g;
            next if $tok eq "";
            my $resolved = $alias_map{$tok};
            unless (defined $resolved) {
                log_message("WARNING: Unknown species '$tok' — skipping.", "yellow");
                log_message("NOTICE:  Valid choices: " . join(", ", @SPECIES_ORDER));
                next;
            }
            push @selected, $resolved unless $seen{$resolved}++;
        }
        unless (@selected) {
            log_message("ERROR: No valid species specified.", "red");
            log_message("NOTICE: Usage: --install-efsa-schemas[=campylobacter,ecoli,salmonella,listeria]");
            return;
        }
    }

    # ── Announce ──────────────────────────────────────────────────────────────
    log_message("NOTICE:");
    log_message("NOTICE: ── Download & install EFSA One Health schemas ────────────");
    log_message("NOTICE:   Source    : $EFSA_REPO_URL");
    log_message("NOTICE:   Species   : " . join(", ", @selected));
    log_message("NOTICE:   After this command your pipeline is ready to run.");
    log_message("NOTICE:");

    # ── Prerequisites ─────────────────────────────────────────────────────────
    my $git_version = `git --version 2>&1`;
    unless ($git_version =~ /git version/) {
        log_message("ERROR: 'git' is not available. Install git and try again.", "red");
        return;
    }

    my $db = peekdir("db");
    if (!$db || $db eq "") {
        log_message("ERROR: No database directory configured. Set general.db in eurlc-wgs.config.", "red");
        return;
    }

    my $schemas_root = "$db/chewbbaca/schemas";
    ensure_dir($schemas_root);

    # ── Ensure builtin catalog is present, then load all catalogs ────────────
    _efsa_ensure_builtin_catalog($db);
    my %catalog = load_schema_catalogs();

    # ── Decide if we need the EFSA repo clone ─────────────────────────────────
    # Clone is needed only for Campylobacter (schema lives in EFSA repo).
    # Filters and mappings for E. coli / Salmonella / Listeria are now bundled
    # as pipeline assets and do NOT require cloning the EFSA repo.
    my $need_clone = grep { $SPECIES_DEF{$_}{install_type} eq "efsa_campy" } @selected;

    my $clone_target;
    if ($need_clone) {
        require File::Temp;
        my $tmpdir = File::Temp::tempdir(CLEANUP => 1);
        $clone_target = "$tmpdir/$EFSA_REPO_NAME";

        log_message("NOTICE: Cloning EFSA repository (shallow clone, this may take a minute)...");
        # Use list form — no shell involved, no path escaping issues.
        # Git prints progress to stderr which goes to the terminal (desirable).
        my $clone_rc = system("git", "clone", "--depth", "1", "--no-tags",
                              $EFSA_REPO_URL, $clone_target);
        if ($clone_rc != 0 || !-d $clone_target) {
            log_message("ERROR: git clone failed (exit " . ($clone_rc >> 8) . ").", "red");
            log_message("NOTICE: Test manually: git clone --depth 1 \"$EFSA_REPO_URL\" /tmp/efsa-test");
            return;
        }
        log_message("NOTICE: ✓  Clone complete.", "green");
    }

    # ── Process each selected species ─────────────────────────────────────────
    my %results;   # species_key => 'ok'|'skipped'|'error'  + details

    for my $key (@selected) {
        my $def  = $SPECIES_DEF{$key};
        my $type = $def->{install_type};
        my $sn   = $def->{schema_name};
        my $schema_dir = "$schemas_root/$sn";

        log_message("NOTICE:");
        log_message("NOTICE: ════ $def->{label} ════");

        # ── Campylobacter: copy schema from EFSA repo ─────────────────────────
        if ($type eq "efsa_campy") {
            my $camp_src = "$clone_target/data/Campylobacter_schema/CAMPISO-PubMLST-8";
            unless (-d $camp_src) {
                log_message("ERROR: Campylobacter schema not found in repo at $camp_src", "red");
                $results{$key} = "error";
                next;
            }

            if (-d $schema_dir) {
                my $go = $ASSUME_YES || prompt_yes_no(
                    "  Schema [$sn] already exists. Replace?", 0);
                if ($go) {
                    system("rm", "-rf", $schema_dir);
                } else {
                    log_message("NOTICE: Keeping existing [$sn].");
                    $results{$key} = "skipped";
                    next;
                }
            }

            if (_install_efsa_campylobacter($camp_src, $schema_dir, $sn)) {
                $results{$key} = "ok";
            } else {
                $results{$key} = "error";
            }
            next;
        }

        # ── chewieNS species: install from PubMLST/chewieNS if not present ──────
        if ($type eq "chewie_ns") {
            my $schema_ok = 0;

            if (-d $schema_dir && scalar(glob("$schema_dir/*.fasta")) > 0) {
                log_message("NOTICE: Schema [$sn] already installed.");
                $schema_ok = 1;
            } else {
                # Try catalog first, then fall back to live chewieNS API lookup.
                my $cat_entry = $catalog{$sn};
                unless ($cat_entry) {
                    ($cat_entry) = map { $catalog{$_} }
                                   grep { index($_, $sn) >= 0 || index($sn, $_) >= 0 }
                                   sort keys %catalog;
                }
                if ($cat_entry) {
                    log_message("NOTICE: Installing schema [$sn] from chewieNS...");
                    $schema_ok = _install_one_schema($cat_entry);
                } else {
                    log_message("WARNING: Schema [$sn] not found in catalog.", "yellow");
                    log_message("NOTICE:  This should not happen with the bundled catalog — please report this as a bug.");
                    $results{$key} = "no_catalog";
                    next;
                }
            }

            unless ($schema_ok) {
                $results{$key} = "error";
                next;
            }

            # ── Install bundled filters and mappings ───────────────────────────
            # Filters and mappings are bundled as pipeline assets (no network required).
            # They are copied into the schema directory:
            #   $schema_dir/filters/cgmlst_efsa.txt       — EFSA-compatible (INNUENDO names)
            #   $schema_dir/filters/cgmlst_chewiens.txt   — chewieNS-native (wgMLST names)
            #   $schema_dir/mappings/id_mapping.tsv        — INNUENDO ↔ wgMLST mapping
            # Existing files are never overwritten (custom filters survive reinstalls).

            my $any_asset_installed = 0;
            my $any_asset_failed    = 0;

            # Helper: copy one asset file to destination, skip if dest already exists.
            my $copy_asset = sub {
                my ($asset_rel, $dest_path) = @_;
                return 1 unless defined $asset_rel;   # no asset defined for this species

                my $src = "$chewbbaca_assets/$asset_rel";
                unless (-f $src) {
                    log_message("WARNING: Bundled asset not found: $src", "yellow");
                    log_message("NOTICE:  Run 'git pull' to update the pipeline, then re-run --install-efsa-schemas.");
                    return 0;
                }

                if (-f $dest_path) {
                    log_message("NOTICE:  Asset already present (not overwriting): $dest_path");
                    return 1;
                }

                ensure_dir(File::Basename::dirname($dest_path));
                if (system("cp", $src, $dest_path) == 0) {
                    log_message("NOTICE: ✓  Installed: $dest_path", "green");
                    return 1;
                } else {
                    log_message("WARNING: Could not copy asset to $dest_path: $!", "yellow");
                    return 0;
                }
            };

            # Copy EFSA filter (INNUENDO names — required for EFSA upload)
            if (defined $def->{filter_efsa}) {
                my $ok = $copy_asset->($def->{filter_efsa}, "$schema_dir/filters/cgmlst_efsa.txt");
                $ok ? $any_asset_installed++ : $any_asset_failed++;
            }

            # Copy chewieNS filter (wgMLST names — for internal analysis)
            if (defined $def->{filter_chewiens}) {
                my $ok = $copy_asset->($def->{filter_chewiens}, "$schema_dir/filters/cgmlst_chewiens.txt");
                $ok ? $any_asset_installed++ : $any_asset_failed++;
            }

            # NOTE: INNUENDO↔wgMLST mapping TSVs are static pipeline assets read at
            # runtime from assets/chewbbaca/mappings/<schema_name>/id_mapping.tsv.
            # They are NOT copied to the database — no installation step needed here.

            if ($any_asset_failed) {
                $results{$key} = "partial";
                next;
            }

            # Wire the EFSA filter (or chewieNS filter if no EFSA filter) into schema.ini.
            # We use the relative path so the schema stays relocatable.
            my $active_filter_rel;
            if (defined $def->{filter_efsa}) {
                $active_filter_rel = "filters/cgmlst_efsa.txt";
            } elsif (defined $def->{filter_chewiens}) {
                $active_filter_rel = "filters/cgmlst_chewiens.txt";
            }

            if (defined $active_filter_rel) {
                my $wired = _efsa_wire_filter_to_schema(
                    filter_path  => $active_filter_rel,   # relative path → stored as-is in schema.ini
                    schema_hints => [$sn],
                    schemas_root => $schemas_root,
                );
                if ($wired) {
                    log_message("NOTICE: ✓  Filter wired to schema [$wired] (filter = $active_filter_rel).", "green");
                    $results{$key} = "ok";
                } else {
                    log_message("WARNING: Could not update schema.ini for [$sn].", "yellow");
                    log_message("NOTICE:  Manually set:  filter = $active_filter_rel  in $schema_dir/schema.ini");
                    $results{$key} = "partial";
                }
            } else {
                # No filter for this species (Listeria): schema used as-is; mapping still installed.
                log_message("NOTICE: ✓  [$sn] ready (no cgMLST filter; mapping installed for EFSA translation).", "green");
                $results{$key} = "ok";
            }
            next;
        }

        log_message("WARNING: Unknown install_type '$type' for $key — skipping.", "yellow");
        $results{$key} = "error";
    }

    # ── Final summary ─────────────────────────────────────────────────────────
    log_message("NOTICE:");
    log_message("NOTICE: ════════════════════════════════════════════════════════");
    log_message("NOTICE: Summary");
    log_message("NOTICE: ════════════════════════════════════════════════════════");

    my $all_ok = 1;
    for my $key (@selected) {
        my $res   = $results{$key} // "error";
        my $label = $SPECIES_DEF{$key}{label};
        my $sn    = $SPECIES_DEF{$key}{schema_name};
        if ($res eq "ok") {
            log_message("NOTICE:   [OK]      $label", "green");
        } elsif ($res eq "skipped") {
            log_message("NOTICE:   [kept]    $label (existing, not replaced)");
        } elsif ($res eq "partial") {
            log_message("NOTICE:   [partial] $label — schema installed, set filter manually", "yellow");
            $all_ok = 0;
        } elsif ($res eq "no_catalog") {
            log_message("NOTICE:   [waiting] $label — catalog entry needed; install schema then re-run", "yellow");
            $all_ok = 0;
        } else {
            log_message("NOTICE:   [ERROR]   $label", "red");
            $all_ok = 0;
        }
    }

    log_message("NOTICE:");
    if ($all_ok) {
        log_message("NOTICE: ✓  All done. Run analyses normally — schemas and filters are wired.", "green");
    } else {
        log_message("NOTICE: Some steps need attention (see above).", "yellow");
        log_message("NOTICE: Re-run --install-efsa-schemas after resolving to complete setup.");
    }
    log_message("NOTICE: Run --list-schemas to verify installed schemas.");
    log_message("NOTICE: ════════════════════════════════════════════════════════");
    log_message("NOTICE:");
}

# ---------------------------------------------------------------------------
# _install_efsa_campylobacter($src, $target, $schema_name)
#
# Copies the already-prepped EFSA Campylobacter schema to the target dir and
# writes schema.ini.  No filter is applied (the schema IS the cgMLST set).
# The training file (Campylobacter_jejuni_coli.trn) is included in the schema.
# ---------------------------------------------------------------------------
sub _install_efsa_campylobacter {
    my ($src, $target, $schema_name) = @_;

    log_message("NOTICE: Installing Campylobacter schema [$schema_name]...");

    system("cp", "-r", $src, $target) == 0
        or do { log_message("ERROR: Failed to copy schema: $!", "red"); return 0; };

    my @_loci_files = glob("$target/*.fasta");
    my $loci_count  = scalar(@_loci_files);

    # schema.ini: filter=unfiltered because CAMPISO-PubMLST-8 *is* cgMLST (1142 loci).
    # The training file is already in $target/ — ensure_schema_prepared will find it.
    my $ini_entry = {
        name        => $schema_name,
        label       => "Campylobacter cgMLST — EFSA CAMPISO (PubMLST-8)",
        description => "EFSA One Health validated Campylobacter cgMLST schema. "
                     . "Based on PubMLST wgMLST v8, reduced to $loci_count cgMLST loci. "
                     . "Training file (Campylobacter_jejuni_coli.trn) included. No filter required.",
        version     => "8",
        source      => "efsa",
        species     => ["Campylobacter jejuni", "Campylobacter coli"],
        source_meta => {
            url         => "https://dev.azure.com/efsa-devops/EFSA/_git/efsa.wgs.onehealth",
            repo        => "efsa.wgs.onehealth",
            schema_path => "data/Campylobacter_schema/CAMPISO-PubMLST-8",
            downloaded  => strftime("%Y-%m-%d", localtime),
        },
    };
    _write_schema_ini($target, $ini_entry, undef);   # undef = unfiltered

    # Short/ already present → ensure_schema_prepared is a no-op
    ensure_schema_prepared($target, $schema_name);

    log_message("NOTICE: ✓  Campylobacter schema installed: $loci_count loci, no filter (cgMLST).", "green");
    return 1;
}

# ---------------------------------------------------------------------------
# _efsa_ensure_builtin_catalog($db)
#
# Writes the bundled builtin.json catalog to $db/chewbbaca/catalog/builtin.json
# if it is missing or older than this script.  The catalog content is embedded
# as a heredoc so the pipeline is self-contained — no network access required.
