            env       => "eurlc-wgs-fastqc",
            yml       => "core/eurlc-wgs-fastqc.yml",
            package_name  => "fastqc",
            # FastQC sometimes hangs, and normally takes a few minutes: a
            # short limit for both FastQC steps (fastqc_rawdata and
            # fastqc_trimmed_data; either can have its own timeout).
            timeout   => "10m",
    },
    fastqc_rawdata => {
            # FastQC on raw (untrimmed) reads. Optional -- disabled by default
            # because FastQC is slow and can hang on some inputs.
            # Enable if you want raw-data QC reports for inspection.
            enabled => 0,
    },
    fastqc_trimmed_data => {
            # FastQC on trimmed + downsampled reads.
            enabled => 0,
    },
    jellyfish => {
            version_check => "loose",
            enabled   => 1,
            required => 1,
            arguments => "",
            env       => "eurlc-wgs-jellyfish",
            yml       => "core/eurlc-wgs-jellyfish.yml",
            package_name     => "kmer-jellyfish",    # bioconda package (YML pins it)
            package_name_alt => "jellyfish",         # older bioconda name
    },
    interop => {
            version_check => "loose",
            enabled   => 1,
            required => 0,
        arguments    => "",
