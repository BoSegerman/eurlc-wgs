sub test_fastqc_rawdata {
   
   return check_conda_tool("fastqc");
 
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_fastqc_rawdata;

sub preprocess_fastqc_rawdata {

    my ($samplenr) = @_;

    my $runstep_name = "fastqc_rawdata";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     

    if ($sample_type eq "FASTA") {
        return "";
    }
 
     ###################################
    ### check essential requirements

    # check enabled 
    if (is_disabled($R_cfg->{fastqc}{enabled})) {
        return "";
    }
    if(is_disabled($R_cfg->{fastqc}{run_on_rawdata})){
        return "";
    }
    
    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__R1__", "__R2__");
    }

    elsif ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name,  "optional", "__SE__");
    }


    

    
    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};     
    my $resultfile_template = $runstep{$runstep_name}{resultfile};
    
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");
    
    if($sample_type eq "PE"){
      my $resultfile_R1 = $resultfile_template;
      $resultfile_R1 =~ s/__FASTQCEXTENSION__/R1_fastqc.zip/g;
      my $resultfile_R2 = $resultfile_template;
      $resultfile_R2 =~ s/__FASTQCEXTENSION__/R2_fastqc.zip/g;

      $resultfile_R1 = fill_placeholders($resultfile_R1,$samplenr,$runstep_name);
      $resultfile_R2 = fill_placeholders($resultfile_R2,$samplenr,$runstep_name);
          
      if(-s $resultfile_R1 && -s $resultfile_R2 ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastqc_rawdata($samplenr);
        return "";
      }
    }
    if($sample_type eq "SE"){
      my $resultfile_SE = $resultfile_template;
      $resultfile_SE =~ s/__FASTQCEXTENSION__/fastqc.zip/g;
      $resultfile_SE = fill_placeholders($resultfile_SE,$samplenr,$runstep_name);
      
      if(-s $resultfile_SE  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastqc_rawdata($samplenr);
        return "";
      }
    }


    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name); 

    
    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastqc_rawdata;

sub postprocess_fastqc_rawdata {
    my ($samplenr) = @_;

    my $runstep_name = "fastqc_rawdata";
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type}; 
      
    my $resultfile_template = $runstep{$runstep_name}{resultfile};
    

    
    if ($sample_type eq "PE") {

        my $resultfile_R1 = standardize_fastqc_resultfiles($samplenr, $runstep_name, "__R1__", "R1_fastqc");
        my $resultfile_R2 = standardize_fastqc_resultfiles($samplenr, $runstep_name, "__R2__", "R2_fastqc");
        return 0 unless defined $resultfile_R1 && defined $resultfile_R2;

        my $result_ref_R1 = parse_fastqc_results2("$resultfile_R1.zip");
        return 0 unless defined $result_ref_R1;
        $R_samples->[$samplenr]{results}{$runstep_name}{R1} = $result_ref_R1;

        my $result_ref_R2 = parse_fastqc_results2("$resultfile_R2.zip");
        return 0 unless defined $result_ref_R2;
        $R_samples->[$samplenr]{results}{$runstep_name}{R2} = $result_ref_R2;

        log_message("NOTICE:=========== Results R1 ===================","green");
        print_fastqc_results($result_ref_R1,"rawdata");

        log_message("NOTICE:=========== Results R2 ===================","green");
        print_fastqc_results($result_ref_R2,"rawdata");
    }
    
    
    elsif ($sample_type eq "SE") {

        my $resultfile_SE = standardize_fastqc_resultfiles($samplenr, $runstep_name, "__SE__", "fastqc");
        return 0 unless defined $resultfile_SE;
        
        my $result_ref_SE = parse_fastqc_results2("$resultfile_SE.zip");
        return 0 unless defined $result_ref_SE;
        $R_samples->[$samplenr]{results}{$runstep_name}{SE} = $result_ref_SE;

        log_message("NOTICE:=========== Results ===================","green");
        print_fastqc_results($result_ref_SE,"rawdata");
    }

   
    return 1; # success
}



sub standardize_fastqc_resultfiles {
    my ($samplenr, $runstep_name, $input_placeholder, $wanted_suffix) = @_;

    my $sample_name = $R_samples->[$samplenr]{name};
    my $resultfile_template = $runstep{$runstep_name}{resultfile};

    # Build raw FastQC output basename
    my $raw_resultbase = "__OUTDIR__/" . get_fastqc_filename(
        File::Basename::basename(fill_placeholders($input_placeholder, $samplenr))
    );

    # Build desired standardized basename
    my $wanted_resultbase = $resultfile_template;
    $wanted_resultbase =~ s/__FASTQCEXTENSION__/$wanted_suffix/g;

    $raw_resultbase    = fill_placeholders($raw_resultbase,    $samplenr, $runstep_name);
    $wanted_resultbase = fill_placeholders($wanted_resultbase, $samplenr, $runstep_name);

    my $raw_zip     = "$raw_resultbase.zip";
    my $raw_html    = "$raw_resultbase.html";
    my $wanted_zip  = "$wanted_resultbase.zip";
    my $wanted_html = "$wanted_resultbase.html";

    # Rename if needed
    if ($raw_resultbase ne $wanted_resultbase) {

        if (-e $raw_zip && !-e $wanted_zip) {
            unless (rename($raw_zip, $wanted_zip)) {
                log_message("WARNING: Sample $sample_name: Could not rename [$raw_zip] -> [$wanted_zip]: $!", "yellow");
            }
        }

        if (-e $raw_html && !-e $wanted_html) {
            unless (rename($raw_html, $wanted_html)) {
                log_message("WARNING: Sample $sample_name: Could not rename [$raw_html] -> [$wanted_html]: $!", "yellow");
            }
        }
    }

    # Final existence check (must have zip at least)
    unless (-s $wanted_zip) {
        log_message("WARNING: Sample $sample_name: FastQC result zip missing or empty: $wanted_zip", "yellow");
        return undef;
    }

    # HTML is nice but optional → warn only
    if (!-s $wanted_html) {
        log_message("WARNING: Sample $sample_name: FastQC html missing or empty: $wanted_html", "yellow");
    }

    return $wanted_resultbase;
}

