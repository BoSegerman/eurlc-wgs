    # version of the pipeline is newer (catalog_version), so that a fixed
    # entry reaches existing installations (B16). Own schemas belong in a
    # separate *.json file in the same folder; an older builtin.json is kept
    # as builtin.json.v<N> in case it had been edited.
    my ($new_v) = $builtin_json =~ /"catalog_version"\s*:\s*"?(\d+)/;
    $new_v //= 0;
    if (-f $cat_file) {
        my $old_v = 0;
        if (open(my $ifh, "<", $cat_file)) {
            local $/;
            my $old = <$ifh>;
            close $ifh;
            ($old_v) = $old =~ /"catalog_version"\s*:\s*"?(\d+)/;
            $old_v //= 0;
        }
        return if $old_v >= $new_v;
        my $backup = "$cat_file.v$old_v";
        rename($cat_file, $backup)
            or do { log_message("WARNING: Could not move old builtin catalog aside ($backup): $!", "yellow"); return; };
        log_message("NOTICE: Builtin schema catalog updated from version $old_v to $new_v (old file kept as $backup)");
    }
    open(my $fh, ">", "$cat_file.tmp$$")
        or do { log_message("WARNING: Could not write builtin catalog: $!", "yellow"); return; };
    print $fh $builtin_json;
    close $fh;
    rename("$cat_file.tmp$$", $cat_file);
    log_message("NOTICE: Installed builtin schema catalog → $cat_file");
}

# ---------------------------------------------------------------------------
# _efsa_wire_filter_to_schema(filter_path => ..., schema_hints => [...], schemas_root => ...)
#
# Looks for an installed chewieNS schema that matches one of the hint names.
# If found, updates its schema.ini with the given filter value.
# filter_path may be a relative path (e.g. "filters/cgmlst_efsa.txt") — it is
# written as-is so the schema stays relocatable.  discover_installed_schemas()
# resolves relative paths against the schema directory at runtime.
# Returns the schema name if wired, undef otherwise.
# ---------------------------------------------------------------------------
sub _efsa_wire_filter_to_schema {
    my (%args) = @_;
    my $filter_path  = $args{filter_path}  // return undef;
    my $schema_hints = $args{schema_hints} // [];
    my $schemas_root = $args{schemas_root} // return undef;

    return undef unless -d $schemas_root;

    for my $hint (@$schema_hints) {
        my $schema_dir = "$schemas_root/$hint";
        next unless -d $schema_dir;

        my $ini_path = "$schema_dir/schema.ini";
        unless (-f $ini_path) {
            log_message("INFO: Found schema dir [$hint] but no schema.ini — skipping filter wire");
            next;
        }

        # Read existing schema.ini, update filter line
        open(my $fh_in, '<:utf8', $ini_path)
            or do { log_message("WARNING: Cannot read $ini_path: $!"); next; };
        my @lines = <$fh_in>;
        close $fh_in;

        my $found_filter = 0;
        for my $line (@lines) {
            if ($line =~ s{^(\s*filter\s*=\s*).*}{$1$filter_path}) {
                $found_filter = 1;
            }
        }
        unless ($found_filter) {
            # No existing filter line in [schema] section — append after [schema] header
            my @new_lines;
            my $in_schema = 0;
            my $added = 0;
            for my $line (@lines) {
                push @new_lines, $line;
                if (!$added && $line =~ /^\[schema\]/) {
                    $in_schema = 1;
                }
                if ($in_schema && !$added && $line =~ /^(name|label|description|version|species|source)\s*=/) {
                    # keep going, add after last header-like field we see
                }
                if ($in_schema && !$added && ($line =~ /^\[/ && $line !~ /^\[schema\]/ || eof)) {
                    # next section or end of file: inject before this line
                    pop @new_lines;
                    push @new_lines, "filter      = $filter_path\n";
                    push @new_lines, $line;
                    $added = 1;
                }
            }
            push @new_lines, "filter      = $filter_path\n" unless $added;
            @lines = @new_lines;
        }

        open(my $fh_out, '>:utf8', $ini_path)
            or do { log_message("WARNING: Cannot update $ini_path: $!"); next; };
        print $fh_out @lines;
        close $fh_out;

        return $hint;   # success
    }

    return undef;   # no matching schema found
}

sub md5_file {
    my ($path) = @_;
    return "ERROR:not_a_file"  unless defined $path && -f $path;
    return "ERROR:empty_file"  unless -s $path;
    open my $fh, '<:raw', $path or return "ERROR:cannot_open";
    return Digest::MD5->new->addfile($fh)->hexdigest;
}

sub ensure_dir {
    my ($path) = @_;


    if (-d $path) {
        return $path;   # success
    }
    
    my $root_dir = _get_path_entry('DIR', "out");
    my $db_root_dir = _get_path_entry('DIR', "db");


    unless (defined $path) {
        log_message("WARNING: Cannot resolve path in ensure_dir","red");
        return "";
    }
    if ( $path eq "") {
       log_message("WARNING: Empty path [$path] in ensure_dir","red");
    }
    
    # Security check — ensure abs_path starts with abs_root
    unless (index($path, $root_dir) == 0 || index($path, $db_root_dir) == 0) {
        log_message("WARNING: Attempt to create directory outside output root or db-root [$path]  — denied","red");
        return "";
    }

    # Create directory if missing
    unless (-d $path) {
        execute_and_log("mkdir -p '$path'");
    }

    if (! (-d $path) ) {
        log_message("WARNING: Could not create directory [$path]","red");
        return "";     
    }
    return $path;   # success
}
##########################################################################################################

sub check_crc32_hash_collisions {
    my (%args) = @_;

    my $crc32_file  = $args{crc32_file};
    my $sha256_file = $args{sha256_file};
    my $out_file    = $args{out_file};   # optional

    my $summary = {
        checked         => 0,
        ok              => 0,
        collision_count => 0,
        collisions      => [],
        rows_checked    => 0,
        report_file     => "",
        error           => "",
    };

    if (!defined $crc32_file || !-e $crc32_file) {
        $summary->{error} = "CRC32 allele table missing: " . ($crc32_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    if (!defined $sha256_file || !-e $sha256_file) {
        $summary->{error} = "SHA256 allele table missing: " . ($sha256_file // "undef");
        log_message("WARNING: $summary->{error}");
        return $summary;
    }

    open my $crc_fh, '<', $crc32_file or do {
        $summary->{error} = "Could not open CRC32 allele table [$crc32_file]: $!";
        log_message("WARNING: $summary->{error}");
        return $summary;
    };

    open my $sha_fh, '<', $sha256_file or do {
        $summary->{error} = "Could not open SHA256 allele table [$sha256_file]: $!";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        return $summary;
    };

    my $crc_header = <$crc_fh>;
    my $sha_header = <$sha_fh>;

    if (!defined $crc_header || !defined $sha_header) {
        $summary->{error} = "Empty CRC32 or SHA256 allele table";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    chomp $crc_header;
    chomp $sha_header;

    my @crc_cols = split /\t/, $crc_header, -1;
    my @sha_cols = split /\t/, $sha_header, -1;

    if (@crc_cols != @sha_cols) {
        $summary->{error} = "CRC32/SHA256 allele tables have different number of columns";
        log_message("WARNING: $summary->{error}");
        close $crc_fh;
        close $sha_fh;
        return $summary;
    }

    for my $i (0 .. $#crc_cols) {
        if ($crc_cols[$i] ne $sha_cols[$i]) {
            $summary->{error} =
                "CRC32/SHA256 headers differ at column $i [$crc_cols[$i]] vs [$sha_cols[$i]]";
            log_message("WARNING: $summary->{error}");
            close $crc_fh;
            close $sha_fh;
            return $summary;
        }
    }

    my %seen;
    my @collisions;
    my $rows = 0;

    while (1) {
        my $crc_line = <$crc_fh>;
        my $sha_line = <$sha_fh>;

        last if !defined $crc_line && !defined $sha_line;

        if (!defined $crc_line || !defined $sha_line) {
            $summary->{error} = "CRC32/SHA256 allele tables have different number of rows";
            log_message("WARNING: $summary->{error}");
            last;
        }

        chomp $crc_line;
        chomp $sha_line;

        next if $crc_line =~ /^\s*$/ && $sha_line =~ /^\s*$/;

        my @crc = split /\t/, $crc_line, -1;
        my @sha = split /\t/, $sha_line, -1;

        my $sample_crc = $crc[0] // "";
        my $sample_sha = $sha[0] // "";

        if ($sample_crc ne $sample_sha) {
            log_message("WARNING: CRC32/SHA256 sample mismatch [$sample_crc] vs [$sample_sha]");
            next;
        }

        $rows++;

        for my $i (1 .. $#crc_cols) {
            my $locus = $crc_cols[$i];

            my $crc_val = $crc[$i] // "";
            my $sha_val = $sha[$i] // "";

            next if $crc_val eq "" || $crc_val eq "-";
            next if $sha_val eq "" || $sha_val eq "-";

            $seen{$locus}{$crc_val}{$sha_val}{$sample_crc} = 1;
        }
    }

    close $crc_fh;
    close $sha_fh;

    foreach my $locus (sort keys %seen) {
        foreach my $crc_val (sort keys %{ $seen{$locus} }) {

            my @sha_values = sort keys %{ $seen{$locus}{$crc_val} };

            next if @sha_values <= 1;

            my @samples;
            foreach my $sha (@sha_values) {
                push @samples, sort keys %{ $seen{$locus}{$crc_val}{$sha} };
            }

            push @collisions, {
                locus   => $locus,
                crc32   => $crc_val,
                sha256s => \@sha_values,
                samples => \@samples,
            };
        }
    }

    $summary->{checked}         = 1;
    $summary->{ok}              = @collisions ? 0 : 1;
    $summary->{collision_count} = scalar(@collisions);
    $summary->{collisions}      = \@collisions;
    $summary->{rows_checked}    = $rows;

    if (defined $out_file && $out_file ne "") {

        open my $out, '>', $out_file or do {
            $summary->{error} = "Could not write CRC32 collision report [$out_file]: $!";
            log_message("WARNING: $summary->{error}");
            return $summary;
        };

        print $out "# CRC32 collision check\n";
        print $out "# CRC32 file: $crc32_file\n";
        print $out "# SHA256 file: $sha256_file\n";
        print $out "# Rows checked: $rows\n";
        print $out "# Collision count: " . scalar(@collisions) . "\n";

        if (@collisions) {
            print $out "# Result: possible CRC32 collisions detected\n";
        }
        else {
            print $out "# Result: no CRC32 collisions detected\n";
        }

        print $out join("\t", qw(locus crc32 sha256_count sha256_values samples)) . "\n";

        foreach my $c (@collisions) {
            print $out join(
                "\t",
                $c->{locus},
                $c->{crc32},
                scalar(@{ $c->{sha256s} || [] }),
                join(",", @{ $c->{sha256s} || [] }),
                join(",", @{ $c->{samples} || [] }),
            ) . "\n";
        }

        close $out;

        $summary->{report_file} = path_relative_to_outdir($out_file);
    }

    if (@collisions) {
        log_message("WARNING: Possible CRC32 hash collisions detected: " . scalar(@collisions));
    }
    else {
        log_message("INFO: No CRC32 hash collisions detected in [$rows] samples", "green");
    }

    return $summary;
}

######################################################################################

sub ensure_dir_not_exists {
    my (%opt) = @_;

    my $dir   = $opt{dir}   or graceful_die("ensure_dir_not_exists: missing dir");
    my $mode  = $opt{mode}  // 'remove';   # remove | rename | fail
    my $quiet = $opt{quiet} // 0;

    return 1 unless -e $dir;   # nothing to do

    graceful_die("ensure_dir_not_exists: [$dir] exists but is not a directory")
        if -e $dir && !-d $dir;

    if ($mode eq 'fail') {
        graceful_die("Output directory [$dir] already exists");
    }

    if ($mode eq 'remove') {
        remove_tree($dir, { error => \my $err });
        if (@$err) {
            graceful_die("Failed removing directory [$dir]: " .
                join(", ", map { %$_ } @$err));
        }
        log_message("INFO: Removed existing directory [$dir]\n") unless $quiet;
        return 1;
    }

    if ($mode eq 'rename') {
      
        my $new = "$dir.old." . time();
        rename($dir, $new)
            or graceful_die("Failed renaming [$dir] -> [$new]: $!");
        log_message("Renamed existing directory [$dir] -> [$new]\n") unless $quiet;
        return 1;
    }

    log_message( "WARNING: ensure_dir_not_exists: unknown mode [$mode]\n");
}

###################################################################################################
###################################################################################################
##
## SCHEDULER SECTION
##
## The runstep machinery -- data-key registry (%data_key), graph validation,
## the two schedulers (per-sample and batch-level), the control channel
## (pause/resume/terminate via the out/control/ spool directory), signal
## handling, and run_step itself. See the runstep machinery design doc for
## the full design rationale.
##
## Sub-categories:
##   - Startup graph validation
##       validate_runstep_graph, validate_requires_have_data_keys,
##       detect_runstep_dependency_cycles, validate_exactly_one_applicable_producer
##   - Per-sample scheduler
##       test_data_driven_runsteps, run_data_driven_runsteps
##   - Batch scheduler (cross-sample runsteps: sort_assemblies, checkm, chewbbaca, multiqc)
##       test_data_driven_batch_runsteps, run_data_driven_batch_runsteps,
##       any_sample_satisfies, all_samples_satisfy
##   - Control channel
##       process_control_commands, check_control_channel
##   - Dispatch
##       run_step, should_run
##
###################################################################################################
###################################################################################################

###################################################################################################
## Species-restricted runsteps -- the optional "species" contract field.
##
##   species => [ 'Salmonella' ],                     # genus
##   species => [ 'Escherichia coli', 'Shigella' ],   # species and/or genus
##
## Meaning: the runstep only runs for samples whose detected taxonomy
## matches one of the entries. applies_if stays a pure CONFIG question
## ("is the tool enabled?"); the species question is answered at runtime,
## once species is known. Concretely:
##
##   - normalize_species_runsteps() (startup) adds 'species_determined' to
##     the step's requires, so both schedulers wait for species
##     determination and the graph validation/cycle checks see the edge.
##   - runstep_species_applies() is checked next to applies_if in both
##     schedulers. Before species is known it answers "yes" (the implicit
##     requires holds the step back); after, it answers whether the
##     detected species matches.
##   - The test phase ignores the field entirely: a tool enabled in the
##     config is tested whatever the samples turn out to contain.
##   - report_species_tools_not_run() (end of run) lists detected species
##     whose species-specific tools are disabled in the config.
##
## Matching (case-insensitive, '_' treated as space):
##   'Salmonella'         matches species "Salmonella enterica" (genus prefix)
##                        or taxonomy genus "Salmonella"
##   'Escherichia coli'   matches species "Escherichia coli" exactly
##                        (and longer names starting with it)

# Startup: validate the field and add the implicit requires. Called once,
# before validate_runstep_graph(), so the graph checks see the result.
sub normalize_species_runsteps {
    my @problems;
    for my $name ( sort keys %runstep ) {
        my $def = $runstep{$name};
        next unless exists $def->{species};

        my $sp = $def->{species};
        if ( ref $sp ne 'ARRAY' || !@$sp || grep { !defined $_ || $_ !~ /\S/ } @$sp ) {
            push @problems, "Runstep [$name]: 'species' must be a non-empty list of species/genus names, e.g. species => [ 'Salmonella' ]";
            next;
        }

        $def->{requires} //= [];
        unless ( grep { $_ eq 'species_determined' } @{ $def->{requires} } ) {
            push @{ $def->{requires} }, 'species_determined';
            $def->{_implicit_requires}{species_determined} = 1;
        }
    }
    if (@problems) {
        log_message("ERROR:   - $_", "red") for @problems;
        graceful_die("Invalid 'species' field in runstep definition(s) -- see above");
    }
}

# Does sample $i's detected taxonomy match any entry in $wanted (arrayref)?
sub sample_matches_species {
    my ($i, $wanted) = @_;
    my $tax     = $R_samples->[$i]{main_results}{taxonomy} // {};
    my $species = lc( $tax->{species} // '' );
    my $genus   = lc( $tax->{genus}   // '' );
    for ($species, $genus) { s/_/ /g; s/^\s+|\s+$//g; }

    for my $w (@$wanted) {
        (my $p = lc $w) =~ s/_/ /g;
        $p =~ s/^\s+|\s+$//g;
        next if $p eq '';
        return 1 if $species eq $p || index($species, "$p ") == 0;
        return 1 if $p !~ / / && $genus eq $p;     # genus-only entry
    }
    return 0;
}

# Runtime gate used by both schedulers, alongside applies_if.
#   no species field         -> 1
#   species not yet known    -> 1 if species can still be determined for
#                               this sample (the implicit requires makes the
#                               step wait); 0 if no producer of
#                               species_determined applies (e.g. kraken2
#                               disabled) -- it would otherwise wait forever
#   species known            -> does it match?
sub runstep_species_applies {
    my ($def, $i) = @_;
    my $wanted = $def->{species} or return 1;

    unless ( eval { $data_key{species_determined}{check}->($i) } ) {
        for my $p ( keys %runstep ) {
            my $d = $runstep{$p};
            next unless grep { $_ eq 'species_determined' } @{ $d->{produces} // [] };
            return 1 if eval { exists $d->{applies_if} ? $d->{applies_if}->($i) : 1 };
        }
        return 0;
    }
    return sample_matches_species($i, $wanted);
}

# End of run: tell the user when samples contained a species for which
# species-specific tools exist but are disabled in the config. Purely
# informational -- the run itself is not affected.
sub report_species_tools_not_run {
    my ($runstep_names) = @_;
    my %disabled;   # runstep -> [ sample names ]
    for my $name (@$runstep_names) {
        my $def = $runstep{$name};
        next unless $def && $def->{species};
        for my $i ( 0 .. $#$R_samples ) {
            next unless eval { $data_key{species_determined}{check}->($i) };
            next unless sample_matches_species($i, $def->{species});
            my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
            next if $applies;
            push @{ $disabled{$name} }, $R_samples->[$i]{name} // "sample $i";
        }
    }
    @S_TOOLS_NOT_RUN = ();
    for my $name ( sort keys %disabled ) {
        my @s = @{ $disabled{$name} };
        my $section = get_runstep_config_section($name) // $name;
        push @S_TOOLS_NOT_RUN, { runstep => $name, section => $section,
                                 species => [ @{ $runstep{$name}{species} } ], samples => \@s };
        # log file only -- shown on screen in the run summary
        log_message("INFO: " . scalar(@s) . " sample(s) matched [" . join(", ", @{ $runstep{$name}{species} })
                  . "] but runstep [$name] is disabled in the configuration ([$section] enabled=0), so it did not run: " . join(", ", @s));
    }
}

###################################################################################################
## Startup graph validation (§9.1) -- structural checks over the runstep
## dependency declarations, run once, after samples are known (needed for
## the per-sample applicable-producer check) but before any real testing
## or processing begins. Aborts the whole run on any problem found, rather
## than letting a misconfigured/newly-added runstep deadlock silently
## partway through a long run. All three checks are based on declared
## requires/produces/applies_if -- none of them call a data_key's actual
## check function, since at this point no sample has produced any real
## data yet (those checks would trivially all be false, telling us nothing
## about whether the GRAPH itself is sound).

# Check A: every key referenced in any runstep's "requires" has a real
# %data_key entry. A missing data_key entry means the runtime
# requires-check can NEVER be satisfied, for any sample, ever --
# a guaranteed-permanent deadlock, not a maybe.
sub validate_requires_have_data_keys {
    my @problems;
    for my $name ( keys %runstep ) {
        my $def = $runstep{$name};
        for my $key ( @{ $def->{requires} // [] } ) {
            next if exists $data_key{$key};
            push @problems, "Runstep [$name] requires data-key [$key], but no such key exists in the data-key registry";
        }
    }
    return @problems;
}

# Check B: no cycles in the dependency graph implied by requires/produces.
# Standard DFS with three-colour marking.
sub detect_runstep_dependency_cycles {
    my %produced_by;
    for my $name ( keys %runstep ) {
        for my $key ( @{ $runstep{$name}{produces} // [] } ) {
            push @{ $produced_by{$key} }, $name;
        }
    }

    my %color;
    my @problems;

    my $visit;
    $visit = sub {
        my ($name, $path) = @_;
        return if ( $color{$name} // 0 ) == 2;

        if ( ( $color{$name} // 0 ) == 1 ) {
            my @cycle = ( @$path, $name );
            push @problems, "Dependency cycle detected: " . join(" -> ", @cycle);
            return;
        }

        $color{$name} = 1;
        for my $key ( @{ $runstep{$name}{requires} // [] } ) {
            for my $producer ( @{ $produced_by{$key} // [] } ) {
                next if $producer eq $name;
                $visit->( $producer, [ @$path, $name ] );
            }
        }
        $color{$name} = 2;
    };

    for my $name ( sort keys %runstep ) { $visit->( $name, [] ); }

    return @problems;
}

# Check C: per sample, for every runstep that itself applies, every key it
# requires must have exactly one declared producer that also applies for
# that same sample.
sub validate_exactly_one_applicable_producer {
    my %produced_by;
    for my $name ( keys %runstep ) {
        next unless defined $name;
        for my $key ( @{ $runstep{$name}{produces} // [] } ) {
            next unless defined $key;
            push @{ $produced_by{$key} }, $name;
        }
    }

    my @problems;

    for my $i ( 0 .. $#$R_samples ) {
        my $sample_name = $R_samples->[$i]{name} // "sample $i";

        for my $name ( keys %runstep ) {
            next unless defined $name;
            my $def = $runstep{$name};
            next unless @{ $def->{requires} // [] };

            my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
            next unless $applies;

            for my $key ( @{ $def->{requires} } ) {
                my @producers = grep { defined $_ } @{ $produced_by{$key} // [] };

                # Skip check for keys where every producer belongs to the
                # same named group -- these are deliberately mutually
                # exclusive pairs (e.g. downsampling_bbmap /
                # check_for_no_downsampling, fastp_rawdata /
                # check_for_no_trimming, checkm / checkm_per_sample).
                # At startup we cannot know which branch applies_if will
                # choose at runtime (it depends on config + data), so
                # false "both applicable" results are common for these.
                # The runtime scheduler already enforces exactly-one via
                # applies_if; this check covers genuine structural errors.
                my @groups = grep { defined $_ }
                             map  { $runstep{$_}{group} }
                             @producers;
                my %unique_groups = map { $_ => 1 } @groups;
                if ( @groups == @producers && keys %unique_groups == 1 ) {
                    next;  # all producers share a group -- legitimate pair
                }

                my @active_producers =
                    grep { defined $_ && eval { exists $runstep{$_}{applies_if} ? $runstep{$_}{applies_if}->($i) : 1 } }
                    @producers;

                if ( @active_producers == 0 ) {
                    # If the key exists in %data_key but has no runstep
                    # producer, it is a synthetic/composite key (like
                    # any_assembler_done) whose check function computes its
                    # value from other keys. No runstep declares produces for
                    # it -- that is by design. Check A already verified it
                    # has a %data_key entry; skip the producer count check.
                    next if exists $data_key{$key};
                    push @problems, "Sample [$sample_name]: runstep [$name] requires [$key], but no declared producer of it applies for this sample";
                }
                elsif ( @active_producers > 1 ) {
                    push @problems, "Sample [$sample_name]: key [$key] has " . scalar(@active_producers) . " simultaneously-applicable declared producers (" . join(", ", grep { defined $_ } @active_producers) . ") -- ambiguous";
                }
            }
        }
    }

    return @problems;
}

# Single entry point -- collects every problem from all three checks before
# stopping, so a developer sees all issues in one pass.
sub validate_runstep_graph {
    # Structural check: applies_if answers from the config only (see
    # $S_STATIC_APPLIES) -- no tool may run here, before any sample data.
    local $S_STATIC_APPLIES = 1;
    my @problems;
    for my $check (
        [ "data-key registry",       \&validate_requires_have_data_keys ],
        [ "dependency cycles",       \&detect_runstep_dependency_cycles ],
        [ "one producer per key",    \&validate_exactly_one_applicable_producer ],
        [ "duplicate hash keys",     \&validate_no_duplicate_hash_keys ],   # Perl silent-overwrite bugs
    ) {
        my $t0 = time();
        push @problems, $check->[1]->();
        log_message(sprintf("INFO: Graph validation: %-22s %.2f s", $check->[0], time() - $t0));
    }

    return unless @problems;

    log_message("ERROR: Runstep dependency graph validation failed:", "red");
    log_message("ERROR:   - $_", "red") for @problems;
    graceful_die("Runstep dependency graph validation failed (" . scalar(@problems) . " problem(s)) -- see above");
}

# Check A-extra: detect the Perl silent-overwrite trap where a runstep hash
# contains duplicate keys. Perl silently discards all but the last value for
# a duplicate key in a hash literal, so { requires => [...], requires => [...] }
# leaves only the second requires in effect. This is impossible to catch at
# runtime from the hash alone (the first value is simply gone), so we check
# at the source-code level by re-parsing this script's own text.
sub validate_no_duplicate_hash_keys {
    my @problems;

    # Read our own source and walk it line by line. When a line opens a
    # runstep hash literal ('$runstep{$runstep_name} = {'), track brace
    # depth until the literal closes. Any 'key =>' that starts a line at
    # depth 1 is a top-level key of that hash; seeing the same key twice
    # in one literal is the silent-overwrite bug.
    #
    # The previous regex-based version could not handle nested braces
    # (e.g. 'applies_if => sub { ... $R_cfg->{x}{y} ... }') and in
    # practice matched nothing, so duplicates went undetected. Brace
    # counting is balanced for everything that appears inside runstep
    # hashes (subs, hash lookups, anonymous hashes), so it is robust here.
    my $src_path = $0;  # the pipeline script itself
    open my $fh, '<', $src_path or return ();
    my @lines = <$fh>;
    close $fh;

    my $current_name = "unknown";
    my $in_block     = 0;
    my $depth        = 0;
    my %seen;

    for my $lineno (0 .. $#lines) {
        my $line = $lines[$lineno];

        if (!$in_block && $line =~ /^\s*\$runstep_name\s*=\s*"([^"]+)"\s*;/) {
            $current_name = $1;
            next;
        }

        if (!$in_block) {
            next unless $line =~ /^\s*\$runstep\{\$runstep_name\}\s*=\s*\{\s*(?:#.*)?$/;
            $in_block = 1;
            $depth    = 1;
            %seen     = ();
            next;
        }

        # Strip comments before counting braces / keys
        (my $code = $line) =~ s/#.*$//;

        if ($depth == 1 && $code =~ /^\s*(\w+)\s*=>/) {
            my $key = $1;
            push @{ $seen{$key} }, $lineno + 1;
        }

        my $opens  = () = $code =~ /\{/g;
        my $closes = () = $code =~ /\}/g;
        $depth += $opens - $closes;

        if ($depth <= 0) {
            for my $key (sort keys %seen) {
                next unless @{ $seen{$key} } > 1;
                push @problems,
                    "Runstep [$current_name] has duplicate key [$key] in its hash literal "
                  . "(lines " . join(", ", @{ $seen{$key} }) . ") -- Perl silently discards "
                  . "all but the last value; only the final one is effective.";
            }
            $in_block = 0;
            $depth    = 0;
        }
    }

    return @problems;
}

###################################################################################################
## Early-test counterpart to run_data_driven_runsteps, for the same reason
## the old @runorder_loop1-driven test loop exists: surface a missing
## requirement before any real processing, not after. Respects applies_if
## the same way -- a disabled runstep is silently skipped here exactly as
## it would have been by never being pushed onto @runorder_loop1 at all.
sub test_data_driven_runsteps {
    my ($runstep_names, $i) = @_;

    my $sample_name = $R_samples->[$i]{name} // "sample $i";
    my $in_parallel = lc($R_cfg->{general}{parallel_mode} // 'off') eq 'on';
    local $S_STATIC_APPLIES = 1;   # test phase: no sample data yet, never run tools here

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in runstep [$name] for sample [$sample_name] during test phase: $err -- skipping", "red");
                next;
            }
            next unless $applies;
        }

        # In parallel mode, also check requires before calling the test
        # function. Many test functions call preprocessing internally to
        # check readiness; if the step's requires (e.g. main_assembly_present)
        # are not yet satisfied, those preprocessing calls would log spurious
        # warnings ("nothing available", "input file missing") about data that
        # simply hasn't been produced yet in this run. Silently skip instead.
        # The implicit species_determined requirement added for species-
        # restricted runsteps is ignored here: those tools are tested
        # whenever they are enabled, whatever the samples contain.
        if ( $in_parallel && @{ $def->{requires} // [] } ) {
            my $ready = 1;
            for my $key ( @{ $def->{requires} } ) {
                next if $def->{_implicit_requires}{$key};
                unless ( exists $data_key{$key} && eval { $data_key{$key}{check}->($i) } ) {
                    $ready = 0; last;
                }
            }
            unless ($ready) {
                # The step's own test cannot run yet, but its conda
                # environment can and must be checked now -- otherwise a
                # missing environment (e.g. a newly enabled tool) is never
                # offered for installation and the step only fails much
                # later, in the middle of the run. check_conda_tool does
                # the install prompt and remembers what it already tested.
                my $section = get_runstep_config_section($name);
                if ( defined $section && ( $R_cfg->{$section}{env} // "" ) ne "" ) {
                    my $rc = eval { check_conda_tool($section) };
                    if ($@) {
                        (my $err = $@) =~ s/\n/ /g;
                        log_message("ERROR: [PIPELINE BUG] environment check crashed for [$name] ($section): $err", "red");
                    }
                    elsif ( defined $rc && $rc == 1 ) { log_message("NOTICE: $name: OK (environment)"); }
                    elsif ( defined $rc && $rc == 0 ) { log_message("NOTICE: Missing requirements for [$name]", "red"); }
                }
                next;
            }
        }

        next unless ref $def->{test} eq 'CODE';   # nothing to test
        my $test_results = eval { $def->{test}->($i) };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] test function crashed in runstep [$name] for sample [$sample_name]: $err -- skipping", "red");
            next;
        }
        next if $test_results == 2;

        if ( $test_results == 1 ) { log_message("NOTICE: $name: OK"); }
        if ( !$test_results ) { log_message("NOTICE: Missing requirements for [$name]", "red"); }
    }
}
sub run_data_driven_runsteps {
    my ($runstep_names, $i) = @_;

    my $sample_name = $R_samples->[$i]{name} // "sample $i";

    for my $name (@$runstep_names) {

        # Fatal-error brake -- checked on every iteration since the flag
        # can become true mid-list (e.g. a coverage-check runstep earlier
        # in the same list call sets it via set_runtime_issue("fail",...)).
        if ( $R_samples->[$i]{fatal_error} ) {
            unless ( $R_samples->[$i]{_fatal_error_logged} ) {
                my $reason = join("; ", @{ $R_samples->[$i]{fatal_error_message} // [] });
                log_message("WARNING: Sample $sample_name: stopping further analysis -- $reason", "red");
                emit_event(type => 'sample_abandoned', sample => $i, reason => $reason);
                $R_samples->[$i]{_fatal_error_logged} = 1;
            }
            last;
        }

        my $def = $runstep{$name};
        next unless defined $def;

        # applies_if -- exception safety (S9.2). A crash here is a
        # PIPELINE CODE BUG, not a data-quality issue. Treat as a soft
        # skip (same as if applies_if returned false) -- never
        # fatal_to_sample. Logged distinctly so the error class is clear.
        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in runstep [$name] for sample [$sample_name]: $err -- skipping (soft skip)", "red");
                next;
            }
            next unless $applies;
        }

        # species field: in this sequential single pass, find_species_kraken2
        # comes earlier in the list, so species is normally known here.
        # If it is not, the implicit species_determined requires below
        # skips the step.
        next unless runstep_species_applies($def, $i);

        # Sequential mode is a single pass: once a step's turn has come it
        # will not be revisited, whether it runs below or is skipped.
        $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;

        # requires / data_key checks
        my $requires_ok = 1;
        for my $key ( @{ $def->{requires} // [] } ) {
            my $satisfied = eval { exists $data_key{$key} && $data_key{$key}{check}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] data_key check crashed for key [$key] in runstep [$name], sample [$sample_name]: $err -- treating as unsatisfied", "red");
                $satisfied = 0;
            }
            unless ($satisfied) {
                $requires_ok = 0;
                last;
            }
        }
        unless ($requires_ok) {
            # Sequential order: a requirement that is unmet now never comes.
            my @unmet = grep { !( exists $data_key{$_} && eval { $data_key{$_}{check}->($i) } ) } @{ $def->{requires} // [] };
            note_skipped_step($i, $name, \@unmet, $runstep_names) unless $R_samples->[$i]{fatal_error};
            next;
        }

        # preprocessing
        my $command = eval { $def->{preprocessing}->($i) };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] preprocessing crashed in runstep [$name] for sample [$sample_name]: $err -- skipping runstep (soft skip)", "red");
            next;
        }

        note_if_reused($i, $name) unless defined $command && $command ne "";

        if ( defined $command && $command ne "" ) {
            my $t_start = time();
            local $S_CURRENT_STEP = { runstep => $name, sample => $i, start_time => $t_start };   # for kill_all_children
            my $known_fail = sample_known_data_fail($i);
            local $S_EXPECTED_FAIL_REASON = $known_fail ne "" ? $known_fail : undef;   # execute_and_log: NOTICE, not ERROR
            my $r = run_step(
                runstep_key => $name,
                name       => $def->{long_name},
                samplenr   => $i,
                message    => $def->{message},
                command    => $command,
                resultfile => "",
                timeout_s  => get_runstep_timeout($name),
            );
            if ( ref $r eq 'HASH' && $r->{timed_out} ) {
                set_runtime_issue($i, "warning", "[$name] stopped: time limit (" . format_elapsed(get_runstep_timeout($name)) . ") reached", $name);
                set_aside_timed_out_result($name, $i, $t_start);
                push @{ $R_samples->[$i]{failed_steps} }, { runstep => $name, reason => "timeout" };
            }
            elsif ( ref $r eq 'HASH' && !$r->{success} && $known_fail ne "" ) {
                set_aside_partial_result($name, $i, $t_start, "failed");
                note_expected_step_failure( $i, $name, "exit code " . ( $r->{exit_code} // '?' ), $known_fail );
            }
            elsif ( ref $r eq 'HASH' && !$r->{success} ) {
                set_runtime_issue($i, "warning", "[$name] failed (exit code " . ( $r->{exit_code} // '?' ) . ")", $name);
                set_aside_partial_result($name, $i, $t_start, "failed");
                push @{ $R_samples->[$i]{failed_steps} }, { runstep => $name, reason => "exit code " . ( $r->{exit_code} // '?' ) };
            }

            # result_parsing
            eval { $def->{result_parsing}->($i) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] result_parsing crashed in runstep [$name] for sample [$sample_name]: $err -- results for this runstep may be incomplete", "red");
            }
        }
    }
}
###################################################################################################
## Batch-level counterparts to run_data_driven_runsteps/test_data_driven_runsteps,
## for runsteps that are genuinely cross-sample by nature (sort_assemblies,
## multiqc) rather than sample-oriented -- see the design discussion on
## keeping as much as possible sample-oriented so samples from different
## runs can be combined later, with these as the deliberate, named
## exceptions. No sample index: applies_if/test/preprocessing/
## result_parsing are all called with no arguments, exactly mirroring the
## existing @runorder_post1 calling convention (samplenr => -1 in run_step)
## -- this replaces that hardcoded list with the same declarative contract
## the per-sample runsteps already use, not a different mechanism.
##
## "requires" here means something different than for a per-sample
## runstep: there's no single sample to check a data-key against. Two
## helpers below cover the two ways that's actually needed in practice --
## "did at least one sample get far enough" (sort_assemblies tolerates
## individual samples missing their assembly, so it only needs SOME
## sample to have one) versus a stricter "did every sample get there"
## for anything that would need that instead. Meaningful only once the
## full per-sample phase has completed, which is exactly when batch
## runsteps are positioned to run.

sub any_sample_satisfies {
    my ($key) = @_;
    return 0 unless exists $data_key{$key};
    for my $i ( 0 .. $#$R_samples ) {
        return 1 if $data_key{$key}{check}->($i);
    }
    return 0;
}

sub all_samples_satisfy {
    my ($key) = @_;
    return 0 unless exists $data_key{$key};
    for my $i ( 0 .. $#$R_samples ) {
        return 0 unless $data_key{$key}{check}->($i);
    }
    return 1;
}

sub test_data_driven_batch_runsteps {
    my ($runstep_names) = @_;

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in batch runstep [$name] during test phase: $err -- skipping", "red");
                next;
            }
            next unless $applies;
        }

        next unless ref $def->{test} eq 'CODE';   # nothing to test (e.g. cleanup)
        my $test_results = eval { $def->{test}->() };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] test function crashed in batch runstep [$name]: $err -- skipping", "red");
            next;
        }
        next if $test_results == 2;

        if ( $test_results == 1 ) { log_message("NOTICE: $name: OK"); }
        if ( !$test_results ) { log_message("NOTICE: Missing requirements for [$name]", "red"); }
    }
}
sub run_data_driven_batch_runsteps {
    my ($runstep_names) = @_;

    for my $name ( @$runstep_names ) {
        my $def = $runstep{$name};
        next unless defined $def;

        # applies_if -- same exception-safety rationale as in
        # run_data_driven_runsteps (S9.2): a crash is a PIPELINE CODE BUG,
        # logged distinctly, treated as a soft skip. Batch runsteps have no
        # single sample to attribute a fatal_to_sample to anyway.
        if ( exists $def->{applies_if} ) {
            my $applies = eval { $def->{applies_if}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] applies_if crashed in batch runstep [$name]: $err -- skipping (soft skip)", "red");
                next;
            }
            next unless $applies;
        }

        my $requires_ok = 1;
        for my $key ( @{ $def->{requires} // [] } ) {
            my $satisfied = eval { any_sample_satisfies($key) };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] requires check crashed for key [$key] in batch runstep [$name]: $err -- treating as unsatisfied", "red");
                $satisfied = 0;
            }
            unless ($satisfied) {
                $requires_ok = 0;
                last;
            }
        }
        next unless $requires_ok;

        my $command = eval { $def->{preprocessing}->() };
        if ($@) {
            (my $err = $@) =~ s/\n/ /g;
            log_message("ERROR: [PIPELINE BUG] preprocessing crashed in batch runstep [$name]: $err -- skipping runstep (soft skip)", "red");
            next;
        }

        if ( defined $command && $command ne "" ) {
            run_step(
                runstep_key => $name,
                name       => $def->{long_name},
                samplenr   => -1,
                message    => $def->{message},
                command    => $command,
                resultfile => "",
                timeout_s  => get_runstep_timeout($name),
            );

            eval { $def->{result_parsing}->() };
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                log_message("ERROR: [PIPELINE BUG] result_parsing crashed in batch runstep [$name]: $err -- results for this runstep may be incomplete", "red");
            }
        }
    }
}

###################################################################################################
## Control channel (§11.3) -- spool directory under out/control/, one JSON
## file per command, processed in filename order (timestamps in the name
## ensure chronological order), each file deleted after handling so it is
## never processed twice.
##
## Supported commands:
##   { "command": "pause" }            -- stop dispatching new work
##   { "command": "resume" }           -- resume normal dispatch
##   { "command": "terminate" }        -- graceful terminate: finish the
##                                        current step, then exit 1
##
## Command delivery from the GUI/operator side:
##   Write to a temp name, then rename atomically into the spool dir.
##   Never write the final filename directly (avoids a partially-written
##   file at its final name being read before the write is complete).
##   Example: write_file("$control_dir/.tmp_$name", '{"command":"pause"}');
##            rename("$control_dir/.tmp_$name", "$control_dir/$name");

# Filled in a BEGIN block: this line sits far below the main program, which
# has already run (and exited) before execution would reach a plain
# 'my %h = (...)' here -- the hash would be empty whenever it is used, and
# every command was rejected as unknown.
my %_valid_control_command;
BEGIN { %_valid_control_command = map { $_ => 1 } qw(pause resume terminate); }

sub process_control_commands {
    return unless -d $S_control_dir;

    opendir(my $dh, $S_control_dir) or return;
    my @files = sort grep { /^[^.]/ && -f "$S_control_dir/$_" } readdir($dh);
    closedir($dh);

    for my $file (@files) {
        my $path = "$S_control_dir/$file";
        my $raw  = do { local $/; open(my $fh,'<',$path) or next; <$fh> } // '';
        my $cmd  = eval { JSON::MaybeXS->new->decode($raw) };
        my $json_err = $@;
        my $name = ($cmd && ref $cmd eq 'HASH') ? ($cmd->{command} // '') : '';

        # Also accept the bare word, for typing by hand:  echo pause > control/p
        if ($name eq '' && $raw =~ /^\s*(pause|resume|terminate)\s*$/i) {
            $name = lc $1;
        }

        unless ($_valid_control_command{$name}) {
            (my $shown = substr($raw, 0, 80)) =~ s/[^\x20-\x7e]/?/g;   # non-ASCII (e.g. curly quotes) shown as ?
            my $why = $name ne ''   ? "unknown command [$name]"
                    : $json_err     ? "not valid JSON"
                    :                 "no \"command\" field";
            log_message("WARNING: Control channel: ignoring command file [$file] -- $why. Content: [$shown]. "
                      . "Expected {\"command\":\"pause|resume|terminate\"} or just the word", "red");
            unlink $path;
            next;
        }

        if ($name eq 'pause') {
            unless ($S_paused) {
                $S_paused = 1;
                $S_paused_since = time();
                log_message("NOTICE: Control channel: PAUSED -- will not dispatch new work until resumed", "yellow");
                emit_event(type => 'paused');
            }
        }
        elsif ($name eq 'resume') {
            if ($S_paused) {
                $S_paused = 0;
                $S_paused_since = undef;
                log_message("NOTICE: Control channel: RESUMED -- resuming normal dispatch", "green");
                emit_event(type => 'resumed');
            }
        }
        elsif ($name eq 'terminate') {
            unless ($S_terminate) {
                $S_terminate = 1;
                $S_paused    = 1;   # stop new dispatch too
                log_message("NOTICE: Control channel: TERMINATE received -- will exit after current step finishes", "red");
                emit_event(type => 'terminating');
            }
        }

        unlink $path;
    }
}

# Called at the start of every run_step invocation, before dispatch.
# Processes any pending commands, then blocks (with a short poll sleep)
# if paused, so a pause/resume pair issued between two steps has the
# intended effect. A terminate command while paused is also honoured here.
sub check_control_channel {
    process_control_commands();

    while ($S_paused) {
        # Check for new commands (a resume or terminate) while we wait.
        # 5-second poll -- short enough to feel responsive, long enough
        # not to burn CPU while idle.
        sleep 5;
        process_control_commands();

        if ($S_terminate) {
            log_message("NOTICE: Control channel: terminating after pause -- exiting now", "red");
            close_logfile();
            exit 6;   # stopped on request (A15)
        }
    }

    if ($S_terminate) {
        log_message("NOTICE: Control channel: terminating after current step -- exiting now", "red");
        close_logfile();
        exit 6;   # stopped on request (A15)
    }
}

sub run_step {
    my (%args) = @_;

    my $name        = $args{name}        // "Unnamed step";
    my $samplenr    = $args{samplenr}    // -1;
    my $message     = $args{message}     // "";
    my $command     = $args{command}     // "";
    my $resultfile  = $args{resultfile}  // "";
    my $timeout_s   = $args{timeout_s};      # undef -> general.timeout

    # progress report
    my $formated_msg = log_progress($samplenr, $message);

    
    {

      # Control channel check (§11.3) -- honour any pending pause/resume/
      # terminate commands before starting a new piece of work. Called here
      # rather than in the schedulers so a single hook covers every
      # runstep, per-sample and batch alike, without scheduler duplication.
      check_control_channel();

      my $key = $args{runstep_key} // $name;
      emit_runstep_event('runstep_started', $samplenr, $key);

      my $result = execute_and_log($command, 1, $formated_msg, $timeout_s );

      emit_runstep_event('runstep_finished', $samplenr, $key,
          status    => !$result ? 'failed' : $result->{timed_out} ? 'timeout' : $result->{success} ? 'success' : 'failed',
          exit_code => $result ? $result->{exit_code} : undef,
          elapsed_s => $result ? $result->{elapsed_s} : undef,
      );

      return $result;
    }

}

# Has the sample already failed on its data, before this step? Then a later
# step that fails, or is skipped because of it, is a consequence and not a
# new problem: it is recorded as a note (expected_failed_steps,
# expected_skipped) and does not count as a run error, a failed step (exit
# code 5) or a runtime warning. Judged with the FAIL thresholds of the read
# and coverage measures (qscore_*, coverage_*) that already have a value,
# so it follows the configuration. Returns the reason, or "".
sub sample_known_data_fail {
    my ($i) = @_;
    my $s = $R_samples->[$i] // return "";
    if ( $s->{fatal_error} ) {
        my $m = $s->{fatal_error_message};
        $m = join( "; ", @$m ) if ref $m eq 'ARRAY';
        return "sample abandoned" . ( defined $m && $m ne "" ? ": $m" : "" );
    }
    my $species = $s->{main_results}{taxonomy}{species} // '';
    for my $measure ( sort keys %QC_MEASURE_DEF ) {
        my $def = $QC_MEASURE_DEF{$measure};
        next unless ( $def->{category} // '' ) =~ /^(qscore|coverage)$/;
        my $observed = eval { get_main_result_value( $i, $def->{path} ) };
        next if !defined $observed || ref $observed || $observed eq '' || lc $observed eq 'n/a';
        my $txt = get_config_value_for_species( $species, "fail_$measure" );
        next if !defined $txt || $txt eq '';
        my $th = parse_threshold_string($txt);
        next unless $th && @{ $th->{conditions} // [] };
        return "QC FAIL on the data: " . ( $def->{label} // $measure ) . " is $observed (fail $txt)"
            if threshold_matches( $observed, $th );
    }
    return "";
}

# A step that failed on a sample whose data had already failed: a note.
sub note_expected_step_failure {
    my ($i, $name, $why, $because) = @_;
    my $sn = $R_samples->[$i]{name} // $i;
    push @{ $R_samples->[$i]{expected_failed_steps} }, { runstep => $name, reason => $why, because => $because };
    log_message("NOTICE: Sample $sn: [$name] failed ($why) -- expected, the data had already failed ($because); recorded as a note, not as a run error");
}

# A step that could not run because a requirement will never be met.
# "An earlier step failed" goes to the run summary (skipped_upstream) and
# the log; "nothing produces it for this sample" is normal and only logged.
sub note_skipped_step {
    my ($i, $name, $unmet, $names) = @_;
    my $why = ( grep { key_unreachable_reason($_, $i, $names) eq "failed" } @$unmet ) ? "failed" : "not_applicable";
    my $sn  = $R_samples->[$i]{name} // $i;
    if ( $why eq "failed" && ( my $because = sample_known_data_fail($i) ) ne "" ) {
        push @{ $R_samples->[$i]{expected_skipped} }, $name;
        log_message("INFO: Sample $sn: [$name] skipped -- an earlier step failed on data that had already failed ($because)");
    } elsif ( $why eq "failed" ) {
        push @{ $R_samples->[$i]{skipped_upstream} }, $name;
        log_message("INFO: Sample $sn: [$name] skipped -- an earlier step failed (no " . join(", ", @$unmet) . ")");
    } else {
        log_message("INFO: Sample $sn: [$name] not run -- nothing produced " . join(", ", @$unmet) . " for this sample");
    }
    emit_runstep_event( 'runstep_finished', $i, $name, status => 'skipped', reason => ( $why eq "failed" ? "upstream failed" : "requirement not produced" ) );
}

# Can data key $key still be produced for sample $i? Returns "" if it can
# (or cannot be decided), else why not:
#   "failed"         -- its producers are settled and at least one was tried:
#                       an earlier step failed (shown in the run summary)
#   "not_applicable" -- no producer applies to this sample
# Producers are the runsteps in @$names that produce the key, or that it is
# derived from (derived_from). Settled = runstep_settled and not running.
sub key_unreachable_reason {
    my ($key, $i, $names) = @_;
    my %prod;
    for my $n (@$names) {
        $prod{$n} = 1 if grep { $_ eq $key } @{ $runstep{$n}{produces} // [] };
    }
    my $df = $data_key{$key}{derived_from};
    if ( ref $df eq 'HASH' ) {
        $prod{ $df->{runstep} } = 1 if $df->{runstep};
        $prod{$_} = 1 for ( $df->{group} ? group_members( $df->{group} ) : () );
    }
    return "" unless %prod;
    my $tried = 0;
    for my $n ( keys %prod ) {
        return "" if grep { $_->{sample} == $i && $_->{runstep} eq $n } values %S_par_active;
        return "" unless runstep_settled($n, $i);
        $tried = 1 if $S_RUNSTEP_ATTEMPTED{"$i,$n"};
    }
    return $tried ? "failed" : "not_applicable";
}

# A step that did not finish properly -- time limit, exit code != 0 or a
# signal, or the whole run interrupted -- may have left a half-written result
# file (shell redirections create it before the tool starts). Move it aside
# (<file>.timeout / .failed / .interrupted) so result_parsing reports the
# step as failed and a later --resume runs it again instead of reusing a
# broken file (A4). Only a file written during this attempt is touched.
sub set_aside_timed_out_result { my ($name, $i, $start_time) = @_; set_aside_partial_result($name, $i, $start_time, "timeout"); }

sub set_aside_partial_result {
    my ($name, $i, $start_time, $why) = @_;
    $why //= "failed";
    my %what = ( timeout => "time limit reached", failed => "the step failed", interrupted => "the run was interrupted" );
    my $tmpl = $runstep{$name}{resultfile} // "";
    return if $tmpl eq "";
    my $f = eval { fill_placeholders($tmpl, $i, $name) } // "";
    return if $f eq "" || $f =~ /__[A-Z0-9-]+__/ || !-e $f;
    # CORE::stat: 'use File::stat' further up makes plain stat() return an object (A1)
    return if ( ( CORE::stat($f) )[9] // 0 ) < $start_time - 1;   # older than this attempt
    unlink "$f.$why" if -e "$f.$why";
    if ( rename $f, "$f.$why" ) {
        log_message("WARNING: [$name] " . ( $R_samples->[$i]{name} // "sample $i" )
                  . ": " . ( $what{$why} // $why ) . " -- its result file was moved aside to $f.$why"
                  . " (a later --resume runs the step again)");
    }
}

#########################################################################################################
## rerun=<step>[,<step>...]
##
## Runs the named runsteps again in an existing output directory, together
## with every runstep that depends on them, for all samples. It works by
## removing their result files before the run: each runstep's preprocessing
## then finds nothing and runs the tool, while everything else is reused
## (resume mode). Dependents come from the requires/produces graph,
## including composite keys via data_key{...}{derived_from}.
##
## What is removed per (sample, runstep): the resultfile; the output_dir if
## it is per sample (contains __BASE__); and any rerun_paths (contract
## field, globs allowed). Only paths inside the output directory are ever
## touched. Selection/check steps without result files simply run again.
## Batch steps whose results cannot be resolved per sample (e.g. chewBBACA
## per species) get a warning telling what to remove by hand.

# Runsteps whose results are invalidated when the steps in @$start rerun.
sub rerun_closure {
    my ($start) = @_;
    my %in = map { $_ => 1 } @$start;
    my @all = ( @PER_SAMPLE_RUNSTEPS, @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST );

    my %producers;   # key -> [runsteps]
    for my $n (@all) { push @{ $producers{$_} }, $n for @{ $runstep{$n}{produces} // [] }; }
    my $sources = sub {
        my ($key) = @_;
        my @s = @{ $producers{$key} // [] };
        my $d = $data_key{$key}{derived_from};
        if ($d) {
            push @s, group_members($d->{group}) if $d->{group};
            push @s, $d->{runstep}              if $d->{runstep};
        }
        return @s;
    };

    my $changed = 1;
    while ($changed) {
        $changed = 0;
        for my $n (@all) {
            next if $in{$n};
            for my $key ( @{ $runstep{$n}{requires} // [] } ) {
                if ( grep { $in{$_} } $sources->($key) ) { $in{$n} = 1; $changed = 1; last; }
            }
        }
    }
    return grep { $in{$_} } @all;   # in run order
}

sub prepare_rerun {
    my $spec = $R_cfg->{general}{rerun} // "";
    return unless $spec =~ /\S/;

    my @all   = ( @PER_SAMPLE_RUNSTEPS, @BATCH_RUNSTEPS_PRE, @BATCH_RUNSTEPS_POST );
    my %known = map { $_ => 1 } @all;
    my @asked = grep { $_ ne "" } map { s/^\s+|\s+$//gr } split /,/, $spec;
    my @unknown = grep { !$known{$_} } @asked;
    if (@unknown) {
        graceful_die("rerun=: unknown runstep(s): " . join(", ", @unknown)
                   . ". Valid names: " . join(" ", @all));
    }

    my @steps = rerun_closure(\@asked);
    my %asked = map { $_ => 1 } @asked;
    my @dependents = grep { !$asked{$_} } @steps;

    log_message("NOTICE: rerun: " . join(", ", @asked)
              . ( @dependents ? " -- and the steps that depend on it: " . join(", ", @dependents) : "" ), "yellow");

    # Steps that are switched off for every sample will not run at all.
    for my $n (@asked) {
        my $def = $runstep{$n};
        next unless exists $def->{applies_if};
        my $any = grep { eval { $def->{applies_if}->($_) } } 0 .. $#$R_samples;
        log_message("WARNING: rerun: [$n] does not apply to any sample with the current configuration"
                  . " (switched off?) -- it will not run", "yellow") unless $any;
    }

    my $outroot = abs_path( getdir("out") ) // getdir("out");
    my ($n_removed, @manual) = (0);

    my $remove = sub {
        my ($path) = @_;
        my $abs = abs_path($path) // $path;
        unless ( index($abs, "$outroot/") == 0 ) {
            log_message("WARNING: rerun: not removing [$path] -- outside the output directory", "red");
            return;
        }
        if    (-d $abs) { remove_tree($abs); }
        elsif (-e $abs) { unlink $abs; }
        else            { return; }
        log_message("INFO: rerun: removed $abs");
        $n_removed++;
    };

    for my $n (@steps) {
        my $def      = $runstep{$n};
        my $is_batch = !grep { $_ eq $n } @PER_SAMPLE_RUNSTEPS;
        my @templates;
        push @templates, $def->{resultfile} if ( $def->{resultfile} // "" ) ne "";
        push @templates, $def->{output_dir} if !$is_batch && ( $def->{output_dir} // "" ) =~ /__BASE__/;
        push @templates, @{ $def->{rerun_paths} // [] };
        next unless @templates;

        my $unresolved = 0;
        for my $i ( 0 .. $#$R_samples ) {
            for my $tpl (@templates) {
                my $path = eval { fill_placeholders($tpl, $i, $n) } // "";
                if ( $path eq "" || $path =~ /__[A-Z0-9-]+__/ ) { $unresolved = 1; next; }
                $remove->($_) for ( $path =~ /[*?\[]/ ? glob($path) : ($path) );
            }
        }
        if ($is_batch && $unresolved) {
            push @manual, "$n (" . ( $def->{output_dir} // "?" ) . ")";
        }
    }

    log_message("NOTICE: rerun: removed $n_removed result file(s)/folder(s); the steps above will run again, everything else is reused");
    if (@manual) {
        log_message("WARNING: rerun: batch step results not removed automatically -- remove them by hand if they must be redone: "
                  . join("; ", @manual), "yellow");
    }
    $rundata{rerun}{requested} = \@asked;
    $rundata{rerun}{steps}     = \@steps;
}

#########################################################################################################
## Provenance in resumed runs
##
## A runstep whose preprocessing finds an existing result (and returns "")
## and whose result file is older than this run was reused from an earlier
## run. Recorded per sample in results.run_history.reused_steps and summed
## up in the main report banner.

sub note_if_reused {
    my ($i, $name) = @_;
    return unless $S_RUN_MODE eq "resumed";
    my $tpl = $runstep{$name}{resultfile} // "";
    return if $tpl eq "";
    my $path = eval { fill_placeholders($tpl, $i, $name) } // "";
    return if $path eq "" || !-e $path;
    my $start = $rundata{timestamps}{pipeline_start}{time_value} // time();
    return unless ( ( CORE::stat($path) )[9] // 0 ) < $start;   # CORE::stat, see A1
    my $h    = $R_samples->[$i]{results}{run_history} //= {};
    my $list = $h->{reused_steps} //= [];
    push @$list, $name unless grep { $_ eq $name } @$list;
    $h->{reused_steps_text} = join(", ", @$list);
    emit_runstep_event('runstep_finished', $i, $name, status => 'reused');
}

###################################################################################################
## Moved or copied analyses (resume)
##
## log/filelist_fastq.txt and filelist_fasta.txt keep the raw file paths as
## they were when the analysis was made, and are never rewritten: together
## with the MD5 sums in results/qc/stage1_rawdata/md5/ they document which
## files were analysed. When an analysis has been moved or copied (normally
## the whole data folder, with eurlc-wgs/ in it), a resumed run finds each
## file at the data folder's new place, checks it against its recorded MD5,
## and records the move (log, rundata provenance, report banner).

## The data folders in log/input_dir.txt, oldest first.
sub read_input_dir_history {
    my ($f) = @_;
    my @l;
    if ( -f $f && open( my $fh, '<', $f ) ) {
        while ( my $x = <$fh> ) { chomp $x; $x =~ s/^\s+|\s+$//g; push @l, $x if $x ne ""; }
        close $fh;
    }
    return @l;
}

## A recorded input path -> the path to read now. Unchanged when the file is
## there or this is not a resume. Otherwise: the same path relative to an
## earlier data folder, under the current one; then the same file name
## directly in the current one. Records what it found (%S_RELOCATED).
sub resolve_moved_input {
    my ($path) = @_;
    return $path if !defined $path || $path eq "" || -f $path || !is_resume_mode();
    my $now = eval { abs_path( peekdir("in") ) } // peekdir("in");
    for my $old ( sort { length($b) <=> length($a) } @S_DATA_ROOTS_OLD ) {
        next if $old eq $now;
        if ( index( $path, "$old/" ) == 0 ) {
            my $cand = $now . substr( $path, length $old );
            if ( -f $cand ) { $S_RELOCATED{$path} = $cand; return $cand; }
        }
    }
    my $cand = "$now/" . basename($path);
    if ( -f $cand ) { $S_RELOCATED{$path} = $cand; return $cand; }
    return $path;
}

## After the sample lists are read on a resume: check every moved file
## against the MD5 recorded when it was analysed (a mismatch stops the run),
## report raw files that are not found, and record the move.
sub check_moved_inputs {
    my ($run_data) = @_;
    if (%S_RELOCATED) {
        my $md5dir = getdir("out") . "/results/qc/stage1_rawdata/md5";
        my %recorded;   # file name => md5
        if ( opendir( my $dh, $md5dir ) ) {
            for my $f ( grep { /\.txt$/ } readdir $dh ) {
                open( my $fh, '<', "$md5dir/$f" ) or next;
                while ( my $l = <$fh> ) {
                    $recorded{ basename($2) } = lc $1 if $l =~ /^([0-9a-f]{32})\s+(.+?)\s*$/i;
                }
                close $fh;
            }
            closedir $dh;
        }
        my $n = scalar keys %S_RELOCATED;
        log_message("NOTICE: Resume: the data folder has moved -- $n raw file(s) found at the new place; checking their MD5 sums");
        require Digest::MD5;
        my ( @bad, @unverified );
        my $ok = 0;
        for my $old ( sort keys %S_RELOCATED ) {
            my $new = $S_RELOCATED{$old};
            my $want = $recorded{ basename($old) };
            unless ( defined $want ) { push @unverified, $new; next; }
            my $got = "";
            if ( open( my $fh, '<', $new ) ) {
                binmode $fh;
                $got = Digest::MD5->new->addfile($fh)->hexdigest;
                close $fh;
            }
            if ( $got eq $want ) { $ok++; } else { push @bad, "$new (MD5 $got, recorded $want for $old)"; }
        }
        if (@bad) {
            graceful_die("Resume: " . scalar(@bad) . " raw file(s) at the new place are not the files that were analysed:\n  "
                       . join("\n  ", @bad)
                       . "\nPut the original files there, or give datadir= for the folder that holds them.");
        }
        log_message("WARNING: Resume: " . scalar(@unverified) . " moved raw file(s) have no recorded MD5 and were matched by name only: "
                  . join(", ", map { basename($_) } @unverified), "yellow") if @unverified;
        my %from = map { my $o = $_; my ($r) = grep { index( $o, "$_/" ) == 0 } @S_DATA_ROOTS_OLD; ( ( $r // dirname($o) ) => 1 ) } keys %S_RELOCATED;
        my $to = eval { abs_path( peekdir("in") ) } // peekdir("in");
        log_message("NOTICE: Resume: raw data read from [$to] (moved from [" . join("], [", sort keys %from) . "]): "
                  . "$ok file(s) MD5-verified" . ( @unverified ? ", " . scalar(@unverified) . " by name only" : "" ), "green");
        $rundata{provenance}{run}{data_relocation} = {
            from => [ sort keys %from ], to => $to, files => $n,
            md5_verified => $ok, name_only => scalar(@unverified), run_number => $S_RUN_NUMBER,
        };
    }
    if (%S_RAW_MISSING) {
        my @s = sort keys %S_RAW_MISSING;
        log_message("WARNING: Resume: the raw data of " . scalar(@s) . " sample(s) was not found ("
                  . join(", ", @s[0 .. ($#s < 7 ? $#s : 7)]) . ( @s > 8 ? ", ..." : "" ) . "). "
                  . "Steps that already have results are not affected; a step that needs the reads again will fail. "
                  . "First missing file: $S_RAW_MISSING{$s[0]}[0] -- give datadir= for the folder that holds the data.", "yellow");
        $rundata{provenance}{run}{raw_missing} = { map { $_ => $S_RAW_MISSING{$_} } @s };
    }
}

###################################################################################################
## Validation against a validation dataset (EURL-Campylobacter D1/D2/D3, ...)
##
## Every run writes report/tables/eurlc_observed_results.tsv: one row per
## sample in the pipeline-neutral format of scripts/eurlc-validate
## (docs/eurlc-validate.md). When a validation profile is found (validate=auto:
## in the data folder or the folder above it; or validate=<folder>),
## eurlc-validate compares it with the dataset's expected results, the cgMLST
## distance matrices (at each schema's cluster threshold) and the MD5 sums of
## the raw files; the result goes to report/validation/ and into the report.

## QC measures -> the QC issue words of the validation datasets.
sub validation_issue_codes {
    my ($s) = @_;
    my %codes;
    my $qc  = $s->{qc_checks}       // {};
    my $exp = $s->{qc_expectations} // {};
    my %word = (
        contamination_species_level => 'contamination', contamination_genus_level => 'contamination',
        contamination_mixed_windows => 'contamination',
        assembly_contigs_500 => 'high_contig_count', assembly_contigs => 'high_contig_count',
        assembly_n50 => 'low_n50', assembly_gc => 'gc_outside_range',
        typing_cgmlst_call_rate => 'low_cgmlst_call_rate', typing_cgmlst_paralogous => 'cgmlst_paralogous_loci',
        taxonomy_species_score => 'low_species_score',
    );
    for my $m ( keys %$qc ) {
        my $c = $qc->{$m};
        next unless ref $c eq 'HASH' && ( $c->{status} // "" ) =~ /^(WARNING|CRITICAL|FAIL)$/;
        if    ( $word{$m} )            { $codes{ $word{$m} } = 1; }
        elsif ( $m =~ /^coverage_/ )   { $codes{low_coverage} = 1; }
        elsif ( $m =~ /^qscore_/ )     { $codes{low_read_quality} = 1; }
        elsif ( $m eq 'assembly_size' ) {
            $codes{assembly_size_outside_range} = 1;
            # above or below the limits hit?
            my $v = $c->{observed};
            if ( defined $v && $v =~ /^[\d.]+$/ ) {
                my $t = $exp->{$m}{thresholds} // {};
                for my $lvl (qw(warning critical fail)) {
                    my $raw = ( $t->{$lvl} // {} )->{raw} // "";
                    $codes{large_assembly} = 1 if grep { $v > $_ } ( $raw =~ />\s*([\d.]+)/g );
                    $codes{small_assembly} = 1 if grep { $v < $_ } ( $raw =~ /<\s*([\d.]+)/g );
                }
            }
        }
    }
    if ( $s->{fatal_error} ) {
        my $m = $s->{fatal_error_message};
        $m = join(" ", @$m) if ref $m eq 'ARRAY';
        $codes{low_coverage} = 1 if ( $m // "" ) =~ /depth|coverage/i;
    }
    my $st = $s->{main_results}{mlst}{st} // "";
    $codes{no_st_determined} = 1 if ( $s->{type} // "" ) ne "" && ( $st eq "" || $st =~ /^(n\/a|-|\?|NA|None|novel)$/i );
    return join(";", sort keys %codes);
}

## report/tables/eurlc_observed_results.tsv (format: docs/eurlc-validate.md)
sub write_observed_results_table {
    my $dir  = getdir("out,report,tables");
    my $file = "$dir/eurlc_observed_results.tsv";
    my @cols = qw(sample_id species st mlst_alleles qc_status qc_issues cgmlst_called_percent cgmlst_scheme
                  reportable reportable_reason abandoned);
    open( my $fh, '>', $file ) or do { log_message("WARNING: cannot write [$file]: $!"); return; };
    print {$fh} join("\t", @cols), "\n";
    for my $s (@$R_samples) {
        my $mr = $s->{main_results} // {};
        my $fm = $s->{results}{fastmlst}{main} // $s->{results}{mlst}{main} // {};
        my @genes = @{ $fm->{allele_names} // [ sort map { /^allele_(.+)$/ ? $1 : () } keys %$fm ] };
        my $alleles = join(";", map { "$_(" . ( $fm->{"allele_$_"} // "?" ) . ")" } grep { defined $fm->{"allele_$_"} } @genes);
        my $rep = $mr->{reportable} // {};
        my $cr = $mr->{typing}{cgmlst_call_rate};
        my %v = (
            sample_id             => $s->{name},
            species               => $mr->{taxonomy}{species} // "",
            st                    => $mr->{mlst}{st} // "",
            mlst_alleles          => $alleles,
            qc_status             => $s->{qc}{status} // "",
            qc_issues             => validation_issue_codes($s),
            cgmlst_called_percent => ( defined $cr && $cr ne "n/a" ) ? $cr : "",
            cgmlst_scheme         => $mr->{typing}{cgmlst_call_rate_schema} // "",
            reportable            => $rep->{value} // "",
            reportable_reason     => join("; ", grep { defined $_ && $_ ne "" } $rep->{reason}, $rep->{note}),
            abandoned             => $s->{fatal_error} ? "yes" : "no",
        );
        print {$fh} join("\t", map { my $x = $v{$_} // ""; $x =~ s/[\t\n]/ /g; $x } @cols), "\n";
    }
    close $fh;
    return $file;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## Results fingerprint: report/tables/eurlc_results_fingerprint.json.gz
##
## Every result that matters for a report, per sample and grouped by area,
## plus what the run was made with (versions, settings). Two runs are
## compared with eurlc-wgs-inspect compare (after an update: are the results
## the same as before?; the same data run twice: repeatability). Format:
##   { format, format_version, created, run_name, pipeline_version,
##     context => { versions => {k=>v}, settings => {k=>v} },
##     samples => { <name> => { <area> => { <key> => scalar | [list] },
##                              cgmlst_alleles => { <schema> => { <locus> => allele } } } } }
## Areas: status taxonomy qc qc_status mixture mlst serotype amr virulence
## cgmlst cgmlst_alleles assembly. Values are kept as the pipeline wrote
## them (strings); lists are sorted.

sub fingerprint_sample {
    my ($s) = @_;
    my %fp;
    my $mr  = $s->{main_results} // {};
    my $res = $s->{results}      // {};
    my $sc  = sub { my $v = shift; return undef if !defined $v || ref $v; return "$v"; };
    my $put = sub { my ($area, $k, $v) = @_; $v = $sc->($v); $fp{$area}{$k} = $v if defined $v && $v ne ""; };

    # status
    $put->( status => qc_status  => $s->{qc}{status} );
    $put->( status => reportable => ( $mr->{reportable} // {} )->{value} );
    $put->( status => abandoned  => $s->{fatal_error} ? "yes" : "no" );
    $put->( status => abandoned_step => $s->{fatal_error_runstep} ) if $s->{fatal_error};
    $put->( status => type       => $s->{type} );
    for my $lvl (qw(warning critical fail)) {
        my $l = ( $s->{qc}{issues} // {} )->{$lvl};
        $fp{status}{"issues_$lvl"} = [ sort map { ref $_ ? ( $_->{check} // $_->{message} // "" ) : $_ } @$l ]
            if ref $l eq 'ARRAY' && @$l;
    }
    $put->( status => qc_issue_words => validation_issue_codes($s) );

    # taxonomy (and contamination by other species/genera)
    for my $k ( sort keys %{ $mr->{taxonomy} // {} } ) { $put->( taxonomy => $k => $mr->{taxonomy}{$k} ); }
    my $ct = $mr->{contamination} // {};
    for my $k ( sort keys %$ct ) {
        $put->( ( $k =~ /^mixed_/ ? "mixture" : "taxonomy" ), "contamination_$k" =~ s/^contamination_mixed_/mixed_/r, $ct->{$k} );
    }

    # QC measures: observed values and their status
    my $qc = $s->{qc_checks} // {};
    for my $m ( sort keys %$qc ) {
        next unless ref $qc->{$m} eq 'HASH';
        $put->( qc        => $m => $qc->{$m}{observed} );
        $put->( qc_status => $m => $qc->{$m}{status} );
    }

    # MLST: the reported ST, and each tool's ST and alleles
    for my $k ( sort keys %{ $mr->{mlst} // {} } ) { $put->( mlst => $k => $mr->{mlst}{$k} ); }
    for my $tool (qw(mlst fastmlst)) {
        my $m = ( $res->{$tool} // {} )->{main};
        next unless ref $m eq 'HASH';
        $put->( mlst => "$tool.st" => $m->{st} );
        $put->( mlst => "$tool.schema" => $m->{schema} );
        $put->( mlst => "$tool.$_" => $m->{$_} ) for grep { /^allele_/ } sort keys %$m;
    }

    # serotype, lineage and the like: the reported value and every tool's
    my $ty = $mr->{typing} // {};
    $put->( serotype => reported => ( $ty->{serotype} // {} )->{value} ) if ref $ty->{serotype} eq 'HASH';
    $put->( serotype => lineage => $ty->{lineage} );
    if ( ref $ty->{virulence} eq 'HASH' ) { $put->( virulence => "reported.$_" => $ty->{virulence}{$_} ) for sort keys %{ $ty->{virulence} }; }
    for my $tool ( sort keys %$res ) {
        my $r = $res->{$tool};
        next unless ref $r eq 'HASH';
        for my $k (qw(serotype serovar o_type h_type pathotype stx_subtypes lineage serogroup)) {
            $put->( serotype => "$tool.$k" => $r->{$k} ) if defined $r->{$k} && !ref $r->{$k};
        }
    }

    # AMR and virulence genes (sorted lists)
    my $af = ( $res->{amrfinderplus} // {} )->{amr_hits};
    if ( ref $af eq 'ARRAY' ) {
        my %by;
        for my $h (@$af) {
            next unless ref $h eq 'HASH';
            my $t = lc( $h->{type} // $h->{element_type} // $h->{subtype} // "amr" );
            $by{$t}{ $h->{element_symbol} // $h->{gene_symbol} // "?" } = 1;
        }
        $fp{amr}{"amrfinderplus.$_"} = [ sort keys %{ $by{$_} } ] for keys %by;
        $fp{amr}{"amrfinderplus.hits"} = scalar @$af;
    }
    for my $tool ( grep { /^resfinder/ } sort keys %$res ) {
        my $h = $res->{$tool}{resfinder_hits};
        next unless ref $h eq 'ARRAY';
        $fp{amr}{"$tool.genes"} = [ sort map { $_->{resistance_gene} // "?" } grep { ref $_ eq 'HASH' } @$h ];
    }
    for my $tool ( grep { /^virulencefinder/ } sort keys %$res ) {
        my $h = $res->{$tool}{hits};
        $fp{virulence}{"$tool.genes"} = [ sort map { $_->{gene} // "?" } grep { ref $_ eq 'HASH' } @$h ] if ref $h eq 'ARRAY';
    }

    # cgMLST, per schema: call rate etc. and the (hashed) allele profile
    my $cgdir = getdir("out") . "/results/clustering/chewbbaca";
    for my $tsv ( sort glob("$cgdir/*/*/per_sample/tsv/$s->{name}.profile.tsv") ) {
        my $schema = basename( dirname( dirname( dirname($tsv) ) ) );
        my $sp     = basename( dirname( dirname( dirname( dirname($tsv) ) ) ) );
        my $key    = "$sp/$schema";
        if ( open( my $fh, '<', $tsv ) ) {
            chomp( my $h = <$fh> // "" );
            chomp( my $r = <$fh> // "" );
            close $fh;
            my @h = split /\t/, $h;
            my @r = split /\t/, $r, -1;
            my %a;
            @a{ @h[ 1 .. $#h ] } = @r[ 1 .. $#h ];
            $fp{cgmlst_alleles}{$key} = \%a;
            $fp{cgmlst}{"$key.profile_md5"} = Digest::MD5::md5_hex( join( "\t", map { "$_=" . ( $a{$_} // "" ) } sort keys %a ) );
        }
        my $js = dirname( dirname($tsv) ) . "/json/$s->{name}.json";
        my $j  = -s $js ? eval { read_json_file($js) } : undef;
        if ( ref $j eq 'HASH' ) {
            for my $k (qw(call_rate called schema_size paralogous inferred EXC INF LNF NIPH NIPHEM ASM ALM PLOT3 PLOT5 LOTSC PAMA)) {
                $put->( cgmlst => "$key.$k" => $j->{$k} );
            }
        }
    }
    $put->( cgmlst => "reported.call_rate" => $mr->{typing}{cgmlst_call_rate} );
    $put->( cgmlst => "reported.schema"    => $mr->{typing}{cgmlst_call_rate_schema} );

    # assemblies: the selected one, and every candidate (with its MD5)
    my $as = $mr->{assembly} // {};
    for my $k ( sort keys %$as ) { $put->( assembly => "main.$k" => $as->{$k} ); }
    my $cand = ( $res->{select_main_assembly} // {} )->{candidates};
    my $altdir = getdir("out,results,assemblies,alternative_assemblies");
    if ( ref $cand eq 'ARRAY' ) {
        for my $c ( grep { ref $_ eq 'HASH' && defined $_->{assembler} } @$cand ) {
            my $a = $c->{assembler};
            $put->( assembly => "$a.$_" => $c->{$_} ) for grep { $_ ne 'assembler' } sort keys %$c;
            my ($f) = grep { -s $_ } ( "$altdir/$s->{name}.$a.fasta", "$altdir/$s->{name}.$a.fa" );
            $put->( assembly => "$a.md5" => md5_file($f) ) if $f;
        }
    }
    return \%fp;
}

## Everything that is not a result but decides results: tool and database
## versions, the effective configuration.
sub fingerprint_context {
    my %v;
    $v{pipeline} = $PIPELINE_VERSION;
    $v{pipeline_date} = $rundata{pipeline_info}{versiondate} if defined $rundata{pipeline_info}{versiondate};
    my $pr = $rundata{provenance}{run} // {};
    for my $t ( sort keys %{ $pr->{tools} // {} } ) {
        my $x = $pr->{tools}{$t};
        $v{"tool.$t"} = $x->{version} // "" if ref $x eq 'HASH';
    }
    for my $d ( sort keys %{ $pr->{databases} // {} } ) {
        my $x = $pr->{databases}{$d};
        next unless ref $x eq 'HASH';
        $v{"database.$d"} = join( " ", grep { defined $_ && $_ ne "" } $x->{version_label}, $x->{md5} );
    }
    my %set;
    my $enc = JSON::MaybeXS->new( canonical => 1 );
    for my $sec ( sort keys %{ $R_cfg // {} } ) {
        next unless ref $R_cfg->{$sec} eq 'HASH';
        for my $k ( sort keys %{ $R_cfg->{$sec} } ) {
            my $x = $R_cfg->{$sec}{$k};
            $set{"$sec.$k"} = ref $x ? $enc->encode($x) : ( $x // "" );
        }
    }
    $set{"run.overrides"} = $rundata{config}{overrides} // "";
    $set{"run.seal"} = ref $S_SEAL_RESULT eq 'HASH'
        ? join( " ", grep { defined $_ && $_ ne "" } $S_SEAL_RESULT->{status}, $S_SEAL_RESULT->{name} ) : "UNSEALED";
    return { versions => \%v, settings => \%set };
}

sub write_results_fingerprint {
    my $dir  = getdir("out,report,tables");
    my $file = "$dir/eurlc_results_fingerprint.json.gz";
    my %fp = (
        format           => "eurlc-wgs-results-fingerprint",
        format_version   => $S_FINGERPRINT_FORMAT_VERSION,
        created          => strftime( "%Y-%m-%dT%H:%M:%S", localtime ),
        run_name         => $rundata{pipeline_info}{run_name} // basename( getdir("out") ),
        pipeline_version => $PIPELINE_VERSION,
        context          => fingerprint_context(),
        samples          => {},
    );
    for my $s (@$R_samples) {
        my $fps = eval { fingerprint_sample($s) };
        if ( !$fps ) { log_message("WARNING: Fingerprint: sample $s->{name} skipped: $@", "yellow"); next; }
        $fp{samples}{ $s->{name} } = $fps;
    }
    require IO::Compress::Gzip;
    my $txt = JSON::MaybeXS->new( utf8 => 1, pretty => 1, canonical => 1 )->encode( \%fp );
    unless ( IO::Compress::Gzip::gzip( \$txt => "$file.part", Minimal => 1 ) && rename( "$file.part", $file ) ) {
        log_message("WARNING: cannot write [$file]", "yellow");
        unlink "$file.part";
        return;
    }
    return $file;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## Verification against a reference run (verify_reference=auto|off|<file>)
##
## auto: the newest reference/*.json(.gz) in the data folder or the folder
## above it (next to a validation dataset's documentation). The comparison
## (eurlc-wgs-inspect compare) goes to report/verification/, into the main
## report and the run summary. The reference is the fingerprint of an
## earlier run, copied there by hand: cp report/tables/eurlc_results_fingerprint.json.gz
## <dataset>/reference/<date>_<version>.json.gz

sub find_verification_reference {
    my $v = $R_cfg->{general}{verify_reference} // "auto";
    return "" if $v =~ /^(off|no|0|false)$/i;
    if ( $v !~ /^(auto|yes|1|on|true)$/i ) {
        my @f = -d $v ? glob("$v/*.json $v/*.json.gz") : ($v);
        @f = sort { ( CORE::stat($b) )[9] <=> ( CORE::stat($a) )[9] } grep { -s $_ } @f;
        log_message("WARNING: Verification: no reference fingerprint in [$v]", "yellow") unless @f;
        return $f[0] // "";
    }
    my $in = eval { abs_path( getdir("in") ) } // getdir("in");
    for my $d ( $in, dirname($in) ) {
        my @f = grep { -s $_ } glob("$d/reference/*.json $d/reference/*.json.gz");
        next unless @f;
        @f = sort { ( CORE::stat($b) )[9] <=> ( CORE::stat($a) )[9] || $b cmp $a } @f;
        return $f[0];
    }
    return "";
}

sub run_reference_verification {
    my ($fingerprint) = @_;
    %S_VERIFICATION = ();
    my $ref = find_verification_reference();
    return unless $ref ne "" && defined $fingerprint && -s $fingerprint;
    my $self = eval { abs_path($0) } // $0;
    my ($tool) = grep { -f $_ } ( dirname($self) . "/eurlc-wgs-inspect", dirname($self) . "/../scripts/eurlc-wgs-inspect" );
    $tool //= `command -v eurlc-wgs-inspect 2>/dev/null`;
    chomp $tool if defined $tool;
    unless ( defined $tool && $tool ne "" && -f $tool ) {
        log_message("WARNING: Verification reference found ($ref), but eurlc-wgs-inspect is not installed -- not compared", "yellow");
        return;
    }
    my $out = getdir("out,report") . "/verification";
    File::Path::make_path($out);
    my $expect = $R_cfg->{general}{verify_expect} // "";
    my @cmd = ( "python3", $tool, "compare", $ref, $fingerprint, "--out", $out,
                ( $expect ne "" ? ( "--expect", $expect ) : () ) );
    log_message("NOTICE: Verification: comparing the results with the reference run [" . basename($ref) . "]");
    my $txt = "";
    if ( open( my $p, '-|', @cmd ) ) { local $/; $txt = <$p> // ""; close $p; }
    my $rc = $? >> 8;
    log_message("INFO: Verification output:\n$txt");
    my $j = eval { read_json_file("$out/comparison.json") } // {};
    my $verdict = $j->{verdict} // ( $rc == 0 ? "NO UNEXPECTED DIFFERENCES" : "comparison could not be completed" );
    %S_VERIFICATION = ( reference => basename($ref), verdict => $verdict, same => ( $rc == 0 ? 1 : 0 ),
                        report => "$out/comparison.html" );
    $rundata{verification} = { %S_VERIFICATION };
    log_message( ( $rc == 0 ? "NOTICE" : "WARNING" ) . ": Verification against " . basename($ref) . ": $verdict -- report/verification/comparison.html",
                 $rc == 0 ? "green" : "yellow" );
}

sub get_verification_html_for_report {
    return "" unless %S_VERIFICATION;
    my $cls = $S_VERIFICATION{same} ? "seal-verified" : "seal-warning";
    my $txt = "Verification against the reference run " . encode_entities( $S_VERIFICATION{reference} // "" ) . ": <b>"
            . encode_entities( $S_VERIFICATION{verdict} // "" ) . "</b>";
    return <<"HTML";
<div class="seal-banner $cls">
  <span class="seal-icon">&#8644;</span>
  <span class="seal-label">$txt<br><small style='opacity:0.75'><a href="verification/comparison.html">Comparison</a> (per area and sample; also comparison.tsv)</small></span>
</div>
HTML
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## EFSA WGS System export (export_efsa=auto|off): scripts/eurlc-efsa-export
## writes results/export/efsa/ -- per sample the files of EFSA's programmatic
## submission, a check against EFSA's business rules (preflight.tsv), a
## manifest and upload_cli.sh. Nothing is sent. docs/eurlc-efsa-export.md.

sub run_efsa_export {
    %S_EFSA_EXPORT = ();
    my $g = $R_cfg->{general} // {};
    my $mode = $g->{export_efsa} // "off";
    return if $mode =~ /^(off|no|0|false)$/i;
    my %efsa_species = map { $_ => 1 } ( "Salmonella enterica", "Escherichia coli", "Listeria monocytogenes",
                                          "Campylobacter jejuni", "Campylobacter coli" );
    my $n = grep { $efsa_species{ $_->{main_results}{taxonomy}{species} // "" } } @$R_samples;
    return unless $n;
    my $self = eval { abs_path($0) } // $0;
    my ($tool) = grep { -f $_ } ( dirname($self) . "/eurlc-efsa-export", dirname($self) . "/../scripts/eurlc-efsa-export" );
    $tool //= `command -v eurlc-efsa-export 2>/dev/null`;
    chomp $tool if defined $tool;
    unless ( defined $tool && $tool ne "" && -f $tool ) {
        log_message("WARNING: EFSA export: eurlc-efsa-export is not installed -- no files for the EFSA WGS System", "yellow");
        return;
    }
    my $in   = eval { abs_path( getdir("in") ) } // getdir("in");
    my $meta = ( $g->{efsa_metadata} // "" ) ne "" ? $g->{efsa_metadata} : ( -f "$in/efsa_metadata.tsv" ? "$in/efsa_metadata.tsv" : "" );
    my $edir = ( $g->{efsa_dir} // "" ) ne "" ? $g->{efsa_dir} : ( peekdir("db") ? peekdir("db") . "/efsa_export" : "" );
    my $out  = getdir("out") . "/results/export/efsa";
    File::Path::make_path($out);
    # the run as it is now (in summarize mode, thresholds may have been changed since rundata.json was written)
    my $snap = "$out/.rundata_snapshot.json";
    save_hash_as_json( $snap, \%rundata );
    my @cmd = ( "python3", $tool, "export", getdir("out"), "--out", $out, "--rundata", $snap,
                ( $meta ne "" ? ( "--metadata", $meta ) : () ),
                ( $edir ne "" && -d $edir ? ( "--efsa-dir", $edir ) : () ),
                ( ( $g->{efsa_locus_suffix} // "" ) ne "" ? ( "--locus-suffix", $g->{efsa_locus_suffix} ) : () ),
                ( ( $g->{efsa_pipeline_tag} // "" ) ne "" ? ( "--pipeline-tag", $g->{efsa_pipeline_tag} )
                  : ( "--pipeline-tag", "EURLC-WGS $PIPELINE_VERSION"
                      . ( ref $S_SEAL_RESULT eq 'HASH' && $S_SEAL_RESULT->{name} ? " ($S_SEAL_RESULT->{name})" : "" ) ) ) );
    my $txt = "";
    if ( open( my $p, '-|', @cmd ) ) { local $/; $txt = <$p> // ""; close $p; }
    my $rc = $? >> 8;
    unlink $snap;
    log_message("INFO: EFSA export:\n$txt");
    my $j = eval { read_json_file("$out/summary.json") } // {};
    unless ( %$j ) {
        log_message("WARNING: EFSA export failed (exit $rc) -- see the log", "yellow");
        return;
    }
    my $ready = ( $j->{ready} // 0 ) + ( $j->{ready_with_warnings} // 0 );
    %S_EFSA_EXPORT = (
        stopped => $j->{stopped} // 0,
        text    => "$ready ready" . ( $j->{ready_with_warnings} ? " ($j->{ready_with_warnings} with warnings)" : "" )
                 . ( $j->{stopped} ? ", $j->{stopped} stopped by the checks" : "" ) . " -- results/export/efsa/",
    );
    $rundata{efsa_export} = { %$j };
    log_message( "NOTICE: EFSA export: $S_EFSA_EXPORT{text}", $S_EFSA_EXPORT{stopped} ? "yellow" : "green" );
}

## The folder of the validation dataset to use, or "" (validate=auto|off|<folder>).
sub find_validation_dataset {
    my $v = $R_cfg->{general}{validate} // "auto";
    return "" if $v =~ /^(off|no|0|false)$/i;
    my @cand = $v =~ /^(auto|yes|1|on|true)$/i
        ? do { my $in = eval { abs_path( getdir("in") ) } // getdir("in"); ( $in, dirname($in) ) }
        : ($v);
    for my $d (@cand) {
        next unless -d $d;
        my @p = glob("$d/*_validation_profile.yml $d/*_validation_profile.yaml");
        if ( @p > 1 ) {
            log_message("WARNING: Validation: more than one validation profile in [$d] -- not validated (give validate=<folder>)", "yellow");
            return "";
        }
        return $d if @p == 1;
    }
    log_message("WARNING: Validation: no *_validation_profile.yml in [$v]", "yellow") if $v !~ /^(auto|yes|1|on|true)$/i;
    return "";
}

## Runs eurlc-validate when a dataset is found; fills %S_VALIDATION.
sub run_dataset_validation {
    my ($observed) = @_;
    %S_VALIDATION = ();
    my $ds = find_validation_dataset();
    return unless $ds ne "" && defined $observed && -s $observed;

    my $self = eval { abs_path($0) } // $0;
    my ($validator) = grep { -f $_ } ( dirname($self) . "/eurlc-validate", dirname($self) . "/../scripts/eurlc-validate" );
    $validator //= `command -v eurlc-validate 2>/dev/null`;
    chomp $validator if defined $validator;
    unless ( defined $validator && $validator ne "" && -f $validator ) {
        log_message("WARNING: Validation dataset found in [$ds], but eurlc-validate is not installed -- not validated", "yellow");
        return;
    }
    my $out = getdir("out,report") . "/validation";
    File::Path::make_path($out);

    # raw-file MD5 sums, for the check against the dataset's file manifest
    my $md5 = "$out/fastq_md5.txt";
    if ( open( my $o, '>', $md5 ) ) {
        for my $f ( glob( getdir("out") . "/results/qc/stage1_rawdata/md5/*.txt" ) ) {
            open( my $i, '<', $f ) or next;
            print {$o} $_ while <$i>;
            close $i;
        }
        close $o;
    }
    # distance matrices, each at its schema's cluster threshold
    my @dist;
    my $mdir = getdir("out") . "/results/clustering/distance_matrices";
    for my $f ( sort glob("$mdir/*_distance_all.tsv") ) {
        my ($schema) = grep { basename($f) =~ /_\Q$_\E_distance_all\.tsv$/ } sort { length($b) <=> length($a) } keys %{ $R_cfg_schemas // {} };
        my $thr = get_clustering_default_threshold( { schema => $schema // "" } );
        push @dist, "--distances", "$f:$thr";
    }
    my $label = "EURLC-WGS $PIPELINE_VERSION" . ( ref $S_SEAL_RESULT eq 'HASH' && $S_SEAL_RESULT->{status}
                ? ", " . $S_SEAL_RESULT->{status} . ( $S_SEAL_RESULT->{name} ? " ($S_SEAL_RESULT->{name})" : "" ) : ", UNSEALED" );
    my @cmd = ( "python3", $validator, "--dataset", $ds, "--observed", $observed, @dist,
                ( -s $md5 ? ( "--fastq-md5", $md5 ) : () ), "--out", $out, "--label", $label );
    log_message("NOTICE: Validation: dataset found in [$ds] -- comparing the results with its expected results");
    my $txt = "";
    if ( open( my $p, '-|', @cmd ) ) { local $/; $txt = <$p> // ""; close $p; }
    my $rc = $? >> 8;
    log_message("INFO: Validation output:\n$txt");
    my $j = eval { read_json_file("$out/validation.json") } // {};
    my $verdict = $j->{meta}{verdict} // ( $rc == 0 ? "ALL REQUIRED CHECKS AGREE" : "validation could not be completed" );
    %S_VALIDATION = (
        dataset => $j->{meta}{dataset} // basename($ds), folder => $ds, verdict => $verdict,
        all_agree => ( $rc == 0 ? 1 : 0 ), report => "$out/validation_report.html",
    );
    $rundata{validation} = { %S_VALIDATION };
    log_message( ( $rc == 0 ? "NOTICE" : "WARNING" ) . ": Validation against $S_VALIDATION{dataset}: $verdict -- report/validation/validation_report.html",
                 $rc == 0 ? "green" : "yellow" );
}

## Banner for the main report when a validation was run.
sub get_validation_html_for_report {
    return "" unless %S_VALIDATION;
    my $cls = $S_VALIDATION{all_agree} ? "seal-verified" : "seal-warning";
    my $txt = "Validation against " . encode_entities( $S_VALIDATION{dataset} // "" ) . ": <b>"
            . encode_entities( $S_VALIDATION{verdict} // "" ) . "</b>";
    return <<"HTML";
<div class="seal-banner $cls">
  <span class="seal-icon">&#10003;</span>
  <span class="seal-label">$txt<br><small style='opacity:0.75'><a href="validation/validation_report.html">Validation report</a> (per sample and check; also validation_results.tsv)</small></span>
</div>
HTML
}

# Banner for the main HTML report (resumed runs only).
sub get_resume_html_for_report {
    return "" unless $S_RUN_MODE eq "resumed";
    my %steps; my $n_samples = 0;
    for my $s (@$R_samples) {
        my $l = $s->{results}{run_history}{reused_steps} or next;
        next unless @$l;
        $n_samples++;
        $steps{$_}++ for @$l;
    }
    my $rerun = $R_cfg->{general}{rerun} // "";
    my $txt = "Resumed run (#$S_RUN_NUMBER in this output directory)"
            . ( $rerun =~ /\S/ ? " &mdash; rerun: <b>" . encode_entities($rerun) . "</b>" : "" );
    my $detail = %steps
        ? "Results reused from earlier run(s) for $n_samples sample(s): " . encode_entities( join(", ", sort keys %steps) )
          . ". Program and database versions of earlier runs: log/previous_runs/."
        : "No earlier results were reused.";
    if ( my $mv = $rundata{provenance}{run}{data_relocation} ) {
        $detail .= "<br>The analysis has been moved: raw data read from <b>" . encode_entities( $mv->{to} // "" )
                 . "</b> (analysed at " . encode_entities( join(", ", @{ $mv->{from} // [] }) ) . "); "
                 . ( $mv->{md5_verified} // 0 ) . " of " . ( $mv->{files} // 0 ) . " file(s) checked against their recorded MD5.";
    }
    return <<"HTML";
<div class="seal-banner seal-warning">
  <span class="seal-icon">&#8635;</span>
  <span class="seal-label">$txt<br><small style='opacity:0.75'>$detail</small></span>
</div>
HTML
}

#########################################################################################################
# Resume mode: keep the existing output directory; every runstep's
# preprocessing finds its existing result file and goes straight to
# result_parsing, so only missing steps are run. (overwrite=extend is the
# older name and is normalised to "resume" at startup.)
sub is_resume_mode {
    my $ow = lc( $R_cfg->{general}{overwrite} // "" );
    return ( $ow eq "resume" || $ow eq "extend" ) ? 1 : 0;
}

###################################################################################################
## Parallel scheduler
##
## Activated when general.parallel_mode = "on". Replaces the per-sample
## loop (which calls run_data_driven_runsteps per sample) with a single
## event loop that dispatches ready (sample, runstep) pairs from multiple
## samples simultaneously, subject to the resource budget.
##
## The batch phase (sort_assemblies, checkm, chewbbaca, multiqc) always
## runs sequentially AFTER all per-sample work is done -- regardless of
## parallel_mode. The existing run_data_driven_batch_runsteps() is called
## unmodified for that.
##
## Key data structures:
##   %S_par_active   -- currently-running jobs, keyed by child PID
##   $S_par_threads  -- threads currently committed
##   $S_par_ram_gb   -- RAM (GB) currently committed
##   %S_par_done     -- "$i,$name" set of completed (sample,runstep) pairs
##   %S_par_next_idx -- per-sample index into $runstep_names (next to try)

# Renders the live status board to stdout using ANSI escape codes.
# Called every poll tick while jobs are active. No-op when stdout is not
# a TTY (CI, background, piped).
sub _par_render_status_board {
    my (%args) = @_;
    return unless -t STDOUT;

    my $active_jobs  = $args{active_jobs}  // {};
    my $done         = $args{done}         // 0;
    my $total        = $args{total}        // 1;
    my $samples_done = $args{samples_done} // 0;
    my $samples_total= $args{samples_total}// scalar(@$R_samples);
    my $start_time   = $args{start_time}   // time();
    my $board_lines  = $args{board_lines}  // 0;
    my $done_lines   = $args{done_lines}   // [];

    # Move cursor up to overwrite the board from the previous tick
    print "\r\e[${board_lines}A\e[J" if $board_lines > 0;

    # Print any completed-step lines ABOVE the new board, in the scrollback
    for my $line (@$done_lines) {
        print "$line\n";
    }

    my $elapsed = format_elapsed(time() - $start_time);
    my $pct     = $total > 0 ? int(100 * $done / $total) : 0;
    my $bar_w   = 30;
    my $filled  = int($bar_w * $pct / 100);
    my $bar     = ('█' x $filled) . ('░' x ($bar_w - $filled));

    my $cols = (-t STDOUT) ? ((GetTerminalSize())[0] || 80) : 80;
    my $sep  = '━' x ($cols > 4 ? $cols - 2 : 78);

    my $headroom = $R_cfg->{general}{parallel_headroom} // 0.85;
    my $max_t    = $S_max_threads ? int($S_max_threads * $headroom) : '?';
    my $max_r    = $S_max_ram_gb  ? int($S_max_ram_gb  * $headroom) : '?';

    print "$sep\n";
    printf " eurlc-wgs  |  parallel  |  elapsed: %-10s%s\n", $elapsed,
        $args{paused}
            ? "  |  \x1b[33mPAUSED " . format_elapsed(time() - ($args{paused_since} // time())) . "\x1b[0m"
            : "";
    printf " Progress:  %s %3d%%  (%d/%d steps)\n", $bar, $pct, $done, $total;
    my $warn_str = $S_par_warning_count > 0
        ? "  \x1b[33m\x{26a0} $S_par_warning_count warning(s)\x1b[0m"
        : "";
    printf " Samples:   %d/%d complete  |  Resources: %s/%s threads  %s/%sGB RAM%s\n",
        $samples_done, $samples_total,
        $args{cur_threads} // 0, $max_t,
        $args{cur_ram}     // 0, $max_r,
        $warn_str;
    print "$sep\n";

    my $new_board_lines = 5;

    for my $pid (sort { $a <=> $b } keys %$active_jobs) {
        my $job = $active_jobs->{$pid};
        my $job_elapsed = format_elapsed(time() - ($job->{start_time} // time()));
        printf "  %-10s  %-22s  %s  [%dt %dGB]\n",
            $R_samples->[$job->{sample}]{name} // "?",
            $job->{runstep} // "?",
            $job_elapsed,
            $job->{threads} // 0,
            $job->{ram_gb}  // 0;
        $new_board_lines++;
    }

    print "$sep\n";
    $new_board_lines++;

    # Return only the height of the live board. Done-lines were printed
    # above it and must stay in the scrollback; counting them here made the
    # next tick's cursor-up overshoot and erase them again.
    # NOTE: this count is only correct if NOTHING else writes to the
    # terminal between two renders -- run_parallel_runsteps guarantees that
    # by capturing log_message/warn output and redirecting child output.
    return $new_board_lines;
}

# The parallel per-sample scheduler. Drives the full per-sample phase;
# the batch phase is not touched.
sub run_parallel_runsteps {
    my ($runstep_names, $applicability) = @_;

    my $headroom      = $R_cfg->{general}{parallel_headroom} // 0.85;
    my $thread_budget = $S_max_threads * $headroom;
    my $ram_budget    = $S_max_ram_gb  * $headroom;
    my $total_work    = $applicability->{total};

    $S_par_warning_count = 0;   # reset for this run
    @S_par_warnings      = ();

    %S_par_active = ();    # pid -> { sample, runstep, threads, ram_gb, start_time } (package var, A2)
    my $S_par_threads = 0;
    my $S_par_ram_gb  = 0;
    my %S_par_done;           # "$i,$name" = 1
    my %S_samples_completed;  # $i = 1, prevents double-counting samples_done
    my $idle_ticks_without_dispatch = 0;  # deadlock detector
    my $done_count    = 0;
    my $samples_done  = 0;
    my $board_lines   = 0;
    my $start_time    = time();
    my @done_lines    = ();   # buffered done-lines, printed above the board

    # Track which samples still have pending work
    my %samples_pending = map { $_ => 1 } 0 .. $#$R_samples;

    # Can this data key still be produced for sample $i? See
    # key_unreachable_reason (shared with the sequential scheduler, A9).
    my $key_unreachable = sub { key_unreachable_reason( $_[0], $_[1], $runstep_names ) ? 1 : 0 };

    # While the live board is on screen, every line written to the terminal
    # that the renderer does not know about shifts the board down, so the
    # next cursor-up lands too low and the top of the old board is left
    # behind as a stale "elapsed:" line. Route all parent-side screen output
    # through the board for the whole loop (not just result_parsing):
    #   log_message -> ERROR shown above the board, WARNING counted, rest log-only
    #   Perl warn() -> shown above the board
    # Child processes get their stdout/stderr redirected at fork (below).
    my $board_tty = -t STDOUT;
    my $saved_warn_handler = $SIG{__WARN__};
    local $S_par_log_capture = $board_tty ? \@done_lines : undef;
    local $SIG{__WARN__} = $board_tty
        ? sub { (my $w = shift) =~ s/\s+\z//; push @done_lines, "WARNING (perl): $w"; }
        : $saved_warn_handler;

    # Time limits: same rule as sequential mode (get_runstep_timeout). A job
    # over its limit gets TERM to its whole process group, KILL 5 s later if
    # still alive; it is then reaped like any other job.
    my $enforce_time_limits = sub {
        my $now = time();
        for my $pid ( keys %S_par_active ) {
            my $job = $S_par_active{$pid};
            if ( $job->{killed_at} ) {
                if ( !$job->{hard_killed} && $now - $job->{killed_at} >= 5 ) {
                    kill 'KILL', -$pid;
                    $job->{hard_killed} = 1;
                }
                next;
            }
            next unless $job->{timeout_s} && $now - $job->{start_time} >= $job->{timeout_s};
            $job->{timed_out} = 1;
            $job->{killed_at} = $now;
            log_message("ERROR: Timeout after " . format_elapsed($job->{timeout_s}) . ": [$job->{runstep}] for sample ["
                      . ( $R_samples->[ $job->{sample} ]{name} // '?' ) . "] -- killing the process", "red");
            kill 'TERM', -$pid;
        }
    };

    # Use of the budget (B24, measurement only): time-weighted threads and
    # RAM in use, and how long dispatch stood blocked because the first
    # ready step did not fit (and by which step). Not counted while paused.
    my %use = ( t0 => time(), last => time(), elapsed => 0, threads => 0, ram => 0, blocked => 0, blocked_by => {} );
    my $blocked_by;   # step that blocked dispatch in the previous tick
    my $account_use = sub {
        my $now = time();
        my $dt  = $now - $use{last};
        $use{last} = $now;
        return if $S_paused || $dt <= 0;
        $use{elapsed} += $dt;
        $use{threads} += $S_par_threads * $dt;
        $use{ram}     += $S_par_ram_gb  * $dt;
        if ( defined $blocked_by ) { $use{blocked} += $dt; $use{blocked_by}{$blocked_by} += $dt; }
    };

    while ( %samples_pending || %S_par_active ) {

        $account_use->();

        # ── 0. Time limits ─────────────────────────────────────────────
        $enforce_time_limits->();

        # ── 1. Reap finished children ──────────────────────────────────
        for my $pid (keys %S_par_active) {
            my $w = waitpid($pid, POSIX::WNOHANG());
            next unless $w > 0;
            my $exit_status = $?;

            my $job = delete $S_par_active{$pid};
            $S_par_threads -= $job->{threads};
            $S_par_ram_gb  -= $job->{ram_gb};
            $S_par_threads  = 0 if $S_par_threads < 0;
            $S_par_ram_gb   = 0 if $S_par_ram_gb  < 0;

            my $i    = $job->{sample};
            my $name = $job->{runstep};
            my $def  = $runstep{$name};

            # Exit status, reported like execute_and_log does in sequential mode.
            my $job_status = 'success';
            my $known_fail = ( $job->{timed_out} || !$exit_status ) ? "" : sample_known_data_fail($i);
            if ( $job->{timed_out} ) {
                $job_status = 'timeout';
                set_runtime_issue($i, "warning", "[$name] stopped: time limit (" . format_elapsed($job->{timeout_s}) . ") reached", $name);
                set_aside_timed_out_result($name, $i, $job->{start_time});
                push @{ $R_samples->[$i]{failed_steps} }, { runstep => $name, reason => "timeout" };
            }
            elsif ( $known_fail ne "" ) {
                # The data had already failed: a consequence, recorded as a note.
                $job_status = 'failed';
                my $why = ( $exit_status & 127 ) ? "signal " . ( $exit_status & 127 ) : "exit code " . ( $exit_status >> 8 );
                set_aside_partial_result($name, $i, $job->{start_time}, "failed");
                note_expected_step_failure( $i, $name, $why, $known_fail );
            }
            elsif ( $exit_status & 127 ) {
                $job_status = 'failed';
                log_message("ERROR: [$name] for sample [" . ( $R_samples->[$i]{name} // '?' ) . "] died with signal " . ( $exit_status & 127 ), "red");
            }
            elsif ( $exit_status >> 8 ) {
                $job_status = 'failed';
                log_message("ERROR: [$name] for sample [" . ( $R_samples->[$i]{name} // '?' ) . "] exited with code " . ( $exit_status >> 8 ), "red");
            }
            if ( $job_status eq 'failed' && $known_fail eq "" ) {
                my $why = ( $exit_status & 127 ) ? "signal " . ( $exit_status & 127 ) : "exit code " . ( $exit_status >> 8 );
                push @{ $R_samples->[$i]{failed_steps} }, { runstep => $name, reason => $why };
                set_runtime_issue($i, "warning", "[$name] failed ($why)", $name);
                set_aside_partial_result($name, $i, $job->{start_time}, "failed");
            }

            # result_parsing in the parent -- runs synchronously in the
            # reap cycle. Many result_parsing subs call log_message which
            # would print to stdout and corrupt the board rendering. Capture
            # those log lines into @done_lines so the renderer handles them.
            {
                local $S_par_log_capture = \@done_lines;
                eval { $def->{result_parsing}->($i) } if $def;
            }
            if ($@) {
                (my $err = $@) =~ s/\n/ /g;
                push @done_lines, "ERROR: [PIPELINE BUG] result_parsing crashed in [$name] sample [" . ($R_samples->[$i]{name}//'') . "]: $err";
            }

            $S_par_done{"$i,$name"} = 1;
            $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;
            $done_count++;

            my $elapsed = format_elapsed(time() - $job->{start_time});
            my $sample_name = $R_samples->[$i]{name} // "sample $i";
            # In parallel mode with a TTY, done-lines are suppressed --
            # they flash past too fast to read and cause the board to jump.
            # The progress bar shows advancement; the log file has the full
            # record. Without a TTY (CI, pipe) we still emit them since
            # there's no board to disrupt.
            log_message("NOTICE: $sample_name: $name done ($elapsed)") unless -t STDOUT;

            emit_runstep_event('runstep_finished', $i, $name,
                       status => $job_status, exit_code => ( $exit_status & 127 ) ? undef : ( $exit_status >> 8 ),
                       elapsed_s => sprintf("%.1f", time() - $job->{start_time}) + 0);

            # Re-check sample completion now that this step is done.
            # A sample is complete when every runstep is either already done
            # OR not applicable (applies_if returns false at runtime -- may
            # differ from the startup precompute since some applies_if
            # depend on data produced during the run, e.g. species).
            my $sample_complete = 1;
            for my $n (@$runstep_names) {
                next if $S_par_done{"$i,$n"};
                next if grep { $_->{sample} == $i && $_->{runstep} eq $n } values %S_par_active;
                my $def_n = $runstep{$n};
                next unless defined $def_n;
                my $applies = eval { exists $def_n->{applies_if} ? $def_n->{applies_if}->($i) : 1 };
                $applies = 0 if $applies && !runstep_species_applies($def_n, $i);
                if ($applies) {
                    $sample_complete = 0;
                    last;
                }
                # Not applicable at runtime -- mark done so we don't revisit
                $S_par_done{"$i,$n"} = 1;
                $total_work-- if $applicability->{applicable}{"$i,$n"} && $total_work > $done_count;
            }
            if ($sample_complete) {
                delete $samples_pending{$i};
                $samples_done++ unless $S_samples_completed{$i}++;
            }
        }

        # ── 2. Dispatch new work ───────────────────────────────────────
        my $dispatched_this_tick = 0;
        $blocked_by = undef;

        # While paused (control channel), running jobs finish normally but
        # nothing new is started.
        SAMPLE: for my $i ( $S_paused ? () : sort { $a <=> $b } keys %samples_pending ) {

            # Abandoned sample (fatal_error): let its running jobs finish,
            # then close it like the sequential scheduler does (A9).
            if ( $R_samples->[$i]{fatal_error} ) {
                next SAMPLE if grep { $_->{sample} == $i } values %S_par_active;
                unless ( $R_samples->[$i]{_fatal_error_logged} ) {
                    my $reason = join("; ", @{ $R_samples->[$i]{fatal_error_message} // [] });
                    log_message("WARNING: Sample " . ( $R_samples->[$i]{name} // $i ) . ": stopping further analysis -- $reason", "red");
                    emit_event(type => 'sample_abandoned', sample => $i, reason => $reason);
                    $R_samples->[$i]{_fatal_error_logged} = 1;
                }
                delete $samples_pending{$i};
                $samples_done++ unless $S_samples_completed{$i}++;
                next SAMPLE;
            }

            # Scan the full runstep list every tick -- dispatch as many
            # ready steps as resources allow before moving on to the next
            # sample. This enables mlst+fastmlst+quast+remap to all be
            # dispatched in one tick once the assembly is done.
            # Steps already active for this sample are skipped (the
            # active-jobs grep below handles that).
            RUNSTEP: for my $name (@$runstep_names) {

                next if $S_par_done{"$i,$name"};
                next if grep { $_->{sample} == $i && $_->{runstep} eq $name } values %S_par_active;

                my $def = $runstep{$name};
                next unless defined $def;

                # applies_if
                my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
                if ($@) {
                    (my $err = $@) =~ s/\n/ /g;
                    log_message("ERROR: [PIPELINE BUG] applies_if crashed in [$name] sample [${\($R_samples->[$i]{name}//'')}]: $err -- skipping", "red");
                    next RUNSTEP;
                }
                # species field: runtime match against the detected taxonomy
                # (answers 1 while species is still unknown -- the implicit
                # species_determined requires below holds the step back).
                $applies = 0 if $applies && !runstep_species_applies($def, $i);
                unless ($applies) {
                    $S_par_done{"$i,$name"} = 1;
                    # Counted as applicable at startup but turned out not to
                    # apply (e.g. wrong species) -- shrink the denominator so
                    # the progress bar can reach 100%.
                    $total_work-- if $applicability->{applicable}{"$i,$name"} && $total_work > $done_count;
                    next RUNSTEP;
                }

                # requires
                my @unmet = grep { !( exists $data_key{$_} && eval { $data_key{$_}{check}->($i) } ) } @{ $def->{requires} // [] };
                if (@unmet) {
                    # Never coming (an earlier step failed): skip now instead
                    # of waiting for the deadlock detector (A9). Marked as
                    # attempted, so steps depending on this one settle too.
                    unless ( grep { !$key_unreachable->($_, $i) } @unmet ) {
                        $S_par_done{"$i,$name"} = 1;
                        $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;
                        $total_work-- if $applicability->{applicable}{"$i,$name"} && $total_work > $done_count;
                        note_skipped_step($i, $name, \@unmet, $runstep_names);
                        next RUNSTEP;
                    }
                    next RUNSTEP;   # not yet -- try other steps
                }

                # Resource check
                my $res    = get_runstep_resources($name);
                my $need_t = $res->{threads};
                my $need_r = $res->{ram_gb};

                # Allow dispatch if this would be the only running job
                # (prevents deadlock when a single step exceeds the budget).
                my $is_only = !%S_par_active;

                unless ($is_only || ($S_par_threads + $need_t <= $thread_budget
                                  && $S_par_ram_gb  + $need_r <= $ram_budget)) {
                    # Resources exhausted -- stop dispatching for all samples
                    # this tick. (Other samples might fit smaller steps, but
                    # keeping it simple avoids starvation issues; whether the
                    # idle capacity matters is measured, see %use / B24.)
                    $blocked_by = $name;
                    last SAMPLE;
                }

                # preprocessing
                my $command = eval { $def->{preprocessing}->($i) };
                if ($@) {
                    (my $err = $@) =~ s/\n/ /g;
                    log_message("ERROR: [PIPELINE BUG] preprocessing crashed in [$name]: $err -- skipping", "red");
                    $S_par_done{"$i,$name"} = 1;
                    $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;
                    next RUNSTEP;
                }

                # Empty command: step handled internally by preprocessing
                # (e.g. "already done" path calls result_parsing itself).
                if (!defined $command || $command eq "") {
                    note_if_reused($i, $name);
                    $S_par_done{"$i,$name"} = 1;
                    $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;
                    $done_count++;
                    next RUNSTEP;
                }

                # fork
                emit_runstep_event('runstep_started', $i, $name);
                log_message("INFO: Dispatching [$name] for sample [${\($R_samples->[$i]{name}//'?')}] (${need_t}t/${need_r}GB)");

                my $pid = fork();
                if (!defined $pid) {
                    log_message("ERROR: Fork failed for [$name]: $!", "red");
                    $S_par_done{"$i,$name"} = 1;
                    $S_RUNSTEP_ATTEMPTED{"$i,$name"} = 1;
                    next RUNSTEP;
                }

                if ($pid == 0) {
                    POSIX::setpgid(0, 0);
                    # Keep the child off the terminal while the board is
                    # live: its log_message calls go to the log file only,
                    # and any raw stdout/stderr (internal subs, tools that
                    # print despite their own redirects) goes to the bash
                    # log. Lines the board does not count would leave
                    # stale board fragments behind.
                    if ($board_tty) {
                        $S_par_log_capture = [];
                        my $sink = $log_fh_bash // $log_fh;
                        if ($sink) {
                            open(STDOUT, '>&', $sink);
                            open(STDERR, '>&', $sink);
                        } else {
                            open(STDOUT, '>', '/dev/null');
                            open(STDERR, '>', '/dev/null');
                        }
                    }
                    # SUB\t... commands are internal Perl subs -- exec bash
                    # can't handle them. Call _run_internal_sub directly,
                    # exactly as execute_and_log does in sequential mode.
                    my ($subname, @subargs) = _parse_internal_cmd($command);
                    if (defined $subname) {
                        my $rc = _run_internal_sub($subname, @subargs);
                        STDOUT->flush; STDERR->flush; $log_fh->flush if $logfile_open && $log_fh;
                        POSIX::_exit($rc & 255);   # no END blocks in the child (B23)
                    }
                    exec("bash", "-c", $command) or POSIX::_exit(127);
                }

                POSIX::setpgid($pid, $pid);

                $S_par_active{$pid} = {
                    sample     => $i,
                    runstep    => $name,
                    threads    => $need_t,
                    ram_gb     => $need_r,
                    start_time => time(),
                    timeout_s  => get_runstep_timeout($name),
                };
                $S_par_threads += $need_t;
                $S_par_ram_gb  += $need_r;
                $dispatched_this_tick++;
                $idle_ticks_without_dispatch = 0;
                # No last RUNSTEP -- continue scanning for more ready steps
                # for this sample (e.g. mlst+fastmlst+quast+remap in parallel)
            }
        }

        # ── 3. Control channel ─────────────────────────────────────────
        process_control_commands();
        if ($S_terminate) {
            # Clear the board and stop capturing so the notice is visible.
            print "\r\e[${board_lines}A\e[J" if $board_tty && $board_lines > 0;
            print "$_\n" for @done_lines;
            @done_lines = ();
            $board_lines = 0;
            $S_par_log_capture = undef;
            log_message("NOTICE: Parallel scheduler: terminate command received -- no new work dispatched", "red");
            # Wait for active jobs to finish -- time limits still apply, so a
            # hung tool cannot block the stop forever.
            while (%S_par_active) {
                $enforce_time_limits->();
                for my $pid ( keys %S_par_active ) {
                    delete $S_par_active{$pid} if waitpid($pid, POSIX::WNOHANG()) > 0;
                }
                select(undef, undef, undef, 0.5) if %S_par_active;
            }
            close_logfile();
            exit 6;   # stopped on request (A15)
        }

        # ── 4. Status board + sleep ────────────────────────────────────
        $board_lines = _par_render_status_board(
            active_jobs   => \%S_par_active,
            done          => $done_count,
            total         => $total_work,
            samples_done  => $samples_done,
            samples_total => scalar(@$R_samples),
            start_time    => $start_time,
            board_lines   => $board_lines,
            cur_threads   => $S_par_threads,
            cur_ram       => $S_par_ram_gb,
            done_lines    => \@done_lines,
            paused        => $S_paused,
            paused_since  => $S_paused_since,
        );
        @done_lines = ();   # consumed by renderer

        if (%S_par_active) {
            select(undef, undef, undef, 0.5);
        }
        elsif (%samples_pending && $S_paused) {
            # Paused with nothing running: just wait for resume/terminate.
            # Must not count towards the deadlock detector below.
            $idle_ticks_without_dispatch = 0;
            select(undef, undef, undef, 0.5);
        }
        elsif (%samples_pending) {
            # No active jobs but still pending samples -- either waiting for
            # a requires to be satisfied (normal, short wait) or genuinely
            # deadlocked (requires will never be satisfied). Either way, sleep
            # briefly to avoid burning CPU.
            $idle_ticks_without_dispatch++;

            if ($idle_ticks_without_dispatch >= 10) {
                # 5s with no progress -- probably deadlocked. Log what's stuck
                # and force-complete the pending samples to unblock the batch phase.
                log_message("WARNING: Parallel scheduler: no progress for ${idle_ticks_without_dispatch} idle ticks -- checking for deadlock", "red");
                for my $i (sort keys %samples_pending) {
                    my $sname = $R_samples->[$i]{name} // "sample $i";
                    my @stuck;
                    for my $name (@$runstep_names) {
                        next if $S_par_done{"$i,$name"};
                        next if grep { $_->{sample} == $i && $_->{runstep} eq $name } values %S_par_active;
                        my $def = $runstep{$name};
                        next unless defined $def;
                        my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
                        next unless $applies && runstep_species_applies($def, $i);
                        # Check which requires are unsatisfied
                        for my $key (@{ $def->{requires} // [] }) {
                            unless (exists $data_key{$key} && eval { $data_key{$key}{check}->($i) }) {
                                push @stuck, "[$name] waiting for [$key]";
                            }
                        }
                    }
                    if (@stuck) {
                        log_message("WARNING: Sample [$sname] deadlocked on: " . join(", ", @stuck)
                                  . " -- this should not happen; please report it as a pipeline bug", "red");
                        # Force-complete this sample to unblock the batch phase
                        delete $samples_pending{$i};
                        $samples_done++ unless $S_samples_completed{$i}++;
                    } else {
                        # No stuck steps -- sample is actually done
                        delete $samples_pending{$i};
                        $samples_done++ unless $S_samples_completed{$i}++;
                    }
                }
                $idle_ticks_without_dispatch = 0;
            }

            select(undef, undef, undef, 0.5);
        }
    }

    # B24: store the budget use for the run summary and run_status.json.
    $account_use->();
    if ( $use{elapsed} > 0 ) {
        my ($top) = sort { $use{blocked_by}{$b} <=> $use{blocked_by}{$a} } keys %{ $use{blocked_by} };
        $rundata{parallel_use} = {
            seconds         => sprintf( "%.0f", $use{elapsed} ) + 0,
            thread_budget   => sprintf( "%.1f", $thread_budget ) + 0,
            ram_budget_gb   => sprintf( "%.1f", $ram_budget ) + 0,
            threads_pct     => $thread_budget > 0 ? sprintf( "%.0f", 100 * $use{threads} / ( $thread_budget * $use{elapsed} ) ) + 0 : undef,
            ram_pct         => $ram_budget    > 0 ? sprintf( "%.0f", 100 * $use{ram}     / ( $ram_budget    * $use{elapsed} ) ) + 0 : undef,
            blocked_pct     => sprintf( "%.0f", 100 * $use{blocked} / $use{elapsed} ) + 0,
            blocked_by      => { map { $_ => sprintf( "%.0f", $use{blocked_by}{$_} ) + 0 } keys %{ $use{blocked_by} } },
            mostly_blocked_by => $top,
        };
        log_message( "INFO: " . parallel_use_text() );
    }

    # Final board clear, then hand the terminal back to normal logging
    print "\r\e[${board_lines}A\e[J" if -t STDOUT && $board_lines > 0;
    print "$_\n" for @done_lines;
    @done_lines = ();
    $S_par_log_capture = undef;
    $SIG{__WARN__} = $saved_warn_handler;

    my $total_elapsed = format_elapsed(time() - $start_time);
    log_message("NOTICE: Parallel phase complete: $done_count steps across " . scalar(@$R_samples) . " samples ($total_elapsed)", "green");

    # Surface any warnings that were suppressed during result_parsing cycles.
    # These were counted/stored but not shown on screen to keep the board
    # stable. Print them now so nothing is silently lost before the batch
    # phase begins. Full text is always in the log file regardless.
    # They are already collected in @S_RUN_ISSUES and listed in the run
    # summary at the end, so only say how many there were here.
    if (@S_par_warnings) {
        log_message("NOTICE: " . scalar(@S_par_warnings) . " warning(s) during parallel execution -- listed in the run summary at the end", "yellow");
    }
}



