####################################################################################################
sub get_mashscreen_species(){
  
  my $i = shift(@_);

  # Use the already-resolved path from postprocess_mash_screen() rather than
  # reconstructing it (previously hardcoded to a developer machine path with
  # the wrong file extension, which silently produced empty results for
  # everyone else). txt_sorted is stored relative to the out-directory (used
  # for report links), so rejoin it with the out-dir root for actual file I/O.
  my $mash_sorted_rel  = $R_samples->[$i]{results}{mash_screen}{txt_sorted} // "";
  my $mash_sorted_path = $mash_sorted_rel ne "" ? File::Spec->catfile(getdir("out"), $mash_sorted_rel) : "";
 
if( -f $mash_sorted_path) {  
open(HANDLE_INFILE,"$mash_sorted_path") || graceful_die("could not open file $mash_sorted_path");

my %results_shared = ();
my %results_identity = ();
my %results_hitscore = ();

while(<HANDLE_INFILE>){
   my $line = $_;
   chomp($line);
   if($line =~ /\t/ ){
      my @columns = split(/\t/,$line);
      my $hitscore = $columns[0];
      my $hit = $columns[1];
      my $identity = $columns[2];
      my $shared_hashes = $columns[3];
      my $outof = $columns[4];
      my $multiplicity = $columns[5];
      my $pval = $columns[6];
      
      if($hitscore ne "Hitscore(Ident*Shared)" && $outof>0){
        my $shared_hashes_percent =  $shared_hashes/$outof;
     
        if (! exists( $results_shared{$hit}) && $hit !~ /-\(/) { 
           $results_shared{$hit} = $shared_hashes_percent;
           $results_identity{$hit} = $identity;
           $results_hitscore{$hit} = $hitscore;
        }
      }
     } # if tab


} # end while
  

    my $count = 0;
   foreach my $taxname (sort { $results_hitscore{$b} <=> $results_hitscore{$a} } keys %results_hitscore) {
    $count++;
    if($count==1){   return $taxname; }

  }
      


close(HANDLE_INFILE);
} # end if file  
else{
    return "";
}
}

