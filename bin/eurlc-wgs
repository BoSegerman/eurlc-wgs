## runstep fastqc_trimmed_data

$runstep_name = "fastqc_trimmed_data";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Running FastQC on trimmed+downsampled data...",
      long_name  => "FastQC on trimmed data",
      output_dir => "__DIR-QC2__/FastQC_trimmed_data",
      # Output names guaranteed by symlink approach -- see cmd_template.
      # PE: <outdir>/<sample>_R1_fastqc.zip + <sample>_R2_fastqc.zip
      # SE: <outdir>/<sample>_SE_fastqc.zip
      resultfile => "__DIR-QC2__/FastQC_trimmed_data/__BASE___R1_fastqc.zip",
      resultfiles_status => "NA",

      requires   => [ 'trimmed_downsampled_fastq' ],
      produces   => [ 'fastqc_trimmed_data_done' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} eq 'FASTA';
          return ($R_cfg->{fastqc_trimmed_data}{enabled} || $R_cfg->{fastqc}{rerun}) ? 1 : 0;
      },
};

# TEMPLATES---------------------------------
# Symlink approach: create a temp symlink with a controlled name so FastQC's
# output filename is predictable regardless of the TD file's actual name.

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<'CMD');
    ln -sf '__R1TD__' '__OUTDIR__/__BASE___R1.fastq.gz'
    __NEWCOMMAND__
    ln -sf '__R2TD__' '__OUTDIR__/__BASE___R2.fastq.gz'
    __NEWCOMMAND__
    conda run -n __FASTQCENV__ --no-capture-output fastqc
       -t __THREADS__
       -o __OUTDIR__
       '__OUTDIR__/__BASE___R1.fastq.gz'
       '__OUTDIR__/__BASE___R2.fastq.gz'
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -f '__OUTDIR__/__BASE___R1.fastq.gz' '__OUTDIR__/__BASE___R2.fastq.gz'
CMD

$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<'CMD');
    ln -sf '__SETD__' '__OUTDIR__/__BASE___SE.fastq.gz'
    __NEWCOMMAND__
    conda run -n __FASTQCENV__ --no-capture-output fastqc
       -t __THREADS__
       -o __OUTDIR__
       '__OUTDIR__/__BASE___SE.fastq.gz'
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    rm -f '__OUTDIR__/__BASE___SE.fastq.gz'
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = "";

# TEST---------------------------------
