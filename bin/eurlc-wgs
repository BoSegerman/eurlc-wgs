      long_name  => "Quast",
      output_dir => "__DIR-QC3__/quast",
      resultfile => "__DIR-QC3__/quast/__BASE__/report.txt",
      alt_resultfile => "__DIR-QC3__/quast/alternative_assemblies/__BASE__-__ASSEMBLER__/report.txt",
      resultfiles_status => "NA",
};

# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{main} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{quast}->{env} --no-capture-output quast.py
       '__DIR-ASSEMBLIES__/__BASE__.fasta'
       -o '__OUTDIR__/__BASE__'
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{alternative} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{quast}->{env} --no-capture-output quast.py
       '__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.__ASSEMBLER__.fasta'
       -o '__OUTDIR__/alternative_assemblies/__BASE__-__ASSEMBLER__'
       __HIDE-OUTPUT__
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_quast;

sub test_quast {

   return check_conda_tool("quast");

}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_quast;


sub preprocess_quast {

    my ($samplenr) = @_;

    my $runstep_name = "quast";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $main_command         = $runstep{$runstep_name}{cmd_template}{main};
    my $alt_command_template = $runstep{$runstep_name}{cmd_template}{alternative};

    my $resultfile              = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    my @commands;
    my $expected_results = 0;
    my $all_expected_results_present = 1;

    # Main assembly
    my $main_assembly = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name);
    if (-f $main_assembly) {
        $expected_results++;
        if (!-f $resultfile) {
            $all_expected_results_present = 0;
            push @commands, $main_command;
        }
    }

    # Alternative assemblies
    if ($sample_type ne "FASTA") {
        foreach my $ambl (@assemblers) {
            next unless $R_cfg->{$ambl}{enabled};

            my $alt_assembly = fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/__BASE__.$ambl.fasta", $samplenr, $runstep_name);
            next unless -f $alt_assembly;

            $expected_results++;

            my $alt_resultfile = $alt_resultfile_template;
            $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
            $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr, $runstep_name);

            if (!-f $alt_resultfile) {
                $all_expected_results_present = 0;

                my $add_command = $alt_command_template;
                $add_command =~ s/__ASSEMBLER__/$ambl/g;
                push @commands, $add_command;
            }
        }
    }

    if (!@commands) {
        if ($expected_results > 0 && $all_expected_results_present) {
            log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
            postprocess_quast($samplenr);
        }
        else {
            log_message("WARNING: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name nothing available to process. Skipping","red");
        }
        return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    my $command = join(" ; ", @commands);
    $command = fill_placeholders($command, $samplenr, $runstep_name);

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));

    return $command;
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_quast;

sub postprocess_quast {
    my ($samplenr) = @_;

    my $runstep_name = "quast";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile              = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $alt_resultfile_template = $runstep{$runstep_name}{alt_resultfile};

    # Main assembly report
    if (-f $resultfile) {
        my $result_ref = parse_quast($resultfile, $samplenr);
        $R_samples->[$samplenr]{results}{$runstep_name}{main} = $result_ref;

        log_message("NOTICE: Sample $sample_name: Contigs: $result_ref->{contigs_0_bp}", "green");
        log_message("NOTICE: Sample $sample_name: Contigs (>500): $result_ref->{contigs}", "green");
        log_message("NOTICE: Sample $sample_name: Ns per 100kb: $result_ref->{n_s_per_100_kbp}", "green");
        log_message("NOTICE: Sample $sample_name: N50: $result_ref->{n50}", "green");
        log_message("NOTICE: Sample $sample_name: total_length: $result_ref->{total_length_0_bp}", "green");
        log_message("NOTICE: Sample $sample_name: total_length (>500): $result_ref->{total_length}", "green");
    }
    else {
        log_message("WARNING: Sample $sample_name: Main Quast report not found [$resultfile]", "yellow");
    }

    # Alternative assembly reports
    if ($sample_type ne "FASTA") {
        foreach my $ambl (@assemblers) {
            next unless $R_cfg->{$ambl}{enabled};

            my $alt_resultfile = $alt_resultfile_template;
            $alt_resultfile =~ s/__ASSEMBLER__/$ambl/g;
            $alt_resultfile = fill_placeholders($alt_resultfile, $samplenr, $runstep_name);

            next unless -f $alt_resultfile;

            my $alt_result_ref = parse_quast($alt_resultfile, $samplenr);
            $R_samples->[$samplenr]{results}{$runstep_name}{$ambl} = $alt_result_ref;
            my $qreport = $ambl . "_quast_report";
            my $ireport = $ambl . "_icarus_report";
            $R_samples->[$samplenr]{results}{$runstep_name}->{$qreport} =   path_relative_to_outdir(fill_placeholders("__DIR-QC3__/quast/alternative_assemblies/__BASE__-$ambl/report.html",$samplenr, $runstep_name)); 
            $R_samples->[$samplenr]{results}{$runstep_name}->{$ireport} =   path_relative_to_outdir(fill_placeholders("__DIR-QC3__/quast/alternative_assemblies/__BASE__-$ambl/icarus_viewers/contig_size_viewer.html",$samplenr, $runstep_name)); 
 
        }
    }

    # Links used by the HTML reports.
    $R_samples->[$samplenr]{results}{$runstep_name}->{main_quast_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC3__/quast/__BASE__/report.html",$samplenr, $runstep_name)); 
    $R_samples->[$samplenr]{results}{$runstep_name}->{main_icarus_report} =   path_relative_to_outdir(fill_placeholders("__DIR-QC3__/quast/__BASE__/icarus_viewers/contig_size_viewer.html",$samplenr, $runstep_name)); 
    
    
    return 1;
}



####################################################################################################
####################################################################################################

sub parse_quast {
    my ($resultfile, $samplenr) = @_;

    my %quast_data;   # local hash structure to store parsed results

    my $sample_name = $R_samples->[$samplenr]{name};
    
    
    # Try to open the file
    my $fh;
    unless (open  $fh, '<', $resultfile) {
        log_message("WARNING: could not open QUAST result file for sample $sample_name [$resultfile]");
        return {};  # return empty hashref on failure
    }

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\s+$//;   # remove trailing whitespaces
        $line =~ s/^#//;   # remove leading #
        
        next if $line =~ /^\s*$/;                  # skip blank lines
        next if $line =~ /^All statistics/;        # skip header line
        next if $line =~ /^Assembly/;              # skip assembly header

        # Match rows like "# contigs (>= 0 bp)         24"
        if ($line =~ /^(.+?)\s+([\d.]+)$/) {
            my ($key, $value) = ($1, $2);

            # Clean up the key: remove leading/trailing spaces and special chars
            $key =~ s/^\s+|\s+$//g;
            $key =~ s/[#()%>=]//g;
            $key =~ s/\s+/ /g;                     # normalize spaces
            $key =~ s/\s+$//;

            # Optionally make a machine-friendly key (underscored)
            my $normalized_key = lc($key);
            $normalized_key =~ s/[^a-z0-9]+/_/g;

            $quast_data{$normalized_key} = $value;
        }
    }

    close $fh;

    return \%quast_data;
}

