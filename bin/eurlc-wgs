sub load_optional_illumina_files {

    $rundata{illuminafiles} ||= {};

    ######## RunInfo.xml #################
    my $runinfo_file = find_optional_file("RunInfo.xml");

    if (defined $runinfo_file && -f $runinfo_file) {
        my $runinfo_ref = parse_runinfo_xml($runinfo_file);

        if ($runinfo_ref && ref($runinfo_ref) eq 'HASH' && %$runinfo_ref) {
            $rundata{illuminafiles}{runinfo} = $runinfo_ref;
            log_message("NOTICE: Loaded optional Illumina RunInfo.xml from [$runinfo_file]");

            log_message("NOTICE: Instrument: "   . ($rundata{illuminafiles}{runinfo}{run}{instrument} // "n/a"), "green");
            log_message("NOTICE: Date: "         . ($rundata{illuminafiles}{runinfo}{run}{date} // "n/a"), "green");
            log_message("NOTICE: Flowcell: "     . ($rundata{illuminafiles}{runinfo}{run}{flowcell} // "n/a"), "green");
            log_message("NOTICE: Run number: "   . ($rundata{illuminafiles}{runinfo}{run}{number} // "n/a"), "green");
            log_message("NOTICE: Run id: "       . ($rundata{illuminafiles}{runinfo}{run}{id} // "n/a"), "green");
            log_message("NOTICE: Cycles: "       . ($rundata{illuminafiles}{runinfo}{run}{reads}[0]{num_cycles} // "n/a"), "green");
            log_message("NOTICE: Number lanes: " . ($rundata{illuminafiles}{runinfo}{run}{flowcell_layout}{lane_count} // "n/a"), "green");
            log_message("NOTICE: Number tiles: " . ($rundata{illuminafiles}{runinfo}{run}{flowcell_layout}{tile_count} // "n/a"), "green");
 
        }
        else {
            log_message("WARNING: RunInfo.xml found but could not be parsed [$runinfo_file]");
        }
    }
    #####################################


    ######## RunParameters.xml ###########
    my $runparameters_file = find_optional_file("RunParameters.xml");

    if (defined $runparameters_file && -f $runparameters_file) {
        log_message("NOTICE: Loading optional Illumina RunParameters.xml from [$runparameters_file]");
        my $runparameters_ref = parse_runparameters_xml($runparameters_file);

        if ($runparameters_ref && ref($runparameters_ref) eq 'HASH' && %$runparameters_ref) {
            $rundata{illuminafiles}{runparameters} = $runparameters_ref;
            log_message("INFO: Loaded optional Illumina RunParameters.xml from [$runparameters_file]");
            

            log_message("NOTICE: Mashine: "         . ($rundata{illuminafiles}{runparameters}{scanner_id} // "n/a"), "green");
            log_message("NOTICE: Run ID: "         . ($rundata{illuminafiles}{runparameters}{run_id} // "n/a"), "green");
            log_message("NOTICE: Experiment name: "         . ($rundata{illuminafiles}{runparameters}{experiment_name} // "n/a"), "green");
            log_message("NOTICE: User name: "         . ($rundata{illuminafiles}{runparameters}{username} // "n/a"), "green");
            log_message("NOTICE: Run date: "   . ($rundata{illuminafiles}{runparameters}{run_start_date_iso} // "n/a"), "green");            
            log_message("NOTICE: Library kit: "   . ($rundata{illuminafiles}{runparameters}{library_prep_kit} // "n/a"), "green");
            log_message("NOTICE: Index kit: "   . ($rundata{illuminafiles}{runparameters}{index_kit} // "n/a"), "green");     
            log_message("NOTICE: Chemistry: "   . ($rundata{illuminafiles}{runparameters}{chemistry} // "n/a"), "green");                               
            
        }
        else {
            log_message("WARNING: RunParameters.xml found but could not be parsed [$runparameters_file]");
        }
    }

     ######## SampleSheet.csv ##############
     my $samplesheet_file = find_optional_file("SampleSheet.csv");

     if (defined $samplesheet_file && -f $samplesheet_file) {
         log_message("NOTICE: Loading optional Illumina SampleSheet.csv from [$samplesheet_file]");
         my $samplesheet_ref = parse_samplesheet_csv($samplesheet_file);

         if ($samplesheet_ref && ref($samplesheet_ref) eq 'HASH' && %$samplesheet_ref) {
             $rundata{illuminafiles}{samplesheet} = $samplesheet_ref;
             integrate_samplesheet_into_rundata();
             log_message("INFO: Loaded optional Illumina SampleSheet.csv from [$samplesheet_file]");
             

             log_message("NOTICE: SampleSheet Experiment Name: " . ($rundata{illuminafiles}{samplesheet}{header}{"Experiment Name"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Date: " . ($rundata{illuminafiles}{samplesheet}{header}{"Date"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Chemistry: " . ($rundata{illuminafiles}{samplesheet}{header}{"Chemistry"} // "n/a"), "green");
             log_message("NOTICE: SampleSheet Reads: " . join(", ", @{ $rundata{illuminafiles}{samplesheet}{reads} || [] }), "green");
             log_message("NOTICE: SampleSheet samples: " . ($rundata{illuminafiles}{samplesheet}{summary}{n_samples} // "n/a"), "green");

             
         }
         else {
             log_message("WARNING: SampleSheet.csv found but could not be parsed [$samplesheet_file]");
         }
     }
     #######################################
     
     ######## InterOp #####################
     my $interop_dir = find_optional_dir("InterOp");

     if (defined $interop_dir && -d $interop_dir) {
         log_message("NOTICE: Loading optional Illumina InterOp metrics from [$interop_dir]");
         my $interop_ref = load_interop_metrics();

        if ($interop_ref && ref($interop_ref) eq 'HASH' && %$interop_ref) {
            $rundata{illuminafiles}{interop} = $interop_ref;
            map_interop_index_summary_to_samples();
            map_interop_run_summary_to_matched_samples();
            
            print_interop_summary_to_log();  

            log_message("INFO: Loaded optional Illumina InterOp metrics from [$interop_dir]");
        }
         else {
             log_message("WARNING: InterOp directory found but could not be parsed [$interop_dir]");
         }
     }
     ######################################


    return 1;
}


sub print_interop_summary_to_log {

    my $R_interop = $rundata{illuminafiles}{interop};
    return 0 if !defined $R_interop || ref($R_interop) ne 'HASH';

    my $R_summary = $R_interop->{summary} || {};
    my $R_index   = $R_interop->{index_summary} || {};



    ########################################
    # PF reads and totals (from index summary)

    my ($total_reads, $pf_reads, $pf_pct, $cv, $min, $max);

    my @lanes = sort { $a <=> $b } grep { /^\d+$/ } keys %{ $R_index->{lanes} || {} };
    if (@lanes) {
        my $lane = $lanes[0];
        my $R_lane = $R_index->{lanes}{$lane}{totals} || {};

        $total_reads = $R_lane->{total_reads};
        $pf_reads    = $R_lane->{pf_reads};
        $cv          = $R_lane->{cv};
        $min         = $R_lane->{min};
        $max         = $R_lane->{max};

        if (defined $pf_reads && defined $total_reads && $total_reads > 0) {
            $pf_pct = sprintf("%.1f", 100 * $pf_reads / $total_reads);
        }
    }

    log_message("NOTICE: Total reads: " . ($total_reads // "n/a"), "green");
    log_message("NOTICE: PF reads: " . ($pf_reads // "n/a"), "green");
    log_message("NOTICE: PF (%): " . (defined $pf_pct ? "$pf_pct %" : "n/a"), "green");

    ########################################
    # Yield and Q30 (from summary totals)

    my $R_totals = $R_summary->{totals} || {};

    my $total_yield      = $R_totals->{Total}{yield_gb};
    my $nonidx_yield     = $R_totals->{"Non-indexed"}{yield_gb};

    my $q30_total        = $R_totals->{Total}{pct_q30};
    my $q30_r1           = $R_totals->{"Read 1"}{pct_q30};
    my $q30_i1           = $R_totals->{"Read 2 (I)"}{pct_q30};
    my $q30_i2           = $R_totals->{"Read 3 (I)"}{pct_q30};
    my $q30_r2           = $R_totals->{"Read 4"}{pct_q30};

    log_message("NOTICE: Total yield: " . (defined $total_yield ? "$total_yield Gb" : "n/a"), "green");
    log_message("NOTICE: Non-indexed yield: " . (defined $nonidx_yield ? "$nonidx_yield Gb" : "n/a"), "green");

    log_message("NOTICE: Q30 total: " . (defined $q30_total ? "$q30_total %" : "n/a"), "green");
    log_message("NOTICE: Q30 R1: " . (defined $q30_r1 ? "$q30_r1 %" : "n/a"), "green");
    log_message("NOTICE: Q30 R2: " . (defined $q30_r2 ? "$q30_r2 %" : "n/a"), "green");
    log_message("NOTICE: Q30 index (I1/I2): " .
        (
            defined $q30_i1 || defined $q30_i2
            ? (($q30_i1 // "n/a") . " / " . ($q30_i2 // "n/a") . " %")
            : "n/a"
        ),
        "green"
    );

    ########################################
    # Cluster density + PF (from Read 1 summary)

    my $R_read1 = $R_summary->{read_sections}{"Read 1"}{by_surface}{"-"} || {};

    my $density   = $R_read1->{Density};
    my $clusterpf = $R_read1->{"Cluster PF"};

    log_message("NOTICE: Cluster density: " . ($density // "n/a") . " k/mm²", "green");
    log_message("NOTICE: Cluster PF: " . ($clusterpf // "n/a") . " %", "green");

    ########################################
    # Sample balance (index summary)

    log_message("NOTICE: Sample balance CV: " . (defined $cv ? $cv : "n/a"), "green");
    log_message("NOTICE: Sample balance min/max: " .
        (
            defined $min || defined $max
            ? (($min // "n/a") . " / " . ($max // "n/a") . " %")
            : "n/a"
        ),
        "green"
    );

    ########################################
    # Footer stats

    my $R_footer = $R_summary->{footer} || {};
    
    log_message("NOTICE: Tiles processed (Extracted/Called/Scored): " .
        join(" / ",
            $R_footer->{Extracted} // "n/a",
            $R_footer->{Called}    // "n/a",
            $R_footer->{Scored}    // "n/a"
        ),
        "green"
    );


    return 1;
}
sub integrate_samplesheet_into_rundata {

    my $R_ss = $rundata{illuminafiles}{samplesheet};

    if (!defined $R_ss || ref($R_ss) ne 'HASH') {
        log_message("WARNING: integrate_samplesheet_into_rundata called without parsed SampleSheet data");
        return 0;
    }

    my $R_indexes = build_samplesheet_indexes($R_ss);
    $rundata{illuminafiles}{samplesheet_indexes} = $R_indexes;

    my $matched   = 0;
    my $unmatched = 0;

    for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {
        my $sample_name = $R_samples->[$samplenr]{name} // '';

        if ($sample_name eq '') {
            log_message("WARNING: Sample [$samplenr] has no name, cannot match to SampleSheet");
            $unmatched++;
            next;
        }

        my $R_match =
               $R_indexes->{by_sample_id}{$sample_name}
            || $R_indexes->{by_sample_name}{$sample_name};

        if (!defined $R_match || ref($R_match) ne 'HASH') {
            log_message("NOTICE: No SampleSheet match found for sample [$sample_name]","yellow");
            $unmatched++;
            next;
        }

        # Attach full row as a copied hash
        $R_samples->[$samplenr]{samplesheet} = { %$R_match };

        # Store which key matched
        if (exists $R_indexes->{by_sample_id}{$sample_name}) {
            $R_samples->[$samplenr]{samplesheet_match_type} = 'Sample_ID';
        }
        elsif (exists $R_indexes->{by_sample_name}{$sample_name}) {
            $R_samples->[$samplenr]{samplesheet_match_type} = 'Sample_Name';
        }

        $R_samples->[$samplenr]{samplesheet_match_key} = $sample_name;



        $matched++;
        log_message("NOTICE: Matched sample [$sample_name] to SampleSheet ($R_samples->[$samplenr]{samplesheet_match_type})","green");
    }

    log_message("NOTICE: SampleSheet integration complete: matched [$matched], unmatched [$unmatched]","green");

    return 1;
}

sub build_samplesheet_indexes {
    my ($R_ss) = @_;

    my %by_sample_id;
    my %by_sample_name;

    return {
        by_sample_id   => \%by_sample_id,
        by_sample_name => \%by_sample_name,
    } if !defined $R_ss || ref($R_ss) ne 'HASH' || ref($R_ss->{data}) ne 'ARRAY';

    foreach my $R_row (@{ $R_ss->{data} }) {
        next if !defined $R_row || ref($R_row) ne 'HASH';

        my $sample_id   = $R_row->{Sample_ID}   // '';
        my $sample_name = $R_row->{Sample_Name} // '';

        $by_sample_id{$sample_id}     = $R_row if $sample_id ne '';
        $by_sample_name{$sample_name} = $R_row if $sample_name ne '';
    }

    return {
        by_sample_id   => \%by_sample_id,
        by_sample_name => \%by_sample_name,
    };
}

