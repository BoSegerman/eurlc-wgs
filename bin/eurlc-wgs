sub run_interop_summary {
    my ($run_dir, $outdir) = @_;

    my $exe = resolve_interop_executable(qw(summary interop_summary));
    if (!defined $exe) {
        log_message("WARNING: Could not find InterOp summary executable in env [$R_cfg->{interop}->{env}]");
        return undef;
    }

    my $outfile = "$outdir/interop_summary.csv";
    my $cmd = "conda run -n $R_cfg->{interop}->{env} --no-capture-output " .
              "$exe --csv=1 \"$run_dir\" > \"$outfile\"";

    execute_and_log($cmd, 0, "Parsing Illumina InterOp summary metrics");

    return $outfile;
}

sub run_interop_index_summary {
    my ($run_dir, $outdir) = @_;

    my $exe = resolve_interop_executable(qw(index-summary interop_index-summary));
    if (!defined $exe) {
        log_message("WARNING: Could not find InterOp index-summary executable in env [$R_cfg->{interop}->{env}]");
        return undef;
    }

    my $outfile = "$outdir/interop_index_summary.csv";
    my $cmd = "conda run -n $R_cfg->{interop}->{env} --no-capture-output " .
              "$exe --csv=1 \"$run_dir\" > \"$outfile\"";

    execute_and_log($cmd, 0, "Parsing Illumina InterOp index summary metrics");

    return $outfile;
}


sub parse_interop_csv {
    my ($file) = @_;

    return {} if !defined $file || $file eq "" || !-f $file;

    my $csv;
    eval {
        require Text::CSV;
        $csv = Text::CSV->new({
            binary           => 1,
            allow_whitespace => 0,
            auto_diag        => 1,
        });
    };
    if ($@ || !$csv) {
        log_message("WARNING: Text::CSV not available, cannot parse InterOp CSV [$file]");
        return {};
    }

    open(my $fh, "<", $file) or do {
        log_message("WARNING: Could not open InterOp CSV [$file]: $!");
        return {};
    };

    my @header;
    my @rows;

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\r$//;
        next if $line =~ /^\s*$/;

        if (!$csv->parse($line)) {
            log_message("WARNING: Failed to parse InterOp CSV line in [$file]: [$line]");
            next;
        }

        my @fields = $csv->fields();

        if (!@header) {
            @header = @fields;
            next;
        }

        my %row;
        for (my $i = 0; $i < @header; $i++) {
            my $key = $header[$i];
            my $val = defined $fields[$i] ? $fields[$i] : '';
            $row{$key} = $val;
        }

        push @rows, \%row;
    }

    close($fh);

    return {
        header => [@header],
        rows   => \@rows,
    };
}


#$rundata{illuminafiles}{interop} = {
#    summary_csv_file       => ".../interop_summary.csv",
#    index_summary_csv_file => ".../interop_index_summary.csv",
#
#    summary => {
#        header => [...],
#        rows   => [ {...}, {...} ],
#    },
