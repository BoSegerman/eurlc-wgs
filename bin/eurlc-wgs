my $runstep_name = "";

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep md5_rawdata
#
# Calculates MD5 fingerprints of the raw input files for traceability.
# Implemented as an internal Perl sub (Digest::MD5) -- no shell dependency,
# works identically on Linux and macOS without detecting md5sum vs md5.

$runstep_name = "md5_rawdata";

$runstep{$runstep_name} = {
    resources  => { threads => 1, ram_gb => 0 },

    message    => "Calculating MD5 fingerprints...",
    long_name  => "MD5 fingerprints (rawdata)",
    output_dir => "__DIR-QC1__/md5",
    resultfile => "__DIR-QC1__/md5/md5-__BASE__.txt",

    requires   => [],
    produces   => [ 'md5_done' ],
    applies_if => sub { return $R_cfg->{md5}{enabled} ? 1 : 0; },
};

# TEST---------------------------------
$runstep{$runstep_name}{test} = sub {
    my ($samplenr) = @_;
    return 2 if exists $tests_performed{md5};
    $tests_performed{md5} = 1;
    return 1;  # Digest::MD5 is core Perl, always available
};

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_md5_rawdata;

sub preprocess_md5_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);

    return "" if is_disabled($R_cfg->{md5}{enabled});

    my @input_phs = $sample_type eq 'PE'    ? ('__R1__', '__R2__')
                  : $sample_type eq 'SE'    ? ('__SE__')
                  : $sample_type eq 'FASTA' ? ('__FASTA__')
                  : ();
    return "" unless require_input_files($samplenr, $runstep_name, "fatal", @input_phs);

    if (-s $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_md5_rawdata($samplenr);
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr));
    return "SUB\tmd5_rawdata_internal\t$samplenr";
}

$INTERNAL_SUB{md5_rawdata_internal} = sub {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr);
    my $outdir       = fill_placeholders($runstep{$runstep_name}{output_dir},  $samplenr);
    my $allfile      = "$outdir/all_md5sums.txt";

    my @files;
    if    ($sample_type eq 'PE')    { @files = map { fill_placeholders($_, $samplenr) } ('__R1__', '__R2__') }
    elsif ($sample_type eq 'SE')    { @files = (fill_placeholders('__SE__',    $samplenr)) }
    elsif ($sample_type eq 'FASTA') { @files = (fill_placeholders('__FASTA__', $samplenr)) }

    open my $out,    '>',  $resultfile or die "Cannot write $resultfile: $!";
    open my $allout, '>>',$allfile    or die "Cannot append $allfile: $!";
    print $allout "$sample_name\n";
    for my $path (@files) {
        my $digest = md5_file($path);
        if ($digest =~ /^ERROR:/) {
            log_message("WARNING: MD5 failed for [$path]: $digest");
        }
        my $line = "$digest  $path\n";
        print $out    $line;
        print $allout $line;
    }
    close $out; close $allout;
    return 0;
};


# POST---------------------------------
$runstep{$runstep_name}{result_parsing} = \&postprocess_md5_rawdata;

sub postprocess_md5_rawdata {
    my ($samplenr) = @_;
    my $runstep_name = "md5_rawdata";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};
    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    my $results_ref = parse_md5_rawdata_results($resultfile, $samplenr);
    if (!$results_ref || ref($results_ref) ne 'HASH' || !%{$results_ref}) {
        log_message("WARNING: No MD5 results parsed for sample [$sample_name] from [$resultfile]", "yellow");
        # Not fatal -- analysis can continue without checksums -- but worth
        # flagging so it's visible in the report.
        set_runtime_issue($samplenr, "warning", "No MD5 checksums produced for rawdata");
    }

    register_raw_output($samplenr, $runstep_name,
        title => "MD5 checksums (raw data files)",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__OUTDIR__/md5-__BASE__.txt", $samplenr, $runstep_name)),
    );
    $R_samples->[$samplenr]{results}{$runstep_name} = $results_ref;
    $R_samples->[$samplenr]{main_results}{md5} //= [];

    if ($sample_type eq 'PE') {
        my ($r1, $r2) = map { $results_ref->{$_} // "n/a" } ('R1', 'R2');
        log_message("NOTICE: $sample_name rawdata R1: $r1");
        log_message("NOTICE: $sample_name rawdata R2: $r2");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata R1: $r1", "Rawdata R2: $r2";
    } elsif ($sample_type eq 'SE') {
        my $se = $results_ref->{SE} // "n/a";
        log_message("NOTICE: $sample_name rawdata SE: $se");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata SE: $se";
    } elsif ($sample_type eq 'FASTA') {
        my $fa = $results_ref->{FASTA} // "n/a";
        log_message("NOTICE: $sample_name rawdata FASTA: $fa");
        push @{$R_samples->[$samplenr]{main_results}{md5}}, "Rawdata FASTA: $fa";
    }
    return 1;
}

# PARSE---------------------------------
# Parses the result file written by md5_rawdata_internal.
# Format (one line per input file):
#   <32-char-hex>  <full-path-to-file>
#
# Identifies each line by matching the path against the sample's known
# raw file paths (stored in $R_samples->[$samplenr]{paths}{raw}).
# Returns a hashref with keys R1/R2/SE/FASTA and MD5 hex values.
sub parse_md5_rawdata_results {
    my ($resultfile, $samplenr) = @_;
    my %md5;

    return {} unless defined $resultfile && -s $resultfile;

    my $paths = $R_samples->[$samplenr]{paths}{raw} // {};
    my %known = (
        R1    => $paths->{R1}   // "",
        R2    => $paths->{R2}   // "",
        SE    => $paths->{SE}   // "",
        FASTA => $paths->{FASTA} // $R_samples->[$samplenr]{paths}{fasta} // "",
    );

    open my $fh, '<', $resultfile or do {
        log_message("WARNING: Cannot open MD5 result file [$resultfile]: $!");
        return {};
    };

    # The file was written with the paths as they were spelled then; on a
    # --resume the same files may be reached by another path (a symlink, a
    # different mount point). Match on the path, then on the real path, then
    # on the file name -- the file holds only this sample's files.
    my $real = sub { my $p = shift; return "" if !defined $p || $p eq ""; return eval { abs_path($p) } // $p; };
    my %known_real = map { $_ => $real->($known{$_}) } keys %known;
    my %known_name = map { $_ => ( $known{$_} ne "" ? basename($known{$_}) : "" ) } keys %known;
    my @lines;
    while (my $line = <$fh>) {
        chomp $line;
        next unless $line =~ /^([0-9a-f]{32})\s+(.+)$/i;
        push @lines, [ $1, $2 ];
    }
    close $fh;
    for my $how (
        sub { my ($k, $p) = @_; return $p eq $known{$k} },
        sub { my ($k, $p) = @_; my $r = $real->($p); return $r ne "" && $r eq $known_real{$k} },
        sub { my ($k, $p) = @_; return basename($p) eq $known_name{$k} },
    ) {
        for my $l (@lines) {
            my ($digest, $path) = @$l;
            for my $key (keys %known) {
                next if $known{$key} eq "" || exists $md5{$key};
                if ($how->($key, $path)) { $md5{$key} = $digest; last; }
            }
        }
    }
    return \%md5;
}

##   $R_samples->[$samplenr]{results}{md5_rawdata}{R1}     -- MD5 of raw R1
##   $R_samples->[$samplenr]{results}{md5_rawdata}{R2}     -- MD5 of raw R2
##   $R_samples->[$samplenr]{results}{md5_rawdata}{SE}     -- MD5 of raw SE
##   $R_samples->[$samplenr]{results}{md5_rawdata}{FASTA}  -- MD5 of input FASTA


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep sample_prescan
##
## Pre-scans raw FASTQ reads (not FASTA -- prescan doesn't apply to
## already-assembled data). Detects sequencing instrument, estimates read
## length distribution, checks for adapter contamination, and computes the
## bracken_readlength value used by find_species_kraken2. Must run before
## find_species_kraken2: bracken's command needs the estimated read length
## this produces -- a real data dependency, not just ordering preference.
##
## No external tool: pure Perl via the %INTERNAL_SUB mechanism, which gives
## it proper event/timing tracking from run_step() despite not being a
## subprocess. The internal sub writes its result to a JSON file;
## postprocess_sample_prescan reads it back in the parent process.

$runstep_name = "sample_prescan";

$runstep{$runstep_name} = {
      resources  => { threads => 1, ram_gb => 1 },

      message    => "Pre-scanning raw reads...",
      long_name  => "Raw read pre-scan",
      output_dir => "__DIR-QC1__/fastq_prescan",
      resultfile => "__DIR-QC1__/fastq_prescan/__BASE__.prescan.json",

      requires   => [],
      produces   => [ 'prescan_done' ],
      applies_if => sub {
          my ($i) = @_;
          return $R_samples->[$i]{type} eq 'FASTA' ? 0 : 1;
      },
};

# TEST---------------------------------
# No external tool, nothing to test -- return 2 (skip) immediately.
$runstep{$runstep_name}{test} = sub { return 2; };

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_sample_prescan;

sub preprocess_sample_prescan {
    my ($samplenr) = @_;

    my $runstep_name = "sample_prescan";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $prescan_dir  = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);
    my $prescan_json = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    if (-s $prescan_json) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_sample_prescan($samplenr);
        return "";
    }

    ensure_dir($prescan_dir);

    my $fq1 = $R_samples->[$samplenr]{paths}{raw}{R1} // $R_samples->[$samplenr]{paths}{raw}{SE} // "";
    my $fq2 = $R_samples->[$samplenr]{paths}{raw}{R2} // "";

    return "SUB\tfastq_prescan_internal\t$fq1\t$fq2\t$prescan_dir\t$samplenr";
}

# INTERNAL SUB---------------------------------
# Registered here (not in the central %INTERNAL_SUB) so everything
# belonging to this runstep is co-located. Writes results to JSON and
# TXT files; returns 0 on success. postprocess_sample_prescan reads
# the JSON back in the parent process.
# HELPER SUBS (used only by fastq_prescan_internal, co-located here)
sub nearest_bracken_readlength {
    my ($current_readlength) = @_;

    my @reference_lengths = (50, 75, 100, 150, 200, 250, 300);

    return 150 if !defined $current_readlength || $current_readlength !~ /^\d+(?:\.\d+)?$/;

    my $len = $reference_lengths[0];
    my $min_diff = abs($current_readlength - $len);

    foreach my $ref (@reference_lengths) {
        my $diff = abs($current_readlength - $ref);
        if ($diff < $min_diff) {
            $min_diff = $diff;
            $len = $ref;
        }
    }

    return $len;
}

sub classify_read_header {
    my ($header, $machine_aliases_ref) = @_;

    my %info = (
        header_format          => "unknown",
        platform_guess         => "unknown",
        source_guess           => "unknown",
        instrument             => "",
        instrument_type_guess  => "",
        run_number             => "",
        flowcell               => "",
        lane                   => "",
        machine_alias          => "",
    );

    return \%info if !defined $header || $header eq "";

    $header =~ s/^\@//;

    # Modern Illumina:
    # instrument:run:flowcell:lane:tile:x:y read:is_filtered:control:index
    if ($header =~ /^([A-Za-z0-9_-]+):(\d+):([A-Za-z0-9_-]+):(\d+):\d+:\d+:\d+(?:\s+[12]:[YN]:\d+:[A-Za-z0-9+-]+)?$/) {
        $info{header_format}  = "illumina_modern";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{run_number}     = $2;
        $info{flowcell}       = $3;
        $info{lane}           = $4;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # Older Illumina-ish patterns
    elsif ($header =~ /^([A-Za-z0-9_-]+):(\d+):(\d+):(\d+):(\d+)(?:#\S+)?(?:\/[12])?$/) {
        $info{header_format}  = "illumina_legacy";
        $info{platform_guess} = "Illumina";
        $info{source_guess}   = "local_or_exported";
        $info{instrument}     = $1;
        $info{lane}           = $2;
        $info{instrument_type_guess} = guess_illumina_instrument_type($info{instrument});
    }

    # SRA / ENA / DDBJ accession-like
    elsif ($header =~ /^((?:SRR|ERR|DRR)\d+(?:\.\d+)?)/i) {
        $info{header_format}  = "sra_ena_accession";
        $info{platform_guess} = "unknown";
        $info{source_guess}   = "SRA_ENA_DDBJ";
        $info{instrument}     = "";
    }

    # ONT often UUID-like headers or runid/ch/chunks
    elsif ($header =~ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/i
        || $header =~ /\brunid=/i
        || $header =~ /\bch=\d+/i
        || $header =~ /\bstart_time=/i) {
        $info{header_format}  = "ont_like";
        $info{platform_guess} = "ONT";
        $info{source_guess}   = "local_or_exported";
    }

    # PacBio CCS/subreads often have movie/zmw style
    elsif ($header =~ m{^[^/\s]+/\d+/(?:ccs|\d+_\d+)}i) {
        $info{header_format}  = "pacbio_like";
        $info{platform_guess} = "PacBio";
        $info{source_guess}   = "local_or_exported";
    }

    # Some IonTorrent exports can look like runID:row:col or similar, but weakly standardized
    elsif ($header =~ /^[A-Za-z0-9._-]+:\d+:\d+$/) {
        $info{header_format}  = "iontorrent_like";
        $info{platform_guess} = "IonTorrent";
        $info{source_guess}   = "local_or_exported";
    }

    if ($info{instrument} ne "" && exists $machine_aliases_ref->{ $info{instrument} }) {
        $info{machine_alias} = $machine_aliases_ref->{ $info{instrument} };
    }

    return \%info;
}

# Nicknames per instrument ID: the "id" lines of known_instruments.tsv, then
# general.machine_aliases (ID=name,ID=name), which wins.
sub parse_machine_aliases {
    my ($text) = @_;

    my %aliases = %{ known_instruments()->{id} };
    return \%aliases if !defined $text || $text eq "";

    foreach my $pair (split /\s*,\s*/, $text) {
        next if $pair eq "";
        my ($key, $value) = split /\s*=\s*/, $pair, 2;
        next if !defined $key || !defined $value || $key eq "" || $value eq "";
        $aliases{$key} = $value;
    }

    return \%aliases;
}

## R1/R2 read-name check (used by the prescan, and by its postprocess for
## prescan results made before the check existed). The reads of a pair must
## have the same name in R1 and R2, record by record: Illumina "@<id> 1:N:..."
## and "@<id> 2:N:...", older "@<id>/1" and "@<id>/2", SRA "@<acc>.<n>.1" and
## ".2". Files from two different samples (renamed or mixed up when submitted)
## differ in (nearly) every pair even when they come from the same run and
## flowcell, which the instrument/flowcell check cannot see. A few differing
## names can happen in usable data; many mean the files do not belong together.
## Returns { compared, mismatched, mismatch_pct, examples => [[r1, r2], ...],
##           mates_swapped => 0|1 } or undef when it cannot be checked.
sub fastq_pair_name_check {
    my ($fq1, $fq2, $max) = @_;
    $max ||= 5000;
    return undef unless defined $fq1 && defined $fq2 && $fq1 ne "" && $fq2 ne "" && -f $fq1 && -f $fq2;
    my @fh;
    for my $f ($fq1, $fq2) {
        my $h;
        if ($f =~ /\.gz$/i) { open($h, "-|", "gzip", "-dc", $f) or return undef; }
        else                { open($h, "<", $f) or return undef; }
        push @fh, $h;
    }
    my $norm = sub {
        my ($hdr) = @_;
        $hdr =~ s/^\@//;
        my ($id, $comment) = split /\s+/, $hdr, 2;
        $id //= "";
        $id =~ s{/[123]$}{};
        my ($mate) = ( ($comment // "") =~ /^([123]):[YN]:/ );
        return ($id, $mate // "");
    };
    my ($n, $bad, $r1_says2, $r2_says1, @ex) = (0, 0, 0, 0);
    while ($n < $max) {
        my @rec;
        for my $h (@fh) {
            my @l = map { scalar <$h> } 1 .. 4;
            last unless defined $l[3];
            chomp @l;
            push @rec, $l[0];
        }
        last unless @rec == 2;
        next unless $rec[0] =~ /^\@/ && $rec[1] =~ /^\@/;
        $n++;
        my ($ia, $ma) = $norm->($rec[0]);
        my ($ib, $mb) = $norm->($rec[1]);
        $r1_says2++ if $ma eq "2";
        $r2_says1++ if $mb eq "1";
        next if $ia eq $ib;
        ( my $a2 = $ia ) =~ s/\.[12]$//;           # SRA --readids: <acc>.<n>.1 / .2
        ( my $b2 = $ib ) =~ s/\.[12]$//;
        next if $a2 eq $b2;
        $bad++;
        push @ex, [ $ia, $ib ] if @ex < 3;
    }
    close $_ for @fh;
    return undef unless $n;
    return {
        compared      => $n,
        mismatched    => $bad,
        mismatch_pct  => sprintf("%.3f", 100 * $bad / $n),
        examples      => \@ex,
        # R1 says read 2 and R2 says read 1 in most pairs: the R1 and R2 files are swapped
        mates_swapped => ( $r1_says2 > $n / 2 && $r2_says1 > $n / 2 ) ? 1 : 0,
    };
}

$INTERNAL_SUB{fastq_prescan_internal} = sub {
    my ($fq1, $fq2, $outfolder, $samplenr) = @_;

    my $MAX_SCAN_READS    = $R_cfg->{sample_prescan}{max_scan_reads} // 5000;
    my $MAX_ADAPTER_READS = $MAX_SCAN_READS;   # adapter check runs over the same reads
    my $DEFAULT_READLENGTH = 150;

    my @constants_adapters = (
        "Illumina Tagmentation: CTGTCTCTTATACACATCT",
        "Illumina TruSeq R1: AGATCGGAAGAGCACACGTCTGAAC",
        "Illumina TruSeq R2: AGATCGGAAGAGCGTCGTGTAGGGA",
        "Illumina Tagmentation alt: ATGTGTATAAGAGACA",
    );

    my @adapters = (
        "CTGTCTCTTATACACATCT",
        "AGATCGGAAGAGCACACGTCTGAAC",
        "AGATCGGAAGAGCGTCGTGTAGGGA",
        "ATGTGTATAAGAGACA",
    );

    my $machine_aliases_ref = parse_machine_aliases($R_cfg->{general}{machine_aliases});

    my $hist_quantile = sub {
        my ($hist, $q) = @_;
        my $total = 0;
        $total += $_ for values %$hist;
        return 0 if $total == 0;

        my $target = int($q * ($total - 1));
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %$hist) {
            $cum += $hist->{$k};
            return $k if $cum > $target;
        }

        my @keys = sort { $a <=> $b } keys %$hist;
        return $keys[-1] // 0;
    };

    my $hist_minmax = sub {
        my ($hist) = @_;
        my @keys = sort { $a <=> $b } keys %$hist;
        return (0, 0) if !@keys;
        return ($keys[0], $keys[-1]);
    };

    my $norm_text = sub {
        my ($x, $default) = @_;
        $default //= "unknown";
        return $default if !defined $x || $x eq "";
        return $x;
    };

    my $init_bucket = sub {
        return {
            reads_scanned           => 0,
            zero_length_reads       => 0,
            bases                   => 0,
            gc_bases                => 0,
            n_bases                 => 0,
            qual_sum                => 0,
            read_len_hist           => {},
            adapters_checked        => 0,
            adapters_found          => 0,
            adapter_hits            => {},
            adapter_pos_hist        => {},   # 1-based start of the first adapter hit -> reads
            header_examples         => [],
            header_patterns         => {},
            source_patterns         => {},
            instruments             => {},
            instrument_type_guesses => {},
            flowcells               => {},
            run_numbers             => {},
            lanes                   => {},
            platform_guesses        => {},
            warnings                => [],
        };
    };

    my %res = (
        files    => [ grep { defined && $_ ne "" } ($fq1, $fq2) ],
        adapters => \@constants_adapters,
        R1       => $init_bucket->(),
        R2       => $init_bucket->(),
        total    => $init_bucket->(),
    );

    my @file_specs;
    push @file_specs, [ $fq1, "R1" ] if defined($fq1) && $fq1 ne "";
    push @file_specs, [ $fq2, "R2" ] if defined($fq2) && $fq2 ne "";

    for my $spec (@file_specs) {
        my ($file, $bucket_name) = @$spec;
        my $bucket = $res{$bucket_name};

        my $fh;
        if ($file =~ /\.gz$/i) {
            unless (open($fh, "-|", "gzip", "-dc", $file)) {
                warn "fastq_prescan: Cannot open $file: $!\n";
                return 1;
            }
        }
        else {
            unless (open($fh, "<", $file)) {
                warn "fastq_prescan: Cannot open $file: $!\n";
                return 1;
            }
        }

        while (1) {
            my $header = <$fh>; last unless defined $header;
            my $seq    = <$fh>; last unless defined $seq;
            my $plus   = <$fh>; last unless defined $plus;
            my $qual   = <$fh>; last unless defined $qual;

            chomp($header);
            chomp($seq);
            chomp($plus);
            chomp($qual);

            # FASTQ format validation
            unless ($header =~ /^\@/) {
                push @{ $bucket->{warnings} },
                    "Non-FASTQ header (missing \@) at read ${\($bucket->{reads_scanned}+1)}: ".substr($header,0,40);
                # Skip this record -- we may be misaligned; try to recover
                next;
            }
            unless ($plus =~ /^\+/) {
                push @{ $bucket->{warnings} },
                    "Missing + separator at read ${\($bucket->{reads_scanned}+1)}";
                next;
            }
            if (length($seq) != length($qual)) {
                push @{ $bucket->{warnings} },
                    "Sequence/quality length mismatch at read ${\($bucket->{reads_scanned}+1)}: "
                    . "seq=".length($seq)." qual=".length($qual);
                # Count the read but flag it
            }

            $bucket->{reads_scanned}++;
            $res{total}{reads_scanned}++;

            # Zero-length sequence -- count but don't include in length stats.
            # Causes failures in many downstream tools (fastp, bowtie2, spades).
            if (length($seq) == 0) {
                $bucket->{zero_length_reads}++;
                $res{total}{zero_length_reads}++;
                next;
            }

            my $len = length($seq);
            $bucket->{bases} += $len;
            $res{total}{bases} += $len;

            $bucket->{read_len_hist}{$len}++;
            $res{total}{read_len_hist}{$len}++;

            my $gc_count = ($seq =~ tr/GCgc//);
            $bucket->{gc_bases} += $gc_count;
            $res{total}{gc_bases} += $gc_count;

            my $n_count = ($seq =~ tr/Nn//);
            $bucket->{n_bases} += $n_count;
            $res{total}{n_bases} += $n_count;

            for my $c (unpack("C*", $qual)) {
                my $Q = $c - 33;
                $Q = 0 if $Q < 0;
                $bucket->{qual_sum} += $Q;
                $res{total}{qual_sum} += $Q;
            }

            if ($bucket->{reads_scanned} <= $MAX_ADAPTER_READS) {
                $bucket->{adapters_checked}++;
                # earliest hit of any adapter: its position drives the
                # adapter-content curve (share of reads with adapter by position)
                my ($best_pos, $best_i);
                for (my $i = 0; $i < @adapters; $i++) {
                    my $pos = index($seq, $adapters[$i]);
                    next if $pos < 0;
                    ($best_pos, $best_i) = ($pos, $i) if !defined $best_pos || $pos < $best_pos;
                }
                if (defined $best_pos) {
                    $bucket->{adapters_found}++;
                    $bucket->{adapter_hits}{$constants_adapters[$best_i]}++;
                    $bucket->{adapter_pos_hist}{ $best_pos + 1 }++;
                }
            }

            if (@{ $bucket->{header_examples} } < 5) {
                push @{ $bucket->{header_examples} }, $header;
            }
            if (@{ $res{total}{header_examples} } < 5) {
                push @{ $res{total}{header_examples} }, $header;
            }

            my $header_info = classify_read_header($header, $machine_aliases_ref);

            my $header_format         = $norm_text->($header_info->{header_format});
            my $source_guess          = $norm_text->($header_info->{source_guess});
            my $platform_guess        = $norm_text->($header_info->{platform_guess});
            my $instrument_type_guess = $norm_text->($header_info->{instrument_type_guess});

            $bucket->{header_patterns}{$header_format}++;
            $res{total}{header_patterns}{$header_format}++;

            $bucket->{source_patterns}{$source_guess}++;
            $res{total}{source_patterns}{$source_guess}++;

            $bucket->{platform_guesses}{$platform_guess}++;
            $res{total}{platform_guesses}{$platform_guess}++;

            $bucket->{instrument_type_guesses}{$instrument_type_guess}++;
            $res{total}{instrument_type_guesses}{$instrument_type_guess}++;

            if (defined $header_info->{instrument} && $header_info->{instrument} ne "") {
                $bucket->{instruments}{ $header_info->{instrument} }++;
                $res{total}{instruments}{ $header_info->{instrument} }++;
            }

            if (defined $header_info->{flowcell} && $header_info->{flowcell} ne "") {
                $bucket->{flowcells}{ $header_info->{flowcell} }++;
                $res{total}{flowcells}{ $header_info->{flowcell} }++;
            }

            if (defined $header_info->{run_number} && $header_info->{run_number} ne "") {
                $bucket->{run_numbers}{ $header_info->{run_number} }++;
                $res{total}{run_numbers}{ $header_info->{run_number} }++;
            }

            if (defined $header_info->{lane} && $header_info->{lane} ne "") {
                $bucket->{lanes}{ $header_info->{lane} }++;
                $res{total}{lanes}{ $header_info->{lane} }++;
            }

            last if $bucket->{reads_scanned} >= $MAX_SCAN_READS;
        }

        close $fh;
    }

    # Build total adapter stats from R1 + R2 buckets instead of sampling only the first reads overall
    $res{total}{adapters_checked} = ($res{R1}{adapters_checked} // 0) + ($res{R2}{adapters_checked} // 0);
    $res{total}{adapters_found}   = ($res{R1}{adapters_found}   // 0) + ($res{R2}{adapters_found}   // 0);

    for my $ad (@constants_adapters) {
        $res{total}{adapter_hits}{$ad} =
              ($res{R1}{adapter_hits}{$ad} // 0)
            + ($res{R2}{adapter_hits}{$ad} // 0);
    }

    my $dominant_key = sub {
        my ($href) = @_;
        return "" if !defined $href || ref($href) ne "HASH" || !%$href;

        my ($best) = sort { $href->{$b} <=> $href->{$a} } keys %$href;
        return $best // "";
    };

    my $dominant_value = sub {
        my ($href) = @_;
        my $key = $dominant_key->($href);
        return $key;
    };

    my $finalize_bucket = sub {
        my ($bucket) = @_;

        if ($bucket->{reads_scanned} > 0 && $bucket->{bases} > 0) {
            my ($min_len, $max_len) = $hist_minmax->($bucket->{read_len_hist});
            $bucket->{shortest}   = $min_len;
            $bucket->{longest}    = $max_len;
            $bucket->{average}    = $bucket->{bases} / $bucket->{reads_scanned};
            $bucket->{median}     = $hist_quantile->($bucket->{read_len_hist}, 0.50);
            $bucket->{q1}         = $hist_quantile->($bucket->{read_len_hist}, 0.25);
            $bucket->{q3}         = $hist_quantile->($bucket->{read_len_hist}, 0.75);
            $bucket->{q05}        = $hist_quantile->($bucket->{read_len_hist}, 0.05);
            $bucket->{gc_pct}     = sprintf("%.5f", 100 * $bucket->{gc_bases} / $bucket->{bases});
            $bucket->{n_pct}      = sprintf("%.5f", 100 * $bucket->{n_bases} / $bucket->{bases});
            $bucket->{av_q_score} = sprintf("%.3f", $bucket->{qual_sum} / $bucket->{bases});
        }
        else {
            $bucket->{shortest}   = 0;
            $bucket->{longest}    = 0;
            $bucket->{average}    = 0;
            $bucket->{median}     = 0;
            $bucket->{q1}         = 0;
            $bucket->{q3}         = 0;
            $bucket->{q05}        = 0;
            $bucket->{gc_pct}     = sprintf("%.5f", 0);
            $bucket->{n_pct}      = sprintf("%.5f", 0);
            $bucket->{av_q_score} = sprintf("%.3f", 0);
        }

        $bucket->{estimated_bracken_readlength} =
            $bucket->{median} && $bucket->{median} > 0
            ? nearest_bracken_readlength($bucket->{median})
            : $DEFAULT_READLENGTH;

        $bucket->{adapter_pct} =
            $bucket->{adapters_checked}
            ? sprintf("%.5f", 100 * $bucket->{adapters_found} / $bucket->{adapters_checked})
            : sprintf("%.5f", 0);

        $bucket->{header_format}         = $dominant_value->($bucket->{header_patterns})         || "unknown";
        $bucket->{source_guess}          = $dominant_value->($bucket->{source_patterns})         || "unknown";
        $bucket->{platform_guess}        = $dominant_value->($bucket->{platform_guesses})        || "unknown";
        $bucket->{instrument_type_guess} = $dominant_value->($bucket->{instrument_type_guesses}) || "unknown";

        $bucket->{instrument} = $dominant_value->($bucket->{instruments}) || "";
        $bucket->{flowcell}   = $dominant_value->($bucket->{flowcells})   || "";
        $bucket->{run_number} = $dominant_value->($bucket->{run_numbers}) || "";
        $bucket->{lane}       = $dominant_value->($bucket->{lanes})       || "";

        $bucket->{machine_alias} = "";
        if ($bucket->{instrument} ne "" && exists $machine_aliases_ref->{ $bucket->{instrument} }) {
            $bucket->{machine_alias} = $machine_aliases_ref->{ $bucket->{instrument} };
        }

        $bucket->{looks_long_read}  = 0;
        $bucket->{long_read_reason} = "";

        if ($bucket->{median} > 600) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Median read length > 600 bp";
        }
        elsif ($bucket->{q3} > 1000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Upper quartile read length > 1000 bp";
        }
        elsif ($bucket->{longest} > 5000) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Observed reads > 5000 bp";
        }
        elsif ($bucket->{platform_guess} =~ /^(ONT|PacBio)$/i) {
            $bucket->{looks_long_read}  = 1;
            $bucket->{long_read_reason} = "Header format suggests long-read platform";
        }

        if ($bucket->{looks_long_read}) {
            push @{ $bucket->{warnings} }, "Reads may represent long-read data: $bucket->{long_read_reason}";
        }

        if ($bucket->{zero_length_reads} > 0) {
            my $pct = $bucket->{reads_scanned} > 0
                ? sprintf("%.1f", 100 * $bucket->{zero_length_reads} / $bucket->{reads_scanned})
                : "?";
            push @{ $bucket->{warnings} },
                "Zero-length reads detected: $bucket->{zero_length_reads} of $bucket->{reads_scanned} scanned ($pct%). "
              . "Some downstream tools (fastp, bowtie2, SPAdes) do not tolerate empty reads.";
        }

        return $bucket;
    };

    $finalize_bucket->($res{R1});
    $finalize_bucket->($res{R2});
    $finalize_bucket->($res{total});

    # Warn if either file produced zero reads (likely empty or unreadable)
    for my $key (qw(R1 R2)) {
        if ($res{$key}{reads_scanned} == 0 && defined $res{files}[0]) {
            push @{ $res{$key}{warnings} },
                "No reads scanned -- file may be empty or unreadable";
        }
    }

    # For PE samples: verify R1 and R2 appear to be from the same run.
    # Instrument + flowcell mismatch is a strong signal of mis-paired files
    # -- flag as a fatal issue so postprocess can stop the sample.
    $res{total}{fatal_issues} //= [];
    if ($fq2 ne "" && $res{R1}{reads_scanned} > 0 && $res{R2}{reads_scanned} > 0) {
        my $r1_inst = (sort { $res{R1}{instruments}{$b} <=> $res{R1}{instruments}{$a} }
                       keys %{ $res{R1}{instruments} })[0] // "";
        my $r2_inst = (sort { $res{R2}{instruments}{$b} <=> $res{R2}{instruments}{$a} }
                       keys %{ $res{R2}{instruments} })[0] // "";
        my $r1_fc   = (sort { $res{R1}{flowcells}{$b} <=> $res{R1}{flowcells}{$a} }
                       keys %{ $res{R1}{flowcells} })[0] // "";
        my $r2_fc   = (sort { $res{R2}{flowcells}{$b} <=> $res{R2}{flowcells}{$a} }
                       keys %{ $res{R2}{flowcells} })[0] // "";

        if ($r1_inst ne "" && $r2_inst ne "" && $r1_inst ne $r2_inst) {
            push @{ $res{total}{fatal_issues} },
                "R1/R2 instrument mismatch -- files may not be paired correctly "
              . "(R1: $r1_inst, R2: $r2_inst)";
        }
        if ($r1_fc ne "" && $r2_fc ne "" && $r1_fc ne $r2_fc) {
            push @{ $res{total}{fatal_issues} },
                "R1/R2 flowcell mismatch -- files may not be paired correctly "
              . "(R1: $r1_fc, R2: $r2_fc)";
        }
    }

    # R1/R2 read names, pair by pair (fastq_pair_name_check)
    if ($fq2 ne "") {
        $res{total}{pair_check} = fastq_pair_name_check($fq1, $fq2, $MAX_SCAN_READS);
    }

    # Outfolder must be defined -- if not, it's a bug in the caller.
    # Don't graceful_die (we're in a fork -- it would kill just the fork
    # process); instead warn to STDERR and return 1 (failure exit code).
    # The parent will see a non-zero exit and log it as a pipeline error.
    unless (defined $outfolder && $outfolder ne "") {
        warn "fastq_prescan_internal: outfolder not defined (caller bug)\n";
        return 1;
    }

    my $folder = fill_placeholders($outfolder, $samplenr);
    ensure_dir($folder);

    my $json_path = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.json"), $samplenr);
    my $txt_path  = fill_placeholders(File::Spec->catfile($folder, "__BASE__.prescan.txt"),  $samplenr);

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1);

    open(my $jfh, ">", $json_path) or graceful_die("fastq_prescan: Cannot write [$json_path]: $!");
    print {$jfh} $json->encode(\%res);
    close($jfh) or graceful_die("fastq_prescan: Failed closing [$json_path]: $!");

    open(my $tfh, ">", $txt_path) or graceful_die("fastq_prescan: Cannot write [$txt_path]: $!");

    my $print_bucket = sub {
        my ($label, $bucket) = @_;
        print {$tfh} "=== $label ===\n";
        print {$tfh} "Reads scanned: $bucket->{reads_scanned}\n";
        print {$tfh} "Read length (shortest/q05/q1/median/q3/average/longest): "
                   . "$bucket->{shortest} / $bucket->{q05} / $bucket->{q1} / $bucket->{median} / $bucket->{q3} / "
                   . sprintf("%.2f", $bucket->{average}) . " / $bucket->{longest}\n";
        print {$tfh} "Estimated Bracken read length: $bucket->{estimated_bracken_readlength}\n";
        print {$tfh} "Average Phred score: $bucket->{av_q_score}\n";
        print {$tfh} "GC %: $bucket->{gc_pct}\n";
        print {$tfh} "N %: $bucket->{n_pct}\n";
        print {$tfh} "Adapter % (of checked): $bucket->{adapter_pct}\n";
        print {$tfh} "Header format: $bucket->{header_format}\n";
        print {$tfh} "Platform guess: $bucket->{platform_guess}\n";
        print {$tfh} "Source guess: $bucket->{source_guess}\n";
        print {$tfh} "Instrument: $bucket->{instrument}\n";
        print {$tfh} "Instrument type guess: $bucket->{instrument_type_guess}\n";
        print {$tfh} "Machine alias: $bucket->{machine_alias}\n";
        print {$tfh} "Flowcell: $bucket->{flowcell}\n";
        print {$tfh} "Run number: $bucket->{run_number}\n";
        print {$tfh} "Lane: $bucket->{lane}\n";
        print {$tfh} "Looks like long-read data: " . ($bucket->{looks_long_read} ? "yes" : "no") . "\n";
        print {$tfh} "Long-read reason: $bucket->{long_read_reason}\n" if $bucket->{long_read_reason};

        if (@{ $bucket->{warnings} }) {
            print {$tfh} "Warnings:\n";
            print {$tfh} "  - $_\n" for @{ $bucket->{warnings} };
        }

        print {$tfh} "Example headers:\n";
        print {$tfh} "  - $_\n" for @{ $bucket->{header_examples} };
        print {$tfh} "\n";
    };

    print {$tfh} "FASTQ prescan summary\n";
    print {$tfh} "Files:\n";
    print {$tfh} "  R1: " . (defined($fq1) && $fq1 ne "" ? $fq1 : "(none)") . "\n";
    print {$tfh} "  R2: " . (defined($fq2) && $fq2 ne "" ? $fq2 : "(none)") . "\n\n";

    $print_bucket->("R1",    $res{R1});
    $print_bucket->("R2",    $res{R2});
    $print_bucket->("TOTAL", $res{total});

    print {$tfh} "Adapters searched:\n";
    print {$tfh} "  - $_\n" for @constants_adapters;

    close($tfh) or graceful_die("fastq_prescan: Failed closing [$txt_path]: $!");

    return 0;   # internal sub contract: write to file, return 0=success
};

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_sample_prescan;

sub postprocess_sample_prescan {
    my ($samplenr) = @_;

    my $runstep_name = "sample_prescan";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $prescan_json = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    unless (-s $prescan_json) {
        log_message("WARNING: fastq_prescan JSON resultfile not found for sample $sample_name");
        return 0;
    }

    my $prescan_ref = read_json($prescan_json);

    unless ($prescan_ref && ref($prescan_ref) eq 'HASH') {
        log_message("WARNING: fastq_prescan JSON could not be parsed for sample $sample_name");
        set_runtime_issue($samplenr, "warning", "sample_prescan: JSON result unreadable");
        return 0;
    }

    # Surface fatal issues (e.g. R1/R2 mismatch) -- stop the sample immediately.
    # These were written by the internal sub (which runs in a fork and cannot
    # call set_runtime_issue directly).
    for my $issue (@{ $prescan_ref->{total}{fatal_issues} // [] }) {
        log_message("ERROR: sample_prescan [$sample_name]: $issue", "red");
        set_runtime_issue($samplenr, "fail", "sample_prescan: $issue");
    }
    return 0 if $R_samples->[$samplenr]{fatal_error};   # stop early if fatal

    # Surface non-fatal warnings from any bucket
    for my $bucket_key (qw(R1 R2 total)) {
        for my $w (@{ $prescan_ref->{$bucket_key}{warnings} // [] }) {
            log_message("WARNING: sample_prescan [$sample_name] $bucket_key: $w", "yellow");
            set_runtime_issue($samplenr, "warning", "sample_prescan $bucket_key: $w");
        }
    }

    # R1/R2 read names: the QC measure qscore_raw_pair_name_mismatch_pct
    # (thresholds in the config), and a runtime warning with examples.
    # Prescan results made before the check existed: check now.
    my $raw = $R_samples->[$samplenr]{paths}{raw} // {};
    if ( ( $raw->{R2} // "" ) ne "" && !exists $prescan_ref->{total}{pair_check} ) {
        $prescan_ref->{total}{pair_check} = fastq_pair_name_check( $raw->{R1}, $raw->{R2},
                                                                   $R_cfg->{sample_prescan}{max_scan_reads} // 5000 );
    }
    my $pc = $prescan_ref->{total}{pair_check};
    if ( ref $pc eq 'HASH' ) {
        $R_samples->[$samplenr]{main_results}{qscore}{raw}{pair_name_mismatch_pct} = $pc->{mismatch_pct};
        if ( $pc->{mismatched} ) {
            my $ex = join( "; ", map { "R1 '$_->[0]' / R2 '$_->[1]'" } @{ $pc->{examples} // [] } );
            my $msg = "read names differ between R1 and R2 in $pc->{mismatched} of $pc->{compared} pairs scanned"
                    . " ($pc->{mismatch_pct} %)"
                    . ( $pc->{mismatched} * 2 > $pc->{compared}
                        ? " -- the R1 and R2 files probably do not belong together (renamed or mixed up?)" : "" )
                    . ( $ex ne "" ? "; e.g. $ex" : "" );
            # A few mismatched pairs occur in usable data: logged, but only a
            # runtime issue above 0.5 % (the QC measure has its own thresholds).
            log_message( "WARNING: sample_prescan [$sample_name]: $msg", "yellow" );
            set_runtime_issue( $samplenr, "warning", "sample_prescan: $msg" ) if ( $pc->{mismatch_pct} // 0 ) > 0.5;
        }
        if ( $pc->{mates_swapped} ) {
            my $msg = "the reads in the R1 file are marked as read 2, and those in R2 as read 1: the R1 and R2 files look swapped";
            log_message( "WARNING: sample_prescan [$sample_name]: $msg", "yellow" );
            set_runtime_issue( $samplenr, "warning", "sample_prescan: $msg" );
        }
    }

    # Consumed by find_species_kraken2's bracken command.
    my $bracken_len = $prescan_ref->{R1}{estimated_bracken_readlength}
                    // $prescan_ref->{SE}{estimated_bracken_readlength}
                    // $prescan_ref->{total}{estimated_bracken_readlength}
                    // 150;
    $R_samples->[$samplenr]{bracken_readlength} = $bracken_len;

    $R_samples->[$samplenr]{results}{fastq_prescan} = $prescan_ref;

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "FASTQ prescan results (text)",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.txt",  $samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "FASTQ prescan results (JSON)",
        type  => "json",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.json", $samplenr, $runstep_name)),
    );

    $R_samples->[$samplenr]{main_results}{run_data}{platform_guess}         = $prescan_ref->{total}{platform_guess}         // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{instrument}             = $prescan_ref->{total}{instrument}             // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{instrument_type_guess}  = $prescan_ref->{total}{instrument_type_guess}  // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{machine_alias}          = $prescan_ref->{total}{machine_alias}          // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{flowcell}               = $prescan_ref->{total}{flowcell}               // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{run_number}             = $prescan_ref->{total}{run_number}             // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{lane}                   = $prescan_ref->{total}{lane}                   // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{looks_long_read}        = $prescan_ref->{total}{looks_long_read}        // "n/a";
    $R_samples->[$samplenr]{main_results}{run_data}{long_read_reason}       = $prescan_ref->{total}{long_read_reason}       // "n/a";

    # first max_scan_reads reads only; the QC measure uses fastp's whole-file value (raw.n_pct, set by fastp_rawdata)
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{n_pct_prescan}      = $prescan_ref->{total}{n_pct}                  // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{n_pct}            //= $prescan_ref->{total}{n_pct}                  // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_q_score}          = $prescan_ref->{total}{av_q_score}             // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len}         = $prescan_ref->{total}{average}                // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len}        = $prescan_ref->{total}{q3}                     // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len}        = $prescan_ref->{total}{median}                 // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len}        = $prescan_ref->{total}{q1}                     // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len}        = $prescan_ref->{total}{q05}                    // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{adapter_pct}         = $prescan_ref->{total}{adapter_pct}            // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{gc}                  = $prescan_ref->{total}{gc_pct}                 // "n/a";
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{longest_read_len}    = $prescan_ref->{total}{longest}                // "n/a";

    $R_samples->[$samplenr]{main_results}{qscore}{raw}{av_read_len_rel}     = safe_rel($prescan_ref->{total}{average}, $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P75_read_len_rel}    = safe_rel($prescan_ref->{total}{q3},      $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P50_read_len_rel}    = safe_rel($prescan_ref->{total}{median},  $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P25_read_len_rel}    = safe_rel($prescan_ref->{total}{q1},      $prescan_ref->{total}{longest}, "n/a");
    $R_samples->[$samplenr]{main_results}{qscore}{raw}{P05_read_len_rel}    = safe_rel($prescan_ref->{total}{q05},     $prescan_ref->{total}{longest}, "n/a");

    return 1;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep find_species_kraken2


$runstep_name = "find_species_kraken2";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 8 },
      # [kraken2] parallel_threads/parallel_ram_gb also apply to this step
      config_section => 'kraken2',

      message    => "Determining species (using kraken2)...",
      long_name  => "species identification (using kraken2)",
      output_dir => "__DIR-QC1__/species_determination_kraken2",
      resultfile => "__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",

      # requires prescan_done: bracken's read-length parameter is a real data
      # dependency set by sample_prescan.
      # requires trimmed_fastq: species determination runs on fastp-trimmed reads
      # (not raw) -- adapter-free reads produce cleaner k-mer hits and better
      # classification. This means fastp_rawdata must complete first, but it's
      # fast (~30-60s) and the quality improvement is worth it.
      # downsampling_bbmap in turn requires species_determined -- it uses
      # species-specific maxdepth from config -- forming the chain:
      #   prescan + fastp → find_species → downsampling
      requires   => [ 'prescan_done', 'trimmed_fastq' ],
      produces   => [ 'species_determined' ],
      applies_if => sub {
          my ($i) = @_;
          return $R_cfg->{kraken2}{enabled} ? 1 : 0;
      },
};


# TEMPLATES---------------------------------

$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd(<<CMD);
    zcat __R1T__ | head -n 400000 | gzip > __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__
    zcat __R2T__ | head -n 400000 | gzip > __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__  
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db __KRAKENDB__
       --paired __OUTDIR__/tmpR1.fastq.gz __OUTDIR__/tmpR2.fastq.gz
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmpR1.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmpR2.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
CMD


$runstep{$runstep_name}{cmd_template}{SE} = wrap_cmd(<<CMD);
    zcat __SET__ | head -n 400000 | gzip > __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__
    conda run -n $R_cfg->{kraken2}->{env} --no-capture-output kraken2 
       --report __OUTDIR__/kraken2-__BASE__.report 
       --threads __THREADS__ 
       --db __KRAKENDB__
       __OUTDIR__/tmpSE.fastq.gz
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmpSE.fastq.gz
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.bracken
       -r __READLEN__
       __HIDE-OUTPUT__
    __NEWCOMMAND__
    conda run -n $R_cfg->{bracken}->{env} --no-capture-output bracken
       -d __BRACKENDB__
       -i __OUTDIR__/kraken2-__BASE__.report
       -o __OUTDIR__/__BASE__.genus.bracken
       -r __READLEN__
       -l G
       __HIDE-OUTPUT__
CMD

$runstep{$runstep_name}{cmd_template}{FASTA} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{kraken2}->{env}  --no-capture-output kraken2
       --report __OUTDIR__/kraken2-__BASE__.report
       --threads __THREADS__  
       --db __KRAKENDB__
       __FASTA__
       > __OUTDIR__/tmp.krakenout.txt
       __HIDE-STDERR__
    __NEWCOMMAND__
    rm __OUTDIR__/tmp.krakenout.txt
CMD


# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_find_species_kraken2;

sub test_find_species_kraken2 {
    my $r_kraken2 = check_conda_tool("kraken2");
    my $r_bracken = check_conda_tool("bracken");

    return 2 if $r_kraken2 == 2 || $r_bracken == 2;   # already tested this run
    return ($r_kraken2 && $r_bracken) ? 1 : 0;
}

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_find_species_kraken2;

sub preprocess_find_species_kraken2 {

    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";

    my $sample_name = $R_samples->[$samplenr]{name};
    my $sample_type = $R_samples->[$samplenr]{type};

    my $command         = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile      = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    ###################################
    ### check essential requirements

    if ($sample_type eq "PE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__R1__", "__R2__");
    }

    if ($sample_type eq "SE") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__SE__");
    }

    if ($sample_type eq "FASTA") {
        return "" unless require_input_files($samplenr, $runstep_name, "fatal", "__FASTA__");
    }

    # Skip only if the result already exists
    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_find_species_kraken2($samplenr);
        return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # Ensure output dir exists
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));

    # Set by sample_prescan's postprocessing, which requires() guarantees
    # has already run for FASTQ samples; defaults to 150 for FASTA (where
    # prescan never applies and this value isn't actually used downstream).
    my $bracken_len = $R_samples->[$samplenr]{bracken_readlength} // 150;

    # check for database file
    if (!test_db_kraken2()) {
        log_message("WARNING: Kraken2 database is missing. Kraken2 will be skipped.", "red");
        return "";
    }

    # runstep specific replacements
    _fill_placeholders__safe_replace(\$command, "__READLEN__", $bracken_len);

    # format command
    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}


# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_find_species_kraken2;

sub postprocess_find_species_kraken2 {
    my ($samplenr) = @_;

    my $runstep_name = "find_species_kraken2";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    my $resultfile   = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    #################
    # parse kraken/bracken results

    my $bracken_resultfile = fill_placeholders("__OUTDIR__/__BASE__.bracken",$samplenr,$runstep_name);
    my $bracken_resultfile_genus = fill_placeholders("__OUTDIR__/__BASE__.genus.bracken",$samplenr,$runstep_name);

    if(-f $bracken_resultfile){
      my $bracken_results_ref = parse_bracken_results($bracken_resultfile,'S');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species} = $bracken_results_ref;
      if (!$bracken_results_ref || !%{$bracken_results_ref}) {
        log_message("WARNING: bracken-species (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") { 
         log_message("WARNING: No bracken (pre-check) resultfile (species level) found for sample $sample_name");  
      } 
    }      
    if(-f $bracken_resultfile_genus){
      my $bracken_results_ref_genus = parse_bracken_results($bracken_resultfile_genus,'G');
      $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus} = $bracken_results_ref_genus;
      if (!$bracken_results_ref_genus || !%{$bracken_results_ref_genus}) {
        log_message("WARNING: bracken-genus (pre-check) data could not be parsed for sample $sample_name" );
      }
    }
    else{
      if($sample_type ne "FASTA") {     
         log_message("WARNING: No bracken resultfile (genus level) found for sample $sample_name");   
      }
    }  
    if(-f $resultfile){
      my $kraken_results_ref = parse_kraken2_results($resultfile);
      $R_samples->[$samplenr]{results}{$runstep_name}{kraken2} = $kraken_results_ref;
      if (!$kraken_results_ref || !%{$kraken_results_ref}) {
        log_message("WARNING: kraken (pre-check) data could not be parsed for sample $sample_name" );
      }      
    }
    else{
      log_message("WARNING: No kraken2 (pre-check) resultfile found for sample $sample_name");   
      return 0; 
    }  

    # Links used by the HTML reports.
    register_raw_output($samplenr, $runstep_name,
        title => "Kraken2 classification report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__.report",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Bracken species report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_species.report",$samplenr, $runstep_name)),
    );
    register_raw_output($samplenr, $runstep_name,
        title => "Bracken genus report",
        type  => "txt",
        path  => path_relative_to_outdir(fill_placeholders("__DIR-QC1__/species_determination_kraken2/kraken2-__BASE__" . "_bracken_genuses.report",$samplenr, $runstep_name)),
    ); 
    
    
    #######################################  
    ## assign genus level taxonomy
    my $genus_method = "bracken";
    my $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{name} // "n/a";
    my $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{genus}{entries}[0]{percent} // 0;    
    my $percent_int = int($genus_result_percent);  
    
    if($genus_result eq "n/a"){   
       $genus_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{name} // "n/a";
       $genus_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{genus}[0]{percent} // 0;    
       $percent_int = int($genus_result_percent);
       $genus_method = "kraken2";   
    }
    

    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus} = $genus_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} = $genus_method;  
 

    
    
    #######################################  
    ## assign species level taxonomy  
    my $species_method = "bracken";    
    my $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{name} // "n/a";
    my $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{bracken}{species}{entries}[0]{percent} // 0; 
    $percent_int = int($species_result_percent);   
     
    if($species_result eq "n/a"){
       $species_result         = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{name} // "n/a";   
       $species_result_percent = $R_samples->[$samplenr]{results}{$runstep_name}{kraken2}{species}[0]{percent}// 0;
       $percent_int = int($species_result_percent); 
       $species_method = "kraken2"; 
    } 
    
       
    ## MAIN RESULTS
    $R_samples->[$samplenr]{main_results}{taxonomy}{species} = $species_result;
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_score} = $percent_int;   
    $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} = $species_method;  

    # load_expectations()/estimate_genomesize()/compute_targetbases() used to
    # run here. Moved out (runstep machinery design doc, §15): genomesize/
    # targetbases now computed in downsampling_bbmap's own preprocessing
    # (where they're actually used), and load_expectations now runs once,
    # late, right before QC evaluation -- by which point species (if
    # determinable at all) is reliably known, giving species-specific
    # thresholds instead of generic ones, with no functional change for any
    # sample where species-ID is disabled (get_config_value_for_species()
    # already falls back to defaults for an unknown/empty species).

    log_message("NOTICE: Sample $sample_name: genus is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{genus} (score $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}%) ","green");  
    log_message("NOTICE: Sample $sample_name: species is detected as: $R_samples->[$samplenr]{main_results}{taxonomy}{species} (score $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}%) ","green"); 

    return 1; # success
}


sub test_db_kraken2{
  # Use db_test if set (resolve_and_verify_databases updates it to the frozen path).
  # Fall back to db_path + hash.k2d for backwards compatibility.
  my $testfile_krakendb;
  my $db_test = $R_cfg->{kraken2}{db_test} // "";
  if ($db_test ne "") {
      $testfile_krakendb = fill_placeholders($db_test);
  } else {
      $testfile_krakendb = fill_placeholders( normalize_path($R_cfg->{kraken2}->{db_path}) . "/hash.k2d" );
  }
  return (-f $testfile_krakendb) ? 1 : 0;
}

##
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{unclassified_percent}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{species}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{species}[]{percent}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{genus}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{kraken2}{genus}[]{percent}
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{species}{entries}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{species}{entries}[]{percent}
##
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{genus}{entries}[]{name}
##  $R_samples->[$samplenr]{results}{find_species_kraken2}{bracken}{genus}{entries}[]{percent}
##
##
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus}
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_score}   
##    $R_samples->[$samplenr]{main_results}{taxonomy}{genus_method} 
##
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species}
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species_score}   
##    $R_samples->[$samplenr]{main_results}{taxonomy}{species_method} 
##
##
##
##
    

# estimate_genomesize() sets maxdepth/fatal_mindepth/fatal_q30_mindepth/gc/
# estimated_genomesize together -- needed broadly (coverage calculations in
# fastp_rawdata's and fastq_stats_trimmed's postprocessing, not just
# downsampling), so this is callable from anywhere, idempotently.
# compute_targetbases() is purely downsampling-specific, so it gets its own,
# narrower helper that still ensures genomesize is available first.
#
# The values depend on the species (per-species maxdepth/genomesize in the
# config), and the first call often comes before the species is known
# (fastp_rawdata's coverage numbers). So the cache remembers which species
# it was computed for and is recomputed when that changes -- otherwise
# downsampling would use the generic values. The expensive k-mer estimate
# (jellyfish) does not depend on the species and is computed only once
# (kmer_genomesize).
sub ensure_genomesize_computed {
    my ($samplenr) = @_;
    my $s  = $R_samples->[$samplenr];
    my $sp = $s->{main_results}{taxonomy}{species} // "";
    return if defined $s->{estimated_genomesize} && ( $s->{_genomesize_species} // "" ) eq $sp;
    estimate_genomesize($samplenr);
    $s->{_genomesize_species} = $sp;
    delete $s->{targetbases};   # derived from the values just recomputed
}

###################################################################################################
## validate_settings (B1): check the values that are otherwise only read
## when a step is about to run (a bad timeout would stop the run halfway),
## or silently fall back to a default. All problems are reported at once.

sub duration_is_valid {
    my ($s) = @_;
    return 1 if !defined $s;
    $s =~ s/^\s+|\s+$//g;
    return 1 if $s eq "" || $s =~ /^(0|none|off|\d+)$/i;
    $s = lc $s; $s =~ s/,//g;
    return $s =~ /^(?:\s*\d+(?:\.\d+)?\s*[dhms]\s*)+$/ ? 1 : 0;
}

# Species settings (B6): species sections accept any key, so a typo there
# used to be silently without effect, and a threshold that could not be read
# simply disappeared. Warns -- does not stop the run -- for
#   - a warning_/critical_/fail_/expected_ key whose rest is not a measure
#     in %QC_MEASURE_DEF;
#   - any other key that no species setting uses;
#   - a threshold value parse_threshold_string() cannot read (e.g. the range
#     form 0.85-1.15), or of which a part is not used.
sub validate_species_settings {
    my %known = map { $_ => 1 } qw(
        genomesize gc maxdepth crossreactive_genus crossreactive_species
        fatal_mindepth fatal_q30_mindepth assembly_size_tolerance main_assembly
        schema filter species name
    );
    for my $sp ( values %{ $rundata{config}{defaults}{species} // {} } ) {
        $known{$_} = 1 for keys %{ $sp // {} };
    }
    my @valid_keys = ( keys %known,
        map { my $m = $_; map { "${_}_$m" } qw(warning critical fail expected) } @measures );
    my $n = 0;
    for my $name ( sort keys %{ $R_cfg_species // {} } ) {
        my $sec = $R_cfg_species->{$name};
        next unless ref $sec eq 'HASH';
        my $where = $name eq 'default' ? "[species default]" : "[species__$name]";
        for my $key ( sort keys %$sec ) {
            my $value = $sec->{$key};
            next if ref $value;
            if ( $key =~ /^(warning|critical|fail|expected)_(.+)$/ ) {
                my ($level, $measure) = ($1, $2);
                unless ( exists $QC_MEASURE_DEF{$measure} ) {
                    my @near = closest_names( $key, \@valid_keys );
                    log_message("WARNING: $where $key: [$measure] is not a QC measure, so this threshold has no effect"
                              . ( @near ? " (did you mean " . join(" or ", @near) . "?)" : "" ), "red");
                    $n++;
                    next;
                }
                next if $level eq 'expected';
                next if !defined $value || $value =~ /^\s*(?:n\/a)?\s*$/i;
                if ( $value =~ /^\s*efsa\s*$/i ) {     # Q30 limit by read length (q30_read_length_threshold)
                    unless ( $measure =~ /_q30_rate$/ ) {
                        log_message("WARNING: $where $key=[efsa]: \"efsa\" (the Q30 limit by read length) only works for "
                                  . "the Q30 rate measures, so this threshold has no effect", "red");
                        $n++;
                    }
                    next;
                }
                my $thr = parse_threshold_string($value);
                if ( !$thr ) {
                    log_message("WARNING: $where $key=[$value] cannot be read as a threshold and is ignored -- "
                              . "write one or more conditions such as <0.85 or \"<0.85 >1.15\"", "red");
                    $n++;
                    next;
                }
                ( my $rest = $value ) =~ s/(<=|>=|<|>|==|!=|=)\s*[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?//g;
                $rest =~ s/\bor\b/ /gi;   # "<0.85 or >1.15" reads as intended
                if ( $rest !~ /^[\s,;]*$/ ) {
                    $rest =~ s/^[\s,;]+|[\s,;]+$//g;
                    $rest =~ s/\s{2,}/ /g;
                    log_message("WARNING: $where $key=[$value]: the part [$rest] is not a condition and is ignored "
                              . "(used: " . join(" ", map { "$_->{op}$_->{value}" } @{ $thr->{conditions} }) . ")", "red");
                    $n++;
                }
                next;
            }
            next if $known{$key};
            my @near = closest_names( $key, \@valid_keys );
            log_message("WARNING: $where $key is not a species setting the pipeline uses -- it has no effect"
                      . ( @near ? " (did you mean " . join(" or ", @near) . "?)" : "" ), "red");
            $n++;
        }
    }
    return $n;
}

sub validate_settings {
    validate_species_settings();
    my @problems;
    my $g = $R_cfg->{general} // {};
    my $num = sub { my ($v) = @_; defined $v && $v =~ /^\s*\d+(?:\.\d+)?\s*$/ };

    # time limits: general.timeout and <tool>.timeout
    for my $sec ( sort keys %$R_cfg ) {
        next unless ref $R_cfg->{$sec} eq 'HASH' && exists $R_cfg->{$sec}{timeout};
        my $v = $R_cfg->{$sec}{timeout};
        push @problems, "$sec.timeout=[$v] is not a time (e.g. 30m, 2h, 1h30m, 0 = no limit)" unless duration_is_valid($v);
    }
    # numbers
    push @problems, "threads=[$g->{threads}] must be a whole number of at least 1"
        unless defined $g->{threads} && $g->{threads} =~ /^\s*\d+\s*$/ && $g->{threads} >= 1;
    for my $k (qw(max_threads max_ram_gb)) {
        push @problems, "$k=[$g->{$k}] must be a number (0 = detect automatically)" if defined $g->{$k} && !$num->($g->{$k});
    }
    if ( defined $g->{parallel_headroom} ) {
        my $h = $g->{parallel_headroom};
        push @problems, "parallel_headroom=[$h] must be a number above 0 and at most 1 (e.g. 0.85)"
            unless $num->($h) && $h > 0 && $h <= 1;
    }
    for my $sec ( sort keys %$R_cfg ) {
        next unless ref $R_cfg->{$sec} eq 'HASH' && $sec ne 'general';
        for my $k (qw(parallel_threads parallel_ram_gb)) {
            next unless exists $R_cfg->{$sec}{$k};
            my $v = $R_cfg->{$sec}{$k};
            push @problems, "$sec.$k=[$v] must be a positive number" unless $num->($v) && $v > 0;
        }
    }
    # choices
    my %choices = (
        parallel_mode  => [qw(on off)],
        overwrite      => [qw(prompt yes no resume extend)],
        chewbbaca_mode => [qw(per_sample per_species_batch)],
        checkm_mode    => [qw(per_sample per_species_batch)],
    );
    for my $k ( sort keys %choices ) {
        next unless defined $g->{$k};
        my $v = lc( $g->{$k} );
        push @problems, "$k=[$g->{$k}] must be one of: " . join(", ", @{ $choices{$k} })
            unless grep { $_ eq $v } @{ $choices{$k} };
    }
    # main_assembly (general and per species): a criterion or an assembler
    my @criteria   = qw(fewest_contigs fewest_contigs500 best_n50);
    my @assemblers = grep { ref $R_cfg->{$_} eq 'HASH' && exists $R_cfg->{$_}{enabled} } qw(spades skesa shovill shovill_spades shovill_skesa);
    my @ma = ( [ "main_assembly", $g->{main_assembly}, $g ] );
    push @ma, map { [ "species $_ main_assembly", $R_cfg->{species}{$_}{main_assembly}, $R_cfg->{species}{$_} ] }
              grep { ref $R_cfg->{species}{$_} eq 'HASH' && defined $R_cfg->{species}{$_}{main_assembly} } sort keys %{ $R_cfg->{species} // {} };
    for my $m (@ma) {
        my ($label, $v, $h) = @$m;
        next unless defined $v && $v ne "";
        # Unicycler was removed (no longer maintained): old configs keep working
        if ( lc $v eq "unicycler" ) {
            log_message("WARNING: $label=unicycler: Unicycler is no longer part of the pipeline -- using the automatic choice instead", "yellow");
            if ( $h == $g ) { $h->{main_assembly} = "fewest_contigs500"; }
            else            { delete $h->{main_assembly}; }   # species: falls back to general
            next;
        }
        push @problems, "$label=[$v] must be one of: " . join(", ", 'fewest_contigs', 'fewest_contigs500', 'best_N50', @assemblers)
            unless grep { $_ eq lc $v } @criteria, @assemblers;
    }
    if ( defined $g->{mlst_determination} && $g->{mlst_determination} ne ""
         && !( ref $R_cfg->{ lc $g->{mlst_determination} } eq 'HASH' ) ) {
        push @problems, "mlst_determination=[$g->{mlst_determination}] is not a tool (e.g. fastmlst, mlst)";
    }

    return unless @problems;
    log_message("ERROR: Invalid setting: $_", "red") for @problems;
    graceful_die( scalar(@problems) . " invalid setting(s) -- see above. Nothing has been run.");
}

###################################################################################################
## Species scope (general.species_scope) and enabled = auto.

# Set "key = value" in [section] of an INI-style config file, in place:
# replaces an existing (uncommented) key line, otherwise adds the line right
# after the section header (adding the section if missing). Keeps every
# other line, comment and the order. Returns 1 on success.
sub set_config_file_value {
    my ($path, $section, $key, $value) = @_;
    open( my $in, '<', $path ) or do { log_message("WARNING: Cannot read [$path]: $!"); return 0; };
    my @lines = <$in>;
    close $in;
    my ($in_sec, $done, $hdr_idx) = (0, 0, undef);
    for my $k ( 0 .. $#lines ) {
        if ( $lines[$k] =~ /^\s*\[([^\]]+)\]/ ) {
            $in_sec = lc($1) eq lc($section) ? 1 : 0;
            $hdr_idx = $k if $in_sec && !defined $hdr_idx;
            next;
        }
        if ( $in_sec && !$done && $lines[$k] =~ /^\s*\Q$key\E\s*[=:]/i ) {
            $lines[$k] = "$key = $value\n";
            $done = 1;
        }
    }
    unless ($done) {
        if ( defined $hdr_idx ) { splice @lines, $hdr_idx + 1, 0, "$key = $value\n"; }
        else                    { push @lines, "\n[$section]\n$key = $value\n"; }
    }
    my $tmp = "$path.tmp$$";
    open( my $out, '>', $tmp ) or do { log_message("WARNING: Cannot write [$tmp]: $!"); return 0; };
    print {$out} @lines;
    close $out;
    return rename( $tmp, $path ) ? 1 : 0;
}

# [tool] species = "A, B" as an array ref (used by the runstep 'species' field).
sub config_species_list {
    my ($section) = @_;
    my $v = $R_cfg->{$section}{species} // "";
    return [ grep { $_ ne "" } map { s/^\s+|\s+$//gr } split /,/, $v ];
}

# Tool sections that declare the species they are for.
sub species_specific_tools {
    return sort grep { ref $R_cfg->{$_} eq 'HASH' && $_ ne 'general' && $_ ne 'species'
                       && exists $R_cfg->{$_}{enabled} && ( $R_cfg->{$_}{species} // "" ) =~ /\S/ } keys %$R_cfg;
}

# Do two species/genus lists share anything? A genus matches its species
# in either direction (scope "Listeria" covers tool "Listeria monocytogenes",
# scope "Escherichia coli" covers a tool for "Escherichia").
sub species_lists_overlap {
    my ($a, $b) = @_;
    my $norm = sub { my $x = lc shift; $x =~ s/_/ /g; $x =~ s/^\s+|\s+$//g; $x =~ s/\s+/ /g; $x };
    for my $x ( map { $norm->($_) } @$a ) {
        for my $y ( map { $norm->($_) } @$b ) {
            next if $x eq "" || $y eq "";
            return 1 if $x eq $y || index($x, "$y ") == 0 || index($y, "$x ") == 0;
        }
    }
    return 0;
}

# enabled = auto -> 1 if the tool's species overlap general.species_scope,
# else 0. Runs right after the command line is applied, before --setup and
# before the runsteps are built, so everything later sees plain 1/0.
sub resolve_auto_enabled {
    my @scope = grep { $_ ne "" } map { s/^\s+|\s+$//gr } split /,/, ( $R_cfg->{general}{species_scope} // "" );
    my (@on, @off);
    for my $sec ( sort keys %$R_cfg ) {
        next unless ref $R_cfg->{$sec} eq 'HASH' && lc( $R_cfg->{$sec}{enabled} // "" ) eq "auto";
        my $sp = config_species_list($sec);
        my $on = @$sp && species_lists_overlap( $sp, \@scope ) ? 1 : 0;
        $R_cfg->{$sec}{enabled} = $on;
        push @{ $on ? \@on : \@off }, $sec;
    }
    # all species tools that are on, also those switched on directly (enable=)
    my @all_on = grep { ( $R_cfg->{$_}{enabled} // 0 ) eq "1" } species_specific_tools();
    log_message("NOTICE: Species scope: " . ( @scope ? join(", ", @scope) : "(none)" )
              . ( @all_on ? " -- species tools on: " . join(", ", @all_on) : " -- no species tools on" ));
    log_message("INFO: Species tools off (species not in scope): " . join(", ", @off)) if @off;
}

# The install command for the cgMLST schema of a species EURLC-WGS knows a
# schema for, or "" for other species.
sub cgmlst_install_hint {
    my ($species) = @_;
    return "" unless defined $species;
    return "eurlc-wgs --install-efsa-schemas=campylobacter" if $species =~ /^Campylobacter (jejuni|coli)\b/;
    return "eurlc-wgs --install-efsa-schemas=salmonella"    if $species =~ /^Salmonella\b/;
    return "eurlc-wgs --install-efsa-schemas=ecoli"         if $species =~ /^(Escherichia coli|Shigella)\b/;
    return "eurlc-wgs --install-efsa-schemas=listeria"      if $species =~ /^Listeria monocytogenes\b/;
    return "";
}

# Largest genus other than the sample's own, from a Kraken2/Bracken result
# hash ({bracken}{genus}{entries}, fallback {kraken2}{genus}). Skips the main
# genus and the species' crossreactive_genus list (config, comma-separated;
# e.g. Shigella for Escherichia coli, which Kraken cannot separate cleanly).
# Returns (name, percent); ("n/a", 0) if there is none.
sub largest_other_genus {
    my ($res, $main_genus, $species) = @_;
    my @hits = @{ $res->{bracken}{genus}{entries} // [] };
    @hits = @{ $res->{kraken2}{genus} // [] } unless @hits;
    my %skip;
    $skip{ lc $main_genus } = 1 if defined $main_genus && $main_genus ne "n/a";
    if ( defined $species && $species ne "n/a" ) {
        my $cross = get_config_value_for_species($species, 'crossreactive_genus', "") // "";
        $skip{ lc $_ } = 1 for grep { $_ ne "" } split /\s*,\s*/, $cross;
    }
    # no main genus known: the top hit is the sample itself
    my $start = ( defined $main_genus && $main_genus ne "n/a" ) ? 0 : 1;
    for my $k ( $start .. $#hits ) {
        my $name = $hits[$k]{name} // next;
        next if $name eq "n/a" || $skip{ lc $name };
        return ( $name, $hits[$k]{percent} // 0 );
    }
    return ( "n/a", 0 );
}

###################################################################################################
## log/run_status.json (A15): how the run stands, for scripts and a GUI.
## Written when the log starts (state "running"), again when the sample
## list is known, and finally from END on every way out of the program --
## the state then follows from the exit code. Written atomically (tmp +
## rename), so a reader never sees half a file.

our $S_RUN_RESULT;          # ok | warnings | problems, set by print_run_summary
our $S_RUN_STATUS_STARTED;  # time the status file was first written

sub write_run_status {
    my ($state, $exit_code) = @_;
    my $dir = $S_RUN_BANNER_DIR // return;
    return unless -d $dir;
    $S_RUN_STATUS_STARTED //= iso_timestamp();

    my (%counts, @samples);
    $counts{samples} = scalar @{ $R_samples // [] };
    for my $i ( 0 .. $#{ $R_samples // [] } ) {
        my $s  = $R_samples->[$i];
        # QC status only means something once the QC evaluation has run,
        # i.e. in a finished run; before that it would be a default PASS.
        my $qc = $state eq 'finished' ? $s->{report_issues}{summary}{status} : undef;
        $counts{$qc}++ if defined $qc;
        $counts{abandoned}++ if $s->{fatal_error};
        $counts{failed_steps}  += scalar @{ $s->{failed_steps}     // [] };
        $counts{skipped_steps} += scalar @{ $s->{skipped_upstream} // [] };
        push @samples, {
            name          => $s->{name},
            index         => $i,
            type          => $s->{type},
            qc_status     => $qc,
            species       => $s->{main_results}{taxonomy}{species},
            abandoned     => $s->{fatal_error} ? join("; ", @{ $s->{fatal_error_message} // [] }) || "yes" : undef,
            failed_steps  => $s->{failed_steps}     // [],
            skipped_steps => $s->{skipped_upstream} // [],
            expected_failed_steps => $s->{expected_failed_steps} // [],   # data already failed: notes
            expected_skipped      => $s->{expected_skipped}      // [],
        };
    }
    my (%seen, @errors);
    for my $is ( grep { $_->{level} eq "ERROR" } @S_RUN_ISSUES ) {
        push @errors, $is->{text} unless $seen{ $is->{text} }++;
        last if @errors >= 50;
    }
    my $out = eval { abs_path( peekdir("out") ) } // "";
    my $report = $S_QCSCREEN ? "$out/qcscreen_report.html" : "$out/report/main_report.html";

    # Seal status (B13), so a GUI can show it without reading the report.
    my $seal;
    my $seal_path = $R_cfg->{general}{seal} // "";
    if ( $seal_path ne "" && -f $seal_path ) {
        my $r = eval { _verify_config_seal( $seal_path, $rundata{config}{path} // "",
                         $R_cfg->{general}{db_freeze_config} // "", $R_cfg->{general}{conda_manifest} // "" ) };
        $seal = { status => $r->{status}, name => $r->{name},
                  mismatches => $r->{mismatches} // [], overrides => $r->{overrides} // [] } if $r;
    }
    $seal //= { status => "UNSEALED", name => undef, mismatches => [], overrides => [ seal_relevant_overrides() ] };

    my %status = (
        schema_version => 1,
        seal       => $seal,
        pipeline   => $rundata{pipeline_info}{name},
        version    => $rundata{pipeline_info}{version},
        run_number => $S_RUN_NUMBER,
        mode       => $S_QCSCREEN ? "qcscreen" : $S_RUN_MODE,
        parallel   => ( lc( $R_cfg->{general}{parallel_mode} // "off" ) eq "on" ? \1 : \0 ),   # JSON true/false
        state      => $state,
        result     => $state eq "finished" ? $S_RUN_RESULT : undef,
        exit_code  => $exit_code,
        started    => $S_RUN_STATUS_STARTED,
        updated    => iso_timestamp(),
        pid        => $MAIN_PID,
        input      => eval { abs_path( peekdir("in") ) },
        output     => $out,
        counts     => \%counts,
        samples    => \@samples,
        errors     => \@errors,
        report     => ( -f $report ? $report : undef ),
        parallel_use => $rundata{parallel_use},   # B24: budget use in parallel mode, when it ran
        command    => join(" ", basename($0), map { _shell_quote_arg($_) } @ORIGINAL_ARGV),
    );
    my $f = "$dir/run_status.json";
    if ( open( my $fh, '>', "$f.tmp$$" ) ) {
        print {$fh} JSON::MaybeXS->new( utf8 => 1, pretty => 1, canonical => 1 )->encode(\%status);
        close $fh;
        rename "$f.tmp$$", $f;
    }
}

# exit code -> final state
sub run_state_for_exit {
    my ($code) = @_;
    return { 0 => "finished", 3 => "finished", 5 => "finished", 1 => "failed", 2 => "nothing_to_do",
             4 => "interrupted", 6 => "stopped" }->{$code} // "failed";
}

# Typical genome sizes per species, for species that have no genomesize in
# the configuration. Two tab-separated files, same format
#     <species or genus><TAB><size in bp>[<TAB>comment]     (# = comment line)
#   1. <db>/genome_sizes.tsv                 -- local additions/overrides
#   2. share/eurlc-wgs/assets/genome_sizes.tsv (bundled; or assets/ next to
#      the script in a development install)
# An exact species match wins; otherwise a genus-only line. Returns
# (size, source) or () if nothing matches.
my %_genome_size_list;
my $_genome_size_list_loaded = 0;
sub lookup_typical_genome_size {
    my ($species) = @_;
    unless ($_genome_size_list_loaded) {
        $_genome_size_list_loaded = 1;
        my @files = (
            [ ( peekdir("db") // "" ) . "/genome_sizes.tsv", "local list" ],
            [ find_share_file("assets/genome_sizes.tsv"), "bundled list" ],
        );
        for my $f (@files) {
            my ($path, $label) = @$f;
            next unless -f $path;
            open( my $fh, '<', $path ) or next;
            my $n = 0;
            while ( my $line = <$fh> ) {
                next if $line =~ /^\s*(#|$)/;
                chomp $line;
                my ($name, $size) = split /\t/, $line;
                next unless defined $size && $size =~ /^\s*\d+\s*$/;
                ( my $key = lc $name ) =~ s/_/ /g;
                $key =~ s/^\s+|\s+$//g;
                next if exists $_genome_size_list{$key};   # first file wins
                $_genome_size_list{$key} = [ $size + 0, $label ];
                $n++;
            }
            close $fh;
            log_message("INFO: Genome size list [$path]: $n entries");
        }
    }
    ( my $sp = lc( $species // "" ) ) =~ s/_/ /g;
    $sp =~ s/^\s+|\s+$//g;
    return () if $sp eq "";
    return @{ $_genome_size_list{$sp} } if $_genome_size_list{$sp};
    my ($genus) = split / /, $sp;
    return ( $_genome_size_list{$genus}[0], "$_genome_size_list{$genus}[1], genus $genus" ) if $genus && $_genome_size_list{$genus};
    return ();
}

# Raw-read coverage from fastp_rawdata's totals. fastp_rawdata runs before
# the species is known, so its own numbers may lack a genome size; this
# recomputes them at the end of the run.
sub refresh_raw_coverage {
    my ($samplenr) = @_;
    my $s = $R_samples->[$samplenr];
    my $before = $s->{results}{fastp_rawdata}{summary}{before_filtering} or return;
    ensure_genomesize_computed($samplenr);
    my $gs = $s->{estimated_genomesize} // 0;
    return unless $gs =~ /^\d+(?:\.\d+)?$/ && $gs > 0;
    $s->{main_results}{coverage}{raw}{coverage}     = safe_quota( $before->{total_bases}, $gs, "n/a" );
    $s->{main_results}{coverage}{raw}{q30_coverage} = safe_quota( $before->{q30_bases},   $gs, "n/a" );
}

sub ensure_targetbases_computed {
    my ($samplenr) = @_;
    ensure_genomesize_computed($samplenr);
    return if defined $R_samples->[$samplenr]{targetbases};
    compute_targetbases($samplenr);
}

sub estimate_genomesize {

   my ($samplenr) = @_;

    my $sample_type = $R_samples->[$samplenr]{type};     
    my $prespeciescheck_result = $R_samples->[$samplenr]{main_results}{taxonomy}{species};

    ###########################
    ### set the maxdepth
    my $maxdepth = get_config_value_for_species($prespeciescheck_result, 'maxdepth', 0);

    $maxdepth =~ s/[xX\s]+//g if defined $maxdepth;

    if (!defined $maxdepth || $maxdepth !~ /^\d+(?:\.\d+)?$/) {
        $maxdepth = 0;
    }

    $maxdepth = 0 if $maxdepth < 0;

    $R_samples->[$samplenr]{maxdepth} = $maxdepth;
 
    ###########################
    ### set the mindepth
    my $mindepth = get_config_value_for_species($prespeciescheck_result, 'fatal_mindepth', 0);

    $mindepth =~ s/[xX\s]+//g if defined $mindepth;

    if (!defined $mindepth || $mindepth !~ /^\d+(?:\.\d+)?$/) {
        $mindepth = 0;
    }

    $mindepth = 0 if $mindepth < 0;

    $R_samples->[$samplenr]{fatal_mindepth} = $mindepth; 
 
     my $q30mindepth = get_config_value_for_species($prespeciescheck_result, 'fatal_q30_mindepth', 0);

    $q30mindepth =~ s/[xX\s]+//g if defined $q30mindepth;

    if (!defined $q30mindepth || $q30mindepth !~ /^\d+(?:\.\d+)?$/) {
        $q30mindepth = 0;
    }

    $q30mindepth = 0 if $q30mindepth < 0;

    $R_samples->[$samplenr]{fatal_q30_mindepth} = $q30mindepth; 
    
    ###########################
    ### set the gc
    my $gc = get_config_value_for_species($prespeciescheck_result, 'gc', 0);

    $gc =~ s/[%\s]+//g if defined $gc;

    if (!defined $gc || $gc !~ /^\d+(?:\.\d+)?$/) {
        $gc = 0;
    }

    $gc = 0 if $gc < 0;

    $R_samples->[$samplenr]{gc} = $gc; 
 
  
    ############################
    ### set the genomesize
    
    my $genomesize = get_config_value_for_species($prespeciescheck_result, 'genomesize', "auto");
    
    # genomesize = kmer: always estimate from the reads (jellyfish), also
    # when the species is in the genome size list -- to check the k-mer
    # estimate, or for a species whose typical size does not fit.
    my $force_kmer = ( $genomesize // "" ) =~ /^\s*kmer\s*$/i ? 1 : 0;
    $genomesize = "auto" if $force_kmer;
    $genomesize  = normalize_genomesize($genomesize);

    # Not in the configuration: typical size from the genome size list
    # (db/genome_sizes.tsv first, then the bundled list) before falling back
    # to the k-mer estimate.
    if ( !$force_kmer
         && ( !defined $genomesize || $genomesize eq "" || $genomesize =~ /^(0|auto)$/i )
         && defined $prespeciescheck_result && $prespeciescheck_result !~ /^(n\/a|)$/i ) {
        my ($size, $source) = lookup_typical_genome_size($prespeciescheck_result);
        if ($size) {
            $R_samples->[$samplenr]{estimated_genomesize}        = $size;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "typical size for $prespeciescheck_result ($source)";
            return;
        }
    }

    if (defined $genomesize && $genomesize ne "" && $genomesize !~ /^(0|auto)$/i) {
      $R_samples->[$samplenr]{estimated_genomesize_method} = "provided estimate for $prespeciescheck_result";
    }  
    elsif ($sample_type eq "FASTA"  ) {
            my $fasta_path = fill_placeholders("__FASTA__",$samplenr);
            my $assemblystats = analyze_assembly_stats($fasta_path);
            $genomesize = (defined $assemblystats && ref($assemblystats) eq 'HASH')
                ? ($assemblystats->{total_length} // 0)
                : 0;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "genomesize of fasta file";
    }    
    else{

        my $R1 = "";
        my $R2 = "";
                
        if($sample_type eq "PE"){
           $R1   = fill_placeholders("__R1__",   $samplenr);
           $R2   = fill_placeholders("__R2__",   $samplenr);
        }  
        if($sample_type eq "SE"){
           $R1   = fill_placeholders("__SE__",   $samplenr);
        }    
        my $base = fill_placeholders("__BASE__", $samplenr);

        # k-mer estimate: once per sample (0 = tried and failed). Not while
        # $S_NO_KMER is set (species not known yet): leave the genome size
        # open, the next call computes it.
        if ( $S_NO_KMER && !exists $R_samples->[$samplenr]{kmer_genomesize} ) {
            $R_samples->[$samplenr]{estimated_genomesize}        = undef;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "pending (species not known yet)";
            return;
        }
        unless ( exists $R_samples->[$samplenr]{kmer_genomesize} ) {
            check_conda_tool("jellyfish");
            $R_samples->[$samplenr]{kmer_genomesize} = determine_genomesize_jellyfish($R1, $R2, $base) // 0;
        }
        $genomesize = $R_samples->[$samplenr]{kmer_genomesize} || undef;

        if (!defined $genomesize) {
            log_message("WARNING: Failed to determine genomesize, falling back to hard coded default value (5 Mb)", "yellow");
            $genomesize = 5000000;
            $R_samples->[$samplenr]{estimated_genomesize_method} = "fallback default after failed k-mer estimate";
        }
        else {
            $R_samples->[$samplenr]{estimated_genomesize_method} = "k-mer based estimate";
        }
    }       

    
    $R_samples->[$samplenr]{estimated_genomesize} = $genomesize;
    
}

##
##
##    $R_samples->[$samplenr]{estimated_genomesize}
##    $R_samples->[$samplenr]{estimated_genomesize_method}   
##
##
##


## Q30 limit by read length, the value "efsa" in a Q30 threshold: EFSA's
## business rule B8 (fastp after filtering) and EURL-AR (Inter-EURL WG on
## NGS, Deliverable 10: after trimming): >= 0.85 for reads up to 75 bp,
## 0.80 up to 150, 0.75 up to 250, 0.70 above. The read length is the mean
## after trimming (as EFSA's ReadMeanLength), else the raw mean. Returns
## (threshold string, note) or (undef, note) when the length is unknown.
sub q30_read_length_threshold {
    my ($samplenr) = @_;
    my $q = $R_samples->[$samplenr]{main_results}{qscore} // {};
    my ($len) = grep { defined $_ && $_ =~ /^[\d.]+$/ && $_ > 0 } ( $q->{trimmed}{av_read_len}, $q->{raw}{av_read_len} );
    return ( undef, "read length unknown: no Q30 limit" ) unless defined $len;
    my $lim = $len <= 75 ? 0.85 : $len <= 150 ? 0.80 : $len <= 250 ? 0.75 : 0.70;
    return ( "<" . sprintf( "%.2f", $lim ),
             sprintf( "EFSA/EURL-AR limit for %.0f-bp reads", $len ) );
}

## cgMLST QC per schema (Nov 2026). The thresholds of the typing_cgmlst_*
## measures depend more on the schema than on the species, so they are
## looked up: the schema's config section [chewbbaca_schema_<name>] -> the
## built-in schema defaults below -> the species -> its genus -> default.
## Every schema the sample was typed with is judged against its own
## thresholds, and the one with the worst status is reported
## (main_results.typing.cgmlst_call_rate/_schema/paralogous/inferred_pct).
# (%CGMLST_SCHEMA_QC_DEFAULTS is declared with the other globals at the top)

sub cgmlst_schema_cfg {
    my ($schema) = @_;
    return undef unless defined $schema && $schema ne "";
    for my $name ( keys %{ $R_cfg->{chewbbaca_schemas} // {} } ) {
        my $s = $R_cfg->{chewbbaca_schemas}{$name};
        next unless ref $s eq 'HASH';
        my $dir = basename( $s->{path} // "" );
        return $s if lc($name) eq lc($schema) || lc($dir) eq lc($schema);
    }
    return undef;
}

sub cgmlst_threshold_value {
    my ($species, $schema, $key) = @_;
    my $s = cgmlst_schema_cfg($schema);
    return $s->{$key} if $s && defined $s->{$key} && $s->{$key} ne "";
    if ( defined $schema ) {
        for my $k ( keys %CGMLST_SCHEMA_QC_DEFAULTS ) {
            return $CGMLST_SCHEMA_QC_DEFAULTS{$k}{$key}
                if lc($k) eq lc($schema) && exists $CGMLST_SCHEMA_QC_DEFAULTS{$k}{$key};
        }
    }
    return get_config_value_for_species($species, $key);
}

sub select_reported_cgmlst_schema {
    my ($samplenr, $species) = @_;
    my $T = $R_samples->[$samplenr]{main_results}{typing} // return;
    my $recs = $T->{cgmlst_schemas};
    return unless ref $recs eq 'ARRAY' && @$recs;
    my %last;
    $last{ $_->{scheme} // "" } = $_ for grep { ref $_ eq 'HASH' } @$recs;   # one per schema (the latest)
    my %rank = ( PASS => 0, WARNING => 1, CRITICAL => 2, FAIL => 3 );
    my $status = sub {
        my ($schema, $measure, $value) = @_;
        return 0 unless defined $value && $value =~ /^-?[\d.]+(?:[eE][-+]?\d+)?$/;
        for my $lvl (qw(fail critical warning)) {
            my $thr = parse_threshold_string( cgmlst_threshold_value( $species, $schema, "${lvl}_$measure" ) );
            return $rank{ uc $lvl } if $thr && threshold_matches( $value, $thr );
        }
        return 0;
    };
    my ($best, $best_key);
    for my $schema ( sort keys %last ) {
        my $r  = $last{$schema};
        my $cr = $r->{call_rate};
        next unless defined $cr && $cr =~ /^-?[\d.]+/;
        my $st = $status->( $schema, 'typing_cgmlst_call_rate', $cr );
        my $sp = $status->( $schema, 'typing_cgmlst_paralogous', $r->{paralogous} );
        my $key = [ ( $st > $sp ? $st : $sp ), -$cr ];      # worst status, then the lowest call rate
        if ( !$best || $key->[0] > $best_key->[0] || ( $key->[0] == $best_key->[0] && $key->[1] > $best_key->[1] ) ) {
            ( $best, $best_key ) = ( $r, $key );
        }
    }
    return unless $best;
    $T->{cgmlst_call_rate}        = $best->{call_rate};
    $T->{cgmlst_call_rate_schema} = $best->{scheme};
    $T->{cgmlst_paralogous}       = $best->{paralogous} // "n/a";
    $T->{cgmlst_inferred_pct}     = $best->{inferred_pct} // "n/a";
    return $best->{scheme};
}

sub load_expectations {
    my ($samplenr) = @_;

    my $species = $R_samples->[$samplenr]{main_results}{taxonomy}{species} // '';

    $R_samples->[$samplenr]{qc_expectations} = {};
    $R_samples->[$samplenr]{qc_checks}       = {};

    # cgMLST: the schema whose status is worst is the one reported, and its
    # thresholds apply (cgmlst_threshold_value)
    my $cg_schema = select_reported_cgmlst_schema( $samplenr, $species );

    foreach my $measure (@measures) {
        my %raw;

        foreach my $level (qw(expected warning critical fail)) {
            my $key = "${level}_$measure";
            $raw{$level} = $measure =~ /^typing_cgmlst_/
                         ? cgmlst_threshold_value( $species, $cg_schema, $key )
                         : get_config_value_for_species($species, $key);
        }

        # "efsa": the Q30 limit for the sample's read length (EFSA B8 / EURL-AR)
        my %tier_note;
        for my $level (qw(warning critical fail)) {
            next unless defined $raw{$level} && $raw{$level} =~ /^\s*efsa\s*$/i;
            if ( $measure !~ /_q30_rate$/ ) { $raw{$level} = undef; next; }
            my ($thr, $note) = q30_read_length_threshold($samplenr);
            $raw{$level}       = $thr;      # undef when the read length is unknown: no threshold
            $tier_note{$level} = $note;
        }

        my $expected = parse_expected_string($raw{expected});
        my $warning  = parse_threshold_string($raw{warning});
        my $critical = parse_threshold_string($raw{critical});
        my $fail     = parse_threshold_string($raw{fail});
        for ( [ warning => $warning ], [ critical => $critical ], [ fail => $fail ] ) {
            $_->[1]{note} = $tier_note{ $_->[0] } if $tier_note{ $_->[0] } && ref $_->[1] eq 'HASH';
        }


        
        $R_samples->[$samplenr]{qc_expectations}{$measure} = {
            expected   => $expected || {},
            thresholds => {
                warning  => $warning,
                critical => $critical,
                fail     => $fail,
            },
        };

        $R_samples->[$samplenr]{qc_checks}{$measure} = {
            observed => undef,
            unit     => $expected->{unit} // '',
            status   => 'NOT_EVALUATED',
            message  => '',
        };
    }

    return 1;
}

##
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{value}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{unit}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{expected}{raw}
##
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{warning}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{critical}
## $R_samples->[$samplenr]{qc_expectations}{$measure}{thresholds}{fail}
##     = undef, if that level has no threshold configured, otherwise:
##     = {
##         conditions => [ { op => '<', value => 30 }, { op => '>', value => 31.6 } ],
##         raw        => '<30 >31.6',   # original config text, used for display
##       }
##     (set by parse_threshold_string(); see threshold_matches() for how
##     conditions are evaluated against an observed value)
##
## $R_samples->[$samplenr]{qc_checks}{$measure}{observed}
## $R_samples->[$samplenr]{qc_checks}{$measure}{unit}
## $R_samples->[$samplenr]{qc_checks}{$measure}{status}
## $R_samples->[$samplenr]{qc_checks}{$measure}{message}
##

sub parse_expected_string {
    my ($text) = @_;

    return {
        value => undef,
        unit  => '',
        raw   => '',
    } unless defined $text && $text ne '';

    $text =~ s/^\s+|\s+$//g;

    my ($value, $unit) = $text =~ /^([<>]?\s*-?\d+(?:\.\d+)?)\s*(.*)$/;

    $unit //= '';
    $unit =~ s/^\s+|\s+$//g;

    return {
        value => defined $value ? $value + 0 : undef,
        unit  => $unit,
        raw   => $text,
    };
}

sub parse_threshold_string {
    my ($text) = @_;

    return undef if !defined $text;
    return undef if ref($text);

    $text =~ s/^\s+|\s+$//g;
    return undef if $text eq '';
    return undef if lc($text) eq 'n/a';

    my @conditions;

    while ($text =~ /(<=|>=|<|>|==|!=|=)\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)/g) {
        push @conditions, {
            op    => $1,
            value => $2 + 0,
        };
    }

    return @conditions
        ? {
            conditions => \@conditions,
            raw        => $text,
        }
        : undef;
}


sub compute_targetbases {

    my ($samplenr) = @_;

    my $setting_targetbases = 0;

    my $genomesize = $R_samples->[$samplenr]{estimated_genomesize};
    my $maxdepth   = $R_samples->[$samplenr]{maxdepth};
    my $method     = $R_samples->[$samplenr]{estimated_genomesize_method} // "";

    if (
        defined $maxdepth &&
        $maxdepth ne "" &&
        $maxdepth !~ /^(0|no|none)$/i &&
        defined $genomesize &&
        $genomesize =~ /^\d+(?:\.\d+)?$/
    ) {
        $setting_targetbases = $maxdepth * $genomesize;

        if ($method eq "k-mer based estimate") {
            my $targetbases_floor = $R_cfg->{species}{default}{targetbases_floor} // 200000000;
            $setting_targetbases = max($setting_targetbases, $targetbases_floor);
        }
    }

    $R_samples->[$samplenr]{targetbases} = int($setting_targetbases);

}


##
##
##   $R_samples->[$samplenr]{targetbases} 
##
##

# Determine genome size estimate from jellyfish histogram
sub determine_genomesize_jellyfish {
    my ($R1, $R2, $basename) = @_;

    my $hist_file = run_jellyfish($R1, $R2, $basename);

    unless (defined $hist_file && -s $hist_file) {
        log_message("WARNING: Jellyfish histogram file missing or empty: $hist_file", "yellow");
        return undef;
    }

    open my $fh, "<", $hist_file or do {
        log_message("WARNING: Could not open jellyfish histogram file: $hist_file ($!)", "yellow");
        return undef;
    };

    my @counts;

    while (<$fh>) {
        chomp;
        next unless /\S/;

        my ($freq, $count) = split;

        # basic sanity check
        next unless defined $count && $count =~ /^\d+(?:\.\d+)?$/;

        push @counts, $count + 0;
    }

    close $fh;

    if (@counts < 10) {
        log_message("WARNING: Jellyfish histogram too small to estimate genome size ($hist_file)", "yellow");
        return undef;
    }

    # Very rough genome size estimation
    my $kmer_sizeestimate = 0;
    for (my $i = 5; $i < @counts; $i++) {
        $kmer_sizeestimate += $counts[$i];
    }

    if ($kmer_sizeestimate <= 0) {
        log_message("WARNING: Jellyfish genome size estimate is zero or invalid ($hist_file)", "yellow");
        return undef;
    }

    return $kmer_sizeestimate / 2;
}


#################################################################################
# Run jellyfish for one sample
sub run_jellyfish {

    my $jellyfish_path            = getdir("out,results,qc,stage1_rawdata") .  "/jellyfish_kmercounts";

    my ($R1, $R2, $basename) = @_;
    my $hist_file = "$jellyfish_path/${basename}_jf.hist";
    my $jf_file   = "$jellyfish_path/${basename}.jf";

    # Build the input command
    my $input_cmd;
    if (defined $R2 && -f $R2) {
        $input_cmd = "zcat -f '$R1' '$R2'";   # -f: uncompressed .fastq too (B22)
    } else {
        $input_cmd = "zcat -f '$R1'";
    }


   
    # Reuse the histogram from an earlier run (resume): the k-mer count is
    # by far the slowest part and the input reads have not changed.
    if ( -s $hist_file ) {
        log_message("INFO: Reusing jellyfish histogram [$hist_file]");
        return $hist_file;
    }

    ensure_dir($jellyfish_path);
    log_message("NOTICE: $basename: estimating genome size from k-mer counts (jellyfish)");
    
    my $count_cmd = "conda run -n $R_cfg->{jellyfish}->{env} --no-capture-output bash -c \"$input_cmd | jellyfish count /dev/fd/0 -t $R_cfg->{general}->{threads} -s 100M -o $jf_file -m 21\"";

    my $histo_cmd = "conda run -n $R_cfg->{jellyfish}->{env} --no-capture-output jellyfish histo -o $hist_file -f $jf_file";

    execute_and_log("$count_cmd ; $histo_cmd", 0, "Estimating genomesize from k-mer profiles (jellyfish)");

    # The .jf binary database is only needed to produce the histogram.
    # Remove it unconditionally once the histogram is written -- it is
    # never used downstream and can be several hundred MB per sample.
    if (-f $jf_file) {
        unlink $jf_file
            or log_message("WARNING: Could not remove jellyfish database [$jf_file]: $!");
        log_message("INFO: Removed jellyfish k-mer database [$jf_file] (histogram kept)");
    }

    return $hist_file;
}







