    ".fq.gz",
    ".fq",
    ".fastq.gz",
    ".fastq"
);


my %runstep;

# "$i,$name" => 1 once a per-sample runstep has been attempted for sample
# $i (run, failed, skipped as already done, or passed over in sequential
# mode). Parent process only. Used by data keys that must wait until a
# whole group has finished, not just until its first member succeeded
# (see all_assemblers_settled).
our %S_RUNSTEP_ATTEMPTED;

# Data-key registry -- see the runstep machinery design doc, §4. Each entry
# is a named, checkable piece of state, independent of any specific
# runstep, that a runstep's "requires" can refer to without needing to know
# which runstep (if any) actually produced it. Deliberately minimal for
# now -- grows as runsteps are migrated to declare requires/produces.
my %data_key = (

    md5_done => {
        check => sub {
            my ($i) = @_;
            my $r = $R_samples->[$i]{results}{md5_rawdata};
            return 0 unless defined $r && ref($r) eq 'HASH';
            return ( defined $r->{R1} || defined $r->{R2} || defined $r->{SE} || defined $r->{FASTA} ) ? 1 : 0;
        },
    },
    trimmed_fastq => {
        # Uses -s (non-empty file) rather than -f (any file) for the same
        # race-condition reason as trimmed_downsampled_fastq: fastp may
        # truncate its output file before filling it, and -s correctly
        # rejects an empty file while -f would accept it. Never satisfied
        # for FASTA samples -- trimming doesn't apply to them.
        check => sub {
            my ($i) = @_;
            my $type = $R_samples->[$i]{type};
            return 1 if $type ne 'FASTA' && reads_removed_by_cleanup($i, 'trimmed_fastq');
            return 1 if $type eq 'PE' && -s fill_placeholders("__R1T__", $i) && -s fill_placeholders("__R2T__", $i);
            return 1 if $type eq 'SE' && -s fill_placeholders("__SET__", $i);   # -s like PE (B26)
            return 0;
        },
    },
    trimmed_downsampled_fastq => {
        # Uses -s (file exists AND has non-zero size) rather than -f (file
        # exists), for two reasons:
        # 1. Race condition in parallel mode: downsampling_bbmap applies_if
        #    always returns true when targetbases is set (the actual
        #    coverage-vs-target check is inside preprocessing). When bbmap
        #    is forked it may truncate its output file immediately, leaving
        #    an empty file that -f would accept but -s correctly rejects.
        # 2. Consistency: require_input_files() (used by Kraken2 and others
        #    that read these files) also uses -s, so the gate and the user
        #    of the gate agree on "file is ready".
        check => sub {
            my ($i) = @_;
            return 1 if ( $R_samples->[$i]{type} // '' ) ne 'FASTA' && reads_removed_by_cleanup($i, 'downsampled_fastq');
            my $type = $R_samples->[$i]{type};
            return 1 if $type eq 'FASTA';   # vacuously true -- no TD files for assembled input
            return 1 if $type eq 'PE' && -s fill_placeholders("__R1TD__", $i) && -s fill_placeholders("__R2TD__", $i);
            return 1 if $type eq 'SE' && -s fill_placeholders("__SETD__", $i);
            return 0;
        },
    },
    prescan_done => {
        # Vacuously satisfied for FASTA samples -- prescan doesn't apply to
        # already-assembled data, so there's nothing for a downstream
        # requires => ['prescan_done'] to wait for in that case.
        check => sub {
            my ($i) = @_;
            return 1 if $R_samples->[$i]{type} eq 'FASTA';
            return 1 if -f fill_placeholders("__DIR-QC1__/fastq_prescan/__BASE__.prescan.json", $i);
            return 0;
        },
    },
    species_determined => {
        # "Species determination is finished" -- not "a species is known".
        # main_results.taxonomy.species starts out as "n/a" (new_sample_struct),
        # so checking it for definedness was true from the very start: in
        # parallel mode downsampling_bbmap (and everything else requiring
        # this key) could start before find_species_kraken2 had finished.
        # Now true when:
        #   - species determination has written its result (species_method
        #     is set by its result parsing, also when the call is "n/a"), or
        #   - find_species_kraken2 does not apply (kraken2 disabled) or has
        #     already been attempted and failed -- there will be no species,
        #     so steps waiting for one must not wait forever.
        check => sub {
            my ($i) = @_;
            my $method = $R_samples->[$i]{main_results}{taxonomy}{species_method} // "n/a";
            return 1 if $method ne "n/a" && $method ne "";
            my $d = $runstep{find_species_kraken2} or return 1;
            my $applies = eval { exists $d->{applies_if} ? $d->{applies_if}->($i) : 1 };
            return 1 unless $applies;
            return $S_RUNSTEP_ATTEMPTED{"$i,find_species_kraken2"} ? 1 : 0;
        },
    },
    spades_assembled => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{spades}{total_length} ? 1 : 0; },
    },
    # shovill_spades_assembled / shovill_skesa_assembled are added by
    # define_shovill_runstep() together with their runsteps.
    skesa_assembled => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{skesa}{total_length} ? 1 : 0; },
    },
    main_assembly_present => {
        # NOTE: new_sample_struct initialises main_results.assembly.method
        # to "n/a", so `defined` is always true from startup -- we must
        # check for an actual assembler name, not just definedness.
        check => sub {
            my ($i) = @_;
            my $method = $R_samples->[$i]{main_results}{assembly}{method} // "";
            return ($method ne "" && $method ne "n/a") ? 1 : 0;
        },
    },
    fasta_imported => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-ALTERNATIVE-ASSEMBLIES__/imported/__BASE__.imported.fasta", $i) ? 1 : 0; },
    },
    quast_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-QC3__/quast/__BASE__/report.txt", $i) ? 1 : 0; },
    },
    remap_done => {
        check => sub {
            my ($i) = @_;
            return 1 if -f fill_placeholders("__DIR-QC3__/remapping/__BASE__/__BASE__.pileup_summary.json", $i);
            return remap_earlier_way_done($i) ? 1 : 0;
        },
    },
    mlst_assembled => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{mlst}{st} ? 1 : 0; },
    },
    fastmlst_assembled => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{fastmlst}{st} ? 1 : 0; },
    },
    main_mlst_present => {
        check => sub {
            my ($i) = @_;
            my $method = $R_samples->[$i]{main_results}{mlst}{method} // "";
            return ($method ne "" && $method ne "n/a") ? 1 : 0;
        },
    },
    # v1 typing/characterisation steps (stubs until built out -- the stub
    # result_parsing sets results.<step>.status, the real ones should too).
    sistr_done           => { check => sub { my ($i) = @_; return defined result_field($i, "sistr", "status")           ? 1 : 0; } },
    seqsero2_done        => { check => sub { my ($i) = @_; return defined result_field($i, "seqsero2", "status")        ? 1 : 0; } },
    ectyper_done         => { check => sub { my ($i) = @_; return defined result_field($i, "ectyper", "status")         ? 1 : 0; } },
    lissero_done         => { check => sub { my ($i) = @_; return defined result_field($i, "lissero", "status")         ? 1 : 0; } },
    virulencefinder_done => { check => sub { my ($i) = @_; return defined result_field($i, "virulencefinder", "status") ? 1 : 0; } },
    plasmidfinder_done   => { check => sub { my ($i) = @_; return defined result_field($i, "plasmidfinder", "status")   ? 1 : 0; } },
    main_serotype_present => {
        check => sub { my ($i) = @_; return defined result_field($i, "select_main_serotype", "status") ? 1 : 0; },
    },
    amrfinderplus_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{amrfinderplus}{hit_count} ? 1 : 0; },
    },
    resfinder_fasta_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{resfinder_fasta}{hit_count} ? 1 : 0; },
    },
    resfinder_fastq_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{resfinder_fastq} ? 1 : 0; },
    },
    bakta_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-ANNOTATED__/__BASE__/__BASE__.txt", $i) ? 1 : 0; },
    },
    kraken2_contamination_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-QC2__/Kraken2/__BASE__.kraken2.txt", $i) ? 1 : 0; },
    },
    mash_screen_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-QC2__/mash_screen/__BASE__.mash_screen.tsv", $i) ? 1 : 0; },
    },
    fastqc_rawdata_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{fastqc_rawdata} ? 1 : 0; },
    },
    fastq_stats_trimmed_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-QC2__/fastq_stats/__BASE__.json", $i) ? 1 : 0; },
    },
    fastp_trimmed_data_done => {
        check => sub { my ($i) = @_; return -f fill_placeholders("__DIR-QC2__/Fastp_trimmed_data/__BASE__.trimmed.json", $i) ? 1 : 0; },
    },
    fastqc_trimmed_data_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{fastqc_trimmed_data} ? 1 : 0; },
    },
    chewbbaca_batch_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{chewbbaca}{schemas} && @{ $R_samples->[$i]{results}{chewbbaca}{schemas} } ? 1 : 0; },
    },
    chewbbaca_per_sample_done => {
        check => sub { my ($i) = @_; return defined $R_samples->[$i]{results}{chewbbaca}{schemas} && @{ $R_samples->[$i]{results}{chewbbaca}{schemas} } ? 1 : 0; },
    },
    multiqc_done => {
        # multiqc is a batch-level step -- satisfied once the stage3 assembly QC
        # report exists (stage1/stage2 may be absent for FASTA-only runs).
        # Vacuously true per-sample once the batch report is written.
        check => sub {
            my $qc3_report = fill_placeholders("__DIR-QC3__/multiqc_report.html", "", "multiqc");
            return (defined $qc3_report && -s $qc3_report) ? 1 : 0;
        },
    },
    cleanup_done => {
        # Nothing requires it: cleanup runs last and leaves nothing to check.
        # Never satisfied, so a step that ever requires it would wait for
        # ever -- it would have to be given a real check first.
        check => sub { return 0; },
    },
);

###################################################################################################
## Gatekeeper library -- see the runstep machinery design doc, §6.2. Named,
## reusable comparison strategies for groups with more than one candidate
## producer for the same result (today: the four assemblers). Deliberately
## scoped to a from-scratch, closing-time comparison for now, not the
## incremental, live-updating leader described in §6.3/§6.4 -- with
## everything still running strictly sequentially, one runstep at a time,
## there is no real difference between the two yet. The incremental
## version is worth building once real concurrency exists, not before.

my %gatekeeper_strategy = (
    highest_value_of => sub {
        my ($field) = @_;
        return sub { my ($a, $b) = @_; ($a->{$field} // 0) <=> ($b->{$field} // 0) };
    },
    lowest_value_of => sub {
        my ($field) = @_;
        return sub { my ($a, $b) = @_; ($b->{$field} // 0) <=> ($a->{$field} // 0) };
    },
);

# Group membership of any runstep tagged with a given `group` -- replaces a
# hardcoded array of names (the old @assemblers list) with something that
# automatically picks up a new member the day one is added, as long as it
# declares the same group. No registry of its own; reads group directly
# off each runstep's own declaration.
#
# Optional $priority_order (e.g. \@ASSEMBLER_TIEBREAK) sorts members
# accordingly instead of alphabetically -- needed wherever a caller has an
# order-sensitive "take the first usable one, then stop" pattern (several
# mlst/fastmlst fallback-selection loops do exactly this); plain
# alphabetical is fine wherever order truly doesn't affect the outcome.
sub group_members {
    my ($group, $priority_order) = @_;
    my @members = grep { ($runstep{$_}{group} // '') eq $group } keys %runstep;

    if ($priority_order) {
        my %rank = map { $priority_order->[$_] => $_ } 0 .. $#$priority_order;
        my $default_rank = scalar(@$priority_order);
        return sort { ($rank{$a} // $default_rank) <=> ($rank{$b} // $default_rank) || $a cmp $b } @members;
    }

    return sort @members;
}

# Generic, from-scratch, order-independent winner selection. $candidates is
# { name => candidate_hashref, ... } for whichever group members actually
# produced a usable result; $comparator is a sub($a,$b) (as returned by a
# %gatekeeper_strategy entry above) or undef for "no real metric, tiebreak
# alone decides"; $tiebreak is an arrayref of names in priority order.
# Ties on the metric never fall through to hash iteration order -- the
# tiebreak always settles them -- which is what makes the result
# independent of how %$candidates happens to be iterated, and therefore
# independent of which candidate happened to be computed/inserted first.
sub gatekeeper_select_winner {
    my ($candidates, $comparator, $tiebreak) = @_;

    my %priority = map { $tiebreak->[$_] => $_ } 0 .. $#$tiebreak;
    my $default_priority = scalar(@$tiebreak);

    my $winner;
    # Sorted, so two candidates that tie on the metric and are both missing
    # from the tiebreak list are decided by name, not by hash order (B26).
    for my $name ( sort keys %$candidates ) {
        if ( !defined $winner ) {
            $winner = $name;
            next;
        }
        my $cmp = $comparator ? $comparator->( $candidates->{$name}, $candidates->{$winner} ) : 0;
        if ( $cmp > 0 ) {
            $winner = $name;
        }
        elsif ( $cmp == 0 ) {
            my $p_new = $priority{$name}   // $default_priority;
            my $p_cur = $priority{$winner} // $default_priority;
            $winner = $name if $p_new < $p_cur;
        }
    }
    return $winner;
}

# A value is "real" (usable) if it's defined and not one of the various
# ways this codebase spells "nothing here" -- shared by every priority-pick
# below so all of them agree on what counts as missing.
sub _is_real_value {
    my ($val) = @_;
    return 0 unless defined $val;
    return 0 if $val eq '' || lc($val) eq 'n/a' || $val eq '-';
    return 1;
}

# Generic priority-pick: given named candidates and a priority order,
# returns the (name, value) of the first candidate -- in priority order --
# whose $field holds a real value. Unlike gatekeeper_select_winner, there
# is no competing metric here, just "take the highest-priority one that
# actually has an answer for this field" -- e.g. selecting the official ST
# from whichever of mlst/fastmlst produced one, or selecting the official
# clonal complex from whichever group member even produces that field at
# all (today only fastmlst does).
sub priority_select_field {
    my ($candidates, $priority, $field) = @_;
    for my $name ( @$priority ) {
        next unless exists $candidates->{$name};
        my $val = $candidates->{$name}{$field};
        next unless _is_real_value($val);
        return ( $name, $val );
    }
    return ( undef, undef );
}

# Warns if any other candidate with a real value for $field disagrees with
# the winner -- a genuine data-quality signal (two independent typing
# methods giving different STs/clonal complexes for the same sample is
# worth a human noticing), not just bookkeeping. Returns the mismatch
# messages too, so a caller can persist them (e.g. into a runstep's own
# recorded "reasons"), not just log them.
sub warn_on_field_mismatch {
    my ($candidates, $priority, $field, $winner_name, $winner_val, $label) = @_;
    return () unless defined $winner_name;
    my @messages;
    for my $name ( @$priority ) {
        next if $name eq $winner_name;
        next unless exists $candidates->{$name};
        my $val = $candidates->{$name}{$field};
        next unless _is_real_value($val);
        if ( $val ne $winner_val ) {
            my $msg = "$label mismatch -- $winner_name says [$winner_val], $name says [$val]";
            log_message("WARNING: $msg", "red");
            push @messages, $msg;
        }
    }
    return @messages;
}


# Dispatch table for runsteps implemented as native Perl functions rather than
# external shell commands. A runstep's cmd_template can be set to the sentinel
# string "SUB\t<name>\t<args...>" (see _parse_internal_cmd/_run_internal_sub,
# called from execute_and_log) to route execution here instead of to a shell.
#
# IMPORTANT: run_step() always forks (execute_and_log($command, 1, ...)), so
# any sub registered here runs inside the forked CHILD -- writes to
# $R_samples/%rundata/any other in-memory structure made there are lost the
# moment the child exits (copy-on-write). Safe usage (see fastq_qc) is to
# only ever write files; a separate result_parsing function, running back in
# the parent after run_step() returns, reads those files to populate
# $R_samples. See the runstep machinery design doc, §10, rule 1.
my %INTERNAL_SUB = (
    fastq_qc => \&fastq_qc,
    write_main_mlst_result => \&write_main_mlst_result,
    write_stub_result      => \&write_stub_result,
    write_main_serotype_result => \&write_main_serotype_result,
);

# Composite data_keys added after %data_key is fully defined -- these
# reference other %data_key entries and must be added after the hash
# initializer runs, otherwise "requires explicit package name" at
# compile-time because the anonymous subs close over %data_key before
# it's declared as my.
# Reads results.<step>.<field> WITHOUT autovivifying results.<step>.
# A plain $R_samples->[$i]{results}{x}{status} in a data-key check creates
# an empty results.x for every sample it is asked about, and the report
# then treats x as having run (it checks 'exists results.x').
sub result_field {
    my ($i, $step, $field) = @_;
    my $r = $R_samples->[$i]{results} or return undef;
    my $s = $r->{$step};
    return ( ref $s eq 'HASH' ) ? $s->{$field} : undef;
}

# Keys produced by the members of a runstep group (e.g. every
# *_assembled key of the 'assembler' group, including fasta_imported from
# check_for_fasta). Derived from the runstep declarations, so a new group
# member is picked up without editing any list here.
sub group_produced_keys {
    my ($group) = @_;
    my %seen;
    return grep { !$seen{$_}++ }
           map  { @{ $runstep{$_}{produces} // [] } }
           group_members($group);
}

$data_key{any_assembler_done} = {
    check => sub {
        my ($i) = @_;
        # fasta_imported (check_for_fasta, also in the 'assembler' group) is
        # the "assembler" for FASTA-type samples, so this is satisfied for
        # FASTA samples too.
        for my $k ( group_produced_keys('assembler') ) {
            return 1 if exists $data_key{$k} && $data_key{$k}{check}->($i);
        }
        return 0;
    },
};

# "Settled": a runstep that applies to this sample has either produced its
# keys or has already been attempted (finished, failed, or -- in sequential
# mode -- passed over), so nothing more will come from it. A runstep that
# does not apply (config off, wrong species, missing definition) counts as
# settled. Used for "wait until the whole group is finished" gates.
sub runstep_settled {
    my ($name, $i) = @_;
    my $def = $runstep{$name} or return 1;
    my $applies = eval { exists $def->{applies_if} ? $def->{applies_if}->($i) : 1 };
    return 1 unless $applies && runstep_species_applies($def, $i);
    return 1 if $S_RUNSTEP_ATTEMPTED{"$i,$name"};
    my @prod = @{ $def->{produces} // [] };
    return 1 if @prod && !grep { !( exists $data_key{$_} && $data_key{$_}{check}->($i) ) } @prod;
    return 0;
}

sub group_settled {
    my ($group, $i) = @_;
    for my $name ( group_members($group) ) {
        return 0 unless runstep_settled($name, $i);
    }
    return 1;
}

# Group gates for the select_main_* steps. Without them the parallel
# scheduler would run the selection as soon as the FIRST group member
# finished, before slower members had a chance (in sequential mode the
# list order already guarantees it).
$data_key{all_assemblers_settled} = { check => sub { group_settled('assembler',          $_[0]) }, derived_from => { group => 'assembler' } };
$data_key{all_mlst_settled}       = { check => sub { group_settled('mlst_determination', $_[0]) }, derived_from => { group => 'mlst_determination' } };
$data_key{all_amr_settled}        = { check => sub { group_settled('amr',                $_[0]) }, derived_from => { group => 'amr' } };
$data_key{all_serotyping_settled} = { check => sub { group_settled('serotyping',         $_[0]) }, derived_from => { group => 'serotyping' } };

# Kraken2 contamination screening has run (or does not apply). Species-
# specific typing steps wait for it, so they only start once both the
# species call and the contamination picture are known.
$data_key{kraken2_settled} = { check => sub { runstep_settled('Kraken2', $_[0]) }, derived_from => { runstep => 'Kraken2' } };
# (derived_from: keys that no runstep "produces" but that are computed from
# other runsteps' results -- used by rerun= to find dependent steps.)
$data_key{any_assembler_done}{derived_from} = { group => 'assembler' };

$data_key{any_mlst_done} = {
    derived_from => { group => 'mlst_determination' },
    check => sub {
        my ($i) = @_;
        for my $k ( group_produced_keys('mlst_determination') ) {   # B26: from the group, like any_assembler_done
            return 1 if exists $data_key{$k} && $data_key{$k}{check}->($i);
        }
        return 0;
    },
};
$data_key{any_amr_done} = {
    derived_from => { group => 'amr' },
    check => sub {
        my ($i) = @_;
        for my $k ( group_produced_keys('amr') ) {   # B26: from the group
            return 1 if exists $data_key{$k} && $data_key{$k}{check}->($i);
        }
        return 0;
    },
};



