sub print_result_table {
    my $number_samples = scalar @$R_samples;


    my $outdir    = getdir("out");
    my $outfile   = "$outdir/resulttable.txt";

    open my $fh, '>', $outfile or do {
        log_message("ERROR: Could not write resulttable", "red");
