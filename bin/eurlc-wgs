## runstep remap

$runstep_name = "remap";

$runstep{$runstep_name} = {
      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 4 },

      message    => "Running Bowtie2 re-mapping...",
      long_name  => "Bowtie2 re-mapping",
      output_dir => "__DIR-QC3__/remapping/__BASE__",
      # Written last, atomically, by --remap-summary=pileup: the step is done
      # only when the whole chain ran (planned §36). Folders made before the
      # streaming way count as done by remap_earlier_way_done().
      resultfile => "__DIR-QC3__/remapping/__BASE__/__BASE__.pileup_summary.json",
      rerun_paths => [ "__DIR-QC3__/remapping/__BASE__" ],   # rerun=remap: the whole folder, cache too
      # plan_read_regeneration: a folder made before the streaming way is done
      done_otherwise => sub { remap_earlier_way_done($_[0]) },
      cachefile  => "__DIR-QC3__/remapping/__BASE__/__BASE__.remap_qc.json",
      mixed_sites_tsv  => "__DIR-QC3__/remapping/__BASE__/__BASE__.mixed_positions.tsv",      
      resultfiles_status => "NA",

      requires   => [ 'main_assembly_present', 'trimmed_downsampled_fastq' ],
      produces   => [ 'remap_done' ],
      applies_if => sub {
          my ($i) = @_;
          return 0 if $R_samples->[$i]{type} ne 'PE';   # remap is currently PE-only
          return $R_cfg->{bowtie2}{enabled} ? 1 : 0;
      },
};


# TEMPLATES---------------------------------

# The commands are chained with && (wrap_cmd_strict), and the pipes run with
# pipefail: a failed bowtie2 or samtools then fails the step, instead of the
# next commands running on a missing or cut-off BAM and the step being
# reported as done (planned §36, småfel 2).
$runstep{$runstep_name}{cmd_template}{PE} = wrap_cmd_strict(<<CMD);
    cp __DIR-ASSEMBLIES__/__BASE__.fasta __DIR-QC3__/remapping/__BASE__/__BASE__.fasta
       __HIDE-OUTPUT__
    __NEWCOMMAND__ 
    cd  __DIR-QC3__/remapping/__BASE__/  
       __HIDE-OUTPUT__    
    __NEWCOMMAND__     
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output bowtie2-build 
       __BASE__.fasta 
       __BASE__ 
       __HIDE-OUTPUT__
    __NEWCOMMAND__    
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output bash -c '
       set -o pipefail;
       bowtie2 
       -p __THREADS__
       -x __BASE__ 
       -1 __R1TD__
       -2 __R2TD__
       | samtools view -b -
       | samtools sort -o __BASE__.sorted.bam - '
       __HIDE-OUTPUT__       
    __NEWCOMMAND__    
       rm *.bt2 
       __HIDE-OUTPUT__    
    __NEWCOMMAND__        
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools faidx 
       __BASE__.fasta 
       __HIDE-OUTPUT__     
    __NEWCOMMAND__    
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools index 
       __BASE__.sorted.bam
       __HIDE-OUTPUT__               
    __NEWCOMMAND__              
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools stats 
       __BASE__.sorted.bam > __BASE__.stats
       __HIDE-STDERR__    
    __NEWCOMMAND__   
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools flagstat 
       __BASE__.sorted.bam > __BASE__.flagstats
       __HIDE-STDERR__    
    __NEWCOMMAND__       
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools idxstats 
       __BASE__.sorted.bam > __BASE__.idxstats
       __HIDE-STDERR__    
    __NEWCOMMAND__      
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output samtools coverage 
       __BASE__.sorted.bam > __BASE__.coverage
       __HIDE-STDERR__    
    __NEWCOMMAND__     
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output  bash -c '
        set -o pipefail;
        samtools depth -aa __BASE__.sorted.bam
        | __REMAP-PERL__ --remap-summary=depth --out __BASE__.depth_summary.json '
        __HIDE-STDERR__    
    __NEWCOMMAND__        
    conda run -n $R_cfg->{bowtie2}->{env} --no-capture-output  bash -c '
        set -o pipefail;
        samtools mpileup 
        -aa 
        -q 20 -Q 20 
        -f __BASE__.fasta 
        __BASE__.sorted.bam 
        | __REMAP-PERL__ --remap-summary=pileup
          --allele-counts __BASE__.allele_counts.tsv.gz
          --summary __BASE__.pileup_summary.json '
       __HIDE-STDERR__
       __REMAP-REMOVE-BAM__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_remap;

sub test_remap {

  return check_conda_tool("bowtie2");

   


}

# PRE---------------------------------



$runstep{$runstep_name}{preprocessing} = \&preprocess_remap;

sub preprocess_remap {

    my ($samplenr) = @_;

    my $runstep_name = "remap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # remap is currently PE-only
    if ($sample_type ne "PE") {
        return "";
    }

    return "" unless require_input_files($samplenr, $runstep_name, "optional", "__DIR-ASSEMBLIES__/__BASE__.fasta", "__R1TD__", "__R2TD__" );

    my $command    = $runstep{$runstep_name}{cmd_template}{$sample_type};
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if (-f $resultfile || remap_earlier_way_done($samplenr)) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_remap($samplenr);
        return "";
    }

    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name));

    # depth and mpileup are read by this script itself (--remap-summary), with
    # the perl it runs under: the command runs inside the bowtie2 environment.
    my $self = eval { abs_path($0) } // $0;
    my $perl = $^X;
    $command =~ s/__REMAP-PERL__/'$perl' '$self'/g;

    # cleanup.bam=1 (default): the BAM, its index and the copy of the assembly
    # are removed as soon as the summaries are written. rerun=remap
    # cleanup.bam=0 makes them again.
    my $remove = is_disabled( $R_cfg->{cleanup}{bam} // 1 ) ? ""
               : " && rm -f __BASE__.sorted.bam __BASE__.sorted.bam.bai __BASE__.fasta __BASE__.fasta.fai";
    $command =~ s/\s*__REMAP-REMOVE-BAM__/$remove/;

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_remap;

## A remap folder made before the streaming way (no pileup_summary.json)
## counts as done when its cache and table are there, together with the BAM
## or the pileup they were made from.
sub remap_earlier_way_done {
    my ($i) = @_;
    my $d = fill_placeholders("__DIR-QC3__/remapping/__BASE__/__BASE__", $i);
    return 0 unless -s "$d.remap_qc.json" && -f "$d.mixed_positions.tsv";
    return ( -f "$d.sorted.bam" || -s "$d.pileup.gz" ) ? 1 : 0;
}

## Can the mixture metric be made again from what is in the folder?
sub remap_mixture_recomputable {
    my ($i) = @_;
    my $d = fill_placeholders("__DIR-QC3__/remapping/__BASE__/__BASE__", $i);
    return 1 if -s "$d.pileup_summary.json" && -s "$d.allele_counts.tsv.gz";
    return 1 if -s "$d.pileup.gz";
    return 0;
}

## Do two sets of [remap_mixture] values differ?
sub remap_params_differ {
    my ($a, $b) = @_;
    return 1 unless ref $a eq 'HASH' && ref $b eq 'HASH';
    my %d = remap_mixture_defaults();
    for my $k (keys %d) {
        my ($x, $y) = ($a->{$k}, $b->{$k});
        return 1 if !defined $x || !defined $y || $x != $y;
    }
    return 0;
}

## QC measures from the re-mapping, main_results.remap (remap_* in
## %QC_MEASURE_DEF), from results.remap. Called by postprocess_remap, and by
## evaluate_sample_qc for runs whose remap was read before these existed
## (summarize does not read the steps again). No default thresholds yet
## (Nov 2026): first the spread.
sub remap_qc_values {
    my ($samplenr) = @_;
    my $result_ref = $R_samples->[$samplenr]{results}{remap};
    return unless ref $result_ref eq 'HASH';
    my $picked = ( $result_ref->{mapping} // {} )->{samtools_stats_sn_picked} // {};
    my $cov    = $result_ref->{coverage} // {};
    {
        my $M   = $result_ref->{mapping} // {};
        my $num = sub { my $v = shift; ( defined $v && $v =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/ ) ? $v + 0 : undef };
        my %q;
        $q{reads_mapped_pct}      = $num->( $picked->{reads_mapped_pct} // $M->{reads_mapped_pct} );
        $q{properly_paired_pct}   = $num->( $picked->{properly_paired_pct} // $M->{properly_paired_pct} );
        # mapped pairs whose mates are on different contigs: a few percent at
        # contig ends; most pairs when R1 and R2 come from different samples.
        # (properly_paired_pct also falls with long inserts: Bowtie2's default
        # maximum insert is 500 bp, so it is not comparable between libraries.)
        my $mp = $num->( $picked->{reads_mapped_and_paired} // $M->{reads_mapped_and_paired} );
        my $dc = $num->( $picked->{pairs_diff_chromosomes} // $M->{pairs_diff_chromosomes} );
        $q{pairs_diff_contig_pct} = ( defined $mp && $mp > 0 && defined $dc ) ? sprintf( "%.3f", 100 * $dc / ( $mp / 2 ) ) : undef;
        $q{breadth_10x_pct}       = $num->( $cov->{breadth_10x_pct} );
        $q{depth_iqr_over_median} = $num->( $cov->{depth_iqr_over_median} );
        my $er = $num->( $M->{error_rate} // $picked->{error_rate} );
        $q{error_rate_pct}        = defined $er ? sprintf( "%.4f", 100 * $er ) : undef;
        # Bases of the assembly in contigs of >= 1 kb whose median depth is
        # below 20 % of the genome's: a contaminant at low abundance makes
        # its own contigs, at a much lower depth than the sample's genome
        # (independent of Kraken; plasmids and repeats are deeper, not shallower).
        my $per = $cov->{depth_per_contig};
        my $gm  = $num->( $cov->{depth_median} );
        if ( ref $per eq 'HASH' && %$per && defined $gm && $gm > 0 ) {
            my ( $tot, $low, $n ) = ( 0, 0, 0 );
            for my $c ( values %$per ) {
                my $len = $c->{positions} // 0;
                $tot += $len;
                my $md = $num->( $c->{median_depth} );
                next unless $len >= 1000 && defined $md && $md < 0.2 * $gm;
                $low += $len;
                $n++;
            }
            if ($tot) {
                $q{low_depth_contig_pct} = sprintf( "%.3f", 100 * $low / $tot );
                $q{low_depth_contig_bp}  = $low;
                $q{low_depth_contigs}    = $n;
            }
        }
        $R_samples->[$samplenr]{main_results}{remap}{$_} = $q{$_} // "n/a" for keys %q;
        for (qw(reads_mapped_pct properly_paired_pct pairs_diff_contig_pct breadth_10x_pct depth_iqr_over_median error_rate_pct low_depth_contig_pct)) {
            $R_samples->[$samplenr]{main_results}{remap}{$_} //= "n/a";
        }
    }
}

sub postprocess_remap {
    my ($samplenr) = @_;

    my $runstep_name = "remap";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};

    # remap is currently PE-only
    if ($sample_type ne "PE") {
        return "";
    }

    my $output_dir       = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);
    my $cachefile        = fill_placeholders($runstep{$runstep_name}{cachefile}, $samplenr, $runstep_name);
    my $mixed_sites_tsv  = fill_placeholders($runstep{$runstep_name}{mixed_sites_tsv}, $samplenr, $runstep_name);

    my $result_ref;

    if (-f $cachefile && -f $mixed_sites_tsv) {
        log_message("INFO: Using cached remap QC JSON for sample $sample_name", "green");
        $result_ref = read_json($cachefile);

        if (!$result_ref || ref($result_ref) ne 'HASH') {
            log_message("WARNING: Cached remap QC JSON is invalid for sample $sample_name. Re-parsing source files.", "yellow");
            $result_ref = undef;
        }
        elsif (($result_ref->{mixture}{method_version} // 1) < REMAP_MIXTURE_METHOD_VERSION()) {
            # The cache was written before the mixture metric changed. It can be brought
            # up to date without mapping again from the allele counts or the pileup.
            if (remap_mixture_recomputable($samplenr)) {
                log_message("NOTICE: Remap QC for sample $sample_name was made with an earlier mixture method -- calculating it again");
                $result_ref = undef;
            }
            else {
                log_message("NOTICE: Remap QC for sample $sample_name was made with an earlier mixture method and neither allele counts nor pileup are left -- the new mixture values are not available (rerun=remap to get them)");
            }
        }
        elsif (defined $result_ref->{mixture}{mixed_params}
               && remap_params_differ($result_ref->{mixture}{mixed_params}, remap_mixture_params())) {
            # [remap_mixture] has changed since the cache was written (planned §36, småfel 5).
            if (remap_mixture_recomputable($samplenr)) {
                log_message("NOTICE: [remap_mixture] values differ from those used for sample $sample_name -- calculating the mixture metric again");
                $result_ref = undef;
            }
            else {
                log_message("NOTICE: [remap_mixture] values differ from those used for sample $sample_name, but neither allele counts nor pileup are left -- the stored values are kept (rerun=remap to apply the new ones)");
            }
        }
    }

    if (!$result_ref) {
        log_message("INFO: Parsing remap QC files for sample $sample_name", "green");
        $result_ref = parse_remap_qc($output_dir, $samplenr);

        if ($result_ref && ref($result_ref) eq 'HASH') {
            write_json_file($result_ref,$cachefile);
        }
        else {
            log_message("WARNING: Remap QC parser did not return a valid hashref for sample $sample_name", "yellow");
            return 0;
        }
    }

    $R_samples->[$samplenr]{results}{$runstep_name} = $result_ref;

    my $picked = $result_ref->{mapping}{samtools_stats_sn_picked} // {};
    my $cov    = $result_ref->{coverage} // {};
    my $mix    = $result_ref->{mixture} // {};

    # The mixture metric, where QC thresholds and the reports look for it.
    if (defined $mix->{mixed_windows}) {
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_windows}        = $mix->{mixed_windows};
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_windows_pct}    = $mix->{mixed_windows_pct};
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_sites}          = $mix->{mixed_sites};
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_sites_isolated} = $mix->{mixed_sites_isolated};
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_minoraf_median} = $mix->{mixed_minoraf_median};
        $R_samples->[$samplenr]{main_results}{contamination}{mixed_method}         = "remap, method $mix->{method_version}";
    }

    # The re-mapping values main_results.assembly has places for (they were
    # never filled in): for the reports, a GUI and eurlc-wgs-inspect.
    {
        my $A = $R_samples->[$samplenr]{main_results}{assembly};
        my $M = $result_ref->{mapping} // {};
        $A->{remap_rate}        = $M->{reads_mapped_pct}    // "n/a";
        $A->{remap_insert_size} = $M->{insert_size_average} // "n/a";
        $A->{remap_mean_depth}  = $cov->{depth_mean}        // "n/a";
        $A->{breadth_10x}       = $cov->{breadth_10x_pct}   // "n/a";
        $A->{breadth_20x}       = $cov->{breadth_20x_pct}   // "n/a";
        $A->{breadth_30x}       = $cov->{breadth_30x_pct}   // "n/a";
    }

    # QC measures from the re-mapping (main_results.remap)
    remap_qc_values($samplenr);

    my $fmt = sub {
        my ($value, $suffix) = @_;
        return "n/a" if !defined $value || $value eq "";
        return $value . ($suffix // "");
    };

    my $fmt_percent = sub {
        my ($value) = @_;
        return "n/a" if !defined $value || $value eq "";
        return $value . "%";
    };

    my $fmt_error_rate = sub {
        my ($value) = @_;
        return "n/a" if !defined $value || $value eq "";
        return "n/a" unless $value =~ /^-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/;
        return sprintf("%.5f%%", 100 * $value);
    };

    print_tabular_results("reads_mapped",         $fmt_percent->($picked->{reads_mapped_pct}));
    print_tabular_results("properly_paired",      $fmt_percent->($picked->{properly_paired_pct}));
    print_tabular_results("error_rate, base level", $fmt_error_rate->($result_ref->{mapping}{error_rate}));

    print_tabular_results("average read length",  $fmt->($picked->{average_length}));
    print_tabular_results("average Q score value", $fmt->($picked->{average_quality}));
    print_tabular_results("insert_size_average",  $fmt->($picked->{insert_size_average}));

    print_tabular_results("Mean depth",           $fmt->($cov->{depth_mean}, "X"));
    print_tabular_results("Median depth",         $fmt->($cov->{depth_median}, "X"));
    print_tabular_results("Q1 depth",             $fmt->($cov->{depth_q1}, "X"));
    print_tabular_results("Q3 depth",             $fmt->($cov->{depth_q3}, "X"));
    print_tabular_results("Depth IQR",            $fmt->($cov->{depth_iqr}));
    print_tabular_results("Depth IQR over median", $fmt->($cov->{depth_iqr_over_median}));
    print_tabular_results("Depth SD",             $fmt->($cov->{depth_sd}));

    print_tabular_results("Breadth of coverage at 1X",  $fmt_percent->($cov->{breadth_1x_pct}));
    print_tabular_results("Breadth of coverage at 10X", $fmt_percent->($cov->{breadth_10x_pct}));
    print_tabular_results("Breadth of coverage at 20X", $fmt_percent->($cov->{breadth_20x_pct}));
    print_tabular_results("Breadth of coverage at 30X", $fmt_percent->($cov->{breadth_30x_pct}));

    print_tabular_results("SNP callable genome at >=20X (bases)", $fmt->($mix->{"callable_sites_dp_ge_20"}));
    print_tabular_results("SNP callable genome at >=20X (%)",     $fmt_percent->($cov->{breadth_20x_pct}));

    print_tabular_results(
        "positions (>=20X) with minor allele fraction 5-10%",
        $fmt->($mix->{"sites_minoraf_0_05_to_0_10_dp20"})
    );
    print_tabular_results(
        "positions (>=20X) with minor allele fraction 10-20%",
        $fmt->($mix->{"sites_minoraf_0_10_to_0_20_dp20"})
    );
    print_tabular_results(
        "positions (>=20X) with minor allele fraction >=20%",
        $fmt->($mix->{"sites_minoraf_ge_0_20_dp20"})
    );
    print_tabular_results("Mixture: 1-kb windows with mixed positions",
        $fmt->($mix->{mixed_windows}) . (defined $mix->{mixed_windows_total} ? " of $mix->{mixed_windows_total}" : ""));
    print_tabular_results("Mixture: mixed positions after filters",  $fmt->($mix->{mixed_sites}));
    print_tabular_results("Mixture: of which isolated (none within 1 kb)", $fmt->($mix->{mixed_sites_isolated}));
    print_tabular_results("Mixture: median minor allele fraction",   $fmt->($mix->{mixed_minoraf_median}));



    
    return 1;
}




###############################################################################
# REMAPPING QC RESULT STRUCTURE OVERVIEW
#
# $res = {
#
#   files => {
#       flagstats        => "<samtools flagstat output>",
#       coverage         => "<samtools coverage output>",
#       idxstats         => "<samtools idxstats output>",
#       stats            => "<samtools stats output>",
#       depth_tsv        => "<samtools depth -aa output>",
#       pileup           => "<samtools mpileup.gz output>",
#       mixed_sites_tsv  => "<tab-delimited table of mixed positions>",
#   },
#
#   mapping => {
#       # ---- parsed from samtools flagstat ----
#       flagstat => {
#           reads_total           => int,
#           reads_mapped          => int,
#           reads_mapped_pct      => float,
#           properly_paired       => int,
#           properly_paired_pct   => float,
#           paired_in_sequencing  => int,
#           read1                 => int,
#           read2                 => int,
#           singletons            => int,
#           singletons_pct        => float,
#       },
#
#       # ---- parsed from samtools stats (selected SN fields) ----
#       samtools_stats_sn_picked => {
#           raw_total_sequences        => int,
#           sequences                  => int,
#           reads_mapped               => int,
#           reads_unmapped             => int,
#           reads_properly_paired      => int,
#           reads_mapped_and_paired    => int,
#           reads_MQ0                  => int,
#
#           bases_mapped_cigar         => int,
#           mismatches                 => int,
#           error_rate                 => float,
#
#           average_length             => float,
#           average_quality            => float,
#
#           insert_size_average        => float,
#           insert_size_sd             => float,
#
#           inward_oriented_pairs      => int,
#           outward_oriented_pairs     => int,
#           other_orientation_pairs    => int,
#           pairs_diff_chromosomes     => int,
#
#           properly_paired_pct        => float,
#           reads_mapped_pct           => float,   # derived if possible
#       },
#
#       # ---- full SN key-value table from samtools stats ----
#       samtools_stats_sn_all => {
#           "<samtools SN key>" => "<value>",
#           ...
#       },
#
#       # ---- convenience aliases copied from samtools_stats_sn_picked ----
#       raw_total_sequences        => int,
#       sequences                  => int,
#       reads_mapped               => int,
#       reads_unmapped             => int,
#       reads_properly_paired      => int,
#       reads_mapped_and_paired    => int,
#       reads_MQ0                  => int,
#       bases_mapped_cigar         => int,
#       mismatches                 => int,
#       error_rate                 => float,
#       average_length             => float,
#       average_quality            => float,
#       insert_size_average        => float,
#       insert_size_sd             => float,
#       inward_oriented_pairs      => int,
#       outward_oriented_pairs     => int,
#       other_orientation_pairs    => int,
#       pairs_diff_chromosomes     => int,
#       properly_paired_pct        => float,
#       reads_mapped_pct           => float,
#
#       # ---- parsed from idxstats ----
#       idxstats_total_mapped      => int,
#       idxstats_total_unmapped    => int,
#
#       top_contigs_by_mapped_reads => [
#           {
#               contig   => "<contig name>",
#               length   => int,
#               mapped   => int,
#               unmapped => int,
#           },
#           ...
#       ],
#   },
#
#   coverage => {
#       # ---- parsed from idxstats ----
#       idxstats_total_ref_len => int,
#
#       contig_lengths => {
#           "<contig name>" => int,
#           ...
#       },
#
#       # ---- parsed from samtools coverage ----
#       per_contig => [
#           {
#               contig       => "<contig name>",
#               covbases     => int | undef,
#               coverage_pct => float | undef,
#               meandepth    => float | undef,
#           },
#           ...
#       ],
#
#       genome_len_from_coverage => int,
#       covered_bases_1x         => int,
#       breadth_1x_pct           => float,
#       mean_depth_weighted      => float,
#
#       # ---- parsed from samtools depth -aa (whole genome) ----
#       depth_positions_total      => int,
#       depth_mean                 => float,
#       depth_sd                   => float,
#       depth_cv                   => float,
#       depth_q1                   => int,
#       depth_median               => int,
#       depth_q3                   => int,
#       depth_iqr                  => int,
#       depth_iqr_over_median      => float,
#
#       breadth_1x_pct             => float,
#       breadth_10x_pct            => float,
#       breadth_20x_pct            => float,
#       breadth_30x_pct            => float,
#
#       # ---- parsed from samtools depth -aa (per contig medians) ----
#       depth_per_contig => {
#           "<contig name>" => {
#               median_depth => int,
#               positions    => int,
#           },
#           ...
#       },
#   },
#
#   mixture => {
#       # ---- callable sites in pileup at minimum depth ----
#       callable_sites_dp_ge_20           => int,
#
#       # ---- disjoint minor-allele-fraction bins ----
#       sites_minoraf_0_05_to_0_10_dp20   => int,
#       sites_minoraf_0_10_to_0_20_dp20   => int,
#       sites_minoraf_ge_0_20_dp20        => int,
#
#       rate_minoraf_0_05_to_0_10_dp20    => float,
#       rate_minoraf_0_10_to_0_20_dp20    => float,
#       rate_minoraf_ge_0_20_dp20         => float,
#
#       # ---- overall minor AF distribution among callable sites ----
#       minoraf_median_dp20               => float | undef,
#       minoraf_p95_dp20                  => float | undef,
#   },
#
#   warnings => [
#       "Missing flagstats file",
#       "Missing depth file",
#       "Could not compute genome_len from coverage file (missing start/end cols?)",
#       ...
#   ],
# };
#
#
# MIXED POSITIONS TSV (files->{mixed_sites_tsv})
#
# Header:
# contig    contig_length    position    ref_base    depth    median_depth
# depth_over_median    major_base    major_base_count    disagree_count
# minor_af    filtered
#
# Where:
#   contig             = contig/chromosome name
#   contig_length      = length from idxstats
#   position           = 1-based genomic position
#   ref_base           = reference base from pileup
#   depth              = total pileup depth at the position
#   median_depth       = per-contig median depth from depth file
#   depth_over_median  = depth / per-contig median depth
#   major_base         = most supported base in pileup (A/C/G/T)
#   major_base_count   = count of reads supporting major_base
#   disagree_count     = depth - major_base_count
#   minor_af           = disagree_count / depth
#   filtered           = placeholder flag for future filtering logic
#
###############################################################################




#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## remap_internal_main(@ARGV) -- the internal --remap-* modes
##
##   samtools depth -aa X.bam | eurlc-wgs --remap-summary=depth --out X.depth_summary.json
##   samtools mpileup ... X.bam | eurlc-wgs --remap-summary=pileup \
##        --allele-counts X.allele_counts.tsv.gz --summary X.pileup_summary.json
##   eurlc-wgs --remap-check [--convert] [--keep <dir>] <folder> [<folder> ...]
##
## --remap-check looks below each folder for remap results made the earlier
## way (<base>.pileup.gz, <base>.depth.tsv and the remap_qc.json + 
## mixed_positions.tsv made from them), runs the streaming way on the same
## pileup and depth files, and compares: coverage, mapping and mixture values
## and the mixed_positions.tsv rows must be identical -- for the streaming
## way and for the earlier way as the pipeline now runs it (the code was split
## up, so both are checked against what the earlier code wrote). Nothing in the folders
## is changed; the new files go to a temporary folder (or --keep <dir>).
## Exit code 0 when every sample is identical, 1 otherwise.
## --convert: for each IDENTICAL sample, put the new files in its folder and
## remove <base>.depth.tsv and <base>.pileup.gz (the BAM is left alone; the
## cache and the table are already identical). A DIFFERENT sample is not touched.
##
## Runs before the pipeline is set up (called at the top of the main
## program), so it may only use subs and compile-time imports.
sub remap_internal_main {
    my ($mode_arg, @rest) = @_;
    {
        no warnings 'redefine';
        *log_message = sub { my ($m) = @_; $m .= "\n" unless $m =~ /\n$/; print STDERR $m; };
    }
    my $warn = sub { print STDERR "WARNING: $_[0]\n" };
    my (%o, @paths);
    while (@rest) {
        my $a = shift @rest;
        if ($a =~ /^--(convert)$/) {
            $o{$1} = 1;                       # a flag: never takes the next word
        } elsif ($a =~ /^--([\w-]+)(?:=(.*))?$/) {
            $o{$1} = defined $2 ? $2 : (@rest && $rest[0] !~ /^--/ ? shift @rest : 1);
        } else {
            push @paths, $a;
        }
    }

    my $ok = eval {
        if ($mode_arg =~ /^--remap-summary=depth$/) {
            die "--remap-summary=depth needs --out <file>\n" unless $o{out};
            remap_summary_depth_stream(\*STDIN, $o{out}, $o{cap});
            1;
        }
        elsif ($mode_arg =~ /^--remap-summary=pileup$/) {
            die "--remap-summary=pileup needs --allele-counts <file> and --summary <file>\n"
                unless $o{'allele-counts'} && $o{summary};
            remap_summary_pileup_stream(\*STDIN, allele_counts => $o{'allele-counts'},
                summary => $o{summary}, min_dp => $o{'min-dp'} // 20);
            1;
        }
        elsif ($mode_arg eq '--remap-check') {
            die "usage: eurlc-wgs --remap-check [--convert] [--keep <dir>] <output folder> [...]\n" unless @paths;
            return remap_check(\@paths, $o{keep}, $warn, $o{convert}) ? 0 : 1;
        }
        else {
            die "unknown internal mode [$mode_arg]\n";
        }
    };
    return $ok if defined $ok && $ok =~ /^[01]$/ && $mode_arg eq '--remap-check';
    unless ($ok) {
        print STDERR "ERROR: " . ($@ || "failed\n");
        return 1;
    }
    return 0;
}

sub remap_check {
    my ($paths, $keep, $warn, $convert) = @_;
    require File::Find;
    require File::Temp;

    my @found;
    for my $p (@$paths) {
        die "not a folder: $p\n" unless -d $p;
        File::Find::find({ no_chdir => 1, wanted => sub {
            $File::Find::prune = 1 if -d $_ && $_ =~ m{/(large_files|report)$};
            return unless /\.pileup\.gz$/ && -f $_;
            push @found, $_;
        } }, $p);
    }
    die "no <sample>.pileup.gz found below: @$paths\n" unless @found;

    my $tmp_root = $keep // File::Temp::tempdir("eurlc-wgs-remap-check-XXXXXX", TMPDIR => 1, CLEANUP => 1);
    mkdir $tmp_root unless -d $tmp_root;

    my $norm;
    $norm = sub {
        my ($x) = @_;
        return { map { $_ => $norm->($x->{$_}) } keys %$x } if ref $x eq 'HASH';
        return [ map { $norm->($_) } @$x ] if ref $x eq 'ARRAY';
        return defined $x ? "$x" : undef;
    };
    my $diff;
    $diff = sub {
        my ($a, $b, $path, $out) = @_;
        return if @$out >= 15;
        if (ref $a eq 'HASH' && ref $b eq 'HASH') {
            my %k = map { $_ => 1 } (keys %$a, keys %$b);
            $diff->($a->{$_}, $b->{$_}, "$path.$_", $out) for sort keys %k;
        } elsif (ref $a eq 'ARRAY' && ref $b eq 'ARRAY') {
            my $n = @$a > @$b ? @$a : @$b;
            $diff->($a->[$_], $b->[$_], "$path\[$_\]", $out) for 0 .. $n - 1;
        } else {
            my $sa = ref $a ? JSON::MaybeXS->new(canonical => 1)->encode($a) : ($a // "(none)");
            my $sb = ref $b ? JSON::MaybeXS->new(canonical => 1)->encode($b) : ($b // "(none)");
            push @$out, "$path: $sa -> $sb" if $sa ne $sb;
        }
    };

    my ($n_same, $n_diff, $n_skip, $n_conv) = (0, 0, 0, 0);
    my ($bytes_old, $bytes_new) = (0, 0);
    for my $pileup (sort @found) {
        (my $dir = $pileup) =~ s{/[^/]+$}{};
        (my $base = $pileup) =~ s{^.*/|\.pileup\.gz$}{}g;
        my $label = $dir =~ m{([^/]+)/eurlc-wgs/} ? "$1/$base" : $base;
        my $cache = remap_read_json_file("$dir/$base.remap_qc.json");
        my $ref_tsv = "$dir/$base.mixed_positions.tsv";
        if (!-s "$dir/$base.depth.tsv" || ref $cache ne 'HASH' || !-s $ref_tsv) {
            print "SKIP       $label: needs $base.depth.tsv, $base.remap_qc.json and $base.mixed_positions.tsv\n";
            $n_skip++;
            next;
        }
        if (($cache->{mixture}{method_version} // 1) < REMAP_MIXTURE_METHOD_VERSION()) {
            print "SKIP       $label: remap_qc.json has mixture method " . ($cache->{mixture}{method_version} // 1)
                . " -- run eurlc-wgs --resume in that output folder first\n";
            $n_skip++;
            next;
        }
        my $work = "$tmp_root/" . ($label =~ s{/}{__}gr);
        mkdir $work;
        my $t0 = time();

        open(my $dfh, "<", "$dir/$base.depth.tsv") or do { print "SKIP       $label: $!\n"; $n_skip++; next; };
        remap_summary_depth_stream($dfh, "$work/$base.depth_summary.json");
        close $dfh;
        open(my $pfh, "-|", "gzip", "-dc", $pileup) or do { print "SKIP       $label: $!\n"; $n_skip++; next; };
        remap_summary_pileup_stream($pfh, allele_counts => "$work/$base.allele_counts.tsv.gz",
                                    summary => "$work/$base.pileup_summary.json", min_dp => 20);
        close $pfh;

        my %P = (remap_mixture_defaults(), %{ $cache->{mixture}{mixed_params} // {} });
        my $new = parse_remap_qc($dir, undef,
            base           => $base,
            depth_summary  => remap_read_json_file("$work/$base.depth_summary.json"),
            pileup_summary => remap_read_json_file("$work/$base.pileup_summary.json"),
            allele_counts  => "$work/$base.allele_counts.tsv.gz",
            mixed_tsv      => "$work/$base.mixed_positions.tsv",
            params         => \%P,
            warn           => $warn,
        );
        # The earlier way too, as the pipeline now does it for older folders
        my $old = parse_remap_qc($dir, undef,
            base => $base, force_old => 1, mixed_tsv => "$work/$base.mixed_positions.earlier_way.tsv",
            params => \%P, warn => $warn,
        );
        my @d;
        for my $way ([ "streaming", $new, "$work/$base.mixed_positions.tsv" ],
                     [ "earlier way", $old, "$work/$base.mixed_positions.earlier_way.tsv" ]) {
            my ($tag, $res, $tsv) = @$way;
            my @dw;
            for my $k (qw(mapping coverage mixture)) {
                $diff->($norm->($cache->{$k}), $norm->(decode_json(encode_json({ x => $res->{$k} }))->{x}), $k, \@dw);
            }
            # the table of positions, row by row
            if (open(my $fa, "<", $ref_tsv) and open(my $fb, "<", $tsv)) {
                my $line = 0;
                while (1) {
                    my $la = <$fa>; my $lb = <$fb>;
                    $line++;
                    last if !defined $la && !defined $lb;
                    if (($la // "(end of file)") ne ($lb // "(end of file)")) {
                        chomp(my $ca = $la // "(end of file)"); chomp(my $cb = $lb // "(end of file)");
                        push @dw, "mixed_positions.tsv line $line: [$ca] -> [$cb]";
                        last;
                    }
                }
            } else {
                push @dw, "mixed_positions.tsv could not be read";
            }
            push @d, map { "($tag) $_" } @dw;
        }
        my $old_b = (-s "$dir/$base.depth.tsv") + (-s $pileup);
        my $new_b = (-s "$work/$base.depth_summary.json") + (-s "$work/$base.pileup_summary.json")
                  + (-s "$work/$base.allele_counts.tsv.gz");
        $bytes_old += $old_b;
        $bytes_new += $new_b;
        my $sizes = sprintf("%.1f MB -> %.2f MB, %ds", $old_b / 1e6, $new_b / 1e6, time() - $t0);
        if (@d) {
            $n_diff++;
            print "DIFFERENT  $label ($sizes)\n";
            print "             $_\n" for @d;
        } else {
            $n_same++;
            my $note = "";
            if ($convert) {
                # Same results: the new files take over, the large ones go.
                my $ok = 1;
                for my $f ("$base.depth_summary.json", "$base.allele_counts.tsv.gz", "$base.pileup_summary.json") {
                    next if -s "$dir/$f";
                    $ok = 0 unless copy("$work/$f", "$dir/$f.part") && rename("$dir/$f.part", "$dir/$f");
                }
                if ($ok) {
                    unlink "$dir/$base.depth.tsv", $pileup;
                    $note = ", converted: depth.tsv and pileup.gz removed";
                    $n_conv++;
                } else {
                    $note = ", NOT converted (could not write the new files: $!)";
                }
            }
            print "IDENTICAL  $label ($sizes$note)\n";
        }
    }
    printf "\n%d identical, %d different, %d skipped. depth.tsv + pileup.gz %.1f MB -> new files %.2f MB\n",
        $n_same, $n_diff, $n_skip, $bytes_old / 1e6, $bytes_new / 1e6;
    print "Converted $n_conv sample(s): their remap results now come from the new files.\n" if $convert;
    print "New files kept in $tmp_root\n" if $keep;
    return $n_diff == 0 && $n_same > 0;
}

## parse_remap_qc($dir, $samplenr, %opt)
##   Reads the remap step's files. Coverage comes from <base>.depth_summary.json
##   when it is there, else from <base>.depth.tsv; the mixture metric from
##   <base>.pileup_summary.json + <base>.allele_counts.tsv.gz when they are
##   there, else from <base>.pileup.gz (folders made before the streaming way).
##   %opt (used by --remap-check): base, depth_summary / pileup_summary
##   (decoded hashes), allele_counts (path), mixed_tsv (path), params, warn,
##   force_old (read depth.tsv and pileup.gz even when the new files are there).
sub parse_remap_qc {
    my ($dir, $samplenr, %opt) = @_;

    my $base = $opt{base} // fill_placeholders("__BASE__", $samplenr);
    my $min_dp = 20;
    my $warn = $opt{warn} // sub { log_message("WARNING: $_[0]", "yellow") };

    my $mixed_sites_tsv = $opt{mixed_tsv} // File::Spec->catfile($dir, "$base.mixed_positions.tsv");

    my %res = (
        files => {
            flagstats       => File::Spec->catfile($dir, "$base.flagstats"),
            coverage        => File::Spec->catfile($dir, "$base.coverage"),
            idxstats        => File::Spec->catfile($dir, "$base.idxstats"),
            stats           => File::Spec->catfile($dir, "$base.stats"),
            depth_tsv       => File::Spec->catfile($dir, "$base.depth.tsv"),
            pileup          => File::Spec->catfile($dir, "$base.pileup.gz"),
            depth_summary   => File::Spec->catfile($dir, "$base.depth_summary.json"),
            pileup_summary  => File::Spec->catfile($dir, "$base.pileup_summary.json"),
            allele_counts   => File::Spec->catfile($dir, "$base.allele_counts.tsv.gz"),
            mixed_sites_tsv => $mixed_sites_tsv,
        },
        mapping  => {},
        coverage => {},
        warnings => [],
    );

    # ---------- helpers ----------
    my $read_lines = sub {
        my ($path) = @_;
        return [] unless -e $path;

        open(my $fh, "<", $path) or do {
            $warn->("Cannot open [$path]: $!");
            return [];
        };

        my @l = <$fh>;
        close($fh);
        return \@l;
    };

    my $pct = sub {
        my ($num, $den) = @_;
        return undef if !defined($den) || $den == 0;
        return sprintf("%.4f", 100 * $num / $den);
    };

    # ---------- parse flagstat ----------
    if (-e $res{files}{flagstats}) {
        my $lines = $read_lines->($res{files}{flagstats});
        my %fs;

        for my $ln (@$lines) {
            chomp($ln);

            if ($ln =~ /^(\d+)\s+\+\s+\d+\s+in total/) {
                $fs{reads_total} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+mapped\s+\(([\d.]+)%/) {
                $fs{reads_mapped}     = $1;
                $fs{reads_mapped_pct} = $2;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+properly paired\s+\(([\d.]+)%/) {
                $fs{properly_paired}     = $1;
                $fs{properly_paired_pct} = $2;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+paired in sequencing/) {
                $fs{paired_in_sequencing} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+read1/) {
                $fs{read1} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+read2/) {
                $fs{read2} = $1;
            }
            elsif ($ln =~ /^(\d+)\s+\+\s+\d+\s+singletons\s+\(([\d.]+)%/) {
                $fs{singletons}     = $1;
                $fs{singletons_pct} = $2;
            }
        }

        if (defined $fs{reads_total} && defined $fs{reads_mapped} && !defined $fs{reads_mapped_pct}) {
            $fs{reads_mapped_pct} = $pct->($fs{reads_mapped}, $fs{reads_total});
        }

        $res{mapping}{flagstat} = \%fs;
    }
    else {
        push @{ $res{warnings} }, "Missing flagstats file";
    }

    # ---------- parse samtools stats (SN lines) ----------
    if (-e $res{files}{stats}) {
        my $lines = $read_lines->($res{files}{stats});
        my %sn;

        for my $ln (@$lines) {
            chomp($ln);
            next unless $ln =~ /^SN\t([^:]+):\t(.+)$/;
            my ($k, $v) = ($1, $2);

            $v =~ s/\t\#.*$//;
            $v =~ s/\s+\#.*$//;
            $k =~ s/^\s+|\s+$//g;
            $v =~ s/^\s+|\s+$//g;

            $sn{$k} = $v;
        }

        my $get = sub {
            my ($key) = @_;
            return undef unless exists $sn{$key};
            my $v = $sn{$key};
            $v =~ s/,/./g if $key =~ /percentage/i;
            $v =~ s/^\s+|\s+$//g;
            return $v;
        };

        my %picked = (
            raw_total_sequences        => $get->('raw total sequences'),
            sequences                  => $get->('sequences'),
            reads_mapped               => $get->('reads mapped'),
            reads_unmapped             => $get->('reads unmapped'),
            reads_properly_paired      => $get->('reads properly paired'),
            reads_mapped_and_paired    => $get->('reads mapped and paired'),
            reads_MQ0                  => $get->('reads MQ0'),

            bases_mapped_cigar         => $get->('bases mapped (cigar)'),
            mismatches                 => $get->('mismatches'),
            error_rate                 => $get->('error rate'),

            average_length             => $get->('average length'),
            average_quality            => $get->('average quality'),

            insert_size_average        => $get->('insert size average'),
            insert_size_sd             => $get->('insert size standard deviation'),

            inward_oriented_pairs      => $get->('inward oriented pairs'),
            outward_oriented_pairs     => $get->('outward oriented pairs'),
            other_orientation_pairs    => $get->('pairs with other orientation'),
            pairs_diff_chromosomes     => $get->('pairs on different chromosomes'),

            properly_paired_pct        => $get->('percentage of properly paired reads (%)'),
        );

        if (defined $picked{raw_total_sequences} && $picked{raw_total_sequences} =~ /^\d+$/ &&
            defined $picked{reads_mapped}        && $picked{reads_mapped}        =~ /^\d+$/) {
            $picked{reads_mapped_pct} = sprintf("%.4f", 100 * $picked{reads_mapped} / $picked{raw_total_sequences});
        }

        if (defined $picked{bases_mapped_cigar} && $picked{bases_mapped_cigar} =~ /^\d+$/ &&
            defined $picked{mismatches}         && $picked{mismatches}         =~ /^\d+$/ &&
            (!defined $picked{error_rate} || $picked{error_rate} !~ /\S/)) {
            $picked{error_rate} = sprintf("%.6e", $picked{mismatches} / $picked{bases_mapped_cigar});
        }

        $res{mapping}{samtools_stats_sn_picked} = \%picked;
        $res{mapping}{samtools_stats_sn_all}    = \%sn;

        # Convenience aliases at mapping top level
        for my $k (keys %picked) {
            $res{mapping}{$k} = $picked{$k};
        }
    }
    else {
        push @{ $res{warnings} }, "Missing stats file";
    }

    # ---------- parse idxstats ----------
    if (-e $res{files}{idxstats}) {
        my $lines = $read_lines->($res{files}{idxstats});

        my $total_ref_len = 0;
        my $total_mapped  = 0;
        my $total_unmapped = 0;
        my @contigs;
        my %contig_lengths;

        for my $ln (@$lines) {
            chomp($ln);
            next if $ln eq "";

            my ($rname, $rlen, $mapped, $unmapped) = split(/\t/, $ln);
            next unless defined $unmapped;

            $total_ref_len += $rlen;
            $total_mapped  += $mapped;
            $total_unmapped += $unmapped;
            $contig_lengths{$rname} = 0 + $rlen;

            push @contigs, {
                contig   => $rname,
                length   => 0 + $rlen,
                mapped   => 0 + $mapped,
                unmapped => 0 + $unmapped,
            };
        }

        $res{coverage}{idxstats_total_ref_len} = $total_ref_len;
        $res{mapping}{idxstats_total_mapped}   = $total_mapped;
        $res{mapping}{idxstats_total_unmapped} = $total_unmapped;
        $res{coverage}{contig_lengths}         = \%contig_lengths;

        @contigs = sort { $b->{mapped} <=> $a->{mapped} } @contigs;
        splice(@contigs, 10) if @contigs > 10;
        $res{mapping}{top_contigs_by_mapped_reads} = \@contigs;
    }
    else {
        push @{ $res{warnings} }, "Missing idxstats file";
    }

    # ---------- parse samtools coverage ----------
    if (-e $res{files}{coverage}) {
        my $lines = $read_lines->($res{files}{coverage});

        my @hdr;
        my %col;
        my $header_seen = 0;

        my $total_len = 0;
        my $total_covbases = 0;
        my $sum_depth_x_len = 0;

        for my $ln (@$lines) {
            chomp($ln);
            next if $ln eq "";

            if ($ln =~ /^#/) {
                $ln =~ s/^\#//;
                @hdr = split(/\t/, $ln);
                %col = map { $hdr[$_] => $_ } 0 .. $#hdr;
                $header_seen = 1;
                next;
            }

            my @f = split(/\t/, $ln);

            my $rname     = $header_seen && exists $col{rname}     ? $f[$col{rname}]     : $f[0];
            my $startpos  = $header_seen && exists $col{startpos}  ? $f[$col{startpos}]  : undef;
            my $endpos    = $header_seen && exists $col{endpos}    ? $f[$col{endpos}]    : undef;
            my $covbases  = $header_seen && exists $col{covbases}  ? $f[$col{covbases}]  : undef;
            my $coverage  = $header_seen && exists $col{coverage}  ? $f[$col{coverage}]  : undef;
            my $meandepth = $header_seen && exists $col{meandepth} ? $f[$col{meandepth}] : undef;

            my $len = undef;
            if (defined $startpos && defined $endpos && $startpos =~ /^\d+$/ && $endpos =~ /^\d+$/) {
                $len = $endpos - $startpos + 1;
            }

            push @{ $res{coverage}{per_contig} }, {
                contig       => $rname,
                covbases     => defined($covbases)  ? 0 + $covbases  : undef,
                coverage_pct => defined($coverage)  ? 0 + $coverage  : undef,
                meandepth    => defined($meandepth) ? 0 + $meandepth : undef,
            };

            if (defined $len && defined $covbases && $len =~ /^\d+$/) {
                $total_len       += $len;
                $total_covbases  += $covbases;
                $sum_depth_x_len += (defined($meandepth) ? $meandepth : 0) * $len;
            }
        }

        if ($total_len > 0) {
            $res{coverage}{genome_len_from_coverage} = $total_len;
            $res{coverage}{covered_bases_1x}         = $total_covbases;
            $res{coverage}{breadth_1x_pct}           = sprintf("%.2f", 100 * $total_covbases / $total_len);
            $res{coverage}{mean_depth_weighted}      = sprintf("%.3f", $sum_depth_x_len / $total_len);
        }
        else {
            push @{ $res{warnings} }, "Could not compute genome_len from coverage file (missing start/end cols?)";
        }
    }
    else {
        push @{ $res{warnings} }, "Missing coverage file";
    }

    # ---------- breadth/depth: summary (streaming way) or depth file ----------
    my $contig_depth_ref;
    my $DS = $opt{force_old} ? undef : $opt{depth_summary} // remap_read_json_file($res{files}{depth_summary});
    if (ref $DS eq 'HASH') {
        my ($ds, $per) = depth_stats_from_summary($DS);
        @{ $res{coverage} }{ keys %$ds } = values %$ds if $ds;
        $contig_depth_ref = $per;
        $res{coverage}{depth_per_contig} = $contig_depth_ref if defined $contig_depth_ref;
    }
    elsif (-e $res{files}{depth_tsv}) {
        my $ds = depth_stats_from_file(path => $res{files}{depth_tsv}, cap => 5000);
        if ($ds) {
            @{ $res{coverage} }{ keys %$ds } = values %$ds;
        }

        $contig_depth_ref = depth_stats_per_contig_from_file(
            path => $res{files}{depth_tsv},
            cap  => 5000,
        );

        $res{coverage}{depth_per_contig} = $contig_depth_ref if defined $contig_depth_ref;
    }
    else {
        $res{coverage}{breadth_10x_pct} = undef;
        $res{coverage}{breadth_20x_pct} = undef;
        $res{coverage}{breadth_30x_pct} = undef;
        push @{ $res{warnings} }, "Missing depth file";
    }

    # ---------- mixture metric: allele counts (streaming way) or pileup ----------
    my $PS = $opt{force_old} ? undef : $opt{pileup_summary} // remap_read_json_file($res{files}{pileup_summary});
    my $ac = $opt{allele_counts} // $res{files}{allele_counts};
    my $mix;
    if (ref $PS eq 'HASH' && -s $ac) {
        $mix = remap_mixture_from_allele_counts(
            summary            => $PS,
            allele_counts      => $ac,
            out_tsv            => $mixed_sites_tsv,
            contig_depth_ref   => $contig_depth_ref,
            contig_lengths_ref => $res{coverage}{contig_lengths},
            params             => $opt{params},
            warn               => $warn,
        );
    }
    else {
        $mix = parse_pileup_minor_af_metrics(
            pileup             => $res{files}{pileup},
            min_dp             => $min_dp,
            out_tsv            => $mixed_sites_tsv,
            contig_depth_ref   => $contig_depth_ref,
            contig_lengths_ref => $res{coverage}{contig_lengths},
            params             => $opt{params},
            warn               => $warn,
        );
    }
    $res{mixture} = $mix if defined $mix;

    return \%res;
}

sub depth_stats_from_file {
    my (%opt) = @_;
    my $path = $opt{path};
    if (!defined $path || $path eq "") {
        log_message("WARNING: depth_stats_from_file: missing path", "yellow");
        return undef;
    }    
    
    my $cap  = $opt{cap} // 5000;   # cap huge depths
    my $min_pos = $opt{min_pos} // 1;

    unless (-s $path) {
        log_message("WARNING: Cannot read depth file, file missing or empty: [$path]", "yellow");
        return undef;
    }

    open(my $fh, "<", $path) or do {
        log_message("WARNING: Cannot open depth file [$path]: $!", "yellow");
        return undef;
    };

    my %hist;
    my $n = 0;
    my $sum = 0;

    my ($ge1, $ge10, $ge20, $ge30) = (0,0,0,0);

    while (my $ln = <$fh>) {
        chomp($ln);
        next if $ln eq "";
        my @f = split(/\t/, $ln);
        next unless @f >= 3;
        my $d = $f[2];
        next unless defined $d && $d =~ /^\d+$/;

        $n++;
        $sum += $d;

        $ge1 ++ if $d >= 1;
        $ge10++ if $d >= 10;
        $ge20++ if $d >= 20;
        $ge30++ if $d >= 30;

        $d = $cap if $d > $cap;
        $hist{$d}++;
    }
    close($fh);

    return undef if $n < $min_pos;

    my $q_from_hist = sub {
        my ($q) = @_; # 0..1
        my $target = int($q * ($n - 1));
        my $cum = 0;
        for my $k (sort { $a <=> $b } keys %hist) {
            $cum += $hist{$k};
            return $k if $cum > $target;
        }
        return (sort { $a <=> $b } keys %hist)[-1];
    };

    my $mean = $sum / $n;

    # If you also want SD/CV, compute it in a second pass over histogram:
    my $ss = 0;
    for my $k (keys %hist) {
        my $cnt = $hist{$k};
        my $diff = $k - $mean;
        $ss += $cnt * $diff * $diff;
    }
    my $sd = sqrt($ss / $n);
    my $cv = $mean > 0 ? ($sd / $mean) : undef;

    my $q1     = $q_from_hist->(0.25);
    my $median = $q_from_hist->(0.50);
    my $q3     = $q_from_hist->(0.75);
    my $iqr    = $q3 - $q1;

    return {
        depth_positions_total => $n,
        depth_mean            => sprintf("%.3f", $mean),
        depth_sd              => sprintf("%.3f", $sd),
        depth_cv              => defined($cv) ? sprintf("%.6f", $cv) : undef,

        depth_q1              => $q1,
        depth_median          => $median,
        depth_q3              => $q3,
        depth_iqr             => $iqr,
        depth_iqr_over_median => ($median > 0) ? sprintf("%.6f", $iqr / $median) : undef,

        breadth_1x_pct         => sprintf("%.5f", 100 * $ge1  / $n),
        breadth_10x_pct        => sprintf("%.5f", 100 * $ge10 / $n),
        breadth_20x_pct        => sprintf("%.5f", 100 * $ge20 / $n),
        breadth_30x_pct        => sprintf("%.5f", 100 * $ge30 / $n),
    };
}

sub depth_stats_per_contig_from_file {
    my (%opt) = @_;
    my $path = $opt{path};
    my $cap  = $opt{cap} // 5000;

    unless (-s $path) {
        log_message("WARNING: Cannot read depth file, file missing or empty: [$path]", "yellow");
        return undef;
    }

    open(my $fh, "<", $path) or do {
        log_message("WARNING: Cannot open depth file [$path]: $!", "yellow");
        return undef;
    };

    my %hist_by_contig;
    my %n_by_contig;

    while (my $ln = <$fh>) {
        chomp($ln);
        next if $ln eq "";
        my @f = split(/\t/, $ln);
        next unless @f >= 3;

        my ($contig, $pos, $d) = @f[0,1,2];
        next unless defined $d && $d =~ /^\d+$/;

        $n_by_contig{$contig}++;
        $d = $cap if $d > $cap;
        $hist_by_contig{$contig}{$d}++;
    }
    close($fh);

    my %out;

    for my $contig (keys %hist_by_contig) {
        my $n = $n_by_contig{$contig};
        next unless $n > 0;

        my $target = int(0.50 * ($n - 1));
        my $cum = 0;
        my $median = 0;

        for my $k (sort { $a <=> $b } keys %{ $hist_by_contig{$contig} }) {
            $cum += $hist_by_contig{$contig}{$k};
            if ($cum > $target) {
                $median = $k;
                last;
            }
        }

        $out{$contig}{median_depth} = $median;
        $out{$contig}{positions}    = $n;
    }

    return \%out;
}


###############################################################################
# Intra-species mixture metric from the pileup (method_version 2)
#
# Background: counting every position with minor allele fraction >= 5 % gave
# 27-589 "mixed" positions in clean Campylobacter samples (validation set D1),
# mostly positions carried by 1-3 reads, positions next to indels, and a few
# dense clusters in repeated genes. A close contaminant (34 cgMLST alleles
# apart) never rose above that background, even at 20 %.
#
# What is done instead:
#   1. A position is a candidate only if the SECOND most common base (among
#      A/C/G/T; deletions and N are not counted) is supported by enough reads,
#      on both strands, at a high enough fraction.
#   2. Positions with unusual depth, at contig ends, on short contigs, at or
#      next to indels, or with another candidate a few bases away are set aside.
#   3. What remains is counted as 1-kb WINDOWS with at least one such position.
#      A cluster of 40 positions in one repeated gene then counts once, while a
#      contaminating strain, whose differences are spread over the genome, hits
#      many windows.
#
# The numbers reported by the earlier method (sites_minoraf_* etc.) are still
# computed, unchanged, so old and new can be compared on the same run.
#
# Every setting is in the [remap_mixture] config section.
###############################################################################

# Raise when the method changes: a cached result with a lower number is parsed again.
sub REMAP_MIXTURE_METHOD_VERSION { return 2; }

sub remap_mixture_params {
    my %default = remap_mixture_defaults();
    my $cfg = (ref($R_cfg) eq 'HASH' && ref($R_cfg->{remap_mixture}) eq 'HASH') ? $R_cfg->{remap_mixture} : {};
    my %p;
    for my $key (sort keys %default) {
        my $value = $cfg->{$key};
        if (defined $value && $value =~ /^\s*(\d+(?:\.\d+)?)\s*$/) {
            $p{$key} = $1 + 0;
        }
        else {
            log_message("WARNING: [remap_mixture] $key=[$value] is not a number -- using the default ($default{$key})", "yellow")
                if defined $value && $value ne "";
            $p{$key} = $default{$key};
        }
    }
    $p{window_size} = $default{window_size} if $p{window_size} < 1;
    return \%p;
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## The mixture metric is split in three parts, so that the same code serves
## both the earlier way (pileup.gz on disk, parsed in result_parsing) and the
## streaming way (planned §36: samtools mpileup piped into
## eurlc-wgs --remap-summary=pileup, a sparse allele_counts.tsv.gz, the method
## run on that in result_parsing):
##
##   remap_pileup_record()      one mpileup line -> base counts per strand
##   remap_record_derive()      counts -> major/minor base, fractions, old-method bin
##   remap_mixture_from_rows()  filters, windows, the numbers, mixed_positions.tsv
##
## None of them uses global state (no log_message, no $R_cfg): they are also
## called from the internal --remap-* modes, before the pipeline is set up.

# Columns of allele_counts.tsv.gz (format 1). One row per position that the
# method can use: the earlier method's hits, positions whose second base has
# >= 2 reads, and positions where >= 3 reads have an indel or deletion.
sub REMAP_ALLELE_COUNT_COLUMNS {
    return qw(contig pos ref depth A_fwd A_rev C_fwd C_rev G_fwd G_rev T_fwd T_rev del indel_starts n);
}

## One mpileup line -> hashref with the counts, or undef when the line is not
## used (malformed, or depth below $min_dp).
sub remap_pileup_record {
    my ($ln, $min_dp) = @_;
    chomp($ln);
    return undef if $ln eq "";

    my ($chr, $pos, $ref, $dp, $bases) = split(/\t/, $ln);
    return undef unless defined $dp && $dp =~ /^\d+$/;
    return undef unless defined $ref && defined $bases;
    return undef if $dp < $min_dp;

    # Read-start markers are "^" plus one mapping-quality character, which can
    # itself be "+" or "-": they must go before indels are looked for.
    $bases =~ s/\^.//g if index($bases, '^') >= 0;

    # Indels are written after the base they follow: +2AG, -1t. Count them and cut them out.
    my $indel_starts = 0;
    if (index($bases, '+') >= 0 || index($bases, '-') >= 0) {
        my $clean = '';
        my $from  = 0;
        while ($bases =~ /[+-](\d+)/g) {
            my $start = $-[0];
            my $skip  = $+[0] + $1;
            $clean .= substr($bases, $from, $start - $from);
            $from = $skip > length($bases) ? length($bases) : $skip;
            pos($bases) = $from;
            $indel_starts++;
        }
        $clean .= substr($bases, $from);
        $bases = $clean;
    }

    my $refU = uc($ref);
    my $ref_fwd = ($bases =~ tr/.//);
    my $ref_rev = ($bases =~ tr/,//);
    my %r = (
        chr => $chr, pos => $pos, ref => $ref, dp => $dp,
        A_fwd => ($bases =~ tr/A//), C_fwd => ($bases =~ tr/C//), G_fwd => ($bases =~ tr/G//), T_fwd => ($bases =~ tr/T//),
        A_rev => ($bases =~ tr/a//), C_rev => ($bases =~ tr/c//), G_rev => ($bases =~ tr/g//), T_rev => ($bases =~ tr/t//),
        del          => ($bases =~ tr/*#//),     # the read has a deletion at this position
        indel_starts => $indel_starts,
        n            => ($bases =~ tr/Nn//),
    );
    if ($refU =~ /^[ACGT]$/) {
        $r{"${refU}_fwd"} += $ref_fwd;
        $r{"${refU}_rev"} += $ref_rev;
    }
    return \%r;
}

## Adds the derived values to a record from remap_pileup_record() (or read
## back from allele_counts.tsv.gz). Returns the old-method bin: 0, 1 (5-10 %),
## 2 (10-20 %) or 3 (>= 20 %).
sub remap_record_derive {
    my ($r) = @_;
    my @order = qw(A C G T);
    my %cnt = map { $_ => $r->{"${_}_fwd"} + $r->{"${_}_rev"} } @order;

    my $major_base  = "N";
    my $major_count = 0;
    for my $b (@order) {
        if ($cnt{$b} > $major_count) { $major_count = $cnt{$b}; $major_base = $b; }
    }
    my $minor_base  = "N";
    my $minor_count = 0;
    for my $b (@order) {
        next if $b eq $major_base;
        if ($cnt{$b} > $minor_count) { $minor_count = $cnt{$b}; $minor_base = $b; }
    }
    my $dp = $r->{dp};
    my $acgt_depth = $cnt{A} + $cnt{C} + $cnt{G} + $cnt{T};

    $r->{major_base}     = $major_base;
    $r->{major_count}    = $major_count;
    # earlier method: everything that is not the major base, over the pileup depth
    $r->{disagree_count} = $dp - $major_count;
    $r->{minor_af}       = $dp > 0 ? ($r->{disagree_count} / $dp) : 0;
    # new method: the second most common base, over A+C+G+T
    $r->{minor_base}     = $minor_base;
    $r->{minor_count}    = $minor_count;
    $r->{minor_fwd}      = $minor_base eq "N" ? 0 : $r->{"${minor_base}_fwd"};
    $r->{minor_rev}      = $minor_base eq "N" ? 0 : $r->{"${minor_base}_rev"};
    $r->{acgt_depth}     = $acgt_depth;
    $r->{minor_af_acgt}  = $acgt_depth > 0 ? ($minor_count / $acgt_depth) : 0;
    $r->{del_count}      = $r->{del};
    $r->{n_count}        = $r->{n};

    my $af = $r->{minor_af};
    return $af >= 0.20 ? 3 : $af >= 0.10 ? 2 : $af >= 0.05 ? 1 : 0;
}

## Is the record a candidate row (kept in mixed_positions.tsv)?
sub remap_record_is_candidate {
    my ($r, $bin) = @_;
    return $bin || ($r->{minor_count} >= 2 && $r->{minor_af_acgt} >= 0.02);
}

## Does the record mark an indel position for the indel filter?
sub remap_record_is_indel_position {
    my ($r, $P) = @_;
    my $k = $r->{indel_starts} + $r->{del};
    return $P->{indel_distance} > 0 && $k >= 3 && $r->{dp} > 0 && $k / $r->{dp} >= $P->{indel_fraction};
}

## Is the record worth keeping in allele_counts.tsv.gz? Wider than the two
## tests above, so that other [remap_mixture] values can be tried later.
sub remap_record_is_stored {
    my ($r, $bin) = @_;
    return $bin || $r->{minor_count} >= 2 || ($r->{indel_starts} + $r->{del}) >= 3;
}

## The old method's median and p95 of the fraction over all callable
## positions. Kept as a histogram of (disagreeing reads, depth) pairs rather
## than a list of millions of values; the result is the same as sorting the
## list (equal fractions are equal numbers, whatever pair they come from).
sub remap_old_method_quantiles {
    my ($hist) = @_;                       # {"disagree,depth" => count}
    my %by_value;
    my $n = 0;
    for my $k (keys %$hist) {
        my ($d, $dp) = split /,/, $k;
        my $v = $dp > 0 ? $d / $dp : 0;
        push @{ $by_value{$v} }, $v unless exists $by_value{$v};   # keep the number, not the string
        $by_value{$v}[1] += $hist->{$k};
        $n += $hist->{$k};
    }
    return (undef, undef) unless $n;
    my @vals = sort { $a->[0] <=> $b->[0] } values %by_value;
    my $pick = sub {
        my ($idx) = @_;
        my $cum = 0;
        for my $e (@vals) { $cum += $e->[1]; return $e->[0] if $cum > $idx; }
        return $vals[-1][0];
    };
    return (sprintf("%.6f", $pick->(int($n / 2))), sprintf("%.6f", $pick->(int(0.95 * ($n - 1)))));
}

## The default [remap_mixture] values (one place; remap_mixture_params reads the config on top).
sub remap_mixture_defaults {
    return (
        min_minor_reads            => 4,      # reads supporting the second base
        min_minor_reads_per_strand => 1,      # ... of which at least this many on each strand (0 = off)
        min_minor_af               => 0.05,   # second base / (A+C+G+T)
        min_depth_ratio            => 0.5,    # pileup depth / median depth of the contig
        max_depth_ratio            => 1.5,
        min_contig_length          => 2000,
        contig_end_margin          => 150,    # positions this close to a contig end are not used
        indel_fraction             => 0.2,    # a position where this share of reads has an indel or deletion ...
        indel_distance             => 5,      # ... sets aside candidates within this many bases (0 = off)
        neighbour_distance         => 10,     # candidates this close to each other are set aside (0 = off)
        window_size                => 1000,
    );
}

## Earlier way: read a whole pileup (file), then the method.
sub parse_pileup_minor_af_metrics {
    my (%opt) = @_;

    my $pileup = $opt{pileup};
    my $min_dp = $opt{min_dp} // 20;
    my $P = $opt{params} // remap_mixture_params();
    my $warn = $opt{warn} // sub { log_message("WARNING: $_[0]", "yellow") };

    if (!defined $pileup || $pileup eq "") {
        $warn->("parse_pileup_minor_af_metrics: missing pileup path");
        return undef;
    }
    unless (-s $pileup) {
        $warn->(($pileup =~ /\.gz$/ ? "Gzipped pileup" : "Pileup") . " file missing or empty: [$pileup]");
        return undef;
    }
    my $fh;
    if ($pileup =~ /\.gz$/) {
        open($fh, "-|", "gzip", "-dc", $pileup) or do { $warn->("Cannot open gzipped pileup [$pileup]: $!"); return undef; };
    } else {
        open($fh, "<", $pileup) or do { $warn->("Cannot open pileup [$pileup]: $!"); return undef; };
    }

    my %legacy = (callable => 0, bins => [0, 0, 0, 0]);
    my %af_hist;
    my (@rows, %indel_position);
    while (my $ln = <$fh>) {
        my $r = remap_pileup_record($ln, $min_dp) or next;
        $legacy{callable}++;
        my $bin = remap_record_derive($r);
        $af_hist{"$r->{disagree_count},$r->{dp}"}++;
        $legacy{bins}[$bin]++;
        $indel_position{ $r->{chr} }{ $r->{pos} } = 1 if remap_record_is_indel_position($r, $P);
        push @rows, $r if remap_record_is_candidate($r, $bin);
    }
    close($fh);
    @legacy{qw(minoraf_median minoraf_p95)} = remap_old_method_quantiles(\%af_hist);

    return remap_mixture_from_rows(
        rows => \@rows, indel_position => \%indel_position, legacy => \%legacy, params => $P,
        min_dp => $min_dp, out_tsv => $opt{out_tsv}, warn => $warn,
        contig_depth_ref => $opt{contig_depth_ref}, contig_lengths_ref => $opt{contig_lengths_ref},
    );
}

## Streaming way, second half: allele_counts.tsv.gz + pileup_summary.json -> the method.
sub remap_mixture_from_allele_counts {
    my (%opt) = @_;
    my $P    = $opt{params} // remap_mixture_params();
    my $warn = $opt{warn} // sub { log_message("WARNING: $_[0]", "yellow") };
    my $S    = $opt{summary};          # decoded pileup_summary.json
    my $path = $opt{allele_counts};

    unless (ref $S eq 'HASH' && defined $S->{callable}) {
        $warn->("pileup summary missing or invalid -- no mixture values");
        return undef;
    }
    my $fh;
    unless (defined $path && -s $path && open($fh, "-|", "gzip", "-dc", $path)) {
        $warn->("Cannot read allele counts [" . ($path // "") . "] -- no mixture values");
        return undef;
    }
    my @cols = REMAP_ALLELE_COUNT_COLUMNS();
    my (@rows, %indel_position);
    my $header_seen = 0;
    while (my $ln = <$fh>) {
        next if $ln =~ /^#/;
        chomp $ln;
        my @f = split(/\t/, $ln, -1);
        if (!$header_seen) { $header_seen = 1; next if $f[0] eq 'contig'; }
        next unless @f == @cols;
        my %r;
        @r{@cols} = @f;
        $r{chr} = delete $r{contig};
        $r{dp}  = delete $r{depth};
        my $bin = remap_record_derive(\%r);
        $indel_position{ $r{chr} }{ $r{pos} } = 1 if remap_record_is_indel_position(\%r, $P);
        push @rows, \%r if remap_record_is_candidate(\%r, $bin);
    }
    close($fh);

    my %legacy = (
        callable       => $S->{callable},
        bins           => [ 0, @{ $S->{old_method_bins} // [0, 0, 0] } ],
        minoraf_median => $S->{old_method_minoraf_median},
        minoraf_p95    => $S->{old_method_minoraf_p95},
    );
    return remap_mixture_from_rows(
        rows => \@rows, indel_position => \%indel_position, legacy => \%legacy, params => $P,
        min_dp => $S->{min_dp} // 20, out_tsv => $opt{out_tsv}, warn => $warn,
        contig_depth_ref => $opt{contig_depth_ref}, contig_lengths_ref => $opt{contig_lengths_ref},
    );
}

## The method itself: filters, windows, numbers, and mixed_positions.tsv.
sub remap_mixture_from_rows {
    my (%opt) = @_;
    my @rows               = @{ $opt{rows} };
    my %indel_position     = %{ $opt{indel_position} };
    my $L                  = $opt{legacy};
    my $P                  = $opt{params};
    my $min_dp             = $opt{min_dp} // 20;
    my $out_tsv            = $opt{out_tsv};
    my $warn               = $opt{warn} // sub { warn "WARNING: $_[0]\n" };
    my $contig_depth_ref   = $opt{contig_depth_ref}   // {};
    my $contig_lengths_ref = $opt{contig_lengths_ref} // {};
    my $callable = $L->{callable};
    my ($bin_5_10, $bin_10_20, $bin_ge_20) = @{ $L->{bins} }[1, 2, 3];

    # ---- new method: filters ------------------------------------------------
    # Each row gets the FIRST reason it is set aside for, or PASS. The order is
    # from "not a candidate at all" to "a candidate, but in a doubtful place".
    my %filter_count;
    my %passing_by_contig;      # {contig} = [ rows that passed everything so far ]

    for my $row (@rows) {
        my $chr = $row->{chr};
        my $contig_len   = $contig_lengths_ref->{$chr};
        my $median_depth = $contig_depth_ref->{$chr}{median_depth};

        $row->{contig_len}   = $contig_len   // "n/a";
        $row->{median_depth} = $median_depth // "n/a";
        my $ratio;
        if (defined $median_depth && $median_depth =~ /^\d+(?:\.\d+)?$/ && $median_depth > 0) {
            $ratio = $row->{dp} / $median_depth;
        }
        $row->{depth_over_median} = defined $ratio ? sprintf("%.6f", $ratio) : "n/a";

        my $reason = "PASS";
        if ($row->{minor_count} < $P->{min_minor_reads}) {
            $reason = "few_reads";
        }
        elsif ($row->{minor_af_acgt} < $P->{min_minor_af}) {
            $reason = "low_af";
        }
        elsif ($row->{minor_fwd} < $P->{min_minor_reads_per_strand} || $row->{minor_rev} < $P->{min_minor_reads_per_strand}) {
            $reason = "one_strand";
        }
        elsif (!defined $ratio || $ratio < $P->{min_depth_ratio} || $ratio > $P->{max_depth_ratio}) {
            $reason = "depth";
        }
        elsif (!defined $contig_len || $contig_len !~ /^\d+$/ || $contig_len < $P->{min_contig_length}) {
            $reason = "short_contig";
        }
        elsif ($row->{pos} <= $P->{contig_end_margin} || $row->{pos} > $contig_len - $P->{contig_end_margin}) {
            $reason = "contig_end";
        }
        elsif ($P->{indel_distance} > 0 && exists $indel_position{$chr}) {
            for my $near ($row->{pos} - $P->{indel_distance} .. $row->{pos} + $P->{indel_distance}) {
                if ($indel_position{$chr}{$near}) {
                    $reason = "indel";
                    last;
                }
            }
        }
        $row->{filter} = $reason;
        push @{ $passing_by_contig{$chr} }, $row if $reason eq "PASS";
    }

    # Candidates a few bases from each other: the pattern of a misaligned read end
    # or a small rearrangement, not of independent base differences.
    if ($P->{neighbour_distance} > 0) {
        for my $chr (keys %passing_by_contig) {
            my @sorted = sort { $a->{pos} <=> $b->{pos} } @{ $passing_by_contig{$chr} };
            for my $k (0 .. $#sorted) {
                my $close = 0;
                $close = 1 if $k > 0        && $sorted[$k]{pos} - $sorted[$k - 1]{pos} <= $P->{neighbour_distance};
                $close = 1 if $k < $#sorted && $sorted[$k + 1]{pos} - $sorted[$k]{pos} <= $P->{neighbour_distance};
                $sorted[$k]{neighbour} = $close;
            }
            for my $row (@sorted) {
                $row->{filter} = "neighbour" if delete $row->{neighbour};
            }
            $passing_by_contig{$chr} = [ grep { $_->{filter} eq "PASS" } @sorted ];
        }
    }

    # ---- new method: the numbers --------------------------------------------
    my $window = $P->{window_size};
    my (%window_hit, @pass_afs);
    my $sites_pass = 0;
    my $sites_isolated = 0;

    for my $chr (keys %passing_by_contig) {
        my @sorted = sort { $a->{pos} <=> $b->{pos} } @{ $passing_by_contig{$chr} };
        for my $k (0 .. $#sorted) {
            $sites_pass++;
            $window_hit{ $chr . "\t" . int($sorted[$k]{pos} / $window) } = 1;
            push @pass_afs, $sorted[$k]{minor_af_acgt};
            my $alone = 1;
            $alone = 0 if $k > 0        && $sorted[$k]{pos} - $sorted[$k - 1]{pos} <= $window;
            $alone = 0 if $k < $#sorted && $sorted[$k + 1]{pos} - $sorted[$k]{pos} <= $window;
            $sites_isolated++ if $alone;
        }
    }
    $filter_count{ $_->{filter} }++ for @rows;

    # How many windows there are to hit: on the contigs that are long enough to be used.
    my $windows_total = 0;
    for my $chr (keys %$contig_lengths_ref) {
        my $len = $contig_lengths_ref->{$chr};
        next unless defined $len && $len =~ /^\d+$/ && $len >= $P->{min_contig_length};
        $windows_total += int($len / $window) + 1;
    }

    # ---- the table of positions ---------------------------------------------
    if (defined $out_tsv && $out_tsv ne "") {
        if (open(my $tfh, ">", $out_tsv)) {
            print {$tfh} join("\t",
                qw(contig contig_length position ref_base depth median_depth depth_over_median major_base major_base_count disagree_count minor_af filtered),
                qw(minor_base minor_count minor_fwd minor_rev acgt_depth minor_af_acgt del_count indel_starts n_count filter)
            ), "\n";
            for my $row (@rows) {
                print {$tfh} join("\t",
                    $row->{chr},
                    $row->{contig_len},
                    $row->{pos},
                    $row->{ref},
                    $row->{dp},
                    $row->{median_depth},
                    $row->{depth_over_median},
                    $row->{major_base},
                    $row->{major_count},
                    $row->{disagree_count},
                    sprintf("%.6f", $row->{minor_af}),
                    ($row->{filter} eq "PASS" ? 0 : 1),
                    $row->{minor_base},
                    $row->{minor_count},
                    $row->{minor_fwd},
                    $row->{minor_rev},
                    $row->{acgt_depth},
                    sprintf("%.6f", $row->{minor_af_acgt}),
                    $row->{del_count},
                    $row->{indel_starts},
                    $row->{n_count},
                    $row->{filter},
                ), "\n";
            }
            close($tfh);
        }
        else {
            $warn->("Cannot write mixed-position TSV [$out_tsv]: $!");
        }
    }

    my %out;

    # ---- earlier method (unchanged) -------------------------------------------
    $out{"callable_sites_dp_ge_$min_dp"} = $callable;

    $out{"sites_minoraf_0_05_to_0_10_dp$min_dp"} = $bin_5_10;
    $out{"sites_minoraf_0_10_to_0_20_dp$min_dp"} = $bin_10_20;
    $out{"sites_minoraf_ge_0_20_dp$min_dp"}      = $bin_ge_20;

    $out{"rate_minoraf_0_05_to_0_10_dp$min_dp"} = $callable ? sprintf("%.6f", $bin_5_10  / $callable) : sprintf("%.6f", 0);
    $out{"rate_minoraf_0_10_to_0_20_dp$min_dp"} = $callable ? sprintf("%.6f", $bin_10_20 / $callable) : sprintf("%.6f", 0);
    $out{"rate_minoraf_ge_0_20_dp$min_dp"}      = $callable ? sprintf("%.6f", $bin_ge_20 / $callable) : sprintf("%.6f", 0);

    $out{"minoraf_median_dp$min_dp"} = $L->{minoraf_median};
    $out{"minoraf_p95_dp$min_dp"}    = $L->{minoraf_p95};

    # ---- new method ---------------------------------------------------------
    $out{method_version}        = REMAP_MIXTURE_METHOD_VERSION();
    $out{mixed_windows}         = scalar(keys %window_hit);     # the number to judge a sample by
    $out{mixed_windows_total}   = $windows_total;
    $out{mixed_windows_pct}     = $windows_total ? sprintf("%.2f", 100 * scalar(keys %window_hit) / $windows_total) : undef;
    $out{mixed_sites}           = $sites_pass;
    $out{mixed_sites_isolated}  = $sites_isolated;
    if (@pass_afs) {
        @pass_afs = sort { $a <=> $b } @pass_afs;
        $out{mixed_minoraf_median} = sprintf("%.4f", $pass_afs[int(@pass_afs / 2)]);
    }
    else {
        $out{mixed_minoraf_median} = undef;
    }
    $out{mixed_candidates}      = scalar(@rows);
    $out{mixed_filter_counts}   = \%filter_count;
    $out{mixed_params}          = { %$P };

    return \%out;
}


#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## Streaming way, first half: runs inside the remap step (eurlc-wgs
## --remap-summary=...), reading samtools output from a pipe.

sub remap_write_json_atomic {
    my ($data, $path) = @_;
    open(my $fh, ">", "$path.part") or die "Cannot write [$path.part]: $!\n";
    print {$fh} JSON::MaybeXS->new(utf8 => 1, pretty => 1, canonical => 1)->encode($data);
    close($fh) or die "Cannot write [$path.part]: $!\n";
    rename("$path.part", $path) or die "Cannot rename [$path.part]: $!\n";
}

sub remap_read_json_file {
    my ($path) = @_;
    return undef unless defined $path && -s $path;
    open(my $fh, "<", $path) or return undef;
    local $/;
    my $txt = <$fh>;
    close($fh);
    return eval { JSON::MaybeXS->new(utf8 => 1)->decode($txt) };
}

## samtools depth -aa -> per-contig positions, depth sum and depth histogram
## (capped at $cap, as depth_stats_from_file does).
sub remap_summary_depth_stream {
    my ($in, $out_path, $cap) = @_;
    $cap //= 5000;
    my (%n, %sum, %hist, @order);
    while (my $ln = <$in>) {
        chomp($ln);
        next if $ln eq "";
        my @f = split(/\t/, $ln);
        next unless @f >= 3;
        my ($c, $d) = @f[0, 2];
        next unless defined $d && $d =~ /^\d+$/;
        push @order, $c unless exists $n{$c};
        $n{$c}++;
        $sum{$c} += $d;
        $d = $cap if $d > $cap;
        $hist{$c}{$d}++;
    }
    my @contigs = map {
        my $c = $_;
        { name => $c, n => $n{$c}, sum => $sum{$c},
          hist => [ map { [ $_ + 0, $hist{$c}{$_} ] } sort { $a <=> $b } keys %{ $hist{$c} } ] }
    } @order;
    remap_write_json_atomic({ format_version => 1, cap => $cap, contigs => \@contigs }, $out_path);
    return scalar @order;
}

## samtools mpileup -> allele_counts.tsv.gz (sparse) and pileup_summary.json
## (the earlier method's totals over all callable positions). The summary is
## written last: it is the step's result file.
sub remap_summary_pileup_stream {
    my ($in, %o) = @_;
    my $min_dp = $o{min_dp} // 20;
    require IO::Compress::Gzip;
    my $ac = $o{allele_counts};
    my $z = IO::Compress::Gzip->new("$ac.part", Minimal => 1)
        or die "Cannot write [$ac.part]\n";
    my @cols = REMAP_ALLELE_COUNT_COLUMNS();
    $z->print("# eurlc-wgs allele_counts format_version=1 min_dp=$min_dp\n");
    $z->print(join("\t", @cols), "\n");

    my ($lines, $callable, $stored) = (0, 0, 0);
    my @bins = (0, 0, 0, 0);
    my %af_hist;
    while (my $ln = <$in>) {
        $lines++;
        my $r = remap_pileup_record($ln, $min_dp) or next;
        $callable++;
        my $bin = remap_record_derive($r);
        $bins[$bin]++;
        $af_hist{"$r->{disagree_count},$r->{dp}"}++;
        next unless remap_record_is_stored($r, $bin);
        $stored++;
        $z->print(join("\t", $r->{chr}, $r->{pos}, $r->{ref}, $r->{dp},
            @$r{qw(A_fwd A_rev C_fwd C_rev G_fwd G_rev T_fwd T_rev del indel_starts n)}), "\n");
    }
    $z->close() or die "Cannot write [$ac.part]\n";
    rename("$ac.part", $ac) or die "Cannot rename [$ac.part]: $!\n";

    my ($median, $p95) = remap_old_method_quantiles(\%af_hist);
    remap_write_json_atomic({
        format_version            => 1,
        min_dp                    => $min_dp,
        pileup_lines              => $lines,
        callable                  => $callable,
        old_method_bins           => [ @bins[1, 2, 3] ],     # 5-10 %, 10-20 %, >= 20 %
        old_method_minoraf_median => $median,
        old_method_minoraf_p95    => $p95,
        allele_count_rows         => $stored,
    }, $o{summary});
    return $callable;
}

## Coverage values from depth_summary.json: the same keys and values as
## depth_stats_from_file() + depth_stats_per_contig_from_file().
sub depth_stats_from_summary {
    my ($S) = @_;
    return (undef, undef) unless ref $S eq 'HASH' && ref $S->{contigs} eq 'ARRAY';
    my (%hist, %per);
    my ($n, $sum) = (0, 0);
    for my $c (@{ $S->{contigs} }) {
        $n   += $c->{n};
        $sum += $c->{sum};
        my $cn = $c->{n};
        my $target = int(0.50 * ($cn - 1));
        my ($cum, $median) = (0, 0);
        for my $e (@{ $c->{hist} }) {
            $hist{ $e->[0] } += $e->[1];
            next if $cum > $target;
            $cum += $e->[1];
            $median = $e->[0] if $cum > $target;
        }
        $per{ $c->{name} } = { median_depth => $median, positions => $cn } if $cn > 0;
    }
    return (undef, \%per) if $n < 1;

    my @keys = sort { $a <=> $b } keys %hist;
    my ($ge1, $ge10, $ge20, $ge30) = (0, 0, 0, 0);
    for my $k (@keys) {
        $ge1  += $hist{$k} if $k >= 1;
        $ge10 += $hist{$k} if $k >= 10;
        $ge20 += $hist{$k} if $k >= 20;
        $ge30 += $hist{$k} if $k >= 30;
    }
    my $q = sub {
        my $target = int($_[0] * ($n - 1));
        my $cum = 0;
        for my $k (@keys) { $cum += $hist{$k}; return $k if $cum > $target; }
        return $keys[-1];
    };
    my $mean = $sum / $n;
    my $ss = 0;
    for my $k (@keys) { my $diff = $k - $mean; $ss += $hist{$k} * $diff * $diff; }
    my $sd = sqrt($ss / $n);
    my $cv = $mean > 0 ? ($sd / $mean) : undef;
    my ($q1, $median, $q3) = map { $q->($_) } (0.25, 0.50, 0.75);
    my $iqr = $q3 - $q1;
    my %g = (
        depth_positions_total => $n,
        depth_mean            => sprintf("%.3f", $mean),
        depth_sd              => sprintf("%.3f", $sd),
        depth_cv              => defined($cv) ? sprintf("%.6f", $cv) : undef,
        depth_q1              => $q1,
        depth_median          => $median,
        depth_q3              => $q3,
        depth_iqr             => $iqr,
        depth_iqr_over_median => ($median > 0) ? sprintf("%.6f", $iqr / $median) : undef,
        breadth_1x_pct        => sprintf("%.5f", 100 * $ge1  / $n),
        breadth_10x_pct       => sprintf("%.5f", 100 * $ge10 / $n),
        breadth_20x_pct       => sprintf("%.5f", 100 * $ge20 / $n),
        breadth_30x_pct       => sprintf("%.5f", 100 * $ge30 / $n),
    );
    return (\%g, \%per);
}


