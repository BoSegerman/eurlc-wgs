$runstep_name = "remap";

$runstep{$runstep_name} = {
      message    => "Running Bowtie2 re-mapping...",
      long_name  => "Bowtie2 re-mapping",
      output_dir => "__DIR-QC3__/remapping/__BASE__",
      resultfile => "__DIR-QC3__/remapping/__BASE__/__BASE__.sorted.bam",
      cachefile  => "__DIR-QC3__/remapping/__BASE__/__BASE__.remap_qc.json",
      mixed_sites_tsv  => "__DIR-QC3__/remapping/__BASE__/__BASE__.mixed_positions.tsv",      
      resultfiles_status => "NA",
};


