#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep checkm

$runstep_name = "checkm";

$runstep{$runstep_name} = {
      message    => "Running CheckM...",
      long_name  => "CheckM (per-species batch)",
      output_dir => "__DIR-QC3__/CheckM/__SUBDIR__",
      resultfile => "__DIR-QC3__/CheckM/__SUBDIR__/checkm_results.tab",
      resultfiles_status => "NA",

      # Batch-level (runs once per species directory, via sort_assemblies'
      # output). Mutually exclusive with checkm_per_sample via
      # general.checkm_mode -- see the design discussion on evaluating the
      # time/result tradeoff between the two empirically.
      group      => 'checkm_mode',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'checkm_batch_done' ],
      applies_if => sub {
          return ( $R_cfg->{checkm}{enabled} && lc($R_cfg->{general}{checkm_mode} // 'per_species_batch') eq 'per_species_batch' ) ? 1 : 0;
      },
};

# TEMPLATES---------------------------------

# Two CheckM memory-management flags, both filled in by preprocessing below
# rather than hardcoded here, so they stay in one documented place rather
# than being duplicated across both checkm runsteps independently:
#
# __PPLACER-THREADS__ -- always forced to 1, not configurable. pplacer's
#   RAM usage is roughly per-thread (each thread loads its own copy of the
#   reference tree), so >1 thread multiplies an already-large memory
#   requirement for no benefit on the kind of hardware this pipeline
#   targets. See the comment on general.checkm_reduced_tree (config
#   defaults, near general.checkm_mode) for the full explanation.
#
# __CHECKM-REDUCED-TREE__ -- expands to "--reduced_tree" or "" depending on
#   general.checkm_reduced_tree (default on). This is the flag that
#   actually addresses the underlying ~35-40GB reference-tree memory
#   requirement (--pplacer_threads alone only prevents multiplying it).
$runstep{$runstep_name}{cmd_template} = wrap_cmd(<<CMD);
    conda run -n $R_cfg->{checkm}->{env} --no-capture-output checkm 
       data setRoot $R_cfg->{checkm}->{db_path} 
       __HIDE-OUTPUT__
    __NEWCOMMAND__   
    conda run -n $R_cfg->{checkm}->{env} --no-capture-output checkm lineage_wf 
       -x fasta 
       -t __THREADS__ 
       --pplacer_threads __PPLACER-THREADS__ 
       __CHECKM-REDUCED-TREE__
       --tab_table __INPUTDIR__ __OUTDIR__ 
       > __OUTDIR__/checkm_results.tab 
       __HIDE-STDERR__
CMD

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_checkm;

sub test_checkm {

   return check_conda_tool("checkm");

}

$runstep{$runstep_name}{preprocessing} = \&preprocess_checkm;

sub preprocess_checkm {

    my $runstep_name = "checkm";       
    
    my $command_template    = $runstep{$runstep_name}{cmd_template};    
    my $resultfile_template = $runstep{$runstep_name}{resultfile}; 
    my $outdir_template = $runstep{$runstep_name}{output_dir};
    my $command = "";

    # See the cmd_template comment above for what these two flags do and
    # why. __PPLACER-THREADS__ is always 1 (not configurable);
    # __CHECKM-REDUCED-TREE__ depends on general.checkm_reduced_tree.
    $command_template =~ s/__PPLACER-THREADS__/1/g;
    $command_template =~ s/__CHECKM-REDUCED-TREE__/ $R_cfg->{general}{checkm_reduced_tree} ? "--reduced_tree" : "" /ge;
    
    log_message("INFO: Preparing to run step $runstep_name on All samples ");
          
    # runstep specific replacements

 my $species_dir_count = $rundata{batches}{subdirs_count};

    # ------------------------------------------------------------
    # LOOP OVER SPECIES DIRECTORIES
    # ------------------------------------------------------------
    for my $j (0 .. $species_dir_count - 1) {
    

     my $dirname = $rundata{batches}{subdirs}[$j];
     my $species = $rundata{batches}{$dirname}{species};
     my $samples = $rundata{batches}{$dirname}{count};
     
     log_message("INFO: Checking species directory [$dirname] ($species)");
     
     # Collect list of sample names in this species dir
     my @listof_samples = ();
       
     for my $jj (0 .. $samples - 1) {
         my $fasta_path = $rundata{batches}{$dirname}{fasta}[$jj];
         my $filename = basename($fasta_path);
         (my $samplename = $filename) =~ s/\.fasta$//;
         push @listof_samples, $samplename;
     }
 

        
      # info from resultfile, if it exists
     my $resultfile = $resultfile_template;
     $resultfile =~ s/__SUBDIR__/$dirname/g;      
     $resultfile = fill_placeholders($resultfile, "", $runstep_name); 

    my $all_exists = 0;

    if (-f $resultfile) {
        my $result_ref = parse_checkm($resultfile);

        if (defined $result_ref->{bin_count} && $result_ref->{bin_count} > 0) {
            my %resultexists = map { $_->{bin_id} => 1 } @{ $result_ref->{checkm_results} // [] };
            my $missing = 0;

            foreach my $sample_base (@listof_samples) {
                if (!exists $resultexists{$sample_base}) {
                    $missing = 1;
                    last;
                }
            }

            $all_exists = !$missing;
        }
    }
            
  
     if( ! (-f  $resultfile) || !$all_exists){
     
       my $command_part  = $command_template;
       $command_part =~ s/__INPUTDIR__/__DIR-ASSEMBLIES__\/by_species\/$dirname/g;     
       $command_part =~ s/__OUTDIR__/__DIR-QC3__\/CheckM\/$dirname/g;    
       if($command eq ""){
         $command = $command_part;
       }
       else{
         $command = $command . "; " . $command_part;   
       }
       my $outdir = $outdir_template;
       $outdir =~ s/__SUBDIR__/$dirname/g; 
       $outdir = fill_placeholders($outdir, "", $runstep_name);       

       #create output dir
       ensure_dir($outdir);
    }else{
       log_message("NOTICE: Resultfile already exists for CheckM - $species, skipping...");
    }

   
  }  # end for hitcount (count of species after sorting)

     
   #format command
   $command  = fill_placeholders($command, "", $runstep_name);
    
   if($command eq ""){
     postprocess_checkm();
   }
   
   return $command; # success
    
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_checkm;

sub postprocess_checkm {
  

    my $runstep_name = "checkm";
    
    my $resultfile_template = $runstep{$runstep_name}{resultfile}; 
    
   my $hitcount = $rundata{batches}{subdirs_count};

  my @listof_samples = ();
   
   for(my $j=0;$j<$hitcount; $j++){
     my $dirname = $rundata{batches}{subdirs}[$j];
     my $species = $rundata{batches}{$dirname}{species};
     my $samples = $rundata{batches}{$dirname}{count};
     for( my $jj=0;$jj<$samples;$jj++){
         my $fasta_path = $rundata{batches}{$dirname}{fasta}[$jj];
         my $filename = basename($samples);
         my $samplename = $filename;
         $samplename =~ s/.fasta//g; 
         push @listof_samples, $samplename;
     }
 

     my $resultfile = $resultfile_template;
     $resultfile =~ s/__SUBDIR__/$dirname/g;      
     $resultfile = fill_placeholders($resultfile, "", $runstep_name); 

     my $result_ref = parse_checkm($resultfile);
     $rundata{batches}{$dirname}{checkm} = $result_ref; 
     my $hitcount_resultfile = $result_ref->{bin_count};
   
   log_message("NOTICE: CheckM results for species: $species", "green");
   for(my $jj=0;$jj<$hitcount_resultfile; $jj++){
   log_message("NOTICE: Sample: $result_ref->{checkm_results}[$jj]->{bin_id}  (lineage: $result_ref->{checkm_results}[$jj]->{marker_lineage}) [Completeness: $result_ref->{checkm_results}[$jj]->{completeness} Contamination:  $result_ref->{checkm_results}[$jj]->{contamination}]", "green");
   record_checkm_result_for_sample($result_ref->{checkm_results}[$jj]);
  }
   
  }  # end for hitcount (count of species after sorting)

  
    return 1; # success
}

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
## runstep checkm_per_sample
##
## Mutually exclusive with checkm (the per-species-batch mode above) via
## general.checkm_mode. Runs CheckM's lineage_wf on exactly one genome at a
## time -- avoids the pplacer-based taxonomic placement step (which CheckM
## runs jointly across every genome in a single lineage_wf invocation)
## being able to depend on which other samples happen to be in the same
## run, the same way EFSA's own per-sample CheckM usage does. Costs more
## total runtime than batching by species; the per-sample/batch split here
## exists specifically so that tradeoff -- and any actual result
## differences -- can be evaluated empirically by running both modes on
## the same data and comparing.
##
## NOTE: running one genome at a time does NOT reduce pplacer's memory
## requirement -- that cost comes from the reference tree CheckM loads,
## not from how many genomes are being placed. See general.checkm_reduced_tree
## (config defaults, near general.checkm_mode) and the cmd_template comment
## on the batch checkm runstep above for the full explanation.

$runstep_name = "checkm_per_sample";

$runstep{$runstep_name} = {

      # Resources for parallel scheduler (§ parallel_mode=on)
      resources  => { threads => $R_cfg->{general}{threads}, ram_gb => 16 },

      message    => "Running CheckM (per sample)...",
      long_name  => "CheckM (per sample)",
      output_dir => "__DIR-QC3__/CheckM_persample/__BASE__",
      resultfile => "__DIR-QC3__/CheckM_persample/__BASE__/checkm_results.tab",
      resultfiles_status => "NA",

      group      => 'checkm_mode',
      requires   => [ 'main_assembly_present' ],
      produces   => [ 'checkm_per_sample_done' ],
      applies_if => sub {
          return ( $R_cfg->{checkm}{enabled} && lc($R_cfg->{general}{checkm_mode} // 'per_species_batch') eq 'per_sample' ) ? 1 : 0;
      },
};

# TEST---------------------------------
$runstep{$runstep_name}{test} = \&test_checkm;   # same conda tool, shared test

# PRE---------------------------------

$runstep{$runstep_name}{preprocessing} = \&preprocess_checkm_per_sample;

sub preprocess_checkm_per_sample {
    my ($samplenr) = @_;

    my $runstep_name = "checkm_per_sample";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);
    my $outdir     = fill_placeholders($runstep{$runstep_name}{output_dir}, $samplenr, $runstep_name);

    if (-f $resultfile) {
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name already exists. Skipping");
        postprocess_checkm_per_sample($samplenr);
        return "";
    }

    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    # A staging directory containing only this sample's assembly --
    # symlinked, not copied, to avoid duplicating potentially large fasta
    # files on disk. CheckM's lineage_wf takes a directory of genomes; this
    # is what keeps that directory to exactly one.
    my $input_dir = "$outdir/input";
    ensure_dir($input_dir);
    ensure_dir($outdir);

    my $source_fasta = fill_placeholders("__DIR-ASSEMBLIES__/__BASE__.fasta", $samplenr, $runstep_name);
    my $symlink_path = "$input_dir/$sample_name.fasta";

    unless (-f $source_fasta) {
        log_message("WARNING: Sample $sample_name: source assembly file missing [$source_fasta], skipping CheckM (per sample)", "yellow");
        return "";
    }

    unless (-l $symlink_path || -f $symlink_path) {
        symlink($source_fasta, $symlink_path)
            or graceful_die("Could not symlink [$source_fasta] -> [$symlink_path]: $!");
    }

    # --pplacer_threads 1 (always) and --reduced_tree (config-driven) --
    # see the cmd_template comment on the batch checkm runstep above for
    # the full explanation of why both of these matter for memory usage.
    my $reduced_tree_flag = $R_cfg->{general}{checkm_reduced_tree} ? "--reduced_tree" : "";

    my $command = "conda run -n $R_cfg->{checkm}->{env} --no-capture-output checkm "
                . "data setRoot $R_cfg->{checkm}->{db_path} >/dev/null 2>&1 ; "
                . "conda run -n $R_cfg->{checkm}->{env} --no-capture-output checkm lineage_wf "
                . "-x fasta -t __THREADS__ --pplacer_threads 1 $reduced_tree_flag --tab_table '$input_dir' '$outdir' "
                . "> '$resultfile' 2>/dev/null";

    $command = fill_placeholders($command, $samplenr, $runstep_name);

    return $command;
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_checkm_per_sample;

sub postprocess_checkm_per_sample {
    my ($samplenr) = @_;

    my $runstep_name = "checkm_per_sample";
    my $sample_name  = $R_samples->[$samplenr]{name};

    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile}, $samplenr, $runstep_name);

    unless (-f $resultfile) {
        log_message("WARNING: CheckM (per sample) result file not found for sample $sample_name", "red");
        return 0;
    }

    my $result_ref = parse_checkm($resultfile);
    my $row = $result_ref->{checkm_results}[0];

    unless ($row) {
        log_message("WARNING: CheckM (per sample) produced no usable result for sample $sample_name", "red");
        return 0;
    }

    log_message("NOTICE: Sample: $sample_name (lineage: $row->{marker_lineage}) [Completeness: $row->{completeness} Contamination: $row->{contamination}]", "green");
    record_checkm_result_for_sample($row);

    return 1;
}


# PARSER---------------------------------

# Shared by both checkm runsteps (checkm/checkm_per_sample) -- attaches one
# parsed CheckM result row to the matching sample, by name (CheckM's bin_id
# is exactly __BASE__, i.e. $R_samples->[$i]{name}, since input fasta files
# are named __BASE__.fasta). Both modes write to the same canonical
# location, so nothing downstream needs to know or care which mode
# actually ran -- the same principle used throughout this migration.
#
# Fixes a real, previously-invisible gap: the batch mode parsed its shared
# per-species result table and logged it, but never actually attached any
# row to $R_samples->[$i]{results}{checkm} -- nothing anywhere in the
# codebase read from that location, so CheckM's results never reached any
# report, TSV export, or QC evaluation. This helper is what both modes now
# use to actually do that.
sub record_checkm_result_for_sample {
    my ($result_row) = @_;
    return unless $result_row && ref($result_row) eq 'HASH';

    my $bin_id = $result_row->{bin_id};
    return unless defined $bin_id && $bin_id ne '';

    for my $i ( 0 .. $#$R_samples ) {
        if ( $R_samples->[$i]{name} eq $bin_id ) {
            $R_samples->[$i]{results}{checkm} = $result_row;
            return 1;
        }
    }

    log_message("WARNING: CheckM result for bin [$bin_id] did not match any known sample", "red");
    return 0;
}

sub parse_checkm {
    my ($resultfile) = @_;

    my %checkm_data;       # final hash structure
    my @checkm_results;    # list of result rows


    my $fh;
    unless (open $fh, '<', $resultfile) {
        log_message("WARNING: could not open CheckM result file for resultfile [$resultfile]");
        return {};
    }

    my $header;
    my @columns;
    my $in_table = 0;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*$/;           # skip empty lines
        next if $line =~ /^\[/;             # skip log lines starting with [

        # Detect the start of the CheckM result table
        if (!$in_table && $line =~ /^Bin Id\t/) {
            $in_table = 1;
            $header = $line;
            @columns = split /\t/, $header;
            next;
        }

        # Skip everything before the table
        next unless $in_table;

        # Stop parsing if new INFO lines appear after the table
        last if $line =~ /^\[/;

        my @fields = split /\t/, $line;
        next unless @fields == @columns;    # skip malformed lines

        my %entry;
        @entry{@columns} = @fields;

        # Normalize keys (lowercase, underscores)
        for my $key (keys %entry) {
            my $normkey = lc($key);
            $normkey =~ s/[^a-z0-9]+/_/g;
            $entry{$normkey} = delete $entry{$key};
        }

        push @checkm_results, \%entry;
    }

    close $fh;

    if (!@checkm_results) {
        log_message("WARNING: no CheckM result table found for resultfile [$resultfile]");
    }

    $checkm_data{checkm_results} = \@checkm_results;
    $checkm_data{bin_count}      = scalar @checkm_results;

    return \%checkm_data;
}


