   return check_conda_tool("multiqc");
}

# PRE---------------------------------
$runstep{$runstep_name}{preprocessing} = \&preprocess_multiqc;

sub preprocess_multiqc {

    my $runstep_name = "multiqc";

    log_message("INFO: Preparing to run step $runstep_name on all samples");

    my $command = $runstep{$runstep_name}{cmd_template};
    $command = fill_placeholders($command, "", $runstep_name);

    my $qc1_report = fill_placeholders("__DIR-QC1__/multiqc_report.html", "", $runstep_name);
    my $qc2_report = fill_placeholders("__DIR-QC2__/multiqc_report.html", "", $runstep_name);
    my $qc3_report = fill_placeholders("__DIR-QC3__/multiqc_report.html", "", $runstep_name);

    # Store expected result files for later use / reporting
    $runstep{$runstep_name}{resultfiles} = [
        $qc1_report,
        $qc2_report,
        $qc3_report,
    ];

    # Skip if all expected reports already exist
    if (-s $qc1_report && -s $qc2_report && -s $qc3_report) {
        log_message("NOTICE: Skipping $runstep_name, all MultiQC reports already exist");
        postprocess_multiqc();
        return "";
    }

    return $command;
}
# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_multiqc;


sub postprocess_multiqc {

    my $runstep_name = "multiqc";

    my $R_resultfiles = $runstep{$runstep_name}{resultfiles} || [];

    foreach my $file (@$R_resultfiles) {
        if (!defined $file || !-s $file) {
            log_message("WARNING: Expected MultiQC result file missing or empty: [$file]");
            return 0;
        }
    }


for (my $samplenr = 0; $samplenr < @$R_samples; $samplenr++) {

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report1} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC1__/multiqc_report.html", "", $runstep_name)
        );

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report2} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC2__/multiqc_report.html", "", $runstep_name)
        );

    $R_samples->[$samplenr]{results}{$runstep_name}{txt_report3} =
        path_relative_to_outdir(
            fill_placeholders("__DIR-QC3__/multiqc_report.html", "", $runstep_name)
        );
}

    return 1;
}


