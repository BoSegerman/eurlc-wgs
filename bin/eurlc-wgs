sub preprocess_fastq_stats_trimmed {

    my ($samplenr) = @_;

    my $runstep_name = "fastq_stats_trimmed";    
    my $sample_name = $R_samples->[$samplenr]{name};  
    my $sample_type = $R_samples->[$samplenr]{type};     
    
    my $resultfile = fill_placeholders($runstep{$runstep_name}{resultfile},$samplenr);
    
    my $command  = "";
    
    if($sample_type eq "PE") {    
       $command    = "SUB\tfastq_qc\t__R1TD__\t__R2TD__\t__OUTDIR__\t$samplenr";     
    }

    if($sample_type eq "SE") {    
       $command    = "SUB\tfastq_qc\t__SETD__\t\t__OUTDIR__\t$samplenr";     
    }

    if($sample_type eq "FASTA") {    
       return "";     
    }
      
    log_message("INFO: Preparing to run step $runstep_name on sample $sample_name ");

    if(-f $resultfile  ){
        log_message("NOTICE: Runstep: $runstep{$runstep_name}{long_name} Sample: $sample_name  already exists. Skipping");
        postprocess_fastq_stats_trimmed($samplenr);
        return "";
    }
     
    # runstep specific replacements
    
     
    #format command
    $command  = fill_placeholders($command, $samplenr, $runstep_name);           

    #create output dir
    ensure_dir(fill_placeholders($runstep{$runstep_name}{output_dir},$samplenr));
    
    return $command; # success
    
}

# POST---------------------------------

$runstep{$runstep_name}{result_parsing} = \&postprocess_fastq_stats_trimmed;

sub postprocess_fastq_stats_trimmed {
    my ($samplenr) = @_;

    my $runstep_name = "fastq_stats_trimmed";
    my $sample_name  = $R_samples->[$samplenr]{name};
    my $sample_type  = $R_samples->[$samplenr]{type};


    my $outfolder = "__OUTDIR__";          
    my $json_file = "$outfolder/__BASE__.json";   

    $json_file = fill_placeholders($json_file,$samplenr,$runstep_name );

    if (!-e $json_file) {
        log_message("ERROR: [$runstep_name] Missing JSON output for sample [$sample_name]: $json_file", "red");
        return 0;
    }

    my $raw;
    my $fh;
    if (!open( $fh, "<:raw", $json_file)) {
        log_message("ERROR: [$runstep_name] Cannot open JSON for sample [$sample_name]: $json_file ($!)", "red");
        return 0;
    }
    {
        local $/;
        $raw = <$fh>;
    }
    close($fh);

    my $json = JSON::MaybeXS->new(utf8 => 1);

    my $qc;
    my $ok = eval {
        $qc = $json->decode($raw);
        1;
    };
    if (!$ok || ref($qc) ne "HASH") {
        my $err = $@ || "JSON did not decode to a HASH";
        chomp $err;
        log_message("ERROR: [$runstep_name] Failed to decode JSON for sample [$sample_name]: $err", "red");
        return 0;
    }

    # Attach results 
    $R_samples->[$samplenr]{results}{$runstep_name} = $qc;

    # Optional: store provenance
    $R_samples->[$samplenr]{results}{$runstep_name}{_meta} = {
        json_file   => $json_file,
        sample_name => $sample_name,
        sample_type => $sample_type,
    };

    log_message("INFO: [$runstep_name] Loaded QC JSON for sample [$sample_name] from $json_file");
    
    print_tabular_results("Total reads", "$R_samples->[$samplenr]{results}{$runstep_name}{R1}{reads} + $R_samples->[$samplenr]{results}{$runstep_name}{R2}{reads} = $R_samples->[$samplenr]{results}{$runstep_name}{total}{reads}");
    print_tabular_results("Total bases", "$R_samples->[$samplenr]{results}{$runstep_name}{total}{bases} ($R_samples->[$samplenr]{results}{$runstep_name}{R1}{bases} + $R_samples->[$samplenr]{results}{$runstep_name}{R2}{bases})");




    my $res = $R_samples->[$samplenr]{results}{$runstep_name};

    my $bases = $res->{total}{bases};
    my $Q30bases = $res->{total}{q30_bases};
    my $reads = $res->{total}{reads};
    my $genomesize = $R_samples->[$samplenr]{estimated_genomesize} // 0;
    my $maxdepth =  $R_samples->[$samplenr]{maxdepth};
    my $mindepth =  $R_samples->[$samplenr]{fatal_mindepth};
    my $gc =  $R_samples->[$samplenr]{gc} ;

      my $coverageQ30_after = safe_quota($Q30bases, $genomesize, "n/a");
      my $coverage_after = safe_quota($bases, $genomesize, "n/a");

      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{n_pct}           = $res->{total}{n_pct};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{gc}               = $res->{total}{gc_pct};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{av_read_len}      = $res->{total}{average};    
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P75_read_len}     = $res->{total}{q3};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P50_read_len}     = $res->{total}{median};                  
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P25_read_len}     = $res->{total}{q1};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P05_read_len}     = $res->{total}{q05};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{longest_read_len} = $res->{total}{longest};      
      
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{av_read_len_rel}  = safe_rel($res->{total}{average} , $res->{total}{longest}, "n/a");        
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P75_read_len_rel} = safe_rel($res->{total}{q3} , $res->{total}{longest}, "n/a"); 
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P50_read_len_rel} = safe_rel($res->{total}{median} , $res->{total}{longest}, "n/a");                   
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P25_read_len_rel} = safe_rel($res->{total}{q1} , $res->{total}{longest}, "n/a"); 
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{P05_read_len_rel} = safe_rel($res->{total}{q05} , $res->{total}{longest}, "n/a");       
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{adapter_pct}         = $res->{total}{adapter_pct};
      $R_samples->[$samplenr]{main_results}{qscore}{trimmed}{av_q_score}       = $res->{total}{avg_qual};

      $R_samples->[$samplenr]{main_results}{coverage}{trimmed}{q30_coverage} = $coverageQ30_after;
      $R_samples->[$samplenr]{main_results}{coverage}{trimmed}{coverage} = $coverage_after;

   ## check if below mindepth
   if(defined $R_samples->[$samplenr]{fatal_mindepth} && $R_samples->[$samplenr]{fatal_mindepth} ne "n/a" && defined $R_samples->[$samplenr]{mindepth} >0){
     if($coverage_after ne "n/a" && $coverage_after < $R_samples->[$samplenr]{fatal_mindepth}){
       set_runtime_issue($samplenr, "fail", "Coverage is below mindepth", $runstep_name);
       log_message("WARNING: Sample [$sample_name] failed to reach minimum required coverage!!!, Sample is excluded from further analysis","red");
     }
   }
   if(defined $R_samples->[$samplenr]{fatal_q30_mindepth} && $R_samples->[$samplenr]{fatal_q30_mindepth} ne "n/a" && defined $R_samples->[$samplenr]{q30_mindepth} >0){
     if($coverageQ30_after ne "n/a" && $coverageQ30_after < $R_samples->[$samplenr]{fatal_q30_mindepth}){
       set_runtime_issue($samplenr, "fail", "Q30-coverage is below Q30-mindepth", $runstep_name);
       log_message("WARNING: Sample [$sample_name] failed to reach minimum required Q30-coverage!!!, Sample is excluded from further analysis","red");
     }
   }   
   
  
print_tabular_results(
    "Longest read",
    "$res->{total}{longest} (R1: $res->{R1}{longest} R2: $res->{R2}{longest})"
);

print_tabular_results(
    "Shortest read",
    "$res->{total}{shortest} (R1: $res->{R1}{shortest} R2: $res->{R2}{shortest})"
);
if($res->{total}{longest} != 0){
    print_tabular_results(
        "Shortest read (%)",
        sprintf("%.2f", safe_rel($res->{total}{shortest}, $res->{total}{longest},-1) ) . "%"
    );
}
print_tabular_results(
    "Average length",
    "$res->{total}{average} (R1: $res->{R1}{average} R2: $res->{R2}{average})"
);
if($res->{total}{longest} != 0){
   print_tabular_results(
       "Average length (%)",
       sprintf("%.2f", safe_rel($res->{total}{average}, $res->{total}{longest} ,-1) ) . "%"
   );
}

print_tabular_results(
    "Median length",
    "$res->{total}{median} (R1: $res->{R1}{median} R2: $res->{R2}{median})"
);
if($res->{total}{longest} != 0){
    print_tabular_results(
        "Median length (%)",
        sprintf("%.2f", safe_rel($res->{total}{median}, $res->{total}{longest} ,-1) ) . "%"
    );
}

print_tabular_results(
    "Length 25th percentile",
    "$res->{total}{q1} (R1: $res->{R1}{q1} R2: $res->{R2}{q1})"
);
if($res->{total}{longest} != 0){
    print_tabular_results(
        "Length 25th percentile (%)",
        sprintf("%.2f", safe_rel($res->{total}{q1}, $res->{total}{longest} ,-1) ) . "%"
    );
}
print_tabular_results(
    "Length 75th percentile",
    "$res->{total}{q3} (R1: $res->{R1}{q3} R2: $res->{R2}{q3})"
);

if($res->{total}{longest} != 0){
    print_tabular_results(
        "Length 75th percentile (%)",
        sprintf("%.2f", safe_rel($res->{total}{q3}, $res->{total}{longest} ,-1) ) . "%"
    );
}
print_tabular_results(
    "Length 5th percentile",
    "$res->{total}{q05} (R1: $res->{R1}{q05} R2: $res->{R2}{q05})"
);
if($res->{total}{longest} != 0){
   print_tabular_results(
       "5th percentile (%)",
       sprintf("%.2f", safe_rel($res->{total}{q05}, $res->{total}{longest} ,-1) ) . "%"
   );
}
print_tabular_results(
    "N bases (%)",
    "$res->{total}{n_pct}% (R1: $res->{R1}{n_pct}% R2: $res->{R2}{n_pct}%)"
);

print_tabular_results(
    "GC (%)",
    "$res->{total}{gc_pct}% (R1: $res->{R1}{gc_pct}% R2: $res->{R2}{gc_pct}%)"
);
print_tabular_results(
    "Q30 bases (%)",
    "$res->{total}{q30_pct}% (R1: $res->{R1}{q30_pct}% R2: $res->{R2}{q30_pct}%)"
);

print_tabular_results(
    "mean Q score",
    "$res->{total}{avg_qual} ($res->{R1}{avg_qual} + $res->{R2}{avg_qual})"
);

print_tabular_results(
    "Median Q30 drop position",
    "$res->{total}{median_phred_q30_drop} ".
    "(R1: $res->{R1}{median_phred_q30_drop} R2: $res->{R2}{median_phred_q30_drop})"
);

print_tabular_results(
    "Median Q28 drop position",
    "$res->{total}{median_phred_q28_drop} ".
    "(R1: $res->{R1}{median_phred_q28_drop} R2: $res->{R2}{median_phred_q28_drop})"
);
print_tabular_results(
    "Adapters (%)",
    "$res->{total}{adapter_pct}% ($res->{R1}{adapter_pct}% + $res->{R2}{adapter_pct}%)"
);

    
        
    return 1; # success
}


