#!/usr/bin/env python3
# eurlc-efsa-export -- prepare EURLC-WGS results for the EFSA WGS System.
#
#   export   for every sample of a run: the files EFSA's programmatic submission
#            takes (experimentalData.json, typingData.json, allelicProfile.tsv,
#            optionally epidemiologicalData.json, and sampleData.json for the
#            API), a check of each sample against EFSA's business rules
#            (preflight.tsv), a manifest and a script with one `wgs upload`
#            line per sample that is ready
#   compat   EFSA's compatibility report: allelic profiles from this pipeline
#            against profiles from the EFSA Analytical Pipeline for the same
#            samples (perfect / acceptable / warning / fail)
#
# Nothing is ever sent: the upload is done by an appointed Data Provider.
# Reads the output folder; writes only to --out. Standard library only
# (Python >= 3.7).
#
# Sources: EFSA (2025) EN-9830; EFSA WGS System User Manual, "Programmatic
# submission" (business rules B1-B20) and "Analytical pipeline"; the EFSA
# One Health pipeline code (efsa.wgs.onehealth). Open questions are listed in
# docs/eurlc-efsa-export.md.
#
# Part of EURLC-WGS. GPL-3.0-or-later.

import argparse
import csv
import datetime
import gzip
import json
import os
import re
import sys
from collections import OrderedDict

VERSION = "0.1.0"

# ─────────────────────────────────────────────────────────────────────────────
# What EFSA expects, per species
# ─────────────────────────────────────────────────────────────────────────────

