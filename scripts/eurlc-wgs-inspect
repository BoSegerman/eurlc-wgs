#!/usr/bin/env python3
# eurlc-wgs-inspect — look at eurlc-wgs output folders without changing them.
#
#   inventory  what is in an output folder, what takes the space, what could
#              be removed or stored more compactly, duplicates; writes a
#              manifest (TSV) with sizes and optionally MD5 checksums
#   extract    a small .tar.gz with the tools' own result files, logs and
#              report tables for chosen samples (no reads, no BAM)
#   summarize  every sample of one or more runs in one table (QC measures,
#              status, species, typing), the spread of each measure per
#              species, how the thresholds fall out against what is known
#              about the samples, and the issues found across runs
#   compare    the results of one or more runs against a reference run, area by
#              area (after an update: what changed?; the same data run again:
#              repeatability), from the runs' results fingerprints
#   mixture    the intra-species mixture metric of every sample in one or more
#              output folders, with species and QC status, and its spread per
#              species (for choosing thresholds)
#
# Standard library only (Python >= 3.7). Reads the output folder, never
# writes to it (compare --out writes only where it is told).
#
# Part of EURLC-WGS. GPL-3.0-or-later.

import argparse
import datetime
import difflib
import fnmatch
import gzip
import hashlib
import io
import json
import os
import re
import sys
import tarfile
import urllib.parse
import zlib
from collections import defaultdict

VERSION = "0.4.0"

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            if unit == "B":
                return "%d B" % n
            return "%.1f %s" % (n, unit)
        n /= 1000.0


def die(msg, code=2):
    sys.stderr.write("eurlc-wgs-inspect: %s\n" % msg)
    sys.exit(code)


def warn(msg):
    sys.stderr.write("WARNING: %s\n" % msg)


def md5_file(path, bufsize=4 * 1024 * 1024):
    h = hashlib.md5()
    with open(path, "rb") as fh:
        while True:
            b = fh.read(bufsize)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def md5_bytes(b):
    return hashlib.md5(b).hexdigest()


def file_type(name):
    """'.bam', '.tsv', '.fasta', '.tsv.gz', '(none)' …"""
    low = name.lower()
    gz = ""
    if low.endswith(".gz"):
        gz = ".gz"
        low = low[:-3]
    base, ext = os.path.splitext(low)
    if not ext:
        return "(none)" + gz if gz else "(none)"
    return ext + gz


# ─────────────────────────────────────────────────────────────────────────────
# Reading an output folder (or a `find -printf '%s %p\n'` listing of one)
# ─────────────────────────────────────────────────────────────────────────────

class Tree:
    """All files of one output folder: rel path -> {size, mtime}."""

    def __init__(self):
        self.root = None          # real folder, or None for a listing
        self.label = ""
        self.files = {}           # rel -> dict(size=, mtime=)
        self.samples = []         # sample names (longest first for matching)
        self._sample_re = None

    @property
    def is_listing(self):
        return self.root is None

    # ── loading ──────────────────────────────────────────────────────────────
    @classmethod
    def from_folder(cls, path):
        path = os.path.abspath(path)
        if not os.path.isdir(path):
            die("not a folder: %s" % path)
        # Accept the data folder too: <datadir>/eurlc-wgs is the default out.
        if not looks_like_outdir(path) and looks_like_outdir(os.path.join(path, "eurlc-wgs")):
            path = os.path.join(path, "eurlc-wgs")
        if not looks_like_outdir(path):
            warn("[%s] does not look like an eurlc-wgs output folder (no log/ or results/); "
                 "continuing anyway" % path)
        t = cls()
        t.root = path
        t.label = path
        for dirpath, dirnames, filenames in os.walk(path):
            dirnames.sort()
            for fn in filenames:
                full = os.path.join(dirpath, fn)
                try:
                    st = os.lstat(full)
                except OSError as e:
                    warn("cannot stat %s: %s" % (full, e))
                    continue
                if os.path.islink(full):
                    continue      # a symlink takes no space of its own
                rel = os.path.relpath(full, path).replace(os.sep, "/")
                t.files[rel] = {"size": st.st_size, "mtime": int(st.st_mtime)}
        t._find_samples()
        return t

    @classmethod
    def from_listing(cls, listing):
        """Lines '<size> <path>' as written by find . -type f -printf '%s %p\\n'."""
        raw = []
        with open(listing, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.rstrip("\n")
                m = re.match(r"^\s*(\d+)\s+(.+)$", line)
                if not m:
                    continue
                p = m.group(2)
                if p.startswith("./"):
                    p = p[2:]
                raw.append((int(m.group(1)), p))
        if not raw:
            die("no '<size> <path>' lines in %s" % listing)
        # Where is the output folder inside the listing? The prefix in front
        # of log/run_status.json (or log/log.txt, or results/).
        prefix = None
        for marker in ("log/run_status.json", "log/log.txt", "log/run_summary.txt"):
            for _, p in raw:
                if p == marker or p.endswith("/" + marker):
                    prefix = p[: len(p) - len(marker)]
                    break
            if prefix is not None:
                break
        if prefix is None:
            prefix = ""
        t = cls()
        t.label = "%s (listing%s)" % (listing, (", folder " + prefix.rstrip("/")) if prefix else "")
        for size, p in raw:
            if prefix and not p.startswith(prefix):
                continue
            t.files[p[len(prefix):]] = {"size": size, "mtime": 0}
        t._find_samples()
        return t

    # ── samples ──────────────────────────────────────────────────────────────
    def _find_samples(self):
        names = set()
        if self.root:
            man = os.path.join(self.root, "log", "sample_manifest.tsv")
            if os.path.isfile(man):
                with open(man, encoding="utf-8", errors="replace") as fh:
                    for i, line in enumerate(fh):
                        cols = line.rstrip("\n").split("\t")
                        if i == 0 and cols and cols[0] == "sample_name":
                            continue
                        if cols and cols[0]:
                            names.add(cols[0])
        for rel in self.files:
            for rx in (r"^results/assemblies/([^/]+)\.fasta$",
                       r"^report/samples/(.+?)(?:_detailed)?_report\.html$",
                       r"^log/(.+)-results\.json$"):
                m = re.match(rx, rel)
                if m:
                    names.add(m.group(1))
        self.samples = sorted(names, key=lambda s: (-len(s), s))
        if self.samples:
            alt = "|".join(re.escape(s) for s in self.samples)
            self._sample_re = re.compile(r"(?:^|[/._-])(%s)(?=$|[/._-])" % alt)

    def sample_of(self, rel):
        if not self._sample_re:
            return ""
        m = self._sample_re.search(rel)
        return m.group(1) if m else ""

    def group_of(self, rel):
        """The folder a file belongs to, cut where the sample folder starts:
        results/assemblies/alternative_assemblies/Spades/S1/K55/x -> …/Spades"""
        parts = rel.split("/")[:-1]
        out = []
        for c in parts:
            if self._sample_re and self._sample_re.search("/" + c):
                break
            if re.match(r"^K\d+$", c):
                break
            out.append(c)
            if len(out) >= 4:
                break
        return "/".join(out) if out else "."

    def abspath(self, rel):
        return os.path.join(self.root, rel)


def looks_like_outdir(p):
    return os.path.isdir(os.path.join(p, "log")) or os.path.isdir(os.path.join(p, "results"))


# ─────────────────────────────────────────────────────────────────────────────
# What could go: one row per kind of file. First match wins.
#   code, regex on the relative path, what it is / what to do
# These are candidates to look at, not a delete list.
# ─────────────────────────────────────────────────────────────────────────────

HINTS = [
    ("reads",
     r"(^|/)large_files/|\.(fastq|fq)(\.gz)?$",
     "reads (trimmed / downsampled / merged); removed by cleanup.* (on by default)"),
    ("bam",
     r"/remapping/[^/]+/[^/]+\.sorted\.bam(\.bai)?$",
     "BAM from the re-mapping; only read by samtools in the same step. "
     "Removed in the step since the streaming remap (cleanup.bam=1, the default); "
     "rerun=remap cleanup.bam=0 makes it again"),
    ("remap-intermediate",
     r"/remapping/[^/]+/[^/]+\.(depth\.tsv|pileup\.gz)$",
     "samtools depth / mpileup output from before the streaming remap step. "
     "eurlc-wgs --remap-check --convert <folder> checks that the new small files give "
     "identical results and then removes these"),
    ("assembly-copy",
     r"/remapping/[^/]+/[^/]+\.fasta(\.fai)?$"
     r"|^results/assemblies/by_species/"
     r"|/alternative_assemblies/Spades/[^/]+/(contigs|scaffolds)\.fasta$"
     r"|/alternative_assemblies/Skesa/[^/]+/[^/]+\.fasta$"
     r"|/chewbbaca/.*/rawdata/[^/]+/input/",
     "copy of an assembly that is also in results/assemblies/ "
     "(or alternative_assemblies/<sample>.<assembler>.fasta)"),
    ("spades-work",
     r"/alternative_assemblies/Spades/[^/]+/(K\d+/|pipeline_state/|misc/|tmp/|corrected/"
     r"|before_rr\.fasta$|assembly_graph[^/]*\.(fastg|gfa)$|[^/]+\.paths$"
     r"|dataset\.info$|input_dataset\.yaml$|run_spades\.(sh|yaml)$|first_pe_contigs\.fasta$)",
     "SPAdes working files (k-mer folders, graphs, paths); only contigs.fasta, "
     "spades.log and params.txt are used afterwards"),
    ("other-assembler-work",
     r"/alternative_assemblies/(Skesa|Shovill)/[^/]+/.*\.(gfa|fastg)$",
     "assembly graph from SKESA/Shovill; not used afterwards"),
    ("blast-tmp",
     r"_blast/tmp/",
     "BLAST XML from ResFinder / VirulenceFinder / PlasmidFinder (tmp folder); results are in "
     "the tool's json/txt. Removed at the end of a run with cleanup.blast_tmp=1 (default)"),
    ("quast-extras",
     r"/quast/.*(icarus|/basic_stats/|report\.(html|pdf|tex)$|transposed_report\.(tex|txt)$)",
     "QUAST viewers, plots and duplicate report formats; report.tsv is what is read"),
    ("multiqc-data",
     r"/multiqc_data/(multiqc_data\.json|llms-full\.txt|multiqc\.parquet|multiqc_fastp\.txt)$",
     "large MultiQC data files; the MultiQC HTML report does not need them"),
    ("chewbbaca-extras",
     r"/chewbbaca/.*/rawdata/[^/]+/(chewbbaca_results/(cds_coordinates|results_contigsInfo"
     r"|loci_summary_stats)\.tsv$|hashed_results/results_alleles_sha256\.tsv$)",
     "chewBBACA per-sample side files; the allele profiles are kept elsewhere"),
    ("krona",
     r"\.krona_input$|_krona_input$",
     "Krona input text; the Krona HTML is made from it"),
    ("marker",
     r"/\.locks/|\.regeneration_complete$|/pipeline_state/",
     "empty marker files"),
]
_HINTS_RX = [(c, re.compile(rx), a) for c, rx, a in HINTS]
HINT_ADVICE = {c: a for c, _, a in HINTS}


def hint_of(rel):
    for code, rx, _ in _HINTS_RX:
        if rx.search("/" + rel):
            return code
    return ""


TEXT_TYPES = {".tsv", ".txt", ".json", ".jsonl", ".log", ".csv", ".fasta", ".fa", ".fna",
              ".fsa", ".gfa", ".fastg", ".xml", ".html", ".tex", ".seq", ".paths", ".info",
              ".yaml", ".stats", ".coverage", ".idxstats", ".flagstats", ".report",
              ".bracken", ".results", ".explicit", ".fai", ".lib_data", ".off", ".sh"}


def gzip_estimate(path, size, sample=4 * 1024 * 1024):
    """Bytes gzip would save, estimated from the first <sample> bytes."""
    try:
        with open(path, "rb") as fh:
            b = fh.read(sample)
    except OSError:
        return 0
    if not b or b"\0" in b[:65536]:
        return 0
    c = zlib.compress(b, 6)
    ratio = len(c) / float(len(b))
    return int(size * (1 - ratio))


def report_links(tree):
    """Files the HTML reports link to (they must stay)."""
    linked = set()
    rx = re.compile(r"""(?:href|src)\s*=\s*["']([^"'#?]+)""", re.I)
    for rel in tree.files:
        if not rel.endswith(".html"):
            continue
        if not (rel.startswith("report/") or "/" not in rel):
            continue
        try:
            with open(tree.abspath(rel), encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        base = os.path.dirname(rel)
        for url in rx.findall(text):
            if re.match(r"^[a-z][a-z0-9+.-]*:", url, re.I):
                continue
            target = os.path.normpath(os.path.join(base, urllib.parse.unquote(url))).replace(os.sep, "/")
            if target in tree.files:
                linked.add(target)
    return linked


# ─────────────────────────────────────────────────────────────────────────────
# inventory
# ─────────────────────────────────────────────────────────────────────────────

def read_previous_manifest(path):
    prev = {}
    with open(path, encoding="utf-8") as fh:
        header = fh.readline().rstrip("\n").split("\t")
        idx = {h: i for i, h in enumerate(header)}
        if not {"path", "size", "mtime", "md5"} <= set(idx):
            warn("%s has no path/size/mtime/md5 columns; not reused" % path)
            return prev
        for line in fh:
            c = line.rstrip("\n").split("\t")
            if len(c) < len(header):
                continue
            if c[idx["md5"]]:
                prev[c[idx["path"]]] = (c[idx["size"]], c[idx["mtime"]], c[idx["md5"]])
    return prev


def cmd_inventory(a):
    if a.from_listing:
        tree = Tree.from_listing(a.from_listing)
        if a.md5:
            warn("--md5 needs the folder itself; ignored with --from-listing")
            a.md5 = False
    else:
        if not a.outdir:
            die("inventory needs an output folder (or --from-listing FILE)")
        tree = Tree.from_folder(a.outdir)

    rows = []
    for rel in sorted(tree.files):
        f = tree.files[rel]
        rows.append({
            "path": rel, "size": f["size"], "mtime": f["mtime"],
            "group": tree.group_of(rel), "sample": tree.sample_of(rel),
            "type": file_type(os.path.basename(rel)), "hint": hint_of(rel),
            "md5": "", "gzip_saving": 0, "linked": "",
        })
    total = sum(r["size"] for r in rows)

    # ── report links: never suggest removing those ──────────────────────────
    if not tree.is_listing:
        linked = report_links(tree)
        for r in rows:
            if r["path"] in linked:
                r["linked"] = "yes"

    # ── checksums ───────────────────────────────────────────────────────────
    prev = read_previous_manifest(a.previous) if a.previous else {}
    by_size = defaultdict(list)
    for r in rows:
        by_size[r["size"]].append(r)
    if not tree.is_listing:
        need = []
        for r in rows:
            if a.md5:
                need.append(r)
            elif r["size"] >= a.dup_min and len(by_size[r["size"]]) > 1:
                need.append(r)          # possible duplicate: confirm by checksum
        nbytes = sum(r["size"] for r in need)
        if nbytes > 2e9:
            sys.stderr.write("Computing MD5 of %d files (%s) …\n" % (len(need), human(nbytes)))
        for r in need:
            p = prev.get(r["path"])
            if p and p[0] == str(r["size"]) and p[1] == str(r["mtime"]):
                r["md5"] = p[2]
                continue
            try:
                r["md5"] = md5_file(tree.abspath(r["path"]))
            except OSError as e:
                warn("cannot read %s: %s" % (r["path"], e))

    # ── gzip estimate for big uncompressed text ─────────────────────────────
    if not tree.is_listing and not a.no_gzip_estimate:
        for r in rows:
            if r["size"] >= a.gzip_min and r["type"] in TEXT_TYPES:
                r["gzip_saving"] = gzip_estimate(tree.abspath(r["path"]), r["size"])

    # ── manifest ────────────────────────────────────────────────────────────
    if a.manifest:
        cols = ["path", "size", "mtime", "group", "sample", "type", "hint", "linked",
                "md5", "gzip_saving"]
        with open(a.manifest, "w", encoding="utf-8") as fh:
            fh.write("\t".join(cols) + "\n")
            for r in rows:
                fh.write("\t".join(str(r[c]) for c in cols) + "\n")

    # ── summary ─────────────────────────────────────────────────────────────
    out = sys.stdout
    w = out.write
    pct = lambda n: (100.0 * n / total) if total else 0.0

    def table(title, agg, limit=None, keyname=""):
        w("\n== %s\n" % title)
        items = sorted(agg.items(), key=lambda kv: -kv[1][0])
        if limit:
            rest = items[limit:]
            items = items[:limit]
        else:
            rest = []
        w("%10s %6s %7s  %s\n" % ("size", "%", "files", keyname))
        for k, (s, n) in items:
            w("%10s %5.1f%% %7d  %s\n" % (human(s), pct(s), n, k or "(none)"))
        if rest:
            s = sum(v[0] for _, v in rest)
            n = sum(v[1] for _, v in rest)
            w("%10s %5.1f%% %7d  (%d more)\n" % (human(s), pct(s), n, len(rest)))

    def agg_by(key):
        d = defaultdict(lambda: [0, 0])
        for r in rows:
            k = key(r)
            d[k][0] += r["size"]
            d[k][1] += 1
        return d

    w("eurlc-wgs-inspect %s — inventory of %s\n" % (VERSION, tree.label))
    w("Files: %d   Total: %s   Samples: %d\n" % (len(rows), human(total), len(tree.samples)))
    if tree.samples:
        w("Samples: %s\n" % ", ".join(sorted(tree.samples)))

    table("By top folder", agg_by(lambda r: "/".join(r["path"].split("/")[:2])
                                   if r["path"].startswith("results/") else r["path"].split("/")[0]
                                   if "/" in r["path"] else "(top level)"), keyname="folder")
    table("By step folder (sample folders folded in)", agg_by(lambda r: r["group"]),
          limit=a.top, keyname="folder")
    table("By file type", agg_by(lambda r: r["type"]), limit=a.top, keyname="type")

    samp = agg_by(lambda r: r["sample"] or "(shared, not per sample)")
    table("By sample", samp, keyname="sample")
    per = [v[0] for k, v in samp.items() if not k.startswith("(")]
    if per:
        per.sort()
        w("Per sample: median %s, max %s\n" % (human(per[len(per) // 2]), human(per[-1])))

    w("\n== Largest files\n")
    for r in sorted(rows, key=lambda r: -r["size"])[: a.top]:
        w("%10s  %s%s\n" % (human(r["size"]), r["path"], ("  [" + r["hint"] + "]") if r["hint"] else ""))

    # candidates
    cand = defaultdict(lambda: [0, 0, 0])   # code -> size, files, linked files
    for r in rows:
        if not r["hint"]:
            continue
        c = cand[r["hint"]]
        if r["linked"]:
            c[2] += 1
            continue
        c[0] += r["size"]
        c[1] += 1
    w("\n== Candidates for removal or compact storage (look before deleting)\n")
    if not cand:
        w("  none found\n")
    else:
        w("%10s %6s %7s  %s\n" % ("size", "%", "files", "kind"))
        csum = 0
        for code, (s, n, nl) in sorted(cand.items(), key=lambda kv: -kv[1][0]):
            csum += s
            w("%10s %5.1f%% %7d  %s\n" % (human(s), pct(s), n, code))
            w("%27s%s\n" % ("", HINT_ADVICE[code]))
            if nl:
                w("%27s(%d file(s) of this kind are linked from the report and not counted)\n" % ("", nl))
        w("%10s %5.1f%%          all candidates together\n" % (human(csum), pct(csum)))
        if tree.is_listing:
            w("  (from a listing: report links are not checked)\n")

    # duplicates
    w("\n== Duplicate files\n")
    groups = defaultdict(list)
    if tree.is_listing:
        for r in rows:
            if r["size"] >= max(a.dup_min, 100000):
                groups[(r["size"], "")].append(r)
        note = "same size (from a listing, so not confirmed by checksum)"
    else:
        for r in rows:
            if r["md5"] and r["size"] >= a.dup_min:
                groups[(r["size"], r["md5"])].append(r)
        note = "identical content (MD5)"
    dups = [g for g in groups.values() if len(g) > 1]
    if not dups:
        w("  none ≥ %s\n" % human(a.dup_min))
    else:
        wasted = sum(g[0]["size"] * (len(g) - 1) for g in dups)
        w("  %d groups of %s, %s in the extra copies\n" % (len(dups), note, human(wasted)))
        # fold groups that are the same pattern for every sample
        pat = defaultdict(lambda: [0, 0, None])
        for g in dups:
            key = tuple(sorted(generic_path(r["path"], r["sample"]) for r in g))
            p = pat[key]
            p[0] += g[0]["size"] * (len(g) - 1)
            p[1] += 1
            p[2] = p[2] or g
        for key, (s, n, g) in sorted(pat.items(), key=lambda kv: -kv[1][0])[: a.top]:
            w("%10s  %d× %s:\n" % (human(s), n, "group" if n == 1 else "groups (one per sample)"))
            for gp in key:
                w("%12s%s\n" % ("", gp))

    # gzip
    if not tree.is_listing and not a.no_gzip_estimate:
        gz = defaultdict(lambda: [0, 0, 0])
        for r in rows:
            if r["gzip_saving"]:
                k = generic_path(r["path"], r["sample"])
                k = re.sub(r"/[^/]+$", "/*" + (r["type"] if r["type"] != "(none)" else ""), k)
                gz[k][0] += r["gzip_saving"]
                gz[k][1] += 1
                gz[k][2] += r["size"]
        w("\n== Uncompressed text ≥ %s: estimated saving with gzip\n" % human(a.gzip_min))
        if not gz:
            w("  none\n")
        else:
            tot = sum(v[0] for v in gz.values())
            w("  %s could be saved in total\n" % human(tot))
            for k, (s, n, sz) in sorted(gz.items(), key=lambda kv: -kv[1][0])[: a.top]:
                w("%10s of %9s %5d files  %s\n" % (human(s), human(sz), n, k))

    if a.manifest:
        w("\nManifest: %s (%d rows)\n" % (a.manifest, len(rows)))
    return 0


def generic_path(rel, sample):
    """Replace the sample name in a path with <S> so per-sample patterns fold."""
    if sample:
        rel = re.sub(r"(?:(?<=^)|(?<=[/._-]))%s(?=$|[/._-])" % re.escape(sample), "<S>", rel)
    rel = re.sub(r"/K\d+/", "/K*/", rel)
    rel = re.sub(r"/by_species/[^/]+/", "/by_species/*/", rel)
    return rel


# ─────────────────────────────────────────────────────────────────────────────
# extract
# ─────────────────────────────────────────────────────────────────────────────

# What goes in the package (relative paths, regex). Files of samples that
# were not chosen are left out; shared files (no sample in the path) go in.
EXTRACT_INCLUDE = [
    # logs and run data
    r"^log/(run_summary\.txt|run_status\.json|events\.jsonl|sample_manifest\.tsv"
    r"|versions_summary\.txt|cleanup\.json|log\.txt|stderr\.txt|stdout\.txt|bash_commands\.log"
    r"|filelist_fast[aq]\.txt|input_dir\.txt)$",
    r"^log/versioning_explicit/",
    r"^log/[^/]+-results\.json$",
    r"^data/rundata\.json$",
    r"^(config_seal\.ini|eurlc-wgs\.config|db_freeze\.config|conda_manifest\.ini)$",
    r"^log/[^/]+\.(ini|config)$",
    # report tables and pages (no assets, no PDF)
    r"^report/[^/]+\.html$",
    r"^report/samples/[^/]+\.html$",
    r"^report/(tsv|tables)/",
    r"^report/clustering/",
    r"^report/amr/",
    r"^qcscreen_status\.json$",
    # stage 1
    r"/Fastp_rawdata/[^/]+\.json$",
    r"/fastq_prescan/",
    r"/species_determination_kraken2/",
    r"/Downsampling/",
    r"/md5/",
    r"/multiqc_data/(multiqc_general_stats|multiqc_sources|multiqc_software_versions"
    r"|multiqc_quast|quast_table|multiqc_kraken)\.txt$",
    # stage 2
    r"/stage2_trimmeddata/Kraken2/[^/]+\.(bracken|kraken2\.txt|kraken2_bracken_[a-z]+\.txt)$",
    r"/fastq_stats/",
    r"/mash_screen/",
    r"/jellyfish/[^/]+\.(histo|txt|json|tsv)$",
    # stage 3
    r"/quast/(alternative_assemblies/)?[^/]+/(report\.tsv|transposed_report\.tsv|report\.txt|quast\.log)$",
    r"/remapping/[^/]+/[^/]+\.(remap_qc\.json|coverage|flagstats|idxstats|stats|mixed_positions\.tsv"
    r"|depth_summary\.json|pileup_summary\.json|allele_counts\.tsv\.gz)$",
    r"/alternative_assemblies/Spades/[^/]+/(spades\.log|params\.txt)$",
    r"/alternative_assemblies/(Skesa|Shovill)/[^/]+/[^/]+\.(csv|log|txt)$",
    r"/assembly_selection/",
    # typing and AMR (everything except BLAST tmp)
    r"^results/typing/",
    r"^results/amr/",
    # cgMLST
    r"/chewbbaca/[^/]+/[^/]+/per_batch/",
    r"/chewbbaca/[^/]+/[^/]+/per_sample/(json|tsv)/",
    r"/chewbbaca/.*/rawdata/[^/]+/chewbbaca_results/(results_alleles|results_statistics"
    r"|paralogous_counts|paralogous_loci|logging_info|invalid_cds)\.(tsv|txt)$",
    r"/chewbbaca/.*/rawdata/[^/]+/hashed_results/(results_alleles_crc32\.tsv|hashing_report\.json)$",
    r"^results/clustering/allele_tables/[^/]+_all\.tsv$",
    r"^results/clustering/distance_matrices/",
    r"^results/clustering/[^/]+\.(tsv|txt|json)$",
]
EXTRACT_EXCLUDE = [
    r"_blast/tmp/",
    r"\.(bam|bai|fastq|fq|fastq\.gz|fq\.gz|pileup\.gz|parquet|png|pdf)$",
    r"(^|/)large_files/",
    r"/\.locks/",
]
ASSEMBLY_INCLUDE = r"^results/assemblies/[^/]+\.fasta$"

_INC = [re.compile(x) for x in EXTRACT_INCLUDE]
_EXC = [re.compile(x) for x in EXTRACT_EXCLUDE]
_ASM = re.compile(ASSEMBLY_INCLUDE)


def wanted(rel, with_assemblies):
    p = "/" + rel if not rel.startswith("/") else rel
    if any(rx.search(p) or rx.search(rel) for rx in _EXC):
        return False
    if with_assemblies and _ASM.search(rel):
        return True
    return any(rx.search(rel) or rx.search(p) for rx in _INC)


class Anonymizer:
    def __init__(self, tree):
        names = sorted(tree.samples)            # stable numbering
        width = max(2, len(str(len(names))))
        self.map = {n: "S%0*d" % (width, i + 1) for i, n in enumerate(names)}
        alt = "|".join(re.escape(n) for n in sorted(names, key=lambda s: -len(s)))
        self.rx = re.compile(r"(?<![A-Za-z0-9])(%s)(?![A-Za-z0-9])" % alt) if names else None
        # Paths that may hold user or lab names
        self.paths = []
        if tree.root:
            self.paths.append((tree.root, "<OUTDIR>"))
            for f in ("log/input_dir.txt",):
                p = os.path.join(tree.root, f)
                if os.path.isfile(p):
                    with open(p, encoding="utf-8", errors="replace") as fh:
                        d = fh.read().strip()
                    if d:
                        self.paths.append((d.rstrip("/"), "<DATADIR>"))
            # folders of the raw files (lane files may lie elsewhere)
            man = os.path.join(tree.root, "log", "sample_manifest.tsv")
            if os.path.isfile(man):
                dirs = set()
                with open(man, encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        for col in line.rstrip("\n").split("\t")[2:]:
                            for f in col.split(" + "):
                                if f.startswith("/"):
                                    dirs.add(os.path.dirname(f).rstrip("/"))
                for d in dirs:
                    if d and d != "/" and (d, "<DATADIR>") not in self.paths:
                        self.paths.append((d, "<DATADIR>"))
        self.paths.sort(key=lambda kv: -len(kv[0]))
        self.home_rx = re.compile(r"(/home/|/Users/|/mnt/[a-z]/Users/)[^/\s\"'<>]+")
        # The same folders reached by another path (a symlink, another mount
        # point, an earlier run started elsewhere): any absolute path that
        # ends in the data folder's name, or in <data folder>/eurlc-wgs.
        names = set()
        for p, rep_ in self.paths:
            b = os.path.basename(p.rstrip("/"))
            if b == "eurlc-wgs":
                b = os.path.basename(os.path.dirname(p.rstrip("/")))
            if b and len(b) >= 3:
                names.add(b)
        self.name_rx = None
        if names:
            alt = "|".join(re.escape(n) for n in sorted(names, key=lambda x: -len(x)))
            self.name_rx = re.compile(r"(?<![\w.-])/(?:[^\s\"'<>/]+/)*(?:%s)(/eurlc-wgs)?(?=[/\s\"'<>,;:)\]]|$)" % alt)

    def text(self, s):
        for p, rep in self.paths:
            s = s.replace(p, rep)
        if self.name_rx:
            s = self.name_rx.sub(lambda m: "<OUTDIR>" if m.group(1) else "<DATADIR>", s)
        s = self.home_rx.sub(lambda m: m.group(1) + "USER", s)
        if self.rx:
            s = self.rx.sub(lambda m: self.map[m.group(1)], s)
        return s

    def path(self, rel):
        if not self.rx:
            return rel
        return self.rx.sub(lambda m: self.map[m.group(1)], rel)


def filter_rundata(data, keep):
    """Keep only the chosen samples in rundata.json (if it has the usual shape)."""
    if isinstance(data, dict) and isinstance(data.get("samples"), list):
        before = len(data["samples"])
        data["samples"] = [s for s in data["samples"]
                           if isinstance(s, dict) and (s.get("name") in keep or s.get("base") in keep)]
        return data, before, len(data["samples"])
    return data, None, None


def cmd_extract(a):
    tree = Tree.from_folder(a.outdir)
    if not tree.samples:
        warn("no samples found (log/sample_manifest.tsv, results/assemblies/*.fasta)")

    # which samples
    if a.samples:
        chosen = []
        for tok in [t.strip() for t in a.samples.split(",") if t.strip()]:
            hit = [s for s in tree.samples if fnmatch.fnmatchcase(s, tok)] if any(
                ch in tok for ch in "*?[") else ([tok] if tok in tree.samples else [])
            if not hit:
                close = difflib.get_close_matches(tok, tree.samples, n=3)
                die("unknown sample [%s]%s" % (tok, ("; did you mean: " + ", ".join(close)) if close else ""))
            chosen.extend(h for h in hit if h not in chosen)
    elif a.all_samples:
        chosen = list(tree.samples)
    else:
        die("say which samples: --samples S1,S2 (wildcards allowed) or --all-samples.\n"
            "Samples in this folder: %s" % ", ".join(sorted(tree.samples)))
    keep = set(chosen)

    out = a.output
    if not (out.endswith(".tar.gz") or out.endswith(".tgz")):
        out += ".tar.gz"
    top = re.sub(r"\.(tar\.gz|tgz)$", "", os.path.basename(out))
    if os.path.abspath(out).startswith(tree.root + os.sep):
        die("the package must not be written inside the output folder")

    anon = Anonymizer(tree) if a.anonymize else None
    max_file = int(a.max_file_mb * 1e6)

    picked, skipped = [], []
    for rel in sorted(tree.files):
        s = tree.sample_of(rel)
        if s and s not in keep:
            continue
        if not wanted(rel, a.with_assemblies):
            continue
        size = tree.files[rel]["size"]
        if size > max_file and not rel.startswith("data/rundata.json"):
            skipped.append((rel, size, "larger than --max-file-mb"))
            continue
        picked.append(rel)

    manifest_rows = []
    total_in = 0
    with tarfile.open(out, "w:gz", compresslevel=9) as tar:
        for rel in picked:
            src = tree.abspath(rel)
            try:
                with open(src, "rb") as fh:
                    data = fh.read()
            except OSError as e:
                skipped.append((rel, tree.files[rel]["size"], "unreadable: %s" % e))
                continue
            note = ""
            if rel == "data/rundata.json" and not a.all_samples:
                try:
                    obj = json.loads(data.decode("utf-8"))
                    obj, before, after = filter_rundata(obj, keep)
                    if before is not None:
                        data = json.dumps(obj, indent=1, ensure_ascii=False).encode("utf-8")
                        note = "filtered to %d of %d samples" % (after, before)
                except (ValueError, UnicodeDecodeError) as e:
                    note = "not filtered (%s)" % e.__class__.__name__
                if len(data) > max_file * 5:
                    skipped.append((rel, len(data), "rundata.json still too large after filtering"))
                    continue
            orig_md5 = md5_file(src) if not note else md5_bytes(open(src, "rb").read())
            arc = rel
            if anon:
                arc = anon.path(rel)
                try:
                    txt = data.decode("utf-8")
                    new = anon.text(txt)
                    if new != txt:
                        data = new.encode("utf-8")
                        note = (note + "; " if note else "") + "anonymized"
                except UnicodeDecodeError:
                    note = (note + "; " if note else "") + "binary, not anonymized"
            ti = tarfile.TarInfo(name=top + "/" + arc)
            ti.size = len(data)
            ti.mtime = tree.files[rel]["mtime"]
            ti.mode = 0o644
            tar.addfile(ti, io.BytesIO(data))
            total_in += len(data)
            manifest_rows.append((arc, tree.files[rel]["size"], orig_md5, note))

        # the package's own description
        info = io.StringIO()
        info.write("eurlc-wgs-inspect %s extract\n" % VERSION)
        info.write("created: %s\n" % datetime.datetime.now().astimezone().isoformat(timespec="seconds"))
        info.write("source: %s\n" % ("<OUTDIR>" if anon else tree.root))
        info.write("samples: %s\n" % ", ".join(anon.map[s] if anon else s for s in chosen))
        info.write("anonymized: %s\n" % ("yes" if anon else "no"))
        info.write("files: %d, %s uncompressed\n" % (len(manifest_rows), human(total_in)))
        info.write("\nNot included: reads, BAM, pileup, large intermediates, PDFs, images, "
                   "report assets%s.\n" % ("" if a.with_assemblies else ", assemblies"))
        info.write("MANIFEST.tsv: md5 and size are of the original file in the output folder.\n")
        if skipped:
            info.write("\nSkipped:\n")
            for rel, size, why in skipped:
                info.write("  %s  %s  %s\n" % (anon.path(rel) if anon else rel, human(size), why))
        _add_text(tar, top + "/EXTRACT_INFO.txt", info.getvalue())
        m = io.StringIO()
        m.write("path\tsize\tmd5\tnote\n")
        for row in manifest_rows:
            m.write("%s\t%d\t%s\t%s\n" % row)
        _add_text(tar, top + "/MANIFEST.tsv", m.getvalue())

    if anon:
        mp = re.sub(r"\.(tar\.gz|tgz)$", "", out) + ".samplemap.tsv"
        with open(mp, "w", encoding="utf-8") as fh:
            fh.write("code\tsample\n")
            for n, c in sorted(anon.map.items(), key=lambda kv: kv[1]):
                fh.write("%s\t%s\n" % (c, n))

    sz = os.path.getsize(out)
    print("Wrote %s: %d files, %s uncompressed, %s packed" % (out, len(manifest_rows), human(total_in), human(sz)))
    print("Samples: %s" % ", ".join(("%s (= %s)" % (anon.map[s], s)) if anon else s for s in chosen))
    if anon:
        print("Sample key (keep it, do not send it): %s" % mp)
        print("Sample names, the output and data folder paths and home folder names were replaced; "
              "check EXTRACT_INFO.txt and look through the package before sending it on.")
    if skipped:
        print("Skipped %d file(s), see EXTRACT_INFO.txt" % len(skipped))
    return 0


def _add_text(tar, name, text):
    b = text.encode("utf-8")
    ti = tarfile.TarInfo(name=name)
    ti.size = len(b)
    ti.mtime = int(datetime.datetime.now().timestamp())
    ti.mode = 0o644
    tar.addfile(ti, io.BytesIO(b))




# ─────────────────────────────────────────────────────────────────────────────
# summarize
# ─────────────────────────────────────────────────────────────────────────────

LEVELS = ("PASS", "WARNING", "CRITICAL", "FAIL")


def _find_runs(folders):
    """eurlc-wgs output folders (with data/rundata.json) below the given folders."""
    runs = []
    seen = set()
    for folder in folders:
        if not os.path.isdir(folder):
            die("not a folder: %s" % folder)
        for dirpath, dirnames, filenames in os.walk(folder):
            dirnames[:] = [d for d in dirnames if d not in ("results", "large_files", "report", "log")]
            if os.path.basename(dirpath) == "data" and "rundata.json" in filenames:
                out = os.path.dirname(os.path.abspath(dirpath))
                real = os.path.realpath(out)
                if real not in seen:
                    seen.add(real)
                    runs.append(out)
    return sorted(runs)


def _run_label(outdir):
    b = os.path.basename(outdir.rstrip(os.sep))
    if b in ("eurlc-wgs", "eurlc-wgs_qcscreen"):
        b = os.path.basename(os.path.dirname(outdir.rstrip(os.sep))) or b
    return b


def _get(d, *path, default=""):
    for k in path:
        if not isinstance(d, dict):
            return default
        d = d.get(k)
    return default if d is None else d


def _issue_texts(block):
    out = []
    for lvl in ("fail", "critical", "warning"):
        for t in (_get(block, "issues", lvl, default=[]) or []):
            out.append((lvl.upper(), t if isinstance(t, str) else json.dumps(t)))
    return out


def _sample_row(run, smp):
    mr = smp.get("main_results") or {}
    qc = smp.get("qc_checks") or {}
    row = {
        "run": run,
        "sample": smp.get("name", ""),
        "type": smp.get("type", ""),
        "species": _get(mr, "taxonomy", "species"),
        "species_score": _get(mr, "taxonomy", "species_score"),
        "qc_status": _get(smp, "qc", "status"),
        "qc_issues": "; ".join("%s: %s" % x for x in _issue_texts(smp.get("qc"))),
        "runtime_status": _get(smp, "runtime_issues", "status"),
        "runtime_issues": "; ".join("%s: %s" % x for x in _issue_texts(smp.get("runtime_issues"))),
        "abandoned": smp.get("fatal_error_message") or "" if smp.get("fatal_error") else "",
        "assembly_method": _get(mr, "assembly", "method"),
        "st": _get(mr, "mlst", "st"),
        "serotype": _get(mr, "typing", "serotype", "value"),
        "cgmlst_schema": _get(mr, "typing", "cgmlst_call_rate_schema"),
        "contamination_species": _get(mr, "contamination", "species"),
        "contamination_genus": _get(mr, "contamination", "genus"),
    }
    hits = _get(smp, "results", "amrfinderplus", "amr_hits", default=[]) or []
    amr = sorted({h.get("element_symbol", "") for h in hits
                  if isinstance(h, dict) and (h.get("type") or h.get("element_type") or "AMR").upper() == "AMR"} - {""})
    row["amr_genes"] = ",".join(amr)
    measures = {}
    for m, c in qc.items():
        if not isinstance(c, dict):
            continue
        measures[m] = (c.get("observed"), c.get("status", ""))
    return row, measures


def _thresholds_of(smp):
    out = {}
    for m, e in (smp.get("qc_expectations") or {}).items():
        t = (e or {}).get("thresholds") or {}
        out[m] = {lvl: ((t.get(lvl) or {}).get("raw") or "") for lvl in ("warning", "critical", "fail")}
    return out


def _read_expected(path):
    exp = {}
    with open(path, encoding="utf-8") as fh:
        for i, line in enumerate(fh):
            if not line.strip() or line.startswith("#"):
                continue
            c = line.rstrip("\n").split("\t")
            if i == 0 and c[0].lower() == "run":
                continue
            if len(c) < 3:
                warn("%s line %d: needs run, sample, expected (tab-separated)" % (path, i + 1))
                continue
            exp[(c[0], c[1])] = (c[2].strip().lower(), c[3] if len(c) > 3 else "")
    return exp


def cmd_summarize(a):
    runs = _find_runs(a.folders)
    if not runs:
        die("no data/rundata.json below %s" % ", ".join(a.folders), 1)
    expected = _read_expected(a.expected) if a.expected else {}

    rows, all_measures, thresholds = [], [], defaultdict(dict)   # thresholds[species][measure]
    measure_names = set()
    issue_groups = defaultdict(lambda: {"n": 0, "samples": [], "level": ""})
    for out in runs:
        run = _run_label(out)
        try:
            with open(os.path.join(out, "data", "rundata.json"), encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError) as e:
            warn("cannot read %s: %s" % (out, e))
            continue
        for smp in data.get("samples") or []:
            if not isinstance(smp, dict):
                continue
            row, meas = _sample_row(run, smp)
            if expected:
                e = expected.get((run, row["sample"])) or expected.get(("*", row["sample"]))
                row["expected"], row["expected_note"] = e if e else ("", "")
            rows.append(row)
            all_measures.append(meas)
            measure_names.update(meas)
            sp = row["species"] or "(species unknown)"
            for m, t in _thresholds_of(smp).items():
                thresholds[sp].setdefault(m, t)
            for blk in ("qc", "runtime_issues"):
                for lvl, txt in _issue_texts(smp.get(blk)):
                    key = (blk, re.sub(r"(?<![A-Za-z])-?\d+(?:\.\d+)?", "#", txt))
                    g = issue_groups[key]
                    g["n"] += 1
                    g["level"] = lvl
                    if len(g["samples"]) < 6:
                        g["samples"].append("%s/%s" % (run, row["sample"]))
        # run-level errors from log/run_status.json
        rs_path = os.path.join(out, "log", "run_status.json")
        try:
            with open(rs_path, encoding="utf-8") as fh:
                rs = json.load(fh)
            for e in rs.get("errors") or []:
                txt = e if isinstance(e, str) else (e.get("text") or e.get("message") or json.dumps(e))
                g = issue_groups[("run error", re.sub(r"(?<![A-Za-z])-?\d+(?:\.\d+)?", "#", txt))]
                g["n"] += 1
                g["level"] = "ERROR"
                if len(g["samples"]) < 6:
                    g["samples"].append(run)
        except (OSError, ValueError):
            pass

    if a.species:
        keep = [i for i, r in enumerate(rows) if re.search(a.species, r["species"], re.I)]
        rows = [rows[i] for i in keep]
        all_measures = [all_measures[i] for i in keep]
    mnames = sorted(measure_names)

    # ── the table ───────────────────────────────────────────────────────────
    base_cols = ["run", "sample", "type", "species", "species_score", "qc_status", "qc_issues",
                 "runtime_status", "runtime_issues", "abandoned", "assembly_method", "st", "serotype",
                 "cgmlst_schema", "amr_genes", "contamination_species", "contamination_genus"]
    if expected:
        base_cols[2:2] = ["expected", "expected_note"]
    if a.tsv:
        with open(a.tsv, "w", encoding="utf-8") as fh:
            fh.write("\t".join(base_cols + mnames + [m + "_status" for m in mnames]) + "\n")
            for r, meas in zip(rows, all_measures):
                vals = [str(r.get(c, "")) for c in base_cols]
                vals += ["" if meas.get(m, (None, ""))[0] in (None, "n/a") else str(meas[m][0]) for m in mnames]
                vals += [meas.get(m, (None, ""))[1] for m in mnames]
                fh.write("\t".join(v.replace("\t", " ") for v in vals) + "\n")

    w = sys.stdout.write
    w("eurlc-wgs-inspect %s summarize: %d run(s), %d sample(s)\n" % (VERSION, len(runs), len(rows)))

    # ── overview: species × status (× expected) ─────────────────────────────
    w("\n== Samples per species and QC status\n")
    tab = defaultdict(lambda: defaultdict(int))
    for r in rows:
        tab[r["species"] or "(species unknown)"][r["qc_status"] or "?"] += 1
    cols = list(LEVELS) + sorted({st for d in tab.values() for st in d} - set(LEVELS))
    table = [["species", "n"] + cols]
    for sp in sorted(tab):
        table.append([sp, sum(tab[sp].values())] + [tab[sp].get(c, 0) for c in cols])
    _print_table(w, table)

    if expected:
        w("\n== What is known about the samples, against the QC status they got\n")
        conf = defaultdict(lambda: defaultdict(int))
        for r in rows:
            conf[r.get("expected") or "(not listed)"][r["qc_status"] or "?"] += 1
        table = [["expected", "n"] + cols]
        for e in sorted(conf):
            table.append([e, sum(conf[e].values())] + [conf[e].get(c, 0) for c in cols])
        _print_table(w, table)
        missed = [r for r in rows if r.get("expected") not in ("", "clean", "unknown", None) and r["qc_status"] == "PASS"]
        if missed:
            w("Known problem samples that PASS:\n")
            for r in missed[:30]:
                w("  %s/%s  (%s: %s)\n" % (r["run"], r["sample"], r["expected"], r.get("expected_note", "")))
        flagged = [r for r in rows if r.get("expected") == "clean" and r["qc_status"] not in ("PASS", "")]
        if flagged:
            w("Clean samples that do not PASS:\n")
            for r in flagged[:30]:
                w("  %s/%s  %s  %s\n" % (r["run"], r["sample"], r["qc_status"], r["qc_issues"][:150]))

    # ── spread per species and measure ──────────────────────────────────────
    w("\n== Spread of each measure per species%s\n"
      % (" (spread and W/C/F over the samples listed as clean; 'problems flagged' = how many of the\n"
         "   other listed samples get WARNING or worse on this measure, 'problem values' = their values)"
         if expected else ""))
    w("(n = samples with a value; the thresholds are the ones in force in these runs)\n")
    by_sp = defaultdict(list)
    for r, meas in zip(rows, all_measures):
        by_sp[r["species"] or "(species unknown)"].append((r, meas))
    for sp in sorted(by_sp):
        if a.min_samples and len(by_sp[sp]) < a.min_samples:
            continue
        w("\n-- %s (%d sample(s))\n" % (sp, len(by_sp[sp])))
        table = [["measure", "n", "min", "p5", "median", "p95", "max", "warning", "critical", "fail", "W/C/F"]
                 + (["problems flagged", "problem values"] if expected else [])]
        for m in mnames:
            if a.measures and not re.search(a.measures, m):
                continue
            vals, lv, flag, pvals = [], defaultdict(int), [0, 0], []
            for r, meas in by_sp[sp]:
                obs, st = meas.get(m, (None, ""))
                v = _num(obs)
                if v is None:
                    continue
                if expected and r.get("expected") not in ("clean",):
                    if r.get("expected") and r.get("expected") != "unknown":
                        flag[1] += 1
                        if st in ("WARNING", "CRITICAL", "FAIL"):
                            flag[0] += 1
                        pvals.append(v)
                    continue
                vals.append(v)
                lv[st] += 1
            if not vals and not flag[1]:
                continue
            vals.sort()
            t = thresholds.get(sp, {}).get(m, {})
            f = _fmt_num
            line = [m, len(vals), f(vals[0] if vals else None), f(_quantile(vals, .05)), f(_quantile(vals, .5)),
                    f(_quantile(vals, .95)), f(vals[-1] if vals else None),
                    t.get("warning", ""), t.get("critical", ""), t.get("fail", ""),
                    "%d/%d/%d" % (lv["WARNING"], lv["CRITICAL"], lv["FAIL"])]
            if expected:
                line.append("%d of %d" % tuple(flag) if flag[1] else "")
                line.append(",".join(_fmt_num(v) for v in sorted(pvals)[:6]) + (",..." if len(pvals) > 6 else ""))
            table.append(line)
        if len(table) == 1:
            w("  (no values%s)\n" % (" from samples listed as clean -- add them to --expected, or run without it"
                                     if expected else ""))
        else:
            _print_table(w, table)

    # ── issues across runs ──────────────────────────────────────────────────
    if issue_groups:
        w("\n== Issues across runs (numbers replaced by #), most frequent first\n")
        for (blk, txt), g in sorted(issue_groups.items(), key=lambda kv: -kv[1]["n"])[: a.top]:
            w("%5d  %-8s %-14s %s\n" % (g["n"], g["level"], blk, txt[:160]))
            w("%30s e.g. %s\n" % ("", ", ".join(g["samples"][:4])))
    if a.tsv:
        w("\nTable: %s (%d rows, one column per measure and one for its status)\n" % (a.tsv, len(rows)))
    return 0


def _fmt_num(x):
    if x is None:
        return ""
    if abs(x) >= 1000:
        return "%d" % round(x)
    return "%g" % float("%.4g" % x)


def _print_table(w, table):
    widths = [max(len(str(x)) for x in col) for col in zip(*table)]
    for line in table:
        w("  ".join(str(x).ljust(wd) for x, wd in zip(line, widths)).rstrip() + "\n")


# ─────────────────────────────────────────────────────────────────────────────
# mixture
# ─────────────────────────────────────────────────────────────────────────────

MIX_REASONS = ["few_reads", "low_af", "one_strand", "depth", "short_contig", "contig_end", "indel", "neighbour"]
OLD_KEYS = ("sites_minoraf_0_05_to_0_10_dp20", "sites_minoraf_0_10_to_0_20_dp20", "sites_minoraf_ge_0_20_dp20")


def _num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def _outdir_of(path):
    """The eurlc-wgs output folder a results file belongs to."""
    p = os.path.abspath(path)
    i = p.find(os.sep + "results" + os.sep)
    return p[:i] if i >= 0 else os.path.dirname(p)


def _load_samples(outdir, cache):
    """name/base -> (species, status) from data/rundata.json."""
    if outdir in cache:
        return cache[outdir]
    info = {}
    f = os.path.join(outdir, "data", "rundata.json")
    try:
        with open(f, encoding="utf-8") as fh:
            data = json.load(fh)
        for smp in data.get("samples") or []:
            if not isinstance(smp, dict):
                continue
            mr = smp.get("main_results") or {}
            species = (mr.get("taxonomy") or {}).get("species") or ""
            status = ((smp.get("report_issues") or {}).get("summary") or {}).get("status") \
                or (smp.get("qc") or {}).get("status") or ""
            for key in (smp.get("base"), smp.get("name")):
                if key:
                    info[key] = (species, status)
    except (OSError, ValueError):
        pass
    cache[outdir] = info
    return info


def _quantile(sorted_vals, q):
    if not sorted_vals:
        return None
    k = (len(sorted_vals) - 1) * q
    lo = int(k)
    hi = min(lo + 1, len(sorted_vals) - 1)
    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * (k - lo)


def cmd_mixture(a):
    header = ["run", "sample", "species", "qc_status", "method", "depth_median", "windows", "windows_total",
              "windows_pct", "sites", "isolated", "minor_af_median", "old_total_sites"] + \
             ["set_aside_" + r for r in MIX_REASONS]
    rows, old_runs = [], set()
    cache = {}
    seen = set()
    for folder in a.folders:
        if not os.path.isdir(folder):
            die("not a folder: %s" % folder)
        for dirpath, dirnames, filenames in os.walk(folder):
            dirnames[:] = [d for d in dirnames if d not in ("large_files", "report", "K21", "K33", "K55", "K77", "K99", "K127")]
            for fn in filenames:
                if not fn.endswith(".remap_qc.json"):
                    continue
                path = os.path.join(dirpath, fn)
                real = os.path.realpath(path)
                if real in seen:
                    continue
                seen.add(real)
                try:
                    with open(path, encoding="utf-8") as fh:
                        d = json.load(fh)
                except (OSError, ValueError) as e:
                    warn("cannot read %s: %s" % (path, e))
                    continue
                name = fn[: -len(".remap_qc.json")]
                outdir = _outdir_of(path)
                species, status = _load_samples(outdir, cache).get(name, ("", ""))
                m = d.get("mixture") or {}
                old = sum(_num(m.get(k)) or 0 for k in OLD_KEYS)
                run = os.path.basename(outdir.rstrip(os.sep))
                if run == "eurlc-wgs":   # default out folder: name it after the data folder
                    run = os.path.basename(os.path.dirname(outdir.rstrip(os.sep))) or run
                base_row = [run, name, species, status]
                depth = (d.get("coverage") or {}).get("depth_median", "")
                if "mixed_windows" not in m:
                    old_runs.add(outdir)
                    rows.append(base_row + ["old", depth, "", "", "", "", "", "", int(old)] + [""] * len(MIX_REASONS))
                    continue
                fc = m.get("mixed_filter_counts") or {}
                rows.append(base_row + [m.get("method_version", ""), depth, m["mixed_windows"],
                                        m.get("mixed_windows_total", ""), m.get("mixed_windows_pct", ""),
                                        m.get("mixed_sites", ""), m.get("mixed_sites_isolated", ""),
                                        m.get("mixed_minoraf_median") or "", int(old)] +
                            [fc.get(r, 0) for r in MIX_REASONS])
    if not rows:
        die("no *.remap_qc.json below %s" % ", ".join(a.folders), 1)
    rows.sort(key=lambda r: (str(r[2]), str(r[0]), str(r[1])))

    out = sys.stdout
    if not a.summary_only:
        widths = [max(len(str(x)) for x in col) for col in zip(header, *rows)]
        for line in [header] + rows:
            out.write("  ".join(str(x).ljust(w) for x, w in zip(line, widths)).rstrip() + "\n")
    if a.tsv:
        with open(a.tsv, "w", encoding="utf-8") as fh:
            for line in [header] + rows:
                fh.write("\t".join(str(x) for x in line) + "\n")

    # spread per species (new method only)
    by = defaultdict(list)
    for r in rows:
        if r[4] == "old":
            continue
        w = _num(r[6])
        if w is None:
            continue
        by[r[2] or "(species unknown)"].append((w, _num(r[8])))
    if by:
        out.write("\n== Windows with mixed positions per species (new method)\n")
        thr = a.threshold
        cols = ["species", "n", "min", "median", "p90", "p95", "max", "median_pct", "p95_pct"]
        if thr is not None:
            cols.append("above_%g" % thr)
        table = [cols]
        for sp in sorted(by):
            ws = sorted(v[0] for v in by[sp])
            ps = sorted(v[1] for v in by[sp] if v[1] is not None)
            fmt = lambda x: "" if x is None else ("%g" % round(x, 1))
            line = [sp, len(ws), fmt(ws[0]), fmt(_quantile(ws, .5)), fmt(_quantile(ws, .9)),
                    fmt(_quantile(ws, .95)), fmt(ws[-1]), fmt(_quantile(ps, .5)), fmt(_quantile(ps, .95))]
            if thr is not None:
                line.append(sum(1 for w in ws if w > thr))
            table.append(line)
        widths = [max(len(str(x)) for x in col) for col in zip(*table)]
        for line in table:
            out.write("  ".join(str(x).ljust(w) for x, w in zip(line, widths)).rstrip() + "\n")
        out.write("(all samples as found, also mixed or failed ones: filter on qc_status or a list of clean\n"
                  " samples before reading a threshold off this)\n")
    if old_runs:
        out.write("\n%d sample(s) have only the earlier method. To update them (no new mapping needed while\n"
                  "<sample>.pileup.gz is still there):\n" % sum(1 for r in rows if r[4] == "old"))
        for o in sorted(old_runs):
            out.write("  eurlc-wgs outdir=%s --resume\n" % o)
    return 0


# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# compare
# ─────────────────────────────────────────────────────────────────────────────

FP_NAME = "eurlc_results_fingerprint.json.gz"
AREAS = ("status", "taxonomy", "qc_status", "qc", "mixture", "mlst", "serotype", "amr", "virulence",
         "cgmlst", "cgmlst_alleles", "assembly")
AREA_TEXT = {
    "status": "QC status, reportable, abandoned", "taxonomy": "species, genus, contamination by other taxa",
    "qc_status": "status of each QC measure", "qc": "QC measure values", "mixture": "intra-species mixture",
    "mlst": "MLST (ST, alleles, each tool)", "serotype": "serotype and similar", "amr": "AMR genes",
    "virulence": "virulence genes", "cgmlst": "cgMLST call rate, missing loci, profile",
    "cgmlst_alleles": "cgMLST alleles, locus by locus", "assembly": "assemblies (selected and candidates, MD5)",
}


def _fp_path(arg):
    """A fingerprint file, or an output folder (or the data folder above it) holding one."""
    if os.path.isfile(arg):
        return arg
    for c in (os.path.join(arg, "report", "tables", FP_NAME),
              os.path.join(arg, "eurlc-wgs", "report", "tables", FP_NAME),
              os.path.join(arg, "report", "tables", FP_NAME[:-3])):
        if os.path.isfile(c):
            return c
    if os.path.isdir(arg):
        die("no results fingerprint in %s -- it is written by eurlc-wgs 0.1.0-beta1 (Nov 2026) and later; "
            "for an older output folder run 'eurlc-wgs summarize' in it first" % arg)
    die("not found: %s" % arg)


def _load_fp(arg):
    path = _fp_path(arg)
    try:
        opener = gzip.open if path.endswith(".gz") else open
        with opener(path, "rt", encoding="utf-8") as fh:
            fp = json.load(fh)
    except (OSError, ValueError) as ex:
        die("cannot read %s: %s" % (path, ex))
    if fp.get("format") != "eurlc-wgs-results-fingerprint":
        die("%s is not a eurlc-wgs results fingerprint" % path)
    fp["_path"] = path
    label = fp.get("run_name") or ""
    folder = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(path))))
    if os.path.basename(path) == FP_NAME or os.path.basename(path) == FP_NAME[:-3]:
        label = _run_label(folder)
    else:
        label = re.sub(r"\.json(\.gz)?$", "", os.path.basename(path))
    fp["_label"] = label
    return fp


def _as_num(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return float(v)
    if isinstance(v, str) and re.match(r"^\s*-?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?\s*$", v):
        return float(v)
    return None


def _show(v):
    if v is None:
        return "(none)"
    if isinstance(v, list):
        return ", ".join(str(x) for x in v) if v else "(empty)"
    return str(v)


def _same_value(a, b, tol, rtol):
    """(same?, short description of the difference)"""
    if isinstance(a, list) or isinstance(b, list):
        sa = set(a if isinstance(a, list) else ([] if a is None else [a]))
        sb = set(b if isinstance(b, list) else ([] if b is None else [b]))
        if sa == sb:
            return True, ""
        parts = []
        if sb - sa:
            parts.append("+" + ",".join(sorted(map(str, sb - sa))))
        if sa - sb:
            parts.append("-" + ",".join(sorted(map(str, sa - sb))))
        return False, " ".join(parts)
    if a == b:
        return True, ""
    na, nb = _as_num(a), _as_num(b)
    if na is not None and nb is not None:
        d = abs(na - nb)
        lim = max(tol, rtol * max(abs(na), abs(nb)))
        if d <= lim:
            return True, ""
        return False, "%+g" % (nb - na)
    return False, ""


def _expect_match(patterns, area, key):
    full = "%s.%s" % (area, key)
    for p in patterns:
        if p == area or full == p or full.startswith(p + ".") or full.startswith(p + "_") or \
                (p.startswith(area + ".") and key.startswith(p[len(area) + 1:])) or fnmatch.fnmatchcase(full, p):
            return True
    return False


def _compare_alleles(ra, rb, max_loci):
    """per schema: (n different, n called in one only, list of loci)"""
    out = {}
    for schema in sorted(set(ra) | set(rb)):
        a, b = ra.get(schema), rb.get(schema)
        if a is None or b is None:
            out[schema] = ("profile only in the %s" % ("run" if a is None else "reference"), None, [])
            continue
        diff, one = [], []
        for locus in sorted(set(a) | set(b)):
            x, y = a.get(locus, ""), b.get(locus, "")
            if x == y:
                continue
            missing = lambda v: v in ("", "-", "0", "LNF", "NIPH", "NIPHEM", "ASM", "ALM", "PLOT3", "PLOT5", "LOTSC", "PAMA")
            if missing(x) or missing(y):
                one.append(locus)
            else:
                diff.append(locus)
        if diff or one:
            out[schema] = (len(diff), len(one), (diff + one)[:max_loci])
    return out


def _compare_pair(ref, run, a):
    """Every difference of one run from the reference: list of dicts."""
    rows = []
    rs, ss = ref.get("samples", {}), run.get("samples", {})
    for name in sorted(set(rs) | set(ss)):
        if name not in ss:
            rows.append(dict(sample=name, area="sample", key="", ref="present", val="missing", note="sample not in the run"))
            continue
        if name not in rs:
            rows.append(dict(sample=name, area="sample", key="", ref="missing", val="present", note="sample not in the reference"))
            continue
        x, y = rs[name], ss[name]
        for area in AREAS:
            if a.areas and area not in a.areas:
                continue
            ax, ay = x.get(area) or {}, y.get(area) or {}
            if area == "cgmlst_alleles":
                for schema, (nd, n1, loci) in _compare_alleles(ax, ay, a.max_loci).items():
                    if n1 is None:
                        note = nd
                        rv, vv = ("profile", "(none)") if "run" in nd else ("(none)", "profile")
                    else:
                        note = "%d loci with another allele, %d called in only one" % (nd, n1)
                        rv, vv = "", ""
                    rows.append(dict(sample=name, area=area, key=schema, ref=rv, val=vv,
                                     note=note + ((": " + ", ".join(loci)) if loci and a.details else "")))
                continue
            for key in sorted(set(ax) | set(ay)):
                if a.ignore and any(_expect_match([p], area, key) for p in a.ignore):
                    continue
                va, vb = ax.get(key), ay.get(key)
                same, note = _same_value(va, vb, a.tolerance, a.rel_tolerance)
                if not same:
                    rows.append(dict(sample=name, area=area, key=key, ref=_show(va), val=_show(vb), note=note))
    for r in rows:
        r["expected"] = r["area"] != "sample" and _expect_match(a.expect, r["area"], r["key"])
    return rows


def _context_diff(ref, run):
    out = []
    for part in ("versions", "settings"):
        x = (ref.get("context") or {}).get(part) or {}
        y = (run.get("context") or {}).get(part) or {}
        for k in sorted(set(x) | set(y)):
            if _show(x.get(k)) != _show(y.get(k)):
                out.append((part, k, _show(x.get(k)), _show(y.get(k))))
    return out


def _write_compare_html(path, ref, runs, results, verdict, ok, repeat):
    e = lambda s: (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    parts = ["""<!doctype html><html><head><meta charset="utf-8"><title>Comparison with %s</title>
<style>body{font-family:system-ui,sans-serif;margin:2em;max-width:1300px}table{border-collapse:collapse;margin:1em 0}
td,th{border:1px solid #ccc;padding:3px 8px;font-size:13px;text-align:left;vertical-align:top}th{background:#eee}
tr.exp td{background:#f3f3f9;color:#555}tr.bad td{background:#fbe3e3}tr.ok td{background:#eef8ee}
.verdict{font-size:1.3em;padding:.6em 1em;border-radius:6px;display:inline-block}
.pass{background:#d9f2d9}.fail{background:#f7d0d0}small{color:#666}</style></head><body>
<h1>Comparison with the reference run %s</h1><p class="verdict %s">%s</p>
<p><small>Reference: %s (%s, eurlc-wgs %s)</small></p>""" % (
        e(ref["_label"]), e(ref["_label"]), "pass" if ok else "fail", e(verdict),
        e(ref["_path"]), e(ref.get("created", "")), e(ref.get("pipeline_version", "")))]
    if repeat:
        parts.append("<h2>Samples with the same results in every run</h2><table><tr><th>area</th><th>what</th>"
                     "<th>same in all runs</th><th>differ</th></tr>")
        for area, (same, n) in repeat.items():
            parts.append("<tr class='%s'><td>%s</td><td>%s</td><td>%d of %d</td><td>%d</td></tr>" % (
                "ok" if same == n else "bad", area, e(AREA_TEXT.get(area, "")), same, n, n - same))
        parts.append("</table>")
    for run, rows, ctx in results:
        un = [r for r in rows if not r["expected"]]
        parts.append("<h2>%s</h2><p><small>%s (%s, eurlc-wgs %s): %d difference(s), %d of them expected</small></p>" % (
            e(run["_label"]), e(run["_path"]), e(run.get("created", "")), e(run.get("pipeline_version", "")),
            len(rows), len(rows) - len(un)))
        if ctx:
            parts.append("<details><summary>What the run was made with that differs from the reference (%d)</summary>"
                         "<table><tr><th></th><th>key</th><th>reference</th><th>run</th></tr>%s</table></details>" % (
                len(ctx), "".join("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % tuple(map(e, c)) for c in ctx)))
        if rows:
            parts.append("<table><tr><th>sample</th><th>area</th><th>key</th><th>reference</th><th>run</th><th>note</th></tr>")
            for r in rows:
                parts.append("<tr class='%s'><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (
                    "exp" if r["expected"] else "bad", e(r["sample"]), e(r["area"]), e(r["key"]), e(r["ref"]),
                    e(r["val"]), e(r["note"] + (" (expected)" if r["expected"] else ""))))
            parts.append("</table>")
    parts.append("</body></html>")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(parts))


def cmd_compare(a):
    a.expect = [x.strip() for x in ",".join(a.expect or []).split(",") if x.strip()]
    a.ignore = [x.strip() for x in ",".join(a.ignore or []).split(",") if x.strip()]
    a.areas = [x.strip() for x in (a.areas or "").split(",") if x.strip()]
    for p in a.areas:
        if p not in AREAS:
            die("unknown area '%s' (areas: %s)" % (p, ", ".join(AREAS)))
    ref = _load_fp(a.reference)
    runs = [_load_fp(r) for r in a.runs]
    w = sys.stdout.write
    w("eurlc-wgs-inspect %s compare: reference %s (%s)\n" % (VERSION, ref["_label"], ref.get("created", "")))
    if a.expect:
        w("Expected to differ: %s\n" % ", ".join(a.expect))
    results = []
    unexpected_samples = set()
    tsv_rows = []
    for run in runs:
        rows = _compare_pair(ref, run, a)
        ctx = _context_diff(ref, run)
        results.append((run, rows, ctx))
        un = [r for r in rows if not r["expected"]]
        unexpected_samples |= {(run["_label"], r["sample"]) for r in un}
        w("\n== %s (%s, eurlc-wgs %s)\n" % (run["_label"], run.get("created", ""), run.get("pipeline_version", "")))
        if ctx:
            vers = [c for c in ctx if c[0] == "versions"]
            sets = [c for c in ctx if c[0] == "settings"]
            w("   made with: %d version(s) and %d setting(s) differ from the reference\n" % (len(vers), len(sets)))
            for c in (vers + sets)[: (None if a.details else 12)]:
                w("     %-9s %-40s %s -> %s\n" % (c[0], c[1], c[2][:40], c[3][:40]))
            if not a.details and len(ctx) > 12:
                w("     ... %d more (--details)\n" % (len(ctx) - 12))
            th = [c for c in sets if c[1] in ("general.threads", "general.parallel_mode")]
            if th:
                w("   NOTE: the number of threads or the parallel mode differs; some assemblers give slightly\n"
                  "         different assemblies with another thread count\n")
        by_area = defaultdict(lambda: [0, 0, set()])
        for r in rows:
            b = by_area[r["area"]]
            b[1 if r["expected"] else 0] += 1
            b[2].add(r["sample"])
        if not rows:
            w("   no differences in %d sample(s)\n" % len(run.get("samples", {})))
        else:
            w("   %-15s %10s %10s %8s\n" % ("area", "unexpected", "expected", "samples"))
            for area in ("sample",) + AREAS:
                if area in by_area:
                    b = by_area[area]
                    w("   %-15s %10d %10d %8d\n" % (area, b[0], b[1], len(b[2])))
            shown = un if not a.details else rows
            for r in shown[: (None if a.details else a.top)]:
                w("   %-14s %-14s %-40s %s -> %s%s\n" % (
                    r["sample"][:14], r["area"], r["key"][-40:], r["ref"][:30], r["val"][:30],
                    ("  [" + r["note"][:80] + "]") if r["note"] else ""))
            if not a.details and len(shown) > a.top:
                w("   ... %d more unexpected differences (--details, --tsv)\n" % (len(shown) - a.top))
        for r in rows:
            tsv_rows.append([run["_label"], r["sample"], r["area"], r["key"], r["ref"], r["val"],
                             "expected" if r["expected"] else "unexpected", r["note"]])

    # repeatability: per area, samples whose results are the same in all runs
    repeat = {}
    if len(runs) >= 1:
        names = set(ref.get("samples", {}))
        for run in runs:
            names &= set(run.get("samples", {}))
        bad = defaultdict(set)
        for run, rows, ctx in results:
            for r in rows:
                bad[r["area"]].add(r["sample"])
        for area in AREAS:
            if a.areas and area not in a.areas:
                continue
            if not any(area in (s or {}) for s in ref.get("samples", {}).values()):
                continue
            n = len(names)
            repeat[area] = (n - len(bad[area] & names), n)
        w("\nSamples with the same results in %s (%d sample(s) in all):\n" % (
            "the reference and the run" if len(runs) == 1 else "the reference and all %d runs" % len(runs), len(names)))
        for area, (same, n) in repeat.items():
            w("   %-15s %4d of %-4d %s\n" % (area, same, n, AREA_TEXT.get(area, "")))

    n_un = len(unexpected_samples)
    ok = n_un == 0
    verdict = "NO UNEXPECTED DIFFERENCES" if ok else "UNEXPECTED DIFFERENCES IN %d SAMPLE(S)" % n_un
    if len(runs) > 1 and not ok:
        verdict = "UNEXPECTED DIFFERENCES IN %d SAMPLE/RUN PAIR(S)" % n_un
    w("\n%s\n" % verdict)

    header = ["run", "sample", "area", "key", "reference", "value", "kind", "note"]
    tsvs = [a.tsv] if a.tsv else []
    if a.out:
        os.makedirs(a.out, exist_ok=True)
        tsvs.append(os.path.join(a.out, "comparison.tsv"))
        _write_compare_html(os.path.join(a.out, "comparison.html"), ref, runs, results, verdict, ok, repeat)
        with open(os.path.join(a.out, "comparison.json"), "w", encoding="utf-8") as fh:
            json.dump({"verdict": verdict, "no_unexpected_differences": ok, "reference": ref["_path"],
                       "runs": [r["_path"] for r in runs], "expect": a.expect,
                       "tolerance": a.tolerance, "rel_tolerance": a.rel_tolerance,
                       "repeatability": {k: {"same": v[0], "samples": v[1]} for k, v in repeat.items()},
                       "differences": [dict(zip(header, t)) for t in tsv_rows]}, fh, indent=1)
    for t in tsvs:
        with open(t, "w", encoding="utf-8") as fh:
            fh.write("\t".join(header) + "\n")
            for row in tsv_rows:
                fh.write("\t".join(str(c).replace("\t", " ").replace("\n", " ") for c in row) + "\n")
    return 0 if ok else 1


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="eurlc-wgs-inspect",
        description="Look at eurlc-wgs output folders (read-only).",
        epilog="Examples:\n"
               "  eurlc-wgs-inspect inventory /data/run192/eurlc-wgs\n"
               "  eurlc-wgs-inspect inventory /data/run192/eurlc-wgs --md5 --manifest run192.manifest.tsv\n"
               "  eurlc-wgs-inspect inventory --from-listing listing.txt\n"
               "  eurlc-wgs-inspect extract /data/run192/eurlc-wgs --samples 23SCA11,PT43-10 -o run192_review\n"
               "  eurlc-wgs-inspect mixture /data/run*/eurlc-wgs --tsv mixture.tsv --threshold 30\n"
               "  eurlc-wgs-inspect summarize /data/run*/eurlc-wgs --expected known.tsv --tsv all_samples.tsv\n"
               "  eurlc-wgs-inspect compare reference/2026-11-16_v0.1.0.json.gz /data/verif/eurlc-wgs --expect amr\n",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    sub = p.add_subparsers(dest="cmd")

    i = sub.add_parser("inventory", help="what is in an output folder and what takes the space",
                       formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    i.add_argument("outdir", nargs="?", help="eurlc-wgs output folder (or the data folder that holds eurlc-wgs/)")
    i.add_argument("--from-listing", metavar="FILE",
                   help="read a listing made with: find . -type f -printf '%%s %%p\\n' (no checksums then)")
    i.add_argument("--md5", action="store_true", help="checksum every file (else only possible duplicates)")
    i.add_argument("--manifest", metavar="FILE", help="write one row per file to this TSV")
    i.add_argument("--previous", metavar="FILE",
                   help="earlier manifest: reuse its MD5 where size and time are unchanged")
    i.add_argument("--top", type=int, default=25, help="rows in the top lists")
    i.add_argument("--dup-min", type=int, default=10000, help="smallest file (bytes) checked for duplicates")
    i.add_argument("--gzip-min", type=int, default=1000000, help="smallest text file (bytes) for the gzip estimate")
    i.add_argument("--no-gzip-estimate", action="store_true", help="skip the gzip estimate")

    e = sub.add_parser("extract", help="small package of raw result files for chosen samples",
                       formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    e.add_argument("outdir", help="eurlc-wgs output folder")
    e.add_argument("-o", "--output", required=True, help="package name (.tar.gz is added)")
    g = e.add_mutually_exclusive_group()
    g.add_argument("--samples", help="comma-separated sample names; wildcards allowed (\"PT43-*\")")
    g.add_argument("--all-samples", action="store_true", help="every sample")
    e.add_argument("--with-assemblies", action="store_true", help="include results/assemblies/<sample>.fasta")
    e.add_argument("--anonymize", action="store_true",
                   help="replace sample names (S01, S02 …) and folder paths; the key is written next to the package")
    e.add_argument("--max-file-mb", type=float, default=20, help="leave out files larger than this")

    sm = sub.add_parser("summarize", help="every sample of one or more runs: QC measures, spread per species, issues",
                        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    sm.add_argument("folders", nargs="+", help="output folders, or folders above them (searched for data/rundata.json)")
    sm.add_argument("--tsv", metavar="FILE", help="write one row per sample, one column per measure, to this file")
    sm.add_argument("--expected", metavar="FILE",
                    help="what is known about the samples: run<TAB>sample<TAB>expected[<TAB>note], expected = "
                         "clean, contaminated, low_quality, mixed, ... (run * = any run)")
    sm.add_argument("--species", metavar="REGEX", help="only samples of matching species")
    sm.add_argument("--measures", metavar="REGEX", help="only matching measures in the spread tables")
    sm.add_argument("--min-samples", type=int, default=1, help="leave out species with fewer samples")
    sm.add_argument("--top", type=int, default=40, help="issue groups to show")

    x = sub.add_parser("mixture", help="the intra-species mixture metric per sample, and per species",
                       formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    x.add_argument("folders", nargs="+", help="output folders, or folders above them (searched for *.remap_qc.json)")
    x.add_argument("--tsv", metavar="FILE", help="also write the table as tab-separated text")
    x.add_argument("--threshold", type=float, help="count the samples above this many windows, per species")
    x.add_argument("--summary-only", action="store_true", help="only the per-species spread")

    c = sub.add_parser("compare", help="results of runs against a reference run (after an update; repeatability)",
                       formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    c.add_argument("reference", help="the reference: a results fingerprint, or an output folder holding one")
    c.add_argument("runs", nargs="+", help="the run(s) to compare with it (fingerprints or output folders)")
    c.add_argument("--expect", action="append", metavar="LIST",
                   help="areas or measures where differences are expected (comma-separated; e.g. amr, "
                        "qc.coverage, assembly.*.md5): listed, but not counted")
    c.add_argument("--ignore", action="append", metavar="LIST", help="areas or measures left out entirely")
    c.add_argument("--areas", metavar="LIST", help="only these areas (%s)" % ", ".join(AREAS))
    c.add_argument("--tolerance", type=float, default=0.0, help="numbers this close count as the same")
    c.add_argument("--rel-tolerance", type=float, default=0.0,
                   help="numbers this close, as a fraction of the larger (0.001 = 0.1%%), count as the same")
    c.add_argument("--details", action="store_true", help="every difference, also expected ones, and the cgMLST loci")
    c.add_argument("--max-loci", type=int, default=50, help="cgMLST loci listed per sample and schema with --details")
    c.add_argument("--top", type=int, default=40, help="differences shown per run without --details")
    c.add_argument("--tsv", metavar="FILE", help="write every difference to this file")
    c.add_argument("--out", metavar="DIR", help="write comparison.html, comparison.tsv and comparison.json here")

    a = p.parse_args(argv)
    if a.cmd == "compare":
        return cmd_compare(a)
    if a.cmd == "inventory":
        return cmd_inventory(a)
    if a.cmd == "extract":
        return cmd_extract(a)
    if a.cmd == "mixture":
        return cmd_mixture(a)
    if a.cmd == "summarize":
        return cmd_summarize(a)
    p.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
