<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{run_name}} – EURLC-WGS Pipeline Report</title>
    <link rel="icon" type="image/png" href="{{favicon_file}}">
    <link rel="stylesheet" href="{{base_css_file}}">
    <link rel="stylesheet" href="{{main_css_file}}">
</head>

<body class="main-report">

<div class="report-header brand-header">

    <div class="brand-logo">
        <img src="{{pipeline_logo_file}}" alt="EURLC-WGS logo"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

        <div class="logo-fallback">EURLC-WGS</div>
    </div>

    <div class="brand-text">
        <div class="pipeline-badge">EURLC-WGS Pipeline</div>
        <div class="pipeline-subtitle">Whole Genome Sequencing Analysis and Reporting</div>

        <h1>{{run_name}}</h1>

        <div class="header-meta-grid">
            <div class="meta-item"><span class="meta-label">Generated</span><span class="meta-value">{{generated_date}}</span></div>
            <div class="meta-item"><span class="meta-label">Samples analysed</span><span class="meta-value">{{sample_count}}</span></div>
            <div class="meta-item"><span class="meta-label">Pipeline version</span><span class="meta-value">{{pipeline_version}}</span></div>
            <div class="meta-item"><span class="meta-label">Analysis machine</span><span class="meta-value">{{analysis_host}}</span></div>
            <div class="meta-item"><span class="meta-label">Analysis user</span><span class="meta-value">{{analysis_user}}</span></div>
            <div class="meta-item meta-item-wide"><span class="meta-label">Input folder</span><span class="meta-value">{{input_path}}</span></div>
        </div>
    </div>
</div>

<h2>Run summary</h2>
{{run_summary_table}}

<h2>Sample overview</h2>
{{sample_overview_table}}

<h2>Clustering</h2>
{{clustering_table}}

<h2>AMR profile</h2>
{{amr_table}}

<h2>Program versions</h2>
{{versions_table}}

<footer class="report-footer">
    EURLC-WGS Pipeline • SVA – Swedish Veterinary Agency
</footer>

</body>
</html>
